// In-language opcode definitions.  Each shadows a built-in mnemonic
// by macro-expanding to a `raw(...)` byte sequence.  Auto-emitted by
// digi-disasm; do not edit by hand.

function waitForSelectionChoice()    { raw(0x12, 0); }
function jumpReturn()                { raw(0x15, 0); }
function setDialogOwner(v)           { raw(0x1b, Entity!v); }
function setPStat(p, v)              { raw(0x1e, 0, PStat!p, v); }
function addPStat(p, v)              { raw(0x1f, 0, PStat!p, v); }
function reducePStat(p, v)           { raw(0x20, 0, PStat!p, v); }
function storeMapID(p)               { raw(0x21, PStat!p); }
function storeDigimonType(p)         { raw(0x22, PStat!p); }
function setInventorySize(s)         { raw(0x23, s); }
function setTextboxSize(w, h)        { raw(0x26, 0, w, h); }
function fadeOutHUD()                { raw(0x27, 0); }
function giveItem(i, a)              { raw(0x28, 0, Item!i, a); }
function removeItem(i, a)            { raw(0x29, 0, Item!i, a); }
function learnMove(m)                { raw(0x2d, Move!m); }
function giveCard(c)                 { raw(0x2f, c); }
function takeCard(c)                 { raw(0x30, c); }
function advanceToDate(p)            { raw(0x37, PStat!p); }
function storeDigimonTypus(v, p)     { raw(0x3f, 0, v, PStat!p); }
function loadDigimon(d)              { raw(0x46, Digimon!d); }
function setDigimon(t, e, a)         { raw(0x47, Digimon!t, Entity!e, a); }
function unloadEntity(e)             { raw(0x48, Entity!e); }
function callDigimonSubroutine(r)    { raw(0x49, r); }
function waitForEntity(e)            { raw(0x4a, Entity!e); }
function playAnimation(e, a)         { raw(0x56, 0, Entity!e, a); }
function setObjectVisibility(o, i)   { raw(0x57, 0, o, i); }
function playSound(r, s)             { raw(0x5a, 0, r, s); }
function setBGM(m)                   { raw(0x5d, m); }
function callSubroutine(r)           { raw(0x64, r); }
function removeCondition(m)          { raw(0x65, Condition!m); }
function startBattle()               { raw(0x66, 0); }
function setTexboxMode(m, d)         { raw(0x68, 0, m, d); }

// Auto-extracted repeated-pattern functions.

function loadDigimonThenLoadDigimonThenSetDigimonThenSetDigimonThenSetDigimon(a, b, c, d, e, f, g, h, i) {
    loadDigimon(a);
    loadDigimon(b);
    setDigimon(c, d, e);
    setDigimon(f, g, e);
    setDigimon(h, i, e);
}

function setScriptThenSetPStatThenSetBGMThenLoadDigimonThenSetDigimon(a, b, c, d, e, f, g) {
    setScript(a, b);
    setPStat(245, c);
    setBGM(d);
    loadDigimon(e);
    setDigimon(e, f, g);
}

function setScriptThenSetPStatThenSetBGMThenLoadDigimonThenLoadDigimon(a, b, c, d, e, f) {
    setScript(a, b);
    setPStat(245, c);
    setBGM(d);
    loadDigimon(e);
    loadDigimon(f);
}

function loadDigimonThenSetDigimonThenSetDigimonThenLoadDigimonThenSetDigimon(a, b, c, d, e) {
    loadDigimon(a);
    setDigimon(a, b, 1);
    setDigimon(a, c, 1);
    loadDigimon(d);
    setDigimon(d, e, 1);
}

function setScriptThenSetPStatThenSetBGMThenSetPStat(a, b) {
    setScript(163, a);
    setPStat(245, 0);
    setBGM(28);
    setPStat(43, b);
}

function loadDigimonThenLoadDigimonThenSetDigimonThenSetDigimon(a, b, c, d, e, f, g) {
    loadDigimon(a);
    loadDigimon(b);
    setDigimon(c, d, e);
    setDigimon(f, g, e);
}

function setScriptThenSetPStatThenSetBGMThenLoadDigimon(a, b, c, d, e) {
    setScript(a, b);
    setPStat(245, c);
    setBGM(d);
    loadDigimon(e);
}

function setScriptThenSetPStatThenSetBGM(a, b, c, d) {
    setScript(a, b);
    setPStat(245, c);
    setBGM(d);
}

function loadDigimonThenSetDigimonThenSetDigimon(a, b, c, d) {
    loadDigimon(a);
    setDigimon(a, b, c);
    setDigimon(a, d, c);
}

function loadDigimonThenSetDigimonThenSetPStat(a, b, c) {
    loadDigimon(a);
    setDigimon(a, b, 0);
    setPStat(c, b);
}

function addPStatThenLoadDigimonThenSetDigimon(a, b) {
    addPStat(38, 1);
    loadDigimon(a);
    setDigimon(a, b, 0);
}

function loadDigimonThenSetDigimonThenAddPStat(a, b) {
    loadDigimon(a);
    setDigimon(a, b, 0);
    addPStat(42, 1);
}

function sectionOnExitThenCallDigimonSubroutineThenWaitForEntity(a, b) {
    sectionOnExit(a);
    callDigimonSubroutine(b);
    waitForEntity(Entity.System);
}

