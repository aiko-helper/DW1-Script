// In-language opcode definitions.  Each shadows a built-in mnemonic
// by macro-expanding to a `raw(...)` byte sequence.  Auto-emitted by
// digi-disasm; do not edit by hand.

function waitForSelectionChoice() {
  raw(0x12, 0);
}

function jumpReturn() {
  raw(0x15, 0);
}

function setDialogOwner(v: Entity) {
  raw(0x1b, v);
}

function setPStat(p: PStat, v) {
  raw(0x1e, 0, p, v);
}

function addPStat(p: PStat, v) {
  raw(0x1f, 0, p, v);
}

function reducePStat(p: PStat, v) {
  raw(0x20, 0, p, v);
}

function storeMapID(p: PStat) {
  raw(0x21, p);
}

function storeDigimonType(p: PStat) {
  raw(0x22, p);
}

function setInventorySize(s) {
  raw(0x23, s);
}

function setTextboxSize(w, h) {
  raw(0x26, 0, w, h);
}

function fadeOutHUD() {
  raw(0x27, 0);
}

function giveItem(i: Item, a) {
  raw(0x28, 0, i, a);
}

function removeItem(i: Item, a) {
  raw(0x29, 0, i, a);
}

function learnMove(m: Move) {
  raw(0x2d, m);
}

function giveCard(c) {
  raw(0x2f, c);
}

function takeCard(c) {
  raw(0x30, c);
}

function advanceToDate(p: PStat) {
  raw(0x37, p);
}

function storeDigimonTypus(v, p: PStat) {
  raw(0x3f, 0, v, p);
}

function loadDigimon(d: Digimon) {
  raw(0x46, d);
}

function setDigimon(t: Digimon, e: Entity, a) {
  raw(0x47, t, e, a);
}

function unloadEntity(e: Entity) {
  raw(0x48, e);
}

function callDigimonSubroutine(r) {
  raw(0x49, r);
}

function waitForEntity(e: Entity) {
  raw(0x4a, e);
}

function playAnimation(e: Entity, a) {
  raw(0x56, 0, e, a);
}

function setObjectVisibility(o, i) {
  raw(0x57, 0, o, i);
}

function playSound(r, s) {
  raw(0x5a, 0, r, s);
}

function setBGM(m) {
  raw(0x5d, m);
}

function callSubroutine(r) {
  raw(0x64, r);
}

function removeCondition(m: Condition) {
  raw(0x65, m);
}

function setTexboxMode(m, d) {
  raw(0x68, 0, m, d);
}

// Named-arg synonyms (disasm emits with `field: value` form).

function teleport(pstat: PStat) {
  raw(0x58, pstat);
}

function roll(pstat: PStat, max) {
  raw(0x24, 0, pstat, max);
}

function warp(to: Map, spawn, trigger) {
  raw(0x4b, to, spawn, trigger);
}

// Multi-opcode composites (previously built-in C++ sugars).

function loadAndSetDigimon(digimon: Digimon, entity: Entity, autotalk) {
  loadDigimon(digimon);
  setDigimon(digimon, entity, autotalk);
}

function startBattle() {
  fadeOutHUD();
  delay(1);
  raw(0x66, 0);
}

function speak(o, t) {
  setDialogOwner(o);
  showTextbox(t);
}

function learnMoves(moves: Move[]) {
  for m in moves { learnMove(m); }
}

// Auto-extracted repeated-pattern functions.

function loadDigimonThenLoadDigimonThenSetDigimonThenSetDigimonThenSetDigimon(digimon: Digimon, digimon2: Digimon, entity: Entity, autotalk, digimon3: Digimon, entity2: Entity, digimon4: Digimon, entity3: Entity) {
  loadDigimon(digimon);
  loadDigimon(digimon2);
  setDigimon(digimon, entity, autotalk);
  setDigimon(digimon3, entity2, autotalk);
  setDigimon(digimon4, entity3, autotalk);
}

function setScriptThenSetPStatThenSetBGMThenLoadDigimonThenLoadDigimon(scriptId, map: Map, value, musicID, digimon: Digimon, digimon2: Digimon) {
  setScript(scriptId, map);
  setPStat(245, value);
  setBGM(musicID);
  loadDigimon(digimon);
  loadDigimon(digimon2);
}

function setScriptThenSetPStatThenSetBGMThenLoadAndSetDigimonThenSetDigimon(scriptId, map: Map, value, musicID, digimon: Digimon, autotalk, entity: Entity, autotalk2) {
  setScript(scriptId, map);
  setPStat(245, value);
  setBGM(musicID);
  loadAndSetDigimon(digimon, 0, autotalk);
  setDigimon(digimon, entity, autotalk2);
}

function setScriptThenSetPStatThenSetBGMThenLoadAndSetDigimon(scriptId, map: Map, value, musicID, digimon: Digimon, entity: Entity, autotalk) {
  setScript(scriptId, map);
  setPStat(245, value);
  setBGM(musicID);
  loadAndSetDigimon(digimon, entity, autotalk);
}

function setScriptThenSetPStatThenSetBGMThenSetPStat(map: Map, value) {
  setScript(163, map);
  setPStat(245, 0);
  setBGM(28);
  setPStat(43, value);
}

function loadDigimonThenLoadDigimonThenSetDigimonThenSetDigimon(digimon: Digimon, digimon2: Digimon, entity: Entity, autotalk, entity2: Entity) {
  loadDigimon(digimon);
  loadDigimon(digimon2);
  setDigimon(digimon, entity, autotalk);
  setDigimon(digimon2, entity2, autotalk);
}

function setScriptThenSetPStatThenSetBGMThenLoadDigimon(scriptId, map: Map, value, musicID, digimon: Digimon) {
  setScript(scriptId, map);
  setPStat(245, value);
  setBGM(musicID);
  loadDigimon(digimon);
}

function loadDigimonThenLoadAndSetDigimonThenSetDigimonThenSetDigimon(digimon: Digimon, digimon2: Digimon, entity: Entity, digimon3: Digimon, entity2: Entity, digimon4: Digimon, entity3: Entity) {
  loadDigimon(digimon);
  loadAndSetDigimon(digimon2, entity, 1);
  setDigimon(digimon3, entity2, 1);
  setDigimon(digimon4, entity3, 1);
}

function loadAndSetDigimonThenSetDigimonThenLoadAndSetDigimonThenSetDigimon(digimon: Digimon, entity: Entity, entity2: Entity, digimon2: Digimon, entity3: Entity, entity4: Entity) {
  loadAndSetDigimon(digimon, entity, 1);
  setDigimon(digimon, entity2, 1);
  loadAndSetDigimon(digimon2, entity3, 1);
  setDigimon(digimon2, entity4, 1);
}

function setScriptThenSetPStatThenSetBGM(scriptId, map: Map, value, musicID) {
  setScript(scriptId, map);
  setPStat(245, value);
  setBGM(musicID);
}

function loadAndSetDigimonThenSetDigimonThenSetDigimon(digimon: Digimon, entity: Entity, autotalk, entity2: Entity, entity3: Entity) {
  loadAndSetDigimon(digimon, entity, autotalk);
  setDigimon(digimon, entity2, autotalk);
  setDigimon(digimon, entity3, autotalk);
}

function sectionOnExitThenCallDigimonSubroutineThenWaitForEntity(trigger, routine) {
  sectionOnExit(trigger);
  callDigimonSubroutine(routine);
  waitForEntity(Entity.System);
}

