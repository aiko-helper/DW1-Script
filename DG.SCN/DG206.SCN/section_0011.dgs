// source: extract/DIGIMON/SCN/DG.SCN
// DG206.SCN, section 11

section section_11(11) {  // len=928
    if (pstat[121] != 0) goto L_00b0;
    setDialogOwner(6);
    showTextbox("Sorry bro. Come back again\nto challenge me. And don't\nforget to bring a fish.\n");
    return;
L_00b0:
    if (pstat[121] != 2) goto L_01e2;
    setDialogOwner(6);
    showTextbox("Impressive! Perfect score!\nAre you by any chance...\na professional?\n");
    if (trigger(372)) goto L_01e2;
    setTrigger(372);
    playSound(0, 7);
    setDialogOwner(Entity.System);
    showTextbox("<YELLOW>Congratulations!\nHere's a Medal for your\ngreat competition! <WHITE>\n");
L_01e2:
    setDialogOwner(6);
    showTextbox("Wow, you're amazing, man. \nI lost again.\n");
    setDialogOwner(6);
    showTextbox("Well, what can I say.\nHere's your prize.\n");
    roll(pstat: 102, max: 49);
L_0296:
    if (pstat[102] > 0) goto L_02ae;
    giveItem(Item.Rooster, 1);
    setPStat(110, 85);
    goto L_0326;
L_02ae:
    if (pstat[102] > 5) goto L_02c6;
    giveItem(Item.Restore, 1);
    setPStat(110, 11);
    goto L_0326;
L_02c6:
    if (pstat[102] > 15) goto L_02de;
    giveItem(Item.OmniDisk, 1);
    setPStat(110, 18);
    goto L_0326;
L_02de:
    if (pstat[102] > 22) goto L_02f6;
    giveItem(Item.GiantMeat, 1);
    setPStat(110, 39);
    goto L_0326;
L_02f6:
    if (pstat[102] > 30) goto L_030e;
    giveItem(Item.LargeRecovery, 1);
    setPStat(110, 2);
    goto L_0326;
L_030e:
    if (pstat[102] > 50) goto L_0326;
    giveItem(Item.MediumMP, 1);
    setPStat(110, 5);
    goto L_0326;
L_0326:
    if (!trigger(0)) goto L_0376;
    setDialogOwner(6);
    showTextbox("You have too many Items!\n");
    unsetTrigger(3);
    callSubroutine(0);
    callSubroutine(13);
    goto L_0296;
L_0376:
    setDialogOwner(Entity.System);
    showTextbox("I got a <LIGHTBLUE><TREASURE ITEM><WHITE>!\n");
    moveCamera(to: Entity.Player, speed: 10);
    waitForEntity(200);
    return;
    return;
}
