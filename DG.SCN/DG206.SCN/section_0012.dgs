// source: extract/DIGIMON/SCN/DG.SCN
// DG206.SCN, section 12

section section_12(12) {  // len=2950
    if (pstat[121] != 0) goto L_00be;
    setDialogOwner(6);
    showTextbox("If you want to win against\nme, you better use your head!\nI'll see you again someday.\n");
    return;
L_00be:
    if (pstat[121] != 2) goto L_01e8;
    setDialogOwner(6);
    showTextbox("You got a perfect score\nagainst me!! Are you\na Curling genius?!\n");
    if (trigger(372)) goto L_01e8;
    setTrigger(372);
    playSound(0, 7);
    setDialogOwner(Entity.System);
    showTextbox("<YELLOW>Congratulations!\nHere's a Medal for your\ngreat competition! <WHITE>\n");
L_01e8:
    setDialogOwner(6);
    showTextbox("You are good, <LIGHTBLUE><PLAYER><WHITE>!\nHere's the prize\nI promised you!\n");
    roll(pstat: 102, max: 49);
L_025a:
    if (pstat[102] > 0) goto L_0272;
    giveItem(Item.SilverBall, 1);
    setPStat(110, 103);
    goto L_031a;
L_0272:
    if (pstat[102] > 1) goto L_028a;
    giveItem(Item.MetalArmor, 1);
    setPStat(110, 104);
    goto L_031a;
L_028a:
    if (pstat[102] > 2) goto L_02a2;
    giveItem(Item.Chainsaw, 1);
    setPStat(110, 105);
    goto L_031a;
L_02a2:
    if (pstat[102] > 3) goto L_02ba;
    giveItem(Item.SmallSpear, 1);
    setPStat(110, 106);
    goto L_031a;
L_02ba:
    if (pstat[102] > 11) goto L_02d2;
    giveItem(Item.SuperRecovery, 1);
    setPStat(110, 3);
    goto L_031a;
L_02d2:
    if (pstat[102] > 21) goto L_02ea;
    giveItem(Item.Restore, 1);
    setPStat(110, 11);
    goto L_031a;
L_02ea:
    if (pstat[102] > 33) goto L_0302;
    giveItem(Item.Omnipotent, 1);
    setPStat(110, 9);
    goto L_031a;
L_0302:
    if (pstat[102] > 49) goto L_031a;
    giveItem(Item.Sirloin, 1);
    setPStat(110, 40);
    goto L_031a;
L_031a:
    if (!trigger(0)) goto L_036a;
    setDialogOwner(6);
    showTextbox("You have too many Items.\n");
    unsetTrigger(3);
    callSubroutine(0);
    callSubroutine(13);
    goto L_025a;
L_036a:
    setDialogOwner(Entity.System);
    showTextbox("I got a <LIGHTBLUE><TREASURE ITEM><WHITE>!\n");
    moveCamera(to: Entity.Player, speed: 10);
    waitForEntity(200);
    return;
    garbage { 1c 00 fe 00 1c 00 06 00 1e 00 0a 00 c8 08 0b 00 c4 0c 07 00 64 10 0c 00 7a 14 ff ff fe 00 1e 00 7a 00 19 00 01 00 01 01 81 00 65 01 18 00 76 03 19 00 1b 06 1a 00 82 67 82 85 82 99 81 43 81 40 82 84 82 8f 81 40 82 99 82 8f 82 95 81 40 82 97 82 81 82 8e 82 94 81 40 82 94 82 8f 81 40 82 90 82 8c 82 81 82 99 81 40 82 81 0d 00 82 8d 82 81 82 94 82 83 82 88 81 40 82 97 82 89 82 94 82 88 81 40 82 8d 82 85 81 48 81 40 82 68 82 86 81 40 82 99 82 8f 82 95 81 40 82 97 82 89 82 8e 81 43 0d 00 82 68 81 75 82 8c 82 8c 81 40 82 84 82 8f 81 40 82 97 82 88 82 81 82 94 82 85 82 96 82 85 82 92 81 40 82 99 82 8f 82 95 81 40 82 93 82 81 82 99 81 42 0d 00 00 00 1b fd 1a 00 82 76 82 88 82 81 82 94 81 40 82 8b 82 89 82 8e 82 84 81 40 82 8f 82 86 81 40 82 8d 82 81 82 94 82 83 82 88 81 48 0d 00 00 00 1b 06 1a 00 82 76 82 88 82 81 82 94 81 40 82 68 81 40 82 83 82 81 82 8c 82 8c 81 42 81 42 81 42 0d 00 82 63 82 89 82 87 82 89 82 8d 82 8f 82 8e 81 40 82 62 82 95 82 92 82 8c 82 89 82 8e 82 87 81 49 81 40 0d 00 82 68 81 75 82 8c 82 8c 81 40 82 94 82 85 82 8c 82 8c 81 40 82 99 82 8f 82 95 81 40 82 8d 82 8f 82 92 82 85 81 40 82 89 82 8e 82 93 82 89 82 84 82 85 81 42 0d 00 00 00 1b fd 1a 00 82 67 82 8d 82 8d 81 43 81 40 82 97 82 88 82 81 82 94 81 40 82 88 82 81 82 90 82 90 82 85 82 8e 82 93 81 40 82 89 82 86 81 40 82 68 81 40 82 8c 82 8f 82 93 82 85 81 48 0d 00 00 00 1b 06 1a 00 82 6d 82 8f 82 94 82 88 82 89 82 8e 82 87 81 40 82 94 82 88 82 85 81 40 82 86 82 89 82 92 82 93 82 94 81 40 82 94 82 89 82 8d 82 85 81 42 0d 00 82 61 82 95 82 94 81 40 82 8e 82 85 82 98 82 94 81 40 82 94 82 89 82 8d 82 85 81 40 82 99 82 8f 82 95 81 40 82 88 82 81 82 96 82 85 81 40 82 94 82 8f 0d 00 82 87 82 89 82 96 82 85 81 40 82 8d 82 85 81 40 82 81 81 40 82 86 82 89 82 93 82 88 81 40 82 86 82 89 82 92 82 93 82 94 81 42 0d 00 00 00 1b fd 1a 00 82 73 82 88 82 85 82 8e 81 40 82 89 82 86 81 40 82 68 81 40 82 97 82 89 82 8e 81 43 81 40 82 99 82 8f 82 95 81 40 82 83 82 8f 82 8d 82 85 81 40 82 94 82 8f 0d 00 82 94 