// source: extract/DIGIMON/SCN/DG.SCN
// DG206.SCN, section 6

section section_6(6) {  // len=2218
    setPStat(122, 0);
    if (trigger(257) || trigger(357)) goto L_0358;
    setDialogOwner(6);
    showTextbox("Hey, do you want to play a\nmatch with me? If you win,\nI'll do whatever you say.\n");
    setDialogOwner(Entity.Player);
    showTextbox("What kind of match?\n");
    setDialogOwner(6);
    showTextbox("What I call...\nDigimon Curling! \nI'll tell you more inside.\n");
    setDialogOwner(Entity.Player);
    showTextbox("Hmm, what happens if I lose?\n");
    setDialogOwner(6);
    showTextbox("Nothing the first time.\nBut next time you have to\ngive me a fish first.\n");
    setDialogOwner(Entity.Player);
    showTextbox("Then if I win, you come to\nthe city with me. OK?");
    dead_string("? to\nThen, let's do it.\n");
    setDialogOwner(6);
    showTextbox("Alright, that's fine. \nLet's go inside.\n");
    setTrigger(357);
    move(entity: 6, to: (1905, 1667), sprint: 0);
    delay(10);
    move(entity: Entity.Player, to: (1905, 1667), sprint: 0);
    delay(10);
    move(entity: Entity.Partner, to: (1905, 1667), sprint: 0);
    delay(10);
    warp(to: Map.FRZL17, spawn: 1, trigger: 255);
    return;
L_0358:
    if (trigger(257)) goto L_0444;
    setDialogOwner(6);
    showTextbox("Hey, do you want to play a\nmatch with me? Give me a\nfish and you can play me.\n");
    setDialogOwner(Entity.Player);
    setSelection(L_0656, L_061e);
    showTextbox("I'll get you\nNo thanks\n");
    waitForSelectionChoice();
    return;
L_0444:
    if (trigger(92)) goto L_0530;
    setTrigger(92);
    setDialogOwner(6);
    showTextbox("Hey bro! I made a\nskating rink here.\n");
    showTextbox("One fish for one match.\nBut if you win, I'll give\nyou a nice prize.\n");
L_0530:
    setPStat(122, 0);
    setDialogOwner(6);
    showTextbox("Hey dude, don't you want to\nhave a match with me? You can\nchallenge me with one fish.\n");
    setDialogOwner(Entity.Player);
    setSelection(L_0656, L_061e);
    showTextbox("You're on\nNo thanks\n");
    waitForSelectionChoice();
    return;
L_061e:
    setPStat(113, 0);
    setDialogOwner(6);
    showTextbox("Shoot, that's no fun.\n");
    return;
L_0656:
    setDialogOwner(6);
    showTextbox("Give me a fish!\n");
    setTrigger(3);
    callSubroutine(0);
    if (!trigger(3)) goto L_06d0;
    setDialogOwner(Entity.Player);
    showTextbox("I don't got anything now...\n");
    goto L_081e;
L_06d0:
    if (pstat[254] != 62 && pstat[254] != 63 && pstat[254] != 64 && pstat[254] != 65) goto L_06ee;
    callSubroutine(12);
    goto L_077a;
L_06ee:
    if (pstat[254] != 66 && pstat[254] != 67) goto L_0704;
    callSubroutine(12);
    goto L_077a;
L_0704:
    if (pstat[254] != 255) goto L_0718;
    goto L_081e;
    goto L_077a;
L_0718:
    setDialogOwner(Entity.Player);
    showTextbox("Oh no, giving you this\ndoesn't do any good.\n");
    goto L_081e;
L_077a:
    setDialogOwner(6);
    showTextbox("Wow, it looks tasty. Ooops,\nwe have to have a match first.\nLet's go inside.\n");
    warp(to: Map.FRZL17, spawn: 1, trigger: 255);
    return;
L_081e:
    setPStat(113, 0);
    setDialogOwner(6);
    showTextbox("Oh come on, dude.\nWhy don't you go fishing\nat Dragon Eye Lake.\n");
    return;
    return;
}
