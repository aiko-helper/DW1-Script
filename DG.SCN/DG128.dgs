// DG128.SCN
#include "functions.dgs"
#pragma script index=128 start=0x5a000 end=0x5b000 headerU16=0x14 sentinelOff=0x24
#include "entities.dgs"

section onEnter(254) {
  roll(pstat: 110, max: 99);
  if (pstat[110] > 17) goto L1;
  spawnItem(Item.Digimushroom, x: 46, y: 61);

L1:
  roll(pstat: 110, max: 99);
  if (pstat[110] > 0) goto L2;
  spawnItem(Item.SageFruit, x: 60, y: 53);

L2:
  if (!trigger(8) && !trigger(9) && !trigger(10)) goto L3;
  playAnimation(5, 29);

L3:
  if (!trigger(8) || !trigger(9)) goto L4;
  playAnimation(5, 30);

L4:
  if (!trigger(8) || !trigger(10)) goto L5;
  playAnimation(5, 30);

L5:
  if (!trigger(9) || !trigger(10)) goto L6;
  playAnimation(5, 30);

L6:
  if ((!trigger(8) ?? !trigger(9)) || !trigger(10)) goto L7;
  playAnimation(5, 31);

L7:
  if (!trigger(11) && !trigger(12) && !trigger(13)) goto L8;
  playAnimation(6, 29);

L8:
  if (!trigger(11) || !trigger(12)) goto L9;
  playAnimation(6, 30);

L9:
  if (!trigger(11) || !trigger(13)) goto L10;
  playAnimation(6, 30);

L10:
  if (!trigger(12) || !trigger(13)) goto L11;
  playAnimation(6, 30);

L11:
  if ((!trigger(11) ?? !trigger(12)) || !trigger(13)) goto L12;
  playAnimation(6, 31);

L12:
  return;
}

section(5) {
  if (!trigger(8) || !trigger(9)) goto L1;
  speak(5, "Hey, <LIGHTBLUE><PLAYER><WHITE>!\n");
  goto L5;

L1:
  if (!trigger(8) || !trigger(10)) goto L2;
  speak(5, "Hey, <LIGHTBLUE><PLAYER><WHITE>!\n");
  goto L5;

L2:
  if (!trigger(9) || !trigger(10)) goto L3;
  speak(5, "Hey, <LIGHTBLUE><PLAYER><WHITE>!\n");
  goto L5;

L3:
  if (!trigger(8) && !trigger(9) && !trigger(10)) goto L4;
  speak(5, "Thanks for coming!\n");
  goto L5;

L4:
  speak(5, "Hello, I'm Mojyamon!\n");

L5:
  setPStat(254, 5);
  setPStat(249, 1);
  callSubroutine(2);
  if (!trigger(8) && !trigger(9) && !trigger(10)) goto L6;
  playAnimation(5, 29);

L6:
  if (!trigger(8) || !trigger(9)) goto L7;
  playAnimation(5, 30);

L7:
  if (!trigger(8) || !trigger(10)) goto L8;
  playAnimation(5, 30);

L8:
  if (!trigger(9) || !trigger(10)) goto L9;
  playAnimation(5, 30);

L9:
  if ((!trigger(8) ?? !trigger(9)) || !trigger(10)) goto L10;
  playAnimation(5, 31);

L10:
  if (trigger(5) && trigger(6) && trigger(7)) goto L11;
  return;

L11:
  if (trigger(8) && trigger(9) && trigger(10)) goto L12;
  return;

L12:
  if (trigger(11) && trigger(12) && trigger(13)) goto L13;
  return;

L13:
  if (!trigger(252)) goto L14;
  return;

L14:
  speak(5, "<LIGHTBLUE><PLAYER><WHITE>, I'm so happy!\nYou've done so much for us.\n");
  showTextbox("I've decided I'm going\nto the city. We'll work\ntogether, alright?\n");
  goto L15;

L15:
  loop {
    move(entity: 5, to: (1931, -1543), sprint: 1);
    if (pstat[101] >= 6) break;
    addPStat(101, 1);
    delay(10);
    look(entity: Entity.Player, at: 5);
    look(entity: Entity.Partner, at: 5);
  }
  waitForEntity(5);
  unloadEntity(5);
  setPStat(101, 0);
  playSound(8, 11);
  speak(Entity.System, "Mojyamon joins the city!\n");
  setTrigger(252);
  setTrigger(108);
  addPStat(1, 2);
  return;
}

section(6) {
  if (!trigger(11) || !trigger(12)) goto L1;
  speak(6, "Hey, <LIGHTBLUE><PLAYER><WHITE>!\n");
  goto L5;

L1:
  if (!trigger(12) || !trigger(13)) goto L2;
  speak(6, "Hey, <LIGHTBLUE><PLAYER><WHITE>!\n");
  goto L5;

L2:
  if (!trigger(12) || !trigger(13)) goto L3;
  speak(6, "Hey, <LIGHTBLUE><PLAYER><WHITE>!\n");
  goto L5;

L3:
  if (!trigger(11) && !trigger(12) && !trigger(13)) goto L4;
  speak(6, "Thanks for coming!\n");
  goto L5;

L4:
  speak(6, "Hello, I'm Mojyamon!\n");

L5:
  setPStat(254, 6);
  setPStat(249, 2);
  callSubroutine(2);
  if (!trigger(11) && !trigger(12) && !trigger(13)) goto L6;
  playAnimation(6, 29);

L6:
  if (!trigger(11) || !trigger(12)) goto L7;
  playAnimation(6, 30);

L7:
  if (!trigger(11) || !trigger(13)) goto L8;
  playAnimation(6, 30);

L8:
  if (!trigger(12) || !trigger(13)) goto L9;
  playAnimation(6, 30);

L9:
  if ((!trigger(11) ?? !trigger(12)) || !trigger(13)) goto L10;
  playAnimation(6, 31);

L10:
  if (trigger(5) && trigger(6) && trigger(7)) goto L11;
  return;

L11:
  if (trigger(8) && trigger(9) && trigger(10)) goto L12;
  return;

L12:
  if (trigger(11) && trigger(12) && trigger(13)) goto L13;
  return;

L13:
  if (!trigger(252)) goto L14;
  return;

L14:
  speak(6, "<LIGHTBLUE><PLAYER><WHITE>, I'm so happy!\nYou've done so much for us.\n");
  showTextbox("I've decided I'm going\nto the city. We'll work\ntogether, alright?\n");
  goto L15;

L15:
  loop {
    move(entity: 6, to: (-1605, -856), sprint: 1);
    if (pstat[101] >= 6) break;
    addPStat(101, 1);
    delay(10);
    look(entity: Entity.Player, at: 6);
    look(entity: Entity.Partner, at: 6);
  }
  waitForEntity(6);
  unloadEntity(6);
  setPStat(101, 0);
  playSound(8, 11);
  speak(Entity.System, "Mojyamon joins the city!\n");
  setTrigger(252);
  setTrigger(109);
  addPStat(1, 2);
  return;
}

section(51) {
  if ((cond & 0x40) == 0x01 && !trigger(133)) goto L1;
  return;

L1:
  storeDigimonType(103);
  if (pstat[103] != 3 && pstat[103] != 5 && pstat[103] != 8 && pstat[103] != 9 && pstat[103] != 47) goto L2;
  jumpToScriptSection(203, 51);

L2:
  if (pstat[103] != 19 && pstat[103] != 32 && pstat[103] != 51 && pstat[103] != 1 && pstat[103] != 2) goto L3;
  jumpToScriptSection(203, 51);

L3:
  if (pstat[103] != 15 && pstat[103] != 16 && pstat[103] != 29 && pstat[103] != 30 && pstat[103] != 43) goto L4;
  jumpToScriptSection(203, 51);

L4:
  if (pstat[103] != 44 && pstat[103] != 21) goto L5;
  jumpToScriptSection(203, 51);

L5:
  return;
  garbage { 14 00 fe 00 14 00 05 00 1a 01 06 00 48 04 33 00 76 07 ff ff 24 00 6e 63 19 00 0b 00 6e 11 18 00 2a 00 19 00 74 2c 2e 00 3d 00 24 00 6e 63 19 00 0b 00 6e 00 18 00 40 00 19 00 74 3b 3c 00 35 00 19 00 00 00 08 00 40 00 09 00 40 00 0a 00 18 00 58 00 19 00 56 00 05 1d 19 00 00 00 08 00 80 00 09 00 18 00 6c 00 19 00 56 00 05 1e 19 00 00 00 08 00 80 00 0a 00 18 00 80 00 19 00 56 00 05 1e 19 00 00 00 09 00 80 00 0a 00 18 00 94 00 19 00 56 00 05 1e 19 00 00 00 08 00 00 00 09 00 80 00 0a 00 18 00 ac 00 19 00 56 00 05 1f 19 00 00 00 0b 00 40 00 0c 00 40 00 0d 00 18 00 c4 00 19 00 56 00 06 1d 19 00 00 00 0b 00 80 00 0c 00 18 00 d8 00 19 00 56 00 06 1e 19 00 00 00 0b 00 80 00 0d 00 18 00 ec 00 19 00 56 00 06 1e 19 00 00 00 0c 00 80 00 0d 00 18 00 00 01 19 00 56 00 06 1e 19 00 00 00 0b 00 00 00 0c 00 80 00 0d 00 18 00 18 01 19 00 56 00 06 1f fe 00 19 00 00 00 08 00 80 00 09 00 18 00 48 01 19 00 1b 05 1a 00 82 67 82 85 82 99 81 43 81 40 01 06 05 00 01 01 81 49 0d 00 00 00 16 00 18 02 19 00 00 00 08 00 80 00 0a 00 18 00 76 01 19 00 1b 05 1a 00 82 67 82 85 82 99 81 43 81 40 01 06 05 00 01 01 81 49 0d 00 00 00 16 00 18 02 19 00 00 00 09 00 80 00 0a 00 18 00 a4 01 19 00 1b 05 1a 00 82 67 82 85 82 99 81 43 81 40 01 06 05 00 01 01 81 49 0d 00 00 00 16 00 18 02 19 00 00 00 08 00 40 00 09 00 40 00 0a 00 18 00 e8 01 19 00 1b 05 1a 00 82 73 82 88 82 81 82 8e 82 8b 82 93 81 40 82 86 82 8f 82 92 81 40 82 83 82 8f 82 8d 82 89 82 8e 82 87 81 49 0d 00 00 00 16 00 18 02 1b 05 1a 00 82 67 82 85 82 8c 82 8c 82 8f 81 43 81 40 82 68 81 75 82 8d 81 40 82 6c 82 8f 82 8a 82 99 82 81 82 8d 82 8f 82 8e 81 49 0d 00 00 00 1e 00 fe 05 1e 00 f9 01 64 02 19 00 00 00 08 00 40 00 09 00 40 00 0a 00 18 00 3a 02 19 00 56 00 05 1d 19 00 00 00 08 00 80 00 09 00 18 00 4e 02 19 00 56 00 05 1e 19 00 00 00 08 00 80 00 0a 00 18 00 62 02 19 00 56 00 05 1e 19 00 00 00 09 00 80 00 0a 00 18 00 76 02 19 00 56 00 05 1e 19 00 00 00 08 00 00 00 09 00 80 00 0a 00 18 00 8e 02 19 00 56 00 05 1f 19 00 01 00 05 00 41 00 06