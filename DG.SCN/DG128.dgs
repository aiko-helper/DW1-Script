    playAnimation(6, 31);
L_0104:
    return;
}

section section_5(5) {  // len=814
    if (!trigger(8) || !trigger(9)) goto L_002e;
    setDialogOwner(5);
    showTextbox("Hey, <LIGHTBLUE><PLAYER><WHITE>!\n");
    goto L_00fe;
L_002e:
    if (!trigger(8) || !trigger(10)) goto L_005c;
    setDialogOwner(5);
    showTextbox("Hey, <LIGHTBLUE><PLAYER><WHITE>!\n");
