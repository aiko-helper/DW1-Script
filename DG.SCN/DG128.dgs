    return;
L_018a:
    if (trigger(8) && trigger(9) && trigger(10)) goto L_01a0;
    return;
L_01a0:
    if (trigger(11) && trigger(12) && trigger(13)) goto L_01b6;
    return;
L_01b6:
    if (!trigger(252)) goto L_01c4;
    return;
L_01c4:
    setDialogOwner(5);
    showTextbox("<LIGHTBLUE><PLAYER><WHITE>, I'm so happy!\nYou've done so much for us.\n");
    showTextbox("I've decided I'm going\nto the city. We'll work\ntogether, alright?\n");
    goto L_02b4;
L_02b4:
    move(entity: 5, to: (1931, -1543), sprint: 1);
    if (pstat[101] >= 6) goto L_02dc;
    addPStat(101, 1);
    delay(10);
    look(entity: Entity.Player, at: 5);
    look(entity: Entity.Partner, at: 5);
    goto L_02b4;
L_02dc:
    waitForEntity(5);
    unloadEntity(5);
    setPStat(101, 0);
    playSound(8, 11);
    setDialogOwner(Entity.System);
    showTextbox("Mojyamon joins the city!\n");
    setTrigger(252);
    setTrigger(108);
    addPStat(1, 2);
    return;
}

