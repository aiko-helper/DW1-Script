L_008a:
    if (!trigger(8) && !trigger(9) && !trigger(10)) goto L_00ce;
    setDialogOwner(5);
    showTextbox("Thanks for coming!\n");
    goto L_00fe;
L_00ce:
    setDialogOwner(5);
    showTextbox("Hello, I'm Mojyamon!\n");
L_00fe:
