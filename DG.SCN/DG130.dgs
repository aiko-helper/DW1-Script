// DG130.SCN
#include "functions.dgs"
#pragma script index=130 start=0x55800 end=0x56000 headerU16=0xc sentinelOff=0x6e75
#include "entities.dgs"

section onEnter(254) {
  spawnChest(Item.MystyEgg, 1667, -1966, 2048, 672);
  return;
}

section(51) {
  if (!trigger(150)) {
    speak(Entity.Player, "「げ!」<NEWLINE>");
    move(entity: Entity.Player, to: (1104, 243), sprint: 1);
    move(entity: Entity.Partner, to: (675, 290), sprint: 1);
    waitForEntity(Entity.Player);
    panTo(x: 1156, y: -416, slowdown: 20);
    lookPairAt(Entity(5));
    delay(5);
    speak(Entity(5), "「ん?」<NEWLINE>");
    look(entity: Entity(5), at: Entity.Player);
    look(entity: Entity(6), at: Entity.Player);
    look(entity: Entity(7), at: Entity.Player);
    speak(Entity(5), "「ぬあっ!?」<NEWLINE>");
    look(entity: Entity(7), at: Entity(5));
    delay(10);
    look(entity: Entity(7), at: Entity.Player);
    speak(Entity(7), "「お、おかしら、やばいっす!」<NEWLINE>");
    anim(Entity.Player, Animation(20), wait: 15);
    speak(Entity.Player, "「おまえ達、何をしてるんだ!?」<NEWLINE>");
    playAnimation(Entity.Player, Animation(0));
    speak(Entity(5), "「ぐへへ、よくこのニュー・オーガトリデを<NEWLINE> 見つけられたな!」<NEWLINE>");
    anim(Entity.Player, Animation(7), wait: 15);
    speak(Entity.Player, "「また悪事をはたらくつもりか!」<NEWLINE>");
    playAnimation(Entity.Player, Animation(0));
    speak(Entity(5), "「あたりまえじゃねーか!ぐひひひひ!」<NEWLINE>");
    speak(Entity.Player, "「むっ、ゆるせん!<NEWLINE> ここの洞くつから出ていってもらうぞ。」<NEWLINE>");
    speak(Entity(5), "「けっ、今回は前とはちがうぞ…」<NEWLINE>");
    look(entity: Entity(6), at: Entity(5));
    look(entity: Entity(5), at: Entity(6));
    delay(10);
    speak(Entity(6), "「おかしら、あれですか?」<NEWLINE>");
    delay(10);
    speak(Entity(5), "「おうよ、行け!」<NEWLINE>");
    move(entity: Entity(6), to: (861, -1338), sprint: 1);
    waitForEntity(Entity(6));
    unloadEntity(Entity(6));
    move(entity: Entity(7), to: (8, -717), sprint: 1);
    waitForEntity(Entity(7));
    look(entity: Entity(7), at: Entity.Player);
    delay(5);
    setDigimon(Digimon.WaruSeadramon, Entity(3), 0);
    move(entity: Entity(8), to: (586, -461), sprint: 0);
    waitForEntity(Entity(8));
    look(entity: Entity(8), at: Entity.Player);
    delay(5);
    speak(Entity.Player, "「な、何!?」<NEWLINE>");
    look(entity: Entity(5), at: Entity(8));
    delay(5);
    speak(Entity(5), "「ワルシードラモン先生!<NEWLINE> やっちゃってください!」<NEWLINE>");
    speak(Entity.Player, "「ようじんぼうってわけか!」<NEWLINE>");
    look(entity: Entity(5), at: Entity.Player);
    delay(5);
    speak(Entity(5), "「ぐひゃひゃひゃ!<NEWLINE> もうおしまいだな!」<NEWLINE>");
    setTrigger(Trigger(1));
    setPStat(PStat(250), 1);
    setPStat(PStat(251), 5);
    setPStat(PStat(252), 7);
    setPStat(PStat(253), 8);
    startBattle();
    unsetTrigger(Trigger(1));
    setPStat(PStat(250), 0);
    look(entity: Entity.Player, at: Entity(5));
    look(entity: Entity(5), at: Entity.Player);
    look(entity: Entity.Partner, at: Entity(5));
    move(entity: Entity(5), to: (1100, 1000), sprint: 1);
    move(entity: Entity(7), to: (1100, 1000), sprint: 1);
    move(entity: Entity(8), to: (1100, 1000), sprint: 1);
    speak(Entity(5), "「ちきしょお!」<NEWLINE>");
    speak(Entity(7), "「ひぇ~~~」<NEWLINE>");
    for x in [Entity(5), Entity(7), Entity(8)] {
      waitForEntity(x);
    }
    for x in [Entity(5), Entity(7), Entity(8)] {
      unloadEntity(x);
    }
    speak(Entity.Player, "「逃がすかーーーっ!」<NEWLINE>");
    setTrigger(Trigger(150));
    move(entity: Entity.Player, to: (1100, 1000), sprint: 1);
    delay(10);
    move(entity: Entity.Partner, to: (1100, 1000), sprint: 1);
    warp(to: Map.OGRE10, spawn: 0, trigger: 6);
  }
  return;
  garbage { 0c 00 fe 00 0c 00 33 00 1a 00 ff ff 75 6e 83 06 00 00 52 f8 00 08 a0 02 fe 00 19 00 01 00 96 00 18 00 fc 03 19 00 1b fd 1a 00 81 75 82 b0 81 49 81 76 0d 00 00 00 4e fd 50 04 f3 00 01 00 4e fc a3 02 22 01 01 00 4a fd 4f 14 84 04 60 fe 4a c8 4c 00 fd 05 4c 00 fc 05 67 00 05 00 1b 05 1a 00 81 75 82 f1 81 48 81 76 0d 00 00 00 4c 00 05 fd 4c 00 06 fd 4c 00 07 fd 1b 05 1a 00 81 75 82 ca 82 a0 82 c1 81 49 81 48 81 76 0d 00 00 00 4c 00 07 05 67 00 0a 00 4c 00 07 fd 1b 07 1a 00 81 75 82 a8 81 41 82 a8 82 a9 82 b5 82 e7 81 41 82 e2 82 ce 82 a2 82 c1 82 b7 81 49 81 76 0d 00 00 00 56 00 fd 14 67 00 0f 00 1b fd 1a 00 81 75 82 a8 82 dc 82 a6 92 42 81 41 89 bd 82 f0 82 b5 82 c4 82 e9 82 f1 82 be 81 49 81 48 81 76 0d 00 00 00 56 00 fd 00 1b 05 1a 00 81 75 82 ae 82 d6 82 d6 81 41 82 e6 82 ad 82 b1 82 cc 83 6a 83 85 81 5b 81 45 83 49 81 5b 83 4b 83 67 83 8a 83 66 82 f0 0d 00 81 40 8c a9 82 c2 82 af 82 e7 82 ea 82 bd 82 c8 81 49 81 76 0d 00 00 00 56 00 fd 07 67 00 0f 00 1b fd 1a 00 81 75 82 dc 82 bd 88 ab 8e 96 82 f0 82 cd 82 bd 82 e7 82 ad 82 c2 82 e0 82 e8 82 a9 81 49 81 76 0d 00 00 00 56 00 fd 00 1b 05 1a 00 81 75 82 a0 82 bd 82 e8 82 dc 82 a6 82 b6 82 e1 82 cb 81 5b 82 a9 81 49 82 ae 82 d0 82 d0 82 d0 82 d0 81 49 81 76 0d 00 00 00 1b fd 1a 00 81 75 82 de 82 c1 81 41 82 e4 82 e9 82 b9 82 f1 81 49 0d 00 81 40 82 b1 82 b1 82 cc 93 b4 82 ad 82 c2 82 a9 82 e7 8f 6f 82 c4 82 a2 82 c1 82 c4 82 e0 82 e7 82 a4 82 bc 81 42 81 76 0d 00 00 00 1b 05 1a 00 81 75 82 af 82 c1 81 41 8d a1 89 f1 82 cd 91 4f 82 c6 82 cd 82 bf 82 aa 82 a4 82 bc 81 63 81 76 0d 00 00 00 4c 00 06 05 4c 00 05 06 67 00 0a 00 1b 06 1a 00 81 75 82 a8 82 a9 82 b5 82 e7 81 41 82 a0 82 ea 82 c5 82 b7 82 a9 81 48 81 76 0d 00 00 00 67 00 0a 00 1b 05 1a 00 81 75 82 a8 82 a4 82 e6 81 41 8d 73 82 af 81 49 81 76 0d 00 00 00 4e 06 5d 03 c6 fa 01 00 4a 06 48 06 4e 07 08 00 33 fd 01 00 4a 07 4c 00 07 fd 67 00 05 00 47 70 03 00 4e 08 4a 02 33 fe 00 00 4a 08 4c 00 08 fd 67 00 05 00 1b fd 1a 00 81 75 82 c8 81 41 89 bd 81 49 81