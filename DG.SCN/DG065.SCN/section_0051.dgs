// source: extract/DIGIMON/SCN/DG.SCN
// DG065.SCN, section 51

section section_51(51) {  // len=104
    if (trigger(130)) goto L_0066;
    setDialogOwner(5);
    showTextbox("I'll, get you!\n");
    setTrigger(1);
    setPStat(250, 1);
    setPStat(251, 5);
    setPStat(252, 255);
    setPStat(253, 255);
    fadeOutHUD();
    delay(1);
    startBattle();
    unsetTrigger(1);
    setPStat(250, 0);
    unloadEntity(5);
    setTrigger(130);
    setTrigger(290);
    moveCamera(to: Entity.Player, speed: 10);
    waitForEntity(200);
    return;
L_0066:
    return;
}
