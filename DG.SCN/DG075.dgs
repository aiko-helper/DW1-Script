// DG075.SCN
#include "functions.dgs"
#pragma script index=75 start=0x35000 end=0x36000 headerU16=0x18 sentinelOff=0x24
#include "entities.dgs"

section onEnter(254) {
  spawnItemChance(max: 99, chance: 8, item: Item.Digimushroom, x: 33, y: 39);
  spawnItemChance(max: 99, chance: 16, item: Item.Digimushroom, x: 33, y: 22);
  spawnItemChance(max: 99, chance: 2, item: Item.SweetNut, x: 52, y: 35);
  return;
}

section(51) {
  if (trigger(189)) {
    return;
  }
  if (trigger(248) || !trigger(196)) {
    return;
  }
  lookPairAt(Entity(5));
  waitForPair();
  setTrigger(Trigger(189));
  panTo(x: -285, y: 3964, slowdown: 30);
  speak(Entity(5), "I've heard about you.\n");
  look(entity: Entity(5), at: Entity.Player);
  waitForEntity(Entity(5));
  anim(Entity.Player, Animation(19), wait: 15);
  speak(Entity.Player, "If you've heard about us\nand the city, why don't you\ncome with me?\n");
  playAnimation(Entity.Player, Animation(0));
  speak(Entity(5), "I'm also thinking about the\nisland's future. I've been\nsearching for something.\n");
  rotate(entity: Entity(5), to: 2560);
  waitForEntity(Entity(5));
  playAnimation(Entity(5), Animation(24));
  waitForEntity(Entity(5));
  speak(Entity.Player, "What are you looking for?\n");
  speak(Entity(5), "Something that my ancestors\nleft behind, but\nI don't know what it is.\n");

L1:
  if (item[Item.Leomonstone] >= 1) {
    removeItem(Item.Leomonstone, 1);
    goto L2;
    goto L2;
  }
  speak(Entity.Player, "I see. If I find it,\nI'll let you know.\n");
  speak(Entity(5), "I've been looking\na long time.\nIt won't be easy to find.\n");
  speak(Entity(5), "But if you find it,\nI promise,\nI'll go to your city.\n");
  followEntity(Entity.Player, speed: 10);
  return;

L2:
  anim(Entity.Player, Animation(19), wait: 15);
  speak(Entity.Player, "Is this it?\n");
  playAnimation(Entity.Player, Animation(0));
  look(entity: Entity(5), at: Entity.Player);
  waitForEntity(Entity(5));
  speak(Entity(5), "Oh, that's it!\n");
  followEntity(Entity(5), speed: 20);
  move(entity: Entity(5), to: Entity.Player, sprint: 1, withCamera: true);
  waitForEntity(Entity(5));
  look(entity: Entity(5), at: Entity.Player);
  look(entity: Entity.Player, at: Entity(5));
  waitForEntity(Entity(5));
  waitForEntity(Entity.Player);
  anim(Entity(5), Animation(25), wait: 30);
  speak(Entity(5), "This is what my ancestors\nhad written. Let me see.\n");
  speak(Entity(5), "When danger comes to the\nisland, go to the city.\n");
  playAnimation(Entity(5), Animation(24));
  waitForEntity(Entity(5));
  speak(Entity(5), "My ancestors say\nthat I should go!\n");
  speak(Entity.Player, "You are going to help us?\n");
  playAnimation(Entity(5), Animation(22));
  waitForEntity(Entity(5));
  speak(Entity(5), "You can count on me!\n");
  goto L3;

L3:
  approach(who: Entity(5), x: -374, y: -1119, tries: 3, wait: 20);
  playSound(8, 17);
  speak(Entity.System, "Leomon joins the city!\n");
  followEntity(Entity.Player, speed: 10);
  setTrigger(Trigger(248));
  addPStat(PStat(1), 2);
  return;
}

section(5) {
  speak(Entity(5), "I have to look for something.\nExcuse me, but I have to...\n");
  goto section_51.L1;
}

section(83) {
  rotate(entity: Entity.Player, to: 2048);
  setTextboxOrigin(-829, 0, 4099);
  callSubroutine(39);
  speak(Entity(200), "<GREEN>Training:\nStriking Special <WHITE>\n");
  choice { "Begin" -> L1, "Explain" -> L2, "Quit" -> L3 }
  return;

L1:
  setDialogOwner(Entity(200));
  choice { "Normal" -> L4, "Bonus Try" -> L5, "Quit" -> L3 }
  return;

L2:
  speak(Entity(200), "Using a concrete bag,\nstrike at full force.\n");
  showTextbox("This will boost Offensive\nPower and Max HP.\n");
  choice { "Explain again" -> L2, "Begin" -> L1, "Quit" -> L3 }
  return;

L3:
  return;

L4:
  fadeOutHUD();
  setPStat(PStat(254), 1);
  setPStat(PStat(246), 0);
  callDigimonSubroutine(214);
  callSubroutine(7);
  return;

L5:
  setTexboxMode(1, 0);
  speak(Entity.System, "<YELLOW>Slot Game <WHITE>\nUse <LIGHTBLUE><X> <WHITE>to\nmatch three pictures.\n");
  setPStat(PStat(254), 1);
  setPStat(PStat(246), 1);
  callDigimonSubroutine(214);
  callSubroutine(7);
  setTexboxMode(0, 0);
  return;
}

section(85) {
  rotate(entity: Entity.Player, to: 2560);
  setTextboxOrigin(766, 0, 106);
  callSubroutine(39);
  speak(Entity(200), "<GREEN>Training: \nSavanna Course <WHITE>\n");
  choice { "Begin" -> L1, "Explain" -> L2, "Quit" -> L3 }
  return;

L1:
  setDialogOwner(Entity(200));
  choice { "Normal" -> L4, "Bonus Try" -> L5, "Quit" -> L3 }
  return;

L2:
  speak(Entity(200), "Run around Savanna Course.\n");
  showTextbox("This will boost Speed greatly\nand boost Max HP also.\n");
  choice { "Explain again" -> L2, "Begin" -> L1, "Quit" -> L3 }
  return;

L3:
  return;

L4:
  fadeOutHUD();
  setPStat(PStat(254), 2);
  setPStat(PStat(246), 0);
  callDigimonSubroutine(214);
  callSubroutine(7);
  return;

L5:
  setTexboxMode(1, 0);
  speak(Entity.System, "<YELLOW>Slot Game <WHITE>\nUse <LIGHTBLUE><X> <WHITE>to\nmatch three pictures.\n");
  setPStat(PStat(254), 2);
  setPStat(PStat(246), 1);
  callDigimonSubroutine(214);
  callSubroutine(7);
  setTexboxMode(0, 0);
  return;
  garbage { 18 00 fe 00 18 00 33 00 5c 00 05 00 c8 06 53 00 46 07 55 00 90 09 ff ff 24 00 6e 63 19 00 0b 00 6e 08 18 00 2e 00 19 00 74 2c 21 00 27 00 24 00 6e 63 19 00 0b 00 6e 10 18 00 44 00 19 00 74 2c 21 00 16 00 24 00 6e 63 19 00 0b 00 6e 02 18 00 5a 00 19 00 74 34 34 00 23 00 fe 00 19 00 00 00 bd 00 18 00 6a 00 19 00 fe 00 19 00 00 00 f8 00 41 00 c4 00 18 00 7c 00 19 00 fe 00 4c 00 fd 05 4c 00 fc 05 4a fd 4a fc 1c 00 bd 00 4f 1e e3 fe 7c 0f 4a c8 1b 05 1a 00 82 68 81 75 82 96 82 85 81 40 82 88 82 85 82 81 82 92 82 84 81 40 82 81 82 82 82 8f 82 95 82 94 81 40 82 99 82 8f 82 95 81 42 0d 00 00 00 4c 00 05 fd 4a 05 56 00 fd 13 67 00 0f 00 1b fd 1a 00 82 68 82 86 81 40 82 99 82 8f 82 95 81 75 82 96 82 85 81 40 82 88 82 85 82 81 82 92 82 84 81 40 82 81 82 82 82 8f 82 95 82 94 81 40 82 95 82 93 0d 00 82 81 82 8e 82 84 81 40 82 94 82 88 82 85 81 40 82 83 82 89 82 94 82 99 81 43 81 40 82 97 82 88 82 99 81 40 82 84 82 8f 82 8e 81 75 82 94 81 40 82 99 82 8f 82 95 0d 00 82 83 82 8f 82 8d 82 85 81 40 82 97 82 89 82 94 82 88 81 40 82 8d 82 85 81 48 0d 00 00 00 56 00 fd 00 1b 05 1a 00 82 68 81 75 82 8d 81 40 82 81 82 8c 82 93 82 8f 81 40 82 94 82 88 82 89 82 8e 82 8b 82 89 82 8e 82 87 81 40 82 81 82 82 82 8f 82 95 82 94 81 40 82 94 82 88 82 85 0d 00 82 89 82 93 82 8c 82 81 82 8e 82 84 81 75 82 93 81 40 82 86 82 95 82 94 82 95 82 92 82 85 81 42 81 40 82 68 81 75 82 96 82 85 81 40 82 82 82 85 82 85 82 8e 0d 00 82 93 82 85 82 81 82 92 82 83 82 88 82 89 82 8e 82 87 81 40 82 86 82 8f 82 92 81 40 82 93 82 8f 82 8d 82 85 82 94 82 88 82 89 82 8e 82 87 81 42 0d 00 00 00 4d 05 00 0a 4a 05 56 00 05 18 4a 05 1b fd 1a 00 82 76 82 88 82 81 82 94 81 40 82 81 82 92 82 85 81 40 82 99 82 8f 82 95 81 40 82 8c 82 8f 82 8f 82 8b 82 89 82 8e 82 87 81 40 82 86 82 8f 82 92 81 48 0d 00 00 00 1b 05 1a 00 82 72 82 8f 82 8d 82 85 82 94 82 88 82 89 82 8e 82 87 81 40 82 94 82 88 82 81 82 94 81 40 82 8d 82 99 81 40 82 81 82 8e 82 83 82 85 82 93 82 94 82 8f 82 92 82 93 0d 00 82 8c 82 85 82 86 82 94 81 40 82