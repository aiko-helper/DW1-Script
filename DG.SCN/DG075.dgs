// DG075.SCN
#include "functions.dgs"
#pragma script index=75 start=0x33000 end=0x34000 headerU16=0x20 sentinelOff=0x24
#include "entities.dgs"

section onEnter(254) {
  spawnItemChance(max: 99, chance: 10, item: Item.Digimushroom, x: 31, y: 84);
  spawnItemChance(max: 99, chance: 7, item: Item.Digimushroom, x: 48, y: 27);
  spawnItemChance(max: 99, chance: 3, item: Item.RedBerry, x: 25, y: 55);
  return;
}

section(5) {
  {
    switch (pstat[34]) { case 0: break; case 1: goto L1; }
  }
  speak(Entity(5), "「私の一族に、商人をこころざした者が<NEWLINE> いたと思うんだが…。どこかで<NEWLINE> 店を開いているらしい。」<NEWLINE>");
  showTextbox("「私よりもその者を仲間にするほうが<NEWLINE> 役に立つだろう…」<NEWLINE>");
  addPStat(PStat(34), 1);
  return;

L1:
  speak(Entity(5), "「なぜ、ここの時間の流れは外とちがう<NEWLINE> のか?」<NEWLINE>");
  showTextbox("「われわれが住みやすい場所で<NEWLINE> あることはまちがいないのだが…」<NEWLINE>");
  setPStat(PStat(34), 0);
  return;
}

section(6) {
  {
    look(entity: Entity.Player, at: Entity(6));
    sfx(8, 3, wait: 15);
    switch (pstat[35]) { case 0: break; case 1: goto L1; case 2: goto L2; case 3: goto L3; case 4: goto L4; case 5: goto L5; }
  }
  speak(Entity(6), "「オレは空から遠くのほうを見てきたが…」<NEWLINE>");
  showTextbox("「北のほうは永久氷雪地帯が広がってるぜ。<NEWLINE> あんな寒いとこでくらしてるやつらはよ、<NEWLINE> ホントどうかしてるぜぇ。」<NEWLINE>");
  addPStat(PStat(35), 1);
  return;

L1:
  speak(Entity(6), "「オレは空から遠くのほうを見てきたが…」<NEWLINE>");
  showTextbox("「西のほうにゃ、鉄でできた小さい町が<NEWLINE> あるぜ。でも出入り口が閉じたまんま<NEWLINE> なんだ。俺なら飛んで入るがね。ケケ。」<NEWLINE>");
  addPStat(PStat(35), 1);
  return;

L2:
  speak(Entity(6), "「オレは空から遠くのほうを見てきたが…」<NEWLINE>");
  showTextbox("「南西には頭にツノやらハサミやらを<NEWLINE> つけた妙なデジモンの集落があるな。<NEWLINE> 木をくりぬいて家にしてるらしいぜ。」<NEWLINE>");
  addPStat(PStat(35), 1);
  return;

L3:
  speak(Entity(6), "「オレは空から遠くのほうを見てきたが…」<NEWLINE>");
  showTextbox("「北西には霧でおおわれた森があったな。<NEWLINE> 森の中に建物もあったぜ。ま、<NEWLINE> ここからはすげえ離れてるけどな。」<NEWLINE>");
  addPStat(PStat(35), 1);
  return;

L4:
  speak(Entity(6), "「オレは空から遠くのほうを見てきたが…」<NEWLINE>");
  showTextbox("「東のグレートキャニオンには<NEWLINE> もう行ったか?<NEWLINE> あそこはマジでいりくんでるぞ。ケケ。」<NEWLINE>");
  addPStat(PStat(35), 1);
  return;

L5:
  speak(Entity(6), "「オレは空から遠くのほうを見てきたが…」<NEWLINE>");
  showTextbox("「この島のど真ん中にゃ、何があるかって?<NEWLINE> それが俺にもわかんねえんだ。<NEWLINE> すげえ雲がかかってるからなぁ。」<NEWLINE>");
  setPStat(PStat(35), 0);
  return;
}

section(82) {
  {
    anim(Entity(7), Animation(29), wait: 5);
    speak(Entity(7), "「…すでに聞いたと思うが。」<NEWLINE>");
    switch (pstat[36]) { case 0: break; case 1: goto L1; }
  }
  anim(Entity(7), Animation(30), wait: 5);
  speak(Entity(7), "「ここは時間の流れが遅い。外で1日たつ間<NEWLINE> ここでは半日しかたっていない。」<NEWLINE>");
  anim(Entity(7), Animation(30), wait: 5);
  speak(Entity(7), "「まぁ、のんびりしたい者には良い所だ。」<NEWLINE>");
  addPStat(PStat(36), 1);
  anim(Entity(7), Animation(31), wait: 5);
  return;

L1:
  anim(Entity(7), Animation(30), wait: 5);
  speak(Entity(7), "「この奥、時急域は時間の流れが早い。<NEWLINE> 外で1日たつ間に2日たってしまう。」<NEWLINE>");
  anim(Entity(7), Animation(30), wait: 5);
  speak(Entity(7), "「早く成長できる…と言えなくもないが…<NEWLINE> 骨になっては手おくれだからな。」<NEWLINE>");
  setPStat(PStat(36), 0);
  anim(Entity(7), Animation(31), wait: 5);
  return;
}

section(7) {
  return;
}

section(8) {
  return;
}

section(81) {
  {
    speak(Entity.System, " <NEWLINE>       自動はん売機<NEWLINE>");
    speak(Entity.Player, "「何が出るかはお楽しみ…<NEWLINE> 1回200<B><it>…?<NEWLINE> あやしいなあ。どうするかな。」<NEWLINE>");
    setSelection(L1, L2);
    showTextbox("「試してみる。」<NEWLINE>「やめておく。」<NEWLINE>");
    waitForSelectionChoice();
    break;
    return;

L1:
    if (money >= 200) {
      goto L3;
    } else {
      speak(Entity.Player, "「お金が足りないか。」<NEWLINE>");
      return;
    }
    return;

L2:
  }
  return;

L3:
  roll(pstat: PStat(102), max: 99);
  {
    if (pstat[102] < 29) {
      reduceMoney(200);
      speak(Entity.System, "<LIGHTBLUE>肉<WHITE>が出てきた!<NEWLINE>");
      giveItem(Item.Meat, 1);
      if (trigger(0)) {
        speak(Entity.Player, "「いけね、持ち物がいっぱいだ。<NEWLINE> 捨てなきゃ。」<NEWLINE>");
        inventoryFullBailout();
        giveItem(Item.Meat, 1);
      }
    } else {
      break;
    }
    return;
  }
  {
    if (pstat[102] < 59) {
      setDialogOwner(Entity.System);
      reduceMoney(200);
      speak(Entity.System, "<LIGHTBLUE>回復フロッピー<WHITE>が出てきた!<NEWLINE>");
      giveItem(Item.SmallRecovery, 1);
      if (trigger(0)) {
        speak(Entity.Player, "「いけね、持ち物がいっぱいだ。<NEWLINE> 捨てなきゃ。」<NEWLINE>");
        inventoryFullBailout();
        giveItem(Item.SmallRecovery, 1);
      }
    } else {
      break;
    }
    return;
  }
  {
    if (pstat[102] < 79) {
      setDialogOwner(Entity.System);
      reduceMoney(200);
      speak(Entity.System, "<LIGHTBLUE>くさった肉<WHITE>が出てきた!<NEWLINE>");
      giveItem(Item.MoldyMeat, 1);
      if (trigger(0)) {
        speak(Entity.Player, "「いけね、持ち物がいっぱいだ。<NEWLINE> 捨てなきゃ。」<NEWLINE>");
        inventoryFullBailout();
        giveItem(Item.MoldyMeat, 1);
      }
    } else {
      break;
    }
    return;
  }
  {
    if (pstat[102] > 99) break;
    setDialogOwner(Entity.System);
    reduceMoney(200);
    speak(Entity.System, "<LIGHTBLUE>MPフロッピー<WHITE>が出てきた!<NEWLINE>");
    giveItem(Item.MPFloppy, 1);
    if (!trigger(0)) break;
    speak(Entity.Player, "「いけね、持ち物がいっぱいだ<NEWLINE> 捨てなきゃ。」<NEWLINE>");
    inventoryFullBailout();
    giveItem(Item.MPFloppy, 1);
    return;
  }
  return;
  garbage { 20 00 fe 00 20 00 05 00 64 00 06 00 9c 01 52 00 a4 05 07 00 3e 07 08 00 40 07 51 00 42 07 ff ff 24 00 6e 63 19 00 0b 00 6e 0a 18 00 36 00 19 00 74 2c 1f 00 54 00 24 00 6e 63 19 00 0b 00 6e 07 18 00 4c 00 19 00 74 2c 30 00 1b 00 24 00 6e 63 19 00 0b 00 6e 03 18 00 62 00 19 00 74 31 19 00 37 00 fe 00 18 22 02 00 6c 00 18 01 1b 05 1a 00 81 75 8e 84 82 cc 88 ea 91 b0 82 c9 81 41 8f a4 90 6c 82 f0 82 b1 82 b1 82 eb 82 b4 82 b5 82 bd 8e d2 82 aa 0d 00 81 40 82 a2 82 bd 82 c6 8e 76 82 a4 82 f1 82 be 82 aa 81 63 81 42 82 c7 82 b1 82 a9 82 c5 0d 00 81 40 93 58 82 f0 8a 4a 82 a2 82 c4 82 a2 82 e9 82 e7 82 b5 82 a2 81 42 81 76 0d 00 00 00 1a 00 81 75 8e 84 82 e6 82 e8 82 e0 82 bb 82 cc 8e d2 82 f0 92 87 8a d4 82 c9 82 b7 82 e9 82 d9 82 a4 82 aa 0d 00 81 40 96 f0 82 c9 97 a7 82 c2 82 be 82 eb 82 a4 81 63 81 76 0d 00 00 00 1f 00 22 01 fe 00 1b 05 1a 00 81 75 82 c8 82 ba 81 41 82 b1 82 b1 82 cc 8e 9e 8a d4 82 cc 97 ac 82 ea 82 cd 8a 4f 82 c6 82 bf 82 aa 82 a4 0d 00 81 40 82 cc 82 a9 81 48 81 76 0d 00 00 00 1a 00 81 75 82 ed 82 ea 82 ed 82 ea 82 aa 8f 5a 82 dd 82 e2 82 b7 82 a2 8f ea 8f 8a 82 c5 0d 00 81 40 82 a0 82 e9 82 b1 82 c6 82 cd 82 dc 82 bf 82 aa 82 a2 82 c8 82 a2 82 cc 82 be 82 aa 81 63 81 76 0d 00 00 00 1e 00 22 00 fe 00 4c 00 fd 06 5a 00 08 03 67 00 0f 00 18 23 06 00 b8 01 64 02 14 03 c0 03 68 04 fc 04 1b 06 1a 00 81 75 83 49 83 8c 82 cd 8b f3 82 a9 82 e7 89 93 82 ad 82 cc 82 d9 82 a4 82 f0 8c a9 82 c4 82 ab 82 bd 82 aa 81 63 81 76 0d 00 00 00 1a 00 81 75 96 6b 82 cc 82 d9 82 a4 82 cd 89 69 8b 76 95 58 90 e1 92 6e 91 d1 82 aa 8d 4c 82 aa 82 c1 82 c4 82 e9 82 ba 81 42 0d 00 81 40 82 a0 82 f1 82 c8 8a a6 82 a2 82 c6 82 b1 82 c5 82 ad 82 e7 82 b5 82 c4 82 e9 82 e2 82 c2 82 e7 82 cd 82 e6 81 41 0d 00 81 40 83 7a 83 93 83 67 82 c7 82 a4 82 a9 82 b5 82 c4 82 e9 82 ba 82 a5 81 42 81 76 0d 00 00 00 1f 00 23 01 fe 00 1b 06 1a 00 81 75 83 49 83 8c 82 cd 8b f3 82 a9 82 e7 89 93 82 ad 82 cc 82 d9 82 a4 82 f0 8c a9 82 c4 82 ab 82 bd 82 aa 81 63 81 76 0d 00 00 00 1a 00 81