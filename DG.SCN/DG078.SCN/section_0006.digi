  010c:  endSection
  010e:  setDialogOwner 6
  0110:  showTextbox "I've been looking around\nfrom the sky.\n"
  0162:  showTextbox "There's a small city made\nof iron to the west.\n"
  01c4:  showTextbox "But the entrance and exit\nare closed. I can fly there.\n"
  0236:  addPStat 35 1
  023a:  endSection
  023c:  setDialogOwner 6
  023e:  showTextbox "I've been looking around\nfrom the sky.\n"
  0290:  showTextbox "There are groups of Digimon\nthat have horns or claws.\n"
  0300:  showTextbox "I heard they make their\nhomes by carving out wood.\n"
  036a:  addPStat 35 1
  036e:  endSection
  0370:  setDialogOwner 6
  0372:  showTextbox "I've been looking around\nfrom the sky.\n"
  03c4:  showTextbox "In the northwest is a forest\nwith buildings.\n"
  0422:  showTextbox "It's very far.\n"
  0444:  addPStat 35 1
  0448:  endSection
  044a:  setDialogOwner 6
  044c:  showTextbox "I've been looking around\nfrom the sky.\n"
  049e:  showTextbox "Have you been past the Great\nCanyon? It's like a maze.\n"
  0510:  addPStat 35 1
  0514:  endSection
  0516:  setDialogOwner 6
  0518:  showTextbox "I've been looking around\nfrom the sky.\n"
