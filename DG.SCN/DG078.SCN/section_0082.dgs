// source: extract/DIGIMON/SCN/DG.SCN
// DG078.SCN, section 82

section section_82(82) {  // len=668
    playAnimation(7, 29);
    delay(5);
    setDialogOwner(7);
    showTextbox("You heard this already.\n");
    switch (pstat[36]) { case 0: goto L_0046; case 1: goto L_013c; };
L_0046:
    playAnimation(7, 30);
    delay(5);
    setDialogOwner(7);
    showTextbox("Time is slow here.\nHalf a day here is\nlike a day out there.\n");
    playAnimation(7, 30);
    delay(5);
    setDialogOwner(7);
    showTextbox("For those who want to rest,\nit's perfect.\n");
    addPStat(36, 1);
    playAnimation(7, 31);
    delay(5);
    return;
L_013c:
    playAnimation(7, 30);
    delay(5);
    setDialogOwner(7);
    showTextbox("Time goes fast in the\nSpeedy Time Zone.\nIt's just beyond here.\n");
    showTextbox("Two days pass instead\nof one there.\n");
    playAnimation(7, 30);
    delay(5);
    setDialogOwner(7);
    showTextbox("Your Digimon grows faster,\nbut fades away faster too.\n");
    setPStat(36, 0);
    playAnimation(7, 31);
    delay(5);
    return;
}
