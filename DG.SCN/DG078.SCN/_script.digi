; DG078.SCN
;!script index=78 start=0x37800 end=0x38800 headerU16=0x20 sentinelOff=0x24
;!sections onEnter section_5 section_6 section_82 section_7 section_8 section_81

onEnter:     ; len=68
  0000:  storeRandom 110 99
  0004:  if pstat[110] > 10 then onEnter+0x16
  0010:  spawnItem 44 31 84
  0016:  storeRandom 110 99
  001a:  if pstat[110] > 7 then onEnter+0x2c
  0026:  spawnItem 44 48 27
  002c:  storeRandom 110 99
  0030:  if pstat[110] > 3 then onEnter+0x42
  003c:  spawnItem 49 25 55
  0042:  endSection
