// source: extract/DIGIMON/SCN/DG.SCN
// DG101.SCN, section 81

section section_81(81) {  // len=178
    if (item[Item.BlueFlute] < 1) goto L_00a4;
    setDialogOwner(Entity.System);
    showTextbox("Will you play the Lake\nGuardian's <LIGHTBLUE>Blue Flute<WHITE>?\n");
    setDialogOwner(Entity.Player);
    setSelection(L_00aa, L_00a6);
    showTextbox("Play\nDon't play\n");
    waitForSelectionChoice();
    return;
L_00a4:
    return;
L_00a6:
    return;
    return;
L_00aa:
    delay(60);
    warp(to: Map.MAYO06, spawn: 0, trigger: 255);
}
