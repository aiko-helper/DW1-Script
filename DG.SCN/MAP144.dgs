// MAP144.SCN
#include "functions.dgs"
#pragma script index=144 start=0x5e000 end=0x5f800 headerU16=0x24 sentinelOff=0x19
#include "entities.dgs"

section onEnter(254) {
  if (!trigger(320)) {
    setObjectVisibility(10, 0);
  } else {
    setObjectVisibility(10, 1);
  }
  if (!trigger(362)) {
    goto section_6;
  }
  return;
}

section(5) {
  goto section_81;

L1:
  return;
}

section(81) {
  moveCamera(to: (-1143, 1558), slowdown: 10);
  lookPairAt(Entity(5));
  look(entity: Entity(5), at: Entity.Player);
  delay(5);
  storeDigimonType(PStat(103));
  {
    if (trigger(363) && pstat[103] == 39) {
      playSound(8, 20);
      speak(Entity(5), "「ふん!またお前か!さっさと帰れ!」<NEWLINE>");
      anim(Entity.Player, Animation(16), wait: 15);
      speak(Entity.Player, "「あのー…」<NEWLINE>");
      playAnimation(Entity.Player, Animation(0));
      speak(Entity(5), "「ええい、しつこいのう!これでよいか!」<NEWLINE>");
      break;
      followEntity(Entity.Player, speed: 10);
      return;
    }
    if (trigger(363)) {
      playSound(8, 20);
      speak(Entity(5), "「ふん!またお前か!さっさと帰れ!」<NEWLINE>");
      followEntity(Entity.Player, speed: 10);
      return;
    }
    if (pstat[103] == 39) {
      speak(Entity(5), "「ふーん!よくぞ来た、わが仲間よ。<NEWLINE> ここに住みたいなら許可を与えるが?」<NEWLINE>");
      setTrigger(Trigger(49));
      setDialogOwner(Entity.Player);
      setSelection(L1, L2);
      showTextbox("「ここに住みたい。」<NEWLINE>「元の姿に戻したい。」<NEWLINE>");
    }
    goto L3;

L1:
    unsetTrigger(Trigger(49));
    playSound(8, 20);
    speak(Entity(5), "「ふーん!よいぞよいぞ。ん?<NEWLINE> アナログのお前はだめだぞ。」<NEWLINE>");
    speak(Entity.Player, "「俺達はいっしょじゃないと困る!」<NEWLINE>");
    speak(Entity(5), "「ふん、それならいっしょに出て行け!」<NEWLINE>");
    followEntity(Entity.Player, speed: 10);
    return;

L2:
    unsetTrigger(Trigger(49));
    speak(Entity(5), "「な?何を言っておる?」<NEWLINE>");
    anim(Entity.Player, Animation(16), wait: 15);
    speak(Entity.Player, "「こいつはもともとスカモンじゃないんだ。<NEWLINE> 大王、元に戻してくれ!」<NEWLINE>");
    playAnimation(Entity.Player, Animation(0));
    speak(Entity(5), "「よかったではないか、スカモンになれて。」<NEWLINE>");
    speak(Entity.Player, "「いや、今はつごうが悪いんだ。頼むよ。」<NEWLINE>");
    speak(Entity(5), "「スカモンに自然になれると思ったら<NEWLINE> 大間違いだぞ。がんばったものだけが<NEWLINE> スカモンになれるというのに!」<NEWLINE>");
    speak(Entity.Player, "「(けっこう、自然にスカモンになったから<NEWLINE> 困ってんだよなー。)」<NEWLINE>");
    playSound(8, 20);
    speak(Entity(5), "「ふん、あきれた奴だ!もうよい、<NEWLINE> 貴様にはこれがお似合いだ!」<NEWLINE>");
  }
  if (pstat[200] == 39) {
    storeDigimonType(PStat(200));
    copyPStat(PStat(5), PStat(254));
  }
  fadeOutHUD();
  playAnimation(Entity(5), Animation(30));
  sfx(8, 19, wait: 60);
  callDigimonSubroutine(2);
  waitForEntity(Entity(201));
  anim(Entity(5), Animation(0), wait: 5);
  speak(Entity.Player, "「わぁ、大王ありがとう!」<NEWLINE>");
  playSound(8, 20);
  speak(Entity(5), "「さっさと出て行け!」<NEWLINE>");
  setTrigger(Trigger(363));
  followEntity(Entity.Player, speed: 10);
  return;

L3:
  playSound(8, 20);
  speak(Entity(5), "「ふん、わがはいに何か用か?」<NEWLINE>");
  speak(Entity.Player, "「えーと…」<NEWLINE>");
  speak(Entity(5), "「ふん、頼みごとなら聞かんぞ。<NEWLINE> わがはいはスカモンのための王だからな!」<NEWLINE>");
  speak(Entity.Player, "「(街にはさそえないか…。)」<NEWLINE>");
  followEntity(Entity.Player, speed: 10);
  return;
}

section(6) {
  if (trigger(362)) {
    speak(Entity(6), "「うーん、このオレはデジモンカードを<NEWLINE> 集めてるんだけどな。」<NEWLINE>");
    showTextbox("「スカモン大王様のカードが欲しいんだ。<NEWLINE> エテモンカードととっかえてくれないか?」<NEWLINE>");
    if (card[21] >= 1) {
      setDialogOwner(Entity.Player);
      setSelection(L1, L2);
      showTextbox("「とりかえる。」<NEWLINE>「とりかえない。」<NEWLINE>");
      waitForSelectionChoice();
      return;
    }
    speak(Entity.Player, "「悪いけど持ってないなあ。」<NEWLINE>");
    return;
  }
  anim(Entity.Player, Animation(24), wait: 15);
  speak(Entity.Player, "「うわっ強烈なニオイだな…<NEWLINE> もしかしてここはゴミの山ってやつ?<NEWLINE> デジモンの世界にもあるんだなあ。」<NEWLINE>");
  playAnimation(Entity.Player, Animation(0));
  storeDigimonType(PStat(103));
  if (!trigger(362) && pstat[103] == 39) {
    move(entity: Entity(6), to: (192, -2979), sprint: 0);
    waitForEntity(Entity(6));
    speak(Entity(6), "「うーん?これはようこそ。われわれは<NEWLINE> 新しい仲間をかんげいするゾ。」<NEWLINE>");
    speak(Entity.Player, "「ここはスカモン族の集落なのか?」<NEWLINE>");
    speak(Entity(6), "「いかにも。ここはスカモン族のパラダイス、<NEWLINE> ダストキングダムだ。スカモン大王様も<NEWLINE> ここにいらっしゃる。」<NEWLINE>");
    speak(Entity.Player, "「スカモン大王…」<NEWLINE>");
    speak(Entity(6), "「スカモン大王様はすごいのさ。<NEWLINE> 大王様にさからうと他の種族に変身<NEWLINE> させられてしまうのだ!」<NEWLINE>");
    speak(Entity.Player, "「おおおっ!?それってスカモンじゃなく<NEWLINE> なっちゃうわけか?(ってことは……<NEWLINE> 元に戻れるってことか!?)」<NEWLINE>");
    speak(Entity(6), "「ああ…うーん、恐い話だぜ。おぞましい。」<NEWLINE>");
    speak(Entity.Player, "「(いいことを聞いたぜ♪)」<NEWLINE>");
    move(entity: Entity(6), to: (189, -1273), sprint: 0);
    waitForEntity(Entity(6));
    setTrigger(Trigger(362));
    return;
  }
  if (!trigger(362) && trigger(550)) {
    move(entity: Entity(6), to: (192, -2979), sprint: 0);
    waitForEntity(Entity(6));
    speak(Entity.Player, "「あ、スカモン?!」<NEWLINE>");
    speak(Entity(6), "「うーん?この俺を知ってんのか?」<NEWLINE>");
    speak(Entity.Player, "「ま、まーね。(うーん、スカモンも街に<NEWLINE> 連れてかないといけないのかな…。)」<NEWLINE>");
  } else {
    move(entity: Entity(6), to: (192, -2979), sprint: 0);
    waitForEntity(Entity(6));
    speak(Entity(6), "「うーん?こりゃめずらしいゾ!」<NEWLINE>");
    speak(Entity.Player, "「げ、ウンチが動いてしゃべってる!」<NEWLINE>");
    speak(Entity(6), "「うーん?このオレのことか?オレは<NEWLINE> ミュータントデジモンのスカモンだ。」<NEWLINE>");
    speak(Entity.Player, "「ウンチじゃないの?」<NEWLINE>");
    speak(Entity(6), "「それはあるイミ正しい。オレたちは、<NEWLINE> デジタルデータのカスで出来てるからな。」<NEWLINE>");
    speak(Entity.Player, "「(うむ…こいつも街にさそうべきか?<NEWLINE> いや、差別は良くないよな。)」<NEWLINE>");
  }
  speak(Entity(6), "「おめーら、ここでくらすつもりか?」<NEWLINE>");
  speak(Entity.Player, "「え?ぜんぜんそんなこと考えてないけど。」<NEWLINE>");
  speak(Entity(6), "「うーん、ここはスカモン族だけの<NEWLINE> パラダイスだ。<NEWLINE> 悪いが他の種族の者はくらせないゾ。」<NEWLINE>");
  speak(Entity.Player, "「じゃあおまえはよそではくらせないと?」<NEWLINE>");
  speak(Entity(6), "「あったりめージャン!」<NEWLINE>");
  speak(Entity.Player, "「あ、そう、やっぱり…?(ホッ。)」<NEWLINE>");
  speak(Entity(6), "「うーん?ここでくらすのはダメだけど、<NEWLINE> 見学ならかまわんゾ、お客人。」<NEWLINE>");
  speak(Entity.Player, "「あ、ああ、見るだけね。」<NEWLINE>");
  speak(Entity(6), "「ああ、そうだ、大王様をおこらせては<NEWLINE> だめだゾ。大王様の変身の術で<NEWLINE> みじめなすがたにされても知らんゾ!」<NEWLINE>");
  move(entity: Entity(6), to: (189, -1273), sprint: 0);
  waitForEntity(Entity(6));
  setTrigger(Trigger(362));
  return;

L1:
  if (card[14] >= 9) {
    speak(Entity(6), "「おいおい、エテモンカードの<NEWLINE> 持ちすぎだって!やめときな。」<NEWLINE>");
    return;
  }
  speak(Entity(6), "「おお、サンキュー!」<NEWLINE>");
  takeCard(21);
  giveCard(14);
  return;

L2:
  return;
}

section(7) {
  if (!trigger(239)) {
    setTrigger(Trigger(239));
    addPStat(PStat(1), 1);
    speak(Entity(7), "「うーん、ちょっとキミたち。<NEWLINE> 街とやらから来たのかい?」<NEWLINE>");
    showTextbox("「うーん、ここだけの話、<NEWLINE> オレすこしキョーミあるんよね。」<NEWLINE>");
    showTextbox("「そのうちおじゃまするよ。」<NEWLINE>");
    return;
  }
  speak(Entity(7), "「うーん、ちょっとキミたち。<NEWLINE> スカモン族の得意技、知ってるかな?」<NEWLINE>");
  showTextbox("「道ばたのウンチを体内にとりこんで、<NEWLINE> エネルギーに変えちゃうのさ!」<NEWLINE>");
  return;
}

section(8) {
  speak(Entity(8), "「うーん?ここはダストキングダム。<NEWLINE> きみらにしてみりゃゴミの山だけど。」<NEWLINE>");
  showTextbox("「でも役に立つ物も落ちてるかもな。<NEWLINE> そういや、長いさおみたいな物を<NEWLINE> あっちで見かけたゾ。」<NEWLINE>");
  return;
}

section(51) {
  if (!trigger(45)) {
    speak(Entity.Player, "「おっ、<LIGHTBLUE>ぼろいつりざお<WHITE>だ!」<NEWLINE>");
    delay(10);
    anim(Entity.Player, Animation(12), wait: 10);
    playSound(0, 7);
    setObjectVisibility(10, 1);
    delay(10);
    setTrigger(Trigger(45));
    setTrigger(Trigger(320));
  }
  return;
}

section(82) {
  rotate(entity: Entity.Player, to: 2640);
  setTextboxOrigin(1484, 0, -241);
  callSubroutine(39);
  speak(Entity(200), " <NEWLINE><GREEN>     トレーニング・ゴミがくれ<WHITE><NEWLINE>");
  setSelection(L1, L2, L3);
  showTextbox("トレーニング開始<NEWLINE>このトレーニングの説明<NEWLINE>やめる<NEWLINE>");
  waitForSelectionChoice();
  return;

L1:
  setDialogOwner(Entity(200));
  setSelection(L4, L5, L3);
  showTextbox("ノーマルトレーニング<NEWLINE>ボーナストライトレーニング<NEWLINE>やっぱりやめる<NEWLINE>");
  waitForSelectionChoice();
  return;

L2:
  speak(Entity(200), "汚いゴミにうずもれて精神力の<NEWLINE>たん練をします。<NEWLINE>最大MPが大きくアップします。<NEWLINE>");
  setSelection(L2, L1, L3);
  showTextbox("もう一度説明<NEWLINE>トレーニング開始<NEWLINE>やめる<NEWLINE>");
  waitForSelectionChoice();
  return;

L3:
  return;

L4:
  fadeOutHUD();
  setPStat(PStat(254), 4);
  setPStat(PStat(246), 0);
  callDigimonSubroutine(214);
  callSubroutine(7);
  return;

L5:
  setTexboxMode(1, 0);
  speak(Entity.System, "       <YELLOW>スロットゲーム<WHITE><NEWLINE> <NEWLINE>   <ORANGE><CIRCLE><WHITE><ボき><ヌン>で3つのスロットを止めて、<NEWLINE>    うまく絵をそろえてください。<NEWLINE>");
  setPStat(PStat(254), 4);
  setPStat(PStat(246), 1);
  callDigimonSubroutine(214);
  callSubroutine(7);
  setTexboxMode(0, 0);
  return;
  garbage { 24 00 fe 00 24 00 05 00 4e 00 51 00 54 00 06 00 b8 05 07 00 84 0e 08 00 da 0f 33 00 92 10 52 00 e8 10 ff ff 19 00 01 00 40 01 18 00 38 00 19 00 57 00 0a 00 16 00 3c 00 57 00 0a 01 19 00 01 00 6a 01 18 00 4c 00 19 00 16 00 b8 05 fe 00 16 00 54 00 fe 00 4f 0a 89 fb 16 06 4c 00 fd 05 4c 00 fc 05 4c 00 05 fd 67 00 05 00 22 67 19 00 00 00 6b 01 88 00 67 27 18 00 08 01 19 00 5a 00 08 14 1b 05 1a 00 81 75 82 d3 82 f1 81 49 82 dc 82 bd 82 a8 91 4f 82 a9 81 49 82 b3 82 c1 82 b3 82 c6 8b 41 82 ea 81 49 81 76 0d 00 00 00 56 00 fd 10 67 00 0f 00 1b fd 1a 00 81 75 82 a0 82 cc 81 5b 81 63 81 76 0d 00 00 00 56 00 fd 00 1b 05 1a 00 81 75 82 a6 82 a6 82 a2 81 41 82 b5 82 c2 82 b1 82 a2 82 cc 82 a4 81 49 82 b1 82 ea 82 c5 82 e6 82 a2 82 a9 81 49 81 76 0d 00 00 00 16 00 7e 04 50 00 fd 0a 4a c8 fe 00 19 00 00 00 6b 01 18 00 4c 01 19 00 5a 00 08 14 1b 05 1a 00 81 75 82 d3 82 f1 81 49 82 dc 82 bd 82 a8 91 4f 82 a9 81 49 82 b3 82 c1 82 b3 82 c6 8b 41 82 ea 81 49 81 76 0d 00 00 00 50 00 fd 0a 4a c8 fe 00 19 00 08 00 67 27 18 00 e8 01 19 00 1b 05 1a 00 81 75 82 d3 81 5b 82 f1 81 49 82 e6 82 ad 82 bc 97 88 82 bd 81 41 82 ed 82 aa 92 87 8a d4 82 e6 81 42 0d 00 81 40 82 b1 82 b1 82 c9 8f 5a 82 dd 82 bd 82 a2 82 c8 82 e7 8b 96 89 c2 82 f0 97 5e 82 a6 82 e9 82 aa 81 48 81 76 0d 00 00 00 1c 00 31 00 1b fd 10 02 ec 01 98 02 1a 00 81 75 82 b1 82 b1 82 c9 8f 5a 82 dd 82 bd 82 a2 81 42 81 76 0d 00 81 75 8c b3 82 cc 8e 70 82 c9 96 df 82 b5 82 bd 82 a2 81 42 81 76 0d 00 00 00 16 00 fa 04 1d 00 31 00 5a 00 08 14 1b 05 1a 00 81 75 82 d3 81 5b 82 f1 81 49 82 e6 82 a2 82 bc 82 e6 82 a2 82 bc 81 42 82 f1 81 48 0d 00 81 40 83 41 83 69 83 8d 83 4f 82 cc 82 a8 91 4f 82 cd 82 be 82 df 82 be 82 bc 81 42 81 76 0d 00 00 00 1b fd 1a 00 81 75 89 b4 92 42 82 cd 82 a2 82 c1 82 b5 82 e5 82 b6 82 e1 82 c8 82 a2 82 c6 8d a2 82 e9 81 49 81 76 0d 00 00 00 1b 05 1a 00 81 75 82 d3 82 f1 81 41 82 bb 82 ea 82 c8 82 e7 82 a2 82 c1 82 b5 82 e5 82 c9 8f 6f 82 c4 8d 73 82 af 81 49 81 76 0d 00 00 00 50 00 fd 0a 4a c8 fe