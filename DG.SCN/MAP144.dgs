// MAP144.SCN
#include "functions.dgs"
#pragma script index=144 start=0x65800 end=0x66000 headerU16=0x24 sentinelOff=0x19
#include "entities.dgs"

section onEnter(254) {
  if (trigger(270)) goto L1;
  roll(pstat: 110, max: 2);
  goto L2;

L1:
  setPStat(110, 3);

L2:
  return;
}

section(81) {
  move(entity: Entity.Player, to: (-996, 694), sprint: 0);
  waitForEntity(Entity.Player);
  if (pstat[110] != 0 && pstat[110] != 3) goto L1;
  rotate(entity: Entity.Player, to: 2048);
  delay(5);
  rotate3DObject(0, 1);
  delay(20);
  move(entity: Entity.Player, to: (-890, 3131), sprint: 0);
  warp(to: Map.OMOC08, spawn: 0, trigger: 255);

L1:
  move(entity: Entity.Partner, to: Entity.Player, sprint: 1);
  waitForEntity(Entity.Partner);
  rotate(entity: Entity.Player, to: 2048);
  rotate(entity: Entity.Partner, to: 2048);
  delay(5);
  playSound(0, 11);
  delay(10);
  setObjectVisibility(0, 0);
  setPStatThenSetPStatThenCallSubroutine(0, 1);
  moveObjectTo(0, 0, 1, 8, 0, 28, 68);
  delay(5);
  playAnimation(Entity.Player, 17);
  playAnimation(Entity.Partner, 40);
  playSound(8, 13);
  setObjectVisibility(0, 1);
  moveObjectTo(0, 0, 1, 2, 0, 28, -32);
  for id in 3..7 {
    setObjectVisibility(id, 0);
  }
  setPStatThenSetPStatThenCallSubroutine(3, 5);
  delay(15);
  for id in 3..7 {
    setObjectVisibility(id, 1);
  }
  for id in 18..33 {
    setObjectVisibility(id, 0);
  }
  setPStatThenSetPStatThenCallSubroutine(18, 16);
  setPStat(200, 10);
  dealMapDamage(200);
  delay(10);
  for id in 18..33 {
    setObjectVisibility(id, 1);
  }
  delay(20);
  return;
}

