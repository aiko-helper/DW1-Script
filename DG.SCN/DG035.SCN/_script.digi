; DG035.SCN
;!script index=35 start=0x1e000 end=0x1e800 headerU16=0x28 sentinelOff=0x24
;!sections onEnter section_6 section_7 section_8 section_9 section_10 section_11 section_5 section_51

onEnter:     ; len=112
  0000:  storeRandom 110 99
  0004:  if pstat[110] > 9 then onEnter+0x16
  0010:  spawnItem Digimushroom 56 78
  0016:  storeRandom 110 99
  001a:  if pstat[110] > 19 then onEnter+0x2c
  0026:  spawnItem Digimushroom 24 44
  002c:  storeRandom 110 99
  0030:  if pstat[110] > 4 then onEnter+0x42
  003c:  spawnItem SuperVeggy 36 24
  0042:  storeRandom 110 99
  0046:  if pstat[110] > 2 then onEnter+0x58
  0052:  spawnItem Happymushroom 79 6
  0058:  if !trigger(348) OR trigger(128) then onEnter+0x6e
  0068:  spawnItem Steak 48 32
  006e:  endSection
