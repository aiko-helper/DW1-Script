// DG036.SCN
#include "functions.dgs"
#pragma script index=36 start=0x1d000 end=0x1d800 headerU16=0x2c sentinelOff=0x24
#include "entities.dgs"

section onEnter(254) {
  spawnItemChance(max: 99, chance: 9, item: Item.Digimushroom, x: 49, y: 64);
  spawnItemChance(max: 99, chance: 14, item: Item.Digimushroom, x: 19, y: 31);
  spawnItemChance(max: 99, chance: 4, item: Item.Pricklypear, x: 20, y: 9);
  spawnItemChance(max: 99, chance: 0, item: Item.DeluxeMushroom, x: 69, y: 16);
  return;
}

section(5) {
  speak(Entity(5), "「や、やめません?」<NEWLINE>");
  finishEncounter(Trigger(299));
}

section(6) {
  speak(Entity(6), "「シュハ~シュハ~!」<NEWLINE>");
  finishEncounter(Trigger(302));
}

section(7) {
  speak(Entity(7), "「シュッシュッ!」<NEWLINE>");
  finishEncounter(Trigger(302));
}

section(8) {
  speak(Entity(8), "「本気でいかしてもらいまひょ!」<NEWLINE>");
  finishEncounter(Trigger(268));
}

section(9) {
  speak(Entity(9), "「何いってまんねん?」<NEWLINE>");
  finishEncounter(Trigger(268));
}

section(81) {
  speak(Entity.System, "北西・フリーズランド<NEWLINE>");
  return;
}

section(82) {
  {
    rotate(entity: Entity.Player, to: 2048);
    delay(5);
    speak(Entity.System, " <NEWLINE>       エレベーター<NEWLINE>");
    setDialogOwner(Entity.Player);
    setSelection(L1, L2, L3);
    showTextbox("上ボタンを押す<NEWLINE>下ボタンを押す<NEWLINE>乗らない<NEWLINE>");
    waitForSelectionChoice();
    break;
    return;

L1:
    playSound(8, 4);
    rotate3DObject(0, 1);
    delay(1);
    rotate3DObject(1, 1);
    delay(1);
    rotate3DObject(0, 1);
    delay(1);
    rotate3DObject(1, 1);
    delay(1);
    rotate3DObject(0, 1);
    delay(1);
    rotate3DObject(1, 1);
    delay(1);
    rotate3DObject(0, 1);
    delay(1);
    rotate3DObject(1, 1);
    delay(1);
    rotate3DObject(0, 1);
    delay(1);
    rotate3DObject(1, 1);
    delay(1);
    playSound(8, 5);
    warp(to: Map.GCAN10, spawn: 0, trigger: 52);
    return;

L2:
    fadeOutHUD();
    if (!trigger(155)) {
      speak(Entity.Player, "「あれ?」<NEWLINE>");
      showTextbox("「だめだ、反応がない。」<NEWLINE>");
      return;
    } else {
      playSound(8, 4);
      rotate3DObject(0, 1);
      delay(1);
      rotate3DObject(1, 1);
      delay(1);
      rotate3DObject(0, 1);
      delay(1);
      rotate3DObject(1, 1);
      delay(1);
      rotate3DObject(0, 1);
      delay(1);
      rotate3DObject(1, 1);
      delay(1);
      rotate3DObject(0, 1);
      delay(1);
      rotate3DObject(1, 1);
      delay(1);
      rotate3DObject(0, 1);
      delay(1);
      rotate3DObject(1, 1);
      delay(1);
      playSound(8, 5);
      warp(to: Map.GCAN06, spawn: 2, trigger: 53);
      return;
    }
    return;

L3:
  }
  return;
}

section(55) {
  playSound(8, 5);
  return;
}

section(51) {
  move(entity: Entity.Player, to: (2100, -4000), sprint: 0);
  if (trigger(142)) {
    warp(to: Map.GCAN08_2, spawn: 1, trigger: 255);
  }
  warp(to: Map.GCAN08_1, spawn: 1, trigger: 255);
  return;
