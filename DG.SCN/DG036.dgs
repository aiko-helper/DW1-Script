// DG036.SCN
#pragma script index=36 start=0x1e800 end=0x1f000 headerU16=0x24 sentinelOff=0x24

function playAnimationThenDelayThenSpeak(a, b) {
    playAnimation(Entity.Player, a);
    delay(15);
    speak(Entity.Player, b);
}

function speakThenStartBattleThenSetTrigger(a, b) {
    speak(a, b);
    startBattle();
    setTrigger(280);
}


section onEnter(254) {
    roll(pstat: 110, max: 99);
    if (pstat[110] > 9) goto L1;
    spawnItem(Item.Digimushroom, x: 36, y: 68);

L1:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 5) goto L2;
    spawnItem(Item.Digimushroom, x: 83, y: 78);

L2:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 14) goto L3;
    spawnItem(Item.Digimushroom, x: 25, y: 17);

L3:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 2) goto L4;
    spawnItem(Item.Happymushroom, x: 78, y: 60);

L4:
    return;
}

section(5) {
    speakThenStartBattleThenSetTrigger(5, "Hey!\n");
    return;
}

section(6) {
    speakThenStartBattleThenSetTrigger(6, "Don't make me mad!\n");
    return;
}

section(7) {
    speakThenStartBattleThenSetTrigger(7, "You think that's funny?!\n");
    return;
}

section(8) {
    speakThenStartBattleThenSetTrigger(8, "Come on let's go for it!\n");
    return;
}

section(51) {
    if (trigger(124)) goto L1;
    playAnimationThenDelayThenSpeak(15, "Oh no, it's dangerous!\n");
    move(entity: Entity.Player, to: (73, 971), sprint: 1, withCamera: true);
    waitForEntity(Entity.Player);

L1:
    goto section_53.L1;
}

section(52) {
    if (trigger(124)) goto L1;
    playAnimationThenDelayThenSpeak(15, "Oh no, it's dangerous!\n");
    move(entity: Entity.Player, to: (-782, 1580), sprint: 1, withCamera: true);
    waitForEntity(Entity.Player);

L1:
    goto section_53.L1;
}

section(53) {
    if (trigger(124)) goto L1;
    playAnimationThenDelayThenSpeak(15, "Oh no, it's dangerous!\n");
    move(entity: Entity.Player, to: (856, 1137), sprint: 1, withCamera: true);
    waitForEntity(Entity.Player);
    moveCamera(to: Entity.Player, speed: 10);
    waitForEntity(200);

L1:
    if (trigger(103) || !trigger(124)) goto L2;
    rotate(entity: Entity.Player, to: 2000);
    delay(10);
    playAnimationThenDelayThenSpeak(24, "Is there really an\ninvisible bridge here?\n");
    playAnimation(Entity.Player, 0);
    speak(Entity.Player, "What?\n");
    move(entity: Entity.Player, to: (66, 3240), sprint: 0, withCamera: true);
    delay(20);
    move(entity: Entity.Partner, to: (30, 2646), sprint: 0);
    waitForEntity(Entity.Player);
    waitForEntity(Entity.Partner);
    speak(Entity.Player, "Hey, I can walk over this!\n");
    setTrigger(103);

L2:
    return;
