  018e:  pstat[254] = 14
  0192:  callDigimonSubroutine 10
  0194:  waitForEntity System
  0196:  delay 10
  019a:  speak Player "What? Did you turn into\nanother Digimon?\nIt's kinda nice.\n"
  0214:  endSection
  0216:  speak Player " <ORANGE><DIGIMON><WHITE>,\ndo you want to get in?\n"
  0256:  lookAt Player Partner
  025a:  entityWalkTo Partner 900 90 0
