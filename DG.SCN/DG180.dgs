// DG180.SCN
#include "functions.dgs"
#pragma script index=180 start=0x85800 end=0x86000 headerU16=0x10 sentinelOff=0x6722
#include "entities.dgs"

section onEnter(254) {
    // (empty)
}

section(51) {
  storeDigimonType(PStat(103));
  if (pstat[103] == 1 || pstat[103] == 2 || pstat[103] == 3 || pstat[103] == 4) {
    jumpToScriptSection(201, 5);
  }
  if (pstat[103] == 15 || pstat[103] == 16 || pstat[103] == 17 || pstat[103] == 18) {
    jumpToScriptSection(201, 5);
  }
  if (pstat[103] == 29 || pstat[103] == 30 || pstat[103] == 31 || pstat[103] == 32) {
    jumpToScriptSection(201, 5);
  }
  if (pstat[103] == 43 || pstat[103] == 44 || pstat[103] == 45 || pstat[103] == 46) {
    jumpToScriptSection(201, 5);
  }
  if (!trigger(87) && !trigger(205) && pstat[1] >= 15) {
    setTrigger(Trigger(87));
  }
  if (!trigger(354) && pstat[1] >= 50 && trigger(205)) {
    setTrigger(Trigger(354));
    speak(Entity(5), "「待っておったぞ<LIGHTBLUE><PLAYER><WHITE>。<NEWLINE> ついに、この日が来たのじゃ。」<NEWLINE>");
    speak(Entity.Player, "「どうしたんだ?」<NEWLINE>");
    speak(Entity(5), "「ムゲンマウンテンへの入り口が<NEWLINE> 現われたのじゃ。」<NEWLINE>");
    speak(Entity.Player, "「え?そうなの。どこに?」<NEWLINE>");
    speak(Entity(5), "「この街の…滝のむこうじゃ。」<NEWLINE>");
    speak(Entity.Player, "「げっ、めちゃ近いじゃん!」<NEWLINE>");
    speak(Entity(5), "「わしの見たところ、どうやら<NEWLINE> ムゲンマウンテンに最後の敵が<NEWLINE> いるようじゃ。」<NEWLINE>");
    speak(Entity.Player, "「ラスト・ダンジョンってことか。<NEWLINE> やってやるぜ!」<NEWLINE>");
    speak(Entity(5), "「うむ、がんばってくれ!<NEWLINE> しかし、あせってはいかんぞ。準備が<NEWLINE> ととのうまではムチャをするでない。」<NEWLINE>");
    return;
  }
  if (trigger(354) && !trigger(50) && trigger(205)) {
    speak(Entity(5), "「街の滝のむこうにムゲンマウンテンへの<NEWLINE> 入り口が現われておる。」<NEWLINE>");
    speak(Entity(5), "「わしの見たところ、どうやら<NEWLINE> ムゲンマウンテンに最後の敵が<NEWLINE> いるようじゃ。」<NEWLINE>");
    showTextbox("「準備を万全にして行くのじゃぞ!」<NEWLINE>");
    showTextbox("「それはともかく…」<NEWLINE>");
  }
  jumpToScriptSection(201, 5);
}

section(77) {
  speak(Entity(5), "「今の街のはんえい度は<UNKNOWN1>じゃ。」<NEWLINE>");
  if (pstat[1] <= 10) {
    speak(Entity(5), "「まだまだ昔のすがたにはほど遠いのう。」<NEWLINE>");
    return;
  }
  if (pstat[1] <= 30) {
    speak(Entity(5), "「ようやく形になってきた感じかの。」<NEWLINE>");
    return;
  }
  if (pstat[1] <= 50) {
    speak(Entity(5), "「なかなか発展してきたのう。」<NEWLINE>");
    return;
  }
  if (pstat[1] <= 70) {
    speak(Entity(5), "「りっぱな街になったのう。」<NEWLINE>");
    return;
  }
  if (pstat[1] <= 99) {
    speak(Entity(5), "「よくぞここまでりっぱに…すごいのう!」<NEWLINE>");
    return;
  }
  {
    if (pstat[1] > 100) break;
    speak(Entity(5), "「もうワシが言うことは何もない。<NEWLINE> すばらしいぞい!」<NEWLINE>");
    if (stat[Stat.TamerLevel] == 10 || trigger(216)) break;
    addStats(tamerLevel: 1);
    speak(Entity.System, " <NEWLINE> <YELLOW>テイマーレベルが上がった!!!<WHITE><NEWLINE>");
    setTrigger(Trigger(216));
    setTrigger(Trigger(375));
    playSound(0, 7);
    speak(Entity.System, " <YELLOW>おめでとうございます!<NEWLINE> あなたのすばらしい功績に対して<NEWLINE> メダルがおくられました!<WHITE><NEWLINE>");
  }
  return;
  garbage { 10 00 fe 00 10 00 33 00 10 00 4d 00 c0 03 ff ff 22 67 19 00 08 00 67 01 48 00 67 02 48 00 67 03 48 00 67 04 18 00 30 00 19 00 17 00 c9 00 05 00 19 00 08 00 67 0f 48 00 67 10 48 00 67 11 48 00 67 12 18 00 4e 00 19 00 17 00 c9 00 05 00 19 00 08 00 67 1d 48 00 67 1e 48 00 67 1f 48 00 67 20 18 00 6c 00 19 00 17 00 c9 00 05 00 19 00 08 00 67 2b 48 00 67 2c 48 00 67 2d 48 00 67 2e 18 00 8a 00 19 00 17 00 c9 00 05 00 19 00 01 00 57 00 81 00 cd 00 8a 00 01 0f 18 00 a2 00 19 00 1c 00 57 00 19 00 01 00 62 01 8a 00 01 32 80 00 cd 00 18 00 c2 02 19 00 1c 00 62 01 1b 05 1a 00 81 75 91 d2 82 c1 82 c4 82 a8 82 c1 82 bd 82 bc 01 06 05 00 01 01 81 42 0d 00 81 40 82 c2 82 a2 82 c9 81 41 82 b1 82 cc 93 fa 82 aa 97 88 82 bd 82 cc 82 b6 82 e1 81 42 81 76 0d 00 00 00 1b fd 1a 00 81 75 82 c7 82 a4 82 b5 82 bd 82 f1 82 be 81 48 81 76 0d 00 00 00 1b 05 1a 00 81 75 83 80 83 51 83 93 83 7d 83 45 83 93 83 65 83 93 82 d6 82 cc 93 fc 82 e8 8c fb 82 aa 0d 00 81 40 8c bb 82 ed 82 ea 82 bd 82 cc 82 b6 82 e1 81 42 81 76 0d 00 00 00 1b fd 1a 00 81 75 82 a6 81 48 82 bb 82 a4 82 c8 82 cc 81 42 82 c7 82 b1 82 c9 81 48 81 76 0d 00 00 00 1b 05 1a 00 81 75 82 b1 82 cc 8a 58 82 cc 81 63 91 ea 82 cc 82 de 82 b1 82 a4 82 b6 82 e1 81 42 81 76 0d 00 00 00 1b fd 1a 00 81 75 82 b0 82 c1 81 41 82 df 82 bf 82 e1 8b df 82 a2 82 b6 82 e1 82 f1 81 49 81 76 0d 00 00 00 1b 05 1a 00 81 75 82 ed 82 b5 82 cc 8c a9 82 bd 82 c6 82 b1 82 eb 81 41 82 c7 82 a4 82 e2 82 e7 0d 00 81 40 83 80 83 51 83 93 83 7d 83 45 83 93 83 65 83 93 82 c9 8d c5 8c e3 82 cc }
}
