// DG180.SCN
#pragma script index=180 start=0x8a000 end=0x8b000 headerU16=0x1c sentinelOff=0x19

section onEnter(254) {  // len=38
    if (trigger(340)) goto L1;
    goto section_52;

L1:
    if (!trigger(341) || trigger(211)) goto L2;
    goto section_6;

L2:
    return;
}

section(51) {  // len=24
    move(entity: Entity.Player, to: (1482, -663), sprint: 0);
    waitForEntity(Entity.Player);
    move(entity: Entity.Player, to: (551, 87), sprint: 0);
    warp(to: Map.FACT11A, spawn: 1, trigger: 255);
    return;
}

section(5) {  // len=522
    if (trigger(342)) goto L1;
    setTrigger(342);
    speak(5, "I don't feel well.\n");
    speak(Entity.Player, "Are you alright?\n");
    speak(5, "I don't feel good.\n");
    speak(Entity.Player, "Is this where you live?\n");
    speak(5, "I feel sick. No energy.\n");
    speak(Entity.Player, "You look awful.\n");

L1:
    speak(5, "It's getting worse.\n");
    speak(Entity.Player, "I have to figure out why.\n");
    speak(Entity.Player, "Where is this drainage\ncoming from?\nI'm gonna check it out!\n");
    return;
}

section(52) {  // len=230
    setTrigger(340);
    delay(20);
    move(entity: Entity.Player, to: (1931, -482), sprint: 0, withCamera: true);
    move(entity: Entity.Partner, to: (1822, -891), sprint: 0);
    waitForEntity(Entity.Player);
    waitForEntity(Entity.Partner);
    speak(Entity.Player, "What's this?\n");
    playAnimation(Entity.Partner, 23);
    delay(40);
    look(entity: Entity.Player, at: Entity.Partner);
    delay(5);
    speak(Entity.Player, "What happened, <ORANGE><DIGIMON><WHITE>?!\n");
    playAnimation(Entity.Player, 16);
    delay(20);
    speak(Entity.Player, "This fog stinks!\n");
    speak(Entity.Player, "It's weird, kinda nasty.\n");
    return;
}

section(6) {  // len=1398
    delay(20);
    speak(Entity.Player, "Good, the sewer is\nback to normal.\n");
    showTextbox("He'll be alright now.\nI solved the problem.\n");
    moveCamera(to: (2381, -698), slowdown: 20);
    waitForEntity(200);
    playSound(8, 13);
    playAnimation(6, 15);
    delay(20);
    speak(Entity.Player, "Something's wrong!\n");
    look(entity: 6, at: Entity.Player);
    delay(10);
    playSound(8, 11);
    playAnimation(6, 28);
    playSound(8, 13);
    delay(40);
    speak(6, "Da da da!\n");
    setTrigger(1);
    setPStat(250, 1);
    setPStat(251, 6);
    setPStat(252, 255);
    setPStat(253, 255);
    startBattle();
    unsetTrigger(1);
    setPStat(250, 0);
    move(entity: Entity.Player, to: (2387, -771), sprint: 0);
    move(entity: Entity.Partner, to: (1865, -772), sprint: 0);
    move(entity: 6, to: (2795, -771), sprint: 0);
    waitForEntity(Entity.Player);
    waitForEntity(Entity.Partner);
    waitForEntity(6);
    look(entity: Entity.Player, at: 6);
    look(entity: 6, at: Entity.Player);
    look(entity: Entity.Partner, at: 6);
    delay(5);
    speak(6, "I'm tired.\nWhat happened to you guys?\n");
    speak(Entity.Player, "He sounds dumber!\nMaybe he regained his senses.\n");
    speak(6, "Are you calling me dumb?\nHow rude! My name is Numemon.\n");
    speak(Entity.Player, "If you're not dumb,\nwhat are you?\n");
    showTextbox("Excuse me, Numemon. Do you\nknow who saved your life?\n");
    speak(6, "Huh? Do you want me to\nsave your life? OK.\n");
    speak(Entity.Player, "Ugghh. He doesn't get it\nat all! Well, no matter.\n");
    speak(6, "Hey, I'll be a savior. Cool!\n");
    setDialogOwner(Entity.Player);
    playAnimation(Entity.Player, 19);
    delay(15);
    showTextbox("Please come to our city.\nDo you know where it is?\n");
    playAnimation(Entity.Player, 0);
    speak(6, "I know a little.\n");
    goto L1;

L1:
    move(entity: 6, to: (-137, 34), sprint: 1);
    if (pstat[101] >= 6) goto L2;
    addPStat(101, 1);
    delay(10);
    look(entity: Entity.Player, at: 6);
    look(entity: Entity.Partner, at: 6);
    goto L1;

L2:
    waitForEntity(6);
    unloadEntity(6);
    setPStat(101, 0);
    playSound(8, 10);
    speak(Entity.System, "Numemon joins the city!\n");
    moveCamera(to: Entity.Player, speed: 10);
    waitForEntity(200);
    setTrigger(211);
    addPStat(1, 1);
    return;
}

section(7) {  // len=1856
    delay(10);
    playAnimation(7, 28);
    delay(10);
    speak(Entity.Player, "Who is it?!\n");
    speak(7, "Who are you?!\n");
    rotate(entity: 7, to: 1276);
    delay(5);
    rotate(entity: 7, to: 2300);
    delay(5);
    rotate(entity: 7, to: 3324);
    delay(5);
    rotate(entity: 7, to: 252);
    delay(5);
    rotate(entity: 7, to: 1276);
    delay(5);
    rotate(entity: 7, to: 2300);
    delay(5);
    rotate(entity: 7, to: 3324);
    delay(5);
    rotate(entity: 7, to: 252);
    delay(5);
    move(entity: 7, to: (2392, -114), sprint: 1);
    waitForEntity(7);
    unloadEntity(7);
    if (pstat[21] != 0) goto L1;
    setObjectVisibility(23, 0);
    move(entity: Entity.Player, to: (2068, 760), sprint: 1);
    waitForEntity(Entity.Player);
    playAnimation(Entity.Player, 12);
    delay(10);
    setObjectVisibility(23, 1);
    playSound(0, 7);
    speak(Entity.System, "I got a <PINK>Dimensional\nKey Chain<WHITE>! I can now\nhold up to twenty Items!\n");
    playSound(0, 7);
    setInventorySize(20);
    setTrigger(47);

L1:
    if (pstat[21] != 4) goto L2;
    setObjectVisibility(22, 0);
    move(entity: Entity.Player, to: (2068, 760), sprint: 1);
    waitForEntity(Entity.Player);
    playAnimation(Entity.Player, 12);
    delay(10);
    setObjectVisibility(22, 1);
    playSound(0, 7);
    speak(Entity.System, "I got a <PINK>Dimensional\nKey Chain<WHITE>! I can now\nhold up to thirty Items!\n");
    setTrigger(48);
    setInventorySize(30);
    setTrigger(253);
    addPStat(1, 1);

L2:
    addPStat(21, 1);
    setTrigger(336);
    return;
