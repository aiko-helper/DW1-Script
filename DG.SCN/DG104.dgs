// DG104.SCN
#include "functions.dgs"
#pragma script index=104 start=0x4a000 end=0x4b000 headerU16=0x1c sentinelOff=0xfe
#include "entities.dgs"

section onEnter(254) {
  return;
}

section(5) {
  speak(5, "I want to beat Kabuterimon.\nWhat do I need to do to win?\n");
  setDialogOwner(Entity.Player);
  choice { "Hmm. You gotta get stronger." -> L1, "Actually, there is a sure fire" -> L2, "way.... well, hang in there." -> L4 }
  goto L4;

L1:
  speak(5, "I see. Alright, I'll train.\n");
  return;

L2:
  speak(5, "Really?! Then I'll train you!\n");
  playAnimation(Entity.Player, 19);
  delay(15);
  speak(Entity.Player, "Just come to the city.\n");
  playAnimation(Entity.Player, 0);
  speak(5, "...\n");
  showTextbox("You're really nice.\nI'll go to the city.\n");
  goto L3;

L3:
  loop {
    move(entity: 5, to: (664, -1963), sprint: 1);
    if (pstat[101] >= 3) break;
    addPStat(101, 1);
    delay(20);
    look(entity: Entity.Player, at: 5);
    look(entity: Entity.Partner, at: 5);
  }
  waitForEntity(5);
  unloadEntity(5);
  setPStat(101, 0);
  playSound(8, 17);
  speak(Entity.System, "Kuwagamon went to the city!\n");
  setTrigger(251);
  addPStat(1, 2);
  return;

L4:
  speak(5, "Man, you're not nice.\nI'm disappointed!\n");
  return;
}

section(6) {
  if (!trigger(346)) goto L1;
  speak(6, "Hey, you've been in these\nbug battle contests, right?\n");
  showTextbox("Well, I'll teach you\nsomething useful.\n");
  showTextbox("Do you know where Kunemon\nsleeps? In Native Forest?\n");
  showTextbox("Kid Digimons sleep there.\nWhen they wake up, they\nbecome Kunemon.\n");
  showTextbox("But, sometimes they don't.\nIt's a matter of luck.\n");
  return;

L1:
  storeDigimonType(103);
  if (pstat[103] != 19 && pstat[103] != 32 && pstat[103] != 51 && pstat[103] != 60) goto L2;
  goto L3;

L2:
  speak(6, "Hey, you've been in these\nbug battle contests, right?\n");
  showTextbox("Uh...The way you are now,\nyou won't make it.\n");
  showTextbox("Well, I'll teach you\nsomething useful.\n");
  showTextbox("Do you know where Kunemon\nsleeps? In Native Forest.\n");
  showTextbox("Kid Digimons sleep there.\nWhen they wake up, they\nbecome Kunemon.\n");
  showTextbox("But sometimes they don't.\nIt's a matter of luck.\n");
  return;

L3:
  speak(6, "Hey, do you want to enter the\nbug battle contest?\n");
  speak(Entity.Player, "What's that?\n");
  speak(6, "You gotta sign up by ten\no'clock on the twenty second.\n");
  speak(Entity.Player, "Huh???\n");
  speak(6, "You'll get the details\nthe day of the contest.\n");
  speak(6, "I wonder what he's?\ntalking about?\n");
  return;
}

section(7) {
  speak(7, "We will train hard, but\nwe must rest too.\n");
  showTextbox("Shall we rest for an hour?\n");
  setDialogOwner(Entity.Player);
  choice { "Let's rest" -> L1, "No rest" -> L2 }
  return;

L1:
  pstat[:SavedTime] = time();
  addMinutesToDate(PStat.SavedTime, 60);
  advanceToDate(PStat.SavedTime);
  addStats(currentHP: 300, currentMP: 300);
  reduceStats(tiredness: 5);
  warp(to: Map.BETL04, spawn: 0, trigger: 255);
  return;

L2:
  return;
}

section(84) {
  rotate(entity: Entity.Player, to: 2048);
  setTextboxOrigin(-162, 0, 2558);
  callSubroutine(39);
  speak(200, "<GREEN>Training :\nHammer Machine <WHITE>\n");
  choice { "Start" -> L1, "Explain" -> L2, "Quit" -> L3 }
  return;

L1:
  setDialogOwner(200);
  choice { "Normal" -> L4, "Bonus Try" -> L5, "Never mind" -> L3 }
  return;

L2:
  speak(200, "Getting hit by the Hammer\nMachine makes you strong.\nDefensive Power goes up.\n");
  choice { "Explain again" -> L2, "Start" -> L1, "Quit" -> L3 }
  return;

L3:
  return;

L4:
  fadeOutHUD();
  setPStat(254, 3);
  setPStat(246, 0);
  callDigimonSubroutine(214);
  callSubroutine(7);
  return;

L5:
  setTexboxMode(1, 0);
  speak(Entity.System, "<YELLOW>Slot Game <WHITE>\nUse <LIGHTBLUE><X> C?? \nto match three pictures.\n");
  setPStat(254, 3);
  setPStat(246, 1);
  callDigimonSubroutine(214);
  callSubroutine(7);
  setTexboxMode(0, 0);
  return;
}

section(85) {
  rotate(entity: Entity.Player, to: 2048);
  setTextboxOrigin(823, 0, 2144);
  callSubroutine(39);
  speak(200, "<GREEN>Training: Treadmill <WHITE>\n");
  choice { "Start" -> L1, "Explain" -> L2, "Quit" -> L3 }
  return;

L1:
  setDialogOwner(200);
  choice { "Normal" -> L4, "Bonus Try" -> L5, "Never mind" -> L3 }
  return;

L2:
  speak(200, "Run the opposite\nway of the moving belt.\nYour Speed will go up.\n");
  choice { "Explain again" -> L2, "Start" -> L1, "Quit" -> L3 }
  return;

L3:
  return;

L4:
  fadeOutHUD();
  setPStat(254, 2);
  setPStat(246, 0);
  callDigimonSubroutine(214);
  callSubroutine(7);
  return;

L5:
  setTexboxMode(1, 0);
  speak(Entity.System, "<YELLOW>Slot Game <WHITE>\nUse <LIGHTBLUE><X> <WHITE>\nto match three pictures.\n");
  setPStat(254, 2);
  setPStat(246, 1);
  callDigimonSubroutine(214);
  callSubroutine(7);
  setTexboxMode(0, 0);
  return;
  garbage { 1c 00 fe 00 1c 00 05 00 1e 00 06 00 5a 03 07 00 e8 09 54 00 d0 0a 55 00 12 0d ff ff fe 00 1b 05 1a 00 82 68 81 40 82 97 82 81 82 8e 82 94 81 40 82 94 82 8f 81 40 82 82 82 85 82 81 82 94 81 40 82 6a 82 81 82 82 82 95 82 94 82 85 82 92 82 89 82 8d 82 8f 82 8e 81 42 0d 00 82 76 82 88 82 81 82 94 81 40 82 84 82 8f 81 40 82 68 81 40 82 8e 82 85 82 85 82 84 81 40 82 94 82 8f 81 40 82 84 82 8f 81 40 82 94 82 8f 81 40 82 97 82 89 82 8e 81 48 0d 00 00 00 1b fd 10 03 5c 01 9c 01 02 03 1a 00 82 67 82 8d 82 8d 81 42 81 40 82 78 82 8f 82 95 81 40 82 87 82 8f 82 94 82 94 82 81 81 40 82 87 82 85 82 94 81 40 82 93 82 94 82 92 82 8f 82 8e 82 87 82 85 }
}
