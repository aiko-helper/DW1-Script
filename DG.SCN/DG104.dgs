// DG104.SCN
#pragma script index=104 start=0x4a000 end=0x4b000 headerU16=0x1c sentinelOff=0xfe

section onEnter(254) {  // len=2
    return;
}

section(5) {  // len=828
    setDialogOwner(5);
    showTextbox("I want to beat Kabuterimon.\nWhat do I need to do to win?\n");
    setDialogOwner(Entity.Player);
    setSelection(L1, L2, L5);
    showTextbox("Hmm. You gotta get stronger.\nActually, there is a sure fire\nway.... well, hang in there.\n");
    waitForSelectionChoice();
    goto L5;

L1:
    setDialogOwner(5);
    showTextbox("I see. Alright, I'll train.\n");
    return;

L2:
    setDialogOwner(5);
    showTextbox("Really?! Then I'll train you!\n");
    playAnimation(Entity.Player, 19);
    delay(15);
    setDialogOwner(Entity.Player);
    showTextbox("Just come to the city.\n");
    playAnimation(Entity.Player, 0);
    setDialogOwner(5);
    showTextbox("...\n");
    showTextbox("You're really nice.\nI'll go to the city.\n");
    goto L3;

L3:
    move(entity: 5, to: (664, -1963), sprint: 1);
    if (pstat[101] >= 3) goto L4;
    addPStat(101, 1);
    delay(20);
    look(entity: Entity.Player, at: 5);
    look(entity: Entity.Partner, at: 5);
    goto L3;

L4:
    waitForEntity(5);
    unloadEntity(5);
    setPStat(101, 0);
    playSound(8, 17);
    setDialogOwner(Entity.System);
    showTextbox("Kuwagamon went to the city!\n");
    setTrigger(251);
    addPStat(1, 2);
    return;

L5:
    setDialogOwner(5);
    showTextbox("Man, you're not nice.\nI'm disappointed!\n");
    return;
}

section(6) {  // len=1678
    if (!trigger(346)) goto L1;
    setDialogOwner(6);
    showTextbox("Hey, you've been in these\nbug battle contests, right?\n");
    showTextbox("Well, I'll teach you\nsomething useful.\n");
    showTextbox("Do you know where Kunemon\nsleeps? In Native Forest?\n");
    showTextbox("Kid Digimons sleep there.\nWhen they wake up, they\nbecome Kunemon.\n");
    showTextbox("But, sometimes they don't.\nIt's a matter of luck.\n");
    return;

L1:
    storeDigimonType(103);
    if (pstat[103] != 19 && pstat[103] != 32 && pstat[103] != 51 && pstat[103] != 60) goto L2;
    goto L3;

L2:
    setDialogOwner(6);
    showTextbox("Hey, you've been in these\nbug battle contests, right?\n");
    showTextbox("Uh...The way you are now,\nyou won't make it.\n");
    showTextbox("Well, I'll teach you\nsomething useful.\n");
    showTextbox("Do you know where Kunemon\nsleeps? In Native Forest.\n");
    showTextbox("Kid Digimons sleep there.\nWhen they wake up, they\nbecome Kunemon.\n");
    showTextbox("But sometimes they don't.\nIt's a matter of luck.\n");
    return;

L3:
    setDialogOwner(6);
    showTextbox("Hey, do you want to enter the\nbug battle contest?\n");
    setDialogOwner(Entity.Player);
    showTextbox("What's that?\n");
    setDialogOwner(6);
    showTextbox("You gotta sign up by ten\no'clock on the twenty second.\n");
    setDialogOwner(Entity.Player);
    showTextbox("Huh???\n");
    setDialogOwner(6);
    showTextbox("You'll get the details\nthe day of the contest.\n");
    setDialogOwner(6);
    showTextbox("I wonder what he's?\ntalking about?\n");
    return;
}

section(7) {  // len=232
    setDialogOwner(7);
    showTextbox("We will train hard, but\nwe must rest too.\n");
    showTextbox("Shall we rest for an hour?\n");
    setDialogOwner(Entity.Player);
    setSelection(L1, L2);
    showTextbox("Let's rest\nNo rest\n");
    waitForSelectionChoice();
    return;

L1:
    storeDate(105);
    addMinutesToDate(105, 60);
    advanceToDate(105);
    addStats(currentHP: 300, currentMP: 300);
    reduceStats(Stat.Tiredness, 5);
    warp(to: Map.BETL04, spawn: 0, trigger: 255);
    return;

L2:
    return;
}

section(84) {  // len=578
    rotate(entity: Entity.Player, to: 2048);
    setTextboxOrigin(-162, 0, 2558);
    callSubroutine(39);
    setDialogOwner(200);
    showTextbox("<GREEN>Training :\nHammer Machine <WHITE>\n");
    setSelection(L1, L2, L3);
    showTextbox("Start\nExplain\nQuit\n");
    waitForSelectionChoice();
    return;

L1:
    setDialogOwner(200);
    setSelection(L4, L5, L3);
    showTextbox("Normal\nBonus Try\nNever mind\n");
    waitForSelectionChoice();
    return;

L2:
    setDialogOwner(200);
    showTextbox("Getting hit by the Hammer\nMachine makes you strong.\nDefensive Power goes up.\n");
    setSelection(L2, L1, L3);
    showTextbox("Explain again\nStart\nQuit\n");
    waitForSelectionChoice();
    return;

L3:
    return;

L4:
    fadeOutHUD();
    setPStat(254, 3);
    setPStat(246, 0);
    callDigimonSubroutine(214);
    callSubroutine(7);
    return;

L5:
    setTexboxMode(1, 0);
    setDialogOwner(Entity.System);
    showTextbox("<YELLOW>Slot Game <WHITE>\nUse <LIGHTBLUE><X> C?? \nto match three pictures.\n");
    setPStat(254, 3);
    setPStat(246, 1);
    callDigimonSubroutine(214);
    callSubroutine(7);
    setTexboxMode(0, 0);
    return;
}

section(85) {  // len=750
    rotate(entity: Entity.Player, to: 2048);
    setTextboxOrigin(823, 0, 2144);
    callSubroutine(39);
    setDialogOwner(200);
    showTextbox("<GREEN>Training: Treadmill <WHITE>\n");
    setSelection(L1, L2, L3);
    showTextbox("Start\nExplain\nQuit\n");
    waitForSelectionChoice();
    return;

L1:
    setDialogOwner(200);
    setSelection(L4, L5, L3);
    showTextbox("Normal\nBonus Try\nNever mind\n");
    waitForSelectionChoice();
    return;

L2:
    setDialogOwner(200);
    showTextbox("Run the opposite\nway of the moving belt.\nYour Speed will go up.\n");
    setSelection(L2, L1, L3);
    showTextbox("Explain again\nStart\nQuit\n");
    waitForSelectionChoice();
    return;

L3:
    return;

L4:
    fadeOutHUD();
    setPStat(254, 2);
    setPStat(246, 0);
    callDigimonSubroutine(214);
    callSubroutine(7);
    return;

L5:
    setTexboxMode(1, 0);
    setDialogOwner(Entity.System);
    showTextbox("<YELLOW>Slot Game <WHITE>\nUse <LIGHTBLUE><X> <WHITE>\nto match three pictures.\n");
    setPStat(254, 2);
    setPStat(246, 1);
    callDigimonSubroutine(214);
    callSubroutine(7);
    setTexboxMode(0, 0);
    return;
    garbage { 1c 00 fe 00 1c 00 05 00 1e 00 06 00 5a 03 07 00 e8 09 54 00 d0 0a 55 00 12 0d ff ff fe 00 1b 05 1a 00 82 68 81 40 82 97 82 81 82 8e 82 94 81 40 82 94 82 8f 81 40 82 82 82 85 82 81 82 94 81 40 82 6a 82 81 82 82 82 95 82 94 82 85 82 92 82 89 82 8d 82 8f 82 8e 81 42 0d 00 82 76 82 88 82 81 82 94 81 40 82 84 82 8f 81 40 82 68 81 40 82 8e 82 85 82 85 82 84 81 40 82 94 82 8f 81 40 82 84 82 8f 81 40 82 94 82 8f 81 40 82 97 82 89 82 8e 81 48 0d 00 00 00 1b fd 10 03 5c 01 9c 01 02 03 1a 00 82 67 82 8d 82 8d 81 42 81 40 82 78 82 8f 82 95 81 40 82 87 82 8f 82 94 82 94 82 81 81 40 82 87 82 85 82 94 81 40 82 93 82 94 82 92 82 8f 82 8e 82 87 82 85 }
}
