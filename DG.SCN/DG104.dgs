section(5) {
  if (pstat[1] >= 40) {
    speak(Entity(5), "「やあやあ、新しい情報だよ。」<NEWLINE>");
    showTextbox("「えーとね、幼年期のときに、<NEWLINE> 同じトレーニングをくりかえしてみて。」<NEWLINE>");
    showTextbox("「何かいいことがあるってさ。」<NEWLINE>");
    return;
  }
  if (pstat[1] >= 20) {
    speak(Entity(5), "「やあやあ、新しい情報だよ。」<NEWLINE>");
    showTextbox("「えーとね、ボーナストライで、<NEWLINE> カンバンと同じ絵をそろえると、<NEWLINE> 能力アップがさらにすごいってさ。」<NEWLINE>");
    return;
  }
  if (pstat[1] >= 5) {
    speak(Entity(5), "「そうだ、『技』について話すんだったね。」<NEWLINE>");
    showTextbox("「『技』はふつう、バトル中に敵がつかった<NEWLINE> ものを、バトルが終わった時に覚えるんだ。<NEWLINE> 今そうびできるものにかぎられるけど。」<NEWLINE>");
    showTextbox("「毎回確実に覚えるわけじゃないけど、<NEWLINE> これが一番技を増やす近道なんだよね。」<NEWLINE>");
    showTextbox("「で、すっごく可能性はひくいんだけど<NEWLINE> トレーニングで覚えるという方法が<NEWLINE> あってね。」<NEWLINE>");
    showTextbox("「かしこさがそこそこ高くなってから、<NEWLINE> <LIGHTBLUE><PLAYER><WHITE>教室のトレーニングを<NEWLINE> やると覚えることがあるんだって。」<NEWLINE>");
    showTextbox("「しつこいようだけど、本当に可能性は<NEWLINE> ひくいから、期待しすぎちゃダメだよ。<NEWLINE> バランスが大事だからね!」<NEWLINE>");
    return;
  }
  {
    speak(Entity(5), "「やあやあ、ぼくはコロモン。<NEWLINE> じっちゃんにトレーニングについて<NEWLINE> 教えてあげるように言われたんだ。」<NEWLINE>");
    showTextbox("「何か聞きたいことはある?」<NEWLINE>");
    setDialogOwner(Entity.Player);
    setSelection(L1, L2, L3);
    showTextbox("「トレーニングって何?」<NEWLINE>「トレーニングのやり方を教えて。」<NEWLINE>「何も無いよ。」<NEWLINE>");
    waitForSelectionChoice();
    break;

L1:
    speak(Entity(5), "「ここでトレーニングをすれば、デジモンの<NEWLINE> 能力をアップできるんだ。」<NEWLINE>");
    showTextbox("「でもトレーニングすると疲れてくるんだ。<NEWLINE> 時間もけっこうかかるしね。でも、<NEWLINE> バトルより確実に能力がアップするよ。」<NEWLINE>");
    showTextbox("「それとね、すっごくたまにだけど、<NEWLINE> 新しい『技』を覚えることがあるんだよ。」<NEWLINE>");
    showTextbox("「『技』については、また今度話すね。」<NEWLINE>");
    return;

L2:
    speak(Entity(5), "「ここには6つのトレーニング器材が<NEWLINE> あって、それぞれ近くに看板が<NEWLINE> 立ってるんだ。」<NEWLINE>");
    speak(Entity(5), "「まずは看板の前で<ORANGE><CIRCLE><WHITE><ボき><ヌン>を押してみて。<NEWLINE> そこで説明を読めばどの能力があがるのか<NEWLINE> だいたいわかるんだよ。」<NEWLINE>");
    showTextbox("「デジモンの種類によって、上がりやすい<NEWLINE> 能力、またその反対もあるみたい。<NEWLINE> やってみないと分からないけどね。」<NEWLINE>");
    showTextbox("「『トレーニング開始』のあと<NEWLINE> 『ノーマルトレーニング』を選べば<NEWLINE> トレーニングを1時間続けるよ。」<NEWLINE>");
    showTextbox("「トレーニング中、<LIGHTBLUE><CROSS><WHITE><ボき><ヌン>で一気に<NEWLINE> 時間を進められるんだ。」<NEWLINE>");
    showTextbox("「あっ、そうそう、<NEWLINE> 『ボーナストライトレーニング』<NEWLINE> について教えなきゃ」<NEWLINE>");
    showTextbox("「『ボーナストライ』はうまくいくと<NEWLINE> 能力がグンとアップするんだよ。<NEWLINE> でも、失敗すると…」<NEWLINE>");
    showTextbox("「能力はほとんど上がらないんだ。<NEWLINE> 一度試してみるとわかると思うよ。」<NEWLINE>");
    return;

L3:
  }
  speak(Entity(5), "「あ、そう…。<NEWLINE> そのうち新しい情報を聞いとくね。」<NEWLINE>");
  return;
}

section(51) {
  move(entity: Entity.Player, to: (2200, -3000), sprint: 0);
  if (!trigger(203)) {
    warp(to: Map.TWNA01, spawn: 1, trigger: 255);
  }
  {
    if (trigger(220) || trigger(214) || pstat[1] >= 50) goto L2; else break;
  }
  {
    if (trigger(221)) goto L1; else break;
  }
  if (trigger(225)) {
    warp(to: Map.TWNA04, spawn: 1, trigger: 255);
  }
  if (trigger(246)) {
    warp(to: Map.TWNA03, spawn: 1, trigger: 255);
  }
  warp(to: Map.TWNA02, spawn: 1, trigger: 255);

L1:
  if (trigger(225)) {
    warp(to: Map.TWNA07, spawn: 1, trigger: 255);
  }
  if (trigger(246)) {
    warp(to: Map.TWNA06, spawn: 1, trigger: 255);
  }
  {
    warp(to: Map.TWNA05, spawn: 1, trigger: 255);

L2:
    if (trigger(221)) goto L3; else break;
  }
  if (trigger(225)) {
    warp(to: Map.TWNA10, spawn: 1, trigger: 255);
  }
  if (trigger(246)) {
    warp(to: Map.TWNA09, spawn: 1, trigger: 255);
  }
  warp(to: Map.TWNA08, spawn: 1, trigger: 255);

L3:
  if (trigger(225)) {
    warp(to: Map.TWNA13, spawn: 1, trigger: 255);
  }
  if (trigger(246)) {
    warp(to: Map.TWNA12, spawn: 1, trigger: 255);
  }
  warp(to: Map.TWNA11, spawn: 1, trigger: 255);
  return;
}

