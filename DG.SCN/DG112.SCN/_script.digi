; DG112.SCN
;!script index=112 start=0x50800 end=0x51000 headerU16=0x2c sentinelOff=0x24
;!sections onEnter section_5 section_6 section_7 section_8 section_9 section_10 section_11 section_51 section_52

onEnter:     ; len=68
  0000:  storeRandom 110 99
  0004:  if pstat[110] > 11 then onEnter+0x16
  0010:  spawnItem Digimushroom 31 56
  0016:  storeRandom 110 99
  001a:  if pstat[110] > 17 then onEnter+0x2c
  0026:  spawnItem Digimushroom 55 52
  002c:  storeRandom 110 99
  0030:  if pstat[110] > 1 then onEnter+0x42
  003c:  spawnItem Happymushroom 40 80
  0042:  endSection
