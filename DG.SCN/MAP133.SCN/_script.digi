; MAP133.SCN
;!script index=133 start=0x5e000 end=0x5e800 headerU16=0x20 sentinelOff=0x24
;!sections onEnter section_5 section_6 section_7 section_8 section_9 section_10

onEnter:     ; len=90
  0000:  storeRandom 110 99
  0004:  if pstat[110] > 15 then onEnter+0x16
  0010:  spawnItem Digimushroom 58 71
  0016:  storeRandom 110 99
  001a:  if pstat[110] > 6 then onEnter+0x2c
  0026:  spawnItem Digimushroom 32 37
  002c:  storeRandom 110 99
  0030:  if pstat[110] > 3 then onEnter+0x42
  003c:  spawnItem SpinyGreen 31 48
  0042:  storeRandom 110 99
  0046:  if pstat[110] > 0 then onEnter+0x58
  0052:  spawnItem MuscleYam 84 35
  0058:  endSection
