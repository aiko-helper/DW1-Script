// DG052.SCN
#include "functions.dgs"
#pragma script index=52 start=0x26000 end=0x26800 headerU16=0x20 sentinelOff=0x2875
#include "entities.dgs"

section onEnter(254) {
  spawnChest(Item.Sirloin, 500, 567, 0, 653);
  unsetTrigger(Trigger(100));
  return;
}

section(5) {
  speak(Entity(5), "「料理してやる!」<NEWLINE>");
  finishEncounter(Trigger(307));
}

section(6) {
  speak(Entity(6), "「料理してやる!」<NEWLINE>");
  finishEncounter(Trigger(307));
}

section(7) {
  speak(Entity(7), "「料理してやる!」<NEWLINE>");
  finishEncounter(Trigger(307));
}

section(83) {
  rotate(entity: Entity.Player, to: 1024);
  delay(5);
  if (trigger(348)) {
    if (!trigger(100)) {
      rotate3DObject(2, 1);
      rotate3DObject(3, 1);
    }
    delay(20);
    speak(Entity.Player, "「えっとメモは…と。」<NEWLINE>");
    speak(Entity.System, " <NEWLINE>『バカから点をとったところにもどれ』<NEWLINE>");
    setTrigger(Trigger(100));
    return;
  }
  if (item[Item.FridgeKey] >= 1 && !trigger(348)) {
    setTrigger(Trigger(100));
    playSound(8, 3);
    speak(Entity.System, "<LIGHTBLUE>れいぞうこのカギ<WHITE>をつかった!<NEWLINE>");
    rotate3DObject(2, 1);
    rotate3DObject(3, 1);
    delay(60);
    removeItem(Item.FridgeKey, 1);
    anim(Entity.Player, Animation(24), wait: 15);
    speak(Entity.Player, "「んん?ない、ないぞ?」<NEWLINE>");
    playAnimation(Entity.Player, Animation(0));
    speak(Entity.Player, "「お?メモがはってある…」<NEWLINE>");
    speak(Entity.System, " <NEWLINE>『バカから点をとったところにもどれ』<NEWLINE>");
    speak(Entity.Player, "「む、今はこのメモをたよりにするしか<NEWLINE> なさそうだ。うーん。」<NEWLINE>");
    setTrigger(Trigger(348));
    return;
  }
  if (item[Item.FridgeKey] < 1 && !trigger(348)) {
    speak(Entity.Player, "「おや、れいぞうこか。」<NEWLINE>");
    speak(Entity.Player, "「うげ、カギがかかってる。<NEWLINE> そんなれいぞうこってありか?」<NEWLINE>");
    return;
  }
  return;
}

section(81) {
  rotate3DObject(1, 1);
  sfx(8, 1, wait: 10);
  move(entity: Entity.Player, to: (81, -1600), sprint: 0);
  warp(to: Map.YAKA12, spawn: 0, trigger: 255);
  return;
}

