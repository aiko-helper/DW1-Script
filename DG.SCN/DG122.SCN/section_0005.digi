; source: ./extract/DIGIMON/SCN/DG.SCN
; DG122.SCN, section 5

section_5(5):     ; len=1964
  0000:  speak 5 "You saved me!\n"
  0022:  speak Player "So it was you.\n"
  0046:  speak 5 "This is perfect.\n"
  006e:  playAnimation Player 19
  0072:  delay 15
  0076:  speak Player "What?\n"
  0088:  playAnimation Player 0
  008c:  speak 5 "I was headed toward\nyour city to put my talent\nto good use!\n"
  010a:  speak Player "What kind of talent?\n"
  013a:  speak 5 "Oh, you don't know about me?\nI'm famous with Digimon\nas a know-it-all!\n"
  01ce:  speak Player "Really?\nI've never heard of you.\n"
  0216:  speak 5 "I'm ready to go to the city.\n"
  0256:  playAnimation Player 16
  025a:  delay 15
  025e:  speak Player "Is she really\ngoing to be useful?\n"
  02a8:  playAnimation Player 0
  02ac:  speak 5 "See ya!\n"
  02c2:  jump section_5+0x2c6
  02c6:  entityWalkTo 5 -111 -2962 1
  02ce:  if pstat[101] >= 3 then section_5+0x2ee
  02da:  pstat[101] += 1
  02de:  delay 20
  02e2:  lookAt Player 5
  02e6:  lookAt Partner 5
  02ea:  jump section_5+0x2c6
  02ee:  waitForEntity 5
  02f0:  unloadEntity 5
  02f2:  pstat[101] = 0
  02f6:  playSound 8 10
  02fa:  speak System "Shellmon joins the city!\n"
  0332:  setTrigger 235
  0336:  pstat[1] += 2
  033a:  endSection
