  look(entity: Entity.Partner, at: Entity(10));
  delay(5);
  setTrigger(Trigger(1));
  setPStat(PStat(250), 1);
  setPStat(PStat(251), 10);
  setPStat(PStat(252), 255);
  setPStat(PStat(253), 255);
  startBattle();
  unsetTrigger(Trigger(1));
  setPStat(PStat(250), 0);
  look(entity: Entity.Player, at: Entity(10));
  look(entity: Entity(10), at: Entity.Player);
  look(entity: Entity.Partner, at: Entity(10));
  speak(Entity(10), "「ぐ…このままでは…<NEWLINE> さしちがえてでも…倒してこいと…命令…」<NEWLINE>");
  anim(Entity(10), Animation(29), wait: 30);
  anim(Entity.Player, Animation(7), wait: 5);
  speak(Entity.Player, "「何を言ってるんだ、このままじゃ本当に<NEWLINE> 死んでしまうぞ!早く手当てを…」<NEWLINE>");
  move(entity: Entity.Player, to: Entity(10), sprint: 1);
  move(entity: Entity.Partner, to: Entity(10), sprint: 1);
  delay(40);
  for x in [Trigger(88), Trigger(355), Trigger(354)] {
    setTrigger(x);
  }
  warp(to: Map.ROOM11, spawn: 1, trigger: 60);
  return;
}

