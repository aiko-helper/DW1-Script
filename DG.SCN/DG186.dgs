// DG186.SCN
#include "functions.dgs"
#pragma script index=186 start=0x8c800 end=0x8e000 headerU16=0x10 sentinelOff=0xfe
#include "entities.dgs"

section onEnter(254) {
  return;
}

section(51) {
  warp(to: Map.FACT03, spawn: 2, trigger: 255);
  return;
}

section(5) {
  if (trigger(240)) {
    speak(Entity(5), "「こちらは異常ありません。<NEWLINE> がんばってください。」<NEWLINE>");
    return;
  }
  if (trigger(330)) {
    speak(Entity(5), "「私も協力しなくてはなりません。<NEWLINE> 時間を見て街とここを行き来する<NEWLINE> ことにします。」<NEWLINE>");
    playSound(8, 10);
    speak(Entity.System, "アンドロモンが街に参加した!!!<NEWLINE>");
    setTrigger(Trigger(240));
    addPStat(PStat(1), 3);
    return;
  }
  if (trigger(329)) {
    speak(Entity(5), "「データの修復が完了しています。<NEWLINE> ではデータを読みましょう。」<NEWLINE>");
    rotate(entity: Entity(5), to: 2048);
    delay(20);
    playSound(8, 5);
    speak(Entity.Player, "「たのむ。」<NEWLINE>");
    playSound(8, 6);
    speak(Entity.System, "100年前 デジモンの島にアナログの人間<NEWLINE>現わる。アナログの人間、現住のデジモンと<NEWLINE>激しく争う。<NEWLINE>");
    showTextbox("10年に渡る争いの後、アナログの人間は<NEWLINE>敗北し、いずこかへ姿を消す。<NEWLINE>");
    showTextbox("その後10年の間に、島の面積、地域、拡大。<NEWLINE>原因は不明。ほぼ2倍となる。<NEWLINE>");
    anim(Entity.Player, Animation(16), wait: 15);
    speak(Entity.Player, "「人間が…デジモンと争ったのか…」<NEWLINE>");
    playAnimation(Entity.Player, Animation(0));
    speak(Entity(5), "「修復することのできたデータは<NEWLINE> ここまでです。すみません。」<NEWLINE>");
    rotate(entity: Entity(5), to: 0);
    delay(20);
    speak(Entity.Player, "「いや、これは貴重な情報だよ。<NEWLINE> これでかなりのことが分かった。」<NEWLINE>");
    speak(Entity(5), "「そうですか。」<NEWLINE>");
    anim(Entity.Player, Animation(25), wait: 15);
    speak(Entity.Player, "「島を混乱させ、異変をひきおこしたのは<NEWLINE> たぶん、この行方不明の人間だろうな。」<NEWLINE>");
    playAnimation(Entity.Player, Animation(0));
    speak(Entity(5), "「人間は100年も生きられるのですか?」<NEWLINE>");
    speak(Entity.Player, "「うーん、この世界においては人間だけ<NEWLINE> 時間の流れが極端に遅いみたいなんだ。」<NEWLINE>");
    showTextbox("「だから、俺は食べなくても寝なくても平気。<NEWLINE> それでも100年ってのはけっこう長いよ。<NEWLINE> よほどしぶといやつなんだろう。」<NEWLINE>");
    speak(Entity(5), "「どこかにかくれているのでしょうか。」<NEWLINE>");
    speak(Entity.Player, "「見つけて…何とかする。今わかったよ。<NEWLINE> 俺は同じ人間としてそいつをやっつける<NEWLINE> ためにここに呼ばれたんだな。」<NEWLINE>");
    setTrigger(Trigger(330));
    return;
  }
  if (trigger(211) && !trigger(328)) {
    speak(Entity(5), "「…このたびはまことにもうしわけ<NEWLINE> ありませんでした。<NEWLINE> 工場はしばらくの間閉鎖します。」<NEWLINE>");
    anim(Entity.Player, Animation(19), wait: 15);
    speak(Entity.Player, "「島に異変が起きている今は、<NEWLINE> 何がおこるか予想もつかない。<NEWLINE> お前の責任じゃないさ。」<NEWLINE>");
    playAnimation(Entity.Player, Animation(0));
    speak(Entity.Player, "「ギロモンをコントロールしていたやつが<NEWLINE> どこかにいると思うんだ。」<NEWLINE>");
    showTextbox("「コンピュータがこわされて…<NEWLINE> デジモンをくるわせる廃液が流れ出した。<NEWLINE> ぐうぜんじゃないと思うぜ。」<NEWLINE>");
    speak(Entity(5), "「ここのコンピュータは重要な意味をもって<NEWLINE> います。何者かにねらわれたと考えて<NEWLINE> よいと思います。いまさらですが…」<NEWLINE>");
    speak(Entity.Player, "「なんだって?」<NEWLINE>");
    speak(Entity(5), "「ここには島の過去に関するデータが残って<NEWLINE> いたようです。しかしギロモンの暴走に<NEWLINE> よって、データが壊れてしまいました。」<NEWLINE>");
    speak(Entity.Player, "「お前はデータを見てないのか?」<NEWLINE>");
    speak(Entity(5), "「残念ながら。ただ、データは一部修復できる<NEWLINE> ようですので、私がデータをつないで<NEWLINE> みます。」<NEWLINE>");
    speak(Entity.Player, "「そうか、たのむ。時間は?」<NEWLINE>");
    speak(Entity(5), "「もうしばらくは…。この街の正面入り口の<NEWLINE> 閉鎖を解除しておきますので、また<NEWLINE> 来てください。」<NEWLINE>");
    speak(Entity.Player, "「ありがとう。じゃあまた来る。」<NEWLINE>");
    setTrigger(Trigger(328));
    return;
  }
  if (trigger(328)) {
    speak(Entity.Player, "「データ修復は終わったか?」<NEWLINE>");
    speak(Entity(5), "「もうしばらくかかります。<NEWLINE> また来てください。」<NEWLINE>");
    speak(Entity.Player, "「じゃあまた来る。」<NEWLINE>");
    return;
  }
  if (trigger(344) && !trigger(211) && !trigger(341)) {
    anim(Entity.Player, Animation(7), wait: 10);
    speak(Entity.Player, "「やいやーい!」<NEWLINE>");
    speak(Entity(5), "「…あなたは。私はあなたに謝罪しなくては<NEWLINE> なりません。」<NEWLINE>");
    anim(Entity.Player, Animation(7), wait: 15);
    speak(Entity.Player, "「だぁー、そんなのは後だ。早く工場の機械を<NEWLINE> 止めてくれ!」<NEWLINE>");
    playAnimation(Entity.Player, Animation(0));
    speak(Entity(5), "「は。わかりました。」<NEWLINE>");
    rotate(entity: Entity(5), to: 2048);
    delay(20);
    playSound(8, 5);
    speak(Entity(5), "「工場の機能はただ今停止しました。」<NEWLINE>");
    speak(Entity.Player, "「おっし、下水道見てくる。また後でな。」<NEWLINE>");
    setTrigger(Trigger(341));
    return;
  }
  if (trigger(341)) {
    speak(Entity(5), "「私はあなたに謝罪しなくては…」<NEWLINE>");
    speak(Entity.Player, "「おっと、今それどころじゃない!」<NEWLINE>");
    return;
  }
  if (trigger(343)) {
    speak(Entity(5), "「我々のコンピュータは完全です。」<NEWLINE>");
    speak(Entity.Player, "「本当に工場は大丈夫なのかな。困った…」<NEWLINE>");
    anim(Entity.Player, Animation(16), wait: 20);
    playAnimation(Entity.Player, Animation(0));
    speak(Entity.Player, "「よし、こーなったら見張りを何とかしよう。<NEWLINE> 他にアテも無いしな!」<NEWLINE>");
    return;
  }
  speak(Entity(5), "「おや…あなた方は…<NEWLINE> どうやってこの町へ入ってきたのですか?」<NEWLINE>");
  if (!trigger(347)) {
    speak(Entity(5), "「用がないのなら、<NEWLINE> 早急に出ていってください。」<NEWLINE>");
    return;
  }
  if (!trigger(344) && trigger(347) && !trigger(343)) {
    speak(Entity.Player, "「えーと…そんなことは後あと。<NEWLINE> 工場を調査したい。命に関わる問題なんだ。<NEWLINE> 許可をくれ!」<NEWLINE>");
    speak(Entity(5), "「ふむ…?どういうつもりか分かりかねます。<NEWLINE> 許可できません。」<NEWLINE>");
    speak(Entity.Player, "「工場から出てる廃液で死にそうなデジモン<NEWLINE> がいるんだ。」<NEWLINE>");
    speak(Entity(5), "「…?工場からですか?あなたのカンちがい<NEWLINE> でしょう。廃液分解システムは正常に作動<NEWLINE> しています。」<NEWLINE>");
    speak(Entity.Player, "「正常かどうか、見なきゃわかんないだろ!」<NEWLINE>");
    anim(Entity.Player, Animation(19), wait: 5);
    speak(Entity(5), "「我々のコンピュータは完全です。<NEWLINE> 万が一の異常には『ネットキーパー』が<NEWLINE> 働いて異常を断ってくれますので。」<NEWLINE>");
    speak(Entity.Player, "「なんだそれ?それは壊れないのかよ。」<NEWLINE>");
    anim(Entity.Player, Animation(0), wait: 5);
    speak(Entity(5), "「『ネットキーパー』とは、完全なるデジモン、<NEWLINE> ギロモンの別称です。彼の判断、能力は<NEWLINE> まさにパーフェクトなのです。」<NEWLINE>");
    speak(Entity.Player, "「デジモン?!そりゃよけいに危ないよ今は!<NEWLINE> 頼む、許可を!」<NEWLINE>");
    anim(Entity.Player, Animation(19), wait: 5);
    speak(Entity(5), "「……。おひきとりを。」<NEWLINE>");
    anim(Entity.Player, Animation(22), wait: 10);
    speak(Entity.Player, "「く…」<NEWLINE>");
    setTrigger(Trigger(343));
  }
  return;
  garbage { 10 00 fe 00 10 00 33 00 12 00 05 00 18 00 ff ff fe 00 4b 9a 02 ff fe 00 19 00 00 00 f0 00 18 00 62 00 19 00 1b 05 1a 00 81 75 82 b1 82 bf 82 e7 82 cd 88 d9 8f ed 82 a0 82 e8 82 dc 82 b9 82 f1 81 42 0d 00 81 40 82 aa 82 f1 82 ce 82 c1 82 c4 82 ad 82 be 82 b3 82 a2 81 42 81 76 0d 00 00 00 fe 00 19 00 00 00 4a 01 18 00 02 01 19 00 1b 05 1a 00 81 75 8e 84 82 e0 8b a6 97 cd 82 b5 82 c8 82 ad 82 c4 82 cd 82 c8 82 e8 82 dc 82 b9 82 f1 81 42 0d 00 81 40 8e 9e 8a d4 82 f0 8c a9 82 c4 8a 58 82 c6 82 b1 82 b1 82 f0 8d 73 82 ab 97 88 82 b7 82 e9 0d 00 81 40 82 b1 82 c6 82 c9 82 b5 82 dc 82 b7 81 42 81 76 0d 00 00 00 5a 00 08 0a 1b ff 1a 00 83 41 83 93 83 68 83 8d 83 82 83 93 82 aa 8a 58 82 c9 8e 51 89 c1 82 b5 82 bd 81 49 81 49 81 49 0d 00 00 00 1c 00 f0 00 1f 00 01 03 fe 00 19 00 00 00 49 01 18 00 76 05 19 00 1b 05 1a 00 81 75 83 66 81 5b 83 5e 82 cc 8f 43 95 9c 82 aa 8a ae 97 b9 82 b5 82 c4 82 a2 82 dc 82 b7 81 42 0d 00 81 40 82 c5 82 cd 83 66 81 5b 83 5e 82 f0 93 c7 82 dd 82 dc 82 b5 82 e5 82 a4 81 42 81 76 0d 00 00 00 4d 05 00 08 67 00 14 00 5a 00 08 05 1b fd 1a 00 81 75 82 bd 82 cc 82 de 81 42 81 76 0d 00 00 00 5a 00 08 06 1b ff 1a 00 82 50 82 4f 82 4f 94 4e 91 4f 81 40 83 66 83 57 83 82 83 93 82 cc 93 87 82 c9 83 41 83 69 83 8d 83 4f 82 cc 90 6c 8a d4 0d 00 8c bb 82 ed 82 e9 81 42 83 41 83 69 83 8d 83 4f 82 cc 90 6c 8a d4 81 41 8c bb 8f 5a 82 cc 83 66 83 57 83 82 83 93 82 c6 0d 00 8c 83 82 b5 82 ad 91 88 82 a4 81 42 0d 00 00 00 1a 00 82 50 82 4f 94 4e 82 c9 93 6e 82 e9 91 88 82 a2 82 cc 8c e3 81 41 83 41 83 69 83 8d 83 4f 82 cc 90 6c 8a d4 82 cd 0d 00 94 73 96 6b 82 b5 81 41 82 a2 82 b8 82 b1 82 a9 82 d6 8e 70 82 f0 8f c1 82 b7 81 42 0d 00 00 00 1a 00 82 bb 82 cc 8c e3 82 50 82 4f 94 4e 82 cc 8a d4 82 c9 81 41 93 87 82 cc 96 ca 90 cf 81 41 92 6e 88 e6 81 41 8a 67 91 e5 81 42 0d 00 8c b4 88 f6 82 cd 95 73 96 be 81 42 82 d9 82 da 82 51 94 7b 82 c6 82 c8 82 e9 81 42 0d 00 00 00 56 00 fd 10 67 00 0f 00 1b fd 1a 00 81 75 90 6c 8a d4 82 aa 81 63 83 66 83 57 83 82 83