// DG045.SCN
#include "functions.dgs"
#pragma script index=45 start=0x21800 end=0x22000 headerU16=0x18 sentinelOff=0xfe
#include "entities.dgs"

section onEnter(254) {
  return;
}

section(5) {
  speak(Entity(5), "「フォーメーションC!」<NEWLINE>");
  move(entity: Entity(6), to: (-230, 547), sprint: 1);
  move(entity: Entity(7), to: (483, 70), sprint: 1);
  waitForEntity(Entity(6));
  waitForEntity(Entity(7));
  delay(10);
  setTrigger(Trigger(1));
  setPStat(PStat(250), 1);
  setPStat(PStat(251), 5);
  setPStat(PStat(252), 6);
  setPStat(PStat(253), 7);
  startBattle();
  setPStat(PStat(250), 0);
  unsetTrigger(Trigger(1));
  move(entity: Entity(5), to: (550, -2050), sprint: 1);
  move(entity: Entity(6), to: (550, -2050), sprint: 1);
  move(entity: Entity(7), to: (550, -2050), sprint: 1);
  for id in Entity(5)..Entity(7) {
    waitForEntity(id);
  }
  for id in Entity(5)..Entity(7) {
    unloadEntity(id);
  }
  followEntity(Entity.Player, speed: 10);
  return;
}

