// MAP218.SCN
#include "functions.dgs"
#pragma script index=218 start=0xa2000 end=0xa2800 headerU16=0x20 sentinelOff=0x1775
#include "entities.dgs"

section onEnter(254) {
  spawnChest(Item.OffenseChip, -412, 1068, 2048, 712);
  spawnChest(Item.HPChip, 452, -446, 1024, 713);
  return;
}

section(51) {
  move(entity: Entity.Player, to: (2019, -420), sprint: 0);
  warp(to: Map.MGEN12, spawn: 0, trigger: 255);
  return;
}

section(52) {
  move(entity: Entity.Player, to: (-2797, 365), sprint: 0);
  switch pstat[16] {
    1 => {
      warp(to: Map.ICSA08, spawn: 0, trigger: 60);
      return;
    }
    2 => {
      warp(to: Map.CHKA01, spawn: 1, trigger: 60);
      return;
    }
    3 => {
      warp(to: Map.OGRE02, spawn: 0, trigger: 60);
      return;
    }
  }
  return;
}

section(5) {
  speak(Entity(5), "「戦闘開始ーーーーッ!」<NEWLINE>");
  finishEncounter(Trigger(276));
}

section(6) {
  speak(Entity(6), "「ねらいをさだめて…うてぇーー!」<NEWLINE>");
  finishEncounter(Trigger(276));
}

section(7) {
  speak(Entity(7), "「…おれの…しごと。」<NEWLINE>");
  finishEncounter(Trigger(308));
}

