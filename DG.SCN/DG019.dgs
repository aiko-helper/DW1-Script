// DG019.SCN
#include "functions.dgs"
#pragma script index=19 start=0x13000 end=0x13800 headerU16=0x1c sentinelOff=0x24
#include "entities.dgs"

section onEnter(254) {
  spawnItemChance(max: 99, chance: 15, item: Item.Digimushroom, x: 31, y: 57);
  spawnItemChance(max: 99, chance: 7, item: Item.Digimushroom, x: 91, y: 55);
  spawnItemChance(max: 99, chance: 6, item: Item.Happymushroom, x: 62, y: 94);
  return;
}

section(5) {
  {
    playSound(8, 11);
    speak(Entity(5), "「オレとバトるのかぁ~。お~し!」<NEWLINE>");
    anim(Entity.Player, Animation(16), wait: 20);
    setDialogOwner(Entity.Player);
    setSelection(L1, L2);
    showTextbox("「勝つ!」<NEWLINE>「わ、ちょっと待って。」<NEWLINE>");
    waitForSelectionChoice();
    break;

L1:
    {
      setTrigger(Trigger(1));
      startBattle();
      lookPairAt(Entity(5));
      look(entity: Entity(5), at: Entity.Player);
      waitForEntity(Entity.Player);
      speak(Entity(5), "「ぬわ~負けたぁ~くやし~!」<NEWLINE>");
      anim(Entity(5), Animation(29), wait: 40);
      anim(Entity.Player, Animation(20), wait: 20);
      speak(Entity.Player, "「なかなか手強かったな…」<NEWLINE>");
      playAnimation(Entity.Player, Animation(0));
      anim(Entity(5), Animation(28), wait: 20);
      playAnimation(Entity(5), Animation(0));
      look(entity: Entity(5), at: Entity.Player);
      playSound(8, 11);
      speak(Entity(5), "「おまえ、いいやつ。<NEWLINE> マメモン、おまえについてく。」<NEWLINE>");
      anim(Entity.Player, Animation(19), wait: 20);
      speak(Entity.Player, "「ん~ついてくるのはちょっとね…。<NEWLINE> 街に来てくれない?」<NEWLINE>");
      playSound(8, 11);
      speak(Entity(5), "「いーぞ。マメモン、街行く。」<NEWLINE>");
      break;
    }
    approach(who: Entity(5), x: 3800, y: -3100, tries: 10, wait: 10);
    playSound(8, 8);
    speak(Entity.System, "マメモンが街に参加した!!!<NEWLINE>");
    unsetTrigger(Trigger(1));
    followEntity(Entity.Player, speed: 10);
    addPStat(PStat(1), 3);
    setTrigger(Trigger(213));
    return;

L2:
  }
  {
    speak(Entity(5), "「んー、強くなってからまた来~い。」<NEWLINE>");
    break;
  }
  approach(who: Entity(5), x: 3800, y: -3100, tries: 10, wait: 10);
  return;
}

section(6) {
  speak(Entity(6), "「だぁ~。」<NEWLINE>");
  finishEncounter(Trigger(281));
}

section(7) {
  speak(Entity(7), "「うわっはっは。」<NEWLINE>");
  finishEncounter(Trigger(281));
}

section(8) {
  speak(Entity(8), "「ぬぉ~。」<NEWLINE>");
  finishEncounter(Trigger(281));
}

section(81) {
  rotate(entity: Entity.Player, to: 2048);
  speak(Entity.System, "東・迷わずの森<NEWLINE>西・ギアサバンナ<NEWLINE>");
  return;
