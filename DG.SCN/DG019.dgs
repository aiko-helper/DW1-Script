// DG019.SCN
#include "functions.dgs"
#pragma script index=19 start=0x14000 end=0x14800 headerU16=0x2c sentinelOff=0x24

section onEnter(254) {
  roll(pstat: 110, max: 99);
  if (pstat[110] > 14) goto L1;
  spawnItem(Item.Digimushroom, x: 37, y: 19);

L1:
  roll(pstat: 110, max: 99);
  if (pstat[110] > 9) goto L2;
  spawnItem(Item.Digimushroom, x: 60, y: 72);

L2:
  roll(pstat: 110, max: 99);
  if (pstat[110] > 3) goto L3;
  spawnItem(Item.BigBerry, x: 57, y: 54);

L3:
  setTrigger(106);
  setTrigger(105);
  return;
}

