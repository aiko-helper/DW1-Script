; DG168.SCN, section 82

section_82(82):     ; len=1176
  0000:  speak System "Arena Information\n"
  002a:  setSelection section_82+0xa8 section_82+0x10a section_82+0x2bc
  0032:  showTextbox "Record\nAbout Grade Tournament\nAbout Special Tournament\n"
  00a4:  waitForSelectionChoice
  00a6:  endSection
  00a8:  speak System "Number of\nChampionship wins <TOURNAMENTS WON>\n<ARENA WINS>Wins <ARENA LOSSES>Losses\n"
  0106:  fadeOutHUD
  0108:  endSection
  010a:  speak System "Anybody can join a Grade\nTournament. It's held a lot.\n"
  017c:  showTextbox "But a higher generation\nDigimon should not enter\nlower level tournaments.\n"
  0214:  showTextbox "If your Digimon digivolves\nbetween registering and\ntournament, he can't compete.\n"
  02ba:  endSection
  02bc:  speak System "Special tournaments have\nset contestant rules\nand they aren't held often.\n"
  0356:  showTextbox "If there aren't enough\ncontestants in the city,\nit will not even be held.\n"
  03ee:  showTextbox "The same tournament is only\nheld once or twice a year.\nCheck schedule in advance.\n"
  0496:  endSection
