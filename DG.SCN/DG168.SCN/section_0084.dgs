section section_84(84) {  // len=946
    look(entity: 7, at: Entity.Player);
    look(entity: Entity.Player, at: 7);
    delay(10);
    setDialogOwner(7);
    showTextbox("<ORANGE><DIGIMON><WHITE>, let me think of\nyour nickname... a hero\nwho has saved the world.\n");
    showTextbox("Let's see.\n");
    roll(pstat: 110, max: 9);
    if (pstat[110] != 0) goto L_0108;
    setDialogOwner(7);
    showTextbox("How about\n'Invincible <ORANGE><DIGIMON><WHITE>'?\n");
    return;
L_0108:
    if (pstat[110] != 1) goto L_015c;
    setDialogOwner(7);
    showTextbox("How about\n'Legendary Hero <ORANGE><DIGIMON><WHITE>'?\n");
    return;
L_015c:
    if (pstat[110] != 2) goto L_01a6;
    setDialogOwner(7);
    showTextbox("How about\n'<ORANGE><DIGIMON><WHITE> The Great'?\n");
    return;
L_01a6:
    if (pstat[110] != 3) goto L_01f2;
    setDialogOwner(7);
    showTextbox("How about\n'Peacemaker <ORANGE><DIGIMON><WHITE>'?\n");
    return;
L_01f2:
    if (pstat[110] != 4) goto L_023c;
    setDialogOwner(7);
    showTextbox("How about\n'<ORANGE><DIGIMON><WHITE> The Champ'?\n");
    return;
L_023c:
    if (pstat[110] != 5) goto L_0286;
    setDialogOwner(7);
    showTextbox("How about\n'<ORANGE><DIGIMON><WHITE> The Brave'?\n");
    return;
L_0286:
    if (pstat[110] != 6) goto L_02d2;
    setDialogOwner(7);
    showTextbox("How about\n'Cool Dude, <ORANGE><DIGIMON><WHITE>'?\n");
    return;
L_02d2:
    if (pstat[110] != 7) goto L_031e;
