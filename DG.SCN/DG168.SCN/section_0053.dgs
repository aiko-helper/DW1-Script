section section_53(53) {  // len=110
    look(entity: 5, at: Entity.Player);
    look(entity: Entity.Player, at: 5);
    delay(5);
    setDialogOwner(5);
    showTextbox("Hey, those seats are\nfor our guests.\n");
    move(entity: Entity.Player, to: (450, 124), sprint: 1);
    waitForEntity(Entity.Player);
    moveCamera(to: Entity.Player, speed: 10);
    waitForEntity(200);
    return;
}
