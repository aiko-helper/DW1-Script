// DG105.SCN
#include "functions.dgs"
#pragma script index=105 start=0x4b000 end=0x4c000 headerU16=0x24 sentinelOff=0x19
#include "entities.dgs"

section onEnter(254) {
  if (pstat[1] < 10) {
    setObjectVisibility(18, 0);
    setObjectVisibility(23, 1);
  } else {
    setObjectVisibility(18, 1);
    setObjectVisibility(23, 0);
  }
  spawnItemChance(max: 99, chance: 2, item: Item.Happymushroom, x: 61, y: 64);
  spawnItemChance(max: 99, chance: 29, item: Item.Digimushroom, x: 55, y: 71);
  spawnItemChance(max: 99, chance: 39, item: Item.Digimushroom, x: 36, y: 44);
  if (pstat[1] >= 25) {
    setObjectsVisibleRange(28, 33, 0);
  }
  return;
}

section(5) {
  speak(Entity(5), "What do you want?!\n");
  finishEncounter(Trigger(274));
}

section(6) {
  speak(Entity.Player, "Wow!\n");
  anim(Entity.Player, Animation(15), wait: 20);
  playAnimation(Entity.Player, Animation(0));
  speak(Entity(6), "...? ...!\n");
  speak(Entity.Player, "What? Now?!\nOkay, let's fight!\n");
  setTrigger(Trigger(1));
  setPStat(PStat(250), 1);
  setPStat(PStat(251), 6);
  setPStat(PStat(252), 255);
  setPStat(PStat(253), 255);
  startBattle();
  unsetTrigger(Trigger(1));
  setPStat(PStat(250), 0);
  look(entity: Entity(6), at: Entity.Player);
  lookPairAt(Entity(6));
  waitForPair();
  speak(Entity(6), "I lost. Rats!\n");
  playAnimation(Entity(6), Animation(18));
  speak(Entity.Player, "I should invite him\nto the city.\n");
  playAnimation(Entity.Player, Animation(25));
  showTextbox("Uh, excuse me.\n");
  playAnimation(Entity.Player, Animation(19));
  showTextbox("Could you...\ncome to the city...?\n");
  playAnimation(Entity.Player, Animation(0));
  playAnimation(Entity(6), Animation(0));
  speak(Entity(6), "What? City?!\n");
  showTextbox("You mean that...old place?\n");
  playAnimation(Entity(6), Animation(19));
  speak(Entity(6), "Well...\n");
  showTextbox("Uh......\n");
  showTextbox("Uhm.........\n");
  fadeOutHUD();
  playAnimation(Entity(6), Animation(22));
  waitForEntity(Entity(6));
  playAnimation(Entity(6), Animation(22));
  speak(Entity(6), "Well, okay.\nI'm Agumon.\nNice meeting you.\n");
  fadeOutHUD();
  goto L1;

L1:
  approach(who: Entity(6), x: 2400, y: 1663, tries: 3, wait: 20);
  playSound(8, 11);
  speak(Entity.System, "Agumon joins the city!\n");
  setTrigger(Trigger(203));
  addPStat(PStat(1), 1);
  followEntity(Entity.Player, speed: 10);
  speak(Entity.Player, "Alright, it pays to try.\nI'll keep on asking!\n");
  anim(Entity.Player, Animation(11), wait: 20);
  playAnimation(Entity.Player, Animation(0));
  return;
}

section(7) {
  speak(Entity(7), "This is my territory!\n");
  finishEncounter(Trigger(283));
}

section(8) {
  speak(Entity(8), "What?!\n");
  finishEncounter(Trigger(274));
}

section(9) {
  speak(Entity(9), "Now's my chance!\n");
  finishEncounter(Trigger(283));
}

