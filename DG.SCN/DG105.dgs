// DG105.SCN
#include "functions.dgs"
#pragma script index=105 start=0x4b000 end=0x4c000 headerU16=0x24 sentinelOff=0x19

section onEnter(254) {
  if (pstat[1] >= 10) goto L1;
  setObjectVisibility(18, 0);
  setObjectVisibility(23, 1);
  goto L2;

L1:
  setObjectVisibility(18, 1);
  setObjectVisibility(23, 0);

L2:
  roll(pstat: 110, max: 99);
  if (pstat[110] > 2) goto L3;
  spawnItem(Item.Happymushroom, x: 61, y: 64);

L3:
  roll(pstat: 110, max: 99);
  if (pstat[110] > 29) goto L4;
  spawnItem(Item.Digimushroom, x: 55, y: 71);

L4:
  roll(pstat: 110, max: 99);
  if (pstat[110] > 39) goto L5;
  spawnItem(Item.Digimushroom, x: 36, y: 44);

L5:
  if (pstat[1] < 25) goto L6;
  for id in 28..33 {
    setObjectVisibility(id, 0);
  }

L6:
  return;
}

section(5) {
  speak(5, "What do you want?!\n");
  startBattle();
  setTrigger(274);
  return;
}

section(6) {
  speak(Entity.Player, "Wow!\n");
  playAnimation(Entity.Player, 15);
  delay(20);
  playAnimation(Entity.Player, 0);
  speak(6, "...? ...!\n");
  speak(Entity.Player, "What? Now?!\nOkay, let's fight!\n");
  setTrigger(1);
  setPStat(250, 1);
  setPStat(251, 6);
  setPStat(252, 255);
  setPStat(253, 255);
  startBattle();
  unsetTrigger(1);
  setPStat(250, 0);
  look(entity: 6, at: Entity.Player);
  look(entity: Entity.Player, at: 6);
  look(entity: Entity.Partner, at: 6);
  waitForEntity(Entity.Player);
  waitForEntity(Entity.Partner);
  speak(6, "I lost. Rats!\n");
  playAnimation(6, 18);
  speak(Entity.Player, "I should invite him\nto the city.\n");
  playAnimation(Entity.Player, 25);
  showTextbox("Uh, excuse me.\n");
  playAnimation(Entity.Player, 19);
  showTextbox("Could you...\ncome to the city...?\n");
  playAnimation(Entity.Player, 0);
  playAnimation(6, 0);
  speak(6, "What? City?!\n");
  showTextbox("You mean that...old place?\n");
  playAnimation(6, 19);
  speak(6, "Well...\n");
  showTextbox("Uh......\n");
  showTextbox("Uhm.........\n");
  fadeOutHUD();
  playAnimation(6, 22);
  waitForEntity(6);
  playAnimation(6, 22);
  speak(6, "Well, okay.\nI'm Agumon.\nNice meeting you.\n");
  fadeOutHUD();
  goto L1;

L1:
  move(entity: 6, to: (2400, 1663), sprint: 1);
  if (pstat[101] >= 3) goto L2;
  addPStat(101, 1);
  delay(20);
  look(entity: Entity.Player, at: 6);
  look(entity: Entity.Partner, at: 6);
  goto L1;

L2:
  waitForEntity(6);
  unloadEntity(6);
  setPStat(101, 0);
  playSound(8, 11);
  speak(Entity.System, "Agumon joins the city!\n");
  setTrigger(203);
  addPStat(1, 1);
  moveCamera(to: Entity.Player, speed: 10);
  waitForEntity(200);
  speak(Entity.Player, "Alright, it pays to try.\nI'll keep on asking!\n");
  playAnimation(Entity.Player, 11);
  delay(20);
  playAnimation(Entity.Player, 0);
  return;
}

section(7) {
  speak(7, "This is my territory!\n");
  startBattle();
  setTrigger(283);
  return;
}

section(8) {
  speak(8, "What?!\n");
  startBattle();
  setTrigger(274);
  return;
}

section(9) {
  speak(9, "Now's my chance!\n");
  startBattle();
  setTrigger(283);
  return;
}

