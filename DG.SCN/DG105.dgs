// DG105.SCN
#include "functions.dgs"
#pragma script index=105 start=0x47000 end=0x47800 headerU16=0x14 sentinelOff=0x19
#include "entities.dgs"

section onEnter(254) {
  if (trigger(135)) {
    setObjectVisibility(2, 1);
  }
  return;
}

section(51) {
  if (!trigger(134)) {
    rotate(entity: Entity.Player, to: 1900);
    waitForEntity(Entity.Player);
    speak(Entity.Player, "「…これは!すげー!」<NEWLINE>");
    panTo(x: -400, y: 4000, slowdown: 50);
    delay(40);
    followEntity(Entity.Player, speed: 20);
    setTrigger(Trigger(134));
    return;
  }
  return;
}

section(52) {
  if (!trigger(135)) {
    rotate(entity: Entity.Player, to: 1900);
    waitForEntity(Entity.Player);
    speak(Entity.Player, "「おや、石板がはめこまれてるぞ。どれ…」<NEWLINE>");
    move(entity: Entity.Player, to: (-477, 2801), sprint: 0, withCamera: true);
    waitForEntity(Entity.Player);
    rotate(entity: Entity.Player, to: 1900);
    delay(10);
    anim(Entity.Player, Animation(25), wait: 10);
    playSound(8, 7);
    setObjectVisibility(2, 1);
    delay(10);
    speak(Entity.Player, "「レ…オ…モン?レオモンって書いてある。<NEWLINE> あとは…ちょっと読めないな。」<NEWLINE>");
    anim(Entity.Player, Animation(16), wait: 15);
    showTextbox("「うーん、言葉は何でもわかるけど、<NEWLINE> 字はそうでもないみたい…」<NEWLINE>");
    playAnimation(Entity.Player, Animation(0));
    showTextbox("「持っていこう。」<NEWLINE>");
    giveItem(Item.Leomonstone, 1);
    if (trigger(0)) {
      speak(Entity.Player, "「いけね、何か捨てなきゃ。」<NEWLINE>");
      unsetTrigger(Trigger(3));
      callSubroutine(0);
      callSubroutine(13);
      giveItem(Item.Leomonstone, 1);
    }
    playSound(0, 7);
    speak(Entity.System, "<LIGHTBLUE>レオモン族の石板<WHITE>を手に入れた!<NEWLINE>");
    setTrigger(Trigger(135));
    return;
  }
  return;
}

section(5) {
  delay(10);
  anim(Entity(5), Animation(28), wait: 10);
  speak(Entity.Player, "「ん?なにもんだ?!」<NEWLINE>");
  speak(Entity(5), "「ナニモンだァ!」<NEWLINE>");
  rotate(entity: Entity(5), to: 1276);
  delay(5);
  rotate(entity: Entity(5), to: 2300);
  delay(5);
  rotate(entity: Entity(5), to: 3324);
  delay(5);
  rotate(entity: Entity(5), to: 252);
  delay(5);
  rotate(entity: Entity(5), to: 1276);
  delay(5);
  rotate(entity: Entity(5), to: 2300);
  delay(5);
  rotate(entity: Entity(5), to: 3324);
  delay(5);
  rotate(entity: Entity(5), to: 252);
  delay(5);
  move(entity: Entity(5), to: (-1412, 1251), sprint: 1);
  waitForEntity(Entity(5));
  unloadEntity(Entity(5));
  switch pstat[21] {
    0 => {
      setObjectVisibility(3, 0);
      move(entity: Entity.Player, to: (-1878, 2900), sprint: 1);
      waitForEntity(Entity.Player);
      anim(Entity.Player, Animation(12), wait: 10);
      setObjectVisibility(3, 1);
      playSound(0, 7);
      speak(Entity.System, "『<PINK>次元キーホルダー<WHITE>』を<NEWLINE> 手に入れた!<NEWLINE> アイテムを20個まで持てるぞ!<NEWLINE>");
      playSound(0, 7);
      setInventorySize(20);
      setTrigger(Trigger(47));
    }
    4 => {
      setObjectVisibility(4, 0);
      move(entity: Entity.Player, to: (-1878, 2900), sprint: 1);
      waitForEntity(Entity.Player);
      anim(Entity.Player, Animation(12), wait: 10);
      setObjectVisibility(4, 1);
      playSound(0, 7);
      speak(Entity.System, "『<PINK>次元キーホルダー<WHITE>』を<NEWLINE> 手に入れた!<NEWLINE> アイテムを30個まで持てるぞ!<NEWLINE>");
      setTrigger(Trigger(48));
      setInventorySize(30);
      setTrigger(Trigger(253));
      addPStat(PStat(1), 1);
    }
  }
  addPStat(PStat(21), 1);
  setTrigger(Trigger(333));
  return;
  garbage { 14 00 fe 00 14 00 33 00 26 00 34 00 70 00 05 00 0a 02 ff ff 19 00 00 00 87 00 18 00 24 00 19 00 57 00 02 01 fe 00 19 00 01 00 86 00 18 00 6e 00 19 00 4d fd 6c 07 4a fd 1b fd 1a 00 81 75 81 63 82 b1 82 ea 82 cd 81 49 82 b7 82 b0 81 5b 81 49 81 76 0d 00 00 00 4f 32 70 fe a0 0f 4a c8 67 00 28 00 50 00 fd 14 4a c8 1c 00 86 00 fe 00 fe 00 19 00 01 00 87 00 18 00 08 02 19 00 4d fd 6c 07 4a fd 1b fd 1a 00 81 75 82 a8 82 e2 81 41 90 ce 94 c2 82 aa 82 cd 82 df 82 b1 82 dc 82 ea 82 c4 82 e9 82 bc 81 42 82 c7 82 ea 81 63 81 76 0d 00 00 00 52 fd 23 fe f1 0a 00 00 4a fd 4d fd 6c 07 67 00 0a 00 56 00 fd 19 67 00 0a 00 5a 00 08 07 57 00 02 01 67 00 0a 00 1b fd 1a 00 81 75 83 8c 81 63 83 49 81 63 83 82 83 93 81 48 83 8c 83 49 83 82 83 93 82 c1 82 c4 8f 91 82 a2 82 c4 82 a0 82 e9 81 42 0d 00 81 40 82 a0 82 c6 82 cd 81 63 82 bf 82 e5 82 c1 82 c6 93 c7 82 df 82 c8 82 a2 82 c8 81 42 81 76 0d 00 00 00 56 00 fd 10 67 00 0f 00 1a 00 81 75 82 a4 81 5b 82 f1 81 41 8c be 97 74 82 cd 89 bd 82 c5 82 e0 82 ed 82 a9 82 e9 82 af 82 c7 81 41 0d 00 81 40 8e 9a 82 cd 82 bb 82 a4 82 c5 82 e0 82 c8 82 a2 82 dd 82 bd 82 a2 81 63 81 76 0d 00 00 00 56 00 fd 00 1a 00 81 75 8e 9d 82 c1 82 c4 82 a2 82 b1 82 a4 81 42 81 76 0d 00 00 00 28 00 76 01 19 00 00 00 00 00 18 00 d4 01 19 00 1b fd 1a 00 81 75 82 a2 82 af 82 cb 81 41 89 bd 82 a9 8e cc 82 c4 82 c8 82 ab 82 e1 81 42 81 76 0d 00 00 00 1d 00 03 00 64 00 64 0d 28 00 76 01 5a 00 00 07 1b ff 1a 00 01 06 83 8c 83 49 83 82 83 93 91 b0 82 cc 90 ce 94 c2 01 01 82 f0 8e e8 82 c9 93 fc 82 ea 82 bd 81 49 0d 00 00 00 1c 00 87 00 fe 00 fe 00 67 00 0a 00 56 00 05 1c 67 00 0a 00 1b fd 1a 00 81 75 82 f1 81 48 82 c8 82 c9 82 e0 82 f1 82 be 81 48 81 49 81 76 0d 00 00 00 1b 05 1a 00 81 75 83 69 83 6a 83 82 83 93 82 be 83 40 81 49 81 76 0d 00 00 00 4d 05 fc 04 67 00 05 00 4d 05 fc 08 67 00 05 00 4d 05 fc 0c 67 00 05 00 4d 05 fc 00 67 00 05 00 4d 05 fc 04 67 00 05 00 4d 05 fc 08 67 00 05 00 4d 05 fc 0c 67 00 05 00 4d 05 fc 00 67 00 05 00 4e 05 7c fa e3 04 01 00 4a