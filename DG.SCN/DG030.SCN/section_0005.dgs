// source: extract/DIGIMON/SCN/DG.SCN
// DG030.SCN, section 5

section section_5(5) {  // len=1980
    if (trigger(120)) goto L_0014;
    goto L_001a;
    goto L_0018;
L_0014:
    goto L_04d0;
L_0018:
    return;
L_001a:
    setDialogOwner(5);
    showTextbox("Shoot! We hit a big rock!\n");
    showTextbox("I can't drill thru.\n");
    setDialogOwner(Entity.Player);
    showTextbox("You can't? Oh no!\n");
    setDialogOwner(5);
    showTextbox("We gotta figure out how to\nmove it. Can you do it?\n");
    playAnimation(Entity.Player, 19);
    delay(20);
    setDialogOwner(Entity.Player);
    showTextbox("I don't know.\n");
    look(entity: Entity.Player, at: Entity.Partner);
    playAnimation(Entity.Player, 14);
    delay(20);
    setDialogOwner(Entity.Player);
    showTextbox("<ORANGE><DIGIMON><WHITE>,\nI need your help.\n");
    move(entity: Entity.Partner, to: (-337, 170), sprint: 0);
    look(entity: Entity.Player, at: Entity.Partner);
    waitForEntity(Entity.Partner);
    delay(20);
    rotate(entity: Entity.Partner, to: 2000);
    look(entity: 5, at: Entity.Partner);
    look(entity: Entity.Player, at: Entity.Partner);
    storeDigimonType(103);
    if (pstat[103] != 1 && pstat[103] != 2 && pstat[103] != 3 && pstat[103] != 4 && pstat[103] != 15) goto L_01c0;
    goto L_051c;
L_01c0:
    if (pstat[103] != 16 && pstat[103] != 17 && pstat[103] != 18 && pstat[103] != 29 && pstat[103] != 30) goto L_01e0;
    goto L_051c;
L_01e0:
    if (pstat[103] != 31 && pstat[103] != 32 && pstat[103] != 43 && pstat[103] != 44 && pstat[103] != 45) goto L_0200;
    goto L_051c;
L_0200:
    if (pstat[103] != 46 && pstat[103] != 57) goto L_0214;
    goto L_051c;
L_0214:
    playAnimation(Entity.Partner, 27);
    setObjectVisibility(0, 0);
    moveBoulder(0, 50);
    playSound(8, 3);
    delay(20);
    moveBoulder(0, 100);
    move(entity: Entity.Partner, to: (-337, 270), sprint: 0);
    playSound(8, 3);
    delay(20);
    moveBoulder(0, 100);
    move(entity: Entity.Partner, to: (-337, 370), sprint: 0);
    playSound(8, 3);
    delay(20);
    moveBoulder(0, 100);
    move(entity: Entity.Partner, to: (-337, 470), sprint: 0);
    playSound(8, 3);
    delay(20);
    moveBoulder(10, 200);
    move(entity: Entity.Partner, to: (-337, 670), sprint: 0);
    playSound(8, 3);
    delay(5);
    moveBoulder(50, 300);
    playSound(8, 3);
    delay(5);
    moveBoulder(60, 400);
    playSound(8, 3);
    delay(5);
    moveBoulder(80, 500);
    playSound(8, 3);
    delay(3);
    moveBoulder(80, 600);
    playSound(8, 3);
    delay(3);
    moveBoulder(80, 600);
    playSound(8, 3);
    delay(3);
    moveBoulder(120, 300);
    playSound(8, 3);
    delay(2);
    moveBoulder(120, 100);
    playSound(8, 3);
    delay(2);
    moveBoulder(120, 100);
    playSound(8, 3);
    delay(1);
    despawnBoulder();
    playSound(8, 3);
    delay(20);
    playAnimation(Entity.Partner, 0);
    delay(5);
    setObjectVisibility(0, 1);
    setDialogOwner(Entity.Player);
    showTextbox("We did it!\n");
    setDialogOwner(5);
    showTextbox("Wow, amazing power!\nWe moved the rock!\n");
    setDialogOwner(Entity.Player);
    showTextbox("I think it's empty past\nthis point.\n");
    rotate(entity: Entity.Player, to: 2000);
    move(entity: Entity.Player, to: (-131, 1250), sprint: 0);
    waitForEntity(Entity.Player);
    rotate(entity: Entity.Player, to: 2000);
    setDialogOwner(Entity.Player);
    showTextbox("It's a lava river!\nIt's dangerous!\n");
    showTextbox("There's a path along\nthe river. Let's go!\n");
    setDialogOwner(5);
    showTextbox("Are you going inside?\nBe careful!\n");
    setTrigger(120);
    warp(to: Map.TUNN07, spawn: 0, trigger: 255);
    return;
L_04d0:
    setDialogOwner(5);
    showTextbox("Are you going inside?\nBe careful!\n");
    return;
L_051c:
    delay(20);
    playAnimation(Entity.Partner, 27);
    delay(20);
    playAnimation(Entity.Partner, 1);
    delay(30);
    setDialogOwner(5);
    showTextbox("Come back <ORANGE><DIGIMON><WHITE>\nwhen you grow more.\n");
    move(entity: Entity.Player, to: (-337, 0), sprint: 0);
    waitForEntity(Entity.Player);
    return;
    garbage { 10 00 fe 00 10 00 33 00 2c 00 05 00 44 00 ff ff 19 00 01 00 78 00 18 00 26 00 19 00 76 00 7c 00 2a 00 27 00 09 06 57 00 00 01 fe 00 19 00 01 00 d1 00 18 00 3e 00 19 00 4b 1e 00 ff fe 00 4b 7a 00 ff fe 00 19 00 01 00 78 00 18 00 58 00 19 00 16 00 5e 00 16 00 5c 00 16 00 14 05 fe 00 1b 05 1a 00 82 72 82 88 82 8f 82 8f 82 94 81 49 81 40 82 76 82 85 81 40 82 88 82 89 82 94 81 40 82 81 81 40 82 82 82 89 82 87 81 40 82 92 82 8f 82 83 82 8b 81 49 0d 00 00 00 1a 00 82 68 81 40 82 83 82 81 82 8e 81 75 82 94 81 40 82 84 82 92 82 89 82 8c 82 8c 81 40 82 94 82 88 82 92 82 95 81 42 0d 00 00 00 1b fd 1a 00 82 78 82 8f 82 95 81 40 82 83 82 81 82 8e 81 75 82 94 81 48 81 40 82 6e 82 88 81 40 82 8e 82 8f 81 49 0d 00 00 00 1b 05 1a 00 82 76 82 85 81 40 82 87 82 8f 82 94 82 94 82 81 81 40 82 86 82 89 82 87 82 95 82 92 82 85 81 40 82 8f 82 95 82 94 81 40 82 88 82 8f 82 97 81 40 82 94 82 8f 0d 00 82 8d 82 8f 82 96 82 85 81 40 82 89 82 94 81 42 81 40 82 62 82 81 82 8e 81 40 82 99 82 8f 82 95 81 40 82 84 82 8f 81 40 82 89 82 94 81 48 0d 00 00 00 56 00 fd 13 67 00 14 00 1b fd 1a 00 82 68 81 40 82 84 82 8f 82 8e 81 75 82 94 81 40 82 8b 82 8e 82 8f 82 97 81 42 0d 00 00 00 4c 00 fd fc 56 00 fd 0e 67 00 14 00 1b fd 1a 00 01 0a 06 00 01 01 81 43 0d 00 82 68 81 40 82 8e 82 85 82 85 82 84 81 40 82 99 82 8f 82 95 82 92 81 40 82 88 82 85 82 8c 82 90 81 42 0d 00 00 00 4e fc af fe aa 00 00 00 4c 00 fd fc 4a fc 67 00 14 00 4d fc d0 07 4c 00 05 fc 4c 00 fd fc 22 67 19 00 08 00 67 01 48 00 67 02 48 00 67 03 48 00 67 04 48 00 67 0f 18 00 04 02 19 00 16 00 60 05 19 00 08 00 67 10 48 00 67 11 48 00 67 12 48 00 67 1d 48 00 67 1e 18 00 24 02 19 00 16 00 60 05 19 00 08 00 67 1f 48 00 67 20 48 00 67 2b 48 00 };
