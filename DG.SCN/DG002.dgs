// DG002.SCN
#include "functions.dgs"
#pragma script index=2 start=0x7800 end=0x8000 headerU16=0x20 sentinelOff=0x24
#include "entities.dgs"

section onEnter(254) {
  roll(pstat: 110, max: 99);
  if (pstat[110] > 24) goto L1;
  spawnItem(Item.Digimushroom, x: 46, y: 45);

L1:
  roll(pstat: 110, max: 99);
  if (pstat[110] > 4) goto L2;
  spawnItem(Item.Happymushroom, x: 60, y: 59);

L2:
  if (trigger(232)) goto L3;
  playAnimation(6, 28);

L3:
  return;
}

section(5) {
  speak(5, "I'm going to win!\n");
  finishEncounter(277);
}

section(7) {
  speak(7, "Okay, come on, boy!\n");
  finishEncounter(277);
}

section(8) {
  speak(8, "What's going to happen next?\n");
  finishEncounter(274);
}

section(9) {
  speak(9, "No way it will work.\n");
  finishEncounter(274);
}

section(6) {
  setTrigger(44);
  playAnimation(6, 29);
  speak(6, "I'm hungry.\n");
  setDialogOwner(Entity.Player);
  choice { "Give food" -> L1, "Don't give food" -> L8 }
  goto L8;

L1:
  setTrigger(3);
  callSubroutine(0);
  if (!trigger(3)) goto L2;
  speak(Entity.Player, "I don't have food now.\n");
  goto L8;

L2:
  if (pstat[254] != 255) goto L3;
  goto L8;

L3:
  if (pstat[254] != 38 && pstat[254] != 39 && pstat[254] != 40 && pstat[254] != 41) goto L4;
  callSubroutine(12);
  goto L6;

L4:
  if (pstat[254] != 42 && pstat[254] != 44 && pstat[254] != 62 && pstat[254] != 68) goto L5;
  callSubroutine(12);
  goto L6;
  goto L6;

L5:
  speak(Entity.Player, "Oops, I can't give you this.\n");
  goto L8;

L6:
  anim(6, 30, wait: 20);
  playAnimation(6, 8);
  waitForEntity(6);
  speak(6, "That's good...\n");
  playAnimation(6, 0);
  showTextbox("Let's fight!\n");
  setTrigger(1);
  setPStat(250, 1);
  setPStat(251, 6);
  setPStat(252, 255);
  setPStat(253, 255);
  startBattle();
  unsetTrigger(1);
  setPStat(250, 0);
  look(entity: Entity.Player, at: 6);
  look(entity: 6, at: Entity.Player);
  look(entity: Entity.Partner, at: 6);
  speak(6, "This isn't good.\nWhat should I do?\n");
  playAnimation(Entity.Player, 20);
  waitForEntity(Entity.Player);
  speak(Entity.Player, "Come to the city and work\noff what you ate!\n");
  anim(Entity.Player, 0, wait: 10);
  speak(6, "Okay, I'll do that. I'm an\nInsectoid-Digimon named\nKunemon. Nice meeting you.\n");
  goto L7;

L7:
  approach(who: 6, x: 1219, y: 984, tries: 3, wait: 20);
  playSound(8, 11);
  speak(Entity.System, "Kunemon joins the city!\n");
  moveCamera(to: Entity.Player, speed: 10);
  waitForEntity(200);
  setTrigger(232);
  addPStat(1, 1);
  goto L9;

L8:
  speak(6, "Bring some next time.\n");
  anim(6, 28, wait: 20);
  goto L9;

L9:
  return;
}

section(51) {
  if (trigger(185)) goto L1;
  move(entity: Entity.Player, to: (413, 2200), sprint: 0);
  warp(to: Map.MAYO08B, spawn: 1, trigger: 255);

L1:
  move(entity: Entity.Player, to: (413, 2200), sprint: 0);
  warp(to: Map.MAYO08A, spawn: 1, trigger: 255);
  garbage { 20 00 fe 00 20 00 05 00 5e 00 07 00 96 00 08 00 d2 00 09 00 20 01 06 00 5e 01 33 00 46 05 ff ff 24 00 6e 63 19 00 0b 00 6e 18 18 00 36 00 19 00 74 2c 2e 00 2d 00 24 00 6e 63 19 00 0b 00 6e 04 18 00 4c 00 19 00 74 45 3c 00 3b 00 19 00 01 00 e8 00 18 00 5c 00 19 00 56 00 06 1c fe 00 1b 05 1a 00 82 68 81 75 82 8d 81 40 82 87 82 8f 82 89 82 8e 82 87 81 40 82 94 82 8f 81 40 82 97 82 89 82 8e 81 49 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 15 01 fe 00 1b 07 1a 00 82 6e 82 8b 82 81 82 99 81 43 81 40 82 83 82 8f 82 8d 82 85 81 40 82 8f 82 8e 81 43 81 40 82 82 82 8f 82 99 81 49 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 15 01 fe 00 1b 08 1a 00 82 76 82 88 82 81 82 94 81 75 82 93 81 40 82 87 82 8f 82 89 82 8e 82 87 81 40 82 94 82 8f 81 40 82 88 82 81 82 90 82 90 82 85 82 8e 81 40 82 8e 82 85 82 98 82 94 81 48 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 12 01 fe 00 1b 09 1a 00 82 6d 82 8f 81 40 82 97 82 81 82 99 81 40 82 89 82 94 81 40 82 97 82 89 82 8c 82 8c 81 40 82 97 82 8f 82 92 82 8b 81 42 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 12 01 fe 00 1c 00 2c 00 56 00 06 1d 1b 06 1a 00 82 68 81 75 82 8d 81 40 82 88 82 95 82 8e 82 87 82 92 82 99 81 42 0d 00 00 00 1b fd 10 02 ca 01 06 05 1a 00 82 66 82 89 82 96 82 85 81 40 82 86 82 8f 82 8f 82 84 0d 00 82 63 82 8f 82 8e 81 75 82 94 81 40 82 87 82 89 82 96 82 85 81 40 82 86 82 8f 82 8f 82 84 0d 00 00 00 12 00 16 00 06 05 1c 00 03 00 64 00 19 00 00 00 03 00 18 00 14 02 19 00 1b fd 1a 00 82 68 81 40 82 84 82 8f 82 8e 81 75 82 94 81 40 82 88 82 81 82 96 82 85 81 40 82 86 82 8f 82 8f 82 84 81 40 82 8e 82 8f 82 97 81 42 0d 00 00 00 16 00 06 05 19 00 08 00 fe ff 18 00 24 02 19 00 16 00 06 05 19 00 08 00 fe 26 48 00 fe 27 48 00 fe 28 48 00 fe 29 18 00 42 02 19 00 64 0c 16 00 a8 02 19 00 08 00 fe 2a 48 00 fe 2c 48 00 fe 3e 48 00 fe 44 18 00 64 02 19 00 64 0c 16 00 a8 02 16 00 a8 02 1b fd 1a 00 82 6e 82 8f 82 90 82 93 81 43 81 40 82 68 81 40 82 83 82 81 82 8e 81 75 82 94 81 40 82 87 82 89 82 96 82 85 81 40 82 99 82 8f 82 95 }
}
