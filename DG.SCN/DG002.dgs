// DG002.SCN
#include "functions.dgs"
#pragma script index=2 start=0x7000 end=0x7800 headerU16=0x20 sentinelOff=0x24
#include "entities.dgs"

section onEnter(254) {
  spawnItemChance(max: 99, chance: 24, item: Item.Digimushroom, x: 46, y: 45);
  spawnItemChance(max: 99, chance: 4, item: Item.Happymushroom, x: 60, y: 59);
  if (!trigger(232)) {
    playAnimation(Entity(6), Animation(28));
  }
  return;
}

section(5) {
  speak(Entity(5), "「お前さんには、負けないアルヨ!」<NEWLINE>");
  finishEncounter(Trigger(277));
}

section(7) {
  speak(Entity(7), "「オッケー、カモンボーイ!」<NEWLINE>");
  finishEncounter(Trigger(277));
}

section(8) {
  speak(Entity(8), "「ハァ~、この先どうなることやら…」<NEWLINE>");
  finishEncounter(Trigger(274));
}

section(9) {
  speak(Entity(9), "「ぶつぶつ…、かなうワケないじゃん…」<NEWLINE>");
  finishEncounter(Trigger(274));
}

section(6) {
  {
    setTrigger(Trigger(44));
    playAnimation(Entity(6), Animation(29));
    speak(Entity(6), "「お腹すいた。食べ物ない?」<NEWLINE>");
    setDialogOwner(Entity.Player);
    setSelection(L1, L2);
    showTextbox("「食べ物を渡す」<NEWLINE>「何もあげない」<NEWLINE>");
    waitForSelectionChoice();
    break;

L1:
    setTrigger(Trigger(3));
    callSubroutine(0);
    if (trigger(3)) {
      speak(Entity.Player, "「今、何も無いんだった…」<NEWLINE>");
      break;
    }
    if (pstat[254] == 255) {
      break;
    }
    {
      if (pstat[254] == 38 || pstat[254] == 39 || pstat[254] == 40 || pstat[254] == 41) {
        callSubroutine(12);
        break;
      }
      if (pstat[254] == 42 || pstat[254] == 44 || pstat[254] == 62 || pstat[254] == 68) {
        callSubroutine(12);
        break;
        break;
      }
      speak(Entity.Player, "「おっと、これをあげるわけにはいかない。」<NEWLINE>");
      goto L2;
    }
    {
      anim(Entity(6), Animation(30), wait: 20);
      playAnimation(Entity(6), Animation(8));
      waitForEntity(Entity(6));
      speak(Entity(6), "「ムシャムシャ…なかなか…」<NEWLINE>");
      playAnimation(Entity(6), Animation(0));
      showTextbox("「フゥー、それじゃ戦うとしよう。」<NEWLINE>");
      setTrigger(Trigger(1));
      setPStat(PStat(250), 1);
      setPStat(PStat(251), 6);
      setPStat(PStat(252), 255);
      setPStat(PStat(253), 255);
      startBattle();
      unsetTrigger(Trigger(1));
      setPStat(PStat(250), 0);
      look(entity: Entity.Player, at: Entity(6));
      look(entity: Entity(6), at: Entity.Player);
      look(entity: Entity.Partner, at: Entity(6));
      speak(Entity(6), "「かなわないね。どうしよう。」<NEWLINE>");
      playAnimation(Entity.Player, Animation(20));
      waitForEntity(Entity.Player);
      speak(Entity.Player, "「…食った分、街に来て働けよな!」<NEWLINE>");
      anim(Entity.Player, Animation(0), wait: 10);
      speak(Entity(6), "「ふむ、そうしよう。ボクは虫デジモンの<NEWLINE> クネモンだ。ヨロシク。」<NEWLINE>");
      break;
    }
    approach(who: Entity(6), x: 1219, y: 984, tries: 3, wait: 20);
    playSound(8, 11);
    speak(Entity.System, "クネモンが街に参加した!!!<NEWLINE>");
    followEntity(Entity.Player, speed: 10);
    setTrigger(Trigger(232));
    addPStat(PStat(1), 1);
    goto L3;

L2:
  }
  speak(Entity(6), "「今度は持ってきてよ。」<NEWLINE>");
  anim(Entity(6), Animation(28), wait: 20);
  goto L3;

L3:
  return;
}

section(51) {
  if (!trigger(185)) {
    move(entity: Entity.Player, to: (413, 2200), sprint: 0);
    warp(to: Map.MAYO08B, spawn: 1, trigger: 255);
  }
  move(entity: Entity.Player, to: (413, 2200), sprint: 0);
