// source: extract/DIGIMON/SCN/DG.SCN
// DG178.SCN, section 6

section section_6(6) {  // len=2460
    if (trigger(56)) goto L_0156;
    if (!trigger(96) && pstat[18] < 10) goto L_0020;
    goto L_0156;
L_0020:
    setDialogOwner(6);
    showTextbox("You can have this. Good luck.\n");
    setDialogOwner(Entity.System);
    showTextbox("I got lots of Items!\n");
    giveItem(Item.SmallRecovery, 3);
    giveItem(Item.Meat, 3);
    giveItem(Item.MPFloppy, 3);
    giveItem(Item.Restore, 1);
    giveItem(Item.Bandage, 2);
    giveItem(Item.Medicine, 1);
    setDialogOwner(6);
    showTextbox("To look up Items, press\n<GREEN><TRIANGLE> <WHITE>...\n");
    showTextbox("...then select 'Item'\nand look by using\n<LIGHTBLUE><X> <WHITE>.\n");
    setTrigger(56);
    return;
L_0156:
    if (trigger(224) || !trigger(175)) goto L_01ca;
    setDialogOwner(6);
    showTextbox("Sounds like Yuramon has\ngathered more rumors.\n");
    return;
L_01ca:
    if (!trigger(124) || !trigger(103)) goto L_022a;
    setDialogOwner(6);
    showTextbox("I hear Yuramon\nhas some new rumors.\n");
    return;
L_022a:
    if (pstat[1] < 6) goto L_02b4;
    setDialogOwner(6);
    showTextbox("The city is starting to\ngrow and I hear it's\nchanging now.\n");
    return;
L_02b4:
    setDialogOwner(6);
    showTextbox("I will teach you about the\ncommon sense in our world.\n");
    showTextbox("There are twenty four hours\na day and there is morning,\nday and night.\n");
    showTextbox("You may feel\nthe pace is quick.\n");
    showTextbox("There are thirty days a year.\nMonth? What's that? Seasons?\nCan you eat that?\n");
    showTextbox("Of course we have money.\nThe unit is a bit. You can\nnever have too much money.\n");
    showTextbox("When you say 'city' on\nthis island, that means here.\n");
    showTextbox("But there are other\nsmall villages and towns.\n");
    showTextbox("On the clock, the yellow dot\nis hours and the needle is\nminutes.\n");
    showTextbox("Up is Midnight\nand Down is Noon.\n");
    showTextbox("The red part on the left\nmeans late afternoon. It\nshows four - eight o'clock.\n");
    showTextbox("The purple part on the\nright is morning and it\nshows four - eight o'clock.\n");
    showTextbox("Digimon are active at\ncertain times of day.\n");
    showTextbox("Most of them get up in the\nmorning and sleep at night,\nbut some are opposite.\n");
    showTextbox("If you can't meet the\nDigimon you wish, try\na different time of day.\n");
    return;
}
