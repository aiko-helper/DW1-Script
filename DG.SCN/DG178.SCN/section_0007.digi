  0000:  if trigger(54) then section_7+0x14
  000c:  jumpToScriptSection ROOM14 5
  0012:  endSection
  0014:  storeRandom 110 2
  0018:  if pstat[1] < 3 OR pstat[110] != 0 then section_7+0x94
  0028:  setDialogOwner 7
  002a:  showTextbox "Talk to Tsunomon and\nYuramon as often as you can.\n"
  0092:  endSection
  0094:  if pstat[1] < 3 OR pstat[110] != 1 then section_7+0x28a
  00a4:  setDialogOwner 7
  00a6:  showTextbox "I'll tell you about\nthe Tamer level.\n"
  00f4:  showTextbox "With a high Tamer level,\nwhen your Digimon fades away,\n"
  0166:  showTextbox "your next Digimon will have\nbetter parameters.\n"
  01c8:  showTextbox "In the beginning\nit won't go up much,\n"
  0218:  showTextbox "but keep steadily raising him\nand it will get better.\n"
  0288:  endSection
  028a:  if pstat[1] < 3 OR pstat[110] != 2 then section_7+0x3ec
  029a:  setDialogOwner 7
  029c:  showTextbox "When you use your Finishing\nTechnique, make sure to\nrapidly hit L and R buttons.\n"
  0342:  showTextbox "When Finish Gauge is full,\ncompared to when empty, the\ndamage to enemy is double!\n"
  03ea:  endSection
  03ec:  setDialogOwner 7
  03ee:  showTextbox "I'll tell you about a\nDigimon's life.\n"
  043e:  showTextbox "When Digimon gets hungry,\nhe'll tell you.\n"
  0496:  showTextbox "He also needs to go potty.\nMake sure he does it\nin the toilet.\n"
  0518:  showTextbox "Digimon get sleepy and\nneed sleep, but you have to\nmake him sleep.\n"
  05a2:  showTextbox "Don't try to keep him up\nfor too long.\n"
  05f4:  showTextbox "He may get tired, sick\nor just get upset.\nHe's kinda delicate.\n"
  0676:  showTextbox "Since Digimon are wild\ncreatures, you should\npraise or scold them.\n"
  0700:  showTextbox "Whatever you do,\npay attention to what\nyour Digimon is doing.\n"
  0780:  endSection
