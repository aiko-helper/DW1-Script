// source: extract/DIGIMON/SCN/DG.SCN
// DG178.SCN, section 7

section section_7(7) {  // len=1922
    if (trigger(54)) goto L_0014;
    jumpToScriptSection(209, 5);
    return;
L_0014:
    roll(pstat: 110, max: 2);
    if (pstat[1] < 3 || pstat[110] != 0) goto L_0094;
    setDialogOwner(7);
    showTextbox("Talk to Tsunomon and\nYuramon as often as you can.\n");
    return;
L_0094:
    if (pstat[1] < 3 || pstat[110] != 1) goto L_028a;
    setDialogOwner(7);
    showTextbox("I'll tell you about\nthe Tamer level.\n");
    showTextbox("With a high Tamer level,\nwhen your Digimon fades away,\n");
    showTextbox("your next Digimon will have\nbetter parameters.\n");
    showTextbox("In the beginning\nit won't go up much,\n");
    showTextbox("but keep steadily raising him\nand it will get better.\n");
    return;
L_028a:
    if (pstat[1] < 3 || pstat[110] != 2) goto L_03ec;
    setDialogOwner(7);
    showTextbox("When you use your Finishing\nTechnique, make sure to\nrapidly hit L and R buttons.\n");
    showTextbox("When Finish Gauge is full,\ncompared to when empty, the\ndamage to enemy is double!\n");
    return;
L_03ec:
    setDialogOwner(7);
    showTextbox("I'll tell you about a\nDigimon's life.\n");
    showTextbox("When Digimon gets hungry,\nhe'll tell you.\n");
    showTextbox("He also needs to go potty.\nMake sure he does it\nin the toilet.\n");
    showTextbox("Digimon get sleepy and\nneed sleep, but you have to\nmake him sleep.\n");
    showTextbox("Don't try to keep him up\nfor too long.\n");
    showTextbox("He may get tired, sick\nor just get upset.\nHe's kinda delicate.\n");
    showTextbox("Since Digimon are wild\ncreatures, you should\npraise or scold them.\n");
    showTextbox("Whatever you do,\npay attention to what\nyour Digimon is doing.\n");
    return;
}
