; source: extract/DIGIMON/SCN/DG.SCN
; DG178.SCN, section 85

section_85(85):     ; len=658
  0000:  if trigger(94) then section_85+0x1ea
  000c:  setTrigger 94
  0010:  setDialogOwner Player
  0012:  showTextbox "What's this machine?\n"
  0040:  lookAt 5 Player
  0044:  lookAt Player 5
  0048:  delay 5
  004c:  setDialogOwner 5
  004e:  showTextbox "Oh that? That is a\n<PINK>Save Machine for\nMemory Card Battle Data<WHITE>.\n"
  00d0:  showTextbox "Using that machine, you can\nsave your current partner's\ndata for battle.\n"
  0166:  showTextbox "Just press <LIGHTBLUE><X> <WHITE>,\nand the machine will tell\nyou what to do.\n"
  01e0:  setRotation Player 0
  01e4:  delay 5
  01e8:  endSection
  01ea:  setDialogOwner System
  01ec:  showTextbox "Do you want to use\n<PINK>Save Machine for\nMemory Card Battle Data<WHITE>?\n"
  026e:  setSelection section_85+0x28a section_85+0x290
  0274:  showTextbox "Yes\nNo\n"
  0286:  waitForSelectionChoice
  0288:  endSection
  028a:  fadeOutHUD
  028c:  callSubroutine 48
  028e:  endSection
  0290:  endSection
