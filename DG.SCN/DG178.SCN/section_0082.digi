  0090:  setDialogOwner System
  0092:  showTextbox "<YELLOW>Punimon <WHITE>\nI'm Punimon! Why don't you\nrest here a while?\n"
  0108:  showTextbox "<YELLOW>Punimon <WHITE>\nOne hour rest recovers HP,\nMP and lowers Tiredness.\n"
  018a:  setDialogOwner Player
  018c:  setSelection section_82+0x1be section_82+0x1da
  0192:  showTextbox "Rest\nDon't rest\n"
  01b6:  waitForSelectionChoice
  01b8:  playSound 0 1
  01bc:  endSection
  01be:  storeDate 105
  01c0:  addMinutesToDate 105 60
  01c6:  advanceToDate 105
  01c8:  addStats CurrentHP 300
  01cc:  addStats CurrentMP 300
  01d0:  reduceStats Tiredness 10
