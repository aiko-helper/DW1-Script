section_82(82):     ; len=480
  0000:  setRotation Player 3072
  0004:  delay 5
  0008:  playSound 0 0
  000c:  if !trigger(231) AND !trigger(245) AND !trigger(233) AND !trigger(247) then section_82+0x90
  0024:  setDialogOwner Player
  0026:  showTextbox "I don't see Punimon, but\nI think I'll rest here.\n"
