// source: extract/DIGIMON/SCN/DG.SCN
// DG178.SCN, section 85

section section_85(85) {  // len=658
    if (trigger(94)) goto L_01ea;
    setTrigger(94);
    setDialogOwner(Entity.Player);
    showTextbox("What's this machine?\n");
    look(entity: 5, at: Entity.Player);
    look(entity: Entity.Player, at: 5);
    delay(5);
    setDialogOwner(5);
    showTextbox("Oh that? That is a\n<PINK>Save Machine for\nMemory Card Battle Data<WHITE>.\n");
    showTextbox("Using that machine, you can\nsave your current partner's\ndata for battle.\n");
    showTextbox("Just press <LIGHTBLUE><X> <WHITE>,\nand the machine will tell\nyou what to do.\n");
    rotate(entity: Entity.Player, to: 0);
    delay(5);
    return;
L_01ea:
    setDialogOwner(Entity.System);
    showTextbox("Do you want to use\n<PINK>Save Machine for\nMemory Card Battle Data<WHITE>?\n");
    setSelection(L_028a, L_0290);
    showTextbox("Yes\nNo\n");
    waitForSelectionChoice();
    return;
L_028a:
    fadeOutHUD();
    callSubroutine(48);
    return;
L_0290:
    return;
}
