; source: ./extract/DIGIMON/SCN/DG.SCN
; DG178.SCN, section 6

section_6(6):     ; len=2460
  0000:  if trigger(56) then section_6+0x156
  000c:  if !trigger(96) AND pstat[18] < 10 then section_6+0x20
  001c:  jump section_6+0x156
  0020:  speak 6 "You can have this. Good luck.\n"
  0062:  speak System "I got lots of Items!\n"
  0092:  giveItem SmallRecovery 3
  0096:  giveItem Meat 3
  009a:  giveItem MPFloppy 3
  009e:  giveItem Restore 1
  00a2:  giveItem Bandage 2
  00a6:  giveItem Medicine 1
  00aa:  speak 6 "To look up Items, press\n<GREEN><TRIANGLE> <WHITE>...\n"
  00f0:  showTextbox "...then select 'Item'\nand look by using\n<LIGHTBLUE><X> <WHITE>.\n"
  0150:  setTrigger 56
  0154:  endSection
  0156:  if trigger(224) OR !trigger(175) then section_6+0x1ca
  0166:  speak 6 "Sounds like Yuramon has\ngathered more rumors.\n"
  01c8:  endSection
  01ca:  if !trigger(124) OR !trigger(103) then section_6+0x22a
  01da:  speak 6 "I hear Yuramon\nhas some new rumors.\n"
  0228:  endSection
  022a:  if pstat[1] < 6 then section_6+0x2b4
  0236:  speak 6 "The city is starting to\ngrow and I hear it's\nchanging now.\n"
  02b2:  endSection
  02b4:  speak 6 "I will teach you about the\ncommon sense in our world.\n"
  0326:  showTextbox "There are twenty four hours\na day and there is morning,\nday and night.\n"
  03b8:  showTextbox "You may feel\nthe pace is quick.\n"
  03fc:  showTextbox "There are thirty days a year.\nMonth? What's that? Seasons?\nCan you eat that?\n"
  049a:  showTextbox "Of course we have money.\nThe unit is a bit. You can\nnever have too much money.\n"
  053c:  showTextbox "When you say 'city' on\nthis island, that means here.\n"
  05aa:  showTextbox "But there are other\nsmall villages and towns.\n"
  060a:  showTextbox "On the clock, the yellow dot\nis hours and the needle is\nminutes.\n"
  0690:  showTextbox "Up is Midnight\nand Down is Noon.\n"
  06d6:  showTextbox "The red part on the left\nmeans late afternoon. It\nshows four - eight o'clock.\n"
  0776:  showTextbox "The purple part on the\nright is morning and it\nshows four - eight o'clock.\n"
  0810:  showTextbox "Digimon are active at\ncertain times of day.\n"
  086c:  showTextbox "Most of them get up in the\nmorning and sleep at night,\nbut some are opposite.\n"
  090c:  showTextbox "If you can't meet the\nDigimon you wish, try\na different time of day.\n"
  099a:  endSection
