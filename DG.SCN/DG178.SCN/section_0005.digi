  0528:  endSection
  052a:  if !trigger(50) OR trigger(201) then section_5+0x73c
  053a:  setDialogOwner 5
  053c:  showTextbox "You're here!\nThis is something I can't\nask anybody else.\n"
  05b2:  setDialogOwner 253
  05b4:  showTextbox "Never fear, I'm here.\nDo you mean\nAnalogman is back?\n"
  0622:  setDialogOwner 5
  0624:  showTextbox "I can feel his evil, but\nI can't tell where it is.\n"
  068e:  setDialogOwner 253
  0690:  showTextbox "Leave it up to me! I'll find\nhim and take care of it.\n"
  0700:  setDialogOwner 5
  0702:  showTextbox "Thank you.\nBy the way...\n"
  0738:  setTrigger 201
  073c:  if !trigger(203) then section_5+0x74e
