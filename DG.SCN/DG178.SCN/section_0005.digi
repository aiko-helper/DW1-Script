  075e:  playAnimation 5 29
  0762:  delay 5
  0766:  setDialogOwner 5
  0768:  showTextbox "I'm back and I'm planning\nto rebuild File City with\nhelp from <ORANGE><DIGIMON><WHITE>.\n"
  07f2:  playAnimation 5 0
  07f6:  playAnimation 5 29
  07fa:  delay 5
