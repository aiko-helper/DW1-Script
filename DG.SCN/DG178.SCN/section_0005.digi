  075a:  playAnimation 5 0
  075e:  playAnimation 5 29
  0762:  delay 5
  0766:  speak 5 "I'm back and I'm planning\nto rebuild File City with\nhelp from <ORANGE><DIGIMON><WHITE>.\n"
  07f2:  playAnimation 5 0
  07f6:  playAnimation 5 29
  07fa:  delay 5
  07fe:  speak 5 "I want to build\nshops that are useful\nto you and <ORANGE><DIGIMON><WHITE>.\n"
  0870:  playAnimation 5 0
  0874:  playAnimation 5 29
  0878:  delay 5
  087c:  speak 5 "You should explore Native\nForest just outside the city.\n"
