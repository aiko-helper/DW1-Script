section_5:     ; len=2296
  0000:  if trigger(202) OR trigger(215) OR pstat[16] == 0 then section_5+0x224
  0014:  if !trigger(201) OR !trigger(243) then section_5+0x224
  0024:  setDialogOwner 5
  0026:  showTextbox "You had perfect timing in\ncoming here! I have a favor\nthat only you can do.\n"
  00c2:  setDialogOwner 253
  00c4:  showTextbox "What is it?\n"
  00e0:  setDialogOwner 5
  00e2:  showTextbox "I just got the same evil\nfeeling that Analogman\nand Machinedramon give.\n"
  0176:  showTextbox "I know where it comes from.\n"
  01b2:  setDialogOwner 253
  01b4:  showTextbox "Again? Ok, leave it to me!\n"
  01ee:  setDialogOwner 5
  01f0:  showTextbox "Thanks. By the way...\n"
  0220:  jump section_5+0x73c
  0224:  if !trigger(202) OR trigger(215) then section_5+0x52a
  0234:  setDialogOwner 5
  0236:  showTextbox "I heard you beat\nMachinedramon!\n"
  027a:  setDialogOwner 253
  027c:  showTextbox "Yeah, but I don't get it.\nIt seemed like the curse\nof Analogman.\n"
  0302:  setDialogOwner 5
  0304:  showTextbox "His grudge was so strong.\nMaybe we can have peace now.\n"
  0376:  setDialogOwner 253
  0378:  showTextbox "If Machinedramon returns,\nwe'll beat him again.\n"
  03dc:  setDialogOwner 5
  03de:  showTextbox "You're trustworthy. This was\ngrowing in our Meat farm,\nit's for you.\n"
  046c:  setDialogOwner 253
  046e:  showTextbox "Woah! A <LIGHTBLUE>Chained\nMelon<WHITE>?\n"
  04a4:  giveItem 70 1
  04a8:  if !trigger(0) then section_5+0x504
  04b4:  if item[79] < 99 then section_5+0x4c4
  04c2:  endSection
