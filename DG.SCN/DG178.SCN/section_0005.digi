section_5(5):     ; len=2296
  0000:  if trigger(202) OR trigger(215) OR pstat[16] == 0 then section_5+0x224
  0014:  if !trigger(201) OR !trigger(243) then section_5+0x224
  0024:  speak 5 "You had perfect timing in\ncoming here! I have a favor\nthat only you can do.\n"
  00c2:  speak Player "What is it?\n"
  00e0:  speak 5 "I just got the same evil\nfeeling that Analogman\nand Machinedramon give.\n"
  0176:  showTextbox "I know where it comes from.\n"
  01b2:  speak Player "Again? Ok, leave it to me!\n"
  01ee:  speak 5 "Thanks. By the way...\n"
  0220:  jump section_5+0x73c
  0224:  if !trigger(202) OR trigger(215) then section_5+0x52a
  0234:  speak 5 "I heard you beat\nMachinedramon!\n"
  027a:  speak Player "Yeah, but I don't get it.\nIt seemed like the curse\nof Analogman.\n"
  0302:  speak 5 "His grudge was so strong.\nMaybe we can have peace now.\n"
  0376:  speak Player "If Machinedramon returns,\nwe'll beat him again.\n"
  03dc:  speak 5 "You're trustworthy. This was\ngrowing in our Meat farm,\nit's for you.\n"
  046c:  speak Player "Woah! A <LIGHTBLUE>Chained\nMelon<WHITE>?\n"
  04a4:  giveItem ChainMelon 1
  04a8:  if !trigger(0) then section_5+0x504
  04b4:  if item[SpikeClub] < 99 then section_5+0x4c4
  04c2:  endSection
  04c4:  speak Player "I have too many Items.\n"
  04f8:  setTrigger 3
  04fc:  callSubroutine 0
  04fe:  callSubroutine 13
  0500:  giveItem ChainMelon 1
  0504:  speak Player "Thank you!\n"
  0520:  pstat[28] = 0
  0524:  setTrigger 215
  0528:  endSection
  052a:  if !trigger(50) OR trigger(201) then section_5+0x73c
  053a:  speak 5 "You're here!\nThis is something I can't\nask anybody else.\n"
  05b2:  speak Player "Never fear, I'm here.\nDo you mean\nAnalogman is back?\n"
  0622:  speak 5 "I can feel his evil, but\nI can't tell where it is.\n"
  068e:  speak Player "Leave it up to me! I'll find\nhim and take care of it.\n"
  0700:  speak 5 "Thank you.\nBy the way...\n"
  0738:  setTrigger 201
  073c:  if !trigger(203) then section_5+0x74e
