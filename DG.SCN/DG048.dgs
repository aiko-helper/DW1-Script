// DG048.SCN
#include "functions.dgs"
#pragma script index=48 start=0x23800 end=0x24000 headerU16=0x14 sentinelOff=0x1c75
#include "entities.dgs"

section onEnter(254) {
  spawnChest(Item.MPChip, 835, 2461, 0, 650);
  spawnChest(Item.Restore, -2455, -1042, 3072, 651);
  spawnChest(Item.Autopilot, 44, -2504, 3072, 652);
  if (trigger(132)) {
    setObjectVisibility(15, 0);
  }
  return;
}

section(5) {
  speak(Entity(5), "「ここをまもらなくてはいけない。」<NEWLINE>");
  finishEncounter(Trigger(308));
}

section(6) {
  speak(Entity(6), "「めいれい、なんだっけ?」<NEWLINE>");
  finishEncounter(Trigger(308));
}

section(51) {
  if (!trigger(132)) {
    speak(Entity.Player, "「ん?」<NEWLINE>");
    playSound(8, 4);
    setObjectVisibility(15, 0);
    delay(10);
    speak(Entity.Player, "「んわぁぁぁーーーっ!?」<NEWLINE>");
    playSound(8, 5);
    warp(to: Map.YAKA23, spawn: 2, trigger: 52);
    return;
  } else {
    speak(Entity.Player, "「いくぞ!」<NEWLINE>");
    playSound(8, 4);
    playSound(8, 5);
    warp(to: Map.YAKA23, spawn: 2, trigger: 52);
    return;
  }
  return;
