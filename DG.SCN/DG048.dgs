// DG048.SCN
#include "functions.dgs"
#pragma script index=48 start=0x24800 end=0x25000 headerU16=0x24 sentinelOff=0x2075
#include "entities.dgs"

section onEnter(254) {
  spawnChest(Item.PortaPotty, -1455, 184, 3072, 671);
  if (trigger(175)) {
    moveObjectTo(0, 45, 1, 10, 0, 385, -50);
    delay(10);
  }
  return;
}

section(5) {
  speak(Entity(5), "Ah!\n");
  finishEncounter(Trigger(203));
}

section(6) {
  speak(Entity(6), "Ah!\n");
  finishEncounter(Trigger(203));
}

section(51) {
  if (trigger(182) && !trigger(235)) {
    speak(Entity.Player, "Is the elevator causing\nthe ground to rise?\n");
  }
  if (!trigger(175)) {
    return;
  }
  {
    setDialogOwner(Entity.Player);
    choice { "Get in" -> L1, "Don't get in" -> L_00d4 }
    break;

L1:
    move(entity: Entity.Player, to: (1220, 3988), sprint: 0);
    move(entity: Entity.Partner, to: (1201, 3486), sprint: 0);
    waitForPair();
    playSound(8, 5);
    warp(to: Map.GCAN02, spawn: 3, trigger: 53);
    return;
  }
  move(entity: Entity.Player, to: (1152, 2851), sprint: 0);
  waitForEntity(Entity.Player);
  return;
}

section(52) {
  if (!trigger(175)) {
    goto L1;
  }
  return;

L1:
  panTo(x: 40, y: 2922, slowdown: 30);
  lookPairAt(Entity(7));
  anim(Entity.Player, Animation(7), wait: 15);
  speak(Entity.Player, "Hey!\n");
  playAnimation(Entity.Player, Animation(0));
  look(entity: Entity(7), at: Entity.Player);
  look(entity: Entity(8), at: Entity.Player);
  look(entity: Entity(9), at: Entity.Player);
  speak(Entity(7), "What?\n");
  showTextbox("Did you come here to lose?\n");
  playSound(8, 11);
  anim(Entity.Player, Animation(20), wait: 15);
  speak(Entity.Player, "That's my line!\n");
  playAnimation(Entity.Player, Animation(0));
  speak(Entity(7), "I'm holding nothing back\nthis time. I'll make you cry!\n");
  setTrigger(Trigger(1));
  setPStat(PStat(250), 1);
  setPStat(PStat(251), 7);
  setPStat(PStat(252), 8);
  setPStat(PStat(253), 9);
  startBattle();
  unsetTrigger(Trigger(1));
  setPStat(PStat(250), 0);
  look(entity: Entity.Player, at: Entity(7));
  look(entity: Entity(7), at: Entity.Player);
  look(entity: Entity.Partner, at: Entity(7));
  speak(Entity(8), "Wow!\n");
  speak(Entity(9), "Oh no!\n");
  move(entity: Entity(8), to: (224, -784), sprint: 1);
  move(entity: Entity(9), to: (116, -784), sprint: 1);
  waitForEntity(Entity(8));
  waitForEntity(Entity(9));
  unloadEntity(Entity(8));
  unloadEntity(Entity(9));
  speak(Entity(7), "Darn it!\n");
  anim(Entity(7), Animation(46), wait: 30);
  playSound(8, 9);
  setObjectsVisibleRange(0, 25, 0);
  delay(40);
  setPStat(PStat(254), 40);
  callSubroutine(45);
  delay(40);
  unloadEntity(Entity(7));
  anim(Entity.Player, Animation(24), wait: 15);
  speak(Entity.Player, "What is it?\n");
  playAnimation(Entity.Player, Animation(0));
  setObjectsVisibleRange(0, 25, 1);
  setDigimon(Digimon.NPCOgremon, Entity(5), 0);
  rotate(entity: Entity(10), to: 0);
  moveObjectTo(0, 45, 1, 10, 0, 385, -50);
  delay(10);
  callSubroutine(46);
  delay(40);
  playSound(8, 11);
  speak(Entity(10), "Bye, dumb guys!\n");
  look(entity: Entity.Player, at: Entity(10));
  playSound(8, 5);
  waitForEntity(Entity(10));
  unloadEntity(Entity(10));
  setTrigger(Trigger(176));
  speak(Entity.Player, "Darn, he got away!\n");
  move(entity: Entity.Player, to: (1234, 2267), sprint: 1, withCamera: true);
  move(entity: Entity.Partner, to: (774, 2251), sprint: 1);
  waitForPair();
  rotate(entity: Entity.Player, to: 2037);
  rotate(entity: Entity.Partner, to: 2300);
  speak(Entity.Player, "There is an escape elevator.\nChasing him will do no good.\n");
  setTrigger(Trigger(175));
  followEntity(Entity.Player, speed: 10);
  return;
}

section(53) {
  if (!trigger(175)) {
    move(entity: Entity.Player, to: (245, 1250), sprint: 1, withCamera: true);
    move(entity: Entity.Partner, to: (-50, 1250), sprint: 1);
    waitForPair();
    goto section_52.L1;
  }
  return;
}

section(54) {
  playSound(8, 5);
  rotate(entity: Entity.Player, to: 0);
  unsetTrigger(Trigger(180));
  setTrigger(Trigger(181));
  return;
}

section(11) {
  delay(10);
  anim(Entity(11), Animation(28), wait: 10);
  speak(Entity.Player, "Who are you?\n");
  speak(Entity(11), "Who am I? Who are you?\n");
  rotate(entity: Entity(11), to: 1276);
  delay(5);
  rotate(entity: Entity(11), to: 2300);
  delay(5);
  rotate(entity: Entity(11), to: 3324);
  delay(5);
  rotate(entity: Entity(11), to: 252);
  delay(5);
  rotate(entity: Entity(11), to: 1276);
  delay(5);
  rotate(entity: Entity(11), to: 2300);
  delay(5);
  rotate(entity: Entity(11), to: 3324);
  delay(5);
  rotate(entity: Entity(11), to: 252);
  delay(5);
  move(entity: Entity(11), to: (179, -74), sprint: 1);
  waitForEntity(Entity(11));
  unloadEntity(Entity(11));
  if (pstat[21] == 0) {
    setObjectVisibility(43, 0);
    move(entity: Entity.Player, to: (32, 829), sprint: 1);
    waitForEntity(Entity.Player);
    anim(Entity.Player, Animation(12), wait: 10);
    setObjectVisibility(43, 1);
    playSound(0, 7);
    speak(Entity.System, "I got a <PINK>Dimensional\nKey Chain<WHITE>!\nI can carry twenty Items!\n");
    playSound(0, 7);
    setInventorySize(20);
    setTrigger(Trigger(47));
  }
  if (pstat[21] == 4) {
    setObjectVisibility(42, 0);
    move(entity: Entity.Player, to: (32, 829), sprint: 1);
    waitForEntity(Entity.Player);
    anim(Entity.Player, Animation(12), wait: 10);
    setObjectVisibility(42, 1);
    playSound(0, 7);
    speak(Entity.System, "I got a <PINK>Dimensional\nKey Chain<WHITE>!\nI can carry thirty Items!\n");
    setInventorySize(30);
    setTrigger(Trigger(48));
    setTrigger(Trigger(253));
    addPStat(PStat(1), 1);
  }
  addPStat(PStat(21), 1);
  setTrigger(Trigger(334));
  return;
  garbage { 24 00 fe 00 24 00 05 00 4c 00 06 00 68 00 33 00 84 00 34 00 64 01 35 00 62 05 36 00 88 05 0b 00 9a 05 ff ff 75 20 51 fa 00 00 b8 00 00 0c 9f 02 19 00 00 00 af 00 18 00 4a 00 19 00 71 00 2d 01 0a 00 81 01 ce ff 67 00 0a 00 }
}
