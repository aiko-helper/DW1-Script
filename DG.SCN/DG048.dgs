// DG048.SCN
#include "functions.dgs"
#pragma script index=48 start=0x24800 end=0x25000 headerU16=0x24 sentinelOff=0x2075
#include "entities.dgs"

section onEnter(254) {
  spawnChest(Item.PortaPotty, -1455, 184, 3072, 671);
  if (!trigger(175)) goto L1;
  moveObjectTo(0, 45, 1, 10, 0, 385, -50);
  delay(10);

L1:
  return;
}

section(5) {
  speak(5, "Ah!\n");
  finishEncounter(203);
}

section(6) {
  speak(6, "Ah!\n");
  finishEncounter(203);
}

section(51) {
  if (!trigger(182) || trigger(235)) goto L1;
  speak(Entity.Player, "Is the elevator causing\nthe ground to rise?\n");

L1:
  if (trigger(175)) goto L2;
  return;

L2:
  setDialogOwner(Entity.Player);
  choice { "Get in" -> L3, "Don't get in" -> L4 }
  goto L4;

L3:
  move(entity: Entity.Player, to: (1220, 3988), sprint: 0);
  move(entity: Entity.Partner, to: (1201, 3486), sprint: 0);
  waitForPair();
  playSound(8, 5);
  warp(to: Map.GCAN02, spawn: 3, trigger: 53);
  return;

L4:
  move(entity: Entity.Player, to: (1152, 2851), sprint: 0);
  waitForEntity(Entity.Player);
  return;
}

section(52) {
  if (trigger(175)) goto L1;
  goto L2;

L1:
  return;

L2:
  moveCamera(to: (40, 2922), slowdown: 30);
  waitForEntity(200);
  lookPairAt(7);
  anim(Entity.Player, 7, wait: 15);
  speak(Entity.Player, "Hey!\n");
  playAnimation(Entity.Player, 0);
  look(entity: 7, at: Entity.Player);
  look(entity: 8, at: Entity.Player);
  look(entity: 9, at: Entity.Player);
  speak(7, "What?\n");
  showTextbox("Did you come here to lose?\n");
  playSound(8, 11);
  anim(Entity.Player, 20, wait: 15);
  speak(Entity.Player, "That's my line!\n");
  playAnimation(Entity.Player, 0);
  speak(7, "I'm holding nothing back\nthis time. I'll make you cry!\n");
  setTrigger(1);
  setPStat(250, 1);
  setPStat(251, 7);
  setPStat(252, 8);
  setPStat(253, 9);
  startBattle();
  unsetTrigger(1);
  setPStat(250, 0);
  look(entity: Entity.Player, at: 7);
  look(entity: 7, at: Entity.Player);
  look(entity: Entity.Partner, at: 7);
  speak(8, "Wow!\n");
  speak(9, "Oh no!\n");
  move(entity: 8, to: (224, -784), sprint: 1);
  move(entity: 9, to: (116, -784), sprint: 1);
  waitForEntity(8);
  waitForEntity(9);
  unloadEntity(8);
  unloadEntity(9);
  speak(7, "Darn it!\n");
  anim(7, 46, wait: 30);
  playSound(8, 9);
  setObjectsVisibleRange(0, 25, 0);
  delay(40);
  setPStat(254, 40);
  callSubroutine(45);
  delay(40);
  unloadEntity(7);
  anim(Entity.Player, 24, wait: 15);
  speak(Entity.Player, "What is it?\n");
  playAnimation(Entity.Player, 0);
  setObjectsVisibleRange(0, 25, 1);
  setDigimon(Digimon.NPCOgremon, 5, 0);
  rotate(entity: 10, to: 0);
  moveObjectTo(0, 45, 1, 10, 0, 385, -50);
  delay(10);
  callSubroutine(46);
  delay(40);
  playSound(8, 11);
  speak(10, "Bye, dumb guys!\n");
  look(entity: Entity.Player, at: 10);
  playSound(8, 5);
  waitForEntity(10);
  unloadEntity(10);
  setTrigger(176);
  speak(Entity.Player, "Darn, he got away!\n");
  move(entity: Entity.Player, to: (1234, 2267), sprint: 1, withCamera: true);
  move(entity: Entity.Partner, to: (774, 2251), sprint: 1);
  waitForPair();
  rotate(entity: Entity.Player, to: 2037);
  rotate(entity: Entity.Partner, to: 2300);
  speak(Entity.Player, "There is an escape elevator.\nChasing him will do no good.\n");
  setTrigger(175);
  moveCamera(to: Entity.Player, speed: 10);
  waitForEntity(200);
  return;
}

section(53) {
  if (trigger(175)) goto L1;
  move(entity: Entity.Player, to: (245, 1250), sprint: 1, withCamera: true);
  move(entity: Entity.Partner, to: (-50, 1250), sprint: 1);
  waitForPair();
  goto section_52.L2;

L1:
  return;
}

section(54) {
  playSound(8, 5);
  rotate(entity: Entity.Player, to: 0);
  unsetTrigger(180);
  setTrigger(181);
  return;
}

section(11) {
  delay(10);
  anim(11, 28, wait: 10);
  speak(Entity.Player, "Who are you?\n");
  speak(11, "Who am I? Who are you?\n");
  rotate(entity: 11, to: 1276);
  delay(5);
  rotate(entity: 11, to: 2300);
  delay(5);
  rotate(entity: 11, to: 3324);
  delay(5);
  rotate(entity: 11, to: 252);
  delay(5);
  rotate(entity: 11, to: 1276);
  delay(5);
  rotate(entity: 11, to: 2300);
  delay(5);
  rotate(entity: 11, to: 3324);
  delay(5);
  rotate(entity: 11, to: 252);
  delay(5);
  move(entity: 11, to: (179, -74), sprint: 1);
  waitForEntity(11);
  unloadEntity(11);
  if (pstat[21] != 0) goto L1;
  setObjectVisibility(43, 0);
  move(entity: Entity.Player, to: (32, 829), sprint: 1);
  waitForEntity(Entity.Player);
  anim(Entity.Player, 12, wait: 10);
  setObjectVisibility(43, 1);
  playSound(0, 7);
  speak(Entity.System, "I got a <PINK>Dimensional\nKey Chain<WHITE>!\nI can carry twenty Items!\n");
  playSound(0, 7);
  setInventorySize(20);
  setTrigger(47);

L1:
  if (pstat[21] != 4) goto L2;
  setObjectVisibility(42, 0);
  move(entity: Entity.Player, to: (32, 829), sprint: 1);
  waitForEntity(Entity.Player);
  anim(Entity.Player, 12, wait: 10);
  setObjectVisibility(42, 1);
  playSound(0, 7);
  speak(Entity.System, "I got a <PINK>Dimensional\nKey Chain<WHITE>!\nI can carry thirty Items!\n");
  setInventorySize(30);
  setTrigger(48);
  setTrigger(253);
  addPStat(1, 1);

L2:
  addPStat(21, 1);
  setTrigger(334);
  return;
  garbage { 24 00 fe 00 24 00 05 00 4c 00 06 00 68 00 33 00 84 00 34 00 64 01 35 00 62 05 36 00 88 05 0b 00 9a 05 ff ff 75 20 51 fa 00 00 b8 00 00 0c 9f 02 19 00 00 00 af 00 18 00 4a 00 19 00 71 00 2d 01 0a 00 81 01 ce ff 67 00 0a 00 }
}
