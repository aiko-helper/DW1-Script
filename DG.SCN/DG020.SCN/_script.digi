; DG020.SCN
;!script index=20 start=0x14800 end=0x15000 headerU16=0x1c sentinelOff=0x24
;!sections onEnter section_5 section_6 section_7 section_8 section_81

onEnter:     ; len=68
  0000:  storeRandom 110 99
  0004:  if pstat[110] > 15 then onEnter+0x16
  0010:  spawnItem 44 31 57
  0016:  storeRandom 110 99
  001a:  if pstat[110] > 7 then onEnter+0x2c
  0026:  spawnItem 44 91 55
  002c:  storeRandom 110 99
  0030:  if pstat[110] > 6 then onEnter+0x42
  003c:  spawnItem 69 62 94
  0042:  endSection
