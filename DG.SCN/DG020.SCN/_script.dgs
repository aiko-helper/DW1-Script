#pragma sections section_0254 section_0005 section_0006 section_0007 section_0008 section_0081

section onEnter(254) {  // len=68
    roll(pstat: 110, max: 99);
    if (pstat[110] > 15) goto L_0016;
    spawnItem(Item.Digimushroom, 31, 57);
L_0016:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 7) goto L_002c;
    spawnItem(Item.Digimushroom, 91, 55);
L_002c:
    roll(pstat: 110, max: 99);
