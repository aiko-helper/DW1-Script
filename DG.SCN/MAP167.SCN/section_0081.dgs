// source: extract/DIGIMON/SCN/DG.SCN
// MAP167.SCN, section 81

section section_81(81) {  // len=504
    look(entity: Entity.Player, at: 5);
    delay(5);
    if (trigger(89)) goto L_01f0;
    setTrigger(89);
    setDialogOwner(5);
    showTextbox("Oh, <LIGHTBLUE><PLAYER><WHITE>and <ORANGE><DIGIMON><WHITE>,\nyou are here.\n");
    showTextbox("I'm a delivery man.\nI deliver anything.\n");
    showTextbox("The only thing you can\ncarry is yourself, right?\n");
    showTextbox("Why don't I carry you guys?\nGreat idea, Huh?\n");
    showTextbox("I'll take you\nanyplace, anytime.\nI'll charge you, of course.\n");
L_01f0:
    setPStat(254, 5);
    callSubroutine(10);
    return;
}
