; source: extract/DIGIMON/SCN/DG.SCN
; MAP167.SCN, section 81

section_81(81):     ; len=504
  0000:  lookAt Player 5
  0004:  delay 5
  0008:  if trigger(89) then section_81+0x1f0
  0014:  setTrigger 89
  0018:  setDialogOwner 5
  001a:  showTextbox "Oh, <LIGHTBLUE><PLAYER><WHITE>and <ORANGE><DIGIMON><WHITE>,\nyou are here.\n"
  005a:  showTextbox "I'm a delivery man.\nI deliver anything.\n"
  00ae:  showTextbox "The only thing you can\ncarry is yourself, right?\n"
  0114:  showTextbox "Why don't I carry you guys?\nGreat idea, Huh?\n"
  0172:  showTextbox "I'll take you\nanyplace, anytime.\nI'll charge you, of course.\n"
  01f0:  setPStat 254 5
  01f4:  callSubroutine 10
  01f6:  endSection
