  if (!trigger(209) && !trigger(208) && !trigger(222) && !trigger(223)) goto L1;
  warp(to: Map.FACT08A, spawn: 0, trigger: 255);

L1:
  warp(to: Map.FACT08B, spawn: 0, trigger: 255);
  return;
}

