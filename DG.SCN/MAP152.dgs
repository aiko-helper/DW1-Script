// MAP152.SCN
#include "functions.dgs"
#pragma script index=152 start=0x67000 end=0x67800 headerU16=0x18 sentinelOff=0x56
#include "entities.dgs"

section onEnter(254) {
  playAnimation(Entity(5), Animation(30));
  return;
}

section(81) {
  look(entity: Entity.Player, at: Entity(5));
  delay(5);
  if (!trigger(89)) {
    setTrigger(Trigger(89));
    speak(Entity(5), "「来たか、<LIGHTBLUE><PLAYER><WHITE>、<ORANGE><DIGIMON><WHITE>。」<NEWLINE>");
    showTextbox("「俺の仕事は運送屋だ。何でも運ぶぜ。」<NEWLINE>");
    showTextbox("「…と言っても、あんたらが運ぶものと<NEWLINE> 言えばその体だけ…。それなら…」<NEWLINE>");
    showTextbox("「俺があんたらを体ごと運ぶってのは<NEWLINE> 悪くないと思わないか?フフ…」<NEWLINE>");
    showTextbox("「あんたらが知っている場所へいつでも<NEWLINE> 連れてってやるぜ。金はもらうがね。」<NEWLINE>");
  }
  setPStat(PStat(254), 5);
  callSubroutine(10);
  return;
}

section(5) {
  setTrigger(Trigger(44));
  goto section_81;
  return;
}

section(6) {
  speak(Entity(6), "「やぁ、<LIGHTBLUE><PLAYER><WHITE>。」<NEWLINE>");
  speak(Entity(6), "「私は時々ギアサバンナにもどって<NEWLINE> パトロールをつづけているのだが、<NEWLINE> この店はとても役に立つな。」<NEWLINE>");
  speak(Entity(6), "「ところでギアサバンナの海ぞいには<NEWLINE> お店があるようだが、もう<NEWLINE> 行ったかい?」<NEWLINE>");
  return;
}

section(51) {
  move(entity: Entity.Player, to: (2200, -3000), sprint: 0);
  if (!trigger(203)) {
    warp(to: Map.TWNA01, spawn: 4, trigger: 255);
  }
  {
    if (trigger(220) || trigger(214) || pstat[1] >= 50) goto L2; else break;
  }
  {
    if (trigger(221)) goto L1; else break;
  }
  if (trigger(225)) {
    warp(to: Map.TWNA04, spawn: 4, trigger: 255);
  }
  if (trigger(246)) {
    warp(to: Map.TWNA03, spawn: 4, trigger: 255);
  }
  warp(to: Map.TWNA02, spawn: 4, trigger: 255);

L1:
  if (trigger(225)) {
    warp(to: Map.TWNA07, spawn: 4, trigger: 255);
  }
  if (trigger(246)) {
    warp(to: Map.TWNA06, spawn: 4, trigger: 255);
  }
  {
    warp(to: Map.TWNA05, spawn: 4, trigger: 255);

L2:
    if (trigger(221)) goto L3; else break;
  }
  if (trigger(225)) {
    warp(to: Map.TWNA10, spawn: 4, trigger: 255);
  }
  if (trigger(246)) {
    warp(to: Map.TWNA09, spawn: 4, trigger: 255);
  }
  warp(to: Map.TWNA08, spawn: 4, trigger: 255);

L3:
  if (trigger(225)) {
    warp(to: Map.TWNA13, spawn: 4, trigger: 255);
  }
  if (trigger(246)) {
    warp(to: Map.TWNA12, spawn: 4, trigger: 255);
  }
  warp(to: Map.TWNA11, spawn: 4, trigger: 255);
  return;
