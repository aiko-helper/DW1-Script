// MAP152.SCN
#include "functions.dgs"
#pragma script index=152 start=0x6c800 end=0x6d000 headerU16=0x28 sentinelOff=0xfe
#include "entities.dgs"

section onEnter(254) {
  return;
}

section(5) {
  speak(5, "Too much!\n");
  finishEncounter(287);
}

section(6) {
  speak(6, "Phew!\n");
  finishEncounter(287);
}

section(7) {
  speak(7, "Do you need to see me?\n");
  finishEncounter(287);
}

section(8) {
  speak(8, "Don't move!\n");
  finishEncounter(292);
}

section(9) {
  speak(9, "Wait! I'm telling you.\n");
  finishEncounter(292);
}

section(10) {
  speak(10, "I'll talk to you later.\n");
  finishEncounter(292);
}

section(81) {
  rotate3DObject(1, 1);
  sfx(8, 2, wait: 20);
  move(entity: Entity.Player, to: (-1999, 800), sprint: 0);
