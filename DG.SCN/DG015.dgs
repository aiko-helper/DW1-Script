// DG015.SCN
#include "functions.dgs"
#pragma script index=15 start=0x10000 end=0x11000 headerU16=0x1c sentinelOff=0x24
#include "entities.dgs"

section onEnter(254) {
  spawnItemChance(max: 99, chance: 14, item: Item.Digimushroom, x: 48, y: 80);
  spawnItemChance(max: 99, chance: 6, item: Item.Happymushroom, x: 40, y: 60);
  if (trigger(86) && !trigger(225)) {
    setObjectsVisibleRange(0, 3, 0);
  }
  return;
}

section(5) {
  speak(Entity(5), "Are you a Digimon?\n");
  finishEncounter(Trigger(277));
}

section(7) {
  speak(Entity(7), "Where you from Homie?!\n");
  finishEncounter(Trigger(277));
}

section(8) {
  speak(Entity(8), "Don't make fun of me!\n");
  finishEncounter(Trigger(296));
}

section(9) {
  speak(Entity(9), "I'm gonna gobble you!\n");
  finishEncounter(Trigger(278));
}

section(51) {
  if (trigger(225)) {
    return;
  }
  if (!trigger(86)) {
    return;
  }
  move(entity: Entity.Player, to: (-715, -2329), sprint: 0, withCamera: true);
  delay(20);
  rotate(entity: Entity.Player, to: 1024);
  delay(5);
  if (trigger(186)) {
    speak(Entity.Player, "Oh no, if I don't do\nanything, it will dry up...\n");
    showTextbox("I hope it rains...\n");
  } else {
    setTrigger(Trigger(186));
    speak(Entity.Player, "Wow, interesting.\nIt's sprouting.\n");
    delay(20);
    anim(Entity.Player, Animation(16), wait: 20);
    speak(Entity.Player, "It moved a little bit.\nIs this the mysterious plant\neveryone is talking about?\n");
    anim(Entity.Player, Animation(22), wait: 20);
    speak(Entity.Player, "It's wilting. If I don't\ndo anything, it'll die.\n");
    playAnimation(Entity.Player, Animation(0));
  }
  speak(Entity.System, "Gonna use some Items?\n");
  setDialogOwner(Entity.Player);
  choice { "Yes" -> L1, "No" -> L6 }
  goto L6;

L1:
  setTrigger(Trigger(3));
  callSubroutine(0);
  if (trigger(3)) {
    speak(Entity.Player, "I don't have anything now.\n");
    goto L6;
  }
  if (pstat[254] == 255) {
    speak(Entity.Player, "Nothing I have is useful.\n");
    goto L6;
  }
  if (pstat[254] == 121) {
    fadeOutHUD();
    callSubroutine(12);
  } else {
    speak(Entity.Player, "This won't work...\n");
    goto L6;
    return;
  }
  loadDigimon(Digimon.NPCVegimon);
  setObjectsVisibleRange(3, 15, 0);
  setPStat(PStat(247), 3);
  setPStat(PStat(248), 13);
  callSubroutine(21);
  setObjectsVisibleRange(16, 19, 0);
  setPStat(PStat(247), 16);
  setPStat(PStat(248), 4);
  callSubroutine(21);
  setObjectsVisibleRange(20, 32, 0);
  setPStat(PStat(247), 20);
  setPStat(PStat(248), 13);
  callSubroutine(21);
  delay(50);
  sfx(8, 1, wait: 100);
  setObjectsVisibleRange(3, 32, 1);
  setObjectsVisibleRange(33, 76, 0);
  setPStat(PStat(247), 33);
  setPStat(PStat(248), 44);
  callSubroutine(21);
  delay(30);
  setObjectsVisibleRange(0, 3, 1);
  delay(40);
  playSound(8, 2);
  setDigimon(Digimon.NPCVegimon, Entity(1), 0);
  delay(5);
  playAnimation(Entity(6), Animation(28));
  waitForEntity(Entity(6));
  anim(Entity(6), Animation(0), wait: 20);
  setObjectsVisibleRange(33, 75, 1);
  anim(Entity.Player, Animation(15), wait: 10);
  playSound(8, 2);
  anim(Entity(6), Animation(28), wait: 20);
  playSound(8, 2);
  playAnimation(Entity(6), Animation(28));
  move(entity: Entity(6), to: (-977, -1946), animDuration: 3);
  delay(20);
  playSound(8, 2);
  playAnimation(Entity(6), Animation(28));
  move(entity: Entity(6), to: (-1254, -2263), animDuration: 3);
  delay(20);
  playSound(8, 2);
  playAnimation(Entity(6), Animation(28));
  move(entity: Entity(6), to: (-1025, -2799), animDuration: 3);
  delay(20);
  playSound(8, 2);
  playAnimation(Entity(6), Animation(28));
  move(entity: Entity(6), to: (-1025, -2349), animDuration: 3);
  delay(20);
  look(entity: Entity(6), at: Entity.Player);
  delay(5);
  speak(Entity(6), "He he he.\n");
  showTextbox("Hey, I'm Vegiemon!\n");
  anim(Entity.Player, Animation(15), wait: 20);
  speak(Entity.Player, "What! A plant Digimon?\n");
  speak(Entity(6), "By the way, do you like\nveggies?\n");
  playSound(8, 5);
  anim(Entity.Player, Animation(16), wait: 20);
  speak(Entity.Player, "Why are you asking me\nabout veggies? Well?\n");
  setTrigger(Trigger(49));
  setSelection(L2, L3);
  showTextbox("I like them\nI don't\n");
  speak(Entity.Player, "Well, I changed my mind.\n");
  return;

L2:
  unsetTrigger(Trigger(49));
  playSound(8, 5);
  speak(Entity(6), "Anyone who likes veggies\nmust be a nice guy.\n");
  goto L4;

L3:
  unsetTrigger(Trigger(49));
  playSound(8, 5);
  speak(Entity(6), "No, no!\nVeggies are good!\n");
  goto L4;

L4:
  speak(Entity.Player, " ? ? ? \n");
  speak(Entity(6), "Alright, I've decided.\nI'll come with you!\n");
  anim(Entity.Player, Animation(19), wait: 20);
  speak(Entity.Player, "What a persistent guy...\nHey, wait!\n");
  playSound(8, 5);
  speak(Entity(6), "Well, then I won't come!\nBye!\n");
  speak(Entity.Player, "Make up your mind!\n");
  speak(Entity(6), "What do you want me to do?\n");
  anim(Entity.Player, Animation(20), wait: 10);
  speak(Entity.Player, "Why don't you come to\nthe city and help us!\n");
  playAnimation(Entity.Player, Animation(0));
  playSound(8, 5);
  speak(Entity(6), "Alright, sounds good.\nI've been here way too long.\n");
  move(entity: Entity.Player, to: (-1024, -1820), sprint: 1, withCamera: true);
  move(entity: Entity.Partner, to: (-741, -1923), sprint: 1);
  goto L5;

L5:
  approach(who: Entity(6), x: 911, y: -2266, tries: 10, wait: 10);
  playSound(8, 3);
  speak(Entity.System, "Vegiemon joins the city!\n");
  followEntity(Entity.Player, speed: 10);
  setTrigger(Trigger(225));
  addPStat(PStat(1), 2);
  return;

L6:
  move(entity: Entity.Player, to: (-61, -2273), sprint: 0, withCamera: true);
  waitForEntity(Entity.Player);
  return;
  garbage { 1c 00 fe 00 1c 00 05 00 6a 00 07 00 a4 00 08 00 e6 00 09 00 26 01 33 00 66 01 ff ff 24 00 6e 63 19 00 0b 00 6e 0e 18 00 32 00 19 00 74 2c 30 00 50 00 24 00 6e 63 19 00 0b 00 6e 06 18 00 48 00 19 00 74 45 28 00 3c 00 19 00 00 00 56 00 81 00 e1 00 18 00 68 00 19 00 57 00 00 00 57 00 01 00 57 00 02 00 57 00 03 00 fe 00 1b 05 1a 00 82 60 82 92 82 85 81 40 82 99 82 8f 82 95 81 40 82 81 81 40 82 63 82 89 82 87 82 89 82 8d 82 8f 82 8e 81 48 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 15 01 fe 00 1b 07 1a 00 82 76 82 88 82 85 82 92 82 85 81 40 82 99 82 8f 82 95 81 40 82 86 82 92 82 8f 82 8d 81 40 82 67 82 8f 82 8d 82 89 82 85 81 48 81 49 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 15 01 fe 00 1b 08 1a 00 82 63 82 8f 82 8e 81 75 82 94 81 40 82 8d 82 81 82 8b 82 85 81 40 82 86 82 95 82 8e 81 40 82 8f 82 86 81 40 82 8d 82 85 81 49 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 28 01 fe 00 1b 09 1a 00 82 68 81 75 82 8d 81 40 82 87 82 8f 82 8e 82 8e 82 81 81 40 82 87 82 8f 82 82 82 82 82 8c 82 85 81 40 82 99 82 8f 82 95 81 49 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 16 01 fe 00 19 00 00 00 e1 00 18 00 74 01 19 00 fe 00 19 00 01 00 56 00 18 00 82 01 19 00 fe 00 52 fd 35 fd e7 f6 00 00 67 00 14 00 4d fd 00 04 67 00 05 00 19 00 00 00 ba 00 18 00 38 02 19 00 1b fd 1a 00 82 6e 82 88 81 40 82 8e 82 8f 81 43 81 40 82 89 82 86 81 40 82 68 81 40 82 84 82 8f 82 8e 81 75 82 94 81 40 82 84 82 8f 0d 00 82 81 82 8e 82 99 82 94 82 88 82 89 82 8e 82 87 81 43 81 40 82 89 82 94 81 40 82 97 82 89 82 8c 82 8c 81 40 82 84 82 92 82 99 81 40 82 95 82 90 81 42 81 42 81 42 0d 00 00 00 1a 00 82 68 81 40 82 88 82 8f 82 90 82 85 81 40 82 89 82 94 81 40 82 92 82 81 82 89 82 8e 82 93 81 42 81 42 81 42 0d 00 00 00 16 00 aa 03 1c 00 ba 00 1b fd 1a 00 82 76 82 8f 82 97 81 43 81 40 82 89 82 8e 82 94 82 85 82 92 82 85 82 93 82 94 82 89 82 8e 82 87 81 42 0d 00 82 68 82 94 81 75 82 93 81 40 82 93 82 90 82 92 82 8f 82 95 82 94 82 89 82 8e 82 87 81 42 0d 00 00 00 67 00 14 00 56 00 fd 10 67 00 14 00 1b fd 1a 00 82 68 82 94 81 40 82 8d 82 8f 82 96 82 85 82 84 81 40 82 81 81 40 82 8c 82 89 82 94 82 94 82 8c 82 85 81 40 82 82 82 89 82 94 81 42 }
}
