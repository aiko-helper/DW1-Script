// DG015.SCN
#include "functions.dgs"
#pragma script index=15 start=0xf800 end=0x10000 headerU16=0x18 sentinelOff=0x24
#include "entities.dgs"

section onEnter(254) {
  spawnItemChance(max: 99, chance: 9, item: Item.Digimushroom, x: 23, y: 31);
  spawnItemChance(max: 99, chance: 3, item: Item.Happymushroom, x: 67, y: 47);
  return;
}

section(5) {
  {
    speak(Entity(5), "「ぐるるる…」<NEWLINE>");
    showTextbox("「ぐるるる…る…る?」<NEWLINE>");
    playAnimation(Entity.Player, Animation(16));
    showTextbox("「ナ…ニカ…何か…<NEWLINE> 何かよみがえってきたぁ!」<NEWLINE>");
    playSound(8, 0);
    look(entity: Entity.Player, at: Entity.Partner);
    look(entity: Entity.Partner, at: Entity.Player);
    delay(20);
    speak(Entity.Player, "'?\"\n");
    speak(Entity(5), "「ボク、昔街に住んでたんだ。<NEWLINE> キミ、街のにおいがするんだよね。」<NEWLINE>");
    lookPairAt(Entity(5));
    waitForEntity(Entity.Player);
    speak(Entity.Player, "「なんと。」<NEWLINE>");
    speak(Entity(5), "「こわいなあ、いつのまにか街から<NEWLINE> 出ちゃってて記憶もなくなってるんだ。」<NEWLINE>");
    showTextbox("「でも、おかげで全部思い出しましたー!」<NEWLINE>");
    showTextbox("「ボク、街に戻るよ。いいよね?」<NEWLINE>");
    playAnimation(Entity.Player, Animation(19));
    speak(Entity.Player, "「もちろん。きっと前よりもにぎやかに<NEWLINE> なってると思うぜ!」<NEWLINE>");
    playSound(8, 4);
    speak(Entity(5), "「ホント?<NEWLINE> よーし、ボクもがんばろーっと!」<NEWLINE>");
    break;
  }
  approach(who: Entity(5), x: 421, y: -1390, tries: 10, wait: 10);
  playSound(8, 3);
  speak(Entity.System, "ベタモンが街に参加した!!!<NEWLINE>");
  setTrigger(Trigger(204));
  addPStat(PStat(1), 1);
  followEntity(Entity.Player, speed: 10);
  return;
}

section(6) {
  speak(Entity(6), "「ボクのりょうちだぞっ!」<NEWLINE>");
  finishEncounter(Trigger(283));
}

section(7) {
  speak(Entity(7), "「ウキャッ、ウキャキャキャーッ!」<NEWLINE>");
  finishEncounter(Trigger(278));
}

section(8) {
  speak(Entity(8), "「み、みてろ。」<NEWLINE>");
  finishEncounter(Trigger(296));
