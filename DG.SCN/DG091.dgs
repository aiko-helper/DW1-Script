// DG091.SCN
#include "functions.dgs"
#pragma script index=91 start=0x40000 end=0x41000 headerU16=0x20 sentinelOff=0x24
#include "entities.dgs"

section onEnter(254) {
  roll(pstat: 110, max: 99);
  if (pstat[110] <= 5) {
    spawnItem(Item.Digimushroom, x: 49, y: 36);
  }
  roll(pstat: 110, max: 99);
  if (pstat[110] <= 17) {
    spawnItem(Item.Digimushroom, x: 59, y: 55);
  }
  roll(pstat: 110, max: 99);
  if (pstat[110] <= 7) {
    spawnItem(Item.Digimushroom, x: 48, y: 61);
  }
  roll(pstat: 110, max: 99);
  if (pstat[110] <= 2) {
    spawnItem(Item.IceMushroom, x: 38, y: 60);
  }
  return;
}

section(6) {
  speak(6, "I'm gonna win!\n");
  finishEncounter(271);
}

section(7) {
  speak(7, "You'll never beat me!\n");
  finishEncounter(271);
}

section(8) {
  speak(8, "He he! I'm so sorry!\n");
  finishEncounter(272);
}

section(9) {
  speak(9, "Are you ignoring me?\n");
  finishEncounter(272);
}

section(5) {
  if (trigger(195)) {
    goto L4;
  }
  speak(5, "If you want to go thru,\nyou must accept my challenge.\n");
  setTrigger(1);
  setPStat(250, 1);
  setPStat(251, 5);
  setPStat(252, 255);
  setPStat(253, 255);
  startBattle();
  unsetTrigger(1);
  setPStat(250, 0);
  look(entity: Entity.Player, at: 5);
  look(entity: 5, at: Entity.Player);
  look(entity: Entity.Partner, at: 5);
  speak(5, "I let my guard down,\nbut two on one isn't fair.\n");
  playAnimation(Entity.Player, 16);
  setTrigger(49);
  setDialogOwner(Entity.Player);
  setSelection(L1, L1);
  showTextbox("Well, that maybe so\nDon't be a sore loser\n");

L1:
  speak(5, "I never lose to anybody\nwhen it's a fair fight.\n");
  showTextbox("Let's fight one on one. Come\nback tomorrow at four O'clock.\nOnly Digimon will fight.\n");
  setDialogOwner(Entity.Player);
  setSelection(L2, L2);
  showTextbox("Alright\nNo thanks\n");

L2:
  playAnimation(Entity.Player, 16);
  unsetTrigger(49);
  speak(5, "It's a promise then.\nSee you tomorrow!\n");
  setTrigger(195);
  pstat[29] = time();
  goto L3;

L3:
  approach(who: 5, x: -2050, y: -150, tries: 6, wait: 10);
  moveCamera(to: Entity.Player, speed: 10);
  waitForEntity(200);
  return;

L4:
  pstat[:SavedTime] = time();
  if (trigger(195) && pstat[107] >= 15 && pstat[107] <= 17 && pstat[29] == 1) {
    speak(5, "You came back, good.\nToday, we'll fight fair!\n");
    goto L5;
    goto L5;
  }
  speak(5, "You're late, but that gave\nme time to nurse my injury.\nNow let's go for it.\n");
  goto L5;

L5:
  speak(Entity.Player, "I'll just watch. Start!\n");
  look(entity: Entity.Player, at: Entity.Partner);
  waitForEntity(Entity.Player);
  playAnimation(Entity.Player, 20);
  showTextbox("Go <ORANGE><DIGIMON><WHITE>!\n");
  setTrigger(2);
  setTrigger(1);
  setPStat(250, 1);
  setPStat(251, 5);
  setPStat(252, 255);
  setPStat(253, 255);
  startBattle();
  unsetTrigger(1);
  setPStat(250, 0);
  unsetTrigger(2);
  look(entity: Entity.Player, at: 5);
  look(entity: 5, at: Entity.Player);
  look(entity: Entity.Partner, at: 5);
  speak(5, "You're good! Who are you?\n");
  speak(Entity.Player, "We're exploring and trying to\nsave the island from danger.\n");
  speak(5, "What?\n");
  speak(Entity.System, "<LIGHTBLUE><PLAYER><WHITE> tries so hard\nto convince him!\n");
  anim(Entity.Player, 19, wait: 40);
  speak(5, "I'll help you. But, I'll\nhave to see that city first.\n");
  goto L6;

L6:
  approach(who: 5, x: -2000, y: -100, tries: 6, wait: 10);
  playSound(8, 11);
  speak(Entity.System, "Garurumon joins the city!\n");
  setTrigger(222);
  addPStat(1, 2);
  moveCamera(to: Entity.Player, speed: 10);
  waitForEntity(200);
}

section(51) {
  if ((cond & 0x40) == 0x01 && !trigger(133)) goto L1;
  return;

L1:
  storeDigimonType(103);
  if (pstat[103] == 3 || pstat[103] == 5 || pstat[103] == 8 || pstat[103] == 9 || pstat[103] == 47) {
    jumpToScriptSection(203, 51);
  }
  if (pstat[103] == 19 || pstat[103] == 32 || pstat[103] == 51 || pstat[103] == 1 || pstat[103] == 2) {
    jumpToScriptSection(203, 51);
  }
  if (pstat[103] == 15 || pstat[103] == 16 || pstat[103] == 29 || pstat[103] == 30 || pstat[103] == 43) {
    jumpToScriptSection(203, 51);
  }
  if (pstat[103] == 44 || pstat[103] == 21) {
    jumpToScriptSection(203, 51);
  }
  return;
