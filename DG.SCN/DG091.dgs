// DG091.SCN
#include "functions.dgs"
#pragma script index=91 start=0x3c000 end=0x3c800 headerU16=0x20 sentinelOff=0xb75
#include "entities.dgs"

section onEnter(254) {
  spawnChest(Item.Restore, -777, 519, 0, 657);
  spawnChest(Item.LargeRecovery, 793, -2801, 1024, 664);
  return;
}

section(51) {
  if (trigger(322)) {
    move(entity: Entity.Player, to: (-43, -4563), sprint: 0);
    warp(to: Map.ICSA01, spawn: 1, trigger: 5);
  }
  move(entity: Entity.Player, to: (-43, -4563), sprint: 0);
  warp(to: Map.ICSA01, spawn: 1, trigger: 255);
  return;
}

section(52) {
  move(entity: Entity.Player, to: (57, 3135), sprint: 0);
  warp(to: Map.ICSA03, spawn: 0, trigger: 255);
  return;
}

section(53) {
  move(entity: Entity.Player, to: (2289, -1947), sprint: 0);
  warp(to: Map.ICSA07, spawn: 0, trigger: 255);
  return;
}

section(5) {
  speak(Entity(5), "「きみ、ふるえてるよ!」<NEWLINE>");
  finishEncounter(Trigger(294));
}

section(6) {
  speak(Entity(6), "「さむい?そうなの?」<NEWLINE>");
  finishEncounter(Trigger(294));
}

