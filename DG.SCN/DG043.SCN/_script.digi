; DG043.SCN
;!script index=43 start=0x22000 end=0x22800 headerU16=0x2c sentinelOff=0x24
;!sections onEnter section_5 section_6 section_7 section_81 section_53 section_54 section_82 section_51 section_52

onEnter:     ; len=50
  0000:  storeRandom 110 99
  0004:  if pstat[110] > 9 then onEnter+0x16
  0010:  spawnItem Digimushroom 48 68
  0016:  storeRandom 110 99
  001a:  if pstat[110] > 3 then onEnter+0x2c
  0026:  spawnItem Pricklypear 76 49
  002c:  unsetTrigger 98
  0030:  endSection
