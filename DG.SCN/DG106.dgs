// DG106.SCN
#include "functions.dgs"
#pragma script index=106 start=0x4c000 end=0x4c800 headerU16=0x14 sentinelOff=0x24
#include "entities.dgs"

section onEnter(254) {
  roll(pstat: 110, max: 99);
  if (pstat[110] <= 19) {
    spawnItem(Item.Digimushroom, x: 61, y: 54);
  }
  roll(pstat: 110, max: 99);
  if (pstat[110] <= 4) {
    spawnItem(Item.Happymushroom, x: 39, y: 46);
  }
  roll(pstat: 110, max: 99);
  if (pstat[110] <= 14) {
    spawnItem(Item.Digimushroom, x: 55, y: 63);
  }
  return;
}

section(81) {
  rotate(entity: Entity.Player, to: 1536);
  speak(Entity.System, "Rockslide blocked the road...\n");
  return;
}

section(5) {
  speak(5, "Battle test!\n");
  showTextbox("Just kidding.\n");
  unloadEntity(5);
  return;
}

section(6) {
  speak(6, "I'm called Mr. Handy!\nWhat can I do for you?\n");
  setDialogOwner(Entity.Player);
  choice { "Change Parameters" -> L1, "Fast forward time" -> L2, "Master all Techniques" -> L14 }
  return;

L1:
  loop {
    setDialogOwner(Entity.Player);
    choice { "Increase" -> L6, "Decrease" -> L10, "Reset ability level" -> L15 }
    return;

L2:
    setDialogOwner(Entity.Player);
    choice { "Fast forward one hour" -> L3, "Fast forward six hours" -> L4, "Fast forward one day" -> L5 }
    return;

L3:
    pstat[:SavedTime] = time();
    addMinutesToDate(PStat.SavedTime, 60);
    advanceToDate(PStat.SavedTime);
    return;

L4:
    pstat[:SavedTime] = time();
    addMinutesToDate(PStat.SavedTime, 360);
    advanceToDate(PStat.SavedTime);
    return;

L5:
    pstat[:SavedTime] = time();
    addMinutesToDate(PStat.SavedTime, 1440);
    advanceToDate(PStat.SavedTime);
    return;

L6:
    setDialogOwner(Entity.Player);
    choice { "Add fifty" -> L7, "Add one hundred" -> L8, "Add two hundred" -> L9 }
    return;

L7:
    addStats(offense: 50, defense: 50, speed: 50, brains: 50, maxHP: 500, maxMP: 500, currentHP: 500, currentMP: 500);
    continue;
    return;

L8:
    addStats(offense: 100, defense: 100, speed: 100, brains: 100, maxHP: 1000, maxMP: 1000, currentHP: 1000, currentMP: 1000);
    continue;
    return;

L9:
    addStats(offense: 200, defense: 200, speed: 200, brains: 200, maxHP: 2000, maxMP: 2000, currentHP: 2000, currentMP: 2000);
    continue;
    return;

L10:
    setDialogOwner(Entity.Player);
    choice { "Minus fifty" -> L11, "Minus one hundred" -> L12, "Minus two hundred" -> L13 }
    return;

L11:
    reduceStats(offense: 50, defense: 50, speed: 50, brains: 50, maxHP: 500, maxMP: 500, currentHP: 500, currentMP: 500);
    continue;
    return;

L12:
    reduceStats(offense: 100, defense: 100, speed: 100, brains: 100, maxHP: 1000, maxMP: 1000, currentHP: 1000, currentMP: 1000);
    continue;
    return;

L13:
    reduceStats(offense: 200, defense: 200, speed: 200, brains: 200, maxHP: 2000, maxMP: 2000, currentHP: 2000, currentMP: 2000);
    continue;
    return;

L14:
    learnMoves([
      :FireTower, :ProminenceBeam, :SpitFire, :RedInferno,
      :MagmaBomb, :HeatLaser, :InifinityBurn, :Meltdown,
      :ThunderJustice, :SpinningShot, :ElectricCloud, :MegaloSpark,
      :StaticElect, :WindCutter, :ConfusedStorm, :Hurricane,
      :GigaFreeze, :IceStatue, :WinterBlast, :IceNeedle,
      :WaterBlit, :AquaMagic, :AuroraFreeze, :TearDrop,
      :PowerCrane, :AllRangeBeam, :MetalSprinter, :PulseLaser,
      :DeleteProgram, :DGDimension, :FullPotential, :ReverseProg,
      :PoisonPowder, :MassMorph, :InsectPlague, :CharmPerfume,
      :PoisonClaw, :DangerSting, :GreenTrap, :MuscleCharge,
      :SonicJab, :DynamiteKick, :MegatonPunch, :BusterDive,
      :OdorSpray, :PoopSpdToss, :BigPoopToss, :BigRndToss,
      :RndSpdToss, :HorizontalKick, :UltPoopHell, :BlazeBlast,
      :PepperBreath, :LovelyAttack, :Fireball, :DeathClaw
      ]);
    continue;
    return;

L15:
    setStats(offense: 50, defense: 50, speed: 50, brains: 50, maxHP: 500, maxMP: 500, currentHP: 500, currentMP: 500);
  }
  return;
  jumpToScriptSection(205, 6);
  return;
  garbage { 14 00 fe 00 14 00 51 00 58 00 05 00 a0 00 06 00 e4 00 ff ff 24 00 6e 63 19 00 0b 00 6e 13 18 00 2a 00 19 00 74 2c 3d 00 36 00 24 00 6e 63 19 00 0b 00 6e 04 18 00 40 00 19 00 74 45 27 00 2e 00 24 00 6e 63 19 00 0b 00 6e 0e 18 00 56 00 19 00 74 2c 37 00 3f 00 fe 00 4d fd 00 06 1b ff 1a 00 82 71 82 8f 82 83 82 8b 82 93 82 8c 82 89 82 84 82 85 81 40 82 82 82 8c 82 8f 82 83 82 8b 82 85 82 84 81 40 82 94 82 88 82 85 81 40 82 92 82 8f 82 81 82 84 81 42 81 42 81 42 0d 00 00 00 fe 00 1b 05 1a 00 82 61 82 81 82 94 82 94 82 8c 82 85 81 40 82 94 82 85 82 93 82 94 81 49 0d 00 00 00 1a 00 82 69 82 95 82 93 82 94 81 40 82 8b 82 89 82 84 82 84 82 89 82 8e 82 87 81 42 0d 00 00 00 48 05 fe 00 1b 06 1a 00 82 68 81 75 82 8d 81 40 82 83 82 81 82 8c 82 8c 82 85 82 84 81 40 82 6c 82 92 81 42 81 40 82 67 82 81 82 8e 82 84 82 99 81 49 0d 00 82 76 82 88 82 81 82 94 81 40 82 83 82 81 82 8e 81 40 82 68 81 40 82 84 82 8f 81 40 82 86 82 8f 82 92 81 40 82 99 82 8f 82 95 81 48 0d 00 00 00 1b fd 10 03 ca 01 28 02 9e 04 1a 00 82 62 82 88 82 81 82 8e 82 87 82 85 81 40 82 6f 82 81 82 92 82 81 82 8d 82 85 82 94 82 85 82 92 82 93 0d 00 82 65 82 81 82 93 82 94 81 40 82 86 82 8f 82 92 82 97 82 81 82 92 82 84 81 40 82 94 82 89 82 8d 82 85 0d 00 82 6c 82 81 82 93 82 94 82 85 82 92 81 40 82 81 82 8c 82 8c 81 40 82 73 82 85 82 83 82 88 82 8e 82 89 82 91 82 95 82 85 82 93 0d 00 00 00 12 00 fe 00 1b fd 10 03 e2 02 ba 03 14 05 1a 00 82 68 82 8e 82 83 82 92 82 85 82 81 82 93 82 85 0d 00 82 63 82 85 82 83 82 92 82 85 82 81 82 93 82 85 0d 00 82 71 82 85 82 93 82 85 82 94 81 40 82 81 82 82 82 89 82 8c 82 89 82 94 82 99 81 40 82 8c 82 85 82 96 82 85 82 8c 0d 00 00 00 12 00 fe 00 1b fd 10 03 be 02 ca 02 d6 02 1a 00 82 65 82 81 82 93 82 94 81 40 82 86 82 8f 82 92 82 97 82 81 82 92 82 84 81 40 82 8f 82 8e 82 85 81 40 82 88 82 8f 82 95 82 92 0d 00 82 65 82 81 82 93 82 94 81 40 82 86 82 8f 82 92 82 97 82 81 82 92 82 84 81 40 82 93 82 89 82 98 81 40 82 88 82 8f 82 95 82 92 82 93 0d 00 82 65 82 81 82 93 82 94 81 40 82 86 82 8f 82 92 82 97 82 81 82 92 82 84 81 40 82 8f 82 8e 82 85 81 40 82 84 82 81 82 99 0d 00 00 00 12 00 }
}
