// DG020.SCN
#include "functions.dgs"
#pragma script index=20 start=0x13800 end=0x14000 headerU16=0x1c sentinelOff=0x24
#include "entities.dgs"

section onEnter(254) {
  spawnItemChance(max: 99, chance: 6, item: Item.Digimushroom, x: 52, y: 26);
  spawnItemChance(max: 99, chance: 14, item: Item.Digimushroom, x: 40, y: 61);
  spawnItemChance(max: 99, chance: 1, item: Item.DeluxeMushroom, x: 64, y: 61);
  return;
}

section(5) {
  speak(Entity(5), "「そらせっしょーやで!」<NEWLINE>");
  finishEncounter(Trigger(268));
}

section(6) {
  speak(Entity(6), "「なんか置いてけよ!」<NEWLINE>");
  finishEncounter(Trigger(280));
}

section(7) {
  speak(Entity(7), "「このケンカこうたるわ!」<NEWLINE>");
  finishEncounter(Trigger(268));
}

section(8) {
  speak(Entity(8), "「待ちな!」<NEWLINE>");
  finishEncounter(Trigger(280));
}

