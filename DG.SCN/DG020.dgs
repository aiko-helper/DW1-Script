// DG020.SCN
#include "functions.dgs"
#pragma script index=20 start=0x14800 end=0x15000 headerU16=0x1c sentinelOff=0x24
#include "entities.dgs"

section onEnter(254) {
  roll(pstat: 110, max: 99);
  if (pstat[110] > 15) goto L1;
  spawnItem(Item.Digimushroom, x: 31, y: 57);

L1:
  roll(pstat: 110, max: 99);
  if (pstat[110] > 7) goto L2;
  spawnItem(Item.Digimushroom, x: 91, y: 55);

L2:
  roll(pstat: 110, max: 99);
  if (pstat[110] > 6) goto L3;
  spawnItem(Item.Happymushroom, x: 62, y: 94);

L3:
  return;
}

section(5) {
  playSound(8, 11);
  speak(5, "Are we gonna battle?\nChicken?!\n");
  playAnimation(Entity.Player, 16);
  delay(20);
  setDialogOwner(Entity.Player);
  choice { "Okay, let's fight" -> L1, "Wait a minute" -> L3 }
  goto L3;

L1:
  setTrigger(1);
  startBattle();
  look(entity: Entity.Player, at: 5);
  look(entity: Entity.Partner, at: 5);
  look(entity: 5, at: Entity.Player);
  waitForEntity(Entity.Player);
  speak(5, "Oh no! I lost!\n");
  playAnimation(5, 29);
  delay(40);
  playAnimation(Entity.Player, 20);
  delay(20);
  speak(Entity.Player, "He was pretty tough.\n");
  playAnimation(Entity.Player, 0);
  playAnimation(5, 28);
  delay(20);
  playAnimation(5, 0);
  look(entity: 5, at: Entity.Player);
  playSound(8, 11);
  speak(5, "You're nice. I'm Mamemon.\nI'll go with you.\n");
  playAnimation(Entity.Player, 19);
  delay(20);
  speak(Entity.Player, "Coming with us? Well, why\ndon't you go to the city?\n");
  playSound(8, 11);
  speak(5, "OK. I'll go there.\n");
  goto L2;

L2:
  loop {
    move(entity: 5, to: (3800, -3100), sprint: 1);
    if (pstat[101] >= 10) break;
    addPStat(101, 1);
    delay(10);
    look(entity: Entity.Player, at: 5);
    look(entity: Entity.Partner, at: 5);
  }
  waitForEntity(5);
  unloadEntity(5);
  setPStat(101, 0);
  playSound(8, 8);
  speak(Entity.System, "Mamemon joins the city!\n");
  unsetTrigger(1);
  moveCamera(to: Entity.Player, speed: 10);
  waitForEntity(200);
  addPStat(1, 3);
  setTrigger(213);
  return;

L3:
  speak(5, "Come back when\nyou get tougher.\n");
  goto L4;

L4:
  loop {
    move(entity: 5, to: (3800, -3100), sprint: 1);
    if (pstat[101] >= 10) break;
    addPStat(101, 1);
    delay(10);
    look(entity: Entity.Player, at: 5);
    look(entity: Entity.Partner, at: 5);
  }
  waitForEntity(5);
  unloadEntity(5);
  setPStat(101, 0);
  return;
}

section(6) {
  speak(6, "Daaaa!\n");
  startBattle();
  setTrigger(281);
  return;
}

section(7) {
  speak(7, "Ha, ha, ha.\n");
  startBattle();
  setTrigger(281);
  return;
}

section(8) {
  speak(8, "Ugghh!\n");
  startBattle();
  setTrigger(281);
  return;
}

section(81) {
  rotate(entity: Entity.Player, to: 2048);
  speak(Entity.System, "East: Native Forest\nWest: Gear Savanna\n");
  return;
  garbage { 1c 00 fe 00 1c 00 05 00 60 00 06 00 9a 03 07 00 bc 03 08 00 e8 03 51 00 0a 04 ff ff 24 00 6e 63 19 00 0b 00 6e 0f 18 00 32 00 19 00 74 2c 1f 00 39 00 24 00 6e 63 19 00 0b 00 6e 07 18 00 48 00 19 00 74 2c 5b 00 37 00 24 00 6e 63 19 00 0b 00 6e 06 18 00 5e 00 19 00 74 45 3e 00 5e 00 fe 00 5a 00 08 0b 1b 05 1a 00 82 60 82 92 82 85 81 40 82 97 82 85 81 40 82 87 82 8f 82 8e 82 8e 82 81 81 40 82 82 82 81 82 94 82 94 82 8c 82 85 81 48 0d 00 82 62 82 88 82 89 82 83 82 8b 82 85 82 8e 81 48 81 49 0d 00 00 00 56 00 fd 10 67 00 14 00 1b fd 10 02 02 01 1e 03 1a 00 82 6e 82 8b 82 81 82 99 81 43 81 40 82 8c 82 85 82 94 81 75 82 93 81 40 82 86 82 89 82 87 82 88 82 94 0d 00 82 76 82 81 82 89 82 94 81 40 82 81 81 40 82 8d 82 89 82 8e 82 95 82 94 82 85 0d 00 00 00 12 00 16 00 1e 03 1c 00 01 00 27 00 67 00 01 00 66 00 4c 00 fd 05 4c 00 fc 05 4c 00 05 fd 4a fd 1b 05 1a 00 82 6e 82 88 81 40 82 8e 82 8f 81 49 81 40 82 68 81 40 82 8c 82 8f 82 93 82 94 81 49 0d 00 00 00 56 00 05 1d 67 00 28 00 56 00 fd 14 67 00 14 00 1b fd 1a 00 82 67 82 85 81 40 82 97 82 81 82 93 81 40 82 90 82 92 82 85 82 94 82 94 82 99 81 40 82 94 82 8f 82 95 82 87 82 88 81 42 0d 00 00 00 56 00 fd 00 56 00 05 1c 67 00 14 00 56 00 05 00 4c 00 05 fd 5a 00 08 0b 1b 05 1a 00 82 78 82 8f 82 95 81 75 82 92 82 85 81 40 82 8e 82 89 82 83 82 85 81 42 81 40 82 68 81 75 82 8d 81 40 82 6c 82 81 82 8d 82 85 82 8d 82 8f 82 8e 81 42 0d 00 82 68 81 75 82 8c 82 8c 81 40 82 87 82 8f 81 40 82 97 82 89 82 94 82 88 81 40 82 99 82 8f 82 95 81 42 0d 00 00 00 56 00 fd 13 67 00 14 00 1b fd 1a 00 82 62 82 8f 82 8d 82 89 82 8e 82 87 81 40 82 97 82 89 82 94 82 88 81 40 82 95 82 93 81 48 81 40 82 76 82 85 82 8c 82 8c 81 43 81 40 82 97 82 88 82 99 0d 00 82 84 82 8f 82 8e 81 75 82 94 81 40 82 99 82 8f 82 95 81 40 82 87 82 8f 81 40 82 94 82 8f 81 40 82 94 82 88 82 85 81 40 82 83 82 89 82 94 82 99 81 48 0d 00 00 00 5a 00 08 0b 1b 05 1a 00 82 6e 82 6a 81 42 81 40 82 68 81 75 82 8c 82 8c 81 40 82 87 82 8f 81 40 82 94 82 88 82 85 82 92 82 85 81 42 0d 00 00 00 16 00 a0 02 4e 05 d8 0e e4 f3 01 00 19 00 0d 00 65 0a 18 00 c8 02 19 00 1f 00 65 01 67 00 0a 00 4c 00 fd 05 4c 00 fc 05 16 00 a0 02 4a 05 48 05 1e 00 65 00 5a 00 08 08 1b ff 1a 00 82 6c 82 81 82 8d 82 85 82 8d 82 8f 82 8e 81 40 82 8a 82 8f 82 89 82 8e 82 93 81 40 82 94 82 88 82 85 81 40 82 83 82 89 82 94 82 99 81 49 0d 00 00 00 1d 00 01 00 50 00 fd 0a 4a c8 1f 00 01 03 1c 00 d5 00 fe 00 1b 05 1a 00 82 62 82 8f 82 8d 82 85 81 40 82 82 82 81 82 83 82 8b 81 40 82 97 82 88 82 85 82 8e 0d 00 82 99 82 8f 82 95 81 40 82 87 82 85 82 94 81 40 82 94 82 8f 82 95 82 87 82 88 82 85 82 92 81 42 0d 00 00 00 16 00 68 03 4e 05 d8 0e e4 f3 01 00 19 00 0d 00 65 0a 18 00 90 03 19 00 1f 00 65 01 67 00 0a 00 4c 00 fd 05 4c 00 fc 05 16 00 68 03 4a 05 48 05 1e 00 65 00 fe 00 }
}
