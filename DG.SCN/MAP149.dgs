    return;
}

section section_11(11) {  // len=2456
    playSound(8, 9);
    setDialogOwner(11);
    showTextbox("You can't get thru here.\n");
    storeDate(105);
    if (!trigger(331) || pstat[107] != 11 || pstat[108] < 55) goto L_0056;
    goto L_084a;
L_0056:
    if (!trigger(331) || pstat[107] != 12 || pstat[108] > 5) goto L_006e;
    goto L_084a;
L_006e:
    if (!trigger(331) || pstat[107] != 23 || pstat[108] < 55) goto L_0086;
    goto L_084a;
L_0086:
    if (!trigger(331) || pstat[107] != 0 || pstat[108] > 5) goto L_009e;
    goto L_084a;
L_009e:
    if (!trigger(331)) goto L_01cc;
    setDialogOwner(11);
    showTextbox("......\n");
    setDialogOwner(Entity.Player);
    showTextbox("Wow, he's staring at us!\nMaybe he's suspicious\nabout us.\n");
    showTextbox("We should hide from them\nand wait, then come back.\nIt's twelve o'clock.\n");
    return;
L_01cc:
    if (!trigger(342) || trigger(343)) goto L_0434;
    setDialogOwner(Entity.Player);
    showTextbox("This factory must be\ndraining their waste to\nsewage. I must find out.\n");
    look(entity: Entity.Player, at: Entity.Partner);
    delay(5);
    playAnimation(Entity.Player, 22);
    playAnimation(Entity.Partner, 22);
    delay(5);
    playAnimation(Entity.Player, 22);
    playAnimation(Entity.Partner, 22);
    delay(5);
    look(entity: Entity.Player, at: 11);
    playAnimation(Entity.Partner, 0);
    delay(10);
    playAnimation(Entity.Player, 19);
    delay(15);
    setDialogOwner(Entity.Player);
    showTextbox("Can you move, please?\n");
    playAnimation(Entity.Player, 0);
    playSound(8, 9);
    delay(5);
    setDialogOwner(11);
    showTextbox("You can't go thru here\nwithout a permit issued by\nthe person in charge.\n");
    setDialogOwner(Entity.Player);
    showTextbox("I'm in a hurry.\n");
    setDialogOwner(11);
    showTextbox("Sorry, you gotta have\na permit.\n");
    playAnimation(Entity.Player, 25);
    delay(15);
    setDialogOwner(Entity.Player);
    showTextbox("OK, if that's the way\nit is.\n");
    playAnimation(Entity.Player, 0);
    setTrigger(347);
    return;
L_0434:
    if (trigger(343)) goto L_0442;
    return;
L_0442:
    if (!trigger(343)) goto L_0500;
    setDialogOwner(Entity.Player);
    showTextbox("So, what should we do?\n");
    setDialogOwner(Entity.Player);
    setSelection(L_0500, L_06ac, L_0848);
    showTextbox("Time for shift change\nLet me thru or else\nNo, nothing\n");
    waitForSelectionChoice();
    return;
L_0500:
    playSound(8, 9);
    setDialogOwner(11);
    showTextbox("It's not the time for\nthe shift change yet.\n");
    setDialogOwner(Entity.Player);
    setSelection(L_05ce, L_062c);
    showTextbox("That's OK, don't worry.\nWhen is shift change?\n");
    waitForSelectionChoice();
    return;
L_05ce:
    playSound(8, 9);
    setDialogOwner(11);
    showTextbox("No, we have to follow\nthe time strictly.\n");
    return;
L_062c:
    setDialogOwner(11);
    showTextbox("The shift changes are\nat midnight and noon.\n");
    setDialogOwner(Entity.Player);
    showTextbox("Oh, I see.\n");
    setTrigger(331);
    return;
L_06ac:
    playSound(8, 9);
    setDialogOwner(11);
    showTextbox("You can't threaten me.\nYou have to get a permit.\n");
    setDialogOwner(Entity.Player);
    setSelection(L_0786, L_0786);
    showTextbox("A permit? I got one.\nI'll give you permission!\n");
    waitForSelectionChoice();
    return;
L_0786:
    playSound(8, 9);
    setDialogOwner(11);
    showTextbox("We can't give you a permit.\nYou have to go thru\nproper channels.\n");
    setDialogOwner(Entity.Player);
    showTextbox("Wow, you're so strict!\n");
    return;
L_0848:
    return;
L_084a:
    setDialogOwner(Entity.Player);
    showTextbox("Isn't it shift change yet?\n");
    setDialogOwner(11);
    showTextbox("...\n");
    setDialogOwner(Entity.Player);
    showTextbox("Wow, he's staring at us!\nI guess he won't change\nthe shift.\n");
    showTextbox("Let's come back later.\nMaybe we should hide from\nthem and wait.\n");
    return;
}

