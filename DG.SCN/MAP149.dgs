section(11) {
  {
    if (!trigger(74)) {
      speak(Entity(11), "「あ、こんにちは。お肉いりますか?」<NEWLINE>");
      showTextbox("「いけない、まだ説明してなかったんだ。」<NEWLINE>");
      showTextbox("「えと、ここはお肉の畑、肉畑です。<NEWLINE> ここでみんなが食べる肉を育ててます。」<NEWLINE>");
      speak(Entity.Player, "「!、ちょっと待ってよ、肉が畑で<NEWLINE> とれるのか?」<NEWLINE>");
      speak(Entity(11), "「うん。何かおかしい?」<NEWLINE>");
      speak(Entity.Player, "「いや……ま、いいや。それで?」<NEWLINE>");
      speak(Entity(11), "「じっちゃんとぼくらで相談して、<NEWLINE> <LIGHTBLUE><PLAYER><WHITE>さんに1日3つ、お肉を<NEWLINE> わけてあげることにしたんです。」<NEWLINE>");
      showTextbox("「だから、はい。今日のお肉。」<NEWLINE>");
    } else {
      break;
    }
    giveItem(Item.Meat, 3);
    if (item[Item.Meat] >= 99) {
      speak(Entity(11), "「ん、肉の持ちすぎだね。<NEWLINE> 今日のぶんはパスでいいよね。」<NEWLINE>");
      setPStat(PStat(31), 1);
      return;
    }
    if (item[Item.Meat] >= 97) {
      speak(Entity(11), "「ん、肉の持ちすぎだね。<NEWLINE> 持てないぶんはぼくがもらうね。」<NEWLINE>");
      speak(Entity.System, "<LIGHTBLUE>肉<WHITE>を手に入れた!<NEWLINE>");
      setTrigger(Trigger(74));
      setPStat(PStat(31), 0);
      return;
    }
    if (trigger(0)) {
      speak(Entity(11), "「アイテムのもちすぎだよ。」<NEWLINE>");
      return;
    }
    speak(Entity.System, "<LIGHTBLUE>肉<WHITE>を3つ手に入れた!<NEWLINE>");
    setTrigger(Trigger(74));
    setPStat(PStat(31), 0);
    return;
  }
  roll(pstat: PStat.RollScratch, max: 9);
  {
    if (pstat[31] >= 1 && pstat[110] <= 0) {
      speak(Entity(11), "「今日はいっぱいお肉がとれましたよ!<NEWLINE> だから、5つお肉あげる。」<NEWLINE>");
    } else {
      break;
    }
    if (item[Item.Meat] >= 99) {
      speak(Entity(11), "「ん、肉の持ちすぎだね。<NEWLINE> 今日のぶんはパスでいいよね。」<NEWLINE>");
      return;
    }
    if (item[Item.Meat] >= 95) {
      speak(Entity(11), "「ん、肉の持ちすぎだね。<NEWLINE> 持てないぶんはぼくがもらうね。」<NEWLINE>");
      speak(Entity.System, "<LIGHTBLUE>肉<WHITE>を手に入れた!<NEWLINE>");
      giveItem(Item.Meat, 5);
      setTrigger(Trigger(74));
      setPStat(PStat(31), 0);
      return;
    }
    giveItem(Item.Meat, 5);
    if (trigger(0)) {
      speak(Entity(11), "「ん、ざんねんだけど<NEWLINE> アイテムのもちすぎだよ。」<NEWLINE>");
      return;
    }
    speak(Entity.System, "<LIGHTBLUE>肉<WHITE>を5つ手に入れた!<NEWLINE>");
    speak(Entity(11), "「次のぶんは明日ですー。」<NEWLINE>");
    setPStat(PStat(31), 0);
    return;
  }
  {
    if (pstat[31] >= 1) {
      speak(Entity(11), "「はい。今日のお肉どうぞー。」<NEWLINE>");
    } else {
      break;
    }
    if (item[Item.Meat] >= 99) {
      speak(Entity(11), "「ん、肉の持ちすぎだね。<NEWLINE> 今日のぶんはパスでいいよね。」<NEWLINE>");
      return;
    }
    if (item[Item.Meat] >= 97) {
      speak(Entity(11), "「ん、肉の持ちすぎだね。<NEWLINE> 持てないぶんはぼくがもらうね。」<NEWLINE>");
      speak(Entity.System, "<LIGHTBLUE>肉<WHITE>を3つ手に入れた!<NEWLINE>");
      giveItem(Item.Meat, 3);
      setTrigger(Trigger(74));
      setPStat(PStat(31), 0);
      return;
    }
    giveItem(Item.Meat, 3);
    if (trigger(0)) {
      speak(Entity(11), "「アイテムのもちすぎだよ。」<NEWLINE>");
      return;
    }
    speak(Entity.System, "<LIGHTBLUE>肉<WHITE>を手に入れた!<NEWLINE>");
    speak(Entity(11), "「次のぶんは明日ですー。」<NEWLINE>");
    setPStat(PStat(31), 0);
    return;
  }
  speak(Entity(11), "「ん、今日はもうお肉あげましたよね。」<NEWLINE>");
  showTextbox("「食べ物が無くなった時は…<NEWLINE> 迷わずの森ではけっこう自然の<NEWLINE> キノコがみつかるらしいですよ。」<NEWLINE>");
  return;
}

section(9) {
  speak(Entity(9), "「えへへ、ぼくがこの街の外について、<NEWLINE> せつめーしますぅ。」<NEWLINE>");
  showTextbox("「街のまわりは『迷わずの森』ですぅ。<NEWLINE> あまり強いデジモンはいないですぅ。」<NEWLINE>");
  showTextbox("「西はすぐ近くにトレーニング場が<NEWLINE> ありますぅ。これからよく行くことになると<NEWLINE> 思いますぅ。」<NEWLINE>");
  showTextbox("「川をわたって東は『トロピカジャングル』<NEWLINE> ですぅ。その向こうは知らないですぅ。」<NEWLINE>");
  showTextbox("「西のほうは山と湖があって、行き止まり<NEWLINE> ですぅ。でもその向こうにもなにか別の<NEWLINE> 地形が広がっているらしいですぅ。」<NEWLINE>");
  showTextbox("「ずっと南のほうは海ですぅ。北のほうは<NEWLINE> 高ーーい山がそびえてるですぅ。どっちも<NEWLINE> 行き止まりですぅ。」<NEWLINE>");
  showTextbox("「あとはよくしらないですぅ。でもこの街は<NEWLINE> 島の中心らしいですから、北のほうはまだ<NEWLINE> 知らない広い場所があると思うですぅ。」<NEWLINE>");
  showTextbox("「これから街の外のうわさについては<NEWLINE> 調べておきますから、ときどき<NEWLINE> 話をききに来てほしいですぅ。」<NEWLINE>");
  return;
}

