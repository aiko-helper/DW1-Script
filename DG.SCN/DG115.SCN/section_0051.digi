; source: ./extract/DIGIMON/SCN/DG.SCN
; DG115.SCN, section 51

section_51(51):     ; len=3374
  0000:  if trigger(147) then section_51+0x18
  000c:  setTrigger 147
  0010:  jump section_51+0x1a
  0014:  jump section_51+0x1a
  0018:  endSection
  001a:  entityWalkToWithCamera Player -1606 166 1
  0022:  entityWalkTo Partner -1407 465 1
  002a:  waitForEntity Partner
  002c:  waitForEntity Player
  002e:  lookAt Player 5
  0032:  lookAt 5 Player
  0036:  lookAt Partner 5
  003a:  playSound 8 18
  003e:  speak 5 "Welcome young man.\n"
  006a:  playAnimation Player 20
  006e:  delay 15
  0072:  if !trigger(309) then section_51+0xba
  007e:  speak Player "You're Cherrymon, right?\n"
  00b6:  jump section_51+0xd6
  00ba:  speak Player "Who is it?\n"
  00d6:  playAnimation Player 0
  00da:  speak 5 "What do you want with\nan old man like me?\n"
  0134:  if !trigger(309) then section_51+0x176
  0140:  speak Player "First, clear the fog.\n"
  0172:  jump section_51+0x1de
  0176:  speak Player "I can't see with the fog.\nCan you get rid of it?\n"
  01de:  playSound 8 18
  01e2:  speak 5 "So, that's it. I see.\n"
  0214:  playAnimation Player 19
  0218:  delay 15
  021c:  speak Player "... can't you do it?\n"
  024c:  playAnimation Player 0
  0250:  speak 5 "First, listen to what I\ngot to say. Now... \nwhere should I begin?\n"
  02da:  speak Player "If you know about the\nemergency on the island,\nplease tell me about it.\n"
  0370:  speak 5 "I see, I see.\nThe emergency.\n"
  03b0:  playSound 8 18
  03b4:  speak 5 "This island began to change\neighty years ago after the\nland changes happened.\n"
  0456:  showTextbox "The northeastern parts of\nthe island suddenly\nappeared eighty years ago.\n"
  04ec:  showTextbox "Since then, Digimon\nstarted to move away.\nThe species separated.\n"
  0572:  showTextbox "And each species started\nto speak their own tongue.\n"
  05de:  playSound 8 18
  05e2:  showTextbox "They forgot the language\nthey used in the city...\n"
  064a:  showTextbox "In the end, File City\nlost most of its\npopulation of Digimon.\n"
  06ca:  showTextbox "Then Digimon began to\nlose their memory!\n"
  0720:  showTextbox "The island's history, their\npast, their senses...\ngetting worse day by day.\n"
  07bc:  showTextbox "But I have something\nimportant to tell you, but\nI can't remember it, either.\n"
  085a:  playSound 8 18
  085e:  showTextbox "However, all will come\ntogether in the end. Someone\ncompels it to be so!\n"
  08f4:  showTextbox "In time, the Digimon will\ncome to think of the\nemergency as normal.\n"
  0980:  showTextbox "The only thing that can stop\nthis is you and the power of\nFile City to unify Digimon!\n"
  0a30:  showTextbox "Gather Digimon in the city\nand create a miracle.\nIt will definitely happen.\n"
  0acc:  showTextbox "Well, I got all worked up.\nPhew, I've said it all.\n"
  0b36:  if trigger(148) then section_51+0xb94
  0b42:  setTrigger 148
  0b46:  playSound 8 18
  0b4a:  speak 5 "Now, let's get rid of the fog.\n"
  0b8e:  callSubroutine 37
  0b90:  jump section_51+0xb96
  0b94:  endSection
  0b96:  speak 5 "The reason for the forest fog\nwas to be able to speak\nto you. Oh, one more thing...\n"
  0c44:  playSound 8 18
  0c48:  showTextbox "There are others\nin the forest who know\nabout the past.\n"
  0cbc:  showTextbox "Go deep into the forest\nto find them, if you can.\n"
  0d24:  playAnimation 5 29
  0d28:  delay 60
  0d2c:  endSection
