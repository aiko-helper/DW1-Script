onEnter:     ; len=120
  0000:  storeRandom 110 99
  0004:  if pstat[110] > 18 then onEnter+0x16
  0010:  spawnItem 44 56 34
  0016:  storeRandom 110 99
  001a:  if pstat[110] > 12 then onEnter+0x2c
  0026:  spawnItem 44 56 80
  002c:  storeRandom 110 99
  0030:  if pstat[110] > 3 then onEnter+0x42
  003c:  spawnItem 47 35 64
  0042:  storeRandom 110 99
  0046:  if pstat[110] > 0 then onEnter+0x58
  0052:  spawnItem 61 67 32
  0058:  if !trigger(147) then onEnter+0x76
  0064:  moveEntityTo 5 -2017 1378 3
  006c:  waitForEntity 20
  006e:  setRotation 5 0
  0072:  delay 5
  0076:  endSection
