L_000e:
    setTrigger(163);
    roll(pstat: 110, max: 1);
    if (!trigger(159) || !trigger(162)) goto L_002a;
    goto L_003c;
L_002a:
    if (!trigger(166)) goto L_003a;
    goto L_003c;
L_003a:
    return;
L_003c:
    rotate(entity: Entity.Player, to: 2048);
    rotate(entity: Entity.Partner, to: 2048);
    jumpAndLink(section_10.L_0102);
    playSound(8, 2);
    setObjectVisibility(46, 0);
    setObjectVisibility(47, 0);
    setObjectVisibility(48, 0);
    setPStat(247, 46);
    setPStat(248, 3);
    callSubroutine(21);
    moveObjectTo(0, 46, 1, 0, 0, 300, 200);
    moveObjectTo(1, 47, 1, 0, 0, 300, 204);
    moveObjectTo(2, 48, 1, 0, 0, 300, 208);
