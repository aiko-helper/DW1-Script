section section_67(67) {  // len=242
    if (!trigger(236)) goto L_000e;
    return;
L_000e:
    setTrigger(173);
    roll(pstat: 110, max: 1);
    if (!trigger(169) || !trigger(164)) goto L_002a;
    goto L_002c;
L_002a:
    return;
L_002c:
    rotate(entity: Entity.Player, to: 2048);
    rotate(entity: Entity.Partner, to: 2048);
    jumpAndLink(section_10.L_0102);
    playSound(8, 2);
    playSound(8, 2);
    setObjectVisibility(46, 0);
    setObjectVisibility(47, 0);
    setObjectVisibility(48, 0);
    setPStat(247, 46);
    setPStat(248, 3);
    callSubroutine(21);
    moveObjectTo(0, 46, 1, 0, 0, 445, 0);
    moveObjectTo(1, 47, 1, 0, 0, 445, 4);
    moveObjectTo(2, 48, 1, 0, 0, 445, 8);
    delay(1);
    moveObjectTo(0, 46, 1, 25, 0, 540, 765);
    moveObjectTo(1, 47, 1, 25, 0, 540, 769);
    moveObjectTo(2, 48, 1, 25, 0, 540, 773);
    delay(3);
    playAnimation(Entity.Partner, 40);
    setPStat(200, 50);
    dealMapDamage(200);
    if (pstat[110] != 0) goto L_00d0;
    playAnimation(Entity.Player, 17);
    move(entity: Entity.Player, axis: 2, to: 1000, speed: 10, withCamera: true);
    delay(40);
    jumpAndLink(section_10.L_0168);
    jumpAndLink(section_10);
    moveCamera(to: Entity.Player, speed: 10);
    waitForEntity(200);
    goto L_00ec;
L_00d0:
    playAnimation(Entity.Player, 17);
    move(entity: Entity.Player, axis: 2, to: -1800, speed: 10, withCamera: true);
    delay(40);
    jumpAndLink(section_10.L_0168);
    jumpAndLink(section_10);
    moveCamera(to: Entity.Player, speed: 10);
    waitForEntity(200);
L_00ec:
    jumpAndLink(section_10.L_0042);
    return;
}
