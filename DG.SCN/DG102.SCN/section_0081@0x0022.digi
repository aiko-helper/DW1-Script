  02a4:  showTextbox "Explain\nDon't explain\n"
  02d4:  waitForSelectionChoice
  02d6:  jump section_81@0x22+0x4d0
  02da:  speak 5 "On the twenty second,\nthere's a tournament for\nInsectoid Digimon only.\n"
  036e:  showTextbox "You can register for\nthat one right now.\n"
  03c4:  showTextbox "Unless you're an Insectoid\nDigimon, you can't\nregister for the contest.\n"
  0458:  showTextbox "If you win, you'll receive\ndeluxe gifts. Just register.\n"
  04cc:  jump section_81@0x22+0x4d0
  04d0:  setDialogOwner 5
  04d2:  setSelection section_81@0x22+0x73e section_81@0x22+0x702
  04d8:  showTextbox "Register\nDon't register\n"
  050c:  waitForSelectionChoice
  050e:  endSection
