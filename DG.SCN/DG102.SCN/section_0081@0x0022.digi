  05ac:  speak 5 "The tournament just ended.\nWait another year.\n"
  060e:  speak 5 "You're scheduled to\nregister in  ' - <SELECTED TOURNAMENT>- '.\nDo you want to cancel?\n"
  0698:  setDialogOwner Player
  069a:  setSelection section_81@0x22+0x702 section_81@0x22+0x6de
  06a0:  showTextbox "I won't cancel\nI'll cancel\n"
  06da:  waitForSelectionChoice
