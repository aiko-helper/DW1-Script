section section_82(82) {  // len=1148
    unsetTrigger(37);
    if (pstat[255] != 3) goto L_0014;
    goto L_0132;
L_0014:
    if (pstat[255] != 2) goto L_0024;
    goto L_024c;
L_0024:
    setDialogOwner(5);
    showTextbox("Too bad.\nIt'll have to be next year.\n");
    setDialogOwner(Entity.System);
    showTextbox("I got a <LIGHTBLUE>Giant Meat <WHITE>\nfor participating!\n");
    giveItem(Item.GiantMeat, 1);
    if (!trigger(0)) goto L_0130;
    setDialogOwner(5);
    showTextbox("Too much stuff.\nThrow some away.\n");
    setTrigger(3);
    callSubroutine(0);
    callSubroutine(13);
    giveItem(Item.GiantMeat, 1);
L_0130:
    return;
L_0132:
    if (pstat[3] != 22) goto L_024c;
    addMoney(5000);
    setDialogOwner(Entity.System);
    showTextbox("Championship prize money :\nfive thous bits.\nI got a <LIGHTBLUE>Beetle Pearl <WHITE>\nas a championship prize!\n");
    giveItem(Item.Beetlepearl, 1);
    if (!trigger(0)) goto L_0246;
    setDialogOwner(5);
    showTextbox("Too much stuff!\n");
    setTrigger(3);
    callSubroutine(0);
    callSubroutine(13);
    giveItem(Item.Beetlepearl, 1);
L_0246:
    jumpToScriptSection(204, 51);
L_024c:
    roll(pstat: 110, max: 1);
    if (pstat[3] != 22 || pstat[110] != 0) goto L_036a;
    addMoney(2000);
    setDialogOwner(Entity.System);
    showTextbox("Second place prize money :\ntwo thous bits!\nI got a <LIGHTBLUE>Horn Helmet <WHITE>\nas a second place prize!\n");
    giveItem(Item.HornHelmet, 1);
    setTrigger(346);
    if (!trigger(0)) goto L_0368;
    setDialogOwner(5);
    showTextbox("Too much stuff!\n");
    setTrigger(3);
    callSubroutine(0);
    callSubroutine(13);
    giveItem(Item.HornHelmet, 1);
L_0368:
    return;
L_036a:
    if (pstat[3] != 22 || pstat[110] != 1) goto L_047a;
    addMoney(2000);
    setDialogOwner(Entity.System);
    showTextbox("Second place prize money:\ntwo thous bits!\nI got <LIGHTBLUE>Scissor Jaw <WHITE>\nas a second place prize!\n");
    giveItem(Item.ScissorJaw, 1);
    if (!trigger(0)) goto L_0478;
    setDialogOwner(5);
    showTextbox("Too much stuff!\n");
    setTrigger(3);
    callSubroutine(0);
    callSubroutine(13);
    giveItem(Item.ScissorJaw, 1);
L_0478:
    return;
L_047a:
    return;
}
