// source: extract/DIGIMON/SCN/DG.SCN
// DG102.SCN, section 81

section section_81_at_0022(81, 0x0022) {  // len=1892
    storeDate(105);
    look(entity: Entity.Player, at: 5);
    look(entity: 5, at: Entity.Player);
    delay(5);
    if (trigger(37)) goto L_0022;
    goto L_0026;
    goto L_0026;
L_0022:
    goto L_0510;
L_0026:
    if (pstat[106] != 21 || pstat[107] < 10) goto L_00bc;
    setDialogOwner(5);
    showTextbox("Unfortunately, you're\ntoo late to register.\nWait another year.\n");
    return;
L_00bc:
    if (pstat[106] < 20 || pstat[106] > 21) goto L_00d0;
    goto L_0148;
L_00d0:
    setDialogOwner(5);
    showTextbox("We're between tournaments.\nI don't have anything to do.\n");
    return;
L_0148:
    if (pstat[106] != 21 || pstat[107] < 23) goto L_01ba;
    setDialogOwner(5);
    showTextbox("The tournament just ended.\nWait another year.\n");
L_01ba:
    storeDigimonType(103);
    if (pstat[103] != 19 && pstat[103] != 32 && pstat[103] != 51 && pstat[103] != 60) goto L_01d8;
    goto L_024c;
L_01d8:
    setDialogOwner(5);
    showTextbox("You're not an insectoid.\nYou can't enter the contest.\n");
    return;
L_024c:
    if (trigger(37)) goto L_02da;
    setDialogOwner(5);
    showTextbox("You want to enter the contest?\n");
    setDialogOwner(5);
    setSelection(L_02da, L_04d0);
    showTextbox("Explain\nDon't explain\n");
    waitForSelectionChoice();
    goto L_04d0;
L_02da:
    setDialogOwner(5);
    showTextbox("On the twenty second,\nthere's a tournament for\nInsectoid Digimon only.\n");
    showTextbox("You can register for\nthat one right now.\n");
    showTextbox("Unless you're an Insectoid\nDigimon, you can't\nregister for the contest.\n");
    showTextbox("If you win, you'll receive\ndeluxe gifts. Just register.\n");
    goto L_04d0;
L_04d0:
    setDialogOwner(5);
    setSelection(L_073e, L_0702);
    showTextbox("Register\nDon't register\n");
    waitForSelectionChoice();
    return;
L_0510:
    if (pstat[106] < 20 || pstat[106] > 21) goto L_0524;
    goto L_059c;
L_0524:
    setDialogOwner(5);
    showTextbox("We're between tournaments.\nI don't have anything to do.\n");
    return;
L_059c:
    if (pstat[106] != 21 || pstat[107] < 23) goto L_060e;
    setDialogOwner(5);
    showTextbox("The tournament just ended.\nWait another year.\n");
L_060e:
    setDialogOwner(5);
    showTextbox("You're scheduled to\nregister in  ' - <SELECTED TOURNAMENT>- '.\nDo you want to cancel?\n");
    setDialogOwner(Entity.Player);
    setSelection(L_0702, L_06de);
    showTextbox("I won't cancel\nI'll cancel\n");
    waitForSelectionChoice();
    return;
L_06de:
    unsetTrigger(37);
    setDialogOwner(5);
    showTextbox("I canceled.\n");
    return;
L_0702:
    setDialogOwner(5);
    showTextbox("Sure you want to do that?\n");
    return;
L_073e:
    callSubroutine(33);
    setDialogOwner(5);
    showTextbox("I registered.\n");
    return;
}
