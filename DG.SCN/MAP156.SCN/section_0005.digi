section_5(5):     ; len=788
  0000:  entityWalkToEntity Partner 1 Player
  0004:  waitForEntity Player
  0006:  speak 5 "We are going to remodel.\nThe fee is two thous bits.\n"
  0074:  storeDigimonType 103
  0076:  if pstat[103] == 13 then section_5+0xde
  0082:  speak 5 "The style is different.\nWe can't remodel.\n"
  00dc:  endSection
  00de:  setDialogOwner Player
  00e0:  setSelection section_5+0x10e section_5+0x312
  00e6:  showTextbox "Do it\nNo thanks\n"
  010a:  waitForSelectionChoice
  010c:  endSection
  010e:  if money >= 2000 then section_5+0x15e
  011e:  speak 5 "You don't have enough bits.\n"
  015c:  endSection
  015e:  reduceMoney 2000
  0164:  speak 5 "Wait a minute.\n"
  0188:  storeRandom 110 10
  018c:  if pstat[110] > 0 then section_5+0x21a
  0198:  speak 5 "It didn't work, but...\n"
  01cc:  fadeOutHUD
  01ce:  pstat[254] = 41
  01d2:  callDigimonSubroutine 10
  01d4:  delay 570
  01d8:  speak Player "Wow, it turned into Giromon!\n"
  0218:  endSection
  021a:  if pstat[110] > 5 then section_5+0x2aa
  0226:  speak 5 "It was successful!\n"
  0252:  fadeOutHUD
  0254:  pstat[254] = 27
  0258:  callDigimonSubroutine 10
  025a:  delay 570
  025e:  speak Player "Wow, it turned into\nMetalMamemon!\n"
  02a8:  endSection
  02aa:  speak 5 "It didn't work.\n"
  02d0:  speak Player "That's awful!\n"
  02f2:  speak 5 "I'm sorry...\n"
  0312:  endSection
