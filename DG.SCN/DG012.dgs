// DG012.SCN
#include "functions.dgs"
#pragma script index=12 start=0xd800 end=0xe000 headerU16=0x1c sentinelOff=0x175
#include "entities.dgs"

section onEnter(254) {
  spawnChest(Item.MediumRecovery, 1941, 142, 0, 693);
  spawnItemChance(max: 99, chance: 14, item: Item.Digimushroom, x: 79, y: 34);
  spawnItemChance(max: 99, chance: 17, item: Item.Digimushroom, x: 56, y: 61);
  spawnItemChance(max: 99, chance: 5, item: Item.Digimushroom, x: 87, y: 67);
  spawnItemChance(max: 99, chance: 2, item: Item.OrangeBanana, x: 21, y: 57);
  return;
}

section(5) {
  {
    speak(Entity(5), "「あ~チミ、もしかして街つくってるシト?」<NEWLINE>");
    speak(Entity.Player, "「そうだけど?」<NEWLINE>");
    playSound(8, 6);
    speak(Entity(5), "「ンー、ボキに会えたの運いーネ、チミ。」<NEWLINE>");
    showTextbox("「ボキ、こー見えても完全体ヨ。じゃ~<NEWLINE> ボキとの勝負に勝ったら街手伝うケド?」<NEWLINE>");
    playAnimation(Entity.Player, Animation(16));
    setDialogOwner(Entity.Player);
    setSelection(L1, L2);
    showTextbox("「おーし、受けて立とう。」<NEWLINE>「…急に用事を思い出した。」<NEWLINE>");
    waitForSelectionChoice();
    break;

L1:
    {
      setTrigger(Trigger(1));
      setPStat(PStat(250), 1);
      setPStat(PStat(251), 5);
      setPStat(PStat(252), 255);
      setPStat(PStat(253), 255);
      startBattle();
      unsetTrigger(Trigger(1));
      setPStat(PStat(250), 0);
      look(entity: Entity.Player, at: Entity(5));
      look(entity: Entity(5), at: Entity.Player);
      look(entity: Entity.Partner, at: Entity(5));
      lookPairAt(Entity(5));
      look(entity: Entity(5), at: Entity.Player);
      waitForEntity(Entity.Player);
      speak(Entity(5), "「たまげたネー。ボキの完敗。<NEWLINE> そんじゃ街で会おうネー。」<NEWLINE>");
      break;
    }
    approach(who: Entity(5), x: -2444, y: -3233, tries: 10, wait: 10);
    playSound(8, 3);
    speak(Entity.System, "ピッコロモンが街に参加した!!!<NEWLINE>");
    unsetTrigger(Trigger(1));
    setTrigger(Trigger(255));
    addPStat(PStat(1), 3);
    followEntity(Entity.Player, speed: 10);
    return;

L2:
  }
  {
    speak(Entity(5), "「ンー、いくじなしネー。<NEWLINE> そのうちまた会いましょーネー。」<NEWLINE>");
    break;
  }
  approach(who: Entity(5), x: -2444, y: -3233, tries: 10, wait: 10);
  return;
}

section(6) {
  speak(Entity(6), "「もう、セニョリータ!」<NEWLINE>");
  finishEncounter(Trigger(293));
}

section(7) {
  speak(Entity(7), "「どうしたーい?アミーゴ!」<NEWLINE>");
  finishEncounter(Trigger(293));
}

section(8) {
  speak(Entity(8), "「ウッキー、ウッキー!」<NEWLINE>");
  finishEncounter(Trigger(278));
}

section(9) {
  speak(Entity(9), "「ウホッ!」<NEWLINE>");
  finishEncounter(Trigger(278));
  garbage { 1c 00 fe 00 1c 00 05 00 82 00 06 00 12 03 07 00 40 03 08 00 72 03 09 00 a0 03 ff ff 75 01 95 07 00 00 8e 00 00 00 b5 02 24 00 6e 63 19 00 0b 00 6e 0e 18 00 3e 00 19 00 74 2c 4f 00 22 00 24 00 6e 63 19 00 0b 00 6e 11 18 00 54 00 19 00 74 2c 38 00 3d 00 24 00 6e 63 19 00 0b 00 6e 05 18 00 6a 00 19 00 74 2c 57 00 43 00 24 00 6e 63 19 00 0b 00 6e 02 18 00 80 00 19 00 74 37 15 00 39 00 fe 00 1b 05 1a 00 81 75 82 a0 81 60 83 60 83 7e 81 41 82 e0 82 b5 82 a9 82 b5 82 c4 8a 58 82 c2 82 ad 82 c1 82 c4 82 e9 83 56 83 67 81 48 81 76 0d 00 00 00 1b fd 1a 00 81 75 82 bb 82 a4 82 be 82 af 82 c7 81 48 81 76 0d 00 00 00 5a 00 08 06 1b 05 1a 00 81 75 83 93 81 5b 81 41 83 7b 83 4c 82 c9 89 ef 82 a6 82 bd 82 cc 89 5e 82 a2 81 5b 83 6c 81 41 83 60 83 7e 81 42 81 76 0d 00 00 00 1a 00 81 75 83 7b 83 4c 81 41 82 b1 81 5b 8c a9 82 a6 82 c4 82 e0 8a ae 91 53 91 cc 83 88 81 42 82 b6 82 e1 81 60 0d 00 81 40 83 7b 83 4c 82 c6 82 cc 8f 9f 95 89 82 c9 8f 9f 82 c1 82 bd 82 e7 8a 58 8e e8 93 60 82 a4 83 50 83 68 81 48 81 76 0d 00 00 00 56 00 fd 10 1b fd 10 02 a4 01 98 02 1a 00 81 75 82 a8 81 5b 82 b5 81 41 8e f3 82 af 82 c4 97 a7 82 c6 82 a4 81 42 81 76 0d 00 81 75 81 63 8b 7d 82 c9 97 70 8e 96 82 f0 8e 76 82 a2 8f 6f 82 b5 82 bd 81 42 81 76 0d 00 00 00 12 00 16 00 98 02 1c 00 01 00 1e 00 fa 01 1e 00 fb 05 1e 00 fc ff 1e 00 fd ff 27 00 67 00 01 00 66 00 1d 00 01 00 1e 00 fa 00 4c 00 fd 05 4c 00 05 fd 4c 00 fc 05 4c 00 fd 05 4c 00 fc 05 4c 00 05 fd 4a fd 1b 05 1a 00 81 75 82 bd 82 dc 82 b0 82 bd 83 6c 81 5b 81 42 83 7b 83 4c 82 cc 8a ae 94 73 81 42 0d 00 81 40 82 bb 82 f1 82 b6 82 e1 8a 58 82 c5 89 ef 82 a8 82 a4 83 6c 81 5b 81 42 81 76 0d 00 00 00 16 00 28 02 4e 05 74 f6 5f f3 01 00 19 00 0d 00 65 0a 18 00 50 02 19 00 1f 00 65 01 67 00 0a 00 4c 00 fd 05 4c 00 fc 05 16 00 28 02 4a 05 48 05 1e 00 65 00 5a 00 08 03 1b ff 1a 00 83 73 83 62 83 52 83 8d 83 82 83 93 82 aa 8a 58 82 c9 8e 51 89 c1 82 b5 82 bd 81 49 81 49 81 49 0d 00 00 00 1d 00 01 00 1c 00 ff 00 1f 00 01 03 50 00 fd 0a 4a c8 fe