// DG012.SCN
#pragma script index=12 start=0xe800 end=0xf000 headerU16=0x20 sentinelOff=0x24

section onEnter(254) {  // len=46
    roll(pstat: 110, max: 99);
    if (pstat[110] > 9) goto L1;
    spawnItem(Item.Digimushroom, 55, 43);

L1:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 4) goto L2;
    spawnItem(Item.Digimushroom, 68, 46);

L2:
    return;
}

section(81) {  // len=588
    setDialogOwner(Entity.System);
    showTextbox("MP Vending Machine\n");
    rotate(entity: Entity.Player, to: 2048);
    setDialogOwner(Entity.Player);
    showTextbox("This machine recovers MP.\n");
    setSelection(L1, L4, L7);
    showTextbox("Hund MP: two hund bits\nThous MP:eighteen hund bits\nDon't use\n");
    waitForSelectionChoice();
    goto L7;

L1:
    if (money < 200) goto L2;
    addStats(Stat.CurrentMP, 100);
    reduceMoney(200);
    setDialogOwner(Entity.System);
    showTextbox("My MP level went back up!\n");
    goto L3;

L2:
    setDialogOwner(Entity.Player);
    showTextbox("I don't have enough bits.\n");
    return;

L3:
    return;

L4:
    if (money < 1800) goto L5;
    addStats(Stat.CurrentMP, 1000);
    reduceMoney(1800);
    setDialogOwner(Entity.System);
    showTextbox("My MP level went back up!\n");
    goto L6;

L5:
    setDialogOwner(Entity.Player);
    showTextbox("I don't have enough bits.\n");
    return;

L6:
    return;

L7:
    setDialogOwner(Entity.Player);
    showTextbox("Forget about it.\n");
    return;
}

section(53) {  // len=54
    if (!trigger(185)) goto L1;
    return;

L1:
    setDialogOwner(Entity.Player);
    showTextbox("Oh, a bridge!\n");
    setTrigger(185);
    return;
}

section(5) {  // len=60
    setDialogOwner(5);
    showTextbox("You gonna fight me?\n");
    fadeOutHUD();
    delay(1);
    startBattle();
    setTrigger(286);
    return;
}

section(6) {  // len=76
    setDialogOwner(6);
    showTextbox("You're quite a smart aleck!\n");
    fadeOutHUD();
    delay(1);
    startBattle();
    setTrigger(286);
    return;
}

section(7) {  // len=68
    setDialogOwner(7);
    showTextbox("Wha..Whatcha gonna do?!\n");
    fadeOutHUD();
    delay(1);
    startBattle();
    setTrigger(296);
    return;
}

section(8) {  // len=1124
    setDialogOwner(8);
    showTextbox("I'm gonna tell on you!\n");
    fadeOutHUD();
    delay(1);
    startBattle();
    setTrigger(296);
    return;
