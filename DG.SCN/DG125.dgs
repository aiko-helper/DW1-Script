// DG125.SCN
#include "functions.dgs"
#pragma script index=125 start=0x51800 end=0x52800 headerU16=0x10 sentinelOff=0xfe
#include "entities.dgs"

section onEnter(254) {
  return;
}

section(51) {
  removeCondition(Condition.Injured);
  removeCondition(Condition.Sick);
  look(entity: Entity(5), at: Entity.Player);
  look(entity: Entity.Partner, at: Entity.Player);
  anim(Entity.Player, Animation(24), wait: 15);
  speak(Entity.Player, "「な…何だここ…夢か…?」<NEWLINE>");
  playAnimation(Entity.Player, Animation(0));
  rotate(entity: Entity.Player, to: 1050);
  delay(20);
  rotate(entity: Entity.Player, to: 1561);
  delay(20);
  look(entity: Entity.Player, at: Entity(5));
  anim(Entity.Player, Animation(15), wait: 15);
  speak(Entity.Player, "「わっ!誰だぁ!<ORANGE><DIGIMON><WHITE>は?!<NEWLINE> ど、ど、どこだぁ?」<NEWLINE>");
  playAnimation(Entity.Player, Animation(0));
  rotate(entity: Entity.Player, to: 1050);
  delay(5);
  look(entity: Entity.Player, at: Entity(5));
  speak(Entity(5), "「はいはい、落ち着いてねー。<NEWLINE> ぼくは氷雪デジモンのユキダルモン。」<NEWLINE> ここはぼくの家。」<NEWLINE>");
  showTextbox("「君らは雪の中気を失ってた。それを<NEWLINE> ぼくがひろってきてかいほうした。<NEWLINE> わかった?」<NEWLINE>");
  rotate(entity: Entity.Player, to: 25);
  delay(5);
  look(entity: Entity.Player, at: Entity.Partner);
  speak(Entity.Player, "「あ、<ORANGE><DIGIMON><WHITE>、無事だ!よかったー。」<NEWLINE>");
  speak(Entity(5), "「コラ!聞いてんのか!?ぼくがかいほう<NEWLINE> しなきゃ無事じゃなかったんだよ!」<NEWLINE>");
  look(entity: Entity.Player, at: Entity(5));
  anim(Entity.Player, Animation(25), wait: 15);
  speak(Entity.Player, "「えへへ、悪い悪い。サンキューな。」<NEWLINE>");
  anim(Entity.Player, Animation(0), wait: 30);
  look(entity: Entity.Player, at: Entity.Partner);
  anim(Entity.Player, Animation(7), wait: 15);
  speak(Entity.Player, "「おいこら、<ORANGE><DIGIMON><WHITE>、<NEWLINE> おまえがいきなりぶっ倒れるから<NEWLINE> 俺も頭打っちゃったじゃないか!」<NEWLINE>");
  playAnimation(Entity.Player, Animation(0));
  storeDigimonType(PStat(103));
  speak(Entity(5), "「きみ、<DIGIMONTYPE2>は寒さには弱い<NEWLINE> ってこと知らないの?無茶なことして、<NEWLINE> きみこそ反省しなさい。」<NEWLINE>");
  look(entity: Entity.Player, at: Entity(5));
  delay(20);
  look(entity: Entity.Player, at: Entity.Partner);
  anim(Entity.Player, Animation(19), wait: 15);
  speak(Entity.Player, "「そうだったのか…ごめん<ORANGE><DIGIMON><WHITE>。」<NEWLINE>");
  playAnimation(Entity.Player, Animation(0));
  look(entity: Entity.Player, at: Entity(5));
  speak(Entity.Player, "「…色々ありがとーな、ユキダルモン。<NEWLINE> で、すまないついでにちょっと<NEWLINE> お願いがあるんだけど…」<NEWLINE>");
  speak(Entity(5), "「あ~もう。また<DIGIMONTYPE2>が<NEWLINE> ぶっ倒れたらどうするの?早く帰った<NEWLINE> ほうがいいよ!」<NEWLINE>");
  speak(Entity.Player, "「わ…わかった。<ORANGE><DIGIMON><WHITE>は別の<NEWLINE> デジモンに進化させてくるよ。」<NEWLINE>");
  move(entity: Entity.Player, to: (93, -1700), sprint: 1);
  delay(20);
  move(entity: Entity.Partner, to: (93, -1700), sprint: 1);
  delay(20);
  look(entity: Entity(5), at: Entity.Player);
  waitForPair();
  speak(Entity(5), "「???進化…?」<NEWLINE>");
  setTrigger(Trigger(133));
  warp(to: Map.FRZL07, spawn: 2, trigger: 255);
  return;
}

section(5) {
  storeDigimonType(PStat(103));
  {
    if (pstat[103] == 3 || pstat[103] == 5 || pstat[103] == 8 || pstat[103] == 9 || pstat[103] == 47) {
      break;
    }
    if (pstat[103] == 19 || pstat[103] == 32 || pstat[103] == 51 || pstat[103] == 1 || pstat[103] == 2) {
      break;
    }
    if (pstat[103] == 15 || pstat[103] == 16 || pstat[103] == 29 || pstat[103] == 30 || pstat[103] == 43) {
      break;
    }
    if (pstat[103] == 44 || pstat[103] == 21) {
      break;
    }
    {
      speak(Entity.Player, "「やー、こんちわ。また来たよ。」<NEWLINE>");
      speak(Entity(5), "「きみは…。前のデジモンはどーしたの?」<NEWLINE>");
      speak(Entity.Player, "「何言ってんの?同じ同じ。」<NEWLINE>");
      look(entity: Entity(5), at: Entity.Partner);
      speak(Entity(5), "「ん?そ…そう?だっけ…?」<NEWLINE>");
      look(entity: Entity(5), at: Entity.Player);
      speak(Entity.Player, "「あらためてたのみがあって来たんだ。<NEWLINE> 簡単に言うと、街に来て欲しい。」<NEWLINE>");
      speak(Entity(5), "「ほえ?なんかいいことある?面白い?」<NEWLINE>");
      anim(Entity.Player, Animation(19), wait: 15);
      speak(Entity.Player, "「えーと…何か好きなお店を作っていいよ。」<NEWLINE>");
      playAnimation(Entity.Player, Animation(0));
      anim(Entity(5), Animation(11), wait: 5);
      speak(Entity(5), "「えーっ!お店?ぼくあこがれてたんだよ。<NEWLINE> いいないいな、行く、行くよ~。」<NEWLINE>");
      speak(Entity.Player, "「おーそっかそっか。じゃあすぐにでも。」<NEWLINE>");
      speak(Entity(5), "「お店お店~♪かき氷♪アイスクリーム♪<NEWLINE> 楽しみだなぁ~。」<NEWLINE>");
      move(entity: Entity(5), to: (-540, -336), sprint: 1);
      waitForEntity(Entity(5));
      break;
    }
    approach(who: Entity(5), x: 93, y: -1700, tries: 3, wait: 20);
    playSound(8, 11);
    speak(Entity.System, "ユキダルモンが街に参加した!!!<NEWLINE>");
    setTrigger(Trigger(223));
    addPStat(PStat(1), 2);
    return;
  }
  speak(Entity(5), "「あ、こらぁ!そのデジモンは寒さに弱いん<NEWLINE> だってば!」<NEWLINE>");
  anim(Entity.Player, Animation(15), wait: 15);
  speak(Entity.Player, "「うわ、また来まーす!」<NEWLINE>");
  playAnimation(Entity.Player, Animation(0));
  return;
