// DG028.SCN
#include "functions.dgs"
#pragma script index=28 start=0x19800 end=0x1a000 headerU16=0xc sentinelOff=0x19
#include "entities.dgs"

section onEnter(254) {
  if (!trigger(140)) {
    playAnimation(Entity(5), Animation(28));
  }
  return;
}

section(5) {
  if (trigger(234)) {
    speak(Entity(5), "I fixed the entrance sign.\n");
    return;
  }
  {
    if (!trigger(140)) {
    } else {
      break;
    }
    {
      playAnimation(Entity(5), Animation(28));
      playSound(8, 10);
      speak(Entity(5), "It's hot! Do something!\n");
      playAnimation(Entity(5), Animation(28));
      anim(Entity.Player, Animation(16), wait: 20);
      speak(Entity.Player, "What's going on?\n");
      playSound(8, 10);
      speak(Entity(5), "It's too hot!\nI can't take it anymore!\n");
      setTrigger(Trigger(1));
      setPStat(PStat(250), 1);
      setPStat(PStat(251), 5);
      setPStat(PStat(252), 255);
      setPStat(PStat(253), 255);
      startBattle();
      unsetTrigger(Trigger(1));
      setPStat(PStat(250), 0);
      look(entity: Entity.Player, at: Entity(5));
      look(entity: Entity(5), at: Entity.Player);
      look(entity: Entity.Partner, at: Entity(5));
      speak(Entity(5), "I got weird\nbecause of the heat.\n");
      anim(Entity.Player, Animation(25), wait: 20);
      speak(Entity.Player, "I know it's hot, but...\nbe cool man!\n");
      speak(Entity(5), "The more we dig, the hotter\nit gets. The tunnel\nis in a volcano.\n");
      speak(Entity(5), "I don't think it's the only\nreason. Maybe there's\na fire nearby.\n");
      anim(Entity.Player, Animation(16), wait: 20);
      speak(Entity.Player, "Hmmm\n");
      speak(Entity(5), "I don't got a choice.\nI must bear this heat\nand keep on digging.\n");
      anim(Entity.Player, Animation(19), wait: 20);
      speak(Entity.Player, "We'll check out the cause.\nIt'd be great if\nthe tunnel goes thru.\n");
      speak(Entity(5), "You are a nice guy.\nI'll hurry and\ndig this tunnel!\n");
      delay(10);
      playAnimation(Entity.Player, Animation(0));
      break;
    }
    loop {
      move(entity: Entity(5), to: (1061, -767), sprint: 0);
      if (pstat[101] >= 3) break;
      addPStat(PStat.LoopIterator, 1);
      delay(20);
      lookPairAt(Entity(5));
    }
    setPStat(PStat.LoopIterator, 0);
    waitForEntity(Entity(5));
    followEntity(Entity.Player, speed: 10);
    setTrigger(Trigger(140));
    return;
  }
  speak(Entity(5), "Today, I'm in charge\nof cooking.\n");
  return;
  garbage { 0c 00 fe 00 0c 00 05 00 1e 00 ff ff 19 00 01 00 8c 00 18 00 1c 00 19 00 56 00 05 1c fe 00 19 00 00 00 ea 00 18 00 68 00 19 00 1b 05 1a 00 82 68 81 40 82 86 82 89 82 98 82 85 82 84 81 40 82 94 82 88 82 85 81 40 82 85 82 8e 82 94 82 92 82 81 82 8e 82 83 82 85 81 40 82 93 82 89 82 87 82 8e 81 42 0d 00 00 00 fe 00 19 00 01 00 8c 00 18 00 78 00 19 00 16 00 7c 00 16 00 0c 05 56 00 05 1c 5a 00 08 0a 1b 05 1a 00 82 68 82 94 81 75 82 93 81 40 82 88 82 8f 82 94 81 49 81 40 82 63 82 8f 81 40 82 93 82 8f 82 8d 82 85 82 94 82 88 82 89 82 8e 82 87 81 49 0d 00 00 00 56 00 05 1c 56 00 fd 10 67 00 14 00 1b fd 1a 00 82 76 82 88 82 81 82 94 81 75 82 93 81 40 82 87 82 8f 82 89 82 8e 82 87 81 40 82 8f 82 8e 81 48 0d 00 00 00 5a 00 08 0a 1b 05 1a 00 82 68 82 94 81 75 82 93 81 40 82 94 82 8f 82 8f 81 40 82 88 82 8f 82 94 81 49 0d 00 82 68 81 40 82 83 82 81 82 8e 81 75 82 94 81 40 82 94 82 81 82 8b 82 85 81 40 82 89 82 94 81 40 82 81 82 8e 82 99 82 8d 82 8f 82 92 82 85 81 49 0d 00 00 00 1c 00 01 00 1e 00 fa 01 1e 00 fb 05 1e 00 fc ff 1e 00 fd ff 27 00 67 00 01 00 66 00 1d 00 01 00 1e 00 fa 00 4c 00 fd 05 4c 00 05 fd 4c 00 fc 05 1b 05 1a 00 82 68 81 40 82 87 82 8f 82 94 81 40 82 97 82 85 82 89 82 92 82 84 0d 00 82 82 82 85 82 83 82 81 82 95 82 93 82 85 81 40 82 8f 82 86 81 40 82 94 82 88 82 85 81 40 82 88 82 85 82 81 82 94 81 42 0d 00 00 00 56 00 fd 19 67 00 14 00 1b fd 1a 00 82 68 81 40 82 8b 82 8e 82 8f 82 97 81 40 82 89 82 94 81 75 82 93 81 40 82 88 82 8f 82 94 81 43 81 40 82 82 82 95 82 94 81 42 81 42 81 42 0d 00 82 82 82 85 81 40 82 83 82 8f 82 8f 82 8c 81 40 82 8d 82 81 82 8e 81 49 0d 00 00 00 1b 05 1a 00 82 73 82 88 82 85 81 40 82 8d 82 8f 82 92 82 85 81 40 82 97 82 85 81 40 82 84 82 89 82 87 81 43 81 40 82 94 82 88 82 85 81 40 82 88 82 8f 82 94 82 94 82 85 82 92 0d 00 82 89 82 94 81 40 82 87 82 85 82 94 82 93 81 42 81 40 82 73 82 88 82 85 81 40 82 94 82 95 82 8e 82 8e 82 85 82 8c 0d 00 82 89 82 93 81 40 82 89 82 8e 81 40 82 81 81 40 82 96 82 8f 82 8c 82 83 82 81 82 8e 82