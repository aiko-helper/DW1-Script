// DG044.SCN
#include "functions.dgs"
#pragma script index=44 start=0x22800 end=0x23000 headerU16=0x20 sentinelOff=0x24
#include "entities.dgs"

section onEnter(254) {
  spawnItemChance(110, max: 99, chance: 9, item: Item.Digimushroom, x: 29, y: 31);
  spawnItemChance(110, max: 99, chance: 14, item: Item.Digimushroom, x: 27, y: 93);
  spawnItemChance(110, max: 99, chance: 4, item: Item.Pricklypear, x: 35, y: 67);
  return;
}

section(5) {
  speak(5, "I'll beat you up!\n");
  finishEncounter(268);
}

section(6) {
  speak(6, "Take it easy on me.\n");
  finishEncounter(299);
}

section(7) {
  speak(7, "I won't let\nmy catch get away!\n");
  finishEncounter(305);
}

section(8) {
  speak(8, "Phew, it's over.\n");
  finishEncounter(305);
}

section(51) {
  if (!trigger(103)) {
    return;
  }
  move(entity: Entity.Player, to: (10000, -2800), sprint: 0);
  warp(to: Map.GCAN01, spawn: 1, trigger: 255);
}

section(52) {
