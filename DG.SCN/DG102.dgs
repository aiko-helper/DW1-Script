    if (trigger(37)) goto L_02da;
    setDialogOwner(5);
    showTextbox("You want to enter the contest?\n");
    setDialogOwner(5);
    setSelection(L_02da, L_04d0);
    showTextbox("Explain\nDon't explain\n");
    waitForSelectionChoice();
    goto L_04d0;
L_02da:
    setDialogOwner(5);
    showTextbox("On the twenty second,\nthere's a tournament for\nInsectoid Digimon only.\n");
    showTextbox("You can register for\nthat one right now.\n");
    showTextbox("Unless you're an Insectoid\nDigimon, you can't\nregister for the contest.\n");
    showTextbox("If you win, you'll receive\ndeluxe gifts. Just register.\n");
    goto L_04d0;
L_04d0:
    setDialogOwner(5);
    setSelection(L_073e, L_0702);
    showTextbox("Register\nDon't register\n");
    waitForSelectionChoice();
    return;
L_0510:
