// DG085.SCN
#include "functions.dgs"
#pragma script index=85 start=0x39000 end=0x39800 headerU16=0x10 sentinelOff=0xfe
#include "entities.dgs"

section onEnter(254) {
  return;
}

section(51) {
  if (pstat[16] == 1) {
    move(entity: Entity.Player, to: (170, -956), sprint: 0);
    warp(to: Map.MGEN11, spawn: 0, trigger: 60);
  }
  storeDigimonType(PStat(103));
  storeDigimonTypus(103, PStat(109));
  if (pstat[109] == 2) {
    return;
  } else {
    speak(Entity.System, "謎の白い力にさえぎられた!<NEWLINE>");
    fadeOutHUD();
    move(entity: Entity.Player, to: (45, -850), sprint: 1, withCamera: true);
    move(entity: Entity.Partner, to: (349, -753), sprint: 1);
    waitForPair();
    delay(10);
    rotate(entity: Entity.Player, to: 2949);
    delay(10);
    rotate(entity: Entity.Player, to: 1925);
    speak(Entity.Player, "「な、何だ?足が勝手に…」<NEWLINE>");
  }
  return;
}

section(52) {
  {
    if ((cond & 0x40) == 0x01 && !trigger(133)) break;
    return;
  }
  storeDigimonType(PStat(103));
  if (pstat[103] == 3 || pstat[103] == 5 || pstat[103] == 8 || pstat[103] == 9 || pstat[103] == 47) {
    jumpToScriptSection(174, 51);
  }
  if (pstat[103] == 19 || pstat[103] == 32 || pstat[103] == 51 || pstat[103] == 1 || pstat[103] == 2) {
    jumpToScriptSection(174, 51);
  }
  if (pstat[103] == 15 || pstat[103] == 16 || pstat[103] == 29 || pstat[103] == 30 || pstat[103] == 43) {
    jumpToScriptSection(174, 51);
  }
  if (pstat[103] == 44 || pstat[103] == 21) {
    jumpToScriptSection(174, 51);
  }
  return;
