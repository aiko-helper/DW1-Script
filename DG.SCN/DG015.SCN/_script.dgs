// DG015.SCN
#pragma script index=15 start=0x10000 end=0x11000 headerU16=0x1c sentinelOff=0x24
#pragma sections section_0254 section_0005 section_0007 section_0008 section_0009 section_0051

section onEnter(254) {  // len=78
    roll(pstat: 110, max: 99);
    if (pstat[110] > 14) goto L_0016;
    spawnItem(Item.Digimushroom, 48, 80);
L_0016:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 6) goto L_002c;
    spawnItem(Item.Happymushroom, 40, 60);
L_002c:
    if (!trigger(86) || trigger(225)) goto L_004c;
    setObjectVisibility(0, 0);
    setObjectVisibility(1, 0);
    setObjectVisibility(2, 0);
    setObjectVisibility(3, 0);
L_004c:
    return;
}
