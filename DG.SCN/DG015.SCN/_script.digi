; DG015.SCN
;!script index=15 start=0x10000 end=0x11000 headerU16=0x1c sentinelOff=0x24
;!sections onEnter section_5 section_7 section_8 section_9 section_51

onEnter:     ; len=78
  0000:  storeRandom 110 99
  0004:  if pstat[110] > 14 then onEnter+0x16
  0010:  spawnItem Digimushroom 48 80
  0016:  storeRandom 110 99
  001a:  if pstat[110] > 6 then onEnter+0x2c
  0026:  spawnItem Happymushroom 40 60
  002c:  if !trigger(86) OR trigger(225) then onEnter+0x4c
  003c:  setObjectVisibility 0 0
  0040:  setObjectVisibility 1 0
  0044:  setObjectVisibility 2 0
  0048:  setObjectVisibility 3 0
  004c:  endSection
