// DG016.SCN
#include "functions.dgs"
#pragma script index=16 start=0x10000 end=0x10800 headerU16=0x24 sentinelOff=0xfe
#include "entities.dgs"

section onEnter(254) {
  return;
}

section(5) {
  speak(Entity(5), "「シャー、シャー!」<NEWLINE>");
  finishEncounter(Trigger(267));
}

section(6) {
  speak(Entity(6), "「ブーンブーン!」<NEWLINE>");
  finishEncounter(Trigger(267));
}

section(7) {
  speak(Entity(7), "「ははは!キミ、だいじょうぶ?」<NEWLINE>");
  finishEncounter(Trigger(293));
}

section(8) {
  speak(Entity(8), "「ウゴ?」<NEWLINE>");
  finishEncounter(Trigger(278));
}

section(9) {
  speak(Entity(9), "「ホゥ!ホッホホッホ!」<NEWLINE>");
  finishEncounter(Trigger(278));
}

section(10) {
  speak(Entity(10), "「ジャングルモジャ~。」<NEWLINE>");
  finishEncounter(Trigger(278));
}

section(81) {
  rotate(entity: Entity.Player, to: 2048);
  if (!trigger(236)) {
    speak(Entity.System, "  <RED>警告<WHITE>・無謀なるものには砲撃の準備あり<NEWLINE> <NEWLINE>       ケンタルモン<NEWLINE>");
  } else {
    speak(Entity.System, " 引っこしました。新住所・はじまりの街<NEWLINE> <NEWLINE>       ケンタルモン<NEWLINE>");
  }
  return;
