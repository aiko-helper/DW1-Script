// DG016.SCN
#pragma script index=16 start=0x11000 end=0x11800 headerU16=0x18 sentinelOff=0x24

section onEnter(254) {  // len=46
    roll(pstat: 110, max: 99);
    if (pstat[110] > 9) goto L1;
    spawnItem(Item.Digimushroom, 23, 31);

L1:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 3) goto L2;
    spawnItem(Item.Happymushroom, 67, 47);

L2:
    return;
}

section(5) {  // len=890
    setDialogOwner(5);
    showTextbox("Gruun.\n");
    showTextbox("Gruun.ru.ru..\n");
    playAnimation(Entity.Player, 16);
    showTextbox("Something came back to life!\n");
    playSound(8, 0);
    look(entity: Entity.Player, at: Entity.Partner);
    look(entity: Entity.Partner, at: Entity.Player);
    delay(20);
    setDialogOwner(Entity.Player);
    showTextbox(" ? \n");
    setDialogOwner(5);
    showTextbox("I used to live in the city.\nYou smell like the city.\n");
    look(entity: Entity.Player, at: 5);
    look(entity: Entity.Partner, at: 5);
    waitForEntity(Entity.Player);
    setDialogOwner(Entity.Player);
    showTextbox("Wow!\n");
    setDialogOwner(5);
    showTextbox("It's scary. I left the city\nand lost my memory.\n");
    showTextbox("But thanks to you,\nI remember everything now.\n");
    showTextbox("I'm going back to the city,\nOK?\n");
    playAnimation(Entity.Player, 19);
    setDialogOwner(Entity.Player);
    showTextbox("Of course. I'm sure\nthe city is now more lively\nthan before.\n");
    playSound(8, 4);
    setDialogOwner(5);
    showTextbox("Really? Alright!\nI'll try my best!\n");
    goto L1;

L1:
    move(entity: 5, to: (421, -1390), sprint: 1);
    if (pstat[101] >= 10) goto L2;
    addPStat(101, 1);
    delay(10);
    look(entity: Entity.Player, at: 5);
    look(entity: Entity.Partner, at: 5);
    goto L1;

L2:
    waitForEntity(5);
    unloadEntity(5);
    setPStat(101, 0);
    playSound(8, 3);
    setDialogOwner(Entity.System);
    showTextbox("Betamon joins the city!\n");
    setTrigger(204);
    addPStat(1, 1);
    moveCamera(to: Entity.Player, speed: 10);
    waitForEntity(200);
    return;
}

section(6) {  // len=64
    setDialogOwner(6);
    showTextbox("This is my territory!\n");
    fadeOutHUD();
    delay(1);
    startBattle();
    setTrigger(283);
    return;
}

section(7) {  // len=58
    setDialogOwner(7);
    showTextbox("He he he. Alright!\n");
    fadeOutHUD();
    delay(1);
    startBattle();
    setTrigger(278);
    return;
}

section(8) {  // len=966
    setDialogOwner(8);
    showTextbox("Just watch!\n");
    fadeOutHUD();
    delay(1);
    startBattle();
    setTrigger(296);
    return;
