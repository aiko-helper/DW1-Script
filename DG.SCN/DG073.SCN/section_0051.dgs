// source: extract/DIGIMON/SCN/DG.SCN
// DG073.SCN, section 51

section section_51(51) {  // len=902
    if (!trigger(196) && !trigger(338)) goto L_0012;
    return;
L_0012:
    rotate(entity: Entity.Player, to: 2048);
    rotate(entity: Entity.Partner, to: 2048);
    delay(5);
    setTrigger(196);
    setDigimon(Digimon.NPCPatamon, 0, 0);
    setDigimon(Digimon.NPCGobiromon, 1, 0);
    moveCamera(to: (-205, 1478), slowdown: 15);
    waitForEntity(200);
    move(entity: 5, to: (-254, 439), sprint: 1);
    move(entity: 6, to: (-254, 1039), sprint: 1);
    delay(45);
    rotate(entity: 5, to: 0);
    rotate(entity: 6, to: 0);
    moveCamera(to: 5, speed: 25);
    waitForEntity(200);
    setDialogOwner(Entity.Player);
    showTextbox("What is it?\n");
    waitForEntity(5);
    look(entity: 5, at: Entity.Player);
    delay(5);
    setDialogOwner(5);
    showTextbox("HELP ME!\n");
    playAnimation(Entity.Player, 7);
    delay(15);
    setDialogOwner(Entity.Player);
    showTextbox("He's in trouble,\nI gotta help him!\n");
    playAnimation(Entity.Player, 0);
    move(entity: Entity.Player, to: (-150, -550), sprint: 1);
    move(entity: Entity.Partner, to: (-80, -300), sprint: 1);
    setDialogOwner(Entity.System);
    showTextbox("<YELLOW>??? <WHITE>\nPick on someone\nyour own size!\n");
    setPStat(245, 3);
    setBGM(11);
    setDigimon(Digimon.NPCLeomon, 2, 0);
    moveCamera(to: (-677, 509), slowdown: 20);
    waitForEntity(200);
    look(entity: 7, at: 6);
    look(entity: Entity.Player, at: 7);
    delay(10);
    setDialogOwner(Entity.Player);
    showTextbox("Who is that?\n");
    look(entity: 5, at: 7);
    look(entity: 6, at: 7);
    delay(10);
    look(entity: 7, at: 6);
    move(entity: 6, to: (-254, 1039), sprint: 1);
    delay(5);
    move(entity: 7, axis: 1, to: 0, speed: 1);
    delay(2);
    playAnimation(7, 28);
    delay(20);
    playAnimation(7, 0);
    playSound(8, 1);
    look(entity: Entity.Player, at: 7);
    look(entity: 5, at: 7);
    look(entity: 6, at: 7);
    waitForEntity(Entity.Player);
    waitForEntity(5);
    waitForEntity(6);
    playAnimation(6, 40);
    delay(20);
    move(entity: 6, to: (0, 4000), sprint: 1);
    waitForEntity(6);
    unloadEntity(6);
    look(entity: 5, at: 7);
    delay(5);
    look(entity: 7, at: 5);
    delay(5);
    setDialogOwner(7);
    showTextbox("Are you alright?\n");
    setDialogOwner(5);
    showTextbox("Thank you.\n");
    setDialogOwner(7);
    showTextbox("Call me anytime you're\nin trouble. I will\ncome right away!\n");
    showTextbox("See you again!\n");
    move(entity: 7, to: (-2323, 1264), sprint: 1);
    delay(20);
    setDialogOwner(5);
    showTextbox("Hey, wait up!\n");
    move(entity: 5, to: (-2323, 1264), sprint: 1);
    delay(40);
    waitForEntity(5);
    waitForEntity(7);
    unloadEntity(7);
    unloadEntity(5);
    moveCamera(to: Entity.Player, speed: 10);
    waitForEntity(200);
    setDialogOwner(Entity.Player);
    showTextbox("He's like a hero.\nHe gets all the credit.\n");
    playAnimation(Entity.Player, 0);
    setTrigger(196);
    return;
}
