; DG084.SCN
;!script index=84 start=0x3c800 end=0x3d000 headerU16=0x24 sentinelOff=0x24
;!sections onEnter section_5 section_6 section_7 section_8 section_81 section_53 section_51

onEnter:     ; len=68
  0000:  storeRandom 110 99
  0004:  if pstat[110] > 17 then onEnter+0x16
  0010:  spawnItem 44 43 35
  0016:  storeRandom 110 99
  001a:  if pstat[110] > 10 then onEnter+0x2c
  0026:  spawnItem 44 38 67
  002c:  storeRandom 110 99
  0030:  if pstat[110] > 7 then onEnter+0x42
  003c:  spawnItem 44 50 81
  0042:  endSection
