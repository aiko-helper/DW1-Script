// DG216.SCN
#include "functions.dgs"
#pragma script index=216 start=0xbb000 end=0xbc000 headerU16=0x10 sentinelOff=0xfe
#include "entities.dgs"

section onEnter(254) {
  return;
}

section(51) {
  if (!trigger(53)) {
    setTrigger(Trigger(53));
    speak(Entity(5), "Hello, <LIGHTBLUE><PLAYER><WHITE>.\nSurprise! I opened\na clinic!\n");
    showTextbox("It's for treating sickness\nand injuries. It's not free,\nbut it will be cheap.\n");
  }
  if ((cond & 0x20) == 0x01 || (cond & 0x40) == 0x01) goto L1;
  goto L2;

L1:
  speak(Entity(5), "Your Digimon doesn't look\nwell. You need to take\ncare of his health.\n");
  showTextbox("I'll treat him now and\ngive you a discount.\nThree hundred bits.\n");
  if (money >= 300) {
    reduceMoney(300);
  } else {
    speak(Entity(5), "You don't have enough bits?\nPay me what you can.\n");
    reduceMoney(300);
  }
  move(entity: Entity.Partner, to: (-200, -1039), sprint: 0);
  waitForEntity(Entity.Partner);
  look(entity: Entity(5), at: Entity.Partner);
  look(entity: Entity.Player, at: Entity.Partner);
  delay(10);
  followEntity(Entity.Partner, speed: 20);
  sfx(8, 2, wait: 40);
  sfx(8, 3, wait: 20);
  removeCondition(Condition.Injured);
  removeCondition(Condition.Sick);
  anim(Entity.Partner, Animation(11), wait: 20);
  speak(Entity(5), "Everything is OK now.\nJust be careful from now on.\n");
  if (stat[Stat.Tiredness] >= 50) {
    setStats(tiredness: 50);
  }
  followEntity(Entity.Player, speed: 10);
  return;

L2:
  speak(Entity(5), "Your Digimon looks fine.\nWhat do you need?\n");
  setDialogOwner(Entity.Player);
  choice { "Get rid of his Tiredness" -> L3, "Sell me Medicine" -> section_52.L1, "Nothing" -> section_52.L2 }
  goto section_52.L2;

L3:
  if (stat[Stat.Tiredness] >= 80) {
    speak(Entity(5), "<ORANGE><DIGIMON><WHITE>'s Tiredness is very\nhigh, he needs to rest now.\n");
    goto L4;
  }
  if (stat[Stat.Tiredness] >= 50) {
    speak(Entity(5), "<ORANGE><DIGIMON><WHITE> is tired.\nHe should rest now.\n");
    goto L4;
  }
  if (stat[Stat.Tiredness] >= 20) {
    speak(Entity(5), "<ORANGE><DIGIMON><WHITE> seems to be a\nbit tired. He shouldn't\npush himself.\n");
    goto L4;
  }
  speak(Entity(5), "<ORANGE><DIGIMON><WHITE> is fine.\nWatch his Tiredness level.\n");

L4:
  pstat[:SavedTime] = time();
  addMinutesToDate(PStat.SavedTime, 60);
  advanceToDate(PStat.SavedTime);
  addStats(currentHP: 500, currentMP: 500);
  reduceStats(tiredness: 20);
  warp(to: Map.ROOM04, spawn: 1, trigger: 255);
  return;
}

section(52) {
  speak(Entity(5), "Does he feel more relaxed?\n");
  showTextbox("Still need something?\n");
  setDialogOwner(Entity.Player);
  choice { "We'll rest more" -> section_51.L3, "Sell me Medicine" -> L1, "Nothing" -> L2 }
  goto L2;

L1:
  speak(Entity(5), "He should be fine.\n");
  setDialogOwner(Entity.Player);
  choice { "Bandage: four hund bits" -> L3, "Medicine: twelve hund bits" -> L4, "Don't buy" -> L2 }
  goto L2;

L2:
  loop {
    speak(Entity(5), "When he doesn't feel good,\ncome see me.\n");
    roll(pstat: PStat.RollScratch, max: 9);
    if (pstat[110] <= 0) {
      speak(Entity(5), "If he's still tired,\ntrain less, and make him\neat and sleep regularly.\n");
      return;
    }
    if (pstat[110] <= 1) {
      speak(Entity(5), "Staying in cold or hot\nplaces for too long\ncan cause illness.\n");
      return;
    }
    if (pstat[110] <= 2) {
      speak(Entity(5), "A bandage is only good\nfor wounds.\n");
      return;
    }
    if (pstat[110] <= 3) {
      speak(Entity(5), "You can treat sickness\nwith Medicine, but it\nwon't reduce Tiredness.\n");
      return;
    }
    if (pstat[110] <= 4) {
      speak(Entity(5), "If HP is low at the end\nof a battle, Digimon\ncan get hurt easily.\n");
      return;
    }
    if (pstat[110] <= 5) {
      speak(Entity(5), "Keeping Happiness and\nTiredness at good levels\nleads to long life.\n");
      return;
      goto L3;
    }
    return;

L3:
    if (money < 400) {
      speak(Entity(5), "You don't have enough bits.\nI can't sell you that.\n");
      goto L5;
      return;
    }
    giveItem(Item.Bandage, 1);
    if (trigger(0)) {
      speak(Entity(5), "You have too many Items.\n");
      return;
    }
    reduceMoney(400);
    goto L5;

L4:
    if (money < 1200) {
      speak(Entity(5), "You don't have enough bits.\nI can't sell you that.\n");
      goto L5;
      return;
    }
    giveItem(Item.Medicine, 1);
    if (trigger(0)) {
      speak(Entity(5), "You have too many Items.\n");
      return;
    }
    reduceMoney(1200);
    goto L5;

L5:
    speak(Entity(5), "Still need something?\n");
    setDialogOwner(Entity.Player);
    choice { "Get rid of his Tiredness" -> section_51.L3, "Sell me more Medicine" -> L1, "No, nothing" -> L2 }
  }
  return;
  garbage { 10 00 fe 00 10 00 33 00 12 00 34 00 32 06 ff ff fe 00 19 00 01 00 35 00 18 00 1a 01 19 00 1c 00 35 00 1b 05 1a 00 82 67 82 85 82 8c 82 8c 82 8f 81 43 81 40 01 06 05 00 01 01 81 42 0d 00 82 72 82 95 82 92 82 90 82 92 82 89 82 93 82 85 81 49 81 40 82 68 81 40 82 8f 82 90 82 85 82 8e 82 85 82 84 0d 00 82 81 81 40 82 83 82 8c 82 89 82 8e 82 89 82 83 81 49 0d 00 00 00 1a 00 82 68 82 94 81 75 82 93 81 40 82 86 82 8f 82 92 81 40 82 94 82 92 82 85 82 81 82 94 82 89 82 8e 82 87 81 40 82 93 82 89 82 83 82 8b 82 8e 82 85 82 93 82 93 0d 00 82 81 82 8e 82 84 81 40 82 89 82 8e 82 8a 82 95 82 92 82 89 82 85 82 93 81 42 81 40 82 68 82 94 81 75 82 93 81 40 82 8e 82 8f 82 94 81 40 82 86 82 92 82 85 82 85 81 43 0d 00 82 82 82 95 82 94 81 40 82 89 82 94 81 40 82 97 82 89 82 8c 82 8c 81 40 82 82 82 85 81 40 82 83 82 88 82 85 82 81 82 90 81 42 0d 00 00 00 19 00 23 00 20 01 a3 00 40 01 18 00 2e 01 19 00 16 00 88 03 1b 05 1a 00 82 78 82 8f 82 95 82 92 81 40 82 63 82 89 82 87 82 89 82 8d 82 8f 82 8e 81 40 82 84 82 8f 82 85 82 93 82 8e 81 75 82 94 81 40 82 8c 82 8f 82 8f 82 8b 0d 00 82 97 82 85 82 8c 82 8c 81 42 81 40 82 78 82 8f 82 95 81 40 82 8e 82 85 82 85 82 84 81 40 82 94 82 8f 81 40 82 94 82 81 82 8b 82 85 0d 00 82 83 82 81 82 92 82 85 81 40 82 8f 82 86 81 40 82 88 82 89 82 93 81 40 82 88 82 85 82 81 82 8c 82 94 82 88 81 42 0d 00 00 00 1a 00 82 68 81 75 82 8c 82 8c 81 40 82 94 82 92 82 85 82 81 82 94 81 40 82 88 82 89 82 8d 81 40 82 8e 82 8f 82 97 81 40 82 81 82 8e 82 84 0d 00 82 87 82 89 82 96 82 85 81 40 82 99 82 8f 82 95 81 40 82 81 81 40 82 84 82 89 82 93 82 83 82 8f 82 95 82 8e 82 94 81 42 0d 00 82 73 }
}
