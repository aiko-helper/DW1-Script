  setPStat(254, 5);
  callSubroutine(8);
  for x in [384, 385, 388, 392] { unsetTrigger(x); }
  for id in 399..401 { unsetTrigger(id); }
  for x in [
    406, 416, 422, 386,
    389, 391, 390, 395,
    393, 387, 394, 396
    ] { unsetTrigger(x); }
