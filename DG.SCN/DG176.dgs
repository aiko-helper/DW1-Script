section onEnter(254) {
  if (trigger(206) || trigger(211) || trigger(213) || trigger(252)) {
    setObjectVisibility(21, 1);
  } else {
    setRectImpassible(35, 45, 2, 16);
  }
  if (pstat[25] == 3) {
    playAnimation(5, 28);
  }
  if (pstat[26] < 3) {
    setObjectVisibility(18, 0);
    setObjectVisibility(20, 0);
  } else {
    setObjectVisibility(18, 1);
    setObjectVisibility(20, 1);
  }
  return;
}

