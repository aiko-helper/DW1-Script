section section_82(82) {  // len=964
    if (trigger(69)) goto L_000e;
    return;
L_000e:
    look(entity: Entity.Player, at: 6);
    look(entity: 6, at: Entity.Player);
    setDialogOwner(6);
    showTextbox("Hi, I'm busy all the time\nrunning this shop... Not!\n");
    showTextbox("I'm kinda lazy and I won't\nbe in the shop much. \nBut I got some cool stuff.\n");
    showTextbox("Yes! 'Training Manual'!\nWith this, your training\nwill get better!\n");
    showTextbox("It's very valuable. I'll\nsell it for fifty thous bits.\nYou'll regret not buying it.\n");
    setDialogOwner(Entity.Player);
    setSelection(L_027c, L_0382);
    showTextbox("Buy\nDon't buy\n");
L_027c:
    if (money < 50000) goto L_0296;
    reduceMoney(50000);
    goto L_02d6;
L_0296:
    setDialogOwner(6);
    showTextbox("You don't have enough bits.\n");
    return;
L_02d6:
    giveItem(Item.TrainingManual, 1);
    if (!trigger(0)) goto L_0342;
    setDialogOwner(6);
    showTextbox("Hmmm, you have lots of\nstuff with you.\n");
    addMoney(50000);
    return;
L_0342:
    playSound(0, 5);
    setDialogOwner(Entity.System);
    showTextbox("I got a\n<LIGHTBLUE>Training Manual<WHITE>!\n");
L_0382:
    setDialogOwner(6);
    showTextbox("I won't give you a discount.\n");
    return;
}

