// DG194.SCN
#include "functions.dgs"
#pragma script index=194 start=0x94000 end=0x94800 headerU16=0x28 sentinelOff=0x2875
#include "entities.dgs"

section onEnter(254) {
  spawnChest(Item.Sirloin, 3758, 1159, 1024, 686);
  if (trigger(321)) goto L1;
  playAnimation(10, 28);
  return;

L1:
  return;
}

section(51) {
  move(entity: Entity.Player, to: (3588, 1931), sprint: 0);
  warp(to: Map.MGEN07, spawn: 1, trigger: 255);
  return;
}

section(52) {
  move(entity: Entity.Player, to: (-4289, 1108), sprint: 0);
  warp(to: Map.MGEN05, spawn: 1, trigger: 255);
  return;
}

section(5) {
  speak(5, "Taaa\n");
  startBattle();
  setTrigger(288);
  return;
}

section(6) {
  speak(6, "Let's ask for forgiveness.\n");
  startBattle();
  setTrigger(285);
  return;
}

section(7) {
  speak(7, "Forgiveness heals the heart.\n");
  startBattle();
  setTrigger(285);
  return;
}

section(8) {
  speak(8, "Are you evil?\n");
  startBattle();
  setTrigger(288);
  return;
}

section(9) {
  speak(9, "Follow me. Then...\n");
  startBattle();
  setTrigger(285);
  return;
}

section(53) {
  if (!trigger(321)) goto L1;
  return;

L1:
  speak(10, "Ha ha ha!\n");
  playAnimation(10, 28);
  move(entity: 10, axis: 1, to: 0, speed: 20);
  delay(60);
  speak(Entity.Player, "You!\n");
  speak(10, "You will lose!\n");
  setTrigger(1);
  setPStat(250, 1);
  setPStat(251, 10);
  setPStat(252, 255);
  setPStat(253, 255);
  startBattle();
  unsetTrigger(1);
  setPStat(250, 0);
  look(entity: Entity.Player, at: 10);
  look(entity: 10, at: Entity.Player);
  look(entity: Entity.Partner, at: 10);
  speak(10, "I can't believe I was\nbrain washed by him.\n");
  speak(10, "He's strong.\nCan you defeat him?\nWhy are you doing this?\n");
  speak(Entity.Player, "I'll fight for the island\nLet's settle this now.\n");
  speak(10, "We don't want a ruler,\nyou're our only hope.\n");
  goto L2;

L2:
  loop {
    playAnimation(10, 28);
    move(entity: 10, to: (-4562, 41), animDuration: 20);
    if (pstat[101] >= 3) break;
    addPStat(PStat.LoopIterator, 1);
    delay(20);
    look(entity: Entity.Player, at: 10);
    look(entity: Entity.Partner, at: 10);
  }
  waitForEntity(10);
  unloadEntity(10);
  setPStat(PStat.LoopIterator, 0);
  moveCamera(to: Entity.Player, speed: 10);
  waitForEntity(200);
  setTrigger(321);
  return;
  garbage { 28 00 fe 00 28 00 33 00 48 00 34 00 56 00 05 00 64 00 06 00 82 00 07 00 cc 00 08 00 1a 01 09 00 4a 01 35 00 84 01 ff ff 75 28 ae 0e 00 00 87 04 00 04 ae 02 19 00 01 00 41 01 18 00 46 00 19 00 56 00 0a 1c fe 00 fe 00 4e fd 04 0e 8b 07 00 00 4b f8 01 ff fe 00 4e fd 3f ef 54 04 00 00 4b db 01 ff fe 00 1b 05 1a 00 82 73 82 81 82 81 82 81 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 20 01 fe 00 1b 06 1a 00 82 6b 82 85 82 94 81 75 82 93 81 40 82 81 82 93 82 8b 81 40 82 86 82 8f 82 92 81 40 82 86 82 8f 82 92 82 87 82 89 82 96 82 85 82 8e 82 85 82 93 82 93 81 42 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 1d 01 fe 00 1b 07 1a 00 82 65 82 8f 82 92 82 87 82 89 82 96 82 85 82 8e 82 85 82 93 82 93 81 40 82 88 82 85 82 81 82 8c 82 93 81 40 82 94 82 88 82 85 81 40 82 88 82 85 82 81 82 92 82 94 81 42 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 1d 01 fe 00 1b 08 1a 00 82 60 82 92 82 85 81 40 82 99 82 8f 82 95 81 40 82 85 82 96 82 89 82 8c 81 48 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 20 01 fe 00 1b 09 1a 00 82 65 82 8f 82 8c 82 8c 82 8f 82 97 81 40 82 8d 82 85 81 42 81 40 82 73 82 88 82 85 82 8e 81 42 81 42 81 42 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 1d 01 fe 00 19 00 00 00 41 01 18 00 92 01 19 00 fe 00 1b 0a 1a 00 82 67 82 81 81 40 82 88 82 81 81 40 82 88 82 81 81 49 0d 00 00 00 56 00 0a 1c 72 0a 00 00 01 14 67 00 3c 00 1b fd 1a 00 82 78 82 8f 82 95 81 49 0d 00 00 00 1b 0a 1a 00 82 78 82 8f 82 95 81 40 82 97 82 89 82 8c 82 8c 81 40 82 8c 82 8f 82 93 82 85 81 49 0d 00 00 00 1c 00 01 00 1e 00 fa 01 1e 00 fb 0a 1e 00 fc ff 1e 00 fd ff 27 00 67 00 01 00 66 00 1d 00 01 00 1e 00 fa 00 4c 00 fd 0a 4c 00 0a fd 4c 00 fc 0a 1b 0a 1a 00 82 68 81 40 82 83 82 81 82 8e 81 75 82 94 81 40 82 82 82 85 82 8c 82 89 82 85 82 96 82 85 81 40 82 68 81 40 82 97 82 81 82 93 0d 00 82 82 82 92 82 81 82 89 82 8e 81 40 82 97 82 81 82 93 82 88 82 85 82 84 81 40 82 82 82 99 81 40 82 88 82 89 82 8d 81 42 0d 00 00 00 1b 0a 1a 00 82 67 82 85 81 75 82 93 81 40 82 93 82 94 82 92 82 8f 82 8e 82 87 81 42 0d