// DG054.SCN
#include "functions.dgs"
#pragma script index=54 start=0x28800 end=0x2a000 headerU16=0x20 sentinelOff=0x19
#include "entities.dgs"

section onEnter(254) {
  if (!trigger(110)) goto L1;
  setObjectVisibility(14, 1);

L1:
  if (!trigger(356) || trigger(358)) goto L2;
  delay(20);
  rotate(entity: Entity.Player, to: 1024);
  delay(5);
  moveCamera(to: (234, 211), slowdown: 30);
  waitForEntity(200);
  speak(Entity.Player, "Myotismon is gone.\n");
  setTrigger(358);
  moveCamera(to: Entity.Player, speed: 10);
  waitForEntity(200);

L2:
  return;
}

section(81) {
  if (trigger(110)) goto L2;
  speak(Entity.Player, "Oh!\n");
  playAnimation(Entity.Player, 12);
  delay(20);
  setObjectVisibility(14, 1);
  giveItem(Item.MansionKey, 1);
  speak(Entity.Player, "I found a key. Maybe it'll\nopen some of those doors.\n");
  speak(Entity.System, "I used the\n<LIGHTBLUE>Mansion Key<WHITE>!\n");
  if (!trigger(0)) goto L1;
  speak(Entity.Player, "I gotta get rid of something.\n");
  unsetTrigger(3);
  callSubroutine(0);
  callSubroutine(13);
  giveItem(Item.MansionKey, 1);

L1:
  setTrigger(110);
  goto L3;

L2:
  return;

L3:
  return;
}

section(82) {
  if (item[Item.MansionKey] < 1 || trigger(111)) goto L1;
  rotate(entity: Entity.Player, to: 2954);
  playSound(8, 3);
  speak(Entity.System, "I used the\n<LIGHTBLUE>Mansion Key<WHITE>!\n");
  setTrigger(111);
  goto L2;

L1:
  if (item[Item.MansionKey] >= 1 || trigger(111)) goto L2;
  rotate(entity: Entity.Player, to: 2954);
  playSound(8, 2);
  delay(5);
  playSound(8, 2);
  speak(Entity.System, "It doesn't open.\nIt's locked.\n");
  return;

L2:
  rotate3DObject(1, 1);
  playSound(8, 1);
  delay(10);
  move(entity: Entity.Player, to: (1600, 1674), sprint: 0);
  warp(to: Map.YAKA11A, spawn: 4, trigger: 255);
  return;
}

section(84) {
  rotate3DObject(0, 1);
  playSound(8, 1);
  delay(10);
  move(entity: Entity.Player, to: (-866, 3000), sprint: 0);
  warp(to: Map.YAKA12, spawn: 1, trigger: 255);
  return;
}

section(83) {
  if (item[Item.MansionKey] < 1 || trigger(113)) goto L1;
  rotate(entity: Entity.Player, to: 2954);
  playSound(8, 3);
  speak(Entity.System, "I used the\n<LIGHTBLUE>Mansion Key<WHITE>!\n");
  setTrigger(113);
  goto L2;

L1:
  if (item[Item.MansionKey] >= 1 || trigger(113)) goto L2;
  rotate(entity: Entity.Player, to: 2954);
  playSound(8, 2);
  delay(5);
  playSound(8, 2);
  speak(Entity.System, "It doesn't open.\nIt's locked.\n");
  return;

L2:
  rotate3DObject(2, 1);
  playSound(8, 1);
  delay(10);
  move(entity: Entity.Player, to: (1600, -1546), sprint: 0);
  warp(to: Map.YAKA11A, spawn: 5, trigger: 255);
  return;
}

section(60) {
  setDigimon(Digimon.Devimon, 0, 0);
  rotate(entity: Entity.Player, to: 906);
  move(entity: Entity.Partner, to: (775, -69), sprint: 1);
  waitForEntity(Entity.Partner);
  rotate(entity: Entity.Partner, to: 906);
  speak(Entity.Player, "Yum, yum....\n");
  speak(5, "Well.\n");
  look(entity: 5, at: Entity.Player);
  speak(5, "Listen to me.\n");
  speak(Entity.Player, "Yummy, yummy....\n");
  speak(5, "My guys don't behave anymore.\n");
  showTextbox("I don't think they can\nremember my orders.\n");
  showTextbox("They don't understand now.\nThey should be bringing\nme my meals, but....\n");
  speak(Entity.Player, "Yum, yum....\n");
  speak(5, "While I was working,\nthey didn't bring my meals,\nso I forgot to eat.\n");
  look(entity: Entity.Player, at: 5);
  speak(Entity.Player, "You're too wrapped up in\nyour work.\n");
  speak(5, "I'm so embarrassed.\n");
  speak(Entity.Player, "I think there's trouble\nin the mansion.\n");
  speak(5, "Any problem on the island?\nIs everyone like my men?\n");
  speak(Entity.Player, "Yes, they're all\nlosing their memory.\n");
  speak(5, "Do you think someone is\nplanning this?\n");
  speak(Entity.Player, "Hmm?\n");
  speak(5, "What can I do?\n");
  speak(Entity.Player, "We're building a city to\nunite the hearts of Digimon.\n");
  showTextbox("We're looking for friends.\n");
  speak(5, "What can I do? My men\nonly have fighting skills.\n");
  showTextbox("I can't leave them here.\n");
  speak(Entity.Player, "I see.\n");
  speak(5, "Let me think about it.\nI'm very sorry.\n");
  speak(Entity.Player, "I'll come back again.\nDon't forget to eat.\n");
  return;
  speak(Entity.Player, "Want to enter a match?\n");
  speak(5, "A match? That's perfect.\nIt will refresh my men.\n");
  speak(Entity.Player, "So, you want to join?\n");
  speak(5, "Yes, but I still have\nsome research to do.\nI'll go there soon.\n");
}

section(5) {
  if (!trigger(226)) goto L1;
  speak(5, "Thanks for your help.\nI'll show you my research.\n");
  showTextbox("Sometimes, if MetalGreymon\nfades away, he'll ");
  dead_string("?reymon\ndigivolve into SkullGreymon.\n");
  showTextbox("Bakemon, Devimon and\nPhoenixmon also digivolve\nthat way.\n");
  showTextbox("I don't know who they were\nat birth. The Digivolution\nCharts don't say.\n");
  return;

L1:
  if (!trigger(266)) goto L2;
  speak(5, "The matches have\nhelped my men.\n");
  showTextbox("A match is a good\nbreak from my research.\n");
  speak(Entity.Player, "What's the research about?\n");
  return;

L2:
  if (!trigger(205)) goto L3;
  speak(5, "An Arena has been\nmade in the city!\n");
  speak(5, "I wonder if my men\ncould help?\n");
  speak(Entity.Player, "Yes, they can be as\nforceful as they want.\n");
  setTrigger(266);
  goto L4;

L3:
  speak(5, "My men's condition is worse.\nIt's time to leave\nthe mansion.\n");
  return;

L4:
  return;
