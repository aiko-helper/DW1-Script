// DG111.SCN
#pragma script index=111 start=0x50000 end=0x50800 headerU16=0x20 sentinelOff=0x24
#pragma sections section_0254 section_0005 section_0006 section_0007 section_0008 section_0009 section_0010

section onEnter(254) {  // len=94
    roll(pstat: 110, max: 99);
    if (pstat[110] > 16) goto L_0016;
    spawnItem(Item.Digimushroom, 50, 39);
L_0016:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 4) goto L_002c;
    spawnItem(Item.Digimushroom, 34, 78);
L_002c:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 7) goto L_0042;
    spawnItem(Item.Digimushroom, 32, 41);
L_0042:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 3) goto L_0058;
    spawnItem(Item.Happymushroom, 49, 74);
L_0058:
    setTrigger(112);
    return;
}
