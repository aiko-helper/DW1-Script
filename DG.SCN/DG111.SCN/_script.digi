; DG111.SCN
;!script index=111 start=0x50000 end=0x50800 headerU16=0x20 sentinelOff=0x24
;!sections onEnter section_5 section_6 section_7 section_8 section_9 section_10

onEnter:     ; len=94
  0000:  storeRandom 110 99
  0004:  if pstat[110] > 16 then onEnter+0x16
  0010:  spawnItem 44 50 39
  0016:  storeRandom 110 99
  001a:  if pstat[110] > 4 then onEnter+0x2c
  0026:  spawnItem 44 34 78
  002c:  storeRandom 110 99
  0030:  if pstat[110] > 7 then onEnter+0x42
  003c:  spawnItem 44 32 41
  0042:  storeRandom 110 99
  0046:  if pstat[110] > 3 then onEnter+0x58
  0052:  spawnItem 69 49 74
  0058:  setTrigger 112
  005c:  endSection
