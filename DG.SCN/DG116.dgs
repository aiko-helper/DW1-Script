// DG116.SCN
#include "functions.dgs"
#pragma script index=116 start=0x54000 end=0x54800 headerU16=0x1c sentinelOff=0x24
#include "entities.dgs"

section onEnter(254) {
  spawnItemChance(max: 99, chance: 13, item: Item.Digimushroom, x: 53, y: 64);
  spawnItemChance(max: 99, chance: 8, item: Item.Digimushroom, x: 50, y: 36);
  spawnItemChance(max: 99, chance: 2, item: Item.Happymushroom, x: 42, y: 75);
  return;
}

section(6) {
  speak(Entity(6), "Wow!\n");
  finishEncounter(Trigger(280));
}

section(7) {
  speak(Entity(7), "Mmmm.\n");
  finishEncounter(Trigger(280));
}

section(8) {
  speak(Entity(8), "Uh, let's call it quits.\n");
  finishEncounter(Trigger(296));
}

section(9) {
  speak(Entity(9), "We can't let our\nguard down yet.\n");
  finishEncounter(Trigger(301));
}

section(5) {
  speak(Entity(5), "...!\n");
  setTrigger(Trigger(1));
  setPStat(PStat(250), 1);
  setPStat(PStat(251), 5);
  setPStat(PStat(252), 255);
  setPStat(PStat(253), 255);
  startBattle();
  unsetTrigger(Trigger(1));
  setPStat(PStat(250), 0);
  look(entity: Entity(5), at: Entity.Player);
  lookPairAt(Entity(5));
  waitForPair();
  speak(Entity(5), "No, I don't want to!\nI don't want to fight!\n");
  speak(Entity.Player, "If you don't want to\nfight, then run away.\n");
  speak(Entity(5), "That's too bad.\n");
  anim(Entity.Player, Animation(16), wait: 20);
  speak(Entity.Player, "I don't understand you.\n");
  showTextbox("Oh well, why don't you come\nto our city? Better than\nhiding out here.\n");
  speak(Entity(5), "Uh, city?\n");
  anim(Entity.Player, Animation(19), wait: 20);
  speak(Entity.Player, "We are not going to\nforce you.\n");
  speak(Entity(5), "That makes me want to go.\nOkay, I'll go!\n");
  fadeOutHUD();
  goto L1;

L1:
  approach(who: Entity(5), x: -330, y: -2751, tries: 5, wait: 20);
  playSound(8, 10);
  speak(Entity.System, "Gabumon joins the city!\n");
  anim(Entity.Player, Animation(16), wait: 20);
  speak(Entity.Player, "What a weird fellow.\n");
  followEntity(Entity.Player, speed: 10);
  setTrigger(Trigger(217));
  addPStat(PStat(1), 1);
  return;
  garbage { 1c 00 fe 00 1c 00 06 00 60 00 07 00 7e 00 08 00 9e 00 09 00 e4 00 05 00 3a 01 ff ff 24 00 6e 63 19 00 0b 00 6e 0d 18 00 32 00 19 00 74 2c 35 00 40 00 24 00 6e 63 19 00 0b 00 6e 08 18 00 48 00 19 00 74 2c 32 00 24 00 24 00 6e 63 19 00 0b 00 6e 02 18 00 5e 00 19 00 74 45 2a 00 4b 00 fe 00 1b 06 1a 00 82 76 82 8f 82 97 81 49 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 18 01 fe 00 1b 07 1a 00 82 6c 82 8d 82 8d 82 8d 81 42 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 18 01 fe 00 1b 08 1a 00 82 74 82 88 81 43 81 40 82 8c 82 85 82 94 81 75 82 93 81 40 82 83 82 81 82 8c 82 8c 81 40 82 89 82 94 81 40 82 91 82 95 82 89 82 94 82 93 81 42 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 28 01 fe 00 1b 09 1a 00 82 76 82 85 81 40 82 83 82 81 82 8e 81 75 82 94 81 40 82 8c 82 85 82 94 81 40 82 8f 82 95 82 92 0d 00 82 87 82 95 82 81 82 92 82 84 81 40 82 84 82 8f 82 97 82 8e 81 40 82 99 82 85 82 94 81 42 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 2d 01 fe 00 1b 05 1a 00 81 42 81 42 81 42 81 49 0d 00 00 00 1c 00 01 00 1e 00 fa 01 1e 00 fb 05 1e 00 fc ff 1e 00 fd ff 27 00 67 00 01 00 66 00 1d 00 01 00 1e 00 fa 00 4c 00 05 fd 4c 00 fd 05 4c 00 fc 05 4a fd 4a fc 1b 05 1a 00 82 6d 82 8f 81 43 81 40 82 68 81 40 82 84 82 8f 82 8e 81 75 82 94 81 40 82 97 82 81 82 8e 82 94 81 40 82 94 82 8f 81 49 0d 00 82 68 81 40 82 84 82 8f 82 8e 81 75 82 94 81 40 82 97 82 81 82 8e 82 94 81 40 82 94 82 8f 81 40 82 86 82 89 82 87 82 88 82 94 81 49 0d 00 00 00 1b fd 1a 00 82 68 82 86 81 40 82 99 82 8f 82 95 81 40 82 84 82 8f 82 8e 81 75 82 94 81 40 82 97 82 81 82 8e 82 94 81 40 82 94 82 8f 0d 00 82 86 82 89 82 87 82 88 82 94 81 43 81 40 82 94 82 88 82 85 82 8e 81 40 82 92 82 95 82 8e 81 40 82 81 82 97 82 81 82 99 81 42 0d 00 00 00 1b 05 1a 00 82 73 82 88 82 81 82 94 81 75 82 93 81 40 82 94 82 8f 82 8f 81 40 82 82 82 81 82 84 81 42 0d 00 00 00 56 00 fd 10 67 00 14 00 1b fd 1a 00 82 68 81 40 82 84 82 8f 82 8e 81 75 82 94 81 40 82 95 82 8e 82 84 82 85 82 92 82 93 82 94 82 81 82 8e 82 84 81 40 82 99 82 8f 82 95 81