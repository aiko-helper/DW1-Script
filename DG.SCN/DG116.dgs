// DG116.SCN
#include "functions.dgs"
#pragma script index=116 start=0x4d000 end=0x4d800 headerU16=0x10 sentinelOff=0x1875
#include "entities.dgs"

section onEnter(254) {
  spawnChest(Item.DefenseChip, 1460, -443, 3072, 666);
  return;
}

section(6) {
  speak(Entity(6), "「ジャマ?」<NEWLINE>");
  finishEncounter(Trigger(280));
}

section(5) {
  {
    speak(Entity(5), "「やぁー、助かったです!」<NEWLINE>");
    speak(Entity.Player, "「お前か、ハマってたのは。」<NEWLINE>");
    speak(Entity(5), "「だけど、ちょうどよかったですよ。」<NEWLINE>");
    anim(Entity.Player, Animation(19), wait: 15);
    speak(Entity.Player, "「何が?」<NEWLINE>");
    playAnimation(Entity.Player, Animation(0));
    speak(Entity(5), "「ボクはボクの才能をいかすために、<NEWLINE> キミの街へ行く途中だったのですー!」<NEWLINE>");
    speak(Entity.Player, "「う…どんな才能?」<NEWLINE>");
    speak(Entity(5), "「おや、ボクをごぞんじない?<NEWLINE> ボクはデジモンのなかでも評判の<NEWLINE> 物知りなのです!」<NEWLINE>");
    speak(Entity.Player, "「えー。そんなの聞いたこと無いぜ。」<NEWLINE>");
    speak(Entity(5), "「さ、ボクは街へいきましょうかね。」<NEWLINE>");
    anim(Entity.Player, Animation(16), wait: 15);
    speak(Entity.Player, "「(………。こいつ、役に立つの?)」<NEWLINE>");
    playAnimation(Entity.Player, Animation(0));
    speak(Entity(5), "「ではごきげんよう。」<NEWLINE>");
    break;
  }
  approach(who: Entity(5), x: -111, y: -2962, tries: 3, wait: 20);
  playSound(8, 10);
  speak(Entity.System, "シェルモンが街に参加した!!!<NEWLINE>");
  setTrigger(Trigger(235));
  addPStat(PStat(1), 2);
  return;
  garbage { 10 00 fe 00 10 00 06 00 1e 00 05 00 40 00 ff ff 75 18 b4 05 00 00 45 fe 00 0c 9a 02 fe 00 1b 06 1a 00 81 75 83 57 83 83 83 7d 81 48 81 76 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 18 01 fe 00 1b 05 1a 00 81 75 82 e2 82 9f 81 5b 81 41 8f 95 82 a9 82 c1 82 bd 82 c5 82 b7 81 49 81 76 0d 00 00 00 1b fd 1a 00 81 75 82 a8 91 4f 82 a9 81 41 83 6e 83 7d 82 c1 82 c4 82 bd 82 cc 82 cd 81 42 81 76 0d 00 00 00 1b 05 1a 00 81 75 82 be 82 af 82 c7 81 41 82 bf 82 e5 82 a4 82 c7 82 e6 82 a9 82 c1 82 bd 82 c5 82 b7 82 e6 81 42 81 76 0d 00 00 00 56 00 fd 13 67 00 0f 00 1b fd 1a 00 81 75 89 bd 82 aa 81 48 81 76 0d 00 00 00 56 00 fd 00 1b 05 1a 00 81 75 83 7b 83 4e 82 cd 83 7b 83 4e 82 cc 8d cb 94 5c 82 f0 82 a2 82 a9 82 b7 82 bd 82 df 82 c9 81 41 0d 00 81 40 83 4c 83 7e 82 cc 8a 58 82 d6 8d 73 82 ad 93 72 92 86 82 be 82 c1 82 bd 82 cc 82 c5 82 b7 81 5b 81 49 81 76 0d 00 00 00 1b fd 1a 00 81 75 82 a4 81 63 82 c7 82 f1 82 c8 8d cb 94 5c 81 48 81 76 0d 00 00 00 1b 05 1a 00 81 75 82 a8 82 e2 81 41 83 7b 83 4e 82 f0 82 b2 82 bc 82 f1 82 b6 82 c8 82 a2 81 48 0d 00 81 40 83 7b 83 4e 82 cd 83 66 83 57 83 82 83 93 82 cc 82 c8 82 a9 82 c5 82 e0 95 5d 94 bb 82 cc 0d 00 81 40 95 a8 92 6d 82 e8 82 c8 82 cc 82 c5 82 b7 81 49 81 76 0d 00 00 00 1b fd 1a 00 81 75 82 a6 81 5b 81 42 82 bb 82 f1 82 c8 82 cc 95 b7 82 a2 82 bd 82 b1 82 c6 96 b3 82 a2 82 ba 81 42 81 76 0d 00 00 00 1b 05 1a 00 81 75 82 b3 81 41 83 7b 83 4e 82 cd 8a 58 82 d6 82 a2 82 ab 82 dc 82 b5 82 e5 82 a4 82 a9 82 cb 81 42 81 76 0d 00 00 00 56 00 fd 10 67 00 0f 00 1b fd 1a 00 81 75 81 69 81 63 81 63 81 63 81 42 82 b1 82 a2 82 c2 81 41 96 f0 82 c9 97 a7 82 c2 82 cc 81 48 81 6a 81 76 0d 00 00 00 56 00 fd 00 1b 05 1a 00 81 75 82 c5 82 cd 82 b2 82 ab 82 b0 82 f1 82 e6 82 a4 81 42 81 76 0d 00 00 00 16 00 4c 02 4e 05 91 ff 6e f4 01 00 19 00 0d 00 65 03 18 00 74 02 19 00 1f 00 65 01 67 00 14 00 4c 00 fd 05 4c 00 fc 05 16 00 4c 02 4a 05 48 05 1e 00 65 00 5a 00 08 0a 1b ff 1a 00 83 56 83 46 83 8b 83 82 83 93 82 aa 8a 58 82 c9 8e 51 89