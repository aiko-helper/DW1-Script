// DG160.SCN
#include "functions.dgs"
#pragma script index=160 start=0x6d800 end=0x6e800 headerU16=0x14 sentinelOff=0xfe
#include "entities.dgs"

section onEnter(254) {
  return;
}

section(81) {
  look(entity: Entity.Player, at: Entity(5));
  look(entity: Entity(5), at: Entity.Player);
  {
    if (trigger(58) || trigger(61) || trigger(60) || trigger(59)) {
      break;
    }
    if (trigger(209) && !trigger(58) && pstat[27] == 0) {
      speak(Entity(5), "「いらっしゃい。」<NEWLINE>");
      showTextbox("「見てくれ、<LIGHTBLUE><PLAYER><WHITE>。<NEWLINE> 私は外食屋のオーナー兼シェフになることに<NEWLINE> したぞ。」<NEWLINE>");
      showTextbox("「おまえ達には私の炎の料理をじっくり<NEWLINE> 味わってもらうぞ…フフフ…」<NEWLINE>");
      setTrigger(Trigger(58));
      return;
    }
    if (trigger(208) && !trigger(61) && pstat[27] == 1) {
      speak(Entity(5), "「はっはっは、<LIGHTBLUE><PLAYER><WHITE>、<ORANGE><DIGIMON><WHITE><NEWLINE> 俺の料理食べてけよ!」<NEWLINE>");
      showTextbox("「まさか俺の隠れた特技を生かせるとは<NEWLINE> 思わなかったぜ。アイテムとは違う本格的な<NEWLINE> 食事を味わってくれよな!」<NEWLINE>");
      setTrigger(Trigger(61));
      return;
    }
    if (trigger(222) && !trigger(60) && pstat[27] == 2) {
      speak(Entity(5), "「おーす、<LIGHTBLUE><PLAYER><WHITE>、<ORANGE><DIGIMON><WHITE>!<NEWLINE> 俺は料理で食っていくことにしたぜ。<NEWLINE> こう見えて料理は得意でな。」<NEWLINE>");
      showTextbox("「けいたい食ばっかりじゃアキるだろ?<NEWLINE> たまにはゆっくり店で食事すんのもオツな<NEWLINE> もんだぜ!」<NEWLINE>");
      setTrigger(Trigger(60));
      return;
    }
    if (!trigger(223) || trigger(59) || pstat[27] != 3) break;
    speak(Entity(5), "「やあー!<LIGHTBLUE><PLAYER><WHITE>、<ORANGE><DIGIMON><WHITE>。<NEWLINE> ぼくのレストランがついにオープンだよ!」<NEWLINE>");
    showTextbox("「ぼく特製の冷たいデサート、おいしいから<NEWLINE> ぜひ食べてってよね~!」<NEWLINE>");
    setTrigger(Trigger(59));
    return;
  }
  if (trigger(209) && !trigger(58) && pstat[27] == 0) {
    speak(Entity(5), "「ふ…<LIGHTBLUE><PLAYER><WHITE>、私はこの店のシェフと<NEWLINE> して働くことになった。」<NEWLINE>");
    showTextbox(" 「おまえ達には真昼の暑い料理をじっくり<NEWLINE> 味わってもらうぞ。」<NEWLINE>");
    setTrigger(Trigger(58));
    return;
  }
  if (trigger(208) && !trigger(61) && pstat[27] == 1) {
    speak(Entity(5), "「はっは!<LIGHTBLUE><PLAYER><WHITE>、<ORANGE><DIGIMON><WHITE>。<NEWLINE> 俺ぁ料理人になったんだぜ!」<NEWLINE>");
    showTextbox("「まさか俺の隠れた特技を生かせるたぁ<NEWLINE> 思わなかったぜ。俺の特別料理を食いたい<NEWLINE> なら午前中に来な!」<NEWLINE>");
    setTrigger(Trigger(61));
    return;
  }
  if (trigger(222) && !trigger(60) && pstat[27] == 2) {
    speak(Entity(5), "「おーす、<LIGHTBLUE><PLAYER><WHITE>、<ORANGE><DIGIMON><WHITE>!<NEWLINE> 俺は料理に生きることに決めたぜ!」<NEWLINE>");
    showTextbox("「俺の特別料理は夜中か早朝にしか<NEWLINE> 食えないが、栄養満点だぜ!」<NEWLINE>");
    setTrigger(Trigger(60));
    return;
  }
  if (trigger(223) && !trigger(59) && pstat[27] == 3) {
    speak(Entity(5), "「やあー!<LIGHTBLUE><PLAYER><WHITE>、<ORANGE><DIGIMON><WHITE>!<NEWLINE>");
    showTextbox("「ぼく、この店を手伝うことにしたよ。<NEWLINE> デザート作らせてくれるっていうし。」<NEWLINE>");
    showTextbox("「ぼく特製のデザート、絶対おいしいから<NEWLINE> 食べてってね。」<NEWLINE>");
    setTrigger(Trigger(59));
    return;
  }
  if (pstat[27] == 0 || pstat[27] == 1 || pstat[27] == 2) {
    jumpToScriptSection(184, 51);
  }
  if (pstat[27] != 3 && pstat[27] != 4 && pstat[27] != 5) goto section_6;
  jumpToScriptSection(185, 51);
}

section(6) {
  if (!trigger(64)) {
    speak(Entity(6), "「ギギギッ、よお、<LIGHTBLUE><PLAYER><WHITE>!<NEWLINE> さあーこのマシンは何だ?」<NEWLINE>");
    showTextbox("「ギギッ!あぶねえモンじゃねーよ!<NEWLINE> こいつぁ オレのハートをアツくする<NEWLINE> ジュークボックスだ!ギヒヒ!」<NEWLINE>");
    showTextbox("「オマエもよぉ、たまにはハジケるんだよ!<NEWLINE> バ・ク・ハ・ツ・するんだよぉ!<NEWLINE> アツいリクエスト待ってるぜ、ギギ!」<NEWLINE>");
    setTrigger(Trigger(64));
  }
  setPStat(PStat(254), 6);
  callSubroutine(9);
  return;
}

