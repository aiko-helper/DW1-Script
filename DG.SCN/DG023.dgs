// DG023.SCN
#pragma script index=23 start=0x16800 end=0x17000 headerU16=0x28 sentinelOff=0x24

function speakThenStartBattleThenSetTrigger(a, b, c) {
    speak(a, b);
    startBattle();
    setTrigger(c);
}


section onEnter(254) {  // len=68
    roll(pstat: 110, max: 99);
    if (pstat[110] > 7) goto L1;
    spawnItem(Item.Digimushroom, x: 44, y: 33);

L1:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 15) goto L2;
    spawnItem(Item.Digimushroom, x: 23, y: 49);

L2:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 3) goto L3;
    spawnItem(Item.BigBerry, x: 25, y: 74);

L3:
    return;
}

section(5) {  // len=40
    speakThenStartBattleThenSetTrigger(5, "It's hot!\n", 269);
    return;
}

section(6) {  // len=60
    speakThenStartBattleThenSetTrigger(6, "It started boiling!\n", 269);
    return;
}

section(7) {  // len=42
    speakThenStartBattleThenSetTrigger(7, "Oh, I see.\n", 286);
    return;
}

section(8) {  // len=56
    speakThenStartBattleThenSetTrigger(8, "Alright. Come on!\n", 286);
    return;
}

section(9) {  // len=54
    speakThenStartBattleThenSetTrigger(9, "I've had enough!\n", 296);
    return;
}

section(10) {  // len=48
    speakThenStartBattleThenSetTrigger(10, "No thank you!\n", 296);
    return;
}

section(11) {  // len=32
    speakThenStartBattleThenSetTrigger(11, "What?\n", 280);
    return;
}

section(12) {  // len=1608
    speakThenStartBattleThenSetTrigger(12, "Mmmmm!\n", 280);
