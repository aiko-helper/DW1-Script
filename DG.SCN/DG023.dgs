// DG023.SCN
#include "functions.dgs"
#pragma script index=23 start=0x15800 end=0x16000 headerU16=0x2c sentinelOff=0x24
#include "entities.dgs"

section onEnter(254) {
  spawnItemChance(max: 99, chance: 7, item: Item.Digimushroom, x: 44, y: 33);
  spawnItemChance(max: 99, chance: 15, item: Item.Digimushroom, x: 23, y: 49);
  spawnItemChance(max: 99, chance: 3, item: Item.BigBerry, x: 25, y: 74);
  return;
}

section(5) {
  speak(Entity(5), "「アツい、アツいぜ!」<NEWLINE>");
  finishEncounter(Trigger(269));
}

section(6) {
  speak(Entity(6), "「たぎって来たぞぉ!」<NEWLINE>");
  finishEncounter(Trigger(269));
}

section(7) {
  speak(Entity(7), "「おやおや、そうなんだ。」<NEWLINE>");
  finishEncounter(Trigger(286));
}

section(8) {
  speak(Entity(8), "「いいでしょう。さあ!」<NEWLINE>");
  finishEncounter(Trigger(286));
}

section(9) {
  speak(Entity(9), "「もうやだよぉ!」<NEWLINE>");
  finishEncounter(Trigger(296));
}

section(10) {
  speak(Entity(10), "「まっぴらごめんだね。」<NEWLINE>");
  finishEncounter(Trigger(296));
}

section(11) {
  speak(Entity(11), "「んだよ!」<NEWLINE>");
  finishEncounter(Trigger(280));
}

section(12) {
  speak(Entity(12), "「なろぉー!」<NEWLINE>");
  finishEncounter(Trigger(280));
}

section(51) {
  if (trigger(150) && !trigger(234)) {
    speak(Entity.Player, "「何かいやな予感がするな…」<NEWLINE>");
    look(entity: Entity.Player, at: Entity.Partner);
    look(entity: Entity.Partner, at: Entity.Player);
    delay(5);
    speak(Entity.Player, "「おまえもそうか?そうだな。」<NEWLINE>");
    move(entity: Entity.Player, to: (1745, -1614), sprint: 0);
    waitForEntity(Entity.Player);
    return;
  }
  {
    if (!trigger(238)) break;
    if (trigger(150) && !trigger(234)) break;
    speak(Entity.Player, "「トンネルにはもう何も無いからな…<NEWLINE> 一気にかけぬけるか?どうする?」<NEWLINE>");
    setSelection(L1, L2);
    showTextbox("「いくぞ!」<NEWLINE>「やめとこう。」<NEWLINE>");
    waitForSelectionChoice();
    goto L2;
  }
  return;

L1:
  move(entity: Entity.Player, to: (2876, -1583), sprint: 1);
  warp(to: Map.MAYO11, spawn: 1, trigger: 255);

L2:
  move(entity: Entity.Player, to: (2876, -1583), sprint: 0);
  warp(to: Map.TUNN09, spawn: 1, trigger: 255);
  return;
