section onEnter(254) {
  if (pstat[30] < 3 && trigger(178)) {
    move(entity: 5, to: (169, 2232), animDuration: 5);
    waitForEntity(5);
  }
  if (pstat[30] < 10 && trigger(179)) {
    move(entity: 5, to: (169, 2232), animDuration: 5);
    waitForEntity(5);
    return;
  }
  return;
}

