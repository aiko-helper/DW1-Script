// DG169.SCN
#include "functions.dgs"
#pragma script index=169 start=0x75000 end=0x75800 headerU16=0x2c sentinelOff=0x1b75
#include "entities.dgs"

section onEnter(254) {
  spawnChest(Item.HPChip, -373, 4348, 0, 690);
  spawnChest(Item.MPChip, 384, 4392, 0, 691);
  return;
}

section(51) {
  move(entity: Entity.Player, to: (-2748, 3453), sprint: 0);
  warp(to: Map.MGEN98, spawn: 0, trigger: 255);
  return;
}

section(52) {
  move(entity: Entity.Player, to: (2801, 3497), sprint: 0);
  warp(to: Map.MGEN09, spawn: 1, trigger: 255);
  return;
}

section(5) {
  speak(Entity(5), "「さあ、これが最後です。」<NEWLINE>");
  finishEncounter(Trigger(285));
}

section(6) {
  speak(Entity(6), "「ついに来てしまったのか…」<NEWLINE>");
  finishEncounter(Trigger(305));
}

section(7) {
  speak(Entity(7), "「道はひらけます。」<NEWLINE>");
  finishEncounter(Trigger(285));
}

section(8) {
  speak(Entity(8), "「ここで楽にしてやろう!」<NEWLINE>");
  finishEncounter(Trigger(305));
}

section(9) {
  speak(Entity(9), "「これがラスト・チャンスです。」<NEWLINE>");
  finishEncounter(Trigger(285));
}

section(10) {
  speak(Entity(10), "「本当に行くのか…?」<NEWLINE>");
  finishEncounter(Trigger(305));
}

section(53) {
  if (trigger(254)) {
    return;
  }
  {
    look(entity: Entity.Player, at: Entity(11));
    delay(5);
    speak(Entity.Player, "「(うお、おそろしい殺気!全身に<NEWLINE> ビシバシ伝わってくるぜ!)」<NEWLINE>");
    speak(Entity(11), "「………」<NEWLINE>");
    speak(Entity.Player, "「む…向かってこない!?」<NEWLINE>");
    speak(Entity(11), "「………」<NEWLINE>");
    speak(Entity.Player, "「戦わなくてもいいのか…?」<NEWLINE>");
    setDialogOwner(Entity.Player);
    setSelection(L2, L1);
    showTextbox("「先を急いだほうがいいな。」<NEWLINE>「ここは腕試しだ。」<NEWLINE>");
    waitForSelectionChoice();
    break;

L1:
  }
  {
    speak(Entity.Player, "「いくぜ、<ORANGE><DIGIMON><WHITE>!」<NEWLINE>");
    setTrigger(Trigger(1));
    setPStat(PStat(250), 1);
    setPStat(PStat(251), 11);
    setPStat(PStat(252), 255);
    setPStat(PStat(253), 255);
    startBattle();
    unsetTrigger(Trigger(1));
    setPStat(PStat(250), 0);
    look(entity: Entity.Player, at: Entity(11));
    look(entity: Entity(11), at: Entity.Player);
    look(entity: Entity.Partner, at: Entity(11));
    speak(Entity(11), "「………」<NEWLINE>");
    break;
  }
  approach(who: Entity(11), x: 0, y: 0, tries: 3, wait: 20);
  speak(Entity.Player, "「…勝った…のか?」<NEWLINE>");
  setTrigger(Trigger(254));
  addPStat(PStat(1), 3);
  followEntity(Entity.Player, speed: 15);
  return;

L2:
  move(entity: Entity.Player, to: (43, 1754), sprint: 1, withCamera: true);
  waitForEntity(Entity.Player);
  return;
  garbage { 2c 00 fe 00 2c 00 33 00 46 00 34 00 54 00 05 00 62 00 06 00 92 00 07 00 c4 00 08 00 ee 00 09 00 1e 01 0a 00 54 01 35 00 80 01 ff ff 75 1b 8b fe 00 00 fc 10 00 00 b2 02 75 1c 80 01 00 00 28 11 00 00 b3 02 fe 00 4e fd 44 f5 7d 0d 00 00 4b de 00 ff fe 00 4e fd f1 0a a9 0d 00 00 4b fd 01 ff fe 00 1b 05 1a 00 81 75 82 b3 82 a0 81 41 82 b1 82 ea 82 aa 8d c5 8c e3 82 c5 82 b7 81 42 81 76 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 1d 01 fe 00 1b 06 1a 00 81 75 82 c2 82 a2 82 c9 97 88 82 c4 82 b5 82 dc 82 c1 82 bd 82 cc 82 a9 81 63 81 76 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 31 01 fe 00 1b 07 1a 00 81 75 93 b9 82 cd 82 d0 82 e7 82 af 82 dc 82 b7 81 42 81 76 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 1d 01 fe 00 1b 08 1a 00 81 75 82 b1 82 b1 82 c5 8a 79 82 c9 82 b5 82 c4 82 e2 82 eb 82 a4 81 49 81 76 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 31 01 fe 00 1b 09 1a 00 81 75 82 b1 82 ea 82 aa 83 89 83 58 83 67 81 45 83 60 83 83 83 93 83 58 82 c5 82 b7 81 42 81 76 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 1d 01 fe 00 1b 0a 1a 00 81 75 96 7b 93 96 82 c9 8d 73 82 ad 82 cc 82 a9 81 63 81 48 81 76 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 31 01 fe 00 19 00 00 00 fe 00 18 00 8e 01 19 00 fe 00 4c 00 fd 0b 67 00 05 00 1b fd 1a 00 81 75 81 69 82 a4 82 a8 81 41 82 a8 82 bb 82 eb 82 b5 82 a2 8e 45 8b 43 81 49 91 53 90 67 82 c9 0d 00 81 40 83 72 83 56 83 6f 83 56 93 60 82 ed 82 c1 82 c4 82 ad 82 e9 82 ba 81 49 81 6a 81 76 0d 00 00 00 1b 0b 1a 00 81 75 81 63 81 63 81 63 81 76 0d 00 00 00 1b fd 1a 00 81 75 82 de 81 63 8c fc 82 a9 82 c1 82 c4 82 b1 82 c8 82 a2 81 49 81 48 81 76 0d 00 00 00 1b 0b 1a 00 81 75 81 63 81 63 81 63 81 76 0d 00 00 00 1b fd 1a 00 81 75 90 ed 82 ed 82 c8 82 ad 82 c4 82 e0 82 a2 82 a2 82 cc 82 a9 81 63 81 48 81 76 0d 00 00 00 1b fd 10 02 4c 03 8e 02 1a 00 81 75 90 e6 82 f0 8b 7d 82 a2 82 be 82 d9 82 a4 82 aa 82 a2 82 a2 82 c8 81 42 81 76 0d 00 81 75 82 b1 82 b1 82 cd 98 72 8e 8e 82 b5 82 be 81 42 81 76 0d 00 00 00 12 00 16 00 8e 02 1b fd 1a 00 81 75 82 a2 82