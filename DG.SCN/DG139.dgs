section onEnter(254) {
  return;
}

section(51) {
  return;
}

section(5) {
  speak(Entity(5), "「ダレダ、オマエハ?」<NEWLINE>");
  finishEncounter(Trigger(292));
}

section(6) {
  speak(Entity(6), "「ナニシニキタ?」<NEWLINE>");
  finishEncounter(Trigger(292));
}

section(7) {
  speak(Entity(7), "「まろは、ひとやすみするぞえ。」<NEWLINE>");
  finishEncounter(Trigger(273));
}

