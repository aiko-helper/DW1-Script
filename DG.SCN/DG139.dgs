    setSelection(L1, L5);
    showTextbox("「もどる。」<NEWLINE>「もどらない。」<NEWLINE>");
    waitForSelectionChoice();
    break;

L1:
    if (!trigger(203)) {
      warp(to: Map.TWNA01, spawn: 0, trigger: 255);
    }
    {
      if (trigger(220) || trigger(214) || pstat[1] >= 50) goto L3; else break;
    }
    {
