    playSound(8, 4);
    rotate3DObject(0, 1);
    delay(1);
    rotate3DObject(1, 1);
    delay(1);
    rotate3DObject(0, 1);
    delay(1);
    rotate3DObject(1, 1);
    delay(1);
    rotate3DObject(0, 1);
    delay(1);
    rotate3DObject(1, 1);
    delay(1);
    rotate3DObject(0, 1);
    delay(1);
    rotate3DObject(1, 1);
    delay(1);
    playSound(8, 5);
    if (pstat[16] != 3) goto L_00c4;
    warp(to: Map.MGEN11, spawn: 0, trigger: 60);
L_00c4:
