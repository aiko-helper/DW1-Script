; source: ./extract/DIGIMON/SCN/DG.SCN
; DG039.SCN, section 51

section_51(51):     ; len=1958
  0000:  if !trigger(175) OR !trigger(180) OR trigger(182) then section_51+0x18
  0014:  jump section_51+0x30
  0018:  if !trigger(181) OR !trigger(182) OR trigger(235) then section_51+0x2e
  002c:  endSection
  002e:  endSection
  0030:  playSound 8 12
  0034:  speak System "<YELLOW>??? <WHITE>\nHelp me!\n"
  005a:  setRotation Player 1321
  005e:  setRotation Partner 1321
  0062:  delay 10
  0066:  playAnimation Player 23
  006a:  delay 15
  006e:  speak Player "I hear a voice from above.\nAnybody there?\n"
  00c8:  playAnimation Player 0
  00cc:  delay 10
  00d0:  speak System "<YELLOW>??? <WHITE>\nAnybody there?\n"
  0102:  delay 10
  0106:  speak Player "Yes, there is.\n"
  012a:  delay 10
  012e:  speak System "<YELLOW>??? <WHITE>\nHelp me!\nThe ground is bulging up.\n"
  0188:  delay 10
  018c:  speak Player "You gotta be kidding.\n"
  01be:  delay 10
  01c2:  playSound 8 11
  01c6:  speak System "<YELLOW>??? <WHITE>\nNo, it's true.\nI hear some machinery noise.\n"
  0232:  delay 10
  0236:  playAnimation Player 16
  023a:  delay 15
  023e:  speak Player "A machine? It must be coming\nfrom Ogremon's hideout.\n"
  02ae:  playAnimation Player 0
  02b2:  delay 10
  02b6:  speak System "<YELLOW>??? <WHITE>\nYou must have done\nsomething wrong there, no?\n"
  0326:  delay 10
  032a:  speak Player "I did many things. It could\nbe the elevator.... I'll go\nback to the hideout and check.\n"
  03de:  delay 10
  03e2:  playSound 8 11
  03e6:  speak System "<YELLOW>??? <WHITE>\nThanks.\n"
  040a:  delay 10
  040e:  setTrigger 182
