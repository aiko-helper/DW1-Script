section_5(5):     ; len=1836
  0000:  setTrigger 44
  0004:  if !trigger(129) then section_5+0x8c
  0010:  lookAt 5 Player
  0014:  speak 5 "I'll join you at the Arena.\nSome of my men may miss me.\n"
  008a:  endSection
  008c:  if !trigger(325) then section_5+0x178
  0098:  lookAt 5 Player
  009c:  speak 5 "My men don't behave.\nSo I'll take SkullGreymon.\n"
  0102:  speak 5 "SkullGreymon isn't the same.\nHe listens to others now.\n"
  0176:  endSection
  0178:  speak Player "Myotismon, you alright?\n"
  01ae:  playAnimation 5 21
  01b2:  playAnimation 6 21
  01b6:  delay 20
  01ba:  playAnimation 5 0
  01be:  playAnimation 6 0
  01c2:  delay 10
  01c6:  lookAt 5 Player
  01ca:  lookAt 6 Player
  01ce:  delay 5
  01d2:  speak 5 "Ugghh... It's you!\nYou've rescued me again.\n"
  0230:  speak Player "What happened?\n"
  0254:  speak 5 "Have you seen Devimon?\n"
  0288:  speak Player "I have. He's mean.\n"
  02b4:  speak 5 "He runied my research\nwith evil.\n"
  02fc:  playAnimation Player 19
  0300:  delay 15
  0304:  speak Player "Your research\non SkullGreymon?\n"
  0348:  playAnimation Player 0
  034c:  speak 5 "I was collecting bones and\nputting them together.\nI'll be more careful.\n"
  03e2:  speak Player "That Devimon is awful.\n"
  0416:  speak 5 "I know him well.\n"
  043e:  speak Player "What?!\n"
  0452:  speak 5 "He was always tricky,\nbut never this bad.\n"
  04ac:  showTextbox "Maybe he's being\nbrainwashed by someone.\n"
  0502:  speak Player "Maybe.\n"
  0516:  speak 5 "He could be part of your\ngroup if he was himself.\n"
  0580:  moveCameraToEntity Player 10
  0584:  waitForEntity 200
  0586:  setTrigger 129
