section_5:     ; len=1836
  0000:  setTrigger 44
  0004:  if !trigger(129) then section_5+0x8c
  0010:  lookAt 5 253
  0014:  setDialogOwner 5
  0016:  showTextbox "I'll join you at the Arena.\nSome of my men may miss me.\n"
  008a:  endSection
  008c:  if !trigger(325) then section_5+0x178
  0098:  lookAt 5 253
  009c:  setDialogOwner 5
  009e:  showTextbox "My men don't behave.\nSo I'll take SkullGreymon.\n"
  0102:  setDialogOwner 5
  0104:  showTextbox "SkullGreymon isn't the same.\nHe listens to others now.\n"
  0176:  endSection
  0178:  setDialogOwner 253
  017a:  showTextbox "Myotismon, you alright?\n"
  01ae:  playAnimation 5 21
  01b2:  playAnimation 6 21
  01b6:  delay 20
  01ba:  playAnimation 5 0
  01be:  playAnimation 6 0
  01c2:  delay 10
  01c6:  lookAt 5 253
  01ca:  lookAt 6 253
  01ce:  delay 5
  01d2:  setDialogOwner 5
  01d4:  showTextbox "Ugghh... It's you!\nYou've rescued me again.\n"
  0230:  setDialogOwner 253
  0232:  showTextbox "What happened?\n"
  0254:  setDialogOwner 5
  0256:  showTextbox "Have you seen Devimon?\n"
  0288:  setDialogOwner 253
  028a:  showTextbox "I have. He's mean.\n"
  02b4:  setDialogOwner 5
  02b6:  showTextbox "He runied my research\nwith evil.\n"
  02fc:  playAnimation 253 19
  0300:  delay 15
  0304:  setDialogOwner 253
  0306:  showTextbox "Your research\non SkullGreymon?\n"
  0348:  playAnimation 253 0
  034c:  setDialogOwner 5
  034e:  showTextbox "I was collecting bones and\nputting them together.\nI'll be more careful.\n"
  03e2:  setDialogOwner 253
  03e4:  showTextbox "That Devimon is awful.\n"
  0416:  setDialogOwner 5
  0418:  showTextbox "I know him well.\n"
  043e:  setDialogOwner 253
  0440:  showTextbox "What?!\n"
  0452:  setDialogOwner 5
  0454:  showTextbox "He was always tricky,\nbut never this bad.\n"
  04ac:  showTextbox "Maybe he's being\nbrainwashed by someone.\n"
  0502:  setDialogOwner 253
  0504:  showTextbox "Maybe.\n"
  0516:  setDialogOwner 5
  0518:  showTextbox "He could be part of your\ngroup if he was himself.\n"
  0580:  moveCameraToEntity 253 10
  0584:  waitForEntity 200
