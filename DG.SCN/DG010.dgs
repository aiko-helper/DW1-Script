  finishEncounter(Trigger(296));
}

section(10) {
  speak(Entity(10), "「話をきいてよ、たのむからっ!」<NEWLINE>");
  finishEncounter(Trigger(296));
}

section(6) {
  speak(Entity(6), "「きみには勝てそうだ!」<NEWLINE>");
  finishEncounter(Trigger(283));
}

