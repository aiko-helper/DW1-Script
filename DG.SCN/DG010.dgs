// DG010.SCN
#include "functions.dgs"
#pragma script index=10 start=0xd000 end=0xe000 headerU16=0x20 sentinelOff=0x19
#include "entities.dgs"

section onEnter(254) {
  if (trigger(232)) {
    setObjectsVisibleRange(68, 70, 1);
  } else {
    setRectImpassible(22, 16, 3, 12);
  }
  if (trigger(232) && pstat[1] >= 35) {
    setObjectsVisibleRange(71, 73, 0);
  }
  spawnItemChance(max: 99, chance: 39, item: Item.Digimushroom, x: 37, y: 48);
  spawnItemChance(max: 99, chance: 3, item: Item.BlueApple, x: 38, y: 52);
  return;
}

section(5) {
  speak(Entity(5), "You think you're big stuff!\n");
  finishEncounter(Trigger(286));
}

section(7) {
  speak(Entity(7), "What did I ever do to you!?\n");
  finishEncounter(Trigger(296));
}

section(55) {
  return;
}

section(51) {
  if (trigger(258)) {
    return;
  }
  if (trigger(206) || trigger(211) || trigger(252) || trigger(213)) {
  } else {
    return;
  }
  speak(Entity.System, "<YELLOW>? ? ? <WHITE>\nWait!\n");
  anim(Entity.Player, Animation(16), wait: 20);
  playAnimation(Entity.Player, Animation(0));
  move(entity: Entity.Player, to: (-1050, -1473), sprint: 1);
  move(entity: Entity.Partner, to: (-709, -1473), sprint: 1);
  waitForPair();
  rotate(entity: Entity.Player, to: 2048);
  rotate(entity: Entity.Partner, to: 2048);
  callSubroutine(38);
  playSound(8, 0);
  panTo(x: -836, y: -663, slowdown: 20);
  setObjectVisibility(41, 0);
  moveObjectTo(1, 41, 1, 7, 0, 153, 349);
  delay(12);
  moveObjectTo(1, 41, 1, 7, 0, 184, 381);
  delay(12);
  moveObjectTo(1, 41, 1, 7, 0, 153, 411);
  delay(12);
  moveObjectTo(1, 41, 1, 7, 0, 184, 443);
  delay(12);
  moveObjectTo(1, 41, 1, 7, 0, 153, 475);
  delay(12);
  setDigimon(Digimon.NPCNinjamon, Entity(1), 1);
  setObjectsVisibleRange(42, 67, 0);
  setPStat(PStat(247), 42);
  setPStat(PStat(248), 26);
  callSubroutine(21);
  setObjectVisibility(41, 1);
  playSound(8, 0);
  anim(Entity(6), Animation(28), wait: 10);
  setObjectsVisibleRange(42, 67, 1);
  sfx(8, 1, wait: 10);
  speak(Entity(6), "I'm called Ninjamon!\n");
  anim(Entity.Player, Animation(15), wait: 20);
  look(entity: Entity(6), at: Entity.Player);
  delay(10);
  look(entity: Entity(6), at: Entity.Partner);
  delay(10);
  look(entity: Entity(6), at: Entity.Player);
  showTextbox("You're <LIGHTBLUE><PLAYER><WHITE>?\nAnd you must be <ORANGE><DIGIMON><WHITE>!\n");
  showTextbox("You're famous, even as far\nas Ninja Village.  Accept\nmy challenge to fight.\n");
  setDialogOwner(Entity.Player);
  choice { "Sure" -> L2, "Another time" -> L1 }
  goto L1;

L1:
  speak(Entity(6), "Ha, that's what you think!\n");
  goto L2;

L2:
  setTrigger(Trigger(1));
  setPStat(PStat(250), 1);
  setPStat(PStat(251), 6);
  setPStat(PStat(252), 255);
  setPStat(PStat(253), 255);
  startBattle();
  unsetTrigger(Trigger(1));
  setPStat(PStat(250), 0);
  move(entity: Entity.Partner, to: (-633, -581), sprint: 1);
  move(entity: Entity.Partner, to: (-1033, -481), sprint: 1);
  move(entity: Entity(6), to: (-905, -1096), sprint: 1);
  waitForEntity(Entity(20));
  look(entity: Entity.Player, at: Entity(6));
  look(entity: Entity(6), at: Entity.Player);
  look(entity: Entity.Partner, at: Entity(6));
  waitForEntity(Entity.Player);
  speak(Entity(6), "You're just as strong as\nthey say you are. Please\nmake me your disciple!\n");
  anim(Entity.Player, Animation(19), wait: 20);
  speak(Entity.Player, "Disciple? Well, I don't\ndo that. But you can help us\nmake a city.\n");
  speak(Entity(6), "Okay.\nThat's good training too.\nI'll work hard.\n");
  delay(20);
  anim(Entity(6), Animation(28), wait: 10);
  setObjectsVisibleRange(42, 67, 0);
  setPStat(PStat(247), 42);
  setPStat(PStat(248), 26);
  callSubroutine(21);
  sfx(8, 0, wait: 10);
  unloadEntity(Entity(6));
  delay(40);
  setObjectsVisibleRange(42, 67, 1);
  delay(10);
  playSound(8, 11);
  speak(Entity.System, "Ninjamon joins the city!\n");
  unsetTrigger(Trigger(1));
  followEntity(Entity.Player, speed: 10);
  setTrigger(Trigger(258));
  addPStat(PStat(1), 2);
  return;
}

section(8) {
  speak(Entity(8), "Hey, you!\n");
  showTextbox("What do you mean?\nWhy are you here?\n");
  showTextbox("Hey, <LIGHTBLUE><PLAYER><WHITE>!\n");
  showTextbox("When I tried to make\nmy own harem in the city,\nI was kicked out!\n");
  if (money < 50000) {
    return;
  }
  speak(Entity(8), "I hear you're doing\nreal good these days.\nI'll sell you something good!\n");
  showTextbox("It's the extremely valuable\n<LIGHTBLUE>Golden Banana<WHITE>.\n");
  showTextbox("That'll be fifty thous bits.\nNo loans, please.\n");
  setDialogOwner(Entity.Player);
  choice { "Pay" -> L1, "Don't pay" -> L2 }
  goto L2;

L1:
  reduceMoney(50000);
  giveItem(Item.GoldBanana, 1);
  if (trigger(0)) {
    if (item[Item.GoldBanana] >= 99) {
      speak(Entity(8), "You fool! You have too much!\n");
      addMoney(50000);
      return;
    }
    speak(Entity.Player, "Oops, I have too much!\n");
    inventoryFullBailout();
    giveItem(Item.GoldBanana, 1);
  }
  speak(Entity(8), "Thank you very much!\n");
  return;

L2:
  speak(Entity(8), "Humans should use live money.\n");
  return;
}

