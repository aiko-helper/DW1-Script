// DG010.SCN
#pragma script index=10 start=0xd000 end=0xe000 headerU16=0x20 sentinelOff=0x19

section onEnter(254) {  // len=110
    if (!trigger(232)) goto L1;
    for id in 68..70 { setObjectVisibility(id, 1); }
    goto L2;

L1:
    setRectImpassible(22, 16, 3, 12);

L2:
    if (!trigger(232) || pstat[1] < 35) goto L3;
    for id in 71..73 { setObjectVisibility(id, 0); }

L3:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 39) goto L4;
    spawnItem(Item.Digimushroom, 37, 48);

L4:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 3) goto L5;
    spawnItem(Item.BlueApple, 38, 52);

L5:
    return;
}

section(5) {  // len=76
    setDialogOwner(5);
    showTextbox("You think you're big stuff!\n");
    fadeOutHUD();
    delay(1);
    startBattle();
    setTrigger(286);
    return;
}

section(7) {  // len=76
    setDialogOwner(7);
    showTextbox("What did I ever do to you!?\n");
    fadeOutHUD();
    delay(1);
    startBattle();
    setTrigger(296);
    return;
}

section(55) {  // len=2
    return;
}

section(51) {  // len=1678
    if (!trigger(258)) goto L1;
    return;

L1:
    if (!trigger(206) && !trigger(211) && !trigger(252) && !trigger(213)) goto L2;
    goto L3;

L2:
    return;

L3:
    setDialogOwner(Entity.System);
    showTextbox("<YELLOW>? ? ? <WHITE>\nWait!\n");
    playAnimation(Entity.Player, 16);
    delay(20);
    playAnimation(Entity.Player, 0);
    move(entity: Entity.Player, to: (-1050, -1473), sprint: 1);
    move(entity: Entity.Partner, to: (-709, -1473), sprint: 1);
    waitForEntity(Entity.Player);
    waitForEntity(Entity.Partner);
    rotate(entity: Entity.Player, to: 2048);
    rotate(entity: Entity.Partner, to: 2048);
    callSubroutine(38);
    playSound(8, 0);
    moveCamera(to: (-836, -663), slowdown: 20);
    waitForEntity(200);
    setObjectVisibility(41, 0);
    moveObjectTo(1, 41, 1, 7, 0, 153, 349);
    delay(12);
    moveObjectTo(1, 41, 1, 7, 0, 184, 381);
    delay(12);
    moveObjectTo(1, 41, 1, 7, 0, 153, 411);
    delay(12);
    moveObjectTo(1, 41, 1, 7, 0, 184, 443);
    delay(12);
    moveObjectTo(1, 41, 1, 7, 0, 153, 475);
    delay(12);
    setDigimon(Digimon.NPCNinjamon, 1, 1);
    for id in 42..67 { setObjectVisibility(id, 0); }
    setPStat(247, 42);
    setPStat(248, 26);
    callSubroutine(21);
    setObjectVisibility(41, 1);
    playSound(8, 0);
    playAnimation(6, 28);
    delay(10);
    for id in 42..67 { setObjectVisibility(id, 1); }
    playSound(8, 1);
    delay(10);
    setDialogOwner(6);
    showTextbox("I'm called Ninjamon!\n");
    playAnimation(Entity.Player, 15);
    delay(20);
    look(entity: 6, at: Entity.Player);
    delay(10);
    look(entity: 6, at: Entity.Partner);
    delay(10);
    look(entity: 6, at: Entity.Player);
    showTextbox("You're <LIGHTBLUE><PLAYER><WHITE>?\nAnd you must be <ORANGE><DIGIMON><WHITE>!\n");
    showTextbox("You're famous, even as far\nas Ninja Village.  Accept\nmy challenge to fight.\n");
    setDialogOwner(Entity.Player);
    setSelection(L5, L4);
    showTextbox("Sure\nAnother time\n");
    waitForSelectionChoice();
    goto L4;

L4:
    setDialogOwner(6);
    showTextbox("Ha, that's what you think!\n");
    goto L5;

L5:
    setTrigger(1);
    setPStat(250, 1);
    setPStat(251, 6);
    setPStat(252, 255);
    setPStat(253, 255);
    fadeOutHUD();
    delay(1);
    startBattle();
    unsetTrigger(1);
    setPStat(250, 0);
    move(entity: Entity.Partner, to: (-633, -581), sprint: 1);
    move(entity: Entity.Partner, to: (-1033, -481), sprint: 1);
    move(entity: 6, to: (-905, -1096), sprint: 1);
    waitForEntity(20);
    look(entity: Entity.Player, at: 6);
    look(entity: 6, at: Entity.Player);
    look(entity: Entity.Partner, at: 6);
    waitForEntity(Entity.Player);
    setDialogOwner(6);
    showTextbox("You're just as strong as\nthey say you are. Please\nmake me your disciple!\n");
    playAnimation(Entity.Player, 19);
    delay(20);
    setDialogOwner(Entity.Player);
    showTextbox("Disciple? Well, I don't\ndo that. But you can help us\nmake a city.\n");
    setDialogOwner(6);
    showTextbox("Okay.\nThat's good training too.\nI'll work hard.\n");
    delay(20);
    playAnimation(6, 28);
    delay(10);
    for id in 42..67 { setObjectVisibility(id, 0); }
    setPStat(247, 42);
    setPStat(248, 26);
    callSubroutine(21);
    playSound(8, 0);
    delay(10);
    unloadEntity(6);
    delay(40);
    for id in 42..67 { setObjectVisibility(id, 1); }
    delay(10);
    playSound(8, 11);
    setDialogOwner(Entity.System);
    showTextbox("Ninjamon joins the city!\n");
    unsetTrigger(1);
    moveCamera(to: Entity.Player, speed: 10);
    waitForEntity(200);
    setTrigger(258);
    addPStat(1, 2);
    return;
}

section(8) {  // len=956
    setDialogOwner(8);
    showTextbox("Hey, you!\n");
    showTextbox("What do you mean?\nWhy are you here?\n");
    showTextbox("Hey, <LIGHTBLUE><PLAYER><WHITE>!\n");
    showTextbox("When I tried to make\nmy own harem in the city,\nI was kicked out!\n");
    if (money >= 50000) goto L1;
    return;

L1:
    setDialogOwner(8);
    showTextbox("I hear you're doing\nreal good these days.\nI'll sell you something good!\n");
    showTextbox("It's the extremely valuable\n<LIGHTBLUE>Golden Banana<WHITE>.\n");
    showTextbox("That'll be fifty thous bits.\nNo loans, please.\n");
    setDialogOwner(Entity.Player);
    setSelection(L2, L5);
    showTextbox("Pay\nDon't pay\n");
    waitForSelectionChoice();
    goto L5;

L2:
    reduceMoney(50000);
    giveItem(Item.GoldBanana, 1);
    if (!trigger(0)) goto L4;
    if (item[Item.GoldBanana] < 99) goto L3;
    setDialogOwner(8);
    showTextbox("You fool! You have too much!\n");
    addMoney(50000);
    return;

L3:
    setDialogOwner(Entity.Player);
    showTextbox("Oops, I have too much!\n");
    setTrigger(3);
    callSubroutine(0);
    callSubroutine(13);
    giveItem(Item.GoldBanana, 1);

L4:
    setDialogOwner(8);
    showTextbox("Thank you very much!\n");
    return;

L5:
    setDialogOwner(8);
    showTextbox("Humans should use live money.\n");
    return;
}

