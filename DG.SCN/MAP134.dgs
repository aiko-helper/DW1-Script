// MAP134.SCN
#pragma script index=134 start=0x5e800 end=0x5f000 headerU16=0x1c sentinelOff=0x24

section onEnter(254) {  // len=116
    roll(pstat: 110, max: 99);
    if (pstat[110] > 11) goto L_0016;
    spawnItem(Item.Digimushroom, 59, 50);
L_0016:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 17) goto L_002c;
    spawnItem(Item.Digimushroom, 33, 42);
L_002c:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 2) goto L_0042;
    spawnItem(Item.Happymushroom, 37, 61);
L_0042:
    if (!trigger(319)) goto L_0062;
    setObjectVisibility(24, 1);
    setObjectVisibility(25, 1);
    setObjectVisibility(26, 1);
    setObjectVisibility(27, 1);
    goto L_0072;
L_0062:
    setRectImpassible(32, 39, 9, 8);
    setRectImpassible(35, 34, 8, 8);
L_0072:
    return;
}

section section_5(5) {  // len=46
    setDialogOwner(5);
    showTextbox("Shaka shaka!\n");
    fadeOutHUD();
    delay(1);
    startBattle();
    setTrigger(267);
    return;
}

section section_6(6) {  // len=36
    setDialogOwner(6);
    showTextbox("Shreau!\n");
    fadeOutHUD();
    delay(1);
    startBattle();
    setTrigger(267);
    return;
}

section section_7(7) {  // len=32
    setDialogOwner(7);
    showTextbox("Ribbit!\n");
    fadeOutHUD();
    delay(1);
    startBattle();
    return;
}

section section_8(8) {  // len=118
    setDialogOwner(8);
    showTextbox("If we don't knock them out,\nwe'll get knocked out.\n");
    fadeOutHUD();
    delay(1);
    startBattle();
    return;
}

section section_9(9) {  // len=1672
    setDialogOwner(9);
    showTextbox("Bird brain!\n");
    setDialogOwner(9);
    showTextbox("Numbskull!\n");
    setDialogOwner(9);
    showTextbox("Dimwit!\n");
    setDialogOwner(9);
    showTextbox("Chowder head!\n");
    setDialogOwner(9);
    showTextbox("Dumb, dumb!\n");
    setDialogOwner(9);
    showTextbox("Eau de Geek!\n");
    setDialogOwner(Entity.Player);
    showTextbox("What did you say?!\n");
    setSelection(L_0134, L_02be);
    showTextbox("That gets me mad\nI'll just ignore them\n");
L_0134:
    setTrigger(1);
    setPStat(250, 1);
    setPStat(251, 9);
    setPStat(252, 255);
    setPStat(253, 255);
    fadeOutHUD();
    delay(1);
    startBattle();
    unsetTrigger(1);
    setPStat(250, 0);
    look(entity: Entity.Player, at: 9);
    look(entity: 9, at: Entity.Player);
    look(entity: Entity.Partner, at: 9);
    setDialogOwner(9);
    showTextbox("They aren't nice!\n");
    playAnimation(Entity.Player, 15);
    delay(20);
    setTrigger(309);
    goto L_019e;
L_019e:
    move(entity: 9, to: (-174, -388), sprint: 1);
    if (pstat[101] >= 3) goto L_01c6;
    addPStat(101, 1);
    delay(20);
    look(entity: Entity.Player, at: 9);
    look(entity: Entity.Partner, at: 9);
    goto L_019e;
L_01c6:
    waitForEntity(9);
    unloadEntity(9);
    setPStat(101, 0);
    moveCamera(to: Entity.Player, speed: 10);
    waitForEntity(200);
    setDialogOwner(Entity.Player);
    showTextbox("Wait, what is it?\n");
    loadDigimon(Digimon.Gekomon);
    setDigimon(Digimon.Gekomon, 3, 0);
    setDigimon(Digimon.Gekomon, 5, 0);
    setDigimon(Digimon.Gekomon, 6, 0);
    setDigimon(Digimon.Gekomon, 7, 0);
    delay(40);
    playAnimation(Entity.Player, 24);
    delay(20);
    setDialogOwner(Entity.Player);
    showTextbox("!\n");
    move(entity: 8, to: Entity.Player, sprint: 1);
    move(entity: 10, to: Entity.Player, sprint: 1);
    move(entity: 11, to: Entity.Player, sprint: 1);
    move(entity: 12, to: Entity.Player, sprint: 1);
    delay(40);
    setDialogOwner(8);
    showTextbox("My master is calling me.\nCome with me. Ribbit.\n");
    playAnimation(Entity.Player, 25);
    delay(20);
    setDialogOwner(Entity.Player);
    showTextbox("Oh no!\n");
    warp(to: Map.GKYO02, spawn: 0, trigger: 5);
L_02be:
    playAnimation(Entity.Player, 25);
    delay(20);
    setDialogOwner(Entity.Player);
    showTextbox("Ha ha ha, he's bluffing.\nI won't deal with kids.\n");
    return;
    fadeOutHUD();
    delay(1);
    startBattle();
    return;
