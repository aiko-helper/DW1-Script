// DG031.SCN
#include "functions.dgs"
#pragma script index=31 start=0x1a800 end=0x1b000 headerU16=0x14 sentinelOff=0x19
#include "entities.dgs"

section onEnter(254) {
  if (trigger(353) && pstat[30] >= 3) {
    setTrigger(Trigger(126));
    setObjectVisibility(4, 1);
    move(entity: Entity(5), to: (-1134, -566), animDuration: 3);
    delay(5);
    rotate(entity: Entity(5), to: 3072);
    delay(5);
  }
  if (pstat[30] < 3 && !trigger(238)) {
    playAnimation(Entity(5), Animation(29));
  }
  return;
}

section(52) {
  if (trigger(238)) {
    return;
  }
  look(entity: Entity(5), at: Entity.Player);
  look(entity: Entity.Player, at: Entity(5));
  delay(5);
  if (!trigger(353)) {
    speak(Entity(5), "「おう、もう少しで開通するぜ!」<NEWLINE>");
    rotate(entity: Entity(5), to: 512);
    delay(5);
    playAnimation(Entity(5), Animation(29));
    setTrigger(Trigger(353));
    setPStat(PStat(30), 0);
    move(entity: Entity.Player, to: (-334, -853), sprint: 0);
    waitForEntity(Entity.Player);
    return;
  }
  if (trigger(353) && pstat[30] >= 3) {
    speak(Entity(5), "「いよーぅ、待ってたぜ!ついにトンネルが<NEWLINE> 開通したぜ!」<NEWLINE>");
    speak(Entity.Player, "「これで山をこえなくてすむよ。<NEWLINE> ありがとう。」<NEWLINE>");
    speak(Entity(5), "「いや、礼を言うのはこっちだぜ。俺っちでは<NEWLINE> あの大岩をどうにもできなかったからな。」<NEWLINE>");
    speak(Entity(5), "「しかし…これから俺っちは何をしよう?」<NEWLINE>");
    anim(Entity.Player, Animation(19), wait: 15);
    speak(Entity.Player, "「それなら街へおいでよ。何かやることが<NEWLINE> みつかるはずさ!」<NEWLINE>");
    playAnimation(Entity.Player, Animation(0));
    speak(Entity(5), "「おお、俺っちはまだまだ気力充分よ。<NEWLINE> その話、乗っからしてもらうぜ!」<NEWLINE>");
  } else {
    speak(Entity(5), "「もう少しで開通するからな!」<NEWLINE>");
    rotate(entity: Entity(5), to: 512);
    anim(Entity(5), Animation(29), wait: 5);
    move(entity: Entity.Player, to: (-334, -853), sprint: 0);
    waitForEntity(Entity.Player);
    return;
  }
  approach(who: Entity(5), x: 600, y: 1700, tries: 3, wait: 25);
  playSound(8, 8);
  speak(Entity.System, "ドリモゲモンが街に参加した!!!<NEWLINE>");
  followEntity(Entity.Player, speed: 10);
  setTrigger(Trigger(238));
  addPStat(PStat(1), 2);
  return;
}

section(5) {
  goto section_52;

L1:
  return;
}

section(51) {
  move(entity: Entity.Player, to: (-1996, -2148), sprint: 0);
  warp(to: Map.MIHA04B, spawn: 2, trigger: 255);
  return;
