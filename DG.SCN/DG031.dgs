// DG031.SCN
#pragma script index=31 start=0x1b800 end=0x1c800 headerU16=0x10 sentinelOff=0x1775

function playAnimationThenDelayThenSpeak(a, b) {
    playAnimation(Entity.Player, a);
    delay(20);
    speak(Entity.Player, b);
}

function setPStatThenSetPStatThenSetPStat(a, b, c, d, e) {
    setPStat(a, b);
    setPStat(c, d);
    setPStat(e, 255);
}


section onEnter(254) {  // len=26
    spawnChest(Item.OffenseChip, -582, 1062, 0, 694);
    spawnChest(Item.Medicine, -1129, 1032, 0, 695);
    return;
}

section(51) {  // len=2376
    if (!trigger(230)) goto L1;
    goto L5;

L1:
    setTrigger(230);
    speak(Entity.Player, "!\n");
    look(entity: Entity.Player, at: 5);
    look(entity: Entity.Partner, at: 5);
    moveCamera(to: 5, speed: 20);
    waitForEntity(200);
    speak(5, "What happen to the island?\n");
    showTextbox("Tribes fell apart losing\nmemories and becoming wild.\n");
    showTextbox("I don't know how long\nI can stay sane.\n");
    showTextbox("We can't leave it like this!\nThey must realize the danger!\n");
    playAnimation(5, 28);
    delay(20);
    callSubroutine(34);
    playSound(8, 4);
    delay(20);
    playSound(8, 4);
    delay(20);
    playSound(8, 4);
    delay(10);
    move(entity: Entity.Player, to: (-1210, -193), sprint: 1);
    move(entity: Entity.Partner, to: (-1468, -473), sprint: 1);
    waitForEntity(Entity.Player);
    waitForEntity(Entity.Partner);
    look(entity: Entity.Player, at: 5);
    look(entity: Entity.Partner, at: 5);
    setTrigger(106);
    delay(20);
    playAnimationThenDelayThenSpeak(7, "Stop! Do you want to\nruin the island?!\n");
    delay(20);
    look(entity: 5, at: Entity.Player);
    speak(5, "Who are you? Move out of my\nway! This is the only way!\n");
    setTrigger(1);
    setPStatThenSetPStatThenSetPStat(250, 1, 251, 5, 252);
    setPStat(253, 255);
    startBattle();
    unsetTrigger(1);
    setPStat(250, 0);
    look(entity: Entity.Player, at: 5);
    look(entity: 5, at: Entity.Player);
    look(entity: Entity.Partner, at: 5);
    speak(5, "Are you telling me\nthere's another way?\n");
    playAnimationThenDelayThenSpeak(7, "If the island is ruined,\nit defeats the purpose!\nListen to me.\n");
    speak(5, "What?\n");

L2:
    playAnimationThenDelayThenSpeak(19, "We're building a city for\nthe island by gathering all\nDigimon.\n");
    showTextbox("I heard that we can\nsave the island from this\ndanger by uniting Digimon.\n");
    speak(5, "I think you are right, but\ngathering all the Digimon,\nthat's a big...\n");
    playAnimationThenDelayThenSpeak(7, "We're working on it right\nnow. Nothing is impossible!\n");
    speak(5, "That's a big job!\nBut I'm moved...\nMaybe, you guys can do it.\n");
    playAnimationThenDelayThenSpeak(19, "If you believe in us, I want\nyou to come to the city.\n");
    delay(20);
    speak(5, "Alright. I'll go to the city.\nI guess that's my new path!\n");
    goto L3;

L3:
    move(entity: 5, to: (691, -1990), sprint: 1);
    if (pstat[101] >= 10) goto L4;
    addPStat(101, 1);
    delay(10);
    look(entity: Entity.Player, at: 5);
    look(entity: Entity.Partner, at: 5);
    goto L3;

L4:
    waitForEntity(5);
    unloadEntity(5);
    setPStat(101, 0);
    playSound(8, 8);
    speak(Entity.System, "Meramon joins the city!\n");
    setTrigger(209);
    addPStat(1, 2);
    moveCamera(to: Entity.Player, speed: 10);
    waitForEntity(200);
    return;

L5:
    if (!trigger(209)) goto L6;
    return;

L6:
    moveCamera(to: 5, speed: 20);
    waitForEntity(200);
    speak(5, "I knew you'd come back.\nI need to know the answer!\n");
    look(entity: 5, at: Entity.Player);
    move(entity: Entity.Partner, to: Entity.Player, sprint: 1);
    waitForEntity(Entity.Partner);
    setTrigger(1);
    setPStatThenSetPStatThenSetPStat(250, 1, 251, 5, 252);
    setPStat(253, 255);
    startBattle();
    unsetTrigger(1);
    setPStat(250, 0);
    look(entity: Entity.Player, at: 5);
    look(entity: 5, at: Entity.Player);
    look(entity: Entity.Partner, at: 5);
    speak(5, "I guess, I lose...\n");
    speak(Entity.Player, "There's something\nI need to tell you.\n");
    goto L2;
    return;
}

section(52) {  // len=1678
    move(entity: Entity.Player, to: (1000, -4200), sprint: 0);
    if (!trigger(209)) goto L1;
    warp(to: Map.TUNN07_2, spawn: 1, trigger: 255);

L1:
    warp(to: Map.TUNN07, spawn: 1, trigger: 255);
    return;
