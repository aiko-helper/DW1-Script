// DG099.SCN
#include "functions.dgs"
#pragma script index=99 start=0x44800 end=0x45000 headerU16=0x1c sentinelOff=0x1275

section onEnter(254) {
    spawnChest(Item.OmniDisk, -1698, -3442, 3072, 662);
    spawnChest(Item.Omnipotent, 740, -2753, 0, 663);
    return;
}

section(51) {
    move(entity: Entity.Player, to: (-2446, 1282), sprint: 0);
    warp(to: Map.ICSA02, spawn: 2, trigger: 255);
    return;
}

section(52) {
    warp(to: Map.FRZL05, spawn: 1, trigger: 255);
    return;
}

section(53) {
    warp(to: Map.ICSA04, spawn: 0, trigger: 255);
    return;
}

section(5) {
    speak(5, "This is where we say goodbye.\n");
    startBattle();
    setTrigger(305);
    return;
}

section(6) {
    speak(6, "I don't make mistakes!\n");
    startBattle();
    setTrigger(305);
    return;
