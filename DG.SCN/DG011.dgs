// DG011.SCN
#pragma script index=11 start=0xe000 end=0xe800 headerU16=0x24 sentinelOff=0x19

function speakThenStartBattleThenSetTrigger(a, b, c) {
    speak(a, b);
    startBattle();
    setTrigger(c);
}


section onEnter(254) {  // len=110
    if (!trigger(232)) goto L1;
    for id in 68..70 { setObjectVisibility(id, 1); }
    goto L2;

L1:
    setRectImpassible(22, 16, 3, 12);

L2:
    if (!trigger(232) || pstat[1] < 35) goto L3;
    for id in 71..73 { setObjectVisibility(id, 0); }

L3:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 39) goto L4;
    spawnItem(Item.Digimushroom, x: 37, y: 48);

L4:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 3) goto L5;
    spawnItem(Item.BlueApple, x: 38, y: 52);

L5:
    return;
}

section(5) {  // len=76
    speakThenStartBattleThenSetTrigger(5, "I can beat you in one blow!\n", 283);
    return;
}

section(7) {  // len=70
    speakThenStartBattleThenSetTrigger(7, "You don't know anything.\n", 286);
    return;
}

section(8) {  // len=54
