section onEnter(254) {
  if (trigger(232)) {
    setObjectsVisibleRange(68, 70, 1);
  } else {
    setRectImpassible(22, 16, 3, 12);
  }
  if (trigger(232) && pstat[1] >= 35) {
    setObjectsVisibleRange(71, 73, 0);
  }
  roll(pstat: 110, max: 99);
  if (pstat[110] <= 39) {
    spawnItem(Item.Digimushroom, x: 37, y: 48);
  }
  roll(pstat: 110, max: 99);
  if (pstat[110] <= 3) {
    spawnItem(Item.BlueApple, x: 38, y: 52);
  }
  return;
}

section(5) {
  speak(5, "I can beat you in one blow!\n");
  finishEncounter(283);
}

section(7) {
  speak(7, "You don't know anything.\n");
  finishEncounter(286);
}

section(8) {
  speak(8, "Stop it already!\n");
  finishEncounter(296);
}

section(9) {
  speak(9, "Bullies aren't cool!\n");
  finishEncounter(296);
}

section(10) {
  speak(10, "Listen to me, will you?!\n");
  finishEncounter(296);
}

section(6) {
  speak(6, "I think I can beat you!\n");
  finishEncounter(283);
}

