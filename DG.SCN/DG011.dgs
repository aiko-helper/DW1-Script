// DG011.SCN
#include "functions.dgs"
#pragma script index=11 start=0xd000 end=0xd800 headerU16=0x20 sentinelOff=0x24
#include "entities.dgs"

section onEnter(254) {
  spawnItemChance(max: 99, chance: 9, item: Item.Digimushroom, x: 55, y: 43);
  spawnItemChance(max: 99, chance: 4, item: Item.Digimushroom, x: 68, y: 46);
  return;
}

section(81) {
  {
    speak(Entity.System, " <NEWLINE>       MPスタンド<NEWLINE>");
    rotate(entity: Entity.Player, to: 2048);
    speak(Entity.Player, "「MPを回復できる機械か。」<NEWLINE>");
    setSelection(L1, L2, L3);
    showTextbox("MP100回復        200<B><it><NEWLINE>MP1000回復      1800<B><it><NEWLINE>使用しない<NEWLINE>");
    waitForSelectionChoice();
    break;

L1:
    if (money >= 200) {
      addStats(currentMP: 100);
      reduceMoney(200);
      speak(Entity.System, "MPが回復した!<NEWLINE>");
    } else {
      speak(Entity.Player, "「お金が足りないか。」<NEWLINE>");
      return;
    }
    return;

L2:
    if (money >= 1800) {
      addStats(currentMP: 1000);
      reduceMoney(1800);
      speak(Entity.System, "MPが回復した!<NEWLINE>");
    } else {
      speak(Entity.Player, "「お金が足りないか。」<NEWLINE>");
      return;
    }
    return;

L3:
  }
  speak(Entity.Player, "「やめとこ。」<NEWLINE>");
  return;
}

section(53) {
  if (trigger(185)) {
    return;
  }
  speak(Entity.Player, "「あっ、橋!」<NEWLINE>");
  setTrigger(Trigger(185));
  return;
}

section(5) {
  speak(Entity(5), "「僕と戦うんですか?」<NEWLINE>");
  finishEncounter(Trigger(286));
}

section(6) {
  speak(Entity(6), "「ずいぶんと、なまいきですね。」<NEWLINE>");
  finishEncounter(Trigger(286));
}

section(7) {
  speak(Entity(7), "「な、何をするつもり?」<NEWLINE>");
  finishEncounter(Trigger(296));
}

section(8) {
  speak(Entity(8), "「言いつけてやるからな!」<NEWLINE>");
  finishEncounter(Trigger(296));
