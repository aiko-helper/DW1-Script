    setObjectVisibility(73, 0);
L_0040:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 39) goto L_0056;
    spawnItem(Item.Digimushroom, 37, 48);
L_0056:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 3) goto L_006c;
    spawnItem(Item.BlueApple, 38, 52);
L_006c:
    return;
}

section section_5(5) {  // len=76
    setDialogOwner(5);
    showTextbox("I can beat you in one blow!\n");
    fadeOutHUD();
    delay(1);
    startBattle();
    setTrigger(283);
    return;
}

