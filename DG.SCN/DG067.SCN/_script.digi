; DG067.SCN
;!script index=67 start=0x30800 end=0x31000 headerU16=0x24 sentinelOff=0x24
;!sections onEnter section_5 section_6 section_7 section_8 section_9 section_10 section_51

onEnter:     ; len=90
  0000:  storeRandom 110 99
  0004:  if pstat[110] > 9 then onEnter+0x16
  0010:  spawnItem Digimushroom 40 84
  0016:  storeRandom 110 99
  001a:  if pstat[110] > 5 then onEnter+0x2c
  0026:  spawnItem Digimushroom 68 72
  002c:  storeRandom 110 99
  0030:  if pstat[110] > 17 then onEnter+0x42
  003c:  spawnItem Digimushroom 39 59
  0042:  storeRandom 110 99
  0046:  if pstat[110] > 3 then onEnter+0x58
  0052:  spawnItem SweetNut 67 24
  0058:  endSection
