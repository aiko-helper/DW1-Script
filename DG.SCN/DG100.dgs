// DG100.SCN
#pragma script index=100 start=0x45000 end=0x45800 headerU16=0xc sentinelOff=0xfe

section onEnter(254) {  // len=2
    return;
}

section section_60(60) {  // len=2034
    delay(40);
    moveCamera(to: (0, 1000), slowdown: 20);
    playAnimation(Entity.Player, 15);
    delay(20);
    setDialogOwner(Entity.Player);
    showTextbox("Ugh!\n");
    setDialogOwner(6);
    showTextbox("...\n");
    setDialogOwner(Entity.Player);
    showTextbox("Are you serious?!\n");
    waitForEntity(6);
    unloadEntity(6);
    delay(20);
    setDialogOwner(Entity.Player);
    showTextbox("It's gone, was it a trick?\n");
    playAnimation(5, 28);
    delay(40);
    delay(40);
    setTrigger(1);
    setPStat(250, 1);
    setPStat(251, 5);
    setPStat(252, 255);
    setPStat(253, 255);
    fadeOutHUD();
    delay(1);
    startBattle();
    unsetTrigger(1);
    setPStat(250, 0);
    move(entity: 5, to: (0, 950), sprint: 0);
    waitForEntity(5);
    playAnimation(5, 43);
    delay(40);
    setDialogOwner(Entity.Player);
    showTextbox("I did it somehow.\n");
    look(entity: Entity.Player, at: 5);
    waitForEntity(5);
    waitForEntity(Entity.Player);
    unloadEntity(5);
    setDialogOwner(Entity.Player);
    showTextbox("Huh?\n");
    loadDigimon(Digimon.SnowAgumon);
    setDigimon(Digimon.SnowAgumon, 2, 0);
    setDialogOwner(7);
    showTextbox("What's this?\n");
    look(entity: 7, at: Entity.Player);
    delay(20);
    setDialogOwner(7);
    showTextbox("All of a sudden I passed out\nand... Oh, sorry about that!\n");
    setTrigger(202);
    setPStat(16, 0);
    setTrigger(243);
    setPStat(28, 0);
    goto L_01e0;
L_01e0:
    move(entity: 7, to: (3050, 950), sprint: 1);
    if (pstat[101] >= 3) goto L_0208;
    addPStat(101, 1);
    delay(20);
    look(entity: Entity.Player, at: 7);
    look(entity: Entity.Partner, at: 7);
    goto L_01e0;
L_0208:
    waitForEntity(7);
    unloadEntity(7);
    setPStat(101, 0);
    playAnimation(Entity.Player, 16);
    delay(40);
    setDialogOwner(Entity.Player);
    showTextbox("Huh? What was that?\nthe curse of Analogman?\n");
    delay(20);
    if (!trigger(220) && !trigger(214) && pstat[1] < 50) goto L_0296;
    goto L_02fa;
    goto L_029a;
L_0296:
    goto L_029a;
L_029a:
    if (!trigger(221)) goto L_02ae;
    goto L_02d6;
    goto L_02b2;
L_02ae:
    goto L_02b2;
L_02b2:
    if (!trigger(225)) goto L_02c2;
    warp(to: Map.TWNA04, spawn: 0, trigger: 255);
L_02c2:
    if (!trigger(246)) goto L_02d2;
    warp(to: Map.TWNA03, spawn: 0, trigger: 255);
L_02d2:
    warp(to: Map.TWNA02, spawn: 0, trigger: 255);
L_02d6:
    if (!trigger(225)) goto L_02e6;
    warp(to: Map.TWNA07, spawn: 0, trigger: 255);
L_02e6:
    if (!trigger(246)) goto L_02f6;
    warp(to: Map.TWNA06, spawn: 0, trigger: 255);
L_02f6:
    warp(to: Map.TWNA05, spawn: 0, trigger: 255);
L_02fa:
    if (!trigger(221)) goto L_030e;
    goto L_0336;
    goto L_0312;
L_030e:
    goto L_0312;
L_0312:
    if (!trigger(225)) goto L_0322;
    warp(to: Map.TWNA10, spawn: 0, trigger: 255);
L_0322:
    if (!trigger(246)) goto L_0332;
    warp(to: Map.TWNA09, spawn: 0, trigger: 255);
L_0332:
    warp(to: Map.TWNA08, spawn: 0, trigger: 255);
L_0336:
    if (!trigger(225)) goto L_0346;
    warp(to: Map.TWNA13, spawn: 0, trigger: 255);
L_0346:
    if (!trigger(246)) goto L_0356;
    warp(to: Map.TWNA12, spawn: 0, trigger: 255);
L_0356:
    warp(to: Map.TWNA11, spawn: 0, trigger: 255);
    return;
