// DG100.SCN
#include "functions.dgs"
#pragma script index=100 start=0x42800 end=0x43800 headerU16=0x1c sentinelOff=0xfe
#include "entities.dgs"

section onEnter(254) {
  return;
}

section(5) {
  {
    speak(Entity(5), "「オレ カブテリモンのやつらに<NEWLINE> 勝ちたい。<NEWLINE> どうすれば 勝てる?」<NEWLINE>");
    setDialogOwner(Entity.Player);
    setSelection(L1, L2, L3);
    showTextbox("「んー。強くなるしかない。」<NEWLINE>「実はとっておきの方法が…」<NEWLINE>「がんばれ。」<NEWLINE>");
    waitForSelectionChoice();
    break;

L1:
    speak(Entity(5), "「やっぱり そうか<NEWLINE> オレ しゅぎょう する。」<NEWLINE>");
    return;

L2:
    {
      speak(Entity(5), "「何だ おしえろ。」<NEWLINE>");
      anim(Entity.Player, Animation(19), wait: 15);
      speak(Entity.Player, "「街に来ればいいんだよ。」<NEWLINE>");
      playAnimation(Entity.Player, Animation(0));
      speak(Entity(5), "「…」<NEWLINE>");
      showTextbox("「おまえ しんせつ。 オレ 街行く。」<NEWLINE>");
      break;
    }
    approach(who: Entity(5), x: 664, y: -1963, tries: 3, wait: 20);
    playSound(8, 17);
    speak(Entity.System, "クワガーモンが街に参加した!!!<NEWLINE>");
    setTrigger(Trigger(251));
    addPStat(PStat(1), 2);
    return;

L3:
  }
  speak(Entity(5), "「おまえ ふしんせつ。<NEWLINE> オレ がっかり。」<NEWLINE>");
  return;
}

section(6) {
  if (trigger(346)) {
    speak(Entity(6), "「ん おまえ こん虫武闘大会 <NEWLINE> でたことあるな。」<NEWLINE>");
    showTextbox("「では いいこと 教える。」<NEWLINE>");
    showTextbox("「おまえ 『クネモンのねどこ』<NEWLINE> 知ってるか? 迷わずの森に ある。」<NEWLINE>");
    showTextbox("「こどもの デジモン そこで ねる。<NEWLINE> 起きると クネモン なる。<NEWLINE> ならないこと あるけど 運しだい。」<NEWLINE>");
    return;
  }
  storeDigimonType(PStat(103));
  if (pstat[103] == 19 || pstat[103] == 32 || pstat[103] == 51 || pstat[103] == 60) {
  } else {
    speak(Entity(6), "「おまえ こん虫武闘大会に… ん?<NEWLINE> 今のおまえ でられない。」<NEWLINE>");
    showTextbox("「では いいこと 教える。」<NEWLINE>");
    showTextbox("「おまえ 『クネモンのねどこ』<NEWLINE> 知ってるか? 迷わずの森に ある。」<NEWLINE>");
    showTextbox("「こどもの デジモン そこで ねる。<NEWLINE> 起きると クネモン なる。<NEWLINE> ならないこと あるけど 運しだい。」<NEWLINE>");
    return;
  }
  speak(Entity(6), "「おまえ こん虫武闘大会に 出るか?」<NEWLINE>");
  speak(Entity.Player, "「何それ?」<NEWLINE>");
  speak(Entity(6), "「22の10 までに とうろく しないと<NEWLINE> でられないぞ。」<NEWLINE>");
  speak(Entity.Player, "'???\"\n");
  speak(Entity(6), "「くわしいこと 当日 わかる。」<NEWLINE>");
  speak(Entity(6), "「なんのことやら。」<NEWLINE>");
  return;
}

section(7) {
  speak(Entity(7), "「オレたち トレーニング いっぱいする<NEWLINE> だけど きゅうけい だいじ。」<NEWLINE>");
  showTextbox("「1じかん やすんで いくか?」<NEWLINE>");
  setDialogOwner(Entity.Player);
  setSelection(L1, L2);
  showTextbox("「休んでいく。」<NEWLINE>「休まない。」<NEWLINE>");
  waitForSelectionChoice();
  return;

L1:
  pstat[:SavedTime] = time();
  addMinutesToDate(PStat.SavedTime, 60);
  advanceToDate(PStat.SavedTime);
  addStats(currentHP: 300, currentMP: 300);
  reduceStats(tiredness: 5);
  warp(to: Map.BETL04, spawn: 0, trigger: 255);
  return;

L2:
  return;
}

section(84) {
  rotate(entity: Entity.Player, to: 2048);
  setTextboxOrigin(-162, 0, 2558);
  callSubroutine(39);
  speak(Entity(200), " <NEWLINE><GREEN>   トレーニング・ハンマーマシン<WHITE><NEWLINE>");
  setSelection(L1, L2, L3);
  showTextbox("トレーニング開始<NEWLINE>このトレーニングの説明<NEWLINE>やめる<NEWLINE>");
  waitForSelectionChoice();
  return;

L1:
  setDialogOwner(Entity(200));
  setSelection(L4, L5, L3);
  showTextbox("ノーマルトレーニング<NEWLINE>ボーナストライトレーニング<NEWLINE>やっぱりやめる<NEWLINE>");
  waitForSelectionChoice();
  return;

L2:
  speak(Entity(200), "ハンマーマシンに打たれてきたえます。<NEWLINE>防御力が大きくアップします。<NEWLINE>");
  setSelection(L2, L1, L3);
  showTextbox("もう一度説明<NEWLINE>トレーニング開始<NEWLINE>やめる<NEWLINE>");
  waitForSelectionChoice();
  return;

L3:
  return;

L4:
  fadeOutHUD();
  setPStat(PStat(254), 3);
  setPStat(PStat(246), 0);
  callDigimonSubroutine(214);
  callSubroutine(7);
  return;

L5:
  setTexboxMode(1, 0);
  speak(Entity.System, "       <YELLOW>スロットゲーム<WHITE><NEWLINE> <NEWLINE>   <ORANGE><CIRCLE><WHITE><ボき><ヌン>で3つのスロットを止めて、<NEWLINE>    うまく絵をそろえてください。<NEWLINE>");
  setPStat(PStat(254), 3);
  setPStat(PStat(246), 1);
  callDigimonSubroutine(214);
  callSubroutine(7);
  setTexboxMode(0, 0);
  return;
}

section(85) {
  rotate(entity: Entity.Player, to: 2048);
  setTextboxOrigin(823, 0, 2144);
  callSubroutine(39);
  speak(Entity(200), " <NEWLINE><GREEN>   トレーニング・ランニングベルト<WHITE><NEWLINE>");
  setSelection(L1, L2, L3);
  showTextbox("トレーニング開始<NEWLINE>このトレーニングの説明<NEWLINE>やめる<NEWLINE>");
  waitForSelectionChoice();
  return;

L1:
  setDialogOwner(Entity(200));
  setSelection(L4, L5, L3);
  showTextbox("ノーマルトレーニング<NEWLINE>ボーナストライトレーニング<NEWLINE>やっぱりやめる<NEWLINE>");
  waitForSelectionChoice();
  return;

L2:
  speak(Entity(200), "動くベルトを反対方向へ走ります。<NEWLINE>すばやさが大きくアップします。<NEWLINE>");
  setSelection(L2, L1, L3);
  showTextbox("もう一度説明<NEWLINE>トレーニング開始<NEWLINE>やめる<NEWLINE>");
  waitForSelectionChoice();
  return;

L3:
  return;

L4:
  fadeOutHUD();
  setPStat(PStat(254), 2);
  setPStat(PStat(246), 0);
  callDigimonSubroutine(214);
  callSubroutine(7);
  return;

L5:
  setTexboxMode(1, 0);
  speak(Entity.System, "       <YELLOW>スロットゲーム<WHITE><NEWLINE> <NEWLINE>   <ORANGE><CIRCLE><WHITE><ボき><ヌン>で3つのスロットを止めて、<NEWLINE>    うまく絵をそろえてください。<NEWLINE>");
  setPStat(PStat(254), 2);
  setPStat(PStat(246), 1);
  callDigimonSubroutine(214);
  callSubroutine(7);
  setTexboxMode(0, 0);
  return;
  garbage { 1c 00 fe 00 1c 00 05 00 1e 00 06 00 2a 02 07 00 76 05 54 00 3c 06 55 00 3a 08 ff ff fe 00 1b 05 1a 00 81 75 83 49 83 8c 81 40 83 4a 83 75 83 65 83 8a 83 82 83 93 82 cc 82 e2 82 c2 82 e7 82 c9 0d 00 81 40 8f 9f 82 bf 82 bd 82 a2 81 42 0d 00 81 40 82 c7 82 a4 82 b7 82 ea 82 ce 81 40 8f 9f 82 c4 82 e9 81 48 81 76 0d 00 00 00 1b fd 10 03 cc 00 06 01 f4 01 1a 00 81 75 82 f1 81 5b 81 42 8b ad 82 ad 82 c8 82 e9 82 b5 82 a9 82 c8 82 a2 81 42 81 76 0d 00 81 75 8e c0 82 cd 82 c6 82 c1 82 c4 82 a8 82 ab 82 cc 95 fb 96 40 82 aa 81 63 81 76 0d 00 81 75 82 aa 82 f1 82 ce 82 ea 81 42 81 76 0d 00 00 00 12 00 16 00 f4 01 1b 05 1a 00 81 75 82 e2 82 c1 82 cf 82 e8 81 40 82 bb 82 a4 82 a9 0d 00 81 40 83 49 83 8c 81 40 82 b5 82 e3 82 ac 82 e5 82 a4 81 40 82 b7 82 e9 81 42 81 76 0d 00 00 00 fe 00 1b 05 1a 00 81 75 89 bd 82 be 81 40 82 a8 82 b5 82 a6 82 eb 81 42 81 76 0d 00 00 00 56 00 fd 13 67 00 0f 00 1b fd 1a 00 81 75 8a 58 82 c9 97 88 82 ea 82 ce 82 a2 82 a2 82 f1 82 be 82 e6 81 42 81 76 0d 00 00 00 56 00 fd 00 1b 05 1a 00 81 75 81 63 81 76 0d 00 00 00 1a 00 81 75 82 a8 82 dc 82 a6 81 40 82 b5 82 f1 82 b9 82 c2 81 42 81 40 83 49 83 8c 81 40 8a 58 8d 73 82 ad 81 42 81 76 0d 00 00 00 16 00 8e 01 4e 05 98 02 55 f8 01 00 19 00 0d 00 65 03 18 00 b6 01 19 00 1f 00 65 01 67 00 14 00 4c 00 fd 05 4c 00 fc 05 16 00 8e 01 4a 05 48 05 1e 00 65 00 5a 00 08 11 1b ff 1a 00 83 4e 83 8f 83 4b 81 5b 83 82 83 93 82 aa 8a 58 82 c9 8e 51 89 c1 82 b5 82 bd 81 49 81 49 81 49 0d 00 00 00 1c 00 fb 00 1f 00 01 02 fe 00 1b 05 1a 00 81 75 82 a8 82 dc 82 a6 81 40 82 d3 82 b5 82 f1 82 b9 82 c2 81 42 0d 00 81 40 83 49 83 8c 81 40 82 aa 82 c1 82 a9 82 e8 81 42 81 76 0d 00 00 00 fe 00 19 00 00 00 5a 01 18 00 52 03 19 00 1b 06 1a 00 81 75 82 f1 81 40 82 a8 82 dc 82 a6 81 40 82 b1 82 f1 92 8e 95 90 93 ac 91 e5 89 ef 81 40 0d 00 81 40 82 c5 82 bd 82 b1 82 c6 82 a0 82 e9 82 c8 81 42 81 76 0d 00 00 00 1a 00 81 75 82 c5 82 cd 81 40 82 a2 82 a2 82 b1 82 c6 81 40 8b b3 82 a6 82 e9 81 42 81 76 0d 00 00 00 1a 00 81