// DG100.SCN
#include "functions.dgs"
#pragma script index=100 start=0x45000 end=0x45800 headerU16=0xc sentinelOff=0xfe
#include "entities.dgs"

section onEnter(254) {
  return;
}

section(60) {
  {
    delay(40);
    moveCamera(to: (0, 1000), slowdown: 20);
    anim(Entity.Player, Animation(15), wait: 20);
    speak(Entity.Player, "Ugh!\n");
    speak(Entity(6), "...\n");
    speak(Entity.Player, "Are you serious?!\n");
    waitForEntity(Entity(6));
    unloadEntity(Entity(6));
    delay(20);
    speak(Entity.Player, "It's gone, was it a trick?\n");
    anim(Entity(5), Animation(28), wait: 40);
    delay(40);
    setTrigger(Trigger(1));
    setPStat(PStat(250), 1);
    setPStat(PStat(251), 5);
    setPStat(PStat(252), 255);
    setPStat(PStat(253), 255);
    startBattle();
    unsetTrigger(Trigger(1));
    setPStat(PStat(250), 0);
    move(entity: Entity(5), to: (0, 950), sprint: 0);
    waitForEntity(Entity(5));
    anim(Entity(5), Animation(43), wait: 40);
    speak(Entity.Player, "I did it somehow.\n");
    look(entity: Entity.Player, at: Entity(5));
    waitForEntity(Entity(5));
    waitForEntity(Entity.Player);
    unloadEntity(Entity(5));
    speak(Entity.Player, "Huh?\n");
    loadAndSetDigimon(Digimon.SnowAgumon, Entity(2), 0);
    speak(Entity(7), "What's this?\n");
    look(entity: Entity(7), at: Entity.Player);
    delay(20);
    speak(Entity(7), "All of a sudden I passed out\nand... Oh, sorry about that!\n");
    setTrigger(Trigger(202));
    setPStat(PStat(16), 0);
    setTrigger(Trigger(243));
    setPStat(PStat(28), 0);
    break;
  }
  {
    approach(who: Entity(7), x: 3050, y: 950, tries: 3, wait: 20);
    anim(Entity.Player, Animation(16), wait: 40);
    speak(Entity.Player, "Huh? What was that?\nthe curse of Analogman?\n");
    delay(20);
    if (trigger(220) || trigger(214) || pstat[1] >= 50) goto L2; else break;
  }
  {
    if (trigger(221)) goto L1; else break;
  }
  if (trigger(225)) {
    warp(to: Map.TWNA04, spawn: 0, trigger: 255);
  }
  if (trigger(246)) {
    warp(to: Map.TWNA03, spawn: 0, trigger: 255);
  }
  warp(to: Map.TWNA02, spawn: 0, trigger: 255);

L1:
  if (trigger(225)) {
    warp(to: Map.TWNA07, spawn: 0, trigger: 255);
  }
  if (trigger(246)) {
    warp(to: Map.TWNA06, spawn: 0, trigger: 255);
  }
  {
    warp(to: Map.TWNA05, spawn: 0, trigger: 255);

L2:
    if (trigger(221)) goto L3; else break;
  }
  if (trigger(225)) {
    warp(to: Map.TWNA10, spawn: 0, trigger: 255);
  }
  if (trigger(246)) {
    warp(to: Map.TWNA09, spawn: 0, trigger: 255);
  }
  warp(to: Map.TWNA08, spawn: 0, trigger: 255);

L3:
  if (trigger(225)) {
    warp(to: Map.TWNA13, spawn: 0, trigger: 255);
  }
  if (trigger(246)) {
    warp(to: Map.TWNA12, spawn: 0, trigger: 255);
  }
  warp(to: Map.TWNA11, spawn: 0, trigger: 255);
  return;
  garbage { 0c 00 fe 00 0c 00 3c 00 0e 00 ff ff fe 00 67 00 28 00 4f 14 00 00 e8 03 56 00 fd 0f 67 00 14 00 1b fd 1a 00 82 74 82 87 82 88 81 49 0d 00 00 00 1b 06 1a 00 81 42 81 42 81 42 0d 00 00 00 1b fd 1a 00 82 60 82 92 82 85 81 40 82 99 82 8f 82 95 81 40 82 93 82 85 82 92 82 89 82 8f 82 95 82 93 81 48 81 49 0d 00 00 00 4a 06 48 06 67 00 14 00 1b fd 1a 00 82 68 82 94 81 75 82 93 81 40 82 87 82 8f 82 8e 82 85 81 43 81 40 82 97 82 81 82 93 81 40 82 89 82 94 81 40 82 81 81 40 82 94 82 92 82 89 82 83 82 8b 81 48 0d 00 00 00 56 00 05 1c 67 00 28 00 67 00 28 00 1c 00 01 00 1e 00 fa 01 1e 00 fb 05 1e 00 fc ff 1e 00 fd ff 27 00 67 00 01 00 66 00 1d 00 01 00 1e 00 fa 00 4e 05 00 00 b6 03 00 00 4a 05 56 00 05 2b 67 00 28 00 1b fd 1a 00 82 68 81 40 82 84 82 89 82 84 81 40 82 89 82 94 81 40 82 93 82 8f 82 8d 82 85 82 88 82 8f 82 97 81 42 0d 00 00 00 4c 00 fd 05 4a 05 4a fd 48 05 1b fd 1a 00 82 67 82 95 82 88 81 48 0d 00 00 00 46 47 47 47 02 00 1b 07 1a 00 82 76 82 88 82 81 82 94 81 75 82 93 81 40 82 94 82 88 82 89 82 93 81 48 0d 00 00 00 4c 00 07 fd 67 00 14 00 1b 07 1a 00 82 60 82 8c 82 8c 81 40 82 8f 82 86 81 40 82 81 81 40 82 93 82 95 82 84 82 84 82 85 82 8e 81 40 82 68 81 40 82 90 82 81 82 93 82 93 82 85 82 84 81 40 82 8f 82 95 82 94 0d 00 82 81 82 8e 82 84 81 42 81 42 81 42 81 40 82 6e 82 88 81 43 81 40 82 93 82 8f 82 92 82 92 82 99 81 40 82 81 82 82 82 8f 82 95 82 94 81 40 82 94 82 88 82 81 82 94 81 49 0d 00 00 00 1c 00 ca 00 1e 00 10 00 1c 00 f3 00 1e 00 1c 00 16 00 ee 01 4e 07 ea 0b b6 03 01 00 19 00 0d 00 65 03 18 00 16 02 19 00 1f 00 65 01 67 00 14 00 4c 00 fd 07 4c 00 fc 07 16 00 ee 01 4a 07 48 07 1e 00 65 00 56 00 fd 10 67 00 28 00 1b fd 1a 00 82 67 82 95 82 88 81 48 81 40 82 76 82 88 82 81 82 94 81 40 82 97 82 81 82 93 81 40 82 94 82 88 82 81 82 94 81 48 0d 00 82 94 82 88 82 85 81 40 82 83 82 95 82 92 82 93 82 85 81 40 82 8f 82 86 81 40 82 60 82 8e 82 81 82 8c 82 8f 82 87 82 8d 82 81 82 8e 81 48 0d 00 00 00 67 00 14 00 19 00 00 00 dc 00 40 00 d6 00 4a 00 01 32 18