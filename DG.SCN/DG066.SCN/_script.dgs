// DG066.SCN
#pragma script index=66 start=0x30000 end=0x30800 headerU16=0x1c sentinelOff=0x24
#pragma sections section_0254 section_0005 section_0006 section_0007 section_0008 section_0051

section onEnter(254) {  // len=68
    roll(pstat: 110, max: 99);
    if (pstat[110] > 9) goto L_0016;
    spawnItem(Item.Digimushroom, 65, 67);
L_0016:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 2) goto L_002c;
    spawnItem(Item.Happymushroom, 57, 49);
L_002c:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 0) goto L_0042;
    spawnItem(Item.PowerIce, 32, 88);
L_0042:
    return;
}
