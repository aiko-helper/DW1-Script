; DG066.SCN
;!script index=66 start=0x30000 end=0x30800 headerU16=0x1c sentinelOff=0x24
;!sections onEnter section_5 section_6 section_7 section_8 section_51

onEnter:     ; len=68
  0000:  storeRandom 110 99
  0004:  if pstat[110] > 9 then onEnter+0x16
  0010:  spawnItem Digimushroom 65 67
  0016:  storeRandom 110 99
  001a:  if pstat[110] > 2 then onEnter+0x2c
  0026:  spawnItem Happymushroom 57 49
  002c:  storeRandom 110 99
  0030:  if pstat[110] > 0 then onEnter+0x42
  003c:  spawnItem PowerIce 32 88
  0042:  endSection
