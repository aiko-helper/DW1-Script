; MAP158.SCN
;!script index=158 start=0x6f800 end=0x70000 headerU16=0x20 sentinelOff=0x6925
;!sections onEnter section_5 section_6 section_7 section_8 section_9 section_10

onEnter:     ; len=40
  0000:  storeDate 105
  0002:  if pstat[107] < 7 OR pstat[107] >= 19 then onEnter+0x16
  0012:  jump onEnter+0x26
  0016:  setObjectVisibility 19 0
  001a:  setObjectVisibility 20 0
  001e:  setObjectVisibility 21 0
  0022:  setObjectVisibility 22 0
  0026:  endSection
