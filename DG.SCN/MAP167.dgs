// MAP167.SCN
#include "functions.dgs"
#pragma script index=167 start=0x7b000 end=0x7b800 headerU16=0x18 sentinelOff=0x56
#include "entities.dgs"

section onEnter(254) {
  playAnimation(5, 30);
  return;
}

section(81) {
  look(entity: Entity.Player, at: 5);
  delay(5);
  if (!trigger(89)) {
    setTrigger(89);
    speak(5, "Oh, <LIGHTBLUE><PLAYER><WHITE>and <ORANGE><DIGIMON><WHITE>,\nyou are here.\n");
    showTextbox("I'm a delivery man.\nI deliver anything.\n");
    showTextbox("The only thing you can\ncarry is yourself, right?\n");
    showTextbox("Why don't I carry you guys?\nGreat idea, Huh?\n");
    showTextbox("I'll take you\nanyplace, anytime.\nI'll charge you, of course.\n");
  }
  setPStat(254, 5);
  callSubroutine(10);
  return;
}

section(5) {
  setTrigger(44);
  goto section_81;
  return;
}

section(6) {
  speak(6, "Hey, <LIGHTBLUE><PLAYER><WHITE>.\n");
  speak(6, "Sometimes I return to\nGear Savanna to patrol.\n");
  speak(6, "I heard there are some shops\nalong the beach in Gear\nSavanna. Did you see them?\n");
  return;
}

section(51) {
  move(entity: Entity.Player, to: (2200, -3000), sprint: 0);
  if (!trigger(203)) {
    warp(to: Map.TWNA01, spawn: 4, trigger: 255);
  }
  if (trigger(220) || trigger(214) || pstat[1] >= 50) {
    goto L4;
    goto L1;
  }
  goto L1;

L1:
  if (trigger(221)) {
    goto L3;
    goto L2;
  }
  goto L2;

L2:
  if (trigger(225)) {
    warp(to: Map.TWNA04, spawn: 4, trigger: 255);
  }
  if (trigger(246)) {
    warp(to: Map.TWNA03, spawn: 4, trigger: 255);
  }
  warp(to: Map.TWNA02, spawn: 4, trigger: 255);

L3:
  if (trigger(225)) {
    warp(to: Map.TWNA07, spawn: 4, trigger: 255);
  }
  if (trigger(246)) {
    warp(to: Map.TWNA06, spawn: 4, trigger: 255);
  }
  warp(to: Map.TWNA05, spawn: 4, trigger: 255);

L4:
  if (trigger(221)) {
    goto L6;
    goto L5;
  }
  goto L5;

L5:
  if (trigger(225)) {
    warp(to: Map.TWNA10, spawn: 4, trigger: 255);
  }
  if (trigger(246)) {
    warp(to: Map.TWNA09, spawn: 4, trigger: 255);
  }
  warp(to: Map.TWNA08, spawn: 4, trigger: 255);

L6:
  if (trigger(225)) {
    warp(to: Map.TWNA13, spawn: 4, trigger: 255);
  }
  if (trigger(246)) {
    warp(to: Map.TWNA12, spawn: 4, trigger: 255);
  }
  warp(to: Map.TWNA11, spawn: 4, trigger: 255);
  return;
  garbage { 18 00 fe 00 18 00 51 00 1e 00 05 00 16 02 06 00 20 02 33 00 44 03 ff ff 56 00 05 1e fe 00 4c 00 fd 05 67 00 05 00 19 00 01 00 59 00 18 00 0e 02 19 00 1c 00 59 00 1b 05 1a 00 82 6e 82 88 81 43 81 40 01 06 05 00 01 01 82 81 82 8e 82 84 81 40 01 0a 06 00 01 01 81 43 0d 00 82 99 82 8f 82 95 81 40 82 81 82 92 82 85 81 40 82 88 82 85 82 92 82 85 81 42 0d 00 00 00 1a 00 82 68 81 75 82 8d 81 40 82 81 81 40 82 84 82 85 82 8c 82 89 82 96 82 85 82 92 82 99 81 40 82 8d 82 81 82 8e 81 42 0d 00 82 68 81 40 82 84 82 85 82 8c 82 89 82 96 82 85 82 92 81 40 82 81 82 8e 82 99 82 94 82 88 82 89 82 8e 82 87 81 42 0d 00 00 00 1a 00 82 73 82 88 82 85 81 40 82 8f 82 8e 82 8c 82 99 81 40 82 94 82 88 82 89 82 8e 82 87 81 40 82 99 82 8f 82 95 81 40 82 83 82 81 82 8e 0d 00 82 83 82 81 82 92 82 92 82 99 81 40 82 89 82 93 81 40 82 99 82 8f 82 95 82 92 82 93 82 85 82 8c 82 86 81 43 81 40 82 92 82 89 82 87 82 88 82 94 81 48 0d 00 00 00 1a 00 82 76 82 88 82 99 81 40 82 84 82 8f 82 8e 81 75 82 94 81 40 82 68 81 40 82 83 82 81 82 92 82 92 82 99 81 40 82 99 82 8f 82 95 81 40 82 87 82 95 82 99 82 93 81 48 0d 00 82 66 82 92 82 85 82 81 82 94 81 40 82 89 82 84 82 85 82 81 81 43 81 40 82 67 82 95 82 88 81 48 0d 00 00 00 1a 00 82 68 81 75 82 8c 82 8c 81 40 82 94 82 81 82 8b 82 85 81 40 82 99 82 8f 82 95 0d 00 82 81 82 8e 82 99 82 90 82 8c 82 81 82 83 82 85 81 43 81 40 82 81 82 8e 82 99 82 94 82 89 82 8d 82 85 81 42 0d 00 82 68 81 75 82 8c 82 8c 81 40 82 83 82 88 82 81 82 92 82 87 82 85 81 40 82 99 82 8f 82 95 81 43 81 40 82 8f 82 86 81 40 82 83 82 8f 82 95 82 92 82 93 82 85 81 42 0d 00 00 00 1e 00 fe 05 64 0a fe 00 1c 00 2c 00 16 00 1e 00 fe 00 1b 06 1a 00 82 67 82 85 82 99 81 43 81 40 01 06 05 00 01 01 81 42 0d 00 00 00 1b 06 1a 00 82 72 82 8f 82 8d 82 85 82 94 82 89 82 8d 82 85 82 93 81 40 82 68 81 40 82 92 82 85 82 94 82 95 82 92 82 8e 81 40 82 94 82 8f 0d 00 82 66 82 85 82 81 82 92 81 40 82 72 82 81 82 96 82 81 82 8e 82 8e 82 81 81 40 82 94 82 8f 81 40 82 90 82 81 82 94 82 92 82 8f 82 8c 81