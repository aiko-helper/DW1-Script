// source: extract/DIGIMON/SCN/DG.SCN
// MAP162.SCN, section 5

section section_5(5) {  // len=2410
    if (trigger(210) || pstat[1] < 40 || trigger(224) || !trigger(175)) goto L_00c8;
    if (trigger(250)) goto L_00c8;
    setDialogOwner(5);
    showTextbox("Have you seen\nthe Lake Guardian?\n");
    showTextbox("If not, you should\nwait on the south side.\n");
    return;
L_00c8:
    if (trigger(250) || pstat[1] < 25 || trigger(224) || !trigger(175)) goto L_0170;
    setDialogOwner(5);
    showTextbox("Get up very early and\nwalk in the mist.\nSomething good will happen!\n");
    return;
L_0170:
    if (trigger(224) || !trigger(175)) goto L_0286;
    setDialogOwner(5);
    showTextbox("Did you know there's\na place in the north\ncalled Iceberg Beach?\n");
    showTextbox("Rumor has it that a huge\nDigimon often appears\nat the beach.\n");
    return;
L_0286:
    if (trigger(175) || !trigger(198)) goto L_031a;
    setDialogOwner(5);
    showTextbox("Are the bandits defeated?\nI heard there is a gang\nof bandits.\n");
    return;
L_031a:
    if (trigger(198) || !trigger(103)) goto L_046a;
    setTrigger(197);
    setDialogOwner(5);
    showTextbox("Ever been to Great Canyon?\n");
    showTextbox("Rumor has it that\nthe bandits are there.\n");
    setDialogOwner(Entity.Player);
    showTextbox("Are they bad guys?\n");
    setDialogOwner(5);
    showTextbox("They jump you and rob you.\n");
    setDialogOwner(Entity.Player);
    showTextbox("Let's do something about it.\n");
    return;
L_046a:
    if (pstat[1] < 6) goto L_0528;
    setTrigger(124);
    setDialogOwner(5);
    showTextbox("Ever been to Great Canyon?\n");
    showTextbox("Rumor has it that there is an\nInvisible Bridge there.\n");
    return;
L_0528:
    if (!trigger(50) || trigger(202)) goto L_057c;
    setDialogOwner(5);
    showTextbox("I hear\nMachinedramon is back.\n");
    return;
L_057c:
    if (!trigger(50) || !trigger(202)) goto L_05d0;
    setDialogOwner(5);
    showTextbox("You beat\nMachinedramon again.\n");
    return;
L_05d0:
    setDialogOwner(5);
    showTextbox("I'll explain the city\nsurroundings to you.\n");
    showTextbox("Native Forest\nsurrounds the city.\n");
    showTextbox("The Digimon around there\naren't too strong.\n");
    showTextbox("To the west there's a\nTraining Camp.\n");
    showTextbox("Tropical Jungle is\neast across the river.\n");
    showTextbox("I don't know\nwhat's beyond that.\n");
    showTextbox("To the west there is a\nmountain and lake.\n");
    showTextbox("Go south and there is an ocean.\n");
    showTextbox("There is a high mountain\nto the north.\n");
    showTextbox("This city is the\ncenter of the island.\n");
    showTextbox("I'll check the rumors.\nCome back and find out more.\n");
    return;
}
