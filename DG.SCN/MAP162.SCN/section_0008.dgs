// source: extract/DIGIMON/SCN/DG.SCN
// MAP162.SCN, section 8

section section_8(8) {  // len=556
    if (trigger(84)) goto L_01ac;
    setTrigger(84);
    setDialogOwner(8);
    showTextbox("You came at the right time!\n");
    showTextbox("Look at this sculpture!\nWhat do you think?\n");
    showTextbox("What a masterpiece.\nI amaze myself.\n");
    showTextbox("What do you mean?\nYou're making fun of me!\n");
    showTextbox("What were we talking about?\nWell, whatever.\n");
    return;
L_01ac:
    setDialogOwner(8);
    showTextbox("What image did I have?\nWhen you figure it out,\nlet me know.\n");
    return;
}
