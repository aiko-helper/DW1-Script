// source: extract/DIGIMON/SCN/DG.SCN
// MAP162.SCN, section 83

section section_83(83) {  // len=200
    if (!trigger(76) && trigger(246)) goto L_0012;
    return;
L_0012:
    if (pstat[106] == 14) goto L_0020;
    return;
L_0020:
    setDialogOwner(Entity.Player);
    showTextbox("Oh, this is a...\n");
    giveItem(Item.RainPlant, 1);
    if (!trigger(0)) goto L_0080;
    setDialogOwner(Entity.System);
    showTextbox("Too many Items.\n");
    return;
L_0080:
    setObjectVisibility(72, 1);
    setDialogOwner(Entity.System);
    showTextbox("I got a <LIGHTBLUE>Rain\nPlant Fruit<WHITE>!\n");
    setTrigger(76);
    return;
}
