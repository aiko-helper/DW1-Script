  05d0:  setDialogOwner 5
  05d2:  showTextbox "I'll explain the city\nsurroundings to you.\n"
  062c:  showTextbox "Native Forest\nsurrounds the city.\n"
  0674:  showTextbox "The Digimon around there\naren't too strong.\n"
