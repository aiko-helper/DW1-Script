    speak(Entity.System, "How about one thousand bit\n<LIGHTBLUE>Medicine<WHITE>,\nfor seven hundred bits?\n");
    setPStat(117, 9);
    setDialogOwner(Entity.System);
    choice { "Lower one thous to seven hund" -> L116, "Let me rethink this" -> L_21dc }
    continue;

L100:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 1) goto L101;
    goto L118;

L101:
    goto L128;

L102:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 1) goto L103;
    goto L118;

L103:
    goto L128;

L104:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 1) goto L105;
    goto L118;

L105:
    goto L128;

L106:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 19) goto L107;
    goto L118;

L107:
    goto L128;

L108:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 49) goto L109;
    goto L118;

L109:
    goto L128;

L110:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 79) goto L111;
    goto L118;

L111:
    goto L128;

L112:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 84) goto L113;
    goto L118;

L113:
    goto L128;

L114:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 89) goto L115;
    goto L118;

L115:
    goto L128;

L116:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 94) goto L117;
    goto L118;

L117:
    goto L128;

L118:
    speak(8, "Okay, you got a sale!\n");
    playSound(8, 6);
    delay(10);
    setTextboxSize(12, 3);
    if (pstat[117] != 1) goto L119;
    setPStat(243, 3);
    setPStat(244, 32);
    callSubroutine(31);
    showTextbox("Total Profit: <DISCOUNT>\nProfit:\neight hundred\n");

L119:
    if (pstat[117] != 2) goto L120;
    setPStat(243, 2);
    setPStat(244, 188);
    callSubroutine(31);
    showTextbox("Total Profit: <DISCOUNT>\nProfit:\nseven hundred\n");

L120:
    if (pstat[117] != 3) goto L121;
    setPStat(243, 2);
    setPStat(244, 88);
    callSubroutine(31);
    showTextbox("Total Profit: <DISCOUNT>\nProfit:\nsix hundred\n");

L121:
    if (pstat[117] != 4) goto L122;
    setPStat(243, 1);
    setPStat(244, 244);
    callSubroutine(31);
    showTextbox("Total Profit: <DISCOUNT>\nProfit:\nfive hundred\n");

L122:
    if (pstat[117] != 5) goto L123;
    setPStat(243, 1);
    setPStat(244, 144);
    callSubroutine(31);
    showTextbox("Total Profit: <DISCOUNT>\nProfit:\nfour hundred\n");

L123:
    if (pstat[117] != 6) goto L124;
    setPStat(243, 1);
    setPStat(244, 44);
    callSubroutine(31);
    showTextbox("Total Profit: <DISCOUNT>\nProfit:\nthree hundred\n");

L124:
    if (pstat[117] != 7) goto L125;
    setPStat(243, 0);
    setPStat(244, 200);
    callSubroutine(31);
    showTextbox("Total Profit: <DISCOUNT>\nProfit:\ntwo hundred\n");

L125:
    if (pstat[117] != 8) goto L126;
    setPStat(243, 0);
    setPStat(244, 100);
    callSubroutine(31);
    showTextbox("Total Profit: <DISCOUNT>\nProfit:\none hundred\n");

L126:
    if (pstat[117] != 9) goto L127;
    showTextbox("Total Profit: <DISCOUNT>\nProfit:\nzero\n");

L127:
    goto L40;

L128:
    setPStat(247, 8);
    setPStat(248, 5);
    callSubroutine(28);
    addPStat(119, 1);
    roll(pstat: 110, max: 99);
    if (pstat[110] > 89 || pstat[119] < 3) goto L129;
    goto L45;

L129:
    if (pstat[110] > 59 || pstat[119] != 2) goto L130;
    goto L45;

L130:
    if (pstat[110] > 19 || pstat[119] != 1) goto L131;
    goto L45;

L131:
    goto L132;

L132:
    speak(8, "That's highway robbery!\n");
    speak(Entity.Player, "Okay. well then...\n");
  }
