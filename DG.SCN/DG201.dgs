function setPStatThenCallSubroutineThenSpeakThenSetPStatThenSetDialogOwner(a, b, c) {
    setPStat(248, a);
    callSubroutine(28);
    speak(Entity.System, b);
    setPStat(117, c);
    setDialogOwner(Entity.System);
}

function setPStatThenSetPStatThenCallSubroutineThenShowTextbox(a, b, c) {
    setPStat(243, a);
    setPStat(244, b);
    callSubroutine(31);
    showTextbox(c);
}

function setPStatThenSetPStatThenCallSubroutine() {
    setPStat(247, 8);
    setPStat(248, 5);
    callSubroutine(28);
}


