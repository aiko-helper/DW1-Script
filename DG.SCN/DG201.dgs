    setPStatThenSetPStatThenCallSubroutineThenShowTextbox(1, 244, "Total Profit: <DISCOUNT>\nProfit:\nfive hundred\n");

L125:
    if (pstat[117] != 5) goto L126;
    setPStatThenSetPStatThenCallSubroutineThenShowTextbox(1, 144, "Total Profit: <DISCOUNT>\nProfit:\nfour hundred\n");

L126:
    if (pstat[117] != 6) goto L127;
    setPStatThenSetPStatThenCallSubroutineThenShowTextbox(1, 44, "Total Profit: <DISCOUNT>\nProfit:\nthree hundred\n");

L127:
    if (pstat[117] != 7) goto L128;
    setPStatThenSetPStatThenCallSubroutineThenShowTextbox(0, 200, "Total Profit: <DISCOUNT>\nProfit:\ntwo hundred\n");

L128:
    if (pstat[117] != 8) goto L129;
    setPStatThenSetPStatThenCallSubroutineThenShowTextbox(0, 100, "Total Profit: <DISCOUNT>\nProfit:\none hundred\n");

L129:
    if (pstat[117] != 9) goto L130;
    showTextbox("Total Profit: <DISCOUNT>\nProfit:\nzero\n");

L130:
    goto L41;

L131:
    setPStatThenSetPStatThenCallSubroutine();
    addPStat(119, 1);
    roll(pstat: 110, max: 99);
    if (pstat[110] > 89 || pstat[119] < 3) goto L132;
    goto L46;

L132:
    if (pstat[110] > 59 || pstat[119] != 2) goto L133;
    goto L46;

L133:
    if (pstat[110] > 19 || pstat[119] != 1) goto L134;
    goto L46;

L134:
    goto L135;

L135:
    speak(8, "That's highway robbery!\n");
    speak(Entity.Player, "Okay. well then...\n");
    goto L93;
