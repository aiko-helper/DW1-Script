// MAP179.SCN
#include "functions.dgs"
#pragma script index=179 start=0x83800 end=0x85800 headerU16=0x10 sentinelOff=0xff1b
#include "entities.dgs"

section(5) {
  {
    setDialogOwner(Entity.System);
    setSelection(L4, L8, L21, L1);
    showTextbox("「おみせ1」<NEWLINE>「おみせ2」<NEWLINE>「そのた」<NEWLINE>「名前入力」<NEWLINE>");
    waitForSelectionChoice();
    break;

L1:
    setDialogOwner(Entity.System);
    choice { "'<LIGHTBLUE><PLAYER><WHITE>\"" -> L2, "'<ORANGE><DIGIMON><WHITE>\"" -> L3 }
    break;

L2:
    setPStat(PStat(254), 2);
    callSubroutine(32);
    return;

L3:
    setPStat(PStat(254), 3);
    callSubroutine(32);
    return;

L4:
    setDialogOwner(Entity.Player);
    setSelection(L5, L6, L7);
    showTextbox("「ショップ」<NEWLINE>「マーケット」<NEWLINE>「ポイント」<NEWLINE>");
    waitForSelectionChoice();
    break;

L5:
    for x in [
      Trigger(385), Trigger(396), Trigger(404), Trigger(406),
      Trigger(407), Trigger(416), Trigger(434), Trigger(455),
      Trigger(456), Trigger(458), Trigger(462), Trigger(465),
      Trigger(470), Trigger(473), Trigger(480), Trigger(482),
      Trigger(484), Trigger(485), Trigger(489), Trigger(491),
      Trigger(493), Trigger(401), Trigger(423), Trigger(428),
      Trigger(425), Trigger(449), Trigger(446), Trigger(453),
      Trigger(466), Trigger(457), Trigger(435), Trigger(460),
      Trigger(476), Trigger(490), Trigger(452), Trigger(463),
      Trigger(475), Trigger(481), Trigger(492), Trigger(497),
      Trigger(459), Trigger(464), Trigger(469), Trigger(494),
      Trigger(495), Trigger(477), Trigger(471), Trigger(472),
      Trigger(496), Trigger(468), Trigger(474), Trigger(478),
      Trigger(479), Trigger(487), Trigger(488), Trigger(499),
      Trigger(451), Trigger(454), Trigger(506), Trigger(422),
      Trigger(424), Trigger(417)
    ] {
      setTrigger(x);
    }
    unsetTrigger(Trigger(3));
    setPStat(PStat(254), 7);
    callSubroutine(8);
    break;

L6:
    setTrigger(Trigger(3));
    setPStat(PStat(254), 7);
    callSubroutine(8);
    break;

L7:
    setPStat(PStat(254), 7);
    callSubroutine(1);
    break;

L8:
    setDialogOwner(Entity.Player);
    setSelection(L10, L9, L17);
    showTextbox("「カード」<NEWLINE>「預かり所」<NEWLINE>「その他の店」<NEWLINE>");
    waitForSelectionChoice();
    break;

L9:
    setPStat(PStat(254), 7);
    callSubroutine(11);
    return;

L10:
    setPStat(PStat(254), 7);
    speak(Entity(7), "「今日もイキのいいカードを<NEWLINE> そろえたアルよ」<NEWLINE>");
    callSubroutine(15);
    loop {
      setDialogOwner(Entity.Player);
      setSelection(L11, L15, L_0420);
      showTextbox("「カードを買う」<NEWLINE>「カードを売る」<NEWLINE>「やめる」<NEWLINE>");
      waitForSelectionChoice();
      break;

L11:
      {
        if (money >= 500) {
          setSelection(L12, L14, L16);
          showTextbox("「3枚パック買い」<NEWLINE>「1枚買い」<NEWLINE>「やっぱりやめる」<NEWLINE>");
          waitForSelectionChoice();
          goto L16;
          break;
        }
        setSelection(L14, L16);
        showTextbox("「1枚買い」<NEWLINE>「やっぱりやめる」<NEWLINE>");
        waitForSelectionChoice();
        goto L16;

L12:
      }
      speak(Entity(7), "「パックは500<B><it>よ。<NEWLINE> 何が入っているかは運しだいアル。」<NEWLINE>");
      setDialogOwner(Entity.Player);
      setSelection(L13, L16);
      showTextbox("「買う」<NEWLINE>「やっぱりやめる」<NEWLINE>");
      waitForSelectionChoice();
      goto L16;

L13:
      reduceMoney(500);
      callSubroutine(15);
      speak(Entity(7), "「パックはすぐ開けるよろし。」<NEWLINE>");
      unsetTrigger(Trigger(3));
      unsetTrigger(Trigger(4));
      callSubroutine(14);
      callSubroutine(22);
      goto L16;

L14:
      unsetTrigger(Trigger(3));
      setTrigger(Trigger(4));
      callSubroutine(14);
      callSubroutine(22);
      goto L16;

L15:
      setTrigger(Trigger(3));
      callSubroutine(14);

L16:
      speak(Entity(7), "「まだ用アルか?」<NEWLINE>");
    }
    callSubroutine(16);
    speak(Entity(7), "「またくるアルよ。」<NEWLINE>");
    return;

L17:
    setDialogOwner(Entity.Player);
    setSelection(L18, L19, L20);
    showTextbox("「サウンドテスト」<NEWLINE>「ワープ屋」<NEWLINE>「交換」<NEWLINE>");
    waitForSelectionChoice();
    break;

L18:
    setPStat(PStat(254), 7);
    callSubroutine(9);
    return;

L19:
    setPStat(PStat(254), 7);
    callSubroutine(10);
    return;

L20:
    setPStat(PStat(254), 7);
    setPStat(PStat(249), 2);
    callSubroutine(2);
    return;

L21:
    setDialogOwner(Entity.System);
    setSelection(L27, L28, L22, L29);
    showTextbox("「エントリー」<NEWLINE>「闘技場」<NEWLINE>「いろいろ」<NEWLINE>「ねだん」<NEWLINE>");
    waitForSelectionChoice();
    break;

L22:
    setDialogOwner(Entity.System);
    setSelection(L23, L24, L25, L26);
    showTextbox("「オープニング」<NEWLINE>「エンディング」<NEWLINE>「へんしん」<NEWLINE>「死ぬ(なくなりました)」<NEWLINE>");
    waitForSelectionChoice();
    return;

L23:
    callDigimonSubroutine(5);
    waitForEntity(Entity.System);
    return;

L24:
    callDigimonSubroutine(6);
    waitForEntity(Entity.System);
    return;
    setTrigger(Trigger(3));
    callSubroutine(0);
    if (trigger(3)) {
      speak(Entity.Player, "「なにももってなかった。」<NEWLINE>");
      break;
    }
    if (pstat[254] == 255) {
      speak(Entity(7), "「なにもくれないの?」<NEWLINE>");
    } else {
      callSubroutine(12);
      speak(Entity(7), "「ありがと。」<NEWLINE>");
    }
    break;
    giveItem(Item.SuperSpeedDisk, 1);
    if (trigger(0)) {
      unsetTrigger(Trigger(3));
      callSubroutine(0);
      callSubroutine(13);
      giveItem(Item.SuperSpeedDisk, 1);
    }
    speak(Entity.Player, "「21番を手に入れた。」<NEWLINE>");
    break;

L25:
    storeDigimonType(PStat(200));
    if (pstat[200] == 39) {
      speak(Entity.Player, "「もとにへんしん。」<NEWLINE>");
      copyPStat(PStat(5), PStat(254));
    } else {
      speak(Entity.Player, "「スカモンにへんしん。」<NEWLINE>");
      storeDigimonType(PStat(5));
      setPStat(PStat(254), 39);
    }
    fadeOutHUD();
    callDigimonSubroutine(2);
    waitForEntity(Entity(201));
    speak(Entity.Player, "「かんりょう。」<NEWLINE>");
    break;

L26:
    callSubroutine(47);
  }
  return;

L27:
  if (!trigger(37)) {
    setPStat(PStat(254), 7);
    callSubroutine(18);
  } else {
    speak(Entity(7), "『-<TOURNAMENT>-』にエントリー中<NEWLINE>");
  }
  return;

L28:
  if (!trigger(37)) {
    speak(Entity(7), "「エントリーしてません。」<NEWLINE>");
    return;
  }
  setPStat(PStat(254), 7);
  callSubroutine(6);
  warp(to: Map.TWNB01, spawn: 0, trigger: 255);
  callSubroutine(22);
  return;

L29:
  goto L31;
  loop {
    speak(Entity.Player, "「現在<UNKNOWN2><B><it>」<NEWLINE>");
    setSelection(L31, L32, L30);
    showTextbox("「クリア」<NEWLINE>「足す」<NEWLINE>「おわり」<NEWLINE>");
    waitForSelectionChoice();

L30:
    return;

L31:
    callSubroutine(30);
    continue;

L32:
    setPStat(PStat(243), 19);
    setPStat(PStat(244), 136);
    callSubroutine(31);
  }
}

