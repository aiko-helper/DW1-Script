// MAP217.SCN
#include "functions.dgs"
#pragma script index=217 start=0xa1800 end=0xa2000 headerU16=0x20 sentinelOff=0x1c75
#include "entities.dgs"

section onEnter(254) {
  spawnChest(Item.MPChip, 2108, 375, 1024, 709);
  spawnChest(Item.SpeedChip, 563, 2868, 0, 708);
  spawnChest(Item.DefenseChip, -481, 2868, 0, 710);
  spawnChest(Item.BrainChip, 31, 2868, 0, 711);
  return;
}

section(51) {
  move(entity: Entity.Player, to: (-376, -1201), sprint: 0);
  warp(to: Map.MGEN11, spawn: 1, trigger: 255);
  return;
}

section(52) {
  move(entity: Entity.Player, to: (1221, -413), sprint: 0);
  warp(to: Map.MGEN13, spawn: 0, trigger: 255);
  return;
}

section(5) {
  speak(Entity(5), "「……ヤ…ツ…ザ…キ…」<NEWLINE>");
  finishEncounter(Trigger(290));
}

section(6) {
  speak(Entity(6), "「キル!」<NEWLINE>");
  finishEncounter(Trigger(290));
}

section(7) {
