#include "functions.dgs"
#pragma script index=141 start=0x5c000 end=0x5c800 headerU16=0x30 sentinelOff=0xfe
#include "entities.dgs"

section onEnter(254) {
  return;
}

section(51) {
  move(entity: Entity.Player, to: (-3979, 875), sprint: 0);
  warp(to: Map.FACT02, spawn: 1, trigger: 255);
  return;
}

section(52) {
  move(entity: Entity.Player, to: (3538, -555), sprint: 0);
  warp(to: Map.FACT04, spawn: 1, trigger: 255);
  return;
}

