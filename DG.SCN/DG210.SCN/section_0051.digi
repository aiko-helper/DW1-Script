section_51:     ; len=1332
  0000:  storeDigimonType 103
  0002:  if pstat[103] != 1 AND pstat[103] != 2 AND pstat[103] != 3 AND pstat[103] != 4 then section_51+0x20
  001a:  jumpToScriptSection 221 5
  0020:  if pstat[103] != 15 AND pstat[103] != 16 AND pstat[103] != 17 AND pstat[103] != 18 then section_51+0x3e
  0038:  jumpToScriptSection 221 5
  003e:  if pstat[103] != 29 AND pstat[103] != 30 AND pstat[103] != 31 AND pstat[103] != 32 then section_51+0x5c
  0056:  jumpToScriptSection 221 5
  005c:  if pstat[103] != 43 AND pstat[103] != 44 AND pstat[103] != 45 AND pstat[103] != 46 then section_51+0x7a
  0074:  jumpToScriptSection 221 5
  007a:  if trigger(87) OR trigger(205) OR pstat[1] < 15 then section_51+0x92
  008e:  setTrigger 87
  0092:  if trigger(354) OR pstat[1] < 50 OR !trigger(205) then section_51+0x3a8
  00a6:  setTrigger 354
  00aa:  setDialogOwner 5
  00ac:  showTextbox "I was waiting for you,\n<LIGHTBLUE><PLAYER><WHITE>.\nFinally, this day has come\n"
  011e:  setDialogOwner 253
  0120:  showTextbox "What happened?\n"
  0142:  setDialogOwner 5
  0144:  showTextbox "The entrance to Mt. Infinity\nappeared.\n"
  0196:  setDialogOwner 253
  0198:  showTextbox "What? Really? Where?\n"
  01c6:  setDialogOwner 5
  01c8:  showTextbox "It's beyond the falls\nof the city.\n"
  0212:  setDialogOwner 253
  0214:  showTextbox "Gosh, it's so close!\n"
  0242:  setDialogOwner 5
  0244:  showTextbox "The way I see it, the last\nenemy is on Mt. Infinity.\n"
  02b2:  setDialogOwner 253
  02b4:  showTextbox "So it's the Last Dungeon.\nI'll do it!\n"
  0304:  setDialogOwner 5
  0306:  showTextbox "Good luck! But don't be\nhasty. Don't make a move\nuntil you're fully prepared.\n"
  03a6:  endSection
  03a8:  if !trigger(354) OR trigger(50) OR !trigger(205) then section_51+0x52e
  03bc:  setDialogOwner 5
  03be:  showTextbox "On the other side of the\nwaterfall, in the city, is\nthe entrance to Mt. Infinity.\n"
  0466:  setDialogOwner 5
  0468:  showTextbox "The way I see it, the last\nenemy is on Mt. Infinity.\n"
  04d6:  showTextbox "Go there fully prepared!\n"
  050c:  showTextbox "In any case...\n"
  052e:  jumpToScriptSection 221 5
