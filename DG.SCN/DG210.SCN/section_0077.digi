; source: ./extract/DIGIMON/SCN/DG.SCN
; DG210.SCN, section 77

section_77:     ; len=2748
  0000:  setDialogOwner 5
  0002:  showTextbox "The prosperity rate of\nthe current city is <PROSPERITY>.\n"
  0062:  if pstat[1] > 10 then section_77+0xbc
  006e:  setDialogOwner 5
  0070:  showTextbox "It's far from\nhow it used to look.\n"
  00ba:  endSection
  00bc:  if pstat[1] > 30 then section_77+0x106
  00c8:  setDialogOwner 5
  00ca:  showTextbox "It's finally taking shape.\n"
  0104:  endSection
  0106:  if pstat[1] > 50 then section_77+0x146
  0112:  setDialogOwner 5
  0114:  showTextbox "It's developing well.\n"
  0144:  endSection
  0146:  if pstat[1] > 70 then section_77+0x190
  0152:  setDialogOwner 5
  0154:  showTextbox "It's becoming a fine city.\n"
  018e:  endSection
  0190:  if pstat[1] > 99 then section_77+0x1e8
  019c:  setDialogOwner 5
  019e:  showTextbox "You've done a fine job.\nSplendid!\n"
  01e6:  endSection
  01e8:  if pstat[1] > 100 then section_77+0x338
  01f4:  setDialogOwner 5
  01f6:  showTextbox "There's nothing more I need\nto say. It's fantastic!\n"
  0262:  if stat[21] == 10 OR trigger(216) then section_77+0x338
  0274:  addStats 21 1
  0278:  setDialogOwner 255
  027a:  showTextbox "<YELLOW>Tamer Level\nhas gone up! <WHITE>\n"
  02b6:  setTrigger 216
  02ba:  setTrigger 375
  02be:  playSound 0 7
  02c2:  setDialogOwner 255
  02c4:  showTextbox "<YELLOW>Congratulations!\nHere's a medal\nfor your great work! <WHITE>\n"
  0338:  endSection
