// source: extract/DIGIMON/SCN/DG.SCN
// DG210.SCN, section 51

section section_51(51) {  // len=1332
    storeDigimonType(103);
    if (pstat[103] != 1 && pstat[103] != 2 && pstat[103] != 3 && pstat[103] != 4) goto L_0020;
    jumpToScriptSection(221, 5);
L_0020:
    if (pstat[103] != 15 && pstat[103] != 16 && pstat[103] != 17 && pstat[103] != 18) goto L_003e;
    jumpToScriptSection(221, 5);
L_003e:
    if (pstat[103] != 29 && pstat[103] != 30 && pstat[103] != 31 && pstat[103] != 32) goto L_005c;
    jumpToScriptSection(221, 5);
L_005c:
    if (pstat[103] != 43 && pstat[103] != 44 && pstat[103] != 45 && pstat[103] != 46) goto L_007a;
    jumpToScriptSection(221, 5);
L_007a:
    if (trigger(87) || trigger(205) || pstat[1] < 15) goto L_0092;
    setTrigger(87);
L_0092:
    if (trigger(354) || pstat[1] < 50 || !trigger(205)) goto L_03a8;
    setTrigger(354);
    setDialogOwner(5);
    showTextbox("I was waiting for you,\n<LIGHTBLUE><PLAYER><WHITE>.\nFinally, this day has come\n");
    setDialogOwner(Entity.Player);
    showTextbox("What happened?\n");
    setDialogOwner(5);
    showTextbox("The entrance to Mt. Infinity\nappeared.\n");
    setDialogOwner(Entity.Player);
    showTextbox("What? Really? Where?\n");
    setDialogOwner(5);
    showTextbox("It's beyond the falls\nof the city.\n");
    setDialogOwner(Entity.Player);
    showTextbox("Gosh, it's so close!\n");
    setDialogOwner(5);
    showTextbox("The way I see it, the last\nenemy is on Mt. Infinity.\n");
    setDialogOwner(Entity.Player);
    showTextbox("So it's the Last Dungeon.\nI'll do it!\n");
    setDialogOwner(5);
    showTextbox("Good luck! But don't be\nhasty. Don't make a move\nuntil you're fully prepared.\n");
    return;
L_03a8:
    if (!trigger(354) || trigger(50) || !trigger(205)) goto L_052e;
    setDialogOwner(5);
    showTextbox("On the other side of the\nwaterfall, in the city, is\nthe entrance to Mt. Infinity.\n");
    setDialogOwner(5);
    showTextbox("The way I see it, the last\nenemy is on Mt. Infinity.\n");
    showTextbox("Go there fully prepared!\n");
    showTextbox("In any case...\n");
L_052e:
    jumpToScriptSection(221, 5);
}
