; DG113.SCN
;!script index=113 start=0x51000 end=0x52000 headerU16=0x38 sentinelOff=0x24
;!sections onEnter section_6 section_7 section_8 section_9 section_10 section_11 section_12 section_5 section_54 section_52 section_51 section_53

onEnter:     ; len=90
  0000:  storeRandom 110 99
  0004:  if pstat[110] > 19 then onEnter+0x16
  0010:  spawnItem Digimushroom 37 84
  0016:  storeRandom 110 99
  001a:  if pstat[110] > 16 then onEnter+0x2c
  0026:  spawnItem Digimushroom 33 67
  002c:  storeRandom 110 99
  0030:  if pstat[110] > 12 then onEnter+0x42
  003c:  spawnItem Digimushroom 56 63
  0042:  storeRandom 110 99
  0046:  if pstat[110] > 2 then onEnter+0x58
  0052:  spawnItem Digipine 56 83
  0058:  endSection
