// source: extract/DIGIMON/SCN/DG.SCN
// DG113.SCN, section 51

section section_51(51) {  // len=56
    move(entity: Entity.Player, to: (-2500, -2900), sprint: 0);
    if (!trigger(114) && !trigger(147)) goto L_001c;
    warp(to: Map.MIST02, spawn: 1, trigger: 255);
L_001c:
    roll(pstat: 110, max: 99);
    if (pstat[110] >= 49) goto L_0034;
    warp(to: Map.MIST02, spawn: 1, trigger: 255);
    goto section_53;
L_0034:
    warp(to: Map.MIST07, spawn: 2, trigger: 255);
}
