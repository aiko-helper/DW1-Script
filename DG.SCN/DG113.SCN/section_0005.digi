; source: ./extract/DIGIMON/SCN/DG.SCN
; DG113.SCN, section 5

section_5(5):     ; len=1550
  0000:  playSound 8 11
  0004:  speak 5 "Hey you!\n"
  001c:  setTrigger 1
  0020:  pstat[250] = 1
  0024:  pstat[251] = 5
  0028:  pstat[252] = 255
  002c:  pstat[253] = 255
  0030:  fadeOutHUD
  0032:  delay 1
  0036:  startBattle
  0038:  unsetTrigger 1
  003c:  pstat[250] = 0
  0040:  lookAt 5 Player
  0044:  lookAt Player 5
  0048:  lookAt Partner 5
  004c:  delay 10
  0050:  speak 5 "Hmm, you're something else!\nThat was pretty good for\nso early in the morning.\n"
  00f2:  playAnimation Player 16
  00f6:  delay 20
  00fa:  speak Player "Hey, hey, don't act like it's\nsomebody else's business!\n"
  0170:  speak 5 "I know! I know what you're\ntalking about.\n"
  01ca:  showTextbox "I hear you're working\nhard for the island\nby gathering Digimons.\n"
  0250:  playAnimation Player 19
  0254:  delay 20
  0258:  speak Player "So you know. Well,\nwhy don't you help me.\n"
  02b2:  speak 5 "And, where am I supposed\nto do what?\n"
  0302:  playAnimation Player 7
  0306:  delay 20
  030a:  speak Player "Oh you just don't get it!\nYou're supposed to work\nin the city, remember?!\n"
  03a4:  speak 5 "Well, like they say...\nthe early bird gets the bug.\n"
  0412:  playAnimation Player 7
  0416:  delay 20
  041a:  speak Player "That has nothing to do with\nanything! On top of that,\nit's a worm not a bug!\n"
  04ba:  playAnimation Partner 11
  04be:  delay 5
  04c2:  speak 5 "I'm just joking. Well,\nI'll see you in the city...\n"
  052e:  fadeOutHUD
  0530:  jump section_5+0x534
  0534:  entityWalkTo 5 -330 -2751 1
  053c:  if pstat[101] >= 10 then section_5+0x55c
  0548:  pstat[101] += 1
  054c:  delay 10
  0550:  lookAt Player 5
  0554:  lookAt Partner 5
  0558:  jump section_5+0x534
  055c:  waitForEntity 5
  055e:  unloadEntity 5
  0560:  pstat[101] = 0
  0564:  playSound 8 10
  0568:  speak System "Kokatorimon joins the city!\n"
  05a6:  playAnimation Player 16
  05aa:  delay 20
  05ae:  speak Player "Can we really trust him?\nI wonder...\n"
  05fe:  moveCameraToEntity Player 10
  0602:  waitForEntity 200
  0604:  setTrigger 250
  0608:  pstat[1] += 2
  060c:  endSection
