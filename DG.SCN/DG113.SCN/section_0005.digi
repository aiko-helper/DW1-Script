; source: ./extract/DIGIMON/SCN/DG.SCN
; DG113.SCN, section 5

section_5:     ; len=1550
  0000:  playSound 8 11
  0004:  setDialogOwner 5
  0006:  showTextbox "Hey you!\n"
  001c:  setTrigger 1
  0020:  setPStat 250 1
  0024:  setPStat 251 5
  0028:  setPStat 252 255
  002c:  setPStat 253 255
  0030:  fadeOutHUD
  0032:  delay 1
  0036:  startBattle
  0038:  unsetTrigger 1
  003c:  setPStat 250 0
  0040:  lookAt 5 253
  0044:  lookAt 253 5
  0048:  lookAt 252 5
  004c:  delay 10
  0050:  setDialogOwner 5
  0052:  showTextbox "Hmm, you're something else!\nThat was pretty good for\nso early in the morning.\n"
  00f2:  playAnimation 253 16
  00f6:  delay 20
  00fa:  setDialogOwner 253
  00fc:  showTextbox "Hey, hey, don't act like it's\nsomebody else's business!\n"
  0170:  setDialogOwner 5
  0172:  showTextbox "I know! I know what you're\ntalking about.\n"
  01ca:  showTextbox "I hear you're working\nhard for the island\nby gathering Digimons.\n"
  0250:  playAnimation 253 19
  0254:  delay 20
  0258:  setDialogOwner 253
  025a:  showTextbox "So you know. Well,\nwhy don't you help me.\n"
  02b2:  setDialogOwner 5
  02b4:  showTextbox "And, where am I supposed\nto do what?\n"
  0302:  playAnimation 253 7
  0306:  delay 20
  030a:  setDialogOwner 253
  030c:  showTextbox "Oh you just don't get it!\nYou're supposed to work\nin the city, remember?!\n"
  03a4:  setDialogOwner 5
  03a6:  showTextbox "Well, like they say...\nthe early bird gets the bug.\n"
  0412:  playAnimation 253 7
  0416:  delay 20
  041a:  setDialogOwner 253
  041c:  showTextbox "That has nothing to do with\nanything! On top of that,\nit's a worm not a bug!\n"
  04ba:  playAnimation 252 11
  04be:  delay 5
  04c2:  setDialogOwner 5
  04c4:  showTextbox "I'm just joking. Well,\nI'll see you in the city...\n"
  052e:  fadeOutHUD
  0530:  jump section_5+0x534
  0534:  entityWalkTo 5 -330 -2751 1
  053c:  if pstat[101] >= 10 then section_5+0x55c
  0548:  addPStat 101 1
  054c:  delay 10
  0550:  lookAt 253 5
  0554:  lookAt 252 5
  0558:  jump section_5+0x534
  055c:  waitForEntity 5
  055e:  unloadEntity 5
  0560:  setPStat 101 0
  0564:  playSound 8 10
  0568:  setDialogOwner 255
  056a:  showTextbox "Kokatorimon joins the city!\n"
  05a6:  playAnimation 253 16
  05aa:  delay 20
  05ae:  setDialogOwner 253
  05b0:  showTextbox "Can we really trust him?\nI wonder...\n"
  05fe:  moveCameraToEntity 253 10
  0602:  waitForEntity 200
  0604:  setTrigger 250
  0608:  addPStat 1 2
  060c:  endSection
