; DG114.SCN
;!script index=114 start=0x52000 end=0x52800 headerU16=0x24 sentinelOff=0x24
;!sections onEnter section_5 section_6 section_7 section_8 section_9 section_51 section_52

onEnter:     ; len=68
  0000:  storeRandom 110 99
  0004:  if pstat[110] > 7 then onEnter+0x16
  0010:  spawnItem Digimushroom 55 71
  0016:  storeRandom 110 99
  001a:  if pstat[110] > 15 then onEnter+0x2c
  0026:  spawnItem Digimushroom 45 58
  002c:  storeRandom 110 99
  0030:  if pstat[110] > 4 then onEnter+0x42
  003c:  spawnItem Digimushroom 14 6
  0042:  endSection
