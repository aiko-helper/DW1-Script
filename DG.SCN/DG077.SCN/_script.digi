; DG077.SCN
;!script index=77 start=0x37000 end=0x37800 headerU16=0x20 sentinelOff=0x24
;!sections onEnter section_5 section_6 section_7 section_8 section_9 section_10

onEnter:     ; len=90
  0000:  storeRandom 110 99
  0004:  if pstat[110] > 14 then onEnter+0x16
  0010:  spawnItem 44 30 89
  0016:  storeRandom 110 99
  001a:  if pstat[110] > 8 then onEnter+0x2c
  0026:  spawnItem 44 55 61
  002c:  storeRandom 110 99
  0030:  if pstat[110] > 13 then onEnter+0x42
  003c:  spawnItem 44 26 52
  0042:  storeRandom 110 99
  0046:  if pstat[110] > 2 then onEnter+0x58
  0052:  spawnItem 49 44 17
  0058:  endSection
