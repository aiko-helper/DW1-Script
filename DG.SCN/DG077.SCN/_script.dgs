section onEnter(254) {  // len=90
    roll(pstat: 110, max: 99);
    if (pstat[110] > 14) goto L_0016;
    spawnItem(Item.Digimushroom, 30, 89);
L_0016:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 8) goto L_002c;
    spawnItem(Item.Digimushroom, 55, 61);
L_002c:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 13) goto L_0042;
    spawnItem(Item.Digimushroom, 26, 52);
L_0042:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 2) goto L_0058;
    spawnItem(Item.RedBerry, 44, 17);
L_0058:
