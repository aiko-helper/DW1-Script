  014a:  reduceMoney 50000
  0150:  setInventorySize 10
  0152:  lookAt Partner Player
  0156:  delay 5
  015a:  speak 5 "I invited you here\nto save us.\n"
  019e:  playAnimation 5 0
  01a2:  speak Player "Save you from what?\n"
  01d0:  playAnimation 5 29
  01d4:  delay 5
  01d8:  speak 5 "We are in File City, it's\nthe center of File Island.\n"
  0248:  playAnimation Player 16
  024c:  delay 10
  0250:  speak Player "A city? Here?\n"
  0272:  playAnimation Player 0
  0276:  playAnimation 5 29
  027a:  delay 5
  027e:  speak 5 "Well, it was a city.\nThere used to be all kinds of\nDigimon who lived here.\n"
  031a:  playAnimation 5 0
  031e:  playAnimation 5 29
  0322:  delay 5
  0326:  speak 5 "Digimon started to lose heart\nand moved out of the city.\n"
  039e:  speak Player "What do you mean?\n"
  03c8:  playAnimation 5 0
  03cc:  playAnimation 5 29
  03d0:  delay 5
  03d4:  speak 5 "I'm not sure what caused it.\nDigimon started losing their\nspeaking skills.\n"
  0470:  playAnimation 5 0
  0474:  playAnimation 5 29
  0478:  delay 5
  047c:  speak 5 "Some of them still talk, but\nthey all forgot that they\nlived here.\n"
  0508:  playAnimation 5 0
  050c:  speak Player "That's what you meant\nby losing heart.\n"
  0560:  playAnimation 5 30
  0564:  delay 5
  0568:  speak 5 "It's dangerous if\nwe do nothing.\n"
  05b0:  playAnimation 5 0
  05b4:  speak Player "But why me?\n"
  05d2:  playAnimation 5 29
  05d6:  delay 5
  05da:  speak 5 "You are good at raising\nDigimon, right?\n"
  0630:  playAnimation 5 0
  0634:  speak Player "I'm good at it, alright!\n"
  066c:  playAnimation 5 29
  0670:  delay 5
  0674:  speak 5 "Don't you realize that\nyou're speaking Digimon?\n"
  06da:  playAnimation 5 0
  06de:  speak Player "Huh? No way. I'm speaking\nplain old English.\n"
  073e:  playAnimation 5 29
  0742:  delay 5
  0746:  speak 5 "To us, it sounds like Digimon.\n"
  078a:  playAnimation 5 0
  078e:  playAnimation 6 11
  0792:  playAnimation 7 11
  0796:  delay 5
  079a:  speak 6 "That's right!\n"
  07bc:  playAnimation 6 0
  07c0:  playAnimation 7 0
  07c4:  playAnimation 5 29
  07c8:  delay 5
  07cc:  speak 5 "In this world, your love\nfor Digimon will give\nyou strength.\n"
  084c:  playAnimation 5 0
  0850:  speak Player "Thanks.\n"
  0866:  playAnimation 5 29
  086a:  delay 5
  086e:  speak 5 "That's why I chose you.\nYou can rally all the\nDigimon on the island!\n"
  08fe:  playAnimation 5 0
  0902:  speak Player "What?\n"
  0914:  speak Player "Hmm?\n"
  0924:  speak Player "You can count on me!\n"
  0954:  playAnimation Player 11
  0958:  playAnimation 6 11
  095c:  playAnimation 7 11
  0960:  delay 5
  0964:  speak 6 "Alright!\n"
  097c:  playAnimation 6 0
  0980:  playAnimation 7 0
  0984:  playAnimation 5 31
  0988:  delay 5
  098c:  speak 5 "Thanks, you're our only hope.\n"
  09ce:  playAnimation 5 0
  09d2:  speak Player "Where do I start?\n"
  09fc:  playAnimation 5 29
  0a00:  delay 5
  0a04:  speak 5 "Take <ORANGE><DIGIMON><WHITE> and\nexplore the island.\n"
  0a4c:  playAnimation 5 0
  0a50:  playAnimation 5 29
  0a54:  delay 5
  0a58:  speak 5 "Find the cause of this\ndanger and get Digimon\nto come back.\n"
  0ad6:  playAnimation Player 22
  0ada:  delay 10
  0ade:  playAnimation Player 22
  0ae2:  delay 10
  0ae6:  playAnimation Player 0
  0aea:  delay 2
  0aee:  speak Player "Let's go <ORANGE><DIGIMON><WHITE>!\n"
  0b10:  setRotation Player 0
  0b14:  delay 10
  0b18:  entityWalkTo Player -108 -1728 1
  0b20:  delay 20
  0b24:  entityWalkTo Partner -108 -1728 1
  0b2c:  delay 20
  0b30:  playAnimation 5 0
  0b34:  playAnimation 5 29
  0b38:  delay 5
  0b3c:  speak 5 "Wait, I haven't finished yet.\n"
  0b7e:  playAnimation 5 0
