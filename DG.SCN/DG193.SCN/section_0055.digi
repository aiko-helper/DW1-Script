  014a:  reduceMoney 50000
  0150:  setInventorySize 10
  0152:  lookAt 252 253
  0156:  delay 5
  015a:  setDialogOwner 5
  015c:  showTextbox "I invited you here\nto save us.\n"
  019e:  playAnimation 5 0
  01a2:  setDialogOwner 253
  01a4:  showTextbox "Save you from what?\n"
  01d0:  playAnimation 5 29
  01d4:  delay 5
  01d8:  setDialogOwner 5
  01da:  showTextbox "We are in File City, it's\nthe center of File Island.\n"
  0248:  playAnimation 253 16
  024c:  delay 10
  0250:  setDialogOwner 253
  0252:  showTextbox "A city? Here?\n"
  0272:  playAnimation 253 0
  0276:  playAnimation 5 29
  027a:  delay 5
  027e:  setDialogOwner 5
  0280:  showTextbox "Well, it was a city.\nThere used to be all kinds of\nDigimon who lived here.\n"
  031a:  playAnimation 5 0
  031e:  playAnimation 5 29
  0322:  delay 5
  0326:  setDialogOwner 5
  0328:  showTextbox "Digimon started to lose heart\nand moved out of the city.\n"
  039e:  setDialogOwner 253
  03a0:  showTextbox "What do you mean?\n"
  03c8:  playAnimation 5 0
  03cc:  playAnimation 5 29
  03d0:  delay 5
  03d4:  setDialogOwner 5
  03d6:  showTextbox "I'm not sure what caused it.\nDigimon started losing their\nspeaking skills.\n"
  0470:  playAnimation 5 0
  0474:  playAnimation 5 29
  0478:  delay 5
  047c:  setDialogOwner 5
  047e:  showTextbox "Some of them still talk, but\nthey all forgot that they\nlived here.\n"
  0508:  playAnimation 5 0
  050c:  setDialogOwner 253
  050e:  showTextbox "That's what you meant\nby losing heart.\n"
  0560:  playAnimation 5 30
  0564:  delay 5
  0568:  setDialogOwner 5
  056a:  showTextbox "It's dangerous if\nwe do nothing.\n"
  05b0:  playAnimation 5 0
  05b4:  setDialogOwner 253
  05b6:  showTextbox "But why me?\n"
  05d2:  playAnimation 5 29
  05d6:  delay 5
  05da:  setDialogOwner 5
  05dc:  showTextbox "You are good at raising\nDigimon, right?\n"
  0630:  playAnimation 5 0
  0634:  setDialogOwner 253
  0636:  showTextbox "I'm good at it, alright!\n"
  066c:  playAnimation 5 29
  0670:  delay 5
  0674:  setDialogOwner 5
  0676:  showTextbox "Don't you realize that\nyou're speaking Digimon?\n"
  06da:  playAnimation 5 0
  06de:  setDialogOwner 253
  06e0:  showTextbox "Huh? No way. I'm speaking\nplain old English.\n"
  073e:  playAnimation 5 29
  0742:  delay 5
  0746:  setDialogOwner 5
  0748:  showTextbox "To us, it sounds like Digimon.\n"
  078a:  playAnimation 5 0
  078e:  playAnimation 6 11
  0792:  playAnimation 7 11
  0796:  delay 5
  079a:  setDialogOwner 6
  079c:  showTextbox "That's right!\n"
  07bc:  playAnimation 6 0
  07c0:  playAnimation 7 0
  07c4:  playAnimation 5 29
  07c8:  delay 5
  07cc:  setDialogOwner 5
  07ce:  showTextbox "In this world, your love\nfor Digimon will give\nyou strength.\n"
  084c:  playAnimation 5 0
  0850:  setDialogOwner 253
  0852:  showTextbox "Thanks.\n"
  0866:  playAnimation 5 29
  086a:  delay 5
  086e:  setDialogOwner 5
  0870:  showTextbox "That's why I chose you.\nYou can rally all the\nDigimon on the island!\n"
  08fe:  playAnimation 5 0
  0902:  setDialogOwner 253
  0904:  showTextbox "What?\n"
  0914:  setDialogOwner 253
  0916:  showTextbox "Hmm?\n"
  0924:  setDialogOwner 253
  0926:  showTextbox "You can count on me!\n"
  0954:  playAnimation 253 11
  0958:  playAnimation 6 11
  095c:  playAnimation 7 11
  0960:  delay 5
  0964:  setDialogOwner 6
  0966:  showTextbox "Alright!\n"
  097c:  playAnimation 6 0
  0980:  playAnimation 7 0
  0984:  playAnimation 5 31
  0988:  delay 5
  098c:  setDialogOwner 5
  098e:  showTextbox "Thanks, you're our only hope.\n"
  09ce:  playAnimation 5 0
  09d2:  setDialogOwner 253
  09d4:  showTextbox "Where do I start?\n"
  09fc:  playAnimation 5 29
  0a00:  delay 5
  0a04:  setDialogOwner 5
  0a06:  showTextbox "Take <ORANGE><DIGIMON><WHITE> and\nexplore the island.\n"
  0a4c:  playAnimation 5 0
  0a50:  playAnimation 5 29
  0a54:  delay 5
  0a58:  setDialogOwner 5
  0a5a:  showTextbox "Find the cause of this\ndanger and get Digimon\nto come back.\n"
  0ad6:  playAnimation 253 22
  0ada:  delay 10
  0ade:  playAnimation 253 22
  0ae2:  delay 10
  0ae6:  playAnimation 253 0
  0aea:  delay 2
  0aee:  setDialogOwner 253
  0af0:  showTextbox "Let's go <ORANGE><DIGIMON><WHITE>!\n"
  0b10:  setRotation 253 0
