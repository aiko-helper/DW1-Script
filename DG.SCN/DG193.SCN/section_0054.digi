  037a:  delay 10
  037e:  setDialogOwner Player
  0380:  showTextbox "Hey wait, you're Tokomon.\nThis is a realistic dream.\n"
  03ee:  playAnimation 8 29
  03f2:  delay 5
  03f6:  setDialogOwner 8
  03f8:  showTextbox "<LIGHTBLUE><PLAYER><WHITE>, this isn't\na dream, but it's not\nreal either.\n"
  0462:  playAnimation 8 0
  0466:  lookAt Player 8
  046a:  delay 10
  046e:  setDialogOwner Player
  0470:  showTextbox "What are you talking about?\nWho are you?\n"
  04c6:  playAnimation 8 29
  04ca:  delay 5
  04ce:  setDialogOwner 8
  04d0:  showTextbox "I am Jijimon.\n"
  04f0:  playAnimation 8 0
  04f4:  playAnimation Player 16
  04f8:  setDialogOwner Player
  04fa:  showTextbox "I don't know of any\nDigimon by that name.\n"
  0552:  playAnimation 8 29
  0556:  delay 5
  055a:  setDialogOwner 8
  055c:  showTextbox "There are more Digimon\nthan you know of.\nThis is Digimon World.\n"
  05e0:  playAnimation 8 0
  05e4:  setDialogOwner Player
  05e6:  showTextbox "Digimon World?!\n"
  060a:  setRotation 8 1600
  060e:  delay 5
  0612:  playAnimation 8 29
  0616:  delay 5
  061a:  setDialogOwner 8
  061c:  showTextbox "This world is not a\ndream nor is it real.\nIt's our world.\n"
  0694:  playAnimation 8 0
  0698:  playAnimation Player 16
  069c:  setDialogOwner Player
  069e:  showTextbox "Gee... It looks too real\nto be a dream.\n"
  06f2:  lookAt 8 Player
  06f6:  delay 5
  06fa:  playAnimation 8 29
  06fe:  delay 5
