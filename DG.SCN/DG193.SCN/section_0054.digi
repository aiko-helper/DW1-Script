; source: ./extract/DIGIMON/SCN/DG.SCN
; DG193.SCN, section 54

section_54(54):     ; len=2284
  0000:  moveEntityTo Partner 229 -2733 2
  0008:  setRotation Player 2048
  000c:  lookAt 10 Player
  0010:  delay 5
  0014:  playAnimation Player 18
  0018:  delay 5
  001c:  moveCameraTo 30 200 -2000
  0022:  waitForEntity 200
  0024:  delay 20
  0028:  delay 60
  002c:  playAnimation 8 29
  0030:  delay 5
  0034:  speak 8 "He arrived! It worked!\n"
  0068:  playAnimation 8 0
  006c:  playAnimation 10 11
  0070:  playAnimation 12 11
  0074:  delay 5
  0078:  speak 12 "A human.\nJust like you said, Jiji.\n"
  00c4:  playAnimation 10 0
  00c8:  playAnimation 12 0
  00cc:  speak Player "Mmmm.\n"
  00de:  playAnimation 8 29
  00e2:  delay 5
  00e6:  speak 8 "Shhh, he's getting up.\n"
  011a:  pstat[254] = 253
  011e:  callSubroutine 55
  0120:  playAnimation 8 0
  0124:  speak Player "Huh? Where am I?\n"
  014c:  playAnimation 8 29
  0150:  delay 5
  0154:  speak 8 "Welcome to Digimon World!\n"
  018e:  playAnimation 8 0
  0192:  speak Player "What?\n"
  01a4:  lookAt Player 8
  01a8:  delay 5
  01ac:  playAnimation Player 15
  01b0:  delay 10
  01b4:  speak Player "Yikes!\n"
  01c8:  playAnimation 10 5
  01cc:  delay 5
  01d0:  speak 10 "What's the matter?\n"
  01fc:  playAnimation 10 0
  0200:  playAnimation Player 20
  0204:  speak Player "Who are you guys?\n"
  022e:  playAnimation Player 0
  0232:  lookAt Player 10
  0236:  delay 10
  023a:  lookAt Player 8
  023e:  delay 10
  0242:  playAnimation 8 29
  0246:  delay 5
  024a:  speak 8 "These are Digimon.\n"
  0276:  playAnimation 8 0
  027a:  speak Player "Digi... What?\n"
  029c:  playAnimation 8 29
  02a0:  delay 5
  02a4:  speak 8 "Huh? I thought you knew\nabout Digimon.\n"
  02f8:  playAnimation 8 0
  02fc:  playAnimation Player 16
  0300:  delay 10
  0304:  speak Player "I got it, this is a dream.\n"
  0340:  playAnimation 10 12
  0344:  delay 5
  0348:  speak 10 "It's not a dream.\n"
  0372:  playAnimation 10 0
  0376:  lookAt Player 10
  037a:  delay 10
  037e:  speak Player "Hey wait, you're Tokomon.\nThis is a realistic dream.\n"
  03ee:  playAnimation 8 29
  03f2:  delay 5
  03f6:  speak 8 "<LIGHTBLUE><PLAYER><WHITE>, this isn't\na dream, but it's not\nreal either.\n"
  0462:  playAnimation 8 0
  0466:  lookAt Player 8
  046a:  delay 10
  046e:  speak Player "What are you talking about?\nWho are you?\n"
  04c6:  playAnimation 8 29
  04ca:  delay 5
  04ce:  speak 8 "I am Jijimon.\n"
  04f0:  playAnimation 8 0
  04f4:  playAnimation Player 16
  04f8:  speak Player "I don't know of any\nDigimon by that name.\n"
  0552:  playAnimation 8 29
  0556:  delay 5
  055a:  speak 8 "There are more Digimon\nthan you know of.\nThis is Digimon World.\n"
  05e0:  playAnimation 8 0
  05e4:  speak Player "Digimon World?!\n"
  060a:  setRotation 8 1600
  060e:  delay 5
  0612:  playAnimation 8 29
  0616:  delay 5
  061a:  speak 8 "This world is not a\ndream nor is it real.\nIt's our world.\n"
  0694:  playAnimation 8 0
  0698:  playAnimation Player 16
  069c:  speak Player "Gee... It looks too real\nto be a dream.\n"
  06f2:  lookAt 8 Player
  06f6:  delay 5
  06fa:  playAnimation 8 29
  06fe:  delay 5
  0702:  speak 8 "Look behind you,\nyou'll see what I mean.\n"
  075a:  playAnimation 8 0
  075e:  speak Player "What?\n"
  0770:  setRotation Player 0
  0774:  delay 10
  0778:  playAnimation Player 15
  077c:  lookAt Partner Player
  0780:  delay 20
  0784:  entityWalkTo Partner 229 -2533 0
  078c:  waitForEntity Partner
  078e:  playAnimation Partner 11
  0792:  delay 20
  0796:  playAnimation Player 20
  079a:  speak Player "Is this <ORANGE><DIGIMON><WHITE>?\n"
  07ba:  playAnimation Player 0
  07be:  playAnimation Partner 0
  07c2:  delay 5
  07c6:  speak Player "I remember now! I got sucked\ninto that Digimon key chain.\n"
  0840:  playAnimation 8 29
  0844:  delay 5
  0848:  speak 8 "That's right.\n"
  086a:  playAnimation 8 0
  086e:  lookAt Player 8
  0872:  delay 20
  0876:  speak Player "Why am I here?\n"
  089a:  playAnimation 8 29
  089e:  delay 5
  08a2:  speak 8 "Come to my house,\nI'll explain.\n"
  08e8:  warpTo ROOM08 1 54
