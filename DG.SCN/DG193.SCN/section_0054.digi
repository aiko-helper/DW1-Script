  02a0:  delay 5
  02a4:  setDialogOwner 8
  02a6:  showTextbox "Huh? I thought you knew\nabout Digimon.\n"
  02f8:  playAnimation 8 0
  02fc:  playAnimation Player 16
  0300:  delay 10
  0304:  setDialogOwner Player
  0306:  showTextbox "I got it, this is a dream.\n"
