// source: extract/DIGIMON/SCN/DG.SCN
// DG193.SCN, section 55

section section_55(55) {  // len=3834
    moveCamera(to: (183, 221), slowdown: 20);
    waitForEntity(200);
    delay(20);
    unsetTrigger(55);
    storeDigimonType(103);
    if (pstat[103] != 3) goto L_0042;
    setStats(Stat.Offense, 80);
    setStats(Stat.Defense, 60);
    setStats(Stat.Speed, 70);
    setStats(Stat.Brains, 70);
    setStats(Stat.MaxHP, 800);
    setStats(Stat.MaxMP, 600);
    setStats(Stat.CurrentHP, 800);
    setStats(Stat.CurrentMP, 600);
    goto L_0062;
L_0042:
    setStats(Stat.Offense, 70);
    setStats(Stat.Defense, 80);
    setStats(Stat.Speed, 60);
    setStats(Stat.Brains, 70);
    setStats(Stat.MaxHP, 700);
    setStats(Stat.MaxMP, 700);
    setStats(Stat.CurrentHP, 700);
    setStats(Stat.CurrentMP, 700);
L_0062:
    removeItem(Item.LargeRecovery, 99);
    removeItem(Item.SuperRecovery, 99);
    removeItem(Item.MediumMP, 99);
    removeItem(Item.LargeMP, 99);
    removeItem(Item.Omnipotent, 99);
    removeItem(Item.Restore, 99);
    removeItem(Item.SuperRestore, 99);
    removeItem(Item.SuperOffenseDisk, 99);
    removeItem(Item.SuperDefenseDisk, 99);
    removeItem(Item.SuperSpeedDisk, 99);
    removeItem(Item.BlueApple, 99);
    removeItem(Item.SpinyGreen, 99);
    removeItem(Item.MoldyMeat, 99);
    removeItem(Item.Medicine, 99);
    removeItem(Item.MansionKey, 99);
    removeItem(Item.IceCrystal, 99);
    removeItem(Item.CyberPart, 99);
    removeItem(Item.Unihorn, 99);
    removeItem(Item.Sunglasses, 99);
    removeItem(Item.XBandage, 99);
    removeItem(Item.Fertilizer, 99);
    removeItem(Item.Steak, 99);
    removeItem(Item.Leomonstone, 99);
    removeItem(Item.RainPlant, 99);
    removeItem(Item.PortaPotty, 99);
    removeItem(Item.Autopilot, 99);
    removeItem(Item.IronHoof, 99);
    removeItem(Item.SteelDrill, 99);
    removeItem(Item.TornTatter, 99);
    removeItem(Item.NorthStar, 99);
    removeItem(Item.MetalPart, 99);
    removeItem(Item.FatalBone, 99);
    removeItem(Item.SmallSpear, 99);
    removeItem(Item.SpikeClub, 99);
    removeItem(Item.HairGrower, 99);
    removeItem(Item.MonoStone, 99);
    removeItem(Item.FlamingMane, 99);
    removeItem(Item.Waterbottle, 99);
    removeItem(Item.Rooster, 99);
    removeItem(Item.MystyEgg, 99);
    removeItem(Item.RedRuby, 99);
    removeItem(Item.RedShell, 99);
    removeItem(Item.HornHelmet, 99);
    removeItem(Item.ScissorJaw, 99);
    removeItem(Item.Beetlepearl, 99);
    removeItem(Item.Digiseabass, 99);
    removeItem(Item.ChainMelon, 99);
    removeItem(Item.RayGun, 99);
    removeItem(Item.CoralCharm, 99);
    removeItem(Item.GigaHand, 99);
    removeItem(Item.NobleMane, 99);
    removeItem(Item.MetalBanana, 99);
    removeItem(Item.Rainbowhorn, 99);
    removeItem(Item.KogaLaws, 99);
    removeItem(Item.HardScale, 99);
    removeItem(Item.BlueCrystal, 99);
    removeItem(Item.SilverBall, 99);
    removeItem(Item.MetalArmor, 99);
    reduceMoney(50000);
    setInventorySize(10);
    look(entity: Entity.Partner, at: Entity.Player);
    delay(5);
    setDialogOwner(5);
    showTextbox("I invited you here\nto save us.\n");
    playAnimation(5, 0);
    setDialogOwner(Entity.Player);
    showTextbox("Save you from what?\n");
    playAnimation(5, 29);
    delay(5);
    setDialogOwner(5);
    showTextbox("We are in File City, it's\nthe center of File Island.\n");
    playAnimation(Entity.Player, 16);
    delay(10);
    setDialogOwner(Entity.Player);
    showTextbox("A city? Here?\n");
    playAnimation(Entity.Player, 0);
    playAnimation(5, 29);
    delay(5);
    setDialogOwner(5);
    showTextbox("Well, it was a city.\nThere used to be all kinds of\nDigimon who lived here.\n");
    playAnimation(5, 0);
    playAnimation(5, 29);
    delay(5);
    setDialogOwner(5);
    showTextbox("Digimon started to lose heart\nand moved out of the city.\n");
    setDialogOwner(Entity.Player);
    showTextbox("What do you mean?\n");
    playAnimation(5, 0);
    playAnimation(5, 29);
    delay(5);
    setDialogOwner(5);
    showTextbox("I'm not sure what caused it.\nDigimon started losing their\nspeaking skills.\n");
    playAnimation(5, 0);
    playAnimation(5, 29);
    delay(5);
    setDialogOwner(5);
    showTextbox("Some of them still talk, but\nthey all forgot that they\nlived here.\n");
    playAnimation(5, 0);
    setDialogOwner(Entity.Player);
    showTextbox("That's what you meant\nby losing heart.\n");
    playAnimation(5, 30);
    delay(5);
    setDialogOwner(5);
    showTextbox("It's dangerous if\nwe do nothing.\n");
    playAnimation(5, 0);
    setDialogOwner(Entity.Player);
    showTextbox("But why me?\n");
    playAnimation(5, 29);
    delay(5);
    setDialogOwner(5);
    showTextbox("You are good at raising\nDigimon, right?\n");
    playAnimation(5, 0);
    setDialogOwner(Entity.Player);
    showTextbox("I'm good at it, alright!\n");
    playAnimation(5, 29);
    delay(5);
    setDialogOwner(5);
    showTextbox("Don't you realize that\nyou're speaking Digimon?\n");
    playAnimation(5, 0);
    setDialogOwner(Entity.Player);
    showTextbox("Huh? No way. I'm speaking\nplain old English.\n");
    playAnimation(5, 29);
    delay(5);
    setDialogOwner(5);
    showTextbox("To us, it sounds like Digimon.\n");
    playAnimation(5, 0);
    playAnimation(6, 11);
    playAnimation(7, 11);
    delay(5);
    setDialogOwner(6);
    showTextbox("That's right!\n");
    playAnimation(6, 0);
    playAnimation(7, 0);
    playAnimation(5, 29);
    delay(5);
    setDialogOwner(5);
    showTextbox("In this world, your love\nfor Digimon will give\nyou strength.\n");
    playAnimation(5, 0);
    setDialogOwner(Entity.Player);
    showTextbox("Thanks.\n");
    playAnimation(5, 29);
    delay(5);
    setDialogOwner(5);
    showTextbox("That's why I chose you.\nYou can rally all the\nDigimon on the island!\n");
    playAnimation(5, 0);
    setDialogOwner(Entity.Player);
    showTextbox("What?\n");
    setDialogOwner(Entity.Player);
    showTextbox("Hmm?\n");
    setDialogOwner(Entity.Player);
    showTextbox("You can count on me!\n");
    playAnimation(Entity.Player, 11);
    playAnimation(6, 11);
    playAnimation(7, 11);
    delay(5);
    setDialogOwner(6);
    showTextbox("Alright!\n");
    playAnimation(6, 0);
    playAnimation(7, 0);
    playAnimation(5, 31);
    delay(5);
    setDialogOwner(5);
    showTextbox("Thanks, you're our only hope.\n");
    playAnimation(5, 0);
    setDialogOwner(Entity.Player);
    showTextbox("Where do I start?\n");
    playAnimation(5, 29);
    delay(5);
    setDialogOwner(5);
    showTextbox("Take <ORANGE><DIGIMON><WHITE> and\nexplore the island.\n");
    playAnimation(5, 0);
    playAnimation(5, 29);
    delay(5);
    setDialogOwner(5);
    showTextbox("Find the cause of this\ndanger and get Digimon\nto come back.\n");
    playAnimation(Entity.Player, 22);
    delay(10);
    playAnimation(Entity.Player, 22);
    delay(10);
    playAnimation(Entity.Player, 0);
    delay(2);
    setDialogOwner(Entity.Player);
    showTextbox("Let's go <ORANGE><DIGIMON><WHITE>!\n");
    rotate(entity: Entity.Player, to: 0);
    delay(10);
    move(entity: Entity.Player, to: (-108, -1728), sprint: 1);
    delay(20);
    move(entity: Entity.Partner, to: (-108, -1728), sprint: 1);
    delay(20);
    playAnimation(5, 0);
    playAnimation(5, 29);
    delay(5);
    setDialogOwner(5);
    showTextbox("Wait, I haven't finished yet.\n");
    playAnimation(5, 0);
    warp(to: Map.TWNA01, spawn: 2, trigger: 255);
    return;
    garbage { 10 00 fe 00 10 00 36 00 1a 00 37 00 06 09 ff ff 1e 00 fe 00 64 19 fe 00 fe 00 6c fc e5 00 53 f5 02 00 4d fd 00 08 4c 00 0a fd 67 00 05 00 56 00 fd 12 67 00 05 00 4f 1e c8 00 30 f8 4a c8 67 00 14 00 67 00 3c 00 56 00 08 1d 67 00 05 00 1b 08 1a 00 82 67 82 85 81 40 82 81 82 92 82 92 82 89 82 96 82 85 82 84 81 49 81 40 82 68 82 94 81 40 82 97 82 8f 82 92 82 8b 82 85 82 84 81 49 0d 00 00 00 56 00 08 00 56 00 0a 0b 56 00 0c 0b 67 00 05 00 1b 0c 1a 00 82 60 81 40 82 88 82 95 82 8d 82 81 82 8e 81 42 0d 00 82 69 82 95 82 93 82 94 81 40 82 8c 82 89 82 8b 82 85 81 40 82 99 82 8f 82 95 81 40 82 93 82 81 82 89 82 84 81 43 81 40 82 69 82 89 82 8a 82 89 81 42 0d 00 00 00 56 00 0a 00 56 00 0c 00 1b fd 1a 00 82 6c 82 8d 82 8d 82 8d 81 42 0d 00 00 00 56 00 08 1d 67 00 05 00 1b 08 1a 00 82 72 82 88 82 88 82 88 81 43 81 40 82 88 82 85 81 75 82 93 81 40 82 87 82 85 82 94 82 94 82 89 82 8e 82 87 81 40 82 95 82 90 81 42 0d 00 00 00 1e 00 fe fd 64 37 56 00 08 00 1b fd 1a 00 82 67 82 95 82 88 81 48 81 40 82 76 82 88 82 85 82 92 82 85 81 40 82 81 82 8d 81 40 82 68 81 48 0d 00 00 00 56 00 08 1d 67 00 05 00 1b 08 1a 00 82 76 82 85 82 8c 82 83 82 8f 82 8d 82 85 81 40 82 94 82 8f 81 40 82 63 82 89 82 87 82 89 82 8d 82 8f 82 8e 81 40 82 76 82 8f 82 92 82 8c 82 84 81 49 0d 00 00 00 56 00 08 00 1b fd 1a 00 82 76 82 88 82 81 82 94 81 48 0d 00 00 00 4c 00 fd 08 67 00 05 00 56 00 fd 0f 67 00 0a 00 1b fd 1a 00 82 78 82 89 82 8b 82 85 82 93 81 49 0d 00 00 00 56 00 0a 05 67 00 05 00 1b 0a 1a 00 82 76 82 88 82 81 82 94 81 75 82 93 81 40 82 94 82 88 82 85 81 40 82 8d 82 81 82 94 82 94 82 85 82 92 81 48 0d 00 00 00 56 00 0a 00 56 00 fd 14 1b fd 1a 00 82 76 82 88 82 8f 81 40 82 81 82 92 82 85 81 40 82 99 82 8f 82 95 81 40 82 87 82 95 82 99 82 93 81 48 0d 00 00 00 56 00 fd 00 4c 00 fd 0a 67 00 0a 00 4c 00 fd 08 67 00 0a 00 56 00 08 1d 67 00 05 00 1b 08 1a 00 82 73 82 88 82 85 82 93 82 85 81 40 82 81 82 92 82 85 81 40 82 63 82 89 82 87 82 89 82 8d 82 8f 82 8e 81 42 0d 00 00 00 56 00 08 00 1b fd 