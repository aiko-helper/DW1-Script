// source: extract/DIGIMON/SCN/DG.SCN
// DG193.SCN, section 54

section section_54(54) {  // len=2284
    move(entity: Entity.Partner, to: (229, -2733), animDuration: 2);
    rotate(entity: Entity.Player, to: 2048);
    look(entity: 10, at: Entity.Player);
    delay(5);
    playAnimation(Entity.Player, 18);
    delay(5);
    moveCamera(to: (200, -2000), slowdown: 30);
    waitForEntity(200);
    delay(20);
    delay(60);
    playAnimation(8, 29);
    delay(5);
    setDialogOwner(8);
    showTextbox("He arrived! It worked!\n");
    playAnimation(8, 0);
    playAnimation(10, 11);
    playAnimation(12, 11);
    delay(5);
    setDialogOwner(12);
    showTextbox("A human.\nJust like you said, Jiji.\n");
    playAnimation(10, 0);
    playAnimation(12, 0);
    setDialogOwner(Entity.Player);
    showTextbox("Mmmm.\n");
    playAnimation(8, 29);
    delay(5);
    setDialogOwner(8);
    showTextbox("Shhh, he's getting up.\n");
    setPStat(254, 253);
    callSubroutine(55);
    playAnimation(8, 0);
    setDialogOwner(Entity.Player);
    showTextbox("Huh? Where am I?\n");
    playAnimation(8, 29);
    delay(5);
    setDialogOwner(8);
    showTextbox("Welcome to Digimon World!\n");
    playAnimation(8, 0);
    setDialogOwner(Entity.Player);
    showTextbox("What?\n");
    look(entity: Entity.Player, at: 8);
    delay(5);
    playAnimation(Entity.Player, 15);
    delay(10);
    setDialogOwner(Entity.Player);
    showTextbox("Yikes!\n");
    playAnimation(10, 5);
    delay(5);
    setDialogOwner(10);
    showTextbox("What's the matter?\n");
    playAnimation(10, 0);
    playAnimation(Entity.Player, 20);
    setDialogOwner(Entity.Player);
    showTextbox("Who are you guys?\n");
    playAnimation(Entity.Player, 0);
    look(entity: Entity.Player, at: 10);
    delay(10);
    look(entity: Entity.Player, at: 8);
    delay(10);
    playAnimation(8, 29);
    delay(5);
    setDialogOwner(8);
    showTextbox("These are Digimon.\n");
    playAnimation(8, 0);
    setDialogOwner(Entity.Player);
    showTextbox("Digi... What?\n");
    playAnimation(8, 29);
    delay(5);
    setDialogOwner(8);
    showTextbox("Huh? I thought you knew\nabout Digimon.\n");
    playAnimation(8, 0);
    playAnimation(Entity.Player, 16);
    delay(10);
    setDialogOwner(Entity.Player);
    showTextbox("I got it, this is a dream.\n");
    playAnimation(10, 12);
    delay(5);
    setDialogOwner(10);
    showTextbox("It's not a dream.\n");
    playAnimation(10, 0);
    look(entity: Entity.Player, at: 10);
    delay(10);
    setDialogOwner(Entity.Player);
    showTextbox("Hey wait, you're Tokomon.\nThis is a realistic dream.\n");
    playAnimation(8, 29);
    delay(5);
    setDialogOwner(8);
    showTextbox("<LIGHTBLUE><PLAYER><WHITE>, this isn't\na dream, but it's not\nreal either.\n");
    playAnimation(8, 0);
    look(entity: Entity.Player, at: 8);
    delay(10);
    setDialogOwner(Entity.Player);
    showTextbox("What are you talking about?\nWho are you?\n");
    playAnimation(8, 29);
    delay(5);
    setDialogOwner(8);
    showTextbox("I am Jijimon.\n");
    playAnimation(8, 0);
    playAnimation(Entity.Player, 16);
    setDialogOwner(Entity.Player);
    showTextbox("I don't know of any\nDigimon by that name.\n");
    playAnimation(8, 29);
    delay(5);
    setDialogOwner(8);
    showTextbox("There are more Digimon\nthan you know of.\nThis is Digimon World.\n");
    playAnimation(8, 0);
    setDialogOwner(Entity.Player);
    showTextbox("Digimon World?!\n");
    rotate(entity: 8, to: 1600);
    delay(5);
    playAnimation(8, 29);
    delay(5);
    setDialogOwner(8);
    showTextbox("This world is not a\ndream nor is it real.\nIt's our world.\n");
    playAnimation(8, 0);
    playAnimation(Entity.Player, 16);
    setDialogOwner(Entity.Player);
    showTextbox("Gee... It looks too real\nto be a dream.\n");
    look(entity: 8, at: Entity.Player);
    delay(5);
    playAnimation(8, 29);
    delay(5);
    setDialogOwner(8);
    showTextbox("Look behind you,\nyou'll see what I mean.\n");
    playAnimation(8, 0);
    setDialogOwner(Entity.Player);
    showTextbox("What?\n");
    rotate(entity: Entity.Player, to: 0);
    delay(10);
    playAnimation(Entity.Player, 15);
    look(entity: Entity.Partner, at: Entity.Player);
    delay(20);
    move(entity: Entity.Partner, to: (229, -2533), sprint: 0);
    waitForEntity(Entity.Partner);
    playAnimation(Entity.Partner, 11);
    delay(20);
    playAnimation(Entity.Player, 20);
    setDialogOwner(Entity.Player);
    showTextbox("Is this <ORANGE><DIGIMON><WHITE>?\n");
    playAnimation(Entity.Player, 0);
    playAnimation(Entity.Partner, 0);
    delay(5);
    setDialogOwner(Entity.Player);
    showTextbox("I remember now! I got sucked\ninto that Digimon key chain.\n");
    playAnimation(8, 29);
    delay(5);
    setDialogOwner(8);
    showTextbox("That's right.\n");
    playAnimation(8, 0);
    look(entity: Entity.Player, at: 8);
    delay(20);
    setDialogOwner(Entity.Player);
    showTextbox("Why am I here?\n");
    playAnimation(8, 29);
    delay(5);
    setDialogOwner(8);
    showTextbox("Come to my house,\nI'll explain.\n");
    warp(to: Map.ROOM08, spawn: 1, trigger: 54);
}
