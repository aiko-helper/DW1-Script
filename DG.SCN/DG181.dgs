// DG181.SCN
#include "functions.dgs"
#pragma script index=181 start=0x8b000 end=0x8b800 headerU16=0xc sentinelOff=0x19

section onEnter(254) {
  if (trigger(345)) goto L1;
  playAnimation(5, 28);

L1:
  return;
}

section(51) {
  if (!trigger(345)) goto L1;
  return;

L1:
  speak(Entity.Player, "!\n");
  move(entity: Entity.Player, to: (-835, -37), sprint: 1, withCamera: true);
  move(entity: Entity.Partner, to: (-353, 32), sprint: 1);
  waitForEntity(Entity.Player);
  waitForEntity(Entity.Partner);
  look(entity: Entity.Player, at: 5);
  look(entity: Entity.Partner, at: 5);
  waitForEntity(Entity.Player);
  waitForEntity(Entity.Partner);
  playAnimation(5, 29);
  waitForEntity(5);
  speak(5, "Are you <LIGHTBLUE><PLAYER><WHITE>?\n");
  speak(Entity.Player, "A skelton Digimon?!\n");
  speak(5, "Are you <ORANGE><DIGIMON><WHITE>?\n");
  speak(Entity.Player, "I don't feel life from him,\nbut some evil.\n");
  showTextbox("I wonder if he did\nsomething to Myotismon?!\n");
  playSound(8, 13);
  speak(5, "If you don't tell me...\nI'll attack you!\n");
  setTrigger(1);
  setPStat(250, 1);
  setPStat(251, 5);
  setPStat(252, 255);
  setPStat(253, 255);
  startBattle();
  unsetTrigger(1);
  setPStat(250, 0);
  setTrigger(345);
  speak(5, "I'll attack you!\n");
  playSound(8, 9);
  playAnimation(5, 28);
  delay(60);
  unloadEntity(5);
  rotate(entity: Entity.Player, to: 3072);
  speak(Entity.Player, "I gotta save Myotismon\nas soon as possible!\n");
  moveCamera(to: Entity.Player, speed: 10);
  waitForEntity(200);
  return;
  garbage { 0c 00 fe 00 0c 00 33 00 1e 00 ff ff 19 00 01 00 59 01 18 00 1c 00 19 00 56 00 05 1c fe 00 19 00 00 00 59 01 18 00 2c 00 19 00 fe 00 1b fd 1a 00 81 49 0d 00 00 00 52 fd bd fc db ff 01 00 4e fc 9f fe 20 00 01 00 4a fd 4a fc 4c 00 fd 05 4c 00 fc 05 4a fd 4a fc 56 00 05 1d 4a 05 1b 05 1a 00 82 60 82 92 82 85 81 40 82 99 82 8f 82 95 81 40 01 06 05 00 01 01 81 48 0d 00 00 00 1b fd 1a 00 82 60 81 40 82 93 82 8b 82 85 82 8c 82 94 82 8f 82 8e 81 40 82 63 82 89 82 87 82 89 82 8d 82 8f 82 8e 81 48 81 49 0d 00 00 00 1b 05 1a 00 82 60 82 92 82 85 81 40 82 99 82 8f 82 95 81 40 01 0a 06 00 01 01 81 48 0d 00 00 00 1b fd 1a 00 82 68 81 40 82 84 82 8f 82 8e 81 75 82 94 81 40 82 86 82 85 82 85 82 8c 81 40 82 8c 82 89 82 86 82 85 81 40 82 86 82 92 82 8f 82 8d 81 40 82 88 82 89 82 8d 81 43 0d 00 82 82 82 95 82 94 81 40 82 93 82 8f 82 8d 82 85 81 40 82 85 82 96 82 89 82 8c 81 42 0d 00 00 00 1a 00 82 68 81 40 82 97 82 8f 82 8e 82 84 82 85 82 92 81 40 82 89 82 86 81 40 82 88 82 85 81 40 82 84 82 89 82 84 0d 00 82 93 82 8f 82 8d 82 85 82 94 82 88 82 89 82 8e 82 87 81 40 82 94 82 8f 81 40 82 6c 82 99 82 8f 82 94 82 89 82 93 82 8d 82 8f 82 8e 81 48 81 49 0d 00 00 00 5a 00 08 0d 1b 05 1a 00 82 68 82 86 81 40 82 99 82 8f 82 95 81 40 82 84 82 8f 82 8e 81 75 82 94 81 40 82 94 82 85 82 8c 82 8c 81 40 82 8d 82 85 81 42 81 42 81 42 0d 00 82 68 81 75 82 8c 82 8c 81 40 82 81 82 94 82 94 82 81 82 83 82 8b 81 40 82 99 82 8f 82 95 81 49 0d 00 00 00 1c 00 01 00 1e 00 fa 01 1e 00 fb 05 1e 00 fc ff 1e 00 fd ff 27 00 67 00 01 00 66 00 1d 00 01 00 1e 00 fa 00 1c 00 59 01 1b 05 1a 00 82 68 81 75 82 8c 82 8c 81 40 82 81 82 94 82 94 82 81 82 83 82 8b 81 40 82 99 82 8f 82 95 81 49 0d 00 00 00 5a 00 08 09 56 00 05 1c 67 00 3c 00 48 05 4d fd 00 0c 1b fd 1a 00 82 68 81 40 82 87 82 8f 82 94 82 94 82 81 81 40 82 93 82 81 82 96 82 85 81 40 82 6c 82 99 82 8f 82 94 82 89 82 93 82 8d 82 8f 82 8e 0d 00 82 81 82 93 81 40 82 93 82 8f 82 8f 82 8e 81 40 82 81 82 93 81 40 82 90 82 8f 82 93 82 93 82 89 82 82 82 8c 82