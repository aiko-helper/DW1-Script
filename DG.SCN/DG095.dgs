// DG095.SCN
#include "functions.dgs"
#pragma script index=95 start=0x42800 end=0x43000 headerU16=0x14 sentinelOff=0xfe
#include "entities.dgs"

section onEnter(254) {
  return;
}

section(51) {
  move(entity: Entity.Player, to: (969, -3260), sprint: 0);
  warp(to: Map.ICSA02, spawn: 1, trigger: 255);
  return;
}

section(81) {
  rotate(entity: Entity.Player, to: 2048);
  setTextboxOrigin(-11, 0, 1049);
  callSubroutine(39);
  speak(200, "<GREEN>Training: Moving Ice <WHITE>\n");
  choice { "Begin" -> L1, "Explain" -> L2, "Quit" -> L3 }
  return;

L1:
  choice { "Normal" -> L4, "Bonus Try" -> L5, "Quit" -> L3 }
  return;

L2:
  showTextbox("Pushing ice develops strength.\n");
  showTextbox("Max HP is greatly boosted.\nDefensive power is\nboosted, too.\n");
  choice { "Explain again" -> L2, "Begin" -> L1, "Quit" -> L3 }
  return;

L3:
  return;

L4:
  fadeOutHUD();
  setPStatThenSetPStatThenCallDigimonSubroutineThenCallSubroutine(0, 0);
  return;

L5:
  setTexboxMode(1, 0);
  speak(Entity.System, "<YELLOW>Slot game <WHITE>\nUse <LIGHTBLUE><X> <WHITE>to match\nthree pictures.\n");
  setPStatThenSetPStatThenCallDigimonSubroutineThenCallSubroutine(0, 1);
  setTexboxMode(0, 0);
  return;
}

section(84) {
  rotate(entity: Entity.Player, to: 2048);
  setTextboxOrigin(1574, 0, 116);
  callSubroutine(39);
  speak(200, "<GREEN>Training: Icicle Fall <WHITE>\n");
  choice { "Begin" -> L1, "Explain" -> L2, "Quit" -> L3 }
  return;

L1:
  setDialogOwner(200);
  choice { "Normal" -> L4, "Bonus Try" -> L5, "Quit" -> L3 }
  return;

L2:
  speak(200, "Train in catching\na big icicle.\n");
  showTextbox("Defensive Power is\ngreatly boosted.\nSpeed will also increase.\n");
  choice { "Explain again" -> L2, "Begin" -> L1, "Quit" -> L3 }
  return;

L3:
  return;

L4:
  fadeOutHUD();
  setPStatThenSetPStatThenCallDigimonSubroutineThenCallSubroutine(3, 0);
  return;

L5:
  setTexboxMode(1, 0);
  speak(Entity.System, "<YELLOW>Slot game <WHITE>\nUse <LIGHTBLUE><X> <WHITE>to\nmatch three pictures\n");
  setPStatThenSetPStatThenCallDigimonSubroutineThenCallSubroutine(3, 1);
  setTexboxMode(0, 0);
  return;
