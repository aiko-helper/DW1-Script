// DG095.SCN
#include "functions.dgs"
#pragma script index=95 start=0x3e000 end=0x3e800 headerU16=0x1c sentinelOff=0x375
#include "entities.dgs"

section onEnter(254) {
  spawnChest(Item.SuperRecovery, 9, 1196, 0, 660);
  spawnChest(Item.LargeMP, 1223, 266, 1024, 661);
  if (trigger(322)) {
    setObjectVisibility(0, 1);
  }
  return;
}

section(51) {
  warp(to: Map.ICSA05, spawn: 0, trigger: 255);
  return;
}

section(5) {
  speak(Entity(5), "「帰ったほうがいいんじゃない?」<NEWLINE>");
  finishEncounter(Trigger(294));
}

section(6) {
  speak(Entity(6), "「帰れ!」<NEWLINE>");
  finishEncounter(Trigger(272));
}

section(7) {
  speak(Entity(7), "「もどったほうがいい!」<NEWLINE>");
  finishEncounter(Trigger(272));
}

section(52) {
  if (trigger(322)) {
    return;
  }
  playAnimation(Entity.Player, Animation(22));
  sfx(8, 9, wait: 15);
  speak(Entity.Player, "「ま…まぶしい…!」<NEWLINE>");
  playAnimation(Entity.Player, Animation(0));
  setPStat(PStat(254), 40);
  callSubroutine(45);
  delay(40);
  speak(Entity.System, "<YELLOW>???モン<WHITE><NEWLINE>「我がたましいを求める者よ、今、目ざめの<NEWLINE> 時は来た。なんじにわがつばさの祝福を!」<NEWLINE>");
  speak(Entity.Player, "「何だ…?ここは…?誰の…声…?」<NEWLINE>");
  showTextbox("「う………!」<NEWLINE>");
  setObjectVisibility(0, 1);
  callSubroutine(46);
  delay(40);
  anim(Entity.Player, Animation(24), wait: 15);
  speak(Entity.Player, "「今のは…?<NEWLINE> 光が無くなってる…。ここにはもう<NEWLINE> 何も無い…ってことは!上か!」<NEWLINE>");
  anim(Entity.Player, Animation(23), wait: 15);
  playAnimation(Entity.Player, Animation(0));
  setTrigger(Trigger(322));
  return;
