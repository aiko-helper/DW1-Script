// DG072.SCN
#include "functions.dgs"
#pragma script index=72 start=0x31000 end=0x32000 headerU16=0x18 sentinelOff=0x24
#include "entities.dgs"

section onEnter(254) {
  spawnItemChance(max: 99, chance: 8, item: Item.Digimushroom, x: 33, y: 39);
  spawnItemChance(max: 99, chance: 16, item: Item.Digimushroom, x: 33, y: 22);
  spawnItemChance(max: 99, chance: 2, item: Item.SweetNut, x: 52, y: 35);
  return;
}

section(51) {
  if (trigger(189)) {
    return;
  }
  if (trigger(248) || !trigger(196)) {
    return;
  }
  lookPairAt(Entity(5));
  waitForPair();
  setTrigger(Trigger(189));
  panTo(x: -285, y: 3964, slowdown: 30);
  speak(Entity(5), "「君たちのうわさは聞いているよ。<NEWLINE> 大活躍だね。」<NEWLINE>");
  look(entity: Entity(5), at: Entity.Player);
  waitForEntity(Entity(5));
  anim(Entity.Player, Animation(19), wait: 15);
  speak(Entity.Player, "「俺達のこと、街のこと、聞いているんなら<NEWLINE> 街へ来てくれないか?」<NEWLINE>");
  playAnimation(Entity.Player, Animation(0));
  speak(Entity(5), "「…考えさせてくれ。私も自分なりに島の<NEWLINE> 行く末については考えている。それと…<NEWLINE> ずっと探し求めているものもあってね。」<NEWLINE>");
  rotate(entity: Entity(5), to: 2560);
  waitForEntity(Entity(5));
  playAnimation(Entity(5), Animation(24));
  waitForEntity(Entity(5));
  speak(Entity.Player, "「何を探している?」<NEWLINE>");
  speak(Entity(5), "「私の先祖が未来へたくしたという物品だ。<NEWLINE> 何なのかは分からないのだが…」<NEWLINE>");

L1:
  {
    if (item[Item.Leomonstone] >= 1) {
      removeItem(Item.Leomonstone, 1);
      break;
      break;
    }
    speak(Entity.Player, "「そうか…。もし俺達が見つけたら<NEWLINE> 知らせるよ。」<NEWLINE>");
    speak(Entity(5), "「ふふ…私も長年探しているんだ。<NEWLINE> いくら君でも簡単に見つかるものでは<NEWLINE> ないと思うよ。」<NEWLINE>");
    speak(Entity(5), "「しかし約そくしよう。もし見つかったなら<NEWLINE> 君達の街へ行こう。」<NEWLINE>");
    followEntity(Entity.Player, speed: 10);
    return;
  }
  {
    anim(Entity.Player, Animation(19), wait: 15);
    speak(Entity.Player, "「…それって、これかな?」<NEWLINE>");
    playAnimation(Entity.Player, Animation(0));
    look(entity: Entity(5), at: Entity.Player);
    waitForEntity(Entity(5));
    speak(Entity(5), "「おお、それは!」<NEWLINE>");
    followEntity(Entity(5), speed: 20);
    move(entity: Entity(5), to: Entity.Player, sprint: 1, withCamera: true);
    waitForEntity(Entity(5));
    look(entity: Entity(5), at: Entity.Player);
    look(entity: Entity.Player, at: Entity(5));
    waitForEntity(Entity(5));
    waitForEntity(Entity.Player);
    anim(Entity(5), Animation(25), wait: 30);
    speak(Entity(5), "「ふむ…確かに我が先祖が書いたものだな!<NEWLINE> なになに…」<NEWLINE>");
    speak(Entity(5), "「島に危機がおとずれたときは…島の中心に<NEWLINE> 向かえ…力を合わせよ……!」<NEWLINE>");
    playAnimation(Entity(5), Animation(24));
    waitForEntity(Entity(5));
    speak(Entity(5), "「これは!先祖は、私に街へ行けと…!」<NEWLINE>");
    speak(Entity.Player, "「!!…ってことは…<NEWLINE> 協力してくれるのか?」<NEWLINE>");
    playAnimation(Entity(5), Animation(22));
    waitForEntity(Entity(5));
    speak(Entity(5), "「むろん。任せてくれ!」<NEWLINE>");
    break;
  }
  approach(who: Entity(5), x: -374, y: -1119, tries: 3, wait: 20);
  playSound(8, 17);
  speak(Entity.System, "レオモンが街に参加した!!!<NEWLINE>");
  followEntity(Entity.Player, speed: 10);
  setTrigger(Trigger(248));
  addPStat(PStat(1), 2);
  return;
}

section(5) {
  speak(Entity(5), "「私には探さなくてはならない物が<NEWLINE> あるのだ…悪いが…」<NEWLINE>");
  goto section_51.L1;
}

section(83) {
  rotate(entity: Entity.Player, to: 2048);
  setTextboxOrigin(-829, 0, 4099);
  callSubroutine(39);
  speak(Entity(200), " <NEWLINE><GREEN>  トレーニング・打ちこみスペシャル<WHITE><NEWLINE>");
  setSelection(L1, L2, L3);
  showTextbox("トレーニング開始<NEWLINE>このトレーニングの説明<NEWLINE>やめる<NEWLINE>");
  waitForSelectionChoice();
  return;

L1:
  setDialogOwner(Entity(200));
  setSelection(L4, L5, L3);
  showTextbox("ノーマルトレーニング<NEWLINE>ボーナストライトレーニング<NEWLINE>やっぱりやめる<NEWLINE>");
  waitForSelectionChoice();
  return;

L2:
  speak(Entity(200), "コンクリートバッグを練習台に、技の<NEWLINE>打ちこみをします。攻撃力が大きくアップ、<NEWLINE>最大HPもアップします。<NEWLINE>");
  setSelection(L2, L1, L3);
  showTextbox("もう一度説明<NEWLINE>トレーニング開始<NEWLINE>やめる<NEWLINE>");
  waitForSelectionChoice();
  return;

L3:
  return;

L4:
  fadeOutHUD();
  setPStat(PStat(254), 1);
  setPStat(PStat(246), 0);
  callDigimonSubroutine(214);
  callSubroutine(7);
  return;

L5:
  setTexboxMode(1, 0);
  speak(Entity.System, "       <YELLOW>スロットゲーム<WHITE><NEWLINE> <NEWLINE>   <ORANGE><CIRCLE><WHITE><ボき><ヌン>で3つのスロットを止めて、<NEWLINE>    うまく絵をそろえてください。<NEWLINE>");
  setPStat(PStat(254), 1);
  setPStat(PStat(246), 1);
  callDigimonSubroutine(214);
  callSubroutine(7);
  setTexboxMode(0, 0);
  return;
}

section(85) {
  rotate(entity: Entity.Player, to: 2560);
  setTextboxOrigin(766, 0, 106);
  callSubroutine(39);
  speak(Entity(200), " <NEWLINE><GREEN>   トレーニング・サバンナコース<WHITE><NEWLINE>");
  setSelection(L1, L2, L3);
  showTextbox("トレーニング開始<NEWLINE>このトレーニングの説明<NEWLINE>やめる<NEWLINE>");
  waitForSelectionChoice();
  return;

L1:
  setDialogOwner(Entity(200));
  setSelection(L4, L5, L3);
  showTextbox("ノーマルトレーニング<NEWLINE>ボーナストライトレーニング<NEWLINE>やっぱりやめる<NEWLINE>");
  waitForSelectionChoice();
  return;

L2:
  speak(Entity(200), "サバンナコースを走りまくります。<NEWLINE>すばやさが大きくアップ、最大HPもアップ<NEWLINE>します。<NEWLINE>");
  setSelection(L2, L1, L3);
  showTextbox("もう一度説明<NEWLINE>トレーニング開始<NEWLINE>やめる<NEWLINE>");
  waitForSelectionChoice();
  return;

L3:
  return;

L4:
  fadeOutHUD();
  setPStat(PStat(254), 2);
  setPStat(PStat(246), 0);
  callDigimonSubroutine(214);
  callSubroutine(7);
  return;

L5:
  setTexboxMode(1, 0);
  speak(Entity.System, "       <YELLOW>スロットゲーム<WHITE><NEWLINE> <NEWLINE>   <ORANGE><CIRCLE><WHITE><ボき><ヌン>で3つのスロットを止めて、<NEWLINE>    うまく絵をそろえてください。<NEWLINE>");
  setPStat(PStat(254), 2);
  setPStat(PStat(246), 1);
  callDigimonSubroutine(214);
  callSubroutine(7);
  setTexboxMode(0, 0);
  return;
