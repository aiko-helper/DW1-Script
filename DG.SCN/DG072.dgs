// DG072.SCN
#include "functions.dgs"
#pragma script index=72 start=0x33800 end=0x34000 headerU16=0x18 sentinelOff=0x24
#include "entities.dgs"

section onEnter(254) {
  roll(pstat: 110, max: 99);
  if (pstat[110] > 16) goto L1;
  spawnItem(Item.Digimushroom, x: 49, y: 70);

L1:
  roll(pstat: 110, max: 99);
  if (pstat[110] > 2) goto L2;
  spawnItem(Item.Happymushroom, x: 25, y: 68);

L2:
  return;
}

section(7) {
  speak(7, "I'm very disappointed.\n");
  finishEncounter(282);
}

section(8) {
  speak(8, "Don't make me mad.\n");
  finishEncounter(282);
}

section(9) {
  speak(9, "Dinner?\n");
  finishEncounter(297);
}

section(10) {
  speak(10, "I'm hungry!\n");
