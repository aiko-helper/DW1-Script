; source: ./extract/DIGIMON/SCN/DG.SCN
; DG183.SCN, section 60

section_60(60):     ; len=4078
  0000:  setDigimon NPCMyotismon 0 0
  0004:  moveEntityTo Player 276 -1057 6
  000c:  moveEntityTo Partner -688 481 6
  0014:  waitForEntity Player
  0016:  waitForEntity Partner
  0018:  setRotation Player 2128
  001c:  setRotation Partner 3072
  0020:  speak Player "Yum, Yum.\n"
  003a:  speak 5 "Uh...\n"
  004c:  lookAt 5 Player
  0050:  speak 5 "Please listen up.\n"
  007a:  speak Player "Yummy, Yummy.\n"
  009c:  speak 5 "My men don't listen any more.\n"
  00de:  showTextbox "I don't think they can\nremember my orders.\n"
  0138:  showTextbox "Sometimes they don't\neven understand.\n"
  0188:  showTextbox "My men should\nbring my meals, but...\n"
  01d6:  speak Player "Yummy...\n"
  01ee:  speak 5 "While I was working they\ndidn't bring my meals,\nso I forgot to eat.\n"
  027c:  lookAt Player 5
  0280:  speak Player "You're too wrapped up in\nyour work.\n"
  02ce:  speak 5 "I'm so embarrassed.\n"
  02fc:  speak Player "I think there's trouble\nin the mansion.\n"
  0352:  speak 5 "Problem on the island? Is\neveryone acting like my men?\n"
  03c6:  speak Player "Yes, they're all losing\ntheir memory.\n"
  0418:  speak 5 "Do you think someone's\ndoing this?\n"
  0464:  speak Player "Hmmm\n"
  0474:  speak 5 "What can I do?\n"
  0498:  speak Player "We're building a city to\nunite Digimons' hearts.\n"
  0500:  showTextbox "We're traveling\nto find friends.\n"
  0546:  speak 5 "What I can do?\nMy men have only\nfighting skills.\n"
  05ae:  if trigger(205) then section_60+0x6ca
  05ba:  showTextbox "I can't leave them here.\n"
  05f0:  speak Player "I see...\n"
  0608:  speak 5 "Let me think about it.\nI'm very sorry, but...\n"
  066a:  speak Player "I'll come back again.\nDon't forget to eat.\n"
  06c6:  jump section_60+0x81c
  06ca:  speak Player "Want to enter a match?\n"
  06fe:  speak 5 "A match? It's perfect,\nit will refresh my men.\n"
  0762:  speak Player "So, you want to join?\n"
  0794:  speak 5 "Yes, but I still have\nresearch to do here.\nI'll go there soon.\n"
  0818:  setTrigger 266
  081c:  warpTo YAKA11A 4 255
  0820:  endSection
