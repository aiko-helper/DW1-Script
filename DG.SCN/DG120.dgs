// DG120.SCN
#include "functions.dgs"
#pragma script index=120 start=0x4f000 end=0x4f800 headerU16=0x1c sentinelOff=0x24
#include "entities.dgs"

section onEnter(254) {
  spawnItemChance(max: 99, chance: 18, item: Item.Digimushroom, x: 68, y: 27);
  spawnItemChance(max: 99, chance: 3, item: Item.IceMushroom, x: 54, y: 40);
  return;
}

section(5) {
  speak(Entity(5), "「ちょと、こづいていい?」<NEWLINE>");
  finishEncounter(Trigger(272));
}

section(6) {
  speak(Entity(6), "「いい気になるなぁ!」<NEWLINE>");
  finishEncounter(Trigger(272));
}

section(7) {
  speak(Entity(7), "「キサマ、あまり調子にのるなよ!」<NEWLINE>");
  finishEncounter(Trigger(300));
}

section(8) {
  speak(Entity(8), "「そんなに甘くないぞ。」<NEWLINE>");
  finishEncounter(Trigger(300));
}

section(51) {
