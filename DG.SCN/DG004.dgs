// DG004.SCN
#include "functions.dgs"
#pragma script index=4 start=0x8000 end=0x8800 headerU16=0x24 sentinelOff=0x24
#include "entities.dgs"

section onEnter(254) {
  spawnItemChance(max: 99, chance: 2, item: Item.BlueApple, x: 44, y: 31);
  spawnItemChance(max: 99, chance: 24, item: Item.Digimushroom, x: 42, y: 57);
  spawnItemChance(max: 99, chance: 2, item: Item.DeluxeMushroom, x: 52, y: 51);
  spawnItemChance(max: 99, chance: 59, item: Item.Digimushroom, x: 65, y: 41);
  return;
}

section(81) {
  rotate(entity: Entity.Player, to: 2048);
  delay(5);
  anim(Entity.Player, Animation(16), wait: 15);
  speak(Entity.Player, "「ん、字がきざんであるぞ。」<NEWLINE>");
  playAnimation(Entity.Player, Animation(0));
  speak(Entity.System, " <NEWLINE>       ルスだ!帰れ!<NEWLINE>");
  if (!trigger(242)) {
    speak(Entity.Player, "「誰か住んでるのか?」<NEWLINE>");
  }
  return;
}

section(51) {
  if (trigger(242) || pstat[1] < 50) {
    return;
  }
  {
    move(entity: Entity.Partner, to: Entity.Player, sprint: 1);
    waitForEntity(Entity.Partner);
    rotate(entity: Entity.Partner, to: 2048);
    delay(5);
    speak(Entity.System, "<YELLOW>???<WHITE><NEWLINE>「サルも木から…」<NEWLINE>");
    showTextbox("<YELLOW>???<WHITE><NEWLINE>「フライング・ニー・ドローップ!!!」<NEWLINE>");
    playSound(8, 5);
    playAnimation(Entity(5), Animation(29));
    move(entity: Entity(5), axis: 1, to: 0, speed: 12);
    waitForEntity(Entity(5));
    playAnimation(Entity(5), Animation(0));
    playSound(8, 6);
    setPStat(PStat(200), 30);
    dealMapDamage(PStat(200));
    playAnimation(Entity.Player, Animation(15));
    anim(Entity.Partner, Animation(40), wait: 30);
    setTrigger(Trigger(1));
    setPStat(PStat(250), 1);
    setPStat(PStat(251), 5);
    setPStat(PStat(252), 255);
    setPStat(PStat(253), 255);
    startBattle();
    unsetTrigger(Trigger(1));
    setPStat(PStat(250), 0);
    look(entity: Entity.Player, at: Entity(5));
    look(entity: Entity(5), at: Entity.Player);
    look(entity: Entity.Partner, at: Entity(5));
    speak(Entity(5), "「ウキッ、この俺様が負け…いやいや、<NEWLINE> キサマらたいしたことないな!」<NEWLINE>");
    playSound(8, 13);
    anim(Entity.Player, Animation(20), wait: 15);
    speak(Entity.Player, "「…負けおしみ言ってらぁ。<NEWLINE> 不意打ちしかけてきたくせに…」<NEWLINE>");
    playAnimation(Entity.Player, Animation(0));
    playSound(8, 13);
    playAnimation(Entity(5), Animation(7));
    speak(Entity(5), "「ムキキ!くぅ~こうなったら…」<NEWLINE>");
    showTextbox("「キサマらの街で俺様の実力を<NEWLINE> 思い知らせてやるっ!見てろよウキッ!」<NEWLINE>");
    break;
  }
  approach(who: Entity(5), x: 0, y: 0, tries: 4, wait: 20);
  followEntity(Entity.Player, speed: 10);
  playSound(8, 11);
  speak(Entity.System, "エテモンが街に参加した!!!<NEWLINE>");
  setTrigger(Trigger(242));
  addPStat(PStat(1), 3);
  return;
}

section(6, 0x036c) {
  speak(Entity(6), "「痛い目を見るだけですよ。」<NEWLINE>");
  finishEncounter(Trigger(286));
}

section(6, 0x039e) {
  speak(Entity(6), "「まったく…、子供ですね。」<NEWLINE>");
  finishEncounter(Trigger(286));
}

section(7) {
  speak(Entity(7), "「まあ、かるくお相手しましょうか。」<NEWLINE>");
  finishEncounter(Trigger(286));
}

section(8) {
  speak(Entity(8), "「そのハナ、へしおってやるっ!」<NEWLINE>");
  finishEncounter(Trigger(280));
}

section(9) {
  speak(Entity(9), "「ボキッてしてやるぞ~!」<NEWLINE>");
  finishEncounter(Trigger(280));
  garbage { 24 00 fe 00 24 00 51 00 7e 00 33 00 0a 01 06 00 6c 03 06 00 9e 03 07 00 d0 03 08 00 0a 04 09 00 40 04 ff ff 24 00 6e 63 19 00 0b 00 6e 02 18 00 3a 00 19 00 74 30 2c 00 1f 00 24 00 6e 63 19 00 0b 00 6e 18 18 00 50 00 19 00 74 2c 2a 00 39 00 24 00 6e 63 19 00 0b 00 6e 02 18 00 66 00 19 00 74 2e 34 00 33 00 24 00 6e 63 19 00 0b 00 6e 3b 18 00 7c 00 19 00 74 2c 41 00 29 00 fe 00 4d fd 00 08 67 00 05 00 56 00 fd 10 67 00 0f 00 1b fd 1a 00 81 75 82 f1 81 41 8e 9a 82 aa 82 ab 82 b4 82 f1 82 c5 82 a0 82 e9 82 bc 81 42 81 76 0d 00 00 00 56 00 fd 00 1b ff 1a 00 81 40 0d 00 81 40 81 40 81 40 81 40 81 40 81 40 81 40 83 8b 83 58 82 be 81 49 8b 41 82 ea 81 49 0d 00 00 00 19 00 01 00 f2 00 18 00 08 01 19 00 1b fd 1a 00 81 75 92 4e 82 a9 8f 5a 82 f1 82 c5 82 e9 82 cc 82 a9 81 48 81 76 0d 00 00 00 fe 00 19 00 00 00 f2 00 4d 00 01 32 18 00 1c 01 19 00 fe 00 51 fc 01 fd 4a fc 4d fc 00 08 67 00 05 00 1b ff 1a 00 01 07 81 48 81 48 81 48 01 01 0d 00 81 75 83 54 83 8b 82 e0 96 d8 82 a9 82 e7 81 63 81 76 0d 00 00 00 1a 00 01 07 81 48 81 48 81 48 01 01 0d 00 81 75 83 74 83 89 83 43 83 93 83 4f 81 45 83 6a 81 5b 81 45 83 68 83 8d 81 5b 83 62 83 76 81 49 81 49 81 49 81 76 0d 00 00 00 5a 00 08 05 56 00 05 1d 72 05 00 00 01 0c 4a 05 56 00 05 00 5a 00 08 06 1e 00 c8 1e 69 c8 56 00 fd 0f 56 00 fc 28 67 00 1e 00 1c 00 01 00 1e 00 fa 01 1e 00 fb 05 1e 00 fc ff 1e 00 fd ff 27 00 67 00 01 00 66 00 1d 00 01 00 1e 00 fa 00 4c 00 fd 05 4c 00 05 fd 4c 00 fc 05 1b 05 1a 00 81 75 83 45 83 4c 83 62 81 41 82 b1 82 cc 89 b4 97 6c 82 aa 95 89 82 af 81 63 82 a2 82 e2 82 a2 82 e2 81 41 0d 00 81 40 83 4c 83 54 83 7d 82 e7 82 bd 82 a2 82 b5 82 bd 82 b1 82 c6 82 c8 82 a2 82 c8 81 49 81 76 0d 00 00 00 5a 00 08 0d 56 00 fd 14 67 00 0f 00 1b fd 1a 00 81 75 81 63 95 89 82 af 82 a8 82 b5 82 dd 8c be 82 c1 82 c4 82 e7 82 9f 81 42 0d 00 81 40 95 73 88 d3 91 c5 82 bf 82 b5 82 a9 82 af 82 c4 82 ab 82 bd 82 ad 82 b9 82 c9 81 63 81 76 0d 00 00 00 56 00 fd 00 5a 00 08 0d 56 00 05 07 1b 05 1a 00 81 75 83 80 83 4c 83