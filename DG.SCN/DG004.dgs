// DG004.SCN
#include "functions.dgs"
#pragma script index=4 start=0x8800 end=0x9000 headerU16=0x24 sentinelOff=0x24
#include "entities.dgs"

section onEnter(254) {
  roll(pstat: 110, max: 99);
  if (pstat[110] > 2) goto L1;
  spawnItem(Item.BlueApple, x: 44, y: 31);

L1:
  roll(pstat: 110, max: 99);
  if (pstat[110] > 24) goto L2;
  spawnItem(Item.Digimushroom, x: 42, y: 57);

L2:
  roll(pstat: 110, max: 99);
  if (pstat[110] > 2) goto L3;
  spawnItem(Item.DeluxeMushroom, x: 52, y: 51);

L3:
  roll(pstat: 110, max: 99);
  if (pstat[110] > 59) goto L4;
  spawnItem(Item.Digimushroom, x: 65, y: 41);

L4:
  return;
}

section(81) {
  rotate(entity: Entity.Player, to: 2048);
  delay(5);
  playAnimation(Entity.Player, 16);
  delay(15);
  speak(Entity.Player, "There are engraved\nletters here.\n");
  playAnimation(Entity.Player, 0);
  speak(Entity.System, "No one's here! Go home!\n");
  if (trigger(242)) goto L1;
  speak(Entity.Player, "Is someone living here?\n");

L1:
  return;
}

section(51) {
  if (!trigger(242) && pstat[1] >= 50) goto L1;
  return;

L1:
  move(entity: Entity.Partner, to: Entity.Player, sprint: 1);
  waitForEntity(Entity.Partner);
  rotate(entity: Entity.Partner, to: 2048);
  delay(5);
  speak(Entity.System, "<YELLOW>? ? ? <WHITE>\nEven monkeys fall from trees.\n");
  showTextbox("<YELLOW>? ? ? <WHITE>\nFlying knee drop!\n");
  playSound(8, 5);
  playAnimation(5, 29);
  move(entity: 5, axis: 1, to: 0, speed: 12);
  waitForEntity(5);
  playAnimation(5, 0);
  playSound(8, 6);
  setPStat(200, 30);
  dealMapDamage(200);
  playAnimation(Entity.Player, 15);
  playAnimation(Entity.Partner, 40);
  delay(30);
  setTrigger(1);
  setPStat(250, 1);
  setPStat(251, 5);
  setPStat(252, 255);
  setPStat(253, 255);
  startBattle();
  unsetTrigger(1);
  setPStat(250, 0);
  look(entity: Entity.Player, at: 5);
  look(entity: 5, at: Entity.Player);
  look(entity: Entity.Partner, at: 5);
  speak(5, "I lost, but\nyou guys are nothing!\n");
  playSound(8, 13);
  playAnimation(Entity.Player, 20);
  delay(15);
  speak(Entity.Player, "Don't be a sore loser.\nYou even sneak attacked us\nby surprise.\n");
  playAnimation(Entity.Player, 0);
  playSound(8, 13);
  playAnimation(5, 7);
  speak(5, "Ugh! You leave me\nno choice but to...\n");
  showTextbox("In that city of yours,\nI'll show you how strong\nI am! Just you watch!\n");
  goto L2;

L2:
  loop {
    move(entity: 5, to: (0, 0), sprint: 1);
    if (pstat[101] >= 4) break;
    addPStat(PStat.LoopIterator, 1);
    delay(20);
    look(entity: Entity.Player, at: 5);
    look(entity: Entity.Partner, at: 5);
  }
  waitForEntity(5);
  unloadEntity(5);
  setPStat(PStat.LoopIterator, 0);
  moveCamera(to: Entity.Player, speed: 10);
  playSound(8, 11);
  speak(Entity.System, "Etemon joins the city!\n");
  setTrigger(242);
  addPStat(1, 3);
  return;
}

section(6, 0x049e) {
  speak(6, "You'll only get hurt.\n");
  startBattle();
  setTrigger(286);
  return;
}

section(6, 0x04de) {
  speak(6, "You're such a baby!\n");
  startBattle();
  setTrigger(286);
  return;
}

section(7) {
  speak(7, "I guess I can play with you.\n");
  startBattle();
  setTrigger(286);
  return;
}

section(8) {
  speak(8, "I'll break your nose!\n");
  startBattle();
  setTrigger(280);
  return;
}

section(9) {
  speak(9, "I'll break you in half!\n");
  startBattle();
  setTrigger(280);
  return;
