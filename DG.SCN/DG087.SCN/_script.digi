onEnter:     ; len=68
  0000:  storeRandom 110 99
  0004:  if pstat[110] > 17 then onEnter+0x16
  0010:  spawnItem 44 49 27
  0016:  storeRandom 110 99
  001a:  if pstat[110] > 8 then onEnter+0x2c
