// DG208.SCN
#include "functions.dgs"
#pragma script index=208 start=0xab800 end=0xac800 headerU16=0xc sentinelOff=0xfe
#include "entities.dgs"

section onEnter(254) {
  return;
}

section(82) {
  rotate(entity: Entity.Player, to: 3152);
  delay(5);
  loop {
    if (!trigger(154) || pstat[1] < 45) goto L1;
    setTrigger(153);
    setTextboxSize(21, 8);
    showTextbox("Shell Newspaper Eigth\nAlien Digimon Appears:\nWe have found the UFO.\nThe creature showed its body\nand spoke unknown words.\nIs the creature an Alien?\nWill it appear again?\n");
    fadeOutHUD();
    setDialogOwner(Entity.System);
    choice { "Back" -> L1, "Stop" -> L32 }
    return;

L1:
    if (!trigger(226)) goto L2;
    setTextboxSize(21, 10);
    showTextbox("Shell Newspaper Seven\nMyotismon Denies His\nRetirement:\nIn an interview,\nhe denied the rumors.\nHe is still working hard.\nHe loves his fans.\nHe also announced that\nhis pupil, SkullGreymon,\nwill make his debut.\n");
    fadeOutHUD();
    setTrigger(325);
    setDialogOwner(Entity.System);
    choice { "Back" -> L5, "Forward" -> L3, "Stop" -> L32 }
    return;

L2:
    goto L5;

L3:
    if (!trigger(154) || pstat[1] < 45) goto L4;
    continue;
    goto L5;

L4:
    goto L1;

L5:
    if (pstat[1] < 35 || !trigger(128)) goto L7;
    setTextboxSize(21, 8);
    showTextbox("Shell Newspaper Six\nMyotismon to Retire?:\nRumor is that popular and \nable Myotismon will retire.\nNo one at the arena has\nseen him. His career is at\nits end. He is too old.\n");
    fadeOutHUD();
    if (trigger(226)) goto L6;
    unsetTrigger(266);
    setTrigger(356);

L6:
    setDialogOwner(Entity.System);
    choice { "Back" -> L11, "Forward" -> L8, "Stop" -> L32 }
    return;

L7:
    goto L11;

L8:
    if (!trigger(226)) goto L9;
    goto L1;

L9:
    if (!trigger(154) || pstat[1] < 45) goto L10;
    continue;

L10:
    goto L5;

L11:
    if (pstat[1] < 25) goto L12;
    setTextboxSize(21, 9);
    showTextbox("Shell Newspaper Five\nHidden Treasure:\nA cool shop in Gear Savanna.\nThis shop is only open from\nfirst to fifteenth each year.\nThe shop manager is proud of\nhis rare Items.\n");
    fadeOutHUD();
    setDialogOwner(Entity.System);
    choice { "Back" -> L17, "Forward" -> L13, "Stop" -> L32 }
    return;

L12:
    goto L17;

L13:
    if (pstat[1] < 35 || !trigger(128)) goto L14;
    goto L5;

L14:
    if (!trigger(226)) goto L15;
    goto L1;

L15:
    if (!trigger(154) || pstat[1] < 45) goto L16;
    continue;

L16:
    goto L11;

L17:
    if (pstat[1] < 20) goto L18;
    setTextboxSize(21, 10);
    showTextbox("Shell Newspaper Four\nA Legendary Digimon?:\nRumor is that there is\na cold weather Digimon\nin Freezeland. Mr. M was\nsaved by this monster. It\nlooked like a big snowball.\nDigimon who are not use to\nthe cold, be careful!\n");
    fadeOutHUD();
    setDialogOwner(Entity.System);
    choice { "Back" -> L21, "Forward" -> L19, "Stop" -> L32 }
    return;

L18:
    goto L21;

L19:
    if (pstat[1] < 25) goto L20;
    goto L11;

L20:
    goto L17;

L21:
    if (pstat[1] < 15) goto L22;
    setTextboxSize(21, 10);
    showTextbox("Shell Newspaper Three\nA Guardian for the Lake?:\nLake Guardian is at\nDragon Eye Lake.\nThe Digimon-like creature\nwas called by someone.\nCan this Guardian make\nwishes come true?\n");
    fadeOutHUD();
    setDialogOwner(Entity.System);
    choice { "Back" -> L25, "Forward" -> L23, "Stop" -> L32 }
    return;

L22:
    goto L25;

L23:
    if (pstat[1] < 20) goto L24;
    goto L17;

L24:
    if (!trigger(154) || pstat[1] < 45) break;
  }
  goto L21;

L25:
  loop {
    if (!trigger(118)) goto L26;
    setTextboxSize(21, 9);
    showTextbox("Shell Newspaper Two\nA UFO!:\nA report says the UFO\nis near Mt. Panorama.\nThe UFO looks like a\nsilver dish with light\ncoming from the bottom.\nIs it an alien?\nMore information to come.\n");
    fadeOutHUD();
    setTrigger(152);
    setDialogOwner(Entity.System);
    choice { "Back" -> L29, "Forward" -> L27, "Stop" -> L32 }
    return;

L26:
    goto L29;

L27:
    if (pstat[1] < 15) goto L28;
    goto L21;

L28:
    continue;

L29:
    setTextboxSize(21, 9);
    showTextbox("Shell Newspaper One\nBandits Are Gone!:\n<LIGHTBLUE><PLAYER><WHITE> found the\nhide out, led by Ogremon.\nHowever, Ogremon is \nloose and people\nare still worried.\n");
    fadeOutHUD();
    if (!trigger(118) && pstat[1] < 15) goto L30;
    setDialogOwner(Entity.System);
    choice { "Forward" -> L31, "Stop" -> L32 }
    return;

L30:
    return;

L31:
    if (!trigger(118)) break;
  }
  goto L21;

L32:
  return;
  garbage { 0c 00 fe 00 0c 00 52 00 0e 00 ff ff fe 00 4d fd 50 0c 67 00 05 00 19 00 00 00 9a 00 8a 00 01 2d 18 00 ac 01 19 00 1c 00 99 00 26 00 15 08 1a 00 82 72 82 88 82 85 82 8c 82 8c 81 40 82 6d 82 85 82 97 82 93 82 90 82 81 82 90 82 85 82 92 81 40 82 64 82 89 82 87 82 94 82 88 0d 00 82 60 82 8c 82 89 82 85 82 8e 81 40 82 63 82 89 82 87 82 89 82 8d 82 8f 82 8e 81 40 82 60 82 90 82 90 82 85 82 81 82 92 82 93 81 46 0d 00 82 76 82 85 81 40 82 88 82 81 82 96 82 85 81 40 82 86 82 8f 82 95 82 8e 82 84 81 40 82 94 82 88 82 85 81 40 82 74 82 65 82 6e 81 42 0d 00 82 73 82 88 82 85 81 40 82 83 82 92 82 85 82 81 82 94 82 95 82 92 82 85 81 40 82 93 82 88 82 8f 82 97 82 85 82 84 81 40 82 89 82 94 82 93 81 40 82 82 82 8f 82 84 82 99 0d 00 82 81 82 8e 82 84 81 40 82 93 82 90 82 8f 82 8b 82 85 81 40 82 95 82 8e 82 8b 82 8e 82 8f 82 97 82 8e 81 40 82 97 82 8f 82 92 82 84 82 93 81 42 0d 00 82 68 82 93 81 40 82 94 82 88 82 85 81 40 82 83 82 92 82 85 82 81 82 94 82 95 82 92 82 85 81 40 82 81 82 8e 81 40 82 60 82 8c }
}
