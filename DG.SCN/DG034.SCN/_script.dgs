// DG034.SCN
#pragma script index=34 start=0x1d800 end=0x1e000 headerU16=0x28 sentinelOff=0x24
#pragma sections section_0254 section_0005 section_0006 section_0007 section_0008 section_0009 section_0010 section_0011 section_0012

section onEnter(254) {  // len=68
    roll(pstat: 110, max: 99);
    if (pstat[110] > 14) goto L_0016;
    spawnItem(Item.Digimushroom, 21, 31);
L_0016:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 7) goto L_002c;
    spawnItem(Item.Digimushroom, 59, 78);
L_002c:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 0) goto L_0042;
    spawnItem(Item.DeluxeMushroom, 60, 51);
L_0042:
    return;
}
