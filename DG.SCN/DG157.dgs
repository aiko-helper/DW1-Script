#include "functions.dgs"
#pragma script index=157 start=0x6b800 end=0x6c000 headerU16=0x24 sentinelOff=0x675
#include "entities.dgs"

section onEnter(254) {
  spawnChest(Item.LargeMP, 3621, 1184, 1024, 684);
  return;
}

section(51) {
  move(entity: Entity.Player, to: (-1118, 1965), sprint: 0);
  warp(to: Map.MGEN05, spawn: 0, trigger: 255);
  return;
}

section(52) {
  move(entity: Entity.Player, to: (-260, 387), sprint: 0);
  warp(to: Map.MGEN03, spawn: 1, trigger: 255);
  return;
}

section(5) {
  speak(Entity(5), "「このオレにまっかせとき~っ!」<NEWLINE>");
  finishEncounter(Trigger(288));
}

section(6) {
