// DG069.SCN
#include "functions.dgs"
#pragma script index=69 start=0x2f800 end=0x30000 headerU16=0x18 sentinelOff=0x24
#include "entities.dgs"

section onEnter(254) {
  spawnItemChance(max: 99, chance: 16, item: Item.Digimushroom, x: 49, y: 70);
  spawnItemChance(max: 99, chance: 2, item: Item.Happymushroom, x: 25, y: 68);
  return;
}

section(7) {
  speak(Entity(7), "「まったく、キミには失望したよっ!」<NEWLINE>");
  finishEncounter(Trigger(282));
}

section(8) {
  speak(Entity(8), "「僕をおこらせないでくれたまえ。」<NEWLINE>");
  finishEncounter(Trigger(282));
}

section(9) {
  speak(Entity(9), "「めし?」<NEWLINE>");
  finishEncounter(Trigger(297));
}

section(10) {
