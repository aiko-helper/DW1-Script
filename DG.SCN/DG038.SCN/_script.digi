; DG038.SCN
;!script index=38 start=0x1f800 end=0x20000 headerU16=0x2c sentinelOff=0x24
;!sections onEnter section_5 section_6 section_7 section_8 section_9 section_81 section_82 section_55 section_51

onEnter:     ; len=90
  0000:  storeRandom 110 99
  0004:  if pstat[110] > 9 then onEnter+0x16
  0010:  spawnItem Digimushroom 49 64
  0016:  storeRandom 110 99
  001a:  if pstat[110] > 14 then onEnter+0x2c
  0026:  spawnItem Digimushroom 19 31
  002c:  storeRandom 110 99
  0030:  if pstat[110] > 4 then onEnter+0x42
  003c:  spawnItem Pricklypear 20 9
  0042:  storeRandom 110 99
  0046:  if pstat[110] > 0 then onEnter+0x58
  0052:  spawnItem DeluxeMushroom 69 16
  0058:  endSection
