// DG038.SCN
#pragma script index=38 start=0x1f800 end=0x20000 headerU16=0x2c sentinelOff=0x24
#pragma sections section_0254 section_0005 section_0006 section_0007 section_0008 section_0009 section_0081 section_0082 section_0055 section_0051

section onEnter(254) {  // len=90
    roll(pstat: 110, max: 99);
    if (pstat[110] > 9) goto L_0016;
    spawnItem(Item.Digimushroom, 49, 64);
L_0016:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 14) goto L_002c;
    spawnItem(Item.Digimushroom, 19, 31);
L_002c:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 4) goto L_0042;
    spawnItem(Item.Pricklypear, 20, 9);
L_0042:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 0) goto L_0058;
    spawnItem(Item.DeluxeMushroom, 69, 16);
L_0058:
    return;
}
