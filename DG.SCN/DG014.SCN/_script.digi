; DG014.SCN
;!script index=14 start=0xf800 end=0x10000 headerU16=0x20 sentinelOff=0x24
;!sections onEnter section_5 section_6 section_7 section_8 section_9 section_10

onEnter:     ; len=68
  0000:  storeRandom 110 99
  0004:  if pstat[110] > 15 then onEnter+0x16
  0010:  spawnItem Digimushroom 25 33
  0016:  storeRandom 110 99
  001a:  if pstat[110] > 4 then onEnter+0x2c
  0026:  spawnItem Digimushroom 63 31
  002c:  storeRandom 110 99
  0030:  if pstat[110] > 1 then onEnter+0x42
  003c:  spawnItem DeluxeMushroom 53 81
  0042:  endSection
