// DG014.SCN
#pragma script index=14 start=0xf800 end=0x10000 headerU16=0x20 sentinelOff=0x24
#pragma sections section_0254 section_0005 section_0006 section_0007 section_0008 section_0009 section_0010

section onEnter(254) {  // len=68
    roll(pstat: 110, max: 99);
    if (pstat[110] > 15) goto L_0016;
    spawnItem(Item.Digimushroom, 25, 33);
L_0016:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 4) goto L_002c;
    spawnItem(Item.Digimushroom, 63, 31);
L_002c:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 1) goto L_0042;
    spawnItem(Item.DeluxeMushroom, 53, 81);
L_0042:
    return;
}
