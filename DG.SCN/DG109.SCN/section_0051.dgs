// source: extract/DIGIMON/SCN/DG.SCN
// DG109.SCN, section 51

section section_51(51) {  // len=88
    if (trigger(134)) goto L_0056;
    rotate(entity: Entity.Player, to: 1900);
    waitForEntity(Entity.Player);
    setDialogOwner(Entity.Player);
    showTextbox("Wow, it's amazing!\n");
    moveCamera(to: (-400, 4000), slowdown: 50);
    waitForEntity(200);
    delay(40);
    moveCamera(to: Entity.Player, speed: 20);
    waitForEntity(200);
    setTrigger(134);
    return;
L_0056:
    return;
}
