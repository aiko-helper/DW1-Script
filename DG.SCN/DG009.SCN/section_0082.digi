; source: ./extract/DIGIMON/SCN/DG.SCN
; DG009.SCN, section 82

section_82(82):     ; len=3284
  0000:  setRotation Player 2048
  0004:  delay 5
  0008:  setTextboxSize 19 7
  000c:  showTextbox "Explanation of fishing:\nFirst, get a 'rod'. You'll\nget a submenu <GREEN><TRIANGLE> <WHITE>\nwith 'Fishing' icon. Click\non it. Bait with <LIGHTBLUE><X> <WHITE>.\nSelect something from\nthe foods you have.\n"
  0154:  showTextbox "Next, change directions with\nleft or right buttons. Hold\nrod over head with <LIGHTBLUE><X> <WHITE>,\nthrow again using <LIGHTBLUE><X> <WHITE>.\nWait for the float to move.\nWhen float moves, fish has\nbait. Pull in with <LIGHTBLUE><X> <WHITE>.\n"
  02cc:  showTextbox "Look at gauge at upper left.\nLet go of <LIGHTBLUE><X> <WHITE>before\ngauge is full. Otherwise line\nwill break, so be careful.\nIf you pull the float close\nenough towards yourself, then\nyou have caught the fish.\n"
  044e:  showTextbox "If you get an 'X' on the fish\nshadow, it means that you can't\nfish using the current bait.\n"
  0508:  fadeOutHUD
  050a:  endSection
