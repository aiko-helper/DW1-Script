// source: extract/DIGIMON/SCN/DG.SCN
// DG009.SCN, section 81

section section_81(81) {  // len=738
    setDialogOwner(Entity.System);
    showTextbox("Vending Machine\n");
    rotate(entity: Entity.Player, to: 2048);
    delay(5);
    setDialogOwner(Entity.Player);
    showTextbox("My gosh, it's so expensive!\n");
    setSelection(L_00fa, L_014e, L_01a2);
    showTextbox("Meat : three hund bits\nDigiMushrooms:six hund bits\nDon't buy\n");
    waitForSelectionChoice();
    goto L_01a2;
    return;
L_00fa:
    if (money < 300) goto L_0112;
    goto L_01a4;
    goto L_014e;
L_0112:
    setDialogOwner(Entity.Player);
    showTextbox("I don't got enough money.\n");
    return;
L_014e:
    if (money < 600) goto L_0166;
    goto L_0234;
    goto L_01a2;
L_0166:
    setDialogOwner(Entity.Player);
    showTextbox("I don't got enough money.\n");
    return;
L_01a2:
    return;
L_01a4:
    reduceMoney(300);
    setDialogOwner(Entity.System);
    showTextbox("<LIGHTBLUE>Meat <WHITE>came out!\n");
    giveItem(Item.Meat, 1);
    if (!trigger(0)) goto L_0232;
    if (item[Item.Meat] < 99) goto L_01f2;
    return;
L_01f2:
    setDialogOwner(Entity.Player);
    showTextbox("Oops, too many things.\n");
    setTrigger(3);
    callSubroutine(0);
    callSubroutine(13);
    giveItem(Item.Meat, 1);
L_0232:
    return;
L_0234:
    reduceMoney(600);
    setDialogOwner(Entity.System);
    showTextbox("A <LIGHTBLUE>Digital Mushroom <WHITE>\ncame out!\n");
    giveItem(Item.Digimushroom, 1);
    if (!trigger(0)) goto L_02e0;
    if (item[Item.Digimushroom] < 99) goto L_02a0;
    return;
L_02a0:
    setDialogOwner(Entity.Player);
    showTextbox("Oops, too many things.\n");
    setTrigger(3);
    callSubroutine(0);
    callSubroutine(13);
    giveItem(Item.Digimushroom, 1);
L_02e0:
    return;
}
