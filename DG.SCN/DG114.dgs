// DG114.SCN
#include "functions.dgs"
#pragma script index=114 start=0x52000 end=0x52800 headerU16=0x24 sentinelOff=0x24
#include "entities.dgs"

section onEnter(254) {
  roll(pstat: 110, max: 99);
  if (pstat[110] <= 7) {
    spawnItem(Item.Digimushroom, x: 55, y: 71);
  }
  roll(pstat: 110, max: 99);
  if (pstat[110] <= 15) {
    spawnItem(Item.Digimushroom, x: 45, y: 58);
  }
  roll(pstat: 110, max: 99);
  if (pstat[110] <= 4) {
    spawnItem(Item.Digimushroom, x: 14, y: 6);
  }
  return;
}

section(5) {
  speak(5, "So you're lost, <LIGHTBLUE><PLAYER><WHITE>?\n");
  finishEncounter(280);
}

section(6) {
  speak(6, "Huh?\n");
  finishEncounter(289);
}

section(7) {
  speak(7, "I'm not trying to get\nin your way.\n");
  finishEncounter(291);
}

section(8) {
  speak(8, "'Misty Trees.' Okay, say it.\n");
  finishEncounter(306);
}

section(9) {
  speak(9, "Okay! Showtime!!\n");
  finishEncounter(306);
}

section(51) {
  move(entity: Entity.Player, to: (60, -3200), sprint: 0);
  if (trigger(114) || trigger(147)) {
    warp(to: Map.MIST02, spawn: 2, trigger: 255);
  }
  roll(pstat: 110, max: 99);
  if (pstat[110] < 69) {
    warp(to: Map.MIST02, spawn: 2, trigger: 255);
    goto section_52;
  }
  warp(to: Map.MIST07, spawn: 1, trigger: 255);
}

section(52) {
  move(entity: Entity.Player, to: (70, 5200), sprint: 0);
  if (trigger(114) || trigger(147)) {
    warp(to: Map.MIST05, spawn: 0, trigger: 255);
  }
  addPStat(120, 1);
  if (pstat[120] == 10) {
    setPStat(120, 0);
    warp(to: Map.MIST05, spawn: 0, trigger: 255);
  }
  roll(pstat: 110, max: 99);
  if (pstat[110] < 69) {
    warp(to: Map.MIST04, spawn: 0, trigger: 255);
  } else {
    warp(to: Map.MIST02, spawn: 0, trigger: 255);
  }
  garbage { 24 00 fe 00 24 00 05 00 68 00 06 00 a6 00 07 00 c4 00 08 00 1e 01 09 00 6c 01 33 00 a2 01 34 00 da 01 ff ff 24 00 6e 63 19 00 0b 00 6e 07 18 00 3a 00 19 00 74 2c 37 00 47 00 24 00 6e 63 19 00 0b 00 6e 0f 18 00 50 00 19 00 74 2c 2d 00 3a 00 24 00 6e 63 19 00 0b 00 6e 04 18 00 66 00 19 00 74 2c 0e 00 06 00 fe 00 1b 05 1a 00 82 72 82 8f 81 40 82 99 82 8f 82 95 81 75 82 92 82 85 81 40 82 8c 82 8f 82 93 82 94 81 43 81 40 01 06 05 00 01 01 81 48 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 18 01 fe 00 1b 06 1a 00 82 67 82 95 82 88 81 48 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 21 01 fe 00 1b 07 1a 00 82 68 81 75 82 8d 81 40 82 8e 82 8f 82 94 81 40 82 94 82 92 82 99 82 89 82 8e 82 87 81 40 82 94 82 8f 81 40 82 87 82 85 82 94 0d 00 82 89 82 8e 81 40 82 99 82 8f 82 95 82 92 81 40 82 97 82 81 82 99 81 42 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 23 01 fe 00 1b 08 1a 00 81 75 82 6c 82 89 82 93 82 94 82 99 81 40 82 73 82 92 82 85 82 85 82 93 81 42 81 75 81 40 82 6e 82 8b 82 81 82 99 81 43 81 40 82 93 82 81 82 99 81 40 82 89 82 94 81 42 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 32 01 fe 00 1b 09 1a 00 82 6e 82 8b 82 81 82 99 81 49 81 40 82 72 82 88 82 8f 82 97 82 94 82 89 82 8d 82 85 81 49 81 49 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 32 01 fe 00 4e fd 3c 00 80 f3 00 00 19 00 00 00 72 00 40 00 93 00 18 00 be 01 19 00 4b 74 02 ff 24 00 6e 63 19 00 0d 00 6e 45 18 00 d6 01 19 00 4b 74 02 ff 16 00 da 01 4b 79 01 ff 4e fd 46 00 50 14 00 00 19 00 00 00 72 00 40 00 93 00 18 00 f6 01 19 00 4b 77 00 ff 1f 00 78 01 19 00 08 00 78 0a 18 00 0e 02 19 00 1e 00 78 00 4b 77 00 ff 24 00 6e 63 19 00 0d 00 6e 45 18 00 26 02 19 00 4b 76 00 ff 16 00 2a 02 4b 74 00 ff ff 00 81 40 82 94 82 89 82 92 82 85 82 84 81 42 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 23 01 fe 00 1b 0b 1a 00 82 78 82 8f 82 95 81 48 81 40 82 6d 82 8f 81 40 82 97 82 81 82 99 81 49 81 48 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 18 01 fe 00 1b 0c 1a 00 82 61 82 85 81 40 82 83 82 81 82 92 82 85 82 86 82 95 82 8c 81 40 82