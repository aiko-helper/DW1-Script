  025a:  setDialogOwner 6
  025c:  showTextbox "I feel some strong power.\n"
  0294:  setDialogOwner 6
  0296:  showTextbox "Will you listen to my story?\nThere's a beach cave near\nhere where I rest.\n"
  032e:  showTextbox "But, some mean guys kicked me\nout and I lost my important\ntreasure there.\n"
  03c6:  playAnimation Player 16
  03ca:  delay 15
  03ce:  setDialogOwner Player
  03d0:  showTextbox "Mean guys, huh?\nDoesn't sound good.\n"
  041c:  playAnimation Player 0
  0420:  setDialogOwner 6
  0422:  showTextbox "Please kick them out.\nI want you to help me\nget the cave back.\n"
