section section_81(81) {  // len=1878
    if (!trigger(224) && trigger(175)) goto L_0012;
    return;
L_0012:
    look(entity: Entity.Player, at: 6);
    look(entity: Entity.Partner, at: 6);
    delay(5);
    moveCamera(to: (-2852, 2621), slowdown: 30);
    waitForEntity(200);
    if (!trigger(352)) goto L_00b8;
    setDialogOwner(6);
    showTextbox("Who are you?\n");
    setDialogOwner(Entity.Player);
    setSelection(L_0512, L_04f6);
    showTextbox("I came here to help you\nI'm not ready yet...\n");
L_00b8:
    setTrigger(352);
    setDialogOwner(6);
    showTextbox("Is somebody there?\n");
    playAnimation(Entity.Player, 25);
    delay(15);
    setDialogOwner(Entity.Player);
    showTextbox("You can't see?\n");
    playAnimation(Entity.Player, 0);
    setDialogOwner(6);
    showTextbox("I'm Whamon. Usually\nI live in the sea.\n");
    showTextbox("I don't have eyes, but\nI can feel most things.\n");
    storeDigimonType(103);
    setDialogOwner(Entity.Player);
    showTextbox("I'm human. My name is\n<LIGHTBLUE><PLAYER><WHITE>.\n");
    showTextbox("This is <ORANGE><DIGIMON><WHITE>,\nmy partner and he is <DIGIMONTYPE2>.\n");
    setDialogOwner(6);
    showTextbox("I feel some strong power.\n");
    setDialogOwner(6);
    showTextbox("Will you listen to my story?\nThere's a beach cave near\nhere where I rest.\n");
    showTextbox("But, some mean guys kicked me\nout and I lost my important\ntreasure there.\n");
    playAnimation(Entity.Player, 16);
    delay(15);
    setDialogOwner(Entity.Player);
    showTextbox("Mean guys, huh?\nDoesn't sound good.\n");
    playAnimation(Entity.Player, 0);
    setDialogOwner(6);
    showTextbox("Please kick them out.\nI want you to help me\nget the cave back.\n");
    setDialogOwner(Entity.Player);
    setSelection(L_0512, L_04f6);
    showTextbox("I'll help you\nCan't help right now\n");
L_04f6:
    setDialogOwner(6);
    showTextbox("I see.\n");
    moveCamera(to: Entity.Player, speed: 10);
    waitForEntity(200);
    return;
L_0512:
    setDialogOwner(6);
    showTextbox("Then get on my back.\n");
    moveCamera(to: (-3150, 3000), slowdown: 30);
    playAnimation(6, 28);
    playSound(8, 3);
