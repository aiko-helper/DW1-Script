    waitForEntity(Entity.Player);
    move(entity: Entity.Player, to: (-3041, 3042), sprint: 0);
    move(entity: Entity.Partner, to: (-2454, 2707), sprint: 0);
    waitForEntity(Entity.Partner);
    move(entity: Entity.Partner, to: (-2771, 2915), sprint: 0);
    waitForEntity(Entity.Player);
    waitForEntity(Entity.Partner);
    delay(20);
