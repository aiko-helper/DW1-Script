    rotate(entity: Entity.Partner, to: 1283);
    delay(5);
    setDialogOwner(Entity.Player);
    showTextbox("Let's go.\n");
    playSound(8, 3);
    move(entity: Entity.Player, to: (-4053, 3680), animDuration: 99);
    move(entity: Entity.Partner, to: (-4053, 3680), animDuration: 99);
    move(entity: 6, to: (-4053, 3680), animDuration: 99);
    moveObjectTo(0, 35, 1, 0, 0, 350, 410);
