// MAP210.SCN
#include "functions.dgs"
#pragma script index=210 start=0x9c800 end=0x9d000 headerU16=0xc sentinelOff=0xfe
#include "entities.dgs"

section onEnter(254) {
  return;
}

section(51) {
  callSubroutine(52);
  look(entity: Entity(5), at: Entity.Player);
  look(entity: Entity(6), at: Entity.Player);
  look(entity: Entity(7), at: Entity.Player);
  move(entity: Entity.Partner, to: (-340, -2263), sprint: 0);
  panTo(x: 172, y: -1848, slowdown: 2);
  delay(20);
  speak(Entity(5), "「いよいよ、この時がきてしまったな。」<NEWLINE>");
  speak(Entity.Player, "「うん…本当はずっとここにいたい。<NEWLINE> でも、かあさんが心配してるから…」<NEWLINE>");
  speak(Entity(5), "「わしは…<LIGHTBLUE><PLAYER><WHITE>に<NEWLINE> ありがとうしか言えん。もっと<NEWLINE> もてなして、おんを返したかったがの…」<NEWLINE>");
  speak(Entity.System, "<YELLOW>トコモン<WHITE><NEWLINE>「グスッ、ボクらのこと忘れないでね…」<NEWLINE>");
  speak(Entity(7), "「いつかまた会えるときが…<NEWLINE> きっと来ますよね…」<NEWLINE>");
  rotate(entity: Entity.Player, to: 0);
  delay(30);
  rotate(entity: Entity.Player, to: 1024);
  delay(30);
  rotate(entity: Entity.Player, to: 2048);
  delay(30);
  rotate(entity: Entity.Player, to: 3072);
  delay(30);
  speak(Entity.Player, "「…みんな、本当に楽しかったよ。<NEWLINE> ありがとう。」<NEWLINE>");
  speak(Entity(5), "「ささ、別れがつらくなる前に…<NEWLINE> ぎしきをはじめるぞい…」<NEWLINE>");
  fadeOutHUD();
  callSubroutine(54);
  look(entity: Entity.Player, at: Entity.Partner);
  look(entity: Entity.Partner, at: Entity.Player);
  delay(40);
  speak(Entity.Player, "「<ORANGE><DIGIMON><WHITE>、俺の親友…<NEWLINE> おまえとの冒険、最高だったぜっ!!」<NEWLINE>");
  fadeOutHUD();
  delay(30);
  anim(Entity(5), Animation(32), wait: 40);
  callSubroutine(53);
  return;
