// MAP139.SCN
#include "functions.dgs"
#pragma script index=139 start=0x62800 end=0x63000 headerU16=0x10 sentinelOff=0x1d
#include "entities.dgs"

section onEnter(254) {
  unsetTrigger(116);
  storeDigimonType(103);
  if (pstat[103] == 14 || trigger(214)) {
    goto L1;
  }
  anim(5, 31, wait: 5);

L1:
  return;
}

section(5) {
  goto section_81;
}

section(81) {
  setTrigger(44);
  storeDigimonType(103);
  if (trigger(270) || pstat[103] == 14) {
    return;
  }
  anim(Entity.Player, 16, wait: 15);
  speak(Entity.Player, "This costume seems different\nfrom others. It has some\noverpowering presence.\n");
  fadeOutHUD();
  playAnimation(Entity.Player, 0);
  if (trigger(116)) {
    return;
  }
  setTrigger(116);
  playAnimation(5, 28);
  anim(Entity.Player, 15, wait: 40);
  move(entity: Entity.Player, to: (1079, -180), sprint: 0);
  waitForEntity(Entity.Player);
  look(entity: Entity.Player, at: 5);
  delay(10);
  speak(Entity.Player, "There's a zipper on the back.\n");
  fadeOutHUD();
  if (pstat[103] == 11) {
    move(entity: Entity.Partner, to: 5, sprint: 0);
    waitForEntity(Entity.Partner);
    look(entity: Entity.Player, at: Entity.Partner);
    delay(5);
    speak(Entity.Player, "What happened, <ORANGE><DIGIMON><WHITE>?!\n");
    fadeOutHUD();
    delay(10);
    waitForEntity(5);
    unloadEntity(5);
    setPStat(254, 14);
    callDigimonSubroutine(10);
    waitForEntity(Entity.System);
    delay(10);
    speak(Entity.Player, "What? Did you turn into\nanother Digimon?\nIt's kinda nice.\n");
    return;
  }
  speak(Entity.Player, " <ORANGE><DIGIMON><WHITE>,\ndo you want to get in?\n");
  look(entity: Entity.Player, at: Entity.Partner);
  move(entity: Entity.Partner, to: (900, 90), sprint: 0);
  waitForEntity(Entity.Partner);
  anim(Entity.Partner, 25, wait: 20);
  anim(Entity.Partner, 13, wait: 30);
  speak(Entity.Player, "No, you can't, <ORANGE><DIGIMON><WHITE>.\nOnly if you are limber\nand slippery, you can go in.\n");
  return;
  garbage { 10 00 fe 00 10 00 05 00 34 00 51 00 38 00 ff ff 1d 00 74 00 22 67 19 00 08 00 67 0e 40 00 d6 00 18 00 2a 00 19 00 16 00 32 00 56 00 05 1f 67 00 05 00 fe 00 16 00 38 00 1c 00 2c 00 22 67 19 00 00 00 0e 01 48 00 67 0e 18 00 50 00 19 00 fe 00 56 00 fd 10 67 00 0f 00 1b fd 1a 00 82 73 82 88 82 89 82 93 81 40 82 83 82 8f 82 93 82 94 82 95 82 8d 82 85 81 40 82 93 82 85 82 85 82 8d 82 93 81 40 82 84 82 89 82 86 82 86 82 85 82 92 82 85 82 8e 82 94 0d 00 82 86 82 92 82 8f 82 8d 81 40 82 8f 82 94 82 88 82 85 82 92 82 93 81 42 81 40 82 68 82 94 81 40 82 88 82 81 82 93 81 40 82 93 82 8f 82 8d 82 85 0d 00 82 8f 82 96 82 85 82 92 82 90 82 8f 82 97 82 85 82 92 82 89 82 8e 82 87 81 40 82 90 82 92 82 85 82 93 82 85 82 8e 82 83 82 85 81 42 0d 00 00 00 27 00 56 00 fd 00 19 00 00 00 74 00 18 00 0c 01 19 00 fe 00 1c 00 74 00 56 00 05 1c 56 00 fd 0f 67 00 28 00 4e fd 37 04 4c ff 00 00 4a fd 4c 00 fd 05 67 00 0a 00 1b fd 1a 00 82 73 82 88 82 85 82 92 82 85 81 75 82 93 81 40 82 81 81 40 82 9a 82 89 82 90 82 90 82 85 82 92 81 40 82 8f 82 8e 81 40 82 94 82 88 82 85 81 40 82 82 82 81 82 83 82 8b 81 42 0d 00 00 00 27 00 19 00 08 00 67 0b 18 00 4e 02 19 00 51 fc 00 05 4a fc 4c 00 fd fc 67 00 05 00 1b fd 1a 00 82 76 82 88 82 81 82 94 81 40 82 88 82 81 82 90 82 90 82 85 82 8e 82 85 82 84 81 43 81 40 01 0a 06 00 01 01 81 48 81 49 0d 00 00 00 27 00 67 00 0a 00 4a 05 48 05 1e 00 fe 0e 49 0a 4a ff 67 00 0a 00 1b fd 1a 00 82 76 82 88 82 81 82 94 81 48 81 40 82 63 82 89 82 84 81 40 82 99 82 8f 82 95 81 40 82 94 82 95 82 92 82 8e 81 40 82 89 82 8e 82 94 82 8f 0d 00 82 81 82 8e 82 8f 82 94 82 88 82 85 82 92 81 40 82 63 82 89 82 87 82 89 82 8d 82 8f 82 8e 81 48 0d 00 82 68 82 94 81 75 82 93 81 40 82 8b 82 89 82 8e 82 84 82 81 81 40 82 8e 82 89 82 83 82 85 81 42 0d 00 00 00 fe 00 1b fd 1a 00 81 40 01 0a 06 00 01 01 81 43 0d 00 82 84 82 8f 81 40 82 99 82 8f 82 95 81 40 82 97 82 81 82 8e 82 94 81 40 82 94 82 8f 81 40 82 87 82 85 82 94 81 40 82 89 82 8e 81 48 0d 00 00 00 4c 00 fd fc 4e fc 84 03 5a