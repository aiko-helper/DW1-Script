section onEnter(254) {
  spawnItemChance(max: 99, chance: 5, item: Item.Digimushroom, x: 41, y: 49);
  spawnItemChance(max: 99, chance: 11, item: Item.Digimushroom, x: 42, y: 67);
  return;
}

section(5) {
  speak(Entity(5), "「コゾウ、とって食うぞ~!」<NEWLINE>");
  finishEncounter(Trigger(272));
}

section(6) {
  speak(Entity(6), "「ひと暴れするぜっ!」<NEWLINE>");
  finishEncounter(Trigger(272));
}

section(7) {
  speak(Entity(7), "「自分の弱さをのろうがいい!」<NEWLINE>");
  finishEncounter(Trigger(300));
}

section(8) {
  speak(Entity(8), "「さあ来い、切りさいてやろう!」<NEWLINE>");
  finishEncounter(Trigger(300));
}

