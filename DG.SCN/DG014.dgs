// DG014.SCN
#include "functions.dgs"
#pragma script index=14 start=0xe800 end=0xf800 headerU16=0x1c sentinelOff=0x24
#include "entities.dgs"

section onEnter(254) {
  spawnItemChance(max: 99, chance: 14, item: Item.Digimushroom, x: 48, y: 80);
  spawnItemChance(max: 99, chance: 6, item: Item.Happymushroom, x: 40, y: 60);
  if (trigger(86) && !trigger(225)) {
    setObjectsVisibleRange(0, 3, 0);
  }
  return;
}

section(5) {
  speak(Entity(5), "「アナタ、デジモンデスカ?」<NEWLINE>");
  finishEncounter(Trigger(277));
}

section(7) {
  speak(Entity(7), "「ハウ、アー、ユー?どっからきたの?」<NEWLINE>");
  finishEncounter(Trigger(277));
}

section(8) {
  speak(Entity(8), "「ボクのことバカにするな!」<NEWLINE>");
  finishEncounter(Trigger(296));
}

section(9) {
  speak(Entity(9), "「ガブガブしてやるぅ!」<NEWLINE>");
  finishEncounter(Trigger(278));
}

section(51) {
  if (trigger(225)) {
    return;
  }
  if (!trigger(86)) {
    return;
  }
  move(entity: Entity.Player, to: (-715, -2329), sprint: 0, withCamera: true);
  delay(20);
  rotate(entity: Entity.Player, to: 1024);
  delay(5);
  if (trigger(186)) {
    speak(Entity.Player, "「んー、このままほっとくと本当に<NEWLINE> かれてしまいそうだ。」<NEWLINE>");
    showTextbox("「雨でもふればいいんだけど…」<NEWLINE>");
  } else {
    setTrigger(Trigger(186));
    speak(Entity.Player, "「へー、珍しい。芽が出てるよ。」<NEWLINE>");
    delay(20);
    anim(Entity.Player, Animation(16), wait: 20);
    speak(Entity.Player, "「ん?今少し動いたような…<NEWLINE> これがウワサの不思議な植物ってやつか?」<NEWLINE>");
    anim(Entity.Player, Animation(22), wait: 20);
    speak(Entity.Player, "「でも、ちょっとしおれてるなあ。<NEWLINE> このままだと、かれちゃうぞ。」<NEWLINE>");
    playAnimation(Entity.Player, Animation(0));
  }
  {
    speak(Entity.System, "何かアイテムを使いますか?<NEWLINE>");
    setDialogOwner(Entity.Player);
    setSelection(L1, L5);
    showTextbox("「使ってみよう。」<NEWLINE>「使わない。」<NEWLINE>");
    waitForSelectionChoice();
    break;

L1:
    setTrigger(Trigger(3));
    callSubroutine(0);
    if (trigger(3)) {
      speak(Entity.Player, "「今、何も無いんだった…」<NEWLINE>");
      break;
    }
    switch pstat[254] {
      255 => {
        speak(Entity.Player, "「今の持ち物じゃダメだな。」<NEWLINE>");
        break;
      }
      121 => {
        fadeOutHUD();
        callSubroutine(12);
        goto L2;
      }
    }
    speak(Entity.Player, "「これじゃ意味無いか…」<NEWLINE>");
    break;
    return;

L2:
    loadDigimon(Digimon.NPCVegimon);
    setObjectsVisibleRange(3, 15, 0);
    setPStat(PStat(247), 3);
    setPStat(PStat(248), 13);
    callSubroutine(21);
    setObjectsVisibleRange(16, 19, 0);
    setPStat(PStat(247), 16);
    setPStat(PStat(248), 4);
    callSubroutine(21);
    setObjectsVisibleRange(20, 32, 0);
    setPStat(PStat(247), 20);
    setPStat(PStat(248), 13);
    callSubroutine(21);
    delay(50);
    sfx(8, 1, wait: 100);
    setObjectsVisibleRange(3, 32, 1);
    setObjectsVisibleRange(33, 76, 0);
    setPStat(PStat(247), 33);
    setPStat(PStat(248), 44);
    callSubroutine(21);
    delay(30);
    setObjectsVisibleRange(0, 3, 1);
    delay(40);
    playSound(8, 2);
    setDigimon(Digimon.NPCVegimon, Entity(1), 0);
    delay(5);
    playAnimation(Entity(6), Animation(28));
    waitForEntity(Entity(6));
    anim(Entity(6), Animation(0), wait: 20);
    setObjectsVisibleRange(33, 75, 1);
    anim(Entity.Player, Animation(15), wait: 10);
    playSound(8, 2);
    anim(Entity(6), Animation(28), wait: 20);
    playSound(8, 2);
    playAnimation(Entity(6), Animation(28));
    move(entity: Entity(6), to: (-977, -1946), animDuration: 3);
    delay(20);
    playSound(8, 2);
    playAnimation(Entity(6), Animation(28));
    move(entity: Entity(6), to: (-1254, -2263), animDuration: 3);
    delay(20);
    playSound(8, 2);
    playAnimation(Entity(6), Animation(28));
    move(entity: Entity(6), to: (-1025, -2799), animDuration: 3);
    delay(20);
    playSound(8, 2);
    playAnimation(Entity(6), Animation(28));
    move(entity: Entity(6), to: (-1025, -2349), animDuration: 3);
    delay(20);
    look(entity: Entity(6), at: Entity.Player);
    delay(5);
    speak(Entity(6), "'ûûûû!\"\n");
    showTextbox("「ウォッス!オレ、ベジーモン!」<NEWLINE>");
    anim(Entity.Player, Animation(15), wait: 20);
    speak(Entity.Player, "「びっくりした~。植物のデジモンかよ…」<NEWLINE>");
    speak(Entity(6), "「ケケッ、ところでおまえ、ヤサイ好きか?」<NEWLINE>");
    playSound(8, 5);
    anim(Entity.Player, Animation(16), wait: 20);
    speak(Entity.Player, "「なんだよいきなり…ヤサイ?<NEWLINE> うーん…」<NEWLINE>");
    setTrigger(Trigger(49));
    setSelection(L3, L4);
    showTextbox("「好きだな。」<NEWLINE>「キライだな。」<NEWLINE>");
    speak(Entity.Player, "「…やめとこう。」<NEWLINE>");
    return;

L3:
    {
      unsetTrigger(Trigger(49));
      playSound(8, 5);
      speak(Entity(6), "「お、ヤサイ好きに悪いヤツはいねー。」<NEWLINE>");
      break;

L4:
      unsetTrigger(Trigger(49));
      playSound(8, 5);
      speak(Entity(6), "「いかんいかーん!ヤサイはいいぞー。」<NEWLINE>");
      break;
    }
    {
      speak(Entity.Player, "'???\"\n");
      speak(Entity(6), "「よーし決定。オレ、おまえについていく!」<NEWLINE>");
      anim(Entity.Player, Animation(19), wait: 20);
      speak(Entity.Player, "「げ、強引なやつ…ちょっと待てよ!」<NEWLINE>");
      playSound(8, 5);
      speak(Entity(6), "「じゃあついていかない!じゃーな!」<NEWLINE>");
      speak(Entity.Player, "「気まぐれすぎるよ!」<NEWLINE>");
      speak(Entity(6), "「あーん?どうすりゃいーんだよ?」<NEWLINE>");
      anim(Entity.Player, Animation(20), wait: 10);
      speak(Entity.Player, "「えーとな、街に来て何か手伝え!」<NEWLINE>");
      playAnimation(Entity.Player, Animation(0));
      playSound(8, 5);
      speak(Entity(6), "「ケケケ、いーぜ!とにかくここにいるのは<NEWLINE> もうアキた。ケケ!」<NEWLINE>");
      move(entity: Entity.Player, to: (-1024, -1820), sprint: 1, withCamera: true);
      move(entity: Entity.Partner, to: (-741, -1923), sprint: 1);
      break;
    }
    approach(who: Entity(6), x: 911, y: -2266, tries: 10, wait: 10);
    playSound(8, 3);
    speak(Entity.System, "ベジーモンが街に参加した!!!<NEWLINE>");
    followEntity(Entity.Player, speed: 10);
    setTrigger(Trigger(225));
    addPStat(PStat(1), 2);
    return;

L5:
  }
  move(entity: Entity.Player, to: (-61, -2273), sprint: 0, withCamera: true);
  waitForEntity(Entity.Player);
  return;
  garbage { 1c 00 fe 00 1c 00 05 00 6a 00 07 00 9c 00 08 00 d8 00 09 00 0a 01 33 00 38 01 ff ff 24 00 6e 63 19 00 0b 00 6e 0e 18 00 32 00 19 00 74 2c 30 00 50 00 24 00 6e 63 19 00 0b 00 6e 06 18 00 48 00 19 00 74 45 28 00 3c 00 19 00 00 00 56 00 81 00 e1 00 18 00 68 00 19 00 57 00 00 00 57 00 01 00 57 00 02 00 57 00 03 00 fe 00 1b 05 1a 00 81 75 83 41 83 69 83 5e 81 41 83 66 83 57 83 82 83 93 83 66 83 58 83 4a 81 48 81 76 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 15 01 fe 00 1b 07 1a 00 81 75 83 6e 83 45 81 41 83 41 81 5b 81 41 83 86 81 5b 81 48 82 c7 82 c1 82 a9 82 e7 82 ab 82 bd 82 cc 81 48 81 76 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 15 01 fe 00 1b 08 1a 00 81 75 83 7b 83 4e 82 cc 82 b1 82 c6 83 6f 83 4a 82 c9 82 b7 82 e9 82 c8 81 49 81 76 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 28 01 fe 00 1b 09 1a 00 81 75 83 4b 83 75 83 4b 83 75 82 b5 82 c4 82 e2 82 e9 82 a3 81 49 81 76 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 16 01 fe 00 19 00 00 00 e1 00 18 00 46 01 19 00 fe 00 19 00 01 00 56 00 18 00 54 01 19 00 fe 00 52 fd 35 fd e7 f6 00 00 67 00 14 00 4d fd 00 04 67 00 05 00 19 00 00 00 ba 00 18 00 de 01 19 00 1b fd 1a 00 81 75 82 f1 81 5b 81 41 82 b1 82 cc 82 dc 82 dc 82 d9 82 c1 82 c6 82 ad 82 c6 96 7b 93 96 82 c9 0d 00 81 40 82 a9 82 ea 82 c4 82 b5 82 dc 82 a2 82 bb 82 a4 82 be 81 42 81 76 0d 00 00 00 1a 00 81 75 89 4a 82 c5 82 e0 82 d3 82 ea 82 ce 82 a2 82 a2 82 f1 82 be 82 af 82 c7 81 63 81 76 0d 00 00 00 16 00 ba 02 1c 00 ba 00 1b fd 1a 00 81 75 82 d6 81 5b 81 41 92 bf 82 b5 82 a2 81 42 89 e8 82 aa 8f 6f 82 c4 82 e9 82 e6 81 42 81 76 0d 00 00 00 67 00 14 00 56 00 fd 10 67 00 14 00 1b fd 1a 00 81 75 82 f1 81 48 8d a1 8f ad 82 b5 93 ae 82 a2 82 bd 82 e6 82 a4 82 c8 81 63 0d 00 81 40 82 b1 82 ea 82 aa 83 45 83 8f 83 54 82 cc 95 73 8e 76 8b 63 82 c8 90 41 95 a8 82 c1 82 c4 82 e2 82 c2 82 a9 81 48 81 76 0d 00 00 00 56 00 fd 16 67 00 14 00 1b fd 1a 00 81 75 82 c5 82 e0 81 41 82 bf 82 e5 82 c1 82 c6 82 b5 82 a8 82 ea 82 c4 82 e9 82 c8 82 a0 81 42 0d 00 81 40 82 b1 82