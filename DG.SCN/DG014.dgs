// DG014.SCN
#include "functions.dgs"
#pragma script index=14 start=0xf800 end=0x10000 headerU16=0x20 sentinelOff=0x24

section onEnter(254) {
    roll(pstat: 110, max: 99);
    if (pstat[110] > 15) goto L1;
    spawnItem(Item.Digimushroom, x: 25, y: 33);

L1:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 4) goto L2;
    spawnItem(Item.Digimushroom, x: 63, y: 31);

L2:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 1) goto L3;
    spawnItem(Item.DeluxeMushroom, x: 53, y: 81);

L3:
    return;
}

section(5) {
    speak(5, "Hiss!\n");
    startBattle();
    setTrigger(267);
    return;
}

section(6) {
    speak(6, "Whewww!\n");
    startBattle();
    setTrigger(267);
    return;
}

section(7) {
    speak(7, "Shoeeeee\n");
    startBattle();
    setTrigger(267);
    return;
}

section(8) {
    speak(8, "I won't play with you\nanymore!\n");
    startBattle();
    setTrigger(296);
    return;
}

section(9) {
    speak(9, "Ya-hoo! Alright!\n");
    startBattle();
    setTrigger(278);
    return;
}

section(10) {
    speak(10, "Ha ha ha! Yeah!\n");
    startBattle();
    setTrigger(278);
    return;
