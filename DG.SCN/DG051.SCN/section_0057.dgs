// source: extract/DIGIMON/SCN/DG.SCN
// DG051.SCN, section 57

section section_57(57) {  // len=1404
    if (!trigger(358) || !trigger(359) || trigger(360)) goto L_03fa;
    setTrigger(360);
    loadDigimon(Digimon.Devimon);
    setDigimon(Digimon.Devimon, 0, 0);
    setDialogOwner(Entity.Player);
    playAnimation(Entity.Player, 25);
    delay(15);
    showTextbox("I got a bad feeling....\n");
    playAnimation(Entity.Player, 0);
    look(entity: Entity.Player, at: 5);
    delay(10);
    moveCamera(to: (0, 1614), slowdown: 20);
    waitForEntity(200);
    setDialogOwner(5);
    showTextbox("I knew you'd come!\n");
    move(entity: Entity.Player, to: (-150, -239), sprint: 1);
    move(entity: Entity.Partner, to: (150, -239), sprint: 1);
    waitForEntity(Entity.Player);
    waitForEntity(Entity.Partner);
    look(entity: Entity.Player, at: 5);
    look(entity: Entity.Partner, at: 5);
    delay(5);
    setDialogOwner(Entity.Player);
    showTextbox("Who are you?\n");
    setDialogOwner(5);
    showTextbox("I'm Devimon, a dark angel.\nI hold the power of darkness.\n");
    setDialogOwner(Entity.Player);
    showTextbox("Do you know something?\n");
    setDialogOwner(5);
    showTextbox("Myotismon, is in the mansion.\nMaybe he's alive.\n");
    playAnimation(Entity.Player, 20);
    delay(15);
    setDialogOwner(Entity.Player);
    showTextbox("Did you do this?\n");
    playAnimation(Entity.Player, 0);
    setDialogOwner(5);
    showTextbox("I don't know...all I know\nis that you're my enemy.\n");
    playAnimation(5, 28);
    playSound(8, 8);
    delay(20);
    setDialogOwner(Entity.Player);
    showTextbox("You won't get away!\n");
    move(entity: Entity.Player, to: (-150, 921), sprint: 1);
    move(entity: Entity.Partner, to: (150, 721), sprint: 1);
    delay(20);
    look(entity: Entity.Player, at: 5);
    delay(5);
    setDialogOwner(5);
    showTextbox("Ha ha ha!\n");
    move(entity: 5, to: (145, 795), animDuration: 5);
    waitForEntity(5);
    moveCamera(to: (0, 1614), slowdown: 20);
    waitForEntity(200);
    move(entity: 5, to: (0, -489), animDuration: 5);
    waitForEntity(5);
    look(entity: Entity.Player, at: 5);
    delay(10);
    setDialogOwner(Entity.Player);
    showTextbox("Oh no!\n");
    look(entity: Entity.Player, at: 5);
    delay(10);
    look(entity: 5, at: Entity.Player);
    delay(10);
    setDialogOwner(5);
    showTextbox("Say hi to Myotismon for me.\n");
    move(entity: Entity.Player, to: (50, 250), sprint: 1);
    move(entity: 5, to: (50, -1640), animDuration: 12);
    waitForEntity(5);
    waitForEntity(Entity.Player);
    unloadEntity(5);
    move(entity: Entity.Player, to: (50, -480), sprint: 1);
    waitForEntity(Entity.Player);
    setDialogOwner(Entity.Player);
    showTextbox("He got away!\nI don't like that guy.\n");
    moveCamera(to: Entity.Player, speed: 10);
    waitForEntity(200);
    return;
L_03fa:
    if (trigger(121)) goto L_057a;
    setTrigger(121);
    delay(20);
    rotate(entity: Entity.Player, to: 2048);
    waitForEntity(Entity.Player);
    delay(10);
    rotate(entity: Entity.Player, to: 2560);
    waitForEntity(Entity.Player);
    delay(10);
    rotate(entity: Entity.Player, to: 1536);
    waitForEntity(Entity.Player);
    delay(10);
    moveCamera(to: (-997, -977), slowdown: 30);
    waitForEntity(200);
    moveCamera(to: (-1035, 4000), slowdown: 50);
    waitForEntity(200);
    moveCamera(to: (1222, 4000), slowdown: 30);
    waitForEntity(200);
    moveCamera(to: (1066, -977), slowdown: 50);
    waitForEntity(200);
    rotate(entity: Entity.Player, to: 2560);
    moveCamera(to: Entity.Player, speed: 30);
    waitForEntity(200);
    rotate(entity: Entity.Player, to: 2048);
    rotate(entity: Entity.Partner, to: 2048);
    waitForEntity(Entity.Player);
    waitForEntity(Entity.Partner);
    setDialogOwner(Entity.Player);
    showTextbox("What a big mansion!\n");
    move(entity: Entity.Player, to: (-6, -1255), sprint: 0, withCamera: true);
    waitForEntity(Entity.Player);
    playAnimation(Entity.Player, 24);
    delay(15);
    setDialogOwner(Entity.Player);
    showTextbox("Anybody home?\n");
    playAnimation(Entity.Player, 0);
    delay(40);
    look(entity: Entity.Player, at: Entity.Partner);
    waitForEntity(Entity.Player);
    look(entity: Entity.Partner, at: Entity.Player);
    waitForEntity(Entity.Partner);
    setDialogOwner(Entity.Player);
    showTextbox("No one's home or\nthey can't hear me.\n");
    rotate(entity: Entity.Player, to: 3584);
    waitForEntity(Entity.Player);
    rotate(entity: Entity.Player, to: 3072);
    waitForEntity(Entity.Player);
    rotate(entity: Entity.Player, to: 2560);
    waitForEntity(Entity.Player);
    rotate(entity: Entity.Player, to: 2048);
    waitForEntity(Entity.Player);
    showTextbox("Alright. Start exploring!\n");
    return;
L_057a:
    return;
}
