// source: extract/DIGIMON/SCN/DG.SCN
// DG051.SCN, section 81

section section_81(81) {  // len=160
    if (trigger(360)) goto L_0086;
    rotate(entity: Entity.Player, to: 3072);
    playSound(8, 2);
    delay(5);
    playSound(8, 2);
    setDialogOwner(Entity.System);
    showTextbox("It doesn't open. It's sealed\nwith a weird force.\n");
    return;
L_0086:
    rotate3DObject(1, 1);
    playSound(8, 1);
    delay(10);
    move(entity: Entity.Player, to: (2000, -722), sprint: 0);
    warp(to: Map.YAKA18, spawn: 0, trigger: 255);
    return;
}
