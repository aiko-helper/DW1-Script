// DG039.SCN
#include "functions.dgs"
#pragma script index=39 start=0x1e800 end=0x1f000 headerU16=0x28 sentinelOff=0x24
#include "entities.dgs"

section onEnter(254) {
  spawnItemChance(max: 99, chance: 9, item: Item.Digimushroom, x: 69, y: 49);
  spawnItemChance(max: 99, chance: 2, item: Item.Happymushroom, x: 37, y: 33);
  return;
}

section(5) {
  speak(Entity(5), "「ノリが悪いなぁ!」<NEWLINE>");
  finishEncounter(Trigger(293));
}

section(6) {
  speak(Entity(6), "「ハハ、なにか言った?」<NEWLINE>");
  finishEncounter(Trigger(293));
}

section(7) {
  speak(Entity(7), "「ほんとにムリだってば…」<NEWLINE>");
  finishEncounter(Trigger(299));
}

section(8) {
  speak(Entity(8), "「あんまり自信ないんだよなぁ、ボク。」<NEWLINE>");
  finishEncounter(Trigger(299));
}

section(9) {
  speak(Entity(9), "「てかげんしてよ…」<NEWLINE>");
  finishEncounter(Trigger(299));
}

section(10) {
  speak(Entity(10), "「ケッ、なめんなよ!」<NEWLINE>");
  finishEncounter(Trigger(280));
}

section(81) {
  {
    rotate(entity: Entity.Player, to: 2128);
    delay(5);
    speak(Entity.System, " <NEWLINE>       エレベーター<NEWLINE>");
    setDialogOwner(Entity.Player);
    setSelection(L1, L2, L3);
    showTextbox("屋上ボタンを押す<NEWLINE>上ボタンを押す<NEWLINE>乗らない<NEWLINE>");
    waitForSelectionChoice();
    break;

L1:
    if (!trigger(155)) {
      anim(Entity.Player, Animation(16), wait: 15);
      speak(Entity.Player, "「うーん、反応が無いな…」<NEWLINE>");
      playAnimation(Entity.Player, Animation(0));
      rotate(entity: Entity.Player, to: 2297);
      delay(10);
      rotate(entity: Entity.Player, to: 1785);
      delay(10);
      rotate(entity: Entity.Player, to: 2297);
      showTextbox("「およ、機械に小石がはさまってる。<NEWLINE> さてはこれか…?」<NEWLINE>");
      anim(Entity.Player, Animation(25), wait: 20);
      speak(Entity.System, "小石をとりのぞいた!<NEWLINE>");
      speak(Entity.Player, "「これでいいはずだ。」<NEWLINE>");
      setTrigger(Trigger(155));
      return;
    } else {
      playSound(8, 4);
      rotate3DObject(0, 1);
      delay(1);
      rotate3DObject(1, 1);
      delay(1);
      rotate3DObject(0, 1);
      delay(1);
      rotate3DObject(1, 1);
      delay(1);
      rotate3DObject(0, 1);
      delay(1);
      rotate3DObject(1, 1);
      delay(1);
      rotate3DObject(0, 1);
      delay(1);
      rotate3DObject(1, 1);
      delay(1);
      playSound(8, 5);
      warp(to: Map.GCAN10, spawn: 0, trigger: 52);
      return;
    }
    return;

L2:
    fadeOutHUD();
    if (!trigger(155)) {
      anim(Entity.Player, Animation(16), wait: 15);
      speak(Entity.Player, "「うーん、反応が無いな…」<NEWLINE>");
      playAnimation(Entity.Player, Animation(0));
      rotate(entity: Entity.Player, to: 2297);
      delay(10);
      rotate(entity: Entity.Player, to: 1785);
      delay(10);
      rotate(entity: Entity.Player, to: 2297);
      showTextbox("「およ、機械に小石がはさまってる。<NEWLINE> さてはこれか…?」<NEWLINE>");
      speak(Entity.System, "小石をとりのぞいた!<NEWLINE>");
      speak(Entity.Player, "「これでいいはずだ。」<NEWLINE>");
      setTrigger(Trigger(155));
      return;
    } else {
      playSound(8, 4);
      rotate3DObject(0, 1);
      delay(1);
      rotate3DObject(1, 1);
      delay(1);
      rotate3DObject(0, 1);
      delay(1);
      rotate3DObject(1, 1);
      delay(1);
      rotate3DObject(0, 1);
      delay(1);
      rotate3DObject(1, 1);
      delay(1);
      rotate3DObject(0, 1);
      delay(1);
      rotate3DObject(1, 1);
      delay(1);
      playSound(8, 5);
      warp(to: Map.GCAN03, spawn: 2, trigger: 55);
      return;
    }
    return;

L3:
  }
  return;
}

