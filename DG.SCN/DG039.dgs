// DG039.SCN
#include "functions.dgs"
#pragma script index=39 start=0x20000 end=0x20800 headerU16=0x10 sentinelOff=0x1875

section onEnter(254) {
  spawnChest(Item.DefenseChip, 1460, -443, 3072, 666);
  return;
}

section(6) {
  speak(6, "Am I bothering you?\n");
  startBattle();
  setTrigger(280);
  return;
}

section(51) {
  if (!trigger(175) || !trigger(180) || trigger(182)) goto L1;
  goto L3;

L1:
  if (!trigger(181) || !trigger(182) || trigger(235)) goto L2;
  return;

L2:
  return;

L3:
  playSound(8, 12);
  speak(Entity.System, "<YELLOW>??? <WHITE>\nHelp me!\n");
  rotate(entity: Entity.Player, to: 1321);
  rotate(entity: Entity.Partner, to: 1321);
  delay(10);
  playAnimation(Entity.Player, 23);
  delay(15);
  speak(Entity.Player, "I hear a voice from above.\nAnybody there?\n");
  playAnimation(Entity.Player, 0);
  delay(10);
  speak(Entity.System, "<YELLOW>??? <WHITE>\nAnybody there?\n");
  delay(10);
  speak(Entity.Player, "Yes, there is.\n");
  delay(10);
  speak(Entity.System, "<YELLOW>??? <WHITE>\nHelp me!\nThe ground is bulging up.\n");
  delay(10);
  speak(Entity.Player, "You gotta be kidding.\n");
  delay(10);
  playSound(8, 11);
  speak(Entity.System, "<YELLOW>??? <WHITE>\nNo, it's true.\nI hear some machinery noise.\n");
  delay(10);
  playAnimation(Entity.Player, 16);
  delay(15);
  speak(Entity.Player, "A machine? It must be coming\nfrom Ogremon's hideout.\n");
  playAnimation(Entity.Player, 0);
  delay(10);
  speak(Entity.System, "<YELLOW>??? <WHITE>\nYou must have done\nsomething wrong there, no?\n");
  delay(10);
  speak(Entity.Player, "I did many things. It could\nbe the elevator.... I'll go\nback to the hideout and check.\n");
  delay(10);
  playSound(8, 11);
  speak(Entity.System, "<YELLOW>??? <WHITE>\nThanks.\n");
  delay(10);
  setTrigger(182);
  return;
