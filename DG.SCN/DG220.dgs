// DG220.SCN
#include "functions.dgs"
#pragma script index=220 start=0xa3000 end=0xa5000 headerU16=0x18 sentinelOff=0xfe
#include "entities.dgs"

section onEnter(254) {
  return;
}

section(81) {
  look(entity: Entity.Player, at: Entity(5));
  look(entity: Entity(5), at: Entity.Player);
  delay(5);
  panTo(x: 83, y: 1113, slowdown: 20);
  if (!trigger(91)) {
    setTrigger(Trigger(91));
    speak(Entity(5), "「来たな、<LIGHTBLUE><PLAYER><WHITE>、<ORANGE><DIGIMON><WHITE>!<NEWLINE> 見ろ、これこそがはじまりの街の<NEWLINE> 闘技場だ!」<NEWLINE>");
    showTextbox("「じきに参加者や客もいっぱい来る。<NEWLINE> おまえ達もみんなを喜ばせてやるのだな!」<NEWLINE>");
    showTextbox("「大会の優勝者には賞品や賞金を用意する。<NEWLINE> 参加してそんはないはずだ。」<NEWLINE>");
    showTextbox("「大会の内容などについては、そこにある<NEWLINE> マシンでチェックしておくといい。」<NEWLINE>");
    return;
  }
  goto L2;

L1:
  loop {
    return;

L2:
    storeDigimonType(PStat(103));
    {
      if (pstat[103] == 1 || pstat[103] == 2 || pstat[103] == 15 || pstat[103] == 16) {
        speak(Entity(5), "「ん、幼年期のデジモンではエントリーは<NEWLINE> できないぞ。スケジュールの確認だけ<NEWLINE> するか?」<NEWLINE>");
        break;
      }
      if (pstat[103] == 29 || pstat[103] == 30 || pstat[103] == 43 || pstat[103] == 44) {
        speak(Entity(5), "「ん、幼年期のデジモンではエントリーは<NEWLINE> できないぞ。スケジュールの確認だけ<NEWLINE> するか?」<NEWLINE>");
        break;
      }
      if (!trigger(37)) {
        speak(Entity(5), "「よく来たな、大会参加エントリーを<NEWLINE> するか?」<NEWLINE>");
        break;
      }
      goto L4;
    }
    setDialogOwner(Entity.Player);
    setSelection(L3, L1, L8);
    showTextbox("「する。」<NEWLINE>「しない。」<NEWLINE>「エントリーって?」<NEWLINE>");
    waitForSelectionChoice();
    return;

L3:
    setPStat(PStat(254), 5);
    callSubroutine(18);
    followEntity(Entity.Player, speed: 10);
    return;

L4:
    {
      if (pstat[2] >= 128) {
        break;
        break;
      }
      goto L5;
    }
    speak(Entity(5), "「明日の『-<TOURNAMENT>-』に<NEWLINE> エントリー中だな。」<NEWLINE>");
    showTextbox("「エントリーを中止するのか?」<NEWLINE>");
    setDialogOwner(Entity.Player);
    setSelection(L1, L7);
    showTextbox("「しない。」<NEWLINE>「する。」<NEWLINE>");
    waitForSelectionChoice();
    continue;
    followEntity(Entity.Player, speed: 10);
    return;

L5:
    pstat[:SavedTime] = time();
    if (pstat[107] in 0..10) {
      speak(Entity(5), "「今日の『-<TOURNAMENT>-』に<NEWLINE> エントリーしているな。朝の10時から<NEWLINE> 入場できるぞ。」<NEWLINE>");
      showTextbox("「まさかエントリーを中止する気か?」<NEWLINE>");
      setDialogOwner(Entity.Player);
      setSelection(L1, L7);
      showTextbox("「しない。」<NEWLINE>「する。」<NEWLINE>");
      waitForSelectionChoice();
      continue;
      followEntity(Entity.Player, speed: 10);
      goto L6;
    }
    speak(Entity(5), "「今日の『-<TOURNAMENT>-』に<NEWLINE> エントリーしているな。<NEWLINE> 夜11時までには入場してくれよ。」<NEWLINE>");
    showTextbox("「まさかエントリーを中止する気か?」<NEWLINE>");
    setDialogOwner(Entity.Player);
    setSelection(L1, L7);
    showTextbox("「しない。」<NEWLINE>「する。」<NEWLINE>");
    waitForSelectionChoice();
  }
  followEntity(Entity.Player, speed: 10);

L6:
  return;

L7:
  unsetTrigger(Trigger(37));
  speak(Entity(5), "「では取り消しておくぞ。」<NEWLINE>");
  return;

L8:
  speak(Entity(5), "「エントリーして開始時間に左の階段を<NEWLINE> 下りることではじめて闘技大会に<NEWLINE> 出場できるのだ。」<NEWLINE>");
  showTextbox("「エントリーは無料だ。当日と1日後の<NEWLINE> 大会にのみエントリーできる。」<NEWLINE>");
  showTextbox("「ただし当日の大会は朝10時までに<NEWLINE> エントリーしなくてはならないぞ。」<NEWLINE>");
  showTextbox("「5日後のスケジュールまでは<NEWLINE> 確認できるから、少し前から予定を<NEWLINE> たてておくといいな。」<NEWLINE>");
  showTextbox("「赤で表示されている大会は、参加できない<NEWLINE> ことを示している。だがスタートボタンで<NEWLINE> 内容だけは確認可能だ。」<NEWLINE>");
  showTextbox("「あと、『参加資格-とくになし』の大会<NEWLINE> であっても、幼年期のデジモンは<NEWLINE> 参加することはできないからな。」<NEWLINE>");
  showTextbox("「まあ、エントリーについてはこんな感じだ。<NEWLINE> どうする?エントリーしてみるか?」<NEWLINE>");
  setDialogOwner(Entity.Player);
  setSelection(L3, L1, L8);
  showTextbox("「する。」<NEWLINE>「しない。」<NEWLINE>「ごめん、もう一回説明して。」<NEWLINE>");
  waitForSelectionChoice();
  return;
  return;
}

section(54) {
  if (!trigger(37) || pstat[3] == 22) {
    look(entity: Entity(5), at: Entity.Player);
    look(entity: Entity.Player, at: Entity(5));
    delay(5);
    speak(Entity(5), "「おい、大会にエントリーしてないぞ。」<NEWLINE>");
    move(entity: Entity.Player, to: (-824, 1146), sprint: 1);
    waitForEntity(Entity.Player);
    followEntity(Entity.Player, speed: 10);
    return;
  }
  if (pstat[2] >= 128) {
    look(entity: Entity(5), at: Entity.Player);
    look(entity: Entity.Player, at: Entity(5));
    delay(5);
    speak(Entity(5), "「おい、大会は明日だぞ。」<NEWLINE>");
    move(entity: Entity.Player, to: (-824, 1146), sprint: 1);
    waitForEntity(Entity.Player);
    followEntity(Entity.Player, speed: 10);
    return;
  }
  pstat[:SavedTime] = time();
  if (pstat[107] < 10) {
    look(entity: Entity(5), at: Entity.Player);
    look(entity: Entity.Player, at: Entity(5));
    delay(5);
    speak(Entity(5), "「まだ入場時間前だ。10時まで<NEWLINE> 待ってくれ。」<NEWLINE>");
    move(entity: Entity.Player, to: (-824, 1146), sprint: 1);
    waitForEntity(Entity.Player);
    followEntity(Entity.Player, speed: 10);
    return;
  }
  {
    roll(pstat: PStat.RollScratch, max: 99);
    if (!trigger(40)) break;
    if (stat[Stat.TamerLevel] == 0) break;
    if (pstat[110] > 29) break;
    reduceStats(tamerLevel: 1);
    speak(Entity.System, " <NEWLINE> <PINK>テイマーレベルが下がった!!!<WHITE><NEWLINE>");
  }
  setPStat(PStat(254), 5);
  callSubroutine(6);
  pstat[:SavedTime] = time();
  addMinutesToDate(PStat.SavedTime, 360);
  advanceToDate(PStat.SavedTime);
  if (trigger(50)) {
    warp(to: Map.ROOM19, spawn: 3, trigger: 61);
    return;
  }
  warp(to: Map.ROOM13, spawn: 3, trigger: 61);
  return;
}

