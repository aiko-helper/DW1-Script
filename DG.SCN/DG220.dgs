// DG220.SCN
#include "functions.dgs"
#pragma script index=220 start=0xc1000 end=0xc2000 headerU16=0xc sentinelOff=0xfe
#include "entities.dgs"

section onEnter(254) {
  return;
}

section(83) {
  if (trigger(203)) {
    return;
  }
  playSound(0, 0);
  speak(Entity.System, "<YELLOW>Poyomon <WHITE>\nPoyomon. My name is Poyomon.\n");
  if (pstat[1] >= 30) {
    speak(Entity.System, "<YELLOW>Poyomon <WHITE>\nI'll talk about digivolution.\nWell... It's about the next\nstage after Champion Digimon.\n");
    showTextbox("<YELLOW>Poyomon <WHITE>\nIt's called Ultimate Digimon.\nBut there is no guarantee a\nChampion always digivolves.\n");
    showTextbox("<YELLOW>Poyomon <WHITE>\nConditions to digivolve are\ntough, but once at Ultimate,\nyour life span gets longer.\n");
    showTextbox("<YELLOW>Poyomon <WHITE>\nWith Digivolution Items,\nlife span doesn't increase.\n");
    playSound(0, 1);
    return;
  }
  if (pstat[1] >= 15) {
    speak(Entity.System, "<YELLOW>Poyomon <WHITE>\nI'll talk about digivolution.\nWell... It's about the \nconditions to digivolve.\n");
    showTextbox("<YELLOW>Poyomon <WHITE>\nFirst, weight has to be close\nto next stage weight range.\n");
    showTextbox("<YELLOW>Poyomon <WHITE>\nNext, higher parameters are\nbetter, but the effects of\neach are different.\n");
    showTextbox("<YELLOW>Poyomon <WHITE>\nCare mistakes. Depending on\nthe kind of Digimon you want,\nsometimes mistakes are good.\n");
    showTextbox("<YELLOW>Poyomon <WHITE>\nOh yeah, there are other\nspecial conditions to\nbecome certain Digimon.\n");
    showTextbox("<YELLOW>Poyomon <WHITE>\nLike, especially high\nDiscipline, or many battles.\n");
    showTextbox("<YELLOW>Poyomon <WHITE>\nIf you do this, even if the\nthree basic conditions are not\nfully met, you can digivolve.\n");
    playSound(0, 1);
    return;
  }
  speak(Entity.System, "<YELLOW>Poyomon <WHITE>\nJiji told me that <ORANGE><DIGIMON><WHITE>\nwould be digivolving.\n");
  showTextbox("<YELLOW>Poyomon <WHITE>\nIt takes six hours from Baby\nto In-Training Digimon.\n");
  showTextbox("<YELLOW>Poyomon <WHITE>\nAnd it only takes one day to\ngo to Rookie Digimon stage.\n");
  showTextbox("<YELLOW>Poyomon <WHITE>\nThe next stage of Champion\ntakes about three days.\n");
  showTextbox("<YELLOW>Poyomon <WHITE>\nHow long to next stage? I\nforgot, but it takes longer.\n");
  showTextbox("<YELLOW>Poyomon <WHITE>\nWeight, Parameters and Care\nMistakes affect digivolution.\n");
  showTextbox("<YELLOW>Poyomon <WHITE>\nI'm not sure on details, so\nI'll ask Jiji next time.\n");
  playSound(0, 1);
  return;
  garbage { 0c 00 fe 00 0c 00 53 00 0e 00 ff ff fe 00 19 00 00 00 cb 00 18 00 1c 00 19 00 fe 00 5a 00 00 00 1b ff 1a 00 01 07 82 6f 82 8f 82 99 82 8f 82 8d 82 8f 82 8e 81 40 01 01 0d 00 82 6f 82 8f 82 99 82 8f 82 8d 82 8f 82 8e 81 42 81 40 82 6c 82 99 81 40 82 8e 82 81 82 8d 82 85 81 40 82 89 82 93 81 40 82 6f 82 8f 82 99 82 8f 82 8d 82 8f 82 8e 81 42 0d 00 00 00 19 00 0a 00 01 1e 18 00 62 03 19 00 1b ff 1a 00 01 07 82 6f 82 8f 82 99 82 8f 82 8d 82 8f 82 8e 81 40 01 01 0d 00 82 68 81 75 82 8c 82 8c 81 40 82 94 82 81 82 8c 82 8b 81 40 82 81 82 82 82 8f 82 95 82 94 81 40 82 84 82 89 82 87 82 89 82 96 82 8f 82 8c 82 95 82 94 82 89 82 8f 82 8e 81 42 0d 00 82 76 82 85 82 8c 82 8c 81 42 81 42 81 42 81 40 82 68 82 94 81 75 82 93 81 40 82 81 82 82 82 8f 82 95 82 94 81 40 82 94 82 88 82 85 81 40 82 8e 82 85 82 98 82 94 0d 00 82 93 82 94 82 81 82 87 82 85 81 40 82 81 82 86 82 94 82 85 82 92 81 40 82 62 82 88 82 81 82 8d 82 90 82 89 82 8f 82 8e 81 40 82 63 82 89 82 87 82 89 82 8d 82 8f 82 8e 81 42 0d 00 00 00 1a 00 01 07 82 6f 82 8f 82 99 82 8f 82 8d 82 8f 82 8e 81 40 01 01 0d 00 82 68 82 94 81 75 82 93 81 40 82 83 82 81 82 8c 82 8c 82 85 82 84 81 40 82 74 82 8c 82 94 82 89 82 8d 82 81 82 94 82 85 81 40 82 63 82 89 82 87 82 89 82 8d 82 8f 82 8e 81 42 0d 00 82 61 82 95 82 94 81 40 82 94 82 88 82 85 82 92 82 85 81 40 82 89 82 93 81 40 82 8e 82 8f 81 40 82 87 82 95 82 81 82 92 82 81 82 8e 82 94 82 85 82 85 81 40 82 81 0d 00 82 62 82 88 82 81 82 8d 82 90 82 89 82 8f 82 8e 81 40 82 81 82 8c 82 97 82 81 82 99 82 93 81 40 82 84 82 89 82 87 82 89 82 96 82 8f 82 8c 82 96 82 85 82 93 81 42 0d 00 00 00 1a 00 01 07 82 6f 82 8f 82 99 82 8f 82 8d 82 8f 82 8e 81 40 01 01 0d 00 82 62 82 8f 82 8e 82 84 82 89 82 94 82 89 82 8f 82 8e 82 93 81 40 82 94 82 8f 81 40 82 84 82 89 82 87 82 89 82 96 82 8f 82 8c 82 96 82 85 81 40 82 81 82 92 82 85 0d 00 82 94 82 8f 82 95 82 87 82 88 81 43 81 40 82 82 82 95 82 94 81 40 82 8f 82 8e 82 83 82 85 81 40 82 81 82 94 81 40 82 74 82 8c 82 94 82 89 82 8d 82 81 82