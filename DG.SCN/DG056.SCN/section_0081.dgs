// source: extract/DIGIMON/SCN/DG.SCN
// DG056.SCN, section 81

section section_81(81) {  // len=220
    if (item[Item.MansionKey] < 1 || trigger(115)) goto L_005c;
    rotate(entity: Entity.Player, to: 3138);
    playSound(8, 3);
    setDialogOwner(Entity.System);
    showTextbox("I used the\n<LIGHTBLUE>Mansion Key<WHITE>!\n");
    setTrigger(115);
    goto L_00c2;
L_005c:
    if (item[Item.MansionKey] >= 1 || trigger(115)) goto L_00c2;
    rotate(entity: Entity.Player, to: 3138);
    playSound(8, 2);
    delay(5);
    playSound(8, 2);
    setDialogOwner(Entity.System);
    showTextbox("It doesn't open.\nIt's locked.\n");
    return;
L_00c2:
    rotate3DObject(3, 1);
    playSound(8, 1);
    delay(10);
    move(entity: Entity.Player, to: (700, 50), sprint: 0);
    warp(to: Map.YAKA16, spawn: 0, trigger: 255);
    return;
}
