// source: extract/DIGIMON/SCN/DG.SCN
// DG216.SCN, section 52

section section_52(52) {  // len=2510
    setDialogOwner(5);
    showTextbox("Does he feel more relaxed?\n");
    showTextbox("Still need something?\n");
    setDialogOwner(Entity.Player);
    setSelection(section_51.L_044a, L_00d2, L_018c);
    showTextbox("We'll rest more\nSell me Medicine\nNothing\n");
    waitForSelectionChoice();
    goto L_018c;
L_00d2:
    setDialogOwner(5);
    showTextbox("He should be fine.\n");
    setDialogOwner(Entity.Player);
    setSelection(L_0548, L_061e, L_018c);
    showTextbox("Bandage: four hund bits\nMedicine: twelve hund bits\nDon't buy\n");
    waitForSelectionChoice();
    goto L_018c;
L_018c:
    setDialogOwner(5);
    showTextbox("When he doesn't feel good,\ncome see me.\n");
    roll(pstat: 110, max: 9);
    if (pstat[110] > 0) goto L_0288;
    setDialogOwner(5);
    showTextbox("If he's still tired,\ntrain less, and make him\neat and sleep regularly.\n");
    return;
L_0288:
    if (pstat[110] > 1) goto L_0318;
    setDialogOwner(5);
    showTextbox("Staying in cold or hot\nplaces for too long\ncan cause illness.\n");
    return;
L_0318:
    if (pstat[110] > 2) goto L_0372;
    setDialogOwner(5);
    showTextbox("A bandage is only good\nfor wounds.\n");
    return;
L_0372:
    if (pstat[110] > 3) goto L_0410;
    setDialogOwner(5);
    showTextbox("You can treat sickness\nwith Medicine, but it\nwon't reduce Tiredness.\n");
    return;
L_0410:
    if (pstat[110] > 4) goto L_04a8;
    setDialogOwner(5);
    showTextbox("If HP is low at the end\nof a battle, Digimon\ncan get hurt easily.\n");
    return;
L_04a8:
    if (pstat[110] > 5) goto L_0546;
    setDialogOwner(5);
    showTextbox("Keeping Happiness and\nTiredness at good levels\nleads to long life.\n");
    return;
    goto L_0548;
L_0546:
    return;
L_0548:
    if (money >= 400) goto L_05ca;
    setDialogOwner(5);
    showTextbox("You don't have enough bits.\nI can't sell you that.\n");
    goto L_06f4;
    return;
L_05ca:
    giveItem(Item.Bandage, 1);
    if (!trigger(0)) goto L_0614;
    setDialogOwner(5);
    showTextbox("You have too many Items.\n");
    return;
L_0614:
    reduceMoney(400);
    goto L_06f4;
L_061e:
    if (money >= 1200) goto L_06a0;
    setDialogOwner(5);
    showTextbox("You don't have enough bits.\nI can't sell you that.\n");
    goto L_06f4;
    return;
L_06a0:
    giveItem(Item.Medicine, 1);
    if (!trigger(0)) goto L_06ea;
    setDialogOwner(5);
    showTextbox("You have too many Items.\n");
    return;
L_06ea:
    reduceMoney(1200);
    goto L_06f4;
L_06f4:
    setDialogOwner(5);
    showTextbox("Still need something?\n");
    setDialogOwner(Entity.Player);
    setSelection(section_51.L_044a, L_00d2, L_018c);
    showTextbox("Get rid of his Tiredness\nSell me more Medicine\nNo, nothing\n");
    waitForSelectionChoice();
    goto L_018c;
    return;
    garbage { 10 00 fe 00 10 00 33 00 12 00 34 00 32 06 ff ff fe 00 19 00 01 00 35 00 18 00 1a 01 19 00 1c 00 35 00 1b 05 1a 00 82 67 82 85 82 8c 82 8c 82 8f 81 43 81 40 01 06 05 00 01 01 81 42 0d 00 82 72 82 95 82 92 82 90 82 92 82 89 82 93 82 85 81 49 81 40 82 68 81 40 82 8f 82 90 82 85 82 8e 82 85 82 84 0d 00 82 81 81 40 82 83 82 8c 82 89 82 8e 82 89 82 83 81 49 0d 00 00 00 1a 00 82 68 82 94 81 75 82 93 81 40 82 86 82 8f 82 92 81 40 82 94 82 92 82 85 82 81 82 94 82 89 82 8e 82 87 81 40 82 93 82 89 82 83 82 8b 82 8e 82 85 82 93 82 93 0d 00 82 81 82 8e 82 84 81 40 82 89 82 8e 82 8a 82 95 82 92 82 89 82 85 82 93 81 42 81 40 82 68 82 94 81 75 82 93 81 40 82 8e 82 8f 82 94 81 40 82 86 82 92 82 85 82 85 81 43 0d 00 82 82 82 95 82 94 81 40 82 89 82 94 81 40 82 97 82 89 82 8c 82 8c 81 40 82 82 82 85 81 40 82 83 82 88 82 85 82 81 82 90 81 42 0d 00 00 00 19 00 23 00 20 01 a3 00 40 01 18 00 2e 01 19 00 16 00 88 03 1b 05 1a 00 82 78 82 8f 82 95 82 92 81 40 82 63 82 89 82 87 82 89 82 8d 82 8f 82 8e 81 40 82 84 82 8f 82 85 82 93 82 8e 81 75 82 94 81 40 82 8c 82 8f 82 8f 82 8b 0d 00 82 97 82 85 82 8c 82 8c 81 42 81 40 82 78 82 8f 82 95 81 40 82 8e 82 85 82 85 82 84 81 40 82 94 82 8f 81 40 82 94 82 81 82 8b 82 85 0d 00 82 83 82 81 82 92 82 85 81 40 82 8f 82 86 81 40 82 88 82 89 82 93 81 40 82 88 82 85 82 81 82 8c 82 94 82 88 81 42 0d 00 00 00 1a 00 82 68 81 75 82 8c 82 8c 81 40 82 94 82 92 82 85 82 81 82 94 81 40 82 88 82 89 82 8d 81 40 82 8e 82 8f 82 97 81 40 82 81 82 8e 82 84 0d 00 82 87 82 89 82 96 82 85 81 40 82 99 82 8f 82 95 81 40 82 81 81 40 82 84 82 89 82 93 82 83 82 8f 82 95 82 8e 82 94 81 42 0d 00 82 73 };
}
