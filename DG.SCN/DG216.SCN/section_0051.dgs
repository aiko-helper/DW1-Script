// source: extract/DIGIMON/SCN/DG.SCN
// DG216.SCN, section 51

section section_51(51) {  // len=1568
    if (trigger(53)) goto L_0108;
    setTrigger(53);
    setDialogOwner(5);
    showTextbox("Hello, <LIGHTBLUE><PLAYER><WHITE>.\nSurprise! I opened\na clinic!\n");
    showTextbox("It's for treating sickness\nand injuries. It's not free,\nbut it will be cheap.\n");
L_0108:
    if ((cond & 0x20) == 0x01 || (cond & 0x40) == 0x01) goto L_011c;
    goto L_0376;
L_011c:
    setDialogOwner(5);
    showTextbox("Your Digimon doesn't look\nwell. You need to take\ncare of his health.\n");
    showTextbox("I'll treat him now and\ngive you a discount.\nThree hundred bits.\n");
    if (money < 300) goto L_024a;
    reduceMoney(300);
    goto L_02b8;
L_024a:
    setDialogOwner(5);
    showTextbox("You don't have enough bits?\nPay me what you can.\n");
    reduceMoney(300);
L_02b8:
    move(entity: Entity.Partner, to: (-200, -1039), sprint: 0);
    waitForEntity(Entity.Partner);
    look(entity: 5, at: Entity.Partner);
    look(entity: Entity.Player, at: Entity.Partner);
    delay(10);
    moveCamera(to: Entity.Partner, speed: 20);
    waitForEntity(200);
    playSound(8, 2);
    delay(40);
    playSound(8, 3);
    delay(20);
    removeCondition(Condition.Injured);
    removeCondition(Condition.Sick);
    playAnimation(Entity.Partner, 11);
    delay(20);
    setDialogOwner(5);
    showTextbox("Everything is OK now.\nJust be careful from now on.\n");
    if (stat[Stat.Tiredness] < 50) goto L_036e;
    setStats(Stat.Tiredness, 50);
L_036e:
    moveCamera(to: Entity.Player, speed: 10);
    waitForEntity(200);
    return;
L_0376:
    setDialogOwner(5);
    showTextbox("Your Digimon looks fine.\nWhat do you need?\n");
    setDialogOwner(Entity.Player);
    setSelection(L_044a, section_52.L_00d2, section_52.L_018c);
    showTextbox("Get rid of his Tiredness\nSell me Medicine\nNothing\n");
    waitForSelectionChoice();
    goto section_52.L_018c;
L_044a:
    if (stat[Stat.Tiredness] < 80) goto L_04ca;
    setDialogOwner(5);
    showTextbox("<ORANGE><DIGIMON><WHITE>'s Tiredness is very\nhigh, he needs to rest now.\n");
    goto L_0604;
L_04ca:
    if (stat[Stat.Tiredness] < 50) goto L_0526;
    setDialogOwner(5);
    showTextbox("<ORANGE><DIGIMON><WHITE> is tired.\nHe should rest now.\n");
    goto L_0604;
L_0526:
    if (stat[Stat.Tiredness] < 20) goto L_05ae;
    setDialogOwner(5);
    showTextbox("<ORANGE><DIGIMON><WHITE> seems to be a\nbit tired. He shouldn't\npush himself.\n");
    goto L_0604;
L_05ae:
    setDialogOwner(5);
    showTextbox("<ORANGE><DIGIMON><WHITE> is fine.\nWatch his Tiredness level.\n");
L_0604:
    storeDate(105);
    addMinutesToDate(105, 60);
    advanceToDate(105);
    addStats(Stat.CurrentHP, 500);
    addStats(Stat.CurrentMP, 500);
    reduceStats(Stat.Tiredness, 20);
    warp(to: Map.ROOM04, spawn: 1, trigger: 255);
    return;
}
