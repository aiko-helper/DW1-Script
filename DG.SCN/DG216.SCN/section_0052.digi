; source: ./extract/DIGIMON/SCN/DG.SCN
; DG216.SCN, section 52

section_52(52):     ; len=2510
  0000:  speak 5 "Does he feel more relaxed?\n"
  003c:  showTextbox "Still need something?\n"
  006c:  setDialogOwner Player
  006e:  setSelection section_51+0x44a section_52+0xd2 section_52+0x18c
  0076:  showTextbox "We'll rest more\nSell me Medicine\nNothing\n"
  00cc:  waitForSelectionChoice
  00ce:  jump section_52+0x18c
  00d2:  speak 5 "He should be fine.\n"
  00fe:  setDialogOwner Player
  0100:  setSelection section_52+0x548 section_52+0x61e section_52+0x18c
  0108:  showTextbox "Bandage: four hund bits\nMedicine: twelve hund bits\nDon't buy\n"
  0186:  waitForSelectionChoice
  0188:  jump section_52+0x18c
  018c:  speak 5 "When he doesn't feel good,\ncome see me.\n"
  01e2:  storeRandom 110 9
  01e6:  if pstat[110] > 0 then section_52+0x288
  01f2:  speak 5 "If he's still tired,\ntrain less, and make him\neat and sleep regularly.\n"
  0286:  endSection
  0288:  if pstat[110] > 1 then section_52+0x318
  0294:  speak 5 "Staying in cold or hot\nplaces for too long\ncan cause illness.\n"
  0316:  endSection
  0318:  if pstat[110] > 2 then section_52+0x372
  0324:  speak 5 "A bandage is only good\nfor wounds.\n"
  0370:  endSection
  0372:  if pstat[110] > 3 then section_52+0x410
  037e:  speak 5 "You can treat sickness\nwith Medicine, but it\nwon't reduce Tiredness.\n"
  040e:  endSection
  0410:  if pstat[110] > 4 then section_52+0x4a8
  041c:  speak 5 "If HP is low at the end\nof a battle, Digimon\ncan get hurt easily.\n"
  04a6:  endSection
  04a8:  if pstat[110] > 5 then section_52+0x546
  04b4:  speak 5 "Keeping Happiness and\nTiredness at good levels\nleads to long life.\n"
  0540:  endSection
  0542:  jump section_52+0x548
  0546:  endSection
  0548:  if money >= 400 then section_52+0x5ca
  0558:  speak 5 "You don't have enough bits.\nI can't sell you that.\n"
  05c4:  jump section_52+0x6f4
  05c8:  endSection
  05ca:  giveItem Bandage 1
  05ce:  if !trigger(0) then section_52+0x614
  05da:  speak 5 "You have too many Items.\n"
  0612:  endSection
  0614:  reduceMoney 400
  061a:  jump section_52+0x6f4
  061e:  if money >= 1200 then section_52+0x6a0
  062e:  speak 5 "You don't have enough bits.\nI can't sell you that.\n"
  069a:  jump section_52+0x6f4
  069e:  endSection
  06a0:  giveItem Medicine 1
  06a4:  if !trigger(0) then section_52+0x6ea
  06b0:  speak 5 "You have too many Items.\n"
  06e8:  endSection
  06ea:  reduceMoney 1200
  06f0:  jump section_52+0x6f4
  06f4:  speak 5 "Still need something?\n"
  0726:  setDialogOwner Player
  0728:  setSelection section_51+0x44a section_52+0xd2 section_52+0x18c
  0730:  showTextbox "Get rid of his Tiredness\nSell me more Medicine\nNo, nothing\n"
  07aa:  waitForSelectionChoice
  07ac:  jump section_52+0x18c
  07b0:  endSection
