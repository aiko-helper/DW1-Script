; source: ./extract/DIGIMON/SCN/DG.SCN
; DG216.SCN, section 51

section_51(51):     ; len=1568
  0000:  if trigger(53) then section_51+0x108
  000c:  setTrigger 53
  0010:  speak 5 "Hello, <LIGHTBLUE><PLAYER><WHITE>.\nSurprise! I opened\na clinic!\n"
  0068:  showTextbox "It's for treating sickness\nand injuries. It's not free,\nbut it will be cheap.\n"
  0108:  if (cond & Injured) == 0x01 OR (cond & Sick) == 0x01 then section_51+0x11c
  0118:  jump section_51+0x376
  011c:  speak 5 "Your Digimon doesn't look\nwell. You need to take\ncare of his health.\n"
  01ac:  showTextbox "I'll treat him now and\ngive you a discount.\nThree hundred bits.\n"
  0230:  if money < 300 then section_51+0x24a
  0240:  reduceMoney 300
  0246:  jump section_51+0x2b8
  024a:  speak 5 "You don't have enough bits?\nPay me what you can.\n"
  02b2:  reduceMoney 300
  02b8:  entityWalkTo Partner -200 -1039 0
  02c0:  waitForEntity Partner
  02c2:  lookAt 5 Partner
  02c6:  lookAt Player Partner
  02ca:  delay 10
  02ce:  moveCameraToEntity Partner 20
  02d2:  waitForEntity 200
  02d4:  playSound 8 2
  02d8:  delay 40
  02dc:  playSound 8 3
  02e0:  delay 20
  02e4:  removeCondition Injured
  02e6:  removeCondition Sick
  02e8:  playAnimation Partner 11
  02ec:  delay 20
  02f0:  speak 5 "Everything is OK now.\nJust be careful from now on.\n"
  035c:  if stat[Tiredness] < 50 then section_51+0x36e
  036a:  setStats Tiredness 50
  036e:  moveCameraToEntity Player 10
  0372:  waitForEntity 200
  0374:  endSection
  0376:  speak 5 "Your Digimon looks fine.\nWhat do you need?\n"
  03d2:  setDialogOwner Player
  03d4:  setSelection section_51+0x44a section_52+0xd2 section_52+0x18c
  03dc:  showTextbox "Get rid of his Tiredness\nSell me Medicine\nNothing\n"
  0444:  waitForSelectionChoice
  0446:  jump section_52+0x18c
  044a:  if stat[Tiredness] < 80 then section_51+0x4ca
  0458:  speak 5 "<ORANGE><DIGIMON><WHITE>'s Tiredness is very\nhigh, he needs to rest now.\n"
  04c6:  jump section_51+0x604
  04ca:  if stat[Tiredness] < 50 then section_51+0x526
  04d8:  speak 5 "<ORANGE><DIGIMON><WHITE> is tired.\nHe should rest now.\n"
  0522:  jump section_51+0x604
  0526:  if stat[Tiredness] < 20 then section_51+0x5ae
  0534:  speak 5 "<ORANGE><DIGIMON><WHITE> seems to be a\nbit tired. He shouldn't\npush himself.\n"
  05aa:  jump section_51+0x604
  05ae:  speak 5 "<ORANGE><DIGIMON><WHITE> is fine.\nWatch his Tiredness level.\n"
  0604:  storeDate 105
  0606:  addMinutesToDate 105 60
  060c:  advanceToDate 105
  060e:  addStats CurrentHP 500
  0612:  addStats CurrentMP 500
  0616:  reduceStats Tiredness 20
  061a:  warpTo ROOM04 1 255
  061e:  endSection
