// DG175.SCN
#include "functions.dgs"
#pragma script index=175 start=0x7e000 end=0x7f800 headerU16=0xc sentinelOff=0xfe
#include "entities.dgs"

section onEnter(254) {
  return;
}

section(6) {
  speak(Entity(6), "「どの店にする?」<NEWLINE>");
  setDialogOwner(Entity.Player);
  setSelection(L1, L8, L16);
  showTextbox("「医院。」<NEWLINE>「宝探し屋。」<NEWLINE>「占い屋。」<NEWLINE>");
  waitForSelectionChoice();
  return;

L1:
  {
    speak(Entity(6), "「病院にチェンジしたぞ。」<NEWLINE>");
    if ((cond & 0x20) == 0x01 || (cond & 0x40) == 0x01) break;
    goto L2;
  }
  speak(Entity(6), "「おや、具合が悪いようだね。健康に<NEWLINE> 気をつかってくれないと困るよ。」<NEWLINE>");
  showTextbox("「うむ、ではすぐ治療しよう。<NEWLINE> 代金は300<B><it>にまけておこう。」<NEWLINE>");
  if (money >= 300) {
    reduceMoney(300);
  } else {
    speak(Entity(6), "「何、<B><it>が足りないのか!仕方ない、<NEWLINE> 今はらえるだけでいいよ。いざと言う時の<NEWLINE> ために、ムダづかいはひかえるんだぞ。」<NEWLINE>");
    reduceMoney(300);
  }
  removeCondition(Condition.Injured);
  removeCondition(Condition.Sick);
  showTextbox("「よーし、これで治った。これからは<NEWLINE> 気をつけなさい。」<NEWLINE>");
  return;

L2:
  speak(Entity(6), "「やあ、病気やケガはしてないようだね。<NEWLINE> それで私に何の用かな?」<NEWLINE>");
  setDialogOwner(Entity.Player);
  setSelection(L3, L4, L5);
  showTextbox("「状態をみてほしい。」<NEWLINE>「薬を売ってほしい。」<NEWLINE>「用は無いよ。」<NEWLINE>");

L3:
  speak(Entity(6), "「では、<ORANGE><DIGIMON><WHITE>の状態をみてあげよう。」<NEWLINE>");
  {
    if (stat[Stat.Tiredness] >= 80) {
      speak(Entity(6), "「おや、いかんぞ。<ORANGE><DIGIMON><WHITE>の疲労は<NEWLINE> ほぼ極限状態だ。何か手をうたないと<NEWLINE> 危険だよ!」<NEWLINE>");
      break;
    }
    if (stat[Stat.Tiredness] >= 50) {
      speak(Entity(6), "「おや、うーむ…。<ORANGE><DIGIMON><WHITE>はかなり<NEWLINE> 疲れをためているな。手おくれになる前に<NEWLINE> 休んだほうがいい。」<NEWLINE>");
      break;
    }
    if (stat[Stat.Tiredness] >= 20) {
      speak(Entity(6), "「うーん、<ORANGE><DIGIMON><WHITE>は少し疲れている<NEWLINE> みたいだ。無理はいかんよ。」<NEWLINE>");
      break;
    }
    speak(Entity(6), "「ふむふむ、<ORANGE><DIGIMON><WHITE>は元気だね。<NEWLINE> 疲れているといろいろ害があるから気を<NEWLINE> つけるんだよ。」<NEWLINE>");
  }
  speak(Entity(6), "「さて、ごきげんのほうは…と。」<NEWLINE>");
  {
    if (stat[Stat.Happiness] >= 100) {
      speak(Entity(6), "「<ORANGE><DIGIMON><WHITE>は精神的に最高のリラックス<NEWLINE> 状態だな。長生きするだろう。」<NEWLINE>");
      break;
    }
    if (stat[Stat.Happiness] >= 70) {
      speak(Entity(6), "「<ORANGE><DIGIMON><WHITE>はとても良い精神状態を<NEWLINE> 保っている。正しい生活のたまものだな。」<NEWLINE>");
      break;
    }
    if (stat[Stat.Happiness] >= 30) {
      speak(Entity(6), "「<ORANGE><DIGIMON><WHITE>はなかなかリラックスしている<NEWLINE> みたいだ。何かいいことがあったのかな?」<NEWLINE>");
      break;
    }
    if (stat[Stat.Happiness] >= 0) {
      speak(Entity(6), "「<ORANGE><DIGIMON><WHITE>は特にストレスを感じてない<NEWLINE> ようだ。まあ普通だね。」<NEWLINE>");
      break;
    }
    if (stat[Stat.Happiness] >= -20) {
      speak(Entity(6), "「<ORANGE><DIGIMON><WHITE>は少しストレスを感じている<NEWLINE> ようだね。トレーニングはほどほどにね。」<NEWLINE>");
      break;
    }
    if (stat[Stat.Happiness] >= -50) {
      speak(Entity(6), "「<ORANGE><DIGIMON><WHITE>はそろそろストレスが<NEWLINE> たまってきているな。何か気をまぎらすと<NEWLINE> いい。」<NEWLINE>");
      break;
    }
    if (stat[Stat.Happiness] >= -80) {
      speak(Entity(6), "「<ORANGE><DIGIMON><WHITE>はかなりのストレスで<NEWLINE> 不機嫌だ。無理は禁物だな。」<NEWLINE>");
      break;
    }
    speak(Entity(6), "「<ORANGE><DIGIMON><WHITE>はストレスの限界だ…!<NEWLINE> このままでは寿命が縮むよ!」<NEWLINE>");
    break;
  }
  speak(Entity(6), "「うむ……<ORANGE><DIGIMON><WHITE>については<NEWLINE> こんなところだな。」<NEWLINE>");
  showTextbox("「まだ何か用があるかな?」<NEWLINE>");
  setDialogOwner(Entity.Player);
  setSelection(L3, L4, L5);
  showTextbox("「もう一度状態をみてほしい。」<NEWLINE>「薬を売ってほしい。」<NEWLINE>「もう用は無いよ。」<NEWLINE>");
  waitForSelectionChoice();
  return;

L4:
  speak(Entity(6), "「ふむ、いいだろう。」<NEWLINE>");
  setDialogOwner(Entity.Player);
  setSelection(L6, L7, L5);
  showTextbox(" ばんそうこう        400<B><it><NEWLINE> 薬            1200<B><it><NEWLINE> やっぱり買わない<NEWLINE>");
  waitForSelectionChoice();
  return;

L5:
  speak(Entity(6), "「うむ、調子が悪いと感じたらすぐに<NEWLINE> 来なさい。」<NEWLINE>");
  return;

L6:
  if (item[Item.Bandage] < 1 && trigger(0)) {
    speak(Entity(6), "「持ち物がいっぱいだよ。」<NEWLINE>");
    return;
  }
  {
    if (money >= 400) {
      reduceMoney(400);
      giveItem(Item.Bandage, 1);
      break;
    }
    speak(Entity(6), "「<B><it>が足りないのか。<NEWLINE> それでは売ることができないな。」<NEWLINE>");
    return;

L7:
    if (item[Item.Medicine] < 1 && trigger(0)) {
      speak(Entity(6), "「持ち物がいっぱいだよ。」<NEWLINE>");
      return;
    }
    if (money >= 1200) {
      reduceMoney(1200);
      giveItem(Item.Medicine, 1);
      break;
    }
    speak(Entity(6), "「<B><it>が足りないのか。<NEWLINE> それでは売ることができないな。」<NEWLINE>");
    return;
  }
  speak(Entity(6), "「まだ何か用があるかな?」<NEWLINE>");
  setDialogOwner(Entity.Player);
  setSelection(L3, L4, L5);
  showTextbox("「状態をみてほしい。」<NEWLINE>「もっと薬を売ってほしい。」<NEWLINE>「もう用は無いよ。」<NEWLINE>");
  waitForSelectionChoice();
  return;

L8:
  speak(Entity(6), "「宝探し屋にチェンジしたぞ。」<NEWLINE>");
  if (trigger(178) || trigger(178)) {
  } else {
    speak(Entity(6), "「おう、宝探し依頼か?まず説明を聞くか?」<NEWLINE>");
    setDialogOwner(Entity.Player);
    setSelection(L9, L10, L11);
    showTextbox("「説明して欲しい。」<NEWLINE>「説明はいらない。」<NEWLINE>「別に用はない。」<NEWLINE>");
    waitForSelectionChoice();
    goto L11;

L9:
    speak(Entity(6), "「元手になる代金とひきかえに、俺っちが<NEWLINE> 宝を見つけてくるしくみだ。期間と値段を<NEWLINE> 分けて2つのコースがあるぜ。」<NEWLINE>");
    showTextbox("「ノーマルコースは3日間1000<B><it>。<NEWLINE> スペシャルコースは10日間で5000<NEWLINE> <B><it>になっているぞ。」<NEWLINE>");
    showTextbox("「もちろん、スペシャルコースのほうが<NEWLINE> 良い宝が見つかる可能性は高いぜ!」<NEWLINE>");
    showTextbox("「説明はそんなとこだな。<NEWLINE> で、どうすんだ?」<NEWLINE>");
    setDialogOwner(Entity(6));
    setSelection(L9, L10, L11);
    showTextbox("「もう一度説明してほしい。」<NEWLINE>「宝探しをたのむ。」<NEWLINE>「いや、もう用はない。」<NEWLINE>");
    waitForSelectionChoice();
    goto L11;

L10:
    speak(Entity(6), "「じゃあ、コースを選びな!」<NEWLINE>");
    setDialogOwner(Entity.Player);
    setSelection(L12, L13, L11);
    showTextbox("ノーマルコース       1000<B><it><NEWLINE>スペシャルコース      5000<B><it><NEWLINE>とりやめ<NEWLINE>");
    waitForSelectionChoice();
    goto L11;

L11:
    speak(Entity(6), "「そうか。じゃあな。」<NEWLINE>");
    return;

L12:
    {
      if (money < 1000) {
        break;
      }
      reduceMoney(1000);
      setTrigger(Trigger(178));
      pstat[PStat(30)] = time();
      speak(Entity(6), "「よーし、じゃあ3日後には結果が出る<NEWLINE> からな。がんばるぜ。」<NEWLINE>");
      roll(pstat: PStat(22), max: 49);
      return;

L13:
      if (money < 5000) {
        break;
      }
      reduceMoney(5000);
      setTrigger(Trigger(179));
      pstat[PStat(30)] = time();
      speak(Entity(6), "「よーし、じゃあ10日後には結果が出る<NEWLINE> からな。がんばるぜ。」<NEWLINE>");
      roll(pstat: PStat(23), max: 49);
      return;
    }
    speak(Entity(6), "「<B><it>がたりねーぜ。いくら俺っちでも、<NEWLINE> 元手が無くちゃ宝は探せねえ。」<NEWLINE>");
    return;
  }
  {
    if (pstat[30] < 3 && trigger(178)) {
      break;
    }
    if (pstat[30] < 10 && trigger(179)) {
      break;
    }
    goto L14;
  }
  speak(Entity.System, "<YELLOW>立て札<WHITE><NEWLINE>「宝探し中につき不在。少し待ってくれ。<NEWLINE>            ドリモゲモン」<NEWLINE>");
  return;

L14:
  speak(Entity(6), "「いよーう、お宝、あがってるぜえ。」<NEWLINE>");
  {
    if (trigger(178)) {
      break;
    }
    if (!trigger(179)) break;
    unsetTrigger(Trigger(179));
    goto L15;
  }
  {
    if (pstat[22] <= 0) {
      giveItem(Item.KogaLaws, 1);
      setPStat(PStat.RollScratch, 90);
      break;
    }
    if (pstat[22] <= 1) {
      giveItem(Item.FlameWing, 1);
      setPStat(PStat.RollScratch, 73);
      break;
    }
    if (pstat[22] <= 2) {
      giveItem(Item.TornTatter, 1);
      setPStat(PStat.RollScratch, 82);
      break;
    }
    if (pstat[22] <= 12) {
      giveItem(Item.SuperRecovery, 1);
      setPStat(PStat.RollScratch, 3);
      break;
    }
    if (pstat[22] <= 15) {
      giveItem(Item.Restore, 1);
      setPStat(PStat.RollScratch, 11);
      break;
    }
    if (pstat[22] <= 19) {
      giveItem(Item.Omnipotent, 1);
      setPStat(PStat.RollScratch, 9);
      break;
    }
    if (pstat[22] <= 23) {
      giveItem(Item.Protection, 1);
      setPStat(PStat.RollScratch, 10);
      break;
    }
    if (pstat[22] <= 33) {
      giveItem(Item.LargeMP, 1);
      setPStat(PStat.RollScratch, 6);
      break;
    }
    if (pstat[22] <= 37) {
      giveItem(Item.SuperOffenseDisk, 1);
      setPStat(PStat.RollScratch, 19);
      break;
    }
    if (pstat[22] <= 41) {
      giveItem(Item.SuperDefenseDisk, 1);
      setPStat(PStat.RollScratch, 20);
      break;
    }
    if (pstat[22] <= 45) {
      giveItem(Item.SuperSpeedDisk, 1);
      setPStat(PStat.RollScratch, 21);
      break;
    }
    if (pstat[22] > 49) break;
    giveItem(Item.OmniDisk, 1);
    setPStat(PStat.RollScratch, 18);
    break;
  }
  loop {
    if (trigger(0)) {
      speak(Entity(6), "「持ち物を空けてきてくんな!」<NEWLINE>");
      return;
    }
    showTextbox("<LIGHTBLUE><TREASURE ITEM><WHITE>を手に入れた!<NEWLINE>");
    unsetTrigger(Trigger(178));
    unsetTrigger(Trigger(179));
    break;

L15:
    if (pstat[23] <= 0) {
      giveItem(Item.OffenseChip, 1);
      setPStat(PStat.RollScratch, 23);
      continue;
    }
    if (pstat[23] <= 1) {
      giveItem(Item.HPChip, 1);
      setPStat(PStat.RollScratch, 27);
      continue;
    }
    if (pstat[23] <= 2) {
      giveItem(Item.BrainChip, 1);
      setPStat(PStat.RollScratch, 25);
      continue;
    }
    if (pstat[23] <= 3) {
      giveItem(Item.DefenseChip, 1);
      setPStat(PStat.RollScratch, 24);
      continue;
    }
    if (pstat[23] <= 4) {
      giveItem(Item.MPChip, 1);
      setPStat(PStat.RollScratch, 28);
      continue;
    }
    if (pstat[23] <= 5) {
      giveItem(Item.SpeedChip, 1);
      setPStat(PStat.RollScratch, 26);
      continue;
    }
    if (pstat[23] <= 6) {
      giveItem(Item.KogaLaws, 1);
      setPStat(PStat.RollScratch, 90);
      continue;
    }
    if (pstat[23] <= 7) {
      giveItem(Item.FlameWing, 1);
      setPStat(PStat.RollScratch, 73);
      continue;
    }
    if (pstat[23] <= 8) {
      giveItem(Item.TornTatter, 1);
      setPStat(PStat.RollScratch, 82);
      continue;
    }
    if (pstat[23] <= 20) {
      giveItem(Item.SuperRecovery, 1);
      setPStat(PStat.RollScratch, 3);
      continue;
    }
    if (pstat[23] <= 29) {
      giveItem(Item.Restore, 1);
      setPStat(PStat.RollScratch, 11);
      continue;
    }
    if (pstat[23] > 49) break;
    giveItem(Item.Omnipotent, 1);
    setPStat(PStat.RollScratch, 9);
  }
  speak(Entity(6), "「まいど!」<NEWLINE>");
  return;

L16:
  jumpToScriptSection(182, 6);
  return;
  garbage { 0c 00 fe 00 0c 00 06 00 0e 00 ff ff fe 00 1b 06 1a 00 81 75 82 c7 82 cc 93 58 82 c9 82 b7 82 e9 81 48 81 76 0d 00 00 00 1b fd 10 03 64 00 e2 0a e2 12 1a 00 81 75 88 e3 89 40 81 42 81 76 0d 00 81 75 95 f3 92 54 82 b5 89 ae 81 42 81 76 0d 00 81 75 90 e8 82 a2 89 ae 81 42 81 76 0d 00 00 00 12 00 fe 00 1b 06 1a 00 81 75 95 61 89 40 82 c9 83 60 83 46 83 93 83 57 82 b5 82 bd 82 bc 81 42 81 76 0d 00 00 00 19 00 23 00 20 01 a3 00 40 01 18 00 9a 00 19 00 16 00 14 02 1b 06 1a 00 81 75 82 a8 82 e2 81 41 8b ef 8d 87 82 aa 88 ab 82 a2 82 e6 82 a4 82 be 82 cb 81 42 8c 92 8d 4e 82 c9 0d 00 81 40 8b 43 82 f0 82 c2 82 a9 82 c1 82 c4 82 ad 82 ea 82 c8 82 a2 82 c6 8d a2 82 e9 82 e6 81 42 81 76 0d 00 00 00 1a 00 81 75 82 a4 82 de 81 41 82 c5 82 cd 82 b7 82 ae 8e a1 97 c3 82 b5 82 e6 82 a4 81 42 0d 00 81 40 91 e3 8b e0 82 cd 82 52 82 4f 82 4f 81 6f 81 70 82 c9 82 dc 82 af 82 c4 82 a8 82 b1 82 a4 81 42 81 76 0d 00 00 00 19 00 25 00 00 02 2c 01 00 00 18 00 4a 01 19 00 2b 00 2c 01 00 00 16 00 d0 01 1b 06 1a 00 81 75 89 bd 81 41 81 6f 81 70 82 aa 91 ab 82 e8 82 c8 82 a2 82 cc 82 a9 81 49 8e 64 95 fb 82 c8 82 a2 81 41 0d 00 81 40 8d a1 82 cd 82 e7 82 a6 82 e9 82 be 82 af 82 c5 82 a2 82 a2 82 e6 81 42 82 a2 82 b4 82 c6 8c be 82 a4 8e 9e 82 cc 0d 00 81 40 82 bd 82 df 82 c9 81 41 83 80 83 5f 82 c3 82 a9 82 a2 82 cd 82 d0 82 a9 82 a6 82 e9 82 f1 82 be 82 bc 81 42 81 76 0d 00 00 00 2b 00 2c 01 00 00 65 20 65 40 1a 00 81 75 82 e6 81 5b 82 b5 81 41 82 b1 82 ea 82 c5 8e a1 82 c1 82 bd 81 42 82 b1 82 ea 82 a9 82 e7 82 cd 0d 00 81 40 8b 43 82 f0 82 c2 82 af 82 c8 82 b3 82 a2 81 42 81 76 0d 00 00 00 fe 00 1b 06 1a 00 81 75 82 e2 82 a0 81 41 95 61 8b 43 82 e2 83 50 83 4b 82 cd 82 b5 82 c4 82 c8 82 a2 82 e6 82 a4 82 be 82 cb 81 42 0d 00 81 40 82 bb 82 ea 82 c5 8e 84 82 c9 89 bd 82 cc 97 70 82 a9 82 c8 81 48 81 76 0d 00 00 00 1b fd 10 03 ae 02 5e 08 f6 08 1a 00 81 75 8f f3 91 d4 82 f0 82 dd 82 c4 82 d9 82 b5 82 a2 81 42 81 76 0d 00 81 75 96 f2 82 f0 94 84 82 c1 82 c4 82 d9 82 b5 82 a2 81 42 81