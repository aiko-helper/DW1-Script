section(235) {
  switchToMap(191, Map.ROOM20, 0, 28);
  switch pstat[122] {
    1 => {
      loadAndSetDigimon(Digimon.NPCMetalMamemon, Entity(1), 0);
      return;
    }
    0 => {
      loadAndSetDigimon(Digimon.NPCPenguinmon, Entity(0), 0);
      return;
    }
  }
  roll(pstat: PStat.RollScratch, max: 7);
  if (trigger(227) && pstat[110] <= 0) {
    setPStat(PStat(122), 1);
    loadAndSetDigimon(Digimon.NPCMetalMamemon, Entity(1), 0);
    return;
  }
  if (trigger(257)) {
    setPStat(PStat(122), 0);
    loadAndSetDigimon(Digimon.NPCPenguinmon, Entity(0), 0);
  }
  return;
  return;
}

