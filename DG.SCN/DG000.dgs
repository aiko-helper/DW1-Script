    loadDigimon(Digimon.NPCMetalMamemon);
    setDigimon(Digimon.NPCMetalMamemon, 1, 0);
    return;

L1:
    if (pstat[122] != 0) goto L2;
    loadDigimon(Digimon.NPCPenguinmon);
    setDigimon(Digimon.NPCPenguinmon, 0, 0);
    return;

L2:
    roll(pstat: 110, max: 7);
    if (!trigger(227) || pstat[110] > 0) goto L3;
    setPStat(122, 1);
    loadDigimon(Digimon.NPCMetalMamemon);
    setDigimon(Digimon.NPCMetalMamemon, 1, 0);
    return;

L3:
    if (!trigger(257)) goto L4;
    setPStat(122, 0);
    loadDigimon(Digimon.NPCPenguinmon);
    setDigimon(Digimon.NPCPenguinmon, 0, 0);

L4:
    return;
    return;
}

