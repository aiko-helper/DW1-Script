    loadAndSetDigimon(Digimon.NPCNumemon, Entity(0), 0);
    setPStat(PStat(24), 0);
    return;
  }
  if (trigger(252)) {
    loadAndSetDigimon(Digimon.NPCMojyamon, Entity(1), 0);
    setPStat(PStat(24), 1);
    return;
  }
  if (trigger(213)) {
    loadAndSetDigimon(Digimon.NPCMamemon, Entity(2), 0);
    setPStat(PStat(24), 2);
    return;
  }
  if (trigger(206)) {
    loadAndSetDigimon(Digimon.NPCDevimon, Entity(3), 0);
    setPStat(PStat(24), 3);
    return;
  }
  return;
}

