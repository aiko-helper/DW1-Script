section(0) {
  switchToMap(1, Map.MAYO01, 0, 1);
  pstat[:SavedTime] = time();
  if (pstat[107] in 7..19) {
    loadDigimon(Digimon.ModokiBetamon);
    loadDigimon(Digimon.RedVegimon);
    setDigimonBatch([
      Digimon.ModokiBetamon => Entity(0),
      Digimon.ModokiBetamon => Entity(1),
      Digimon.RedVegimon => Entity(2),
      Digimon.RedVegimon => Entity(3),
      Digimon.ModokiBetamon => Entity(4),
    ], autotalk: 1);
  } else {
    loadDigimon(Digimon.Dokunemon);
    for id in Entity(5)..Entity(7) {
      setDigimon(Digimon.Dokunemon, id, 1);
    }
  }
  return;
}

