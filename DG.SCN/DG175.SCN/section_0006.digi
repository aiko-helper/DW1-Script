section_6(6):     ; len=390
  0000:  if trigger(64) then section_6+0x17e
  000c:  setDialogOwner 6
  000e:  showTextbox "Wow! Hey <LIGHTBLUE><PLAYER><WHITE>!\nWhat's this machine for?\n"
  0060:  showTextbox "Don't be scared! This is\na jukebox that makes my\nheart pump! Alright!\n"
  00f0:  showTextbox "You should boogie!\nCome on, let loose! I'm\nwaiting for your order!\n"
  017a:  setTrigger 64
  017e:  setPStat 254 6
  0182:  callSubroutine 9
  0184:  endSection
