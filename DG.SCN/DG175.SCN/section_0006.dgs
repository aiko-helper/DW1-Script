// source: extract/DIGIMON/SCN/DG.SCN
// DG175.SCN, section 6

section section_6(6) {  // len=390
    if (trigger(64)) goto L_017e;
    setDialogOwner(6);
    showTextbox("Wow! Hey <LIGHTBLUE><PLAYER><WHITE>!\nWhat's this machine for?\n");
    showTextbox("Don't be scared! This is\na jukebox that makes my\nheart pump! Alright!\n");
    showTextbox("You should boogie!\nCome on, let loose! I'm\nwaiting for your order!\n");
    setTrigger(64);
L_017e:
    setPStat(254, 6);
    callSubroutine(9);
    return;
}
