// DG168.SCN
#include "functions.dgs"
#pragma script index=168 start=0x7b800 end=0x7e800 headerU16=0x38 sentinelOff=0x1e
#include "entities.dgs"

section onEnter(254) {
  setPStat(122, 255);
  if (!trigger(257)) {
    setObjectsVisibleRange(0, 3, 0);
    goto L1;
  }
  setObjectsVisibleRange(0, 3, 1);
  setObjectVisibility(5, 0);
  setObjectVisibility(6, 0);

L1:
  if (trigger(257) && !trigger(50)) {
    setObjectVisibility(4, 0);
  }
  if (trigger(257) && trigger(50)) {
    setObjectVisibility(4, 1);
  }
  if (trigger(50)) {
    setObjectVisibility(7, 0);
    setObjectVisibility(8, 0);
  }
  return;
}

section(81) {
  jumpToScriptSection(213, 81);
  return;
}

section(54) {
  jumpToScriptSection(213, 54);
}

section(61) {
  jumpToScriptSection(214, 51);
  return;
