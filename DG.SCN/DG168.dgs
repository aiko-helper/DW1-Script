section(51) {
  if (trigger(257)) {
    warp(to: Map.ROOM20, spawn: 0, trigger: 255);
    setPStat(122, 255);
  }
  return;
}

section(82) {
  speak(Entity.System, "Arena Information\n");
  choice { "Record" -> L1, "About Grade Tournament" -> L2, "About Special Tournament" -> L3 }
  return;

L1:
  speak(Entity.System, "Number of\nChampionship wins <TOURNAMENTS WON>\n<ARENA WINS>Wins <ARENA LOSSES>Losses\n");
  fadeOutHUD();
  return;

L2:
  speak(Entity.System, "Anybody can join a Grade\nTournament. It's held a lot.\n");
  showTextbox("But a higher generation\nDigimon should not enter\nlower level tournaments.\n");
  showTextbox("If your Digimon digivolves\nbetween registering and\ntournament, he can't compete.\n");
  return;

L3:
  speak(Entity.System, "Special tournaments have\nset contestant rules\nand they aren't held often.\n");
  showTextbox("If there aren't enough\ncontestants in the city,\nit will not even be held.\n");
  showTextbox("The same tournament is only\nheld once or twice a year.\nCheck schedule in advance.\n");
  return;
}

section(83) {
  jumpToScriptSection(215, 6);
  return;
}

section(84) {
  look(entity: 7, at: Entity.Player);
  look(entity: Entity.Player, at: 7);
  delay(10);
  speak(7, "<ORANGE><DIGIMON><WHITE>, let me think of\nyour nickname... a hero\nwho has saved the world.\n");
  showTextbox("Let's see.\n");
  roll(pstat: 110, max: 9);
  if (pstat[110] == 0) {
    speak(7, "How about\n'Invincible <ORANGE><DIGIMON><WHITE>'?\n");
    return;
  }
  if (pstat[110] == 1) {
    speak(7, "How about\n'Legendary Hero <ORANGE><DIGIMON><WHITE>'?\n");
    return;
  }
  if (pstat[110] == 2) {
    speak(7, "How about\n'<ORANGE><DIGIMON><WHITE> The Great'?\n");
    return;
  }
  if (pstat[110] == 3) {
    speak(7, "How about\n'Peacemaker <ORANGE><DIGIMON><WHITE>'?\n");
    return;
  }
  if (pstat[110] == 4) {
    speak(7, "How about\n'<ORANGE><DIGIMON><WHITE> The Champ'?\n");
    return;
  }
  if (pstat[110] == 5) {
    speak(7, "How about\n'<ORANGE><DIGIMON><WHITE> The Brave'?\n");
    return;
  }
  if (pstat[110] == 6) {
    speak(7, "How about\n'Cool Dude, <ORANGE><DIGIMON><WHITE>'?\n");
    return;
  }
  if (pstat[110] == 7) {
    speak(7, "How about\n'The Mighty <ORANGE><DIGIMON><WHITE>'?\n");
    return;
  }
  if (pstat[110] == 8) {
    speak(7, "How about\n'Augustas <ORANGE><DIGIMON><WHITE>'?\n");
    return;
  }
  if (pstat[110] != 9) goto section_6;
  speak(7, "How about\n'Mastermind <ORANGE><DIGIMON><WHITE>'?\n");
  return;
}

section(6) {
  jumpToScriptSection(215, 6);
  return;
}

section(53) {
  look(entity: 5, at: Entity.Player);
  look(entity: Entity.Player, at: 5);
  delay(5);
  speak(5, "Hey, those seats are\nfor our guests.\n");
  move(entity: Entity.Player, to: (450, 124), sprint: 1);
  waitForEntity(Entity.Player);
  moveCamera(to: Entity.Player, speed: 10);
  waitForEntity(200);
  return;
}

