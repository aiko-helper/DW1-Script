section section_82(82) {  // len=1176
    setDialogOwner(Entity.System);
    showTextbox("Arena Information\n");
    setSelection(L_00a8, L_010a, L_02bc);
    showTextbox("Record\nAbout Grade Tournament\nAbout Special Tournament\n");
    waitForSelectionChoice();
    return;
L_00a8:
    setDialogOwner(Entity.System);
    showTextbox("Number of\nChampionship wins <TOURNAMENTS WON>\n<ARENA WINS>Wins <ARENA LOSSES>Losses\n");
    fadeOutHUD();
    return;
L_010a:
    setDialogOwner(Entity.System);
    showTextbox("Anybody can join a Grade\nTournament. It's held a lot.\n");
    showTextbox("But a higher generation\nDigimon should not enter\nlower level tournaments.\n");
    showTextbox("If your Digimon digivolves\nbetween registering and\ntournament, he can't compete.\n");
    return;
L_02bc:
    setDialogOwner(Entity.System);
    showTextbox("Special tournaments have\nset contestant rules\nand they aren't held often.\n");
    showTextbox("If there aren't enough\ncontestants in the city,\nit will not even be held.\n");
    showTextbox("The same tournament is only\nheld once or twice a year.\nCheck schedule in advance.\n");
    return;
}

