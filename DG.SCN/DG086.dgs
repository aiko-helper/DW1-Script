// DG086.SCN
#pragma script index=86 start=0x3d800 end=0x3e000 headerU16=0x1c sentinelOff=0x24

function speakThenStartBattleThenSetTrigger(a, b, c) {
    speak(a, b);
    startBattle();
    setTrigger(c);
}


section onEnter(254) {
    roll(pstat: 110, max: 99);
    if (pstat[110] > 16) goto L1;
    spawnItem(Item.Digimushroom, x: 63, y: 56);

L1:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 7) goto L2;
    spawnItem(Item.Digimushroom, x: 61, y: 88);

L2:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 3) goto L3;
    spawnItem(Item.IceMushroom, x: 73, y: 88);

L3:
    return;
}

section(5) {
    speakThenStartBattleThenSetTrigger(5, "Let's settle this!\n", 271);
    return;
}

section(6) {
    speakThenStartBattleThenSetTrigger(6, "Darn it!\n", 271);
    return;
}

section(7) {
    speakThenStartBattleThenSetTrigger(7, "Do you wanna be beat?!\n", 303);
    return;
}

section(8) {
    speakThenStartBattleThenSetTrigger(8, "My one blow will finish you!\n", 303);
    return;
}

section(51) {
    if ((cond & 0x40) == 0x01 && !trigger(133)) goto L1;
    return;

L1:
    storeDigimonType(103);
    if (pstat[103] != 3 && pstat[103] != 5 && pstat[103] != 8 && pstat[103] != 9 && pstat[103] != 47) goto L2;
    jumpToScriptSection(203, 51);

L2:
    if (pstat[103] != 19 && pstat[103] != 32 && pstat[103] != 51 && pstat[103] != 1 && pstat[103] != 2) goto L3;
    jumpToScriptSection(203, 51);

