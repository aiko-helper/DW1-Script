// DG086.SCN
#include "functions.dgs"
#pragma script index=86 start=0x39800 end=0x3a000 headerU16=0x28 sentinelOff=0x24
#include "entities.dgs"

section onEnter(254) {
  spawnItemChance(max: 99, chance: 11, item: Item.Digimushroom, x: 72, y: 53);
  spawnItemChance(max: 99, chance: 17, item: Item.Digimushroom, x: 48, y: 45);
  spawnItemChance(max: 99, chance: 3, item: Item.IceMushroom, x: 35, y: 91);
  setTrigger(Trigger(351));
  return;
}

section(5) {
  speak(Entity(5), "「金目のもの置いてけや。」<NEWLINE>");
  finishEncounter(Trigger(272));
}

section(6) {
  speak(Entity(6), "「氷づけにしてやるー!」<NEWLINE>");
  finishEncounter(Trigger(272));
}

section(7) {
  speak(Entity(7), "「右にも左にも行かせねぇぜ。」<NEWLINE>");
  finishEncounter(Trigger(272));
}

section(8) {
  speak(Entity(8), "「氷づけにしてくれる!」<NEWLINE>");
  finishEncounter(Trigger(300));
}

section(9) {
  speak(Entity(9), "「氷ジゴクを見せてやろう…」<NEWLINE>");
  finishEncounter(Trigger(300));
}

section(10) {
  speak(Entity(10), "「こごえ死にたい?」<NEWLINE>");
  finishEncounter(Trigger(272));
}

section(81) {
  rotate(entity: Entity.Player, to: 2468);
  speak(Entity.System, "西・ミスティツリーズ<NEWLINE> <NEWLINE>東・流氷海岸<NEWLINE>");
  return;
}

