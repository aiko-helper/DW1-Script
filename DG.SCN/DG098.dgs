// DG098.SCN
#pragma script index=98 start=0x44000 end=0x44800 headerU16=0x1c sentinelOff=0x375

section onEnter(254) {  // len=42
    spawnChest(Item.SuperRecovery, 9, 1196, 0, 660);
    spawnChest(Item.LargeMP, 1223, 266, 1024, 661);
    if (!trigger(322)) goto L_0028;
    setObjectVisibility(0, 1);
L_0028:
    return;
}

section section_51(51) {  // len=6
    warp(to: Map.ICSA05, spawn: 0, trigger: 255);
    return;
}

section section_5(5) {  // len=66
    setDialogOwner(5);
    showTextbox("Shouldn't you go home?\n");
    fadeOutHUD();
    delay(1);
    startBattle();
    setTrigger(294);
    return;
}

section section_6(6) {  // len=38
    setDialogOwner(6);
    showTextbox("Go home!\n");
    fadeOutHUD();
    delay(1);
    startBattle();
    setTrigger(272);
    return;
}

section section_7(7) {  // len=60
    setDialogOwner(7);
    showTextbox("You should go back!\n");
    fadeOutHUD();
    delay(1);
    startBattle();
    setTrigger(272);
    return;
}

section section_52(52) {  // len=1808
    if (!trigger(322)) goto L_000e;
    return;
L_000e:
    playAnimation(Entity.Player, 22);
    playSound(8, 9);
    delay(15);
    setDialogOwner(Entity.Player);
    showTextbox("Oh, it's so blinding!\n");
    playAnimation(Entity.Player, 0);
    setPStat(254, 40);
    callSubroutine(45);
    delay(40);
    setDialogOwner(Entity.System);
    showTextbox("<YELLOW>??? mon <WHITE>\nHe who seeks my help, the\ntime has come! I give you\nthe blessings of my wings!\n");
    setDialogOwner(Entity.Player);
    showTextbox("What the..? Where..?\nWhose voice..?\n");
    showTextbox("Ugh!\n");
    setObjectVisibility(0, 1);
    callSubroutine(46);
    delay(40);
    playAnimation(Entity.Player, 24);
    delay(15);
    setDialogOwner(Entity.Player);
    showTextbox("What was that?  The light is\ngone. There's nothing else\nhere. That means it's above?!\n");
    playAnimation(Entity.Player, 23);
    delay(15);
    playAnimation(Entity.Player, 0);
    setTrigger(322);
    return;
