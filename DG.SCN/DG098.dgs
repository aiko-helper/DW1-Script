section(81, 0x0022) {
  pstat[:SavedTime] = time();
  look(entity: Entity.Player, at: Entity(5));
  look(entity: Entity(5), at: Entity.Player);
  delay(5);
  {
    if (!trigger(37)) {
      break;
      break;
    }
    goto L3;
  }
  if (pstat[106] == 21 && pstat[107] >= 10) {
    speak(Entity(5), "「ざんねんだが もう エントリー<NEWLINE> おわった。 あと いちねん まて。」<NEWLINE>");
    return;
  }
  if (pstat[106] in 20..=21) {
  } else {
    speak(Entity(5), "「いま 大会きかん じゃない<NEWLINE> おれ ひま。」<NEWLINE>");
    return;
  }
  if (pstat[106] == 21 && pstat[107] >= 23) {
    speak(Entity(5), "「いま 大会おわったところ<NEWLINE> あと いちねん まて。」<NEWLINE>");
  }
  storeDigimonType(PStat(103));
  if (pstat[103] == 19 || pstat[103] == 32 || pstat[103] == 51 || pstat[103] == 60) {
  } else {
    speak(Entity(5), "「おまえ こん虫じゃない<NEWLINE> 大会 参加 だめ。」<NEWLINE>");
    return;
  }
  {
    {
      if (trigger(37)) break;
      speak(Entity(5), "「大会に エントリー するか?」<NEWLINE>");
      setDialogOwner(Entity(5));
      setSelection(L1, L2);
      showTextbox("「説明をしてほしい。」<NEWLINE>「説明はいらない。」<NEWLINE>");
      waitForSelectionChoice();
      goto L2;

L1:
    }
    speak(Entity(5), "「22日は こん虫デジモンだけの<NEWLINE> 闘技大会 ある<NEWLINE> 今 それに参加エントリー できる」<NEWLINE>");
    showTextbox("「虫デジモン じゃないと 大会 参加<NEWLINE> できない。」<NEWLINE>");
    showTextbox("「ゆうしょう すると <NEWLINE> ごうか しょうひん もらえる<NEWLINE> でて そんはない」<NEWLINE>");
    break;

L2:
  }
  setDialogOwner(Entity(5));
  setSelection(L6, L5);
  showTextbox("「エントリーする。」<NEWLINE>「エントリーしない。」<NEWLINE>");
  waitForSelectionChoice();
  return;

L3:
  if (pstat[106] in 20..=21) {
  } else {
    speak(Entity(5), "「いま 大会きかん じゃない<NEWLINE> おれ ひま。」<NEWLINE>");
    return;
  }
  if (pstat[106] == 21 && pstat[107] >= 23) {
    speak(Entity(5), "「いま 大会おわったところ<NEWLINE> あと いちねん まて。」<NEWLINE>");
  }
  speak(Entity(5), "「おまえ 『-<TOURNAMENT>-』に<NEWLINE> エントリー中<NEWLINE> キャンセル するか?」<NEWLINE>");
  setDialogOwner(Entity.Player);
  setSelection(L5, L4);
  showTextbox("「しない。」<NEWLINE>「する。」<NEWLINE>");
  waitForSelectionChoice();
  return;

L4:
  unsetTrigger(Trigger(37));
  speak(Entity(5), "「キャンセル した。」<NEWLINE>");
  return;

L5:
  speak(Entity(5), "「なんだ いいのか?」<NEWLINE>");
  return;

L6:
  callSubroutine(33);
  speak(Entity(5), "「エントリー した。」<NEWLINE>");
  return;
}

section(51) {
  pstat[:SavedTime] = time();
  if (pstat[106] != 21) {
    look(entity: Entity(5), at: Entity.Player);
    look(entity: Entity.Player, at: Entity(5));
    delay(5);
    speak(Entity(5), "「きょう たいかい ひらかれない。」<NEWLINE>");
    move(entity: Entity.Player, to: (-126, 546), sprint: 1);
    waitForEntity(Entity.Player);
    return;
  }
  if (!trigger(37)) {
    look(entity: Entity(5), at: Entity.Player);
    look(entity: Entity.Player, at: Entity(5));
    delay(5);
    speak(Entity(5), "「エントリー してないやつ<NEWLINE> はいれない。」<NEWLINE>");
    move(entity: Entity.Player, to: (-126, 546), sprint: 1);
    waitForEntity(Entity.Player);
    return;
  }
  if (pstat[107] < 10) {
    look(entity: Entity(5), at: Entity.Player);
    look(entity: Entity.Player, at: Entity(5));
    delay(5);
    speak(Entity(5), "「まだ じゅんびちゅうだ<NEWLINE> 22日の あさ10:00 から<NEWLINE> よる23:00に はいれ。」<NEWLINE>");
    move(entity: Entity.Player, to: (-126, 546), sprint: 1);
    waitForEntity(Entity.Player);
    return;
  }
  if (pstat[107] >= 23) {
    look(entity: Entity(5), at: Entity.Player);
    look(entity: Entity.Player, at: Entity(5));
    delay(5);
    speak(Entity(5), "「ざんねん もう たいかい<NEWLINE> おわった。<NEWLINE> らいねん また こい。」<NEWLINE>");
    move(entity: Entity.Player, to: (-126, 546), sprint: 1);
    waitForEntity(Entity.Player);
    return;
  }
  setPStat(PStat(254), 5);
  callSubroutine(6);
  pstat[:SavedTime] = time();
  addMinutesToDate(PStat.SavedTime, 360);
  advanceToDate(PStat.SavedTime);
  warp(to: Map.BETL02, spawn: 3, trigger: 82);
  return;
}

section(81, 0x0666) {
  goto section_81_at_0022;

L1:
  return;
}

section(82) {
  unsetTrigger(Trigger(37));
  switch pstat[255] {
    3 => {
      goto L1;
    }
    2 => {
      goto L2;
    }
  }
  speak(Entity(5), "「ざんねん。 また らいねんだ。」<NEWLINE>");
  speak(Entity.System, " <NEWLINE>参加賞の<LIGHTBLUE>巨大肉<WHITE>をもらった!<NEWLINE>");
  giveItem(Item.GiantMeat, 1);
  if (trigger(0)) {
    speak(Entity(5), "「持ち物 いっぱいだ。 すてろ。」<NEWLINE>");
    inventoryFullBailout();
    giveItem(Item.GiantMeat, 1);
  }
  return;

L1:
  if (pstat[3] == 22) {
    addMoney(5000);
    speak(Entity.System, " <NEWLINE>優勝賞金5000<B><it>!<NEWLINE> <NEWLINE>優勝賞品<LIGHTBLUE>ビートルダイヤ<WHITE>をゲット!<NEWLINE>");
    giveItem(Item.Beetlepearl, 1);
    if (trigger(0)) {
      speak(Entity(5), "「持ち物 いっぱい!」<NEWLINE>");
      inventoryFullBailout();
      giveItem(Item.Beetlepearl, 1);
    }
    jumpToScriptSection(221, 51);

L2:
  }
  roll(pstat: PStat.RollScratch, max: 1);
  if (pstat[3] == 22 && pstat[110] == 0) {
    addMoney(2000);
    speak(Entity.System, " <NEWLINE>準優勝賞金2000<B><it>!<NEWLINE> <NEWLINE>準優勝賞品<LIGHTBLUE>重い兜<WHITE>をゲット!<NEWLINE>");
    giveItem(Item.HornHelmet, 1);
    setTrigger(Trigger(346));
    if (trigger(0)) {
      speak(Entity(5), "「持ち物 いっぱい!」<NEWLINE>");
      inventoryFullBailout();
      giveItem(Item.HornHelmet, 1);
    }
    return;
  }
  if (pstat[3] == 22 && pstat[110] == 1) {
    addMoney(2000);
    speak(Entity.System, " <NEWLINE>準優勝賞金2000<B><it>!<NEWLINE> <NEWLINE>準優勝賞品<LIGHTBLUE>ギザギザはさみ<WHITE>をゲット!<NEWLINE>");
    giveItem(Item.ScissorJaw, 1);
    if (trigger(0)) {
      speak(Entity(5), "「持ち物 いっぱい!」<NEWLINE>");
      inventoryFullBailout();
      giveItem(Item.ScissorJaw, 1);
    }
    return;
  }
  return;
}

