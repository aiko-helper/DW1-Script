// DG098.SCN
#include "functions.dgs"
#pragma script index=98 start=0x44000 end=0x44800 headerU16=0x1c sentinelOff=0x375
#include "entities.dgs"

section onEnter(254) {
  spawnChest(Item.SuperRecovery, 9, 1196, 0, 660);
  spawnChest(Item.LargeMP, 1223, 266, 1024, 661);
  if (!trigger(322)) goto L1;
  setObjectVisibility(0, 1);

L1:
  return;
}

section(51) {
  warp(to: Map.ICSA05, spawn: 0, trigger: 255);
  return;
}

section(5) {
  speak(5, "Shouldn't you go home?\n");
  startBattle();
  setTrigger(294);
  return;
}

section(6) {
  speak(6, "Go home!\n");
  startBattle();
  setTrigger(272);
  return;
}

section(7) {
  speak(7, "You should go back!\n");
  startBattle();
  setTrigger(272);
  return;
}

section(52) {
  if (!trigger(322)) goto L1;
  return;

L1:
  playAnimation(Entity.Player, 22);
  playSound(8, 9);
  delay(15);
  speak(Entity.Player, "Oh, it's so blinding!\n");
  playAnimation(Entity.Player, 0);
  setPStat(254, 40);
  callSubroutine(45);
  delay(40);
  speak(Entity.System, "<YELLOW>??? mon <WHITE>\nHe who seeks my help, the\ntime has come! I give you\nthe blessings of my wings!\n");
  speak(Entity.Player, "What the..? Where..?\nWhose voice..?\n");
  showTextbox("Ugh!\n");
  setObjectVisibility(0, 1);
  callSubroutine(46);
  delay(40);
  playAnimation(Entity.Player, 24);
  delay(15);
  speak(Entity.Player, "What was that?  The light is\ngone. There's nothing else\nhere. That means it's above?!\n");
  playAnimation(Entity.Player, 23);
  delay(15);
  playAnimation(Entity.Player, 0);
  setTrigger(322);
  return;
