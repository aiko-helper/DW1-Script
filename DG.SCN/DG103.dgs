// DG103.SCN
#include "functions.dgs"
#pragma script index=103 start=0x49000 end=0x4a000 headerU16=0x1c sentinelOff=0xfe
#include "entities.dgs"

section onEnter(254) {
  return;
}

section(5) {
  speak(5, "I'm tired of training here.\nWhat should I do?\n");
  speak(Entity.Player, "What to do?\n");
  speak(5, "Where do you train?\n");
  if (trigger(205)) goto L1;
  speak(Entity.Player, "Is that a training ground?\n");
  speak(5, "I'm tired of training.\nI want to do live battle.\n");
  return;

L1:
  setDialogOwner(Entity.Player);
  setSelection(L2, L3);
  showTextbox("Maybe it's a training ground\nMaybe it's an Arena\n");

L2:
  speak(5, "I'm tired of training.\nI want to do live battle.\n");
  return;

L3:
  speak(5, "I want to go there.\nI'll train there.\n");
  goto L4;

L4:
  approach(who: 5, x: -1342, y: -2147, tries: 3, wait: 20);
  playSound(8, 17);
  speak(Entity.System, "Kabuterimon joins the city!\n");
  setTrigger(219);
  addPStat(1, 2);
  return;
}

section(6) {
  speak(6, "The Insectoid Warrior\nTournament takes place here\nevery year...\n");
  showTextbox("...on days with two two's.\nThe winner gets great stuff!\n");
  showTextbox("But only Insectoid\nDigimon can enter.\n");
  if (!trigger(346)) goto L1;
  speak(6, "There's Kabuterimon,\nKuragamon, Kunemon,\nand one other Insectoid.\n");
  showTextbox("But, no Numemon.\n");
  showTextbox("On days with two two's, the\nInsectoid Warrior Contest\ntakes place every year.\n");
  showTextbox("You've won before, right?\n");
  return;

L1:
  speak(6, "There's Kabuterimon,\nKuragamon, Kunemon,\nand one other Insectoid.\n");
  showTextbox("That's HerculesKabuterimon.\n");
  showTextbox("Hercules-Kabuterimon is\nsuper strong.\n");
  showTextbox("The contest winner can\nbecome Hercules-Kabuterimon\nand get Items.\n");
  showTextbox("You can enter Insectoid\nWarrior Contests many times.\n");
  return;
}

section(7) {
  if (hasTech(Move.MassMorph) == 0) goto L1;
  speak(7, "You're strong.\nThere's nothing to teach you.\n");
  return;

L1:
  speak(7, "We're researching Techniques.\nIt's difficult to master\nhard Techniques.\n");
  showTextbox("If you have ability, you\nmight master the Techniques.\nWant to master the hard ones?\n");
  setDialogOwner(Entity.Player);
  choice { "Of course!" -> L2, "No, I don't" -> L6 }
  return;

L2:
  speak(7, "Then I'll try it.\n");
  if (stat[Stat.Defense] >= 500) goto L3;
  speak(7, "You lack Defensive Power.\nTrain more.\n");
  return;

L3:
  if (stat[Stat.Speed] >= 500) goto L4;
  speak(7, "You lack Speed.\nTrain more.\n");
  return;

L4:
  if (stat[Stat.MaxHP] >= 500) goto L5;
  speak(7, "You lack HP.\nTrain more.\n");
  return;

L5:
  learnMove(Move.MassMorph);
  speak(7, "You mastered a Technique.\n");
  speak(Entity.System, "You mastered the 'Bug'!\n");
  waitForEntity(7);
  moveCamera(to: Entity.Player, speed: 10);
  waitForEntity(200);
  return;

L6:
  return;
}

section(81) {
  rotate(entity: Entity.Player, to: 2128);
  setTextboxOrigin(-541, 0, 1823);
  callSubroutine(39);
  speak(200, "<GREEN>Training: Rock Pushing <WHITE>\n");
  choice { "Begin" -> L1, "Explain" -> L2, "Quit" -> L3 }
  return;

L1:
  choice { "Normal" -> L4, "Bonus Try" -> L5, "Quit" -> L3 }
  return;

L2:
  showTextbox("Get power by pushing\non the rock. Maximum\nHP is boosted greatly.\n");
  choice { "Explain again" -> L2, "Begin" -> L1, "Quit" -> L3 }
  return;

L3:
  return;

L4:
  fadeOutHUD();
  setPStat(254, 0);
  setPStat(246, 0);
  callDigimonSubroutine(214);
  callSubroutine(7);
  return;

L5:
  setTexboxMode(1, 0);
  speak(Entity.System, "<YELLOW>Slot game <WHITE>\nUse <LIGHTBLUE><X> <WHITE>to\nmatch three pictures.\n");
  setPStat(254, 0);
  setPStat(246, 1);
  callDigimonSubroutine(214);
  callSubroutine(7);
  setTexboxMode(0, 0);
  return;
}

section(83) {
  rotate(entity: Entity.Player, to: 1968);
  setTextboxOrigin(-1330, 0, 1434);
  callSubroutine(39);
  speak(200, "<GREEN>Training: Striking <WHITE>\n");
  choice { "Begin" -> L1, "Explain" -> L2, "Quit" -> L3 }
  return;

L1:
  setDialogOwner(200);
  choice { "Normal" -> L4, "Bonus Try" -> L5, "Quit" -> L3 }
  return;

L2:
  speak(200, "Using a dummy, strike at\nfull force. Offensive Power\nis boosted greatly.\n");
  choice { "Explain again" -> L2, "Begin" -> L1, "Quit" -> L3 }
  return;

L3:
  return;

L4:
  fadeOutHUD();
  setPStat(254, 1);
  setPStat(246, 0);
  callDigimonSubroutine(214);
  callSubroutine(7);
  return;

L5:
  setTexboxMode(1, 0);
  speak(Entity.System, "<YELLOW>slot game <WHITE>\nUse <LIGHTBLUE><X> <WHITE>to\nmatch three pictures.\n");
  setPStat(254, 1);
  setPStat(246, 1);
  callDigimonSubroutine(214);
  callSubroutine(7);
  setTexboxMode(0, 0);
  return;
  garbage { 1c 00 fe 00 1c 00 05 00 1e 00 06 00 28 03 07 00 16 08 51 00 a4 0b 53 00 b0 0d ff ff fe 00 1b 05 1a 00 82 68 81 75 82 8d 81 40 82 94 82 89 82 92 82 85 82 84 81 40 }
}
