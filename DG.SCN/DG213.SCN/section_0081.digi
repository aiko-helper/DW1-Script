  0020:  setTrigger 91
  0024:  setDialogOwner 5
  0026:  showTextbox "Oh, <LIGHTBLUE><PLAYER><WHITE>, <ORANGE><DIGIMON><WHITE>\nyou came. Look at this great\nFile City Arena. Cool, huh!\n"
  00b6:  showTextbox "Soon contestants and fans will\nfill this up. You will also\nbring joy to the fans, right?!\n"
  016e:  showTextbox "They'll prepare money and\nprizes for tournament winners.\nYou got nothing to lose.\n"
  0216:  showTextbox "For details on the tournament,\ncheck out the machine there.\n"
  0292:  endSection
  0294:  jump section_81+0x29a
  0298:  endSection
  029a:  storeDigimonType 103
  029c:  if pstat[103] != 1 AND pstat[103] != 2 AND pstat[103] != 15 AND pstat[103] != 16 then section_81+0x358
  02b4:  setDialogOwner 5
  02b6:  showTextbox "Oh yeah, In-Training\nDigimon can't enter though.\nShall I check the schedule?\n"
