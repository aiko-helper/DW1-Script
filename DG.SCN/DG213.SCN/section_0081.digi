  0916:  endSection
  0918:  setDialogOwner 5
  091a:  showTextbox "Once inside, at start time,\ngo down the left stairs in\norder to compete in battle.\n"
  09c4:  showTextbox "Registration is free. You can\nregister for only today's and\ntommorrow's competition.\n"
  0a72:  showTextbox "However, for that day's\ncompetition, you have to\nregister by ten am.\n"
  0b00:  showTextbox "You can check the schedule\nfive days ahead, so check it\nand make your plans.\n"
  0b9e:  showTextbox "The competitions in red mean\nyou that you can't take part.\n"
  0c18:  showTextbox "But press the start button\nto check what it's about.\n"
  0c86:  showTextbox "Even for competitions with\nQualifications: None,\n"
  0cec:  showTextbox "In-Training Digimon\ncannot compete.\n"
  0d38:  showTextbox "Well, that's about it for\nregistration. Do you want\nto enter?\n"
  0db8:  setDialogOwner 253
