  078e:  setDialogOwner 5
  0790:  showTextbox "So you've entered today's\ncompetition, right?\nGo in by eleven pm.\n"
  0818:  showTextbox "You're not planning to\ncancel, are you?!\n"
  086e:  setDialogOwner 253
