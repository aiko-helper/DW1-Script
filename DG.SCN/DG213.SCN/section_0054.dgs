// source: extract/DIGIMON/SCN/DG.SCN
// DG213.SCN, section 54

section section_54(54) {  // len=568
    if (trigger(37) && pstat[3] != 22) goto L_0082;
    look(entity: 5, at: Entity.Player);
    look(entity: Entity.Player, at: 5);
    delay(5);
    setDialogOwner(5);
    showTextbox("Hey! You haven't\nregistered, you know!\n");
    move(entity: Entity.Player, to: (-824, 1146), sprint: 1);
    waitForEntity(Entity.Player);
    moveCamera(to: Entity.Player, speed: 10);
    waitForEntity(200);
    return;
L_0082:
    if (pstat[2] < 128) goto L_0108;
    look(entity: 5, at: Entity.Player);
    look(entity: Entity.Player, at: 5);
    delay(5);
    setDialogOwner(5);
    showTextbox("Hey! The tournament is\ntomorrow, you know!\n");
    move(entity: Entity.Player, to: (-824, 1146), sprint: 1);
    waitForEntity(Entity.Player);
    moveCamera(to: Entity.Player, speed: 10);
    waitForEntity(200);
    return;
L_0108:
    storeDate(105);
    if (pstat[107] >= 10) goto L_01a6;
    look(entity: 5, at: Entity.Player);
    look(entity: Entity.Player, at: 5);
    delay(5);
    setDialogOwner(5);
    showTextbox("It's still early to enter.\nWaiting until ten o'clock.\n");
    move(entity: Entity.Player, to: (-824, 1146), sprint: 1);
    waitForEntity(Entity.Player);
    moveCamera(to: Entity.Player, speed: 10);
    waitForEntity(200);
    return;
L_01a6:
    roll(pstat: 110, max: 99);
    if (!trigger(40)) goto L_0210;
    if (stat[Stat.TamerLevel] == 0) goto L_0210;
    if (pstat[110] > 29) goto L_0210;
    reduceStats(Stat.TamerLevel, 1);
    setDialogOwner(Entity.System);
    showTextbox(" \n<PINK>Tamer Level went down!<WHITE>\n");
L_0210:
    setPStat(254, 5);
    callSubroutine(6);
    storeDate(105);
    addMinutesToDate(105, 360);
    advanceToDate(105);
    if (!trigger(50)) goto L_0232;
    warp(to: Map.ROOM19, spawn: 3, trigger: 61);
    return;
L_0232:
    warp(to: Map.ROOM13, spawn: 3, trigger: 61);
    return;
}
