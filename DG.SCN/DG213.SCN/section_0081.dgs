section section_81(81) {  // len=3588
    look(entity: Entity.Player, at: 5);
    look(entity: 5, at: Entity.Player);
    delay(5);
    moveCamera(to: (83, 1113), slowdown: 20);
    waitForEntity(200);
    if (trigger(91)) goto L_0294;
    setTrigger(91);
    setDialogOwner(5);
    showTextbox("Oh, <LIGHTBLUE><PLAYER><WHITE>, <ORANGE><DIGIMON><WHITE>\nyou came. Look at this great\nFile City Arena. Cool, huh!\n");
    showTextbox("Soon contestants and fans will\nfill this up. You will also\nbring joy to the fans, right?!\n");
    showTextbox("They'll prepare money and\nprizes for tournament winners.\nYou got nothing to lose.\n");
    showTextbox("For details on the tournament,\ncheck out the machine there.\n");
    return;
L_0294:
    goto L_029a;
L_0298:
    return;
L_029a:
    storeDigimonType(103);
    if (pstat[103] != 1 && pstat[103] != 2 && pstat[103] != 15 && pstat[103] != 16) goto L_0358;
    setDialogOwner(5);
    showTextbox("Oh yeah, In-Training\nDigimon can't enter though.\nShall I check the schedule?\n");
    goto L_049a;
L_0358:
    if (pstat[103] != 29 && pstat[103] != 30 && pstat[103] != 43 && pstat[103] != 44) goto L_0414;
    setDialogOwner(5);
    showTextbox("Oh yeah, In-Training\nDigimon can't enter though.\nShall I check the schedule?\n");
    goto L_049a;
L_0414:
    if (trigger(37)) goto L_0496;
    setDialogOwner(5);
    showTextbox("I'm glad you came. Do you\nwanna enter the tournament?\n");
    goto L_049a;
L_0496:
    goto L_04ec;
L_049a:
    setDialogOwner(Entity.Player);
    setSelection(L_04de, L_0298, L_0918);
    showTextbox("Yes\nNo\nWhat do you mean?\n");
    waitForSelectionChoice();
    return;
L_04de:
    setPStat(254, 5);
    callSubroutine(18);
    moveCamera(to: Entity.Player, speed: 10);
    waitForEntity(200);
    return;
L_04ec:
    if (pstat[2] < 128) goto L_0500;
    goto L_0504;
    goto L_0504;
L_0500:
    goto L_0624;
L_0504:
    setDialogOwner(5);
    showTextbox("So you're entering\ntommorrow's\ncompetition, right?\n");
    showTextbox("Are you going to cancel\nyour entry?\n");
    setDialogOwner(Entity.Player);
    setSelection(L_0298, L_08d6);
    showTextbox("No, I won't cancel\nYes, I'm cancelling\n");
    waitForSelectionChoice();
    goto L_0298;
    moveCamera(to: Entity.Player, speed: 10);
    waitForEntity(200);
    return;
L_0624:
    storeDate(105);
    if (pstat[107] < 0 || pstat[107] >= 10) goto L_078e;
    setDialogOwner(5);
    showTextbox("So you've entered today's\ncompetition, right?\nYou can go in from ten am.\n");
    showTextbox("You're not planning to cancel,\nare you?!\n");
    setDialogOwner(Entity.Player);
    setSelection(L_0298, L_08d6);
    showTextbox("No, I won't cancel\nYes, I'm cancelling\n");
    waitForSelectionChoice();
    goto L_0298;
    moveCamera(to: Entity.Player, speed: 10);
    waitForEntity(200);
    goto L_08d4;
L_078e:
    setDialogOwner(5);
    showTextbox("So you've entered today's\ncompetition, right?\nGo in by eleven pm.\n");
    showTextbox("You're not planning to\ncancel, are you?!\n");
    setDialogOwner(Entity.Player);
    setSelection(L_0298, L_08d6);
    showTextbox("No, I won't cancel\nYes, I'm cancelling\n");
    waitForSelectionChoice();
    goto L_0298;
    moveCamera(to: Entity.Player, speed: 10);
    waitForEntity(200);
L_08d4:
    return;
L_08d6:
    unsetTrigger(37);
    setDialogOwner(5);
    showTextbox("Well, I'll cancel for you.\n");
    return;
L_0918:
    setDialogOwner(5);
    showTextbox("Once inside, at start time,\ngo down the left stairs in\norder to compete in battle.\n");
    showTextbox("Registration is free. You can\nregister for only today's and\ntommorrow's competition.\n");
    showTextbox("However, for that day's\ncompetition, you have to\nregister by ten am.\n");
    showTextbox("You can check the schedule\nfive days ahead, so check it\nand make your plans.\n");
    showTextbox("The competitions in red mean\nyou that you can't take part.\n");
    showTextbox("But press the start button\nto check what it's about.\n");
    showTextbox("Even for competitions with\nQualifications: None,\n");
    showTextbox("In-Training Digimon\ncannot compete.\n");
    showTextbox("Well, that's about it for\nregistration. Do you want\nto enter?\n");
    setDialogOwner(Entity.Player);
    setSelection(L_04de, L_0298, L_0918);
    showTextbox("Yes\nNo\nSorry, explain again\n");
    waitForSelectionChoice();
    return;
    return;
}
