// DG215.SCN
#pragma script index=215 start=0xba000 end=0xbb000 headerU16=0xc sentinelOff=0xfe

section onEnter(254) {
    return;
}

section(6) {
    if (trigger(93)) goto L1;
    setTrigger(93);
    speak(6, "Since my injury is healed,\nI want to work. Thanks\nfor taking care of me.\n");
    showTextbox("I can predict the future\nof any creature and that's\nwhat I'll do.\n");
    showTextbox("If you're interested, please\ncome to visit my shop.\nI won't charge you.\n");
    return;

L1:
    speak(6, "Are you interested in finding\nout your fortune?\nOK, let me look at it.\n");
    showTextbox("Hmmm, oh... oh, wow!\n");
    delay(20);
    showTextbox("Well, first of all...\n");
    roll(pstat: 110, max: 11);
    if (pstat[110] > 0) goto L2;
    goto L6;

L2:
    if (pstat[110] > 3) goto L3;
    goto L9;

L3:
    if (pstat[110] > 8) goto L4;
    goto L13;

L4:
    if (pstat[110] > 10) goto L5;
    goto L17;

L5:
    if (pstat[110] > 11) goto L6;
    goto L21;

L6:
    speak(6, "Overall, you have\nvery good luck.\n");
    roll(pstat: 110, max: 2);
    if (pstat[110] > 0) goto L7;
    goto L24;

L7:
    if (pstat[110] > 1) goto L8;
    goto L25;

L8:
    if (pstat[110] > 2) goto L9;
    goto L26;

L9:
    speak(6, "Overall, it looks quite good.\n");
    roll(pstat: 110, max: 3);
    if (pstat[110] > 0) goto L10;
    goto L27;

L10:
    if (pstat[110] > 1) goto L11;
    goto L28;

L11:
    if (pstat[110] > 2) goto L12;
    goto L29;

L12:
    if (pstat[110] > 3) goto L13;
    goto L30;

L13:
    speak(6, "Your overall luck is fair.\n");
    roll(pstat: 110, max: 3);
    if (pstat[110] > 0) goto L14;
    goto L31;

L14:
    if (pstat[110] > 1) goto L15;
    goto L32;

L15:
    if (pstat[110] > 2) goto L16;
    goto L33;

L16:
    if (pstat[110] > 3) goto L17;
    goto L34;

L17:
    speak(6, "Your overall luck is\nnot so good.\n");
    roll(pstat: 110, max: 3);
    if (pstat[110] > 0) goto L18;
    goto L35;

L18:
    if (pstat[110] > 1) goto L19;
    goto L36;

L19:
    if (pstat[110] > 2) goto L20;
    goto L37;

L20:
    if (pstat[110] > 3) goto L21;
    goto L38;

L21:
    speak(6, "Overall, it's not good.\n");
    roll(pstat: 110, max: 2);
    if (pstat[110] > 0) goto L22;
    goto L39;

L22:
    if (pstat[110] > 1) goto L23;
    goto L40;

L23:
    if (pstat[110] > 2) goto L24;
    goto L41;

L24:
    speak(6, "Whatever you do,\nit will go well.\n");
    goto L42;

L25:
    speak(6, "You'll have a wonderful\nchance coming to you.\n");
    goto L42;

L26:
    speak(6, "You might have a\nmemorable event.\n");
    goto L42;

L27:
    speak(6, "You might find\nan unexpected thing.\n");
    goto L42;

L28:
    speak(6, "Your question will be\nanswered.\n");
    goto L42;

L29:
    speak(6, "Your wallet will get fatter.\n");
    goto L42;

L30:
    speak(6, "You might get good news\nfrom your friends.\n");
    goto L42;

L31:
    speak(6, "Changing your mood may be\ngood for you.\n");
    goto L42;

L32:
    speak(6, "Try going somewhere you\ndon't usually go.\n");
    goto L42;

L33:
    speak(6, "You might have an\ninteresting dream.\n");
    goto L42;

L34:
    speak(6, "Try not spending\ntoo much money.\n");
    goto L42;

L35:
    speak(6, "Your secret may be revealed.\n");
    goto L42;

L36:
    speak(6, "Better to go to bed early.\n");
    goto L42;

L37:
    speak(6, "Guard your stuff well.\n");
    goto L42;

L38:
    speak(6, "Your friend may get his\nfrustration out on you.\n");
    goto L42;

L39:
    speak(6, "Multiple disasters may fall.\nupon you...\n");
    goto L42;

L40:
    speak(6, "You might encounter a\nperson you don't like.\n");
    goto L42;

L41:
    speak(6, "A big loss may fall\nupon you...\n");
    goto L42;

L42:
    roll(pstat: 110, max: 9);
    if (pstat[110] > 0) goto L43;
    speak(6, "Your lucky color is red.\n");
    goto L52;

L43:
    if (pstat[110] > 1) goto L44;
    speak(6, "Your lucky color is white.\n");
    goto L52;

L44:
    if (pstat[110] > 2) goto L45;
    speak(6, "Your lucky color is blue.\n");
    goto L52;

L45:
    if (pstat[110] > 3) goto L46;
    speak(6, "Your lucky color is black.\n");
    goto L52;

L46:
    if (pstat[110] > 4) goto L47;
    speak(6, "Your lucky color is green.\n");
    goto L52;

L47:
    if (pstat[110] > 5) goto L48;
    speak(6, "Your lucky color is gray.\n");
    goto L52;

L48:
    if (pstat[110] > 6) goto L49;
    speak(6, "Your lucky color is brown.\n");
    goto L52;

L49:
    if (pstat[110] > 7) goto L50;
    speak(6, "Your lucky color is yellow.\n");
    goto L52;

L50:
    if (pstat[110] > 8) goto L51;
    speak(6, "Your lucky color is purple.\n");
    goto L52;

L51:
    if (pstat[110] > 9) goto L52;
    speak(6, "Your lucky color is gold.\n");
    goto L52;

L52:
    speak(6, "Finally, about your\ncompatibility with\n<ORANGE><DIGIMON><WHITE>...\n");
    roll(pstat: 110, max: 4);
    if (pstat[110] > 0) goto L53;
    speak(6, "It's a perfect match.\n");
    goto L57;

L53:
    if (pstat[110] > 1) goto L54;
    speak(6, "It's pretty good.\n");
    goto L57;

L54:
    if (pstat[110] > 2) goto L55;
    speak(6, "It's ok.\n");
    goto L57;

L55:
    if (pstat[110] > 3) goto L56;
    speak(6, "It's so so.\n");
    goto L57;

L56:
    if (pstat[110] > 4) goto L57;
    speak(6, "It's not bad...\n");
    goto L57;

L57:
    return;
    garbage { 0c 00 fe 00 0c 00 06 00 0e 00 ff ff fe 00 19 00 01 00 5d 00 18 00 d4 01 19 00 1c 00 5d 00 1b 06 1a 00 82 72 82 89 82 8e 82 83 82 85 81 40 82 8d 82 99 81 40 }
}
