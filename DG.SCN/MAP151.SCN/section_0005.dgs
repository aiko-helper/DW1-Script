// source: extract/DIGIMON/SCN/DG.SCN
// MAP151.SCN, section 5

section section_5(5) {  // len=8168
    if (!trigger(240)) goto L_0052;
    setDialogOwner(5);
    showTextbox("It's all cool here.\nGood luck.\n");
    return;
L_0052:
    if (!trigger(330)) goto L_0150;
    setDialogOwner(5);
    showTextbox("I must help, too. I'll go\nback and forth between here\nand the city whenever I can.\n");
    playSound(8, 10);
    setDialogOwner(Entity.System);
    showTextbox("Andromon joins the city!\n");
    setTrigger(240);
    addPStat(1, 3);
    return;
L_0150:
    if (!trigger(329)) goto L_0934;
    setDialogOwner(5);
    showTextbox("Data repair is complete.\nNow, let's read data.\n");
    rotate(entity: 5, to: 2048);
    delay(20);
    playSound(8, 5);
    setDialogOwner(Entity.Player);
    showTextbox("Please.\n");
    playSound(8, 6);
    setDialogOwner(Entity.System);
    showTextbox("One hundred years ago,\nAnalog Humans appeared\non Digimon island.\n");
    showTextbox("Analog Humans and native\nDigimon fought very hard.\n");
    showTextbox("After ten years of battle,\nthe Analog Humans were\ndefeated and disappeared.\n");
    showTextbox("In the next ten years,\nmysteriously, the island's\narea almost doubled in size.\n");
    playAnimation(Entity.Player, 16);
    delay(15);
    setDialogOwner(Entity.Player);
    showTextbox("So humans fought Digimon?\n");
    playAnimation(Entity.Player, 0);
    setDialogOwner(5);
    showTextbox("I'm sorry. That's all the\ndata we could recover.\n");
    rotate(entity: 5, to: 0);
    delay(20);
    setDialogOwner(Entity.Player);
    showTextbox("Don't worry. This is \nvery important information.\nNow I know so much more.\n");
    setDialogOwner(5);
    showTextbox("Is that right?\n");
    playAnimation(Entity.Player, 25);
    delay(15);
    setDialogOwner(Entity.Player);
    showTextbox("These humans are probably the\nones who caused confusion and\ntrouble on the island.\n");
    playAnimation(Entity.Player, 0);
    setDialogOwner(5);
    showTextbox("Can humans live\none hundred years?\n");
    setDialogOwner(Entity.Player);
    showTextbox("It seems that for humans,\ntime is slow in this world.\n");
    showTextbox("I guess that's why I don't\nhave to eat or sleep here.\n");
    showTextbox("One hundred years is a\nvery long time. Those guys\nmust be very tough.\n");
    setDialogOwner(5);
    showTextbox("Do you think they are\nhiding somewhere?\n");
    setDialogOwner(Entity.Player);
    showTextbox("I'll find them\nand do something.\n");
    showTextbox("Now I know why I'm here. \nSince I'm human,\nI need to deal with them.\n");
    setTrigger(330);
    return;
L_0934:
    if (!trigger(211) || trigger(328)) goto L_0fd0;
    setDialogOwner(5);
    showTextbox("We're so sorry. We'll close\nthe factory for a while.\n");
    playAnimation(Entity.Player, 19);
    delay(15);
    setDialogOwner(Entity.Player);
    showTextbox("Because of the trouble now,\nno one can say what's gonna\nhappen. It's not your fault.\n");
    playAnimation(Entity.Player, 0);
    setDialogOwner(Entity.Player);
    showTextbox("I think there's somebody\ncontrolling Giromon.\n");
    showTextbox("Computers were destroyed and\nwaste water started to leak.\n");
    showTextbox("That water made Digimons\ninsane. I don't think\nit's a coincidence.\n");
    setDialogOwner(5);
    showTextbox("These computers have some\nkey importance.\n");
    showTextbox("It may be too late,\nbut I think someone was\ntrying to get us.\n");
    setDialogOwner(Entity.Player);
    showTextbox("What?!\n");
    setDialogOwner(5);
    showTextbox("I think there was some data\nregarding the island's past\non these computers.\n");
    showTextbox("But due to the Giromon's\nriot, the data was destroyed.\n");
    setDialogOwner(Entity.Player);
    showTextbox("You've never seen the data?\n");
    setDialogOwner(5);
    showTextbox("No, but we might be able to\nrepair some of it. I'll\ntry to connect the data.\n");
    setDialogOwner(Entity.Player);
    showTextbox("I see, thank you.\nHow long will it take?\n");
    setDialogOwner(5);
    showTextbox("It'll be a while. I'll\nreopen the town entrance,\nso come back again.\n");
    setDialogOwner(Entity.Player);
    showTextbox("Thanks. I'll be back.\n");
    setTrigger(328);
    return;
L_0fd0:
    if (!trigger(328)) goto L_10b4;
    setDialogOwner(Entity.Player);
    showTextbox("Have you finish\nrepairing the data?\n");
    setDialogOwner(5);
    showTextbox("It'll take a while longer.\nCome back again.\n");
    setDialogOwner(Entity.Player);
    showTextbox("OK, I'll be back.\n");
    return;
L_10b4:
    if (!trigger(344) || trigger(211) || trigger(341)) goto L_128c;
    playAnimation(Entity.Player, 7);
    delay(10);
    setDialogOwner(Entity.Player);
    showTextbox("Hey, hey!\n");
    setDialogOwner(5);
    showTextbox("I have to apologize.\n");
    playAnimation(Entity.Player, 7);
    delay(15);
    setDialogOwner(Entity.Player);
    showTextbox("Do that later, you gotta stop\nthe factory's machines now!\n");
    playAnimation(Entity.Player, 0);
    setDialogOwner(5);
    showTextbox("Alright, I will.\n");
    rotate(entity: 5, to: 2048);
    delay(20);
    playSound(8, 5);
    setDialogOwner(5);
    showTextbox("The factory's function has\njust stopped.\n");
    setDialogOwner(Entity.Player);
    showTextbox("Good, I'll check the sewer.\nLaters, dude.\n");
    setTrigger(341);
    return;
L_128c:
    if (!trigger(341)) goto L_1318;
    setDialogOwner(5);
    showTextbox("I must apologize.\n");
    setDialogOwner(Entity.Player);
    showTextbox("We don't got time\nto discuss that now!\n");
    return;
L_1318:
    if (!trigger(343)) goto L_1468;
    setDialogOwner(5);
    showTextbox("Our computer is perfect.\n");
    setDialogOwner(Entity.Player);
    showTextbox("Is the factory really safe?\nWhat can we do now?\n");
    playAnimation(Entity.Player, 16);
    delay(20);
    playAnimation(Entity.Player, 0);
    setDialogOwner(Entity.Player);
    showTextbox("OK, we gotta do something\nabout the guards. We don't\nhave any other way!\n");
    return;
L_1468:
    setDialogOwner(5);
    showTextbox("How did you get into town?\n");
    if (trigger(347)) goto L_1518;
    setDialogOwner(5);
    showTextbox("If you don't have any\nbusiness here, leave now!\n");
    return;
L_1518:
    if (trigger(344) || !trigger(347) || trigger(343)) goto L_1bac;
    setDialogOwner(Entity.Player);
    showTextbox("We can talk about that later.\nI gotta check out\nthe factory now.\n");
    showTextbox("This is a life and death\nsituation. Give me the okay!\n");
    setDialogOwner(5);
    showTextbox("I don't quite understand\nwhat you're trying to do.\nI can't give you permission.\n");
    setDialogOwner(Entity.Player);
    showTextbox("There are Digimon about to\nfade away because of the\nwaste water from the factory!\n");
    setDialogOwner(5);
    showTextbox("From the factory? No way!\nThe waste water cleaning\nsystem is working fine.\n");
    setDialogOwner(Entity.Player);
    showTextbox("How can you know it's working\nfine if we don't check?!\n");
    playAnimation(Entity.Player, 19);
    delay(5);
    setDialogOwner(5);
    showTextbox("Our computer is perfect. In\nemergencies, the Net Keeper\nwill shut down the system.\n");
    setDialogOwner(Entity.Player);
    showTextbox("Are you telling me that\nNet Keeper will always\nwork correctly?\n");
    playAnimation(Entity.Player, 0);
    delay(5);
    setDialogOwner(5);
    showTextbox("Net Keeper is another\nname for Giromon who is\nan Ultimate Digimon.\n");
    showTextbox("His judgement and ability\nare so perfect.\n");
    setDialogOwner(Entity.Player);
    showTextbox("He is a Digimon?! Oh no, we\nare in even more trouble now.\nPlease, give me permission!\n");
    playAnimation(Entity.Player, 19);
    delay(5);
    setDialogOwner(5);
    showTextbox("Leave! Now!\n");
    playAnimation(Entity.Player, 22);
    delay(10);
    setDialogOwner(Entity.Player);
    showTextbox("Sigh...Rats!\n");
    setTrigger(343);
L_1bac:
    return;
    garbage { 10 00 fe 00 10 00 33 00 12 00 05 00 18 00 ff ff fe 00 4b 9a 02 ff fe 00 19 00 00 00 f0 00 18 00 6a 00 19 00 1b 05 1a 00 82 68 82 94 81 75 82 93 81 40 82 81 82 8c 82 8c 81 40 82 83 82 8f 82 8f 82 8c 81 40 82 88 82 85 82 92 82 85 81 42 0d 00 82 66 82 8f 82 8f 82 84 81 40 82 8c 82 95 82 83 82 8b 81 42 0d 00 00 00 fe 00 19 00 00 00 4a 01 18 00 68 01 19 00 1b 05 1a 00 82 68 81 40 82 8d 82 95 82 93 82 94 81 40 82 88 82 85 82 8c 82 90 81 43 81 40 82 94 82 8f 82 8f 81 42 81 40 82 68 81 75 82 8c 82 8c 81 40 82 87 82 8f 0d 00 82 82 82 81 82 83 82 8b 81 40 82 81 82 8e 82 84 81 40 82 86 82 8f 82 92 82 94 82 88 81 40 82 82 82 85 82 94 82 97 82 85 82 85 82 8e 81 40 82 88 82 85 82 92 82 85 0d 00 82 81 82 8e 82 84 81 40 82 94 82 88 82 85 81 40 82 83 82 89 82 94 82 99 81 40 82 97 82 88 82 85 82 8e 82 85 82 96 82 85 82 92 81 40 82 68 81 40 82 83 82 81 82 8e 81 42 0d 00 00 00 5a 00 08 0a 1b ff 1a 00 82 60 82 8e 82 84 82 92 82 8f 82 8d 82 8f 82 8e 81 40 82 8a 82 8f 82 89 82 8e 82 93 81 40 82 94 82 88 82 85 81 40 82 83 82 89 82 94 82 99 81 49 0d 00 00 00 1c 00 f0 00 1f 00 01 03 fe 00 19 00 00 00 49 01 18 00 4c 09 19 00 1b 05 1a 00 82 63 82 81 82 94 82 81 81 40 82 92 82 85 82 90 82 81 82 89 82 92 81 40 82 89 82 93 81 40 82 83 82 8f 82 8d 82 90 82 8c 82 85 82 94 82 85 81 42 0d 00 82 6d 82 8f 82 97 81 43 81 40 82 8c 82 85 82 94 81 75 82 93 81 40 82 92 82 85 82 81 82 84 81 40 82 84 82 81 82 94 82 81 81 42 0d 00 00 00 4d 05 00 08 67 00 14 00 5a 00 08 05 1b fd 1a 00 82 6f 82 8c 82 85 82 81 82 93 82 85 81 42 0d 00 00 00 5a 00 08 06 1b ff 1a 00 82 6e 82 8e 82 85 81 40 82 88 82 95 82 8e 82 84 82 92 82 85 82 84 81 40 82 99 82 85 82 81 82 92 82 93 81 40 82 81 82 87 82 8f 81 43 0d 00 82 60 82 8e 82 81 82 8c 82 8f 82 87 81 40 82 67 82 95 82 8d 82 81 82 8e 82 93 81 40 82 81 82 90 82 90 82 85 82 81 82 92 82 85 82 84 0d 00 82 8f 82 8e 81 40 82 63 82 89 82 87 82 89 82 8d 82 8f 82 8e 81 40 82 89 82 93 82 8c 82 81 82 8e 82 84 81 42 0d 00 00 00 1a 00 82 60 82 8e 82 81 82 8c 82 8f 82 87 81 40 82 67 82 95 82 8d 82 81 82 8e 82 93 81 40 82 81 82 8e 82 84 81 40 82 8e 82 81 82 94 82 89 82 96 82 85 0d 00 82 63 82 89 82 87 82 89 82 8d 82 8f 82 8e 81 40 82 86 82 8f 82 95 82 87 82 88 82 94 81 40 82 96 82 85 82 92 82 99 81 40 82 88 82 81 82 92 82 84 81 42 0d 00 00 00 1a 00 82 60 82 86 82 94 82 85 82 92 81 40 82 94 82 85 82 8e 81 40 82 99 82 85 82 81 82 92 82 93 81 40 82 8f 82 86 81 40 82 82 82 81 82 94 82 94 82 8c 82 85 81 43 0d 00 82 94 82 88 82 85 81 40 82 60 82 8e 82 81 82 8c 82 8f 82 87 81 40 82 67 82 95 82 8d 82 81 82 8e 82 93 81 40 82 97 82 85 82 92 82 85 0d 00 82 84 82 85 82 86 82 85 82 81 82 94 82 85 82 84 81 40 82 81 82 8e 82 84 81 40 82 84 82 89 82 93 82 81 82 90 82 90 82 85 82 81 82 92 82 85 82 84 81 42 0d 00 00 00 1a 00 82 68 82 8e 81 40 82 94 82 88 82 85 81 40 82 8e 82 85 82 98 82 94 81 40 82 94 82 85 82 8e 81 40 82 99 82 85 82 81 82 92 82 93 81 43 0d 00 82 8d 82 99 82 93 82 94 82 85 82 92 82 89 82 8f 82 95 82 93 82 8c 82 99 81 43 81 40 82 94 82 88 82 85 81 40 82 89 82 93 82 8c 82 81 82 8e 82 84 81 75 82 93 0d 00 82 81 82 92 82 85 82 81 81 40 82 81 82 8c 82 8d 82 8f 82 93 82 94 81 40 82 84 82 8f 82 95 82 82 82 8c 82 85 82 84 81 40 82 89 82 8e 81 40 82 93 82 89 82 9a 82 85 81 42 0d 00 00 00 56 00 fd 10 67 00 0f 00 1b fd };
}
