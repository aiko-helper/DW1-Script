; source: ./extract/DIGIMON/SCN/DG.SCN
; MAP151.SCN, section 5

section_5:     ; len=8168
  0000:  if !trigger(240) then section_5+0x52
  000c:  setDialogOwner 5
  000e:  showTextbox "It's all cool here.\nGood luck.\n"
  0050:  endSection
  0052:  if !trigger(330) then section_5+0x150
  005e:  setDialogOwner 5
  0060:  showTextbox "I must help, too. I'll go\nback and forth between here\nand the city whenever I can.\n"
  010a:  playSound 8 10
  010e:  setDialogOwner 255
  0110:  showTextbox "Andromon joins the city!\n"
  0146:  setTrigger 240
  014a:  addPStat 1 3
  014e:  endSection
  0150:  if !trigger(329) then section_5+0x934
  015c:  setDialogOwner 5
  015e:  showTextbox "Data repair is complete.\nNow, let's read data.\n"
  01c0:  setRotation 5 2048
  01c4:  delay 20
  01c8:  playSound 8 5
  01cc:  setDialogOwner 253
  01ce:  showTextbox "Please.\n"
  01e2:  playSound 8 6
  01e6:  setDialogOwner 255
  01e8:  showTextbox "One hundred years ago,\nAnalog Humans appeared\non Digimon island.\n"
  026e:  showTextbox "Analog Humans and native\nDigimon fought very hard.\n"
  02d8:  showTextbox "After ten years of battle,\nthe Analog Humans were\ndefeated and disappeared.\n"
  0374:  showTextbox "In the next ten years,\nmysteriously, the island's\narea almost doubled in size.\n"
  0416:  playAnimation 253 16
  041a:  delay 15
  041e:  setDialogOwner 253
  0420:  showTextbox "So humans fought Digimon?\n"
  0458:  playAnimation 253 0
  045c:  setDialogOwner 5
  045e:  showTextbox "I'm sorry. That's all the\ndata we could recover.\n"
  04c4:  setRotation 5 0
  04c8:  delay 20
  04cc:  setDialogOwner 253
  04ce:  showTextbox "Don't worry. This is \nvery important information.\nNow I know so much more.\n"
  0568:  setDialogOwner 5
  056a:  showTextbox "Is that right?\n"
  058c:  playAnimation 253 25
  0590:  delay 15
  0594:  setDialogOwner 253
  0596:  showTextbox "These humans are probably the\nones who caused confusion and\ntrouble on the island.\n"
  0640:  playAnimation 253 0
  0644:  setDialogOwner 5
  0646:  showTextbox "Can humans live\none hundred years?\n"
  0690:  setDialogOwner 253
  0692:  showTextbox "It seems that for humans,\ntime is slow in this world.\n"
  0702:  showTextbox "I guess that's why I don't\nhave to eat or sleep here.\n"
  0772:  showTextbox "One hundred years is a\nvery long time. Those guys\nmust be very tough.\n"
  0802:  setDialogOwner 5
  0804:  showTextbox "Do you think they are\nhiding somewhere?\n"
  0858:  setDialogOwner 253
  085a:  showTextbox "I'll find them\nand do something.\n"
  08a0:  showTextbox "Now I know why I'm here. \nSince I'm human,\nI need to deal with them.\n"
  092e:  setTrigger 330
  0932:  endSection
  0934:  if !trigger(211) OR trigger(328) then section_5+0xfd0
  0944:  setDialogOwner 5
  0946:  showTextbox "We're so sorry. We'll close\nthe factory for a while.\n"
  09b4:  playAnimation 253 19
  09b8:  delay 15
  09bc:  setDialogOwner 253
  09be:  showTextbox "Because of the trouble now,\nno one can say what's gonna\nhappen. It's not your fault.\n"
  0a6c:  playAnimation 253 0
  0a70:  setDialogOwner 253
  0a72:  showTextbox "I think there's somebody\ncontrolling Giromon.\n"
  0ad2:  showTextbox "Computers were destroyed and\nwaste water started to leak.\n"
  0b4a:  showTextbox "That water made Digimons\ninsane. I don't think\nit's a coincidence.\n"
  0bd4:  setDialogOwner 5
  0bd6:  showTextbox "These computers have some\nkey importance.\n"
  0c2e:  showTextbox "It may be too late,\nbut I think someone was\ntrying to get us.\n"
  0cae:  setDialogOwner 253
  0cb0:  showTextbox "What?!\n"
  0cc2:  setDialogOwner 5
  0cc4:  showTextbox "I think there was some data\nregarding the island's past\non these computers.\n"
  0d60:  showTextbox "But due to the Giromon's\nriot, the data was destroyed.\n"
  0dd2:  setDialogOwner 253
  0dd4:  showTextbox "You've never seen the data?\n"
  0e10:  setDialogOwner 5
  0e12:  showTextbox "No, but we might be able to\nrepair some of it. I'll\ntry to connect the data.\n"
  0eb0:  setDialogOwner 253
  0eb2:  showTextbox "I see, thank you.\nHow long will it take?\n"
  0f08:  setDialogOwner 5
  0f0a:  showTextbox "It'll be a while. I'll\nreopen the town entrance,\nso come back again.\n"
  0f98:  setDialogOwner 253
  0f9a:  showTextbox "Thanks. I'll be back.\n"
  0fca:  setTrigger 328
  0fce:  endSection
  0fd0:  if !trigger(328) then section_5+0x10b4
  0fdc:  setDialogOwner 253
  0fde:  showTextbox "Have you finish\nrepairing the data?\n"
  102a:  setDialogOwner 5
  102c:  showTextbox "It'll take a while longer.\nCome back again.\n"
  1088:  setDialogOwner 253
  108a:  showTextbox "OK, I'll be back.\n"
  10b2:  endSection
  10b4:  if !trigger(344) OR trigger(211) OR trigger(341) then section_5+0x128c
  10c8:  playAnimation 253 7
  10cc:  delay 10
  10d0:  setDialogOwner 253
  10d2:  showTextbox "Hey, hey!\n"
  10ea:  setDialogOwner 5
  10ec:  showTextbox "I have to apologize.\n"
  111a:  playAnimation 253 7
  111e:  delay 15
  1122:  setDialogOwner 253
  1124:  showTextbox "Do that later, you gotta stop\nthe factory's machines now!\n"
  119c:  playAnimation 253 0
  11a0:  setDialogOwner 5
  11a2:  showTextbox "Alright, I will.\n"
  11c8:  setRotation 5 2048
  11cc:  delay 20
  11d0:  playSound 8 5
  11d4:  setDialogOwner 5
  11d6:  showTextbox "The factory's function has\njust stopped.\n"
  122c:  setDialogOwner 253
  122e:  showTextbox "Good, I'll check the sewer.\nLaters, dude.\n"
  1286:  setTrigger 341
  128a:  endSection
  128c:  if !trigger(341) then section_5+0x1318
  1298:  setDialogOwner 5
  129a:  showTextbox "I must apologize.\n"
  12c2:  setDialogOwner 253
  12c4:  showTextbox "We don't got time\nto discuss that now!\n"
  1316:  endSection
  1318:  if !trigger(343) then section_5+0x1468
  1324:  setDialogOwner 5
  1326:  showTextbox "Our computer is perfect.\n"
  135c:  setDialogOwner 253
  135e:  showTextbox "Is the factory really safe?\nWhat can we do now?\n"
  13c2:  playAnimation 253 16
  13c6:  delay 20
  13ca:  playAnimation 253 0
  13ce:  setDialogOwner 253
  13d0:  showTextbox "OK, we gotta do something\nabout the guards. We don't\nhave any other way!\n"
  1466:  endSection
  1468:  setDialogOwner 5
  146a:  showTextbox "How did you get into town?\n"
  14a4:  if trigger(347) then section_5+0x1518
  14b0:  setDialogOwner 5
  14b2:  showTextbox "If you don't have any\nbusiness here, leave now!\n"
  1516:  endSection
  1518:  if trigger(344) OR !trigger(347) OR trigger(343) then section_5+0x1bac
  152c:  setDialogOwner 253
  152e:  showTextbox "We can talk about that later.\nI gotta check out\nthe factory now.\n"
  15b4:  showTextbox "This is a life and death\nsituation. Give me the okay!\n"
  1624:  setDialogOwner 5
  1626:  showTextbox "I don't quite understand\nwhat you're trying to do.\nI can't give you permission.\n"
  16ca:  setDialogOwner 253
  16cc:  showTextbox "There are Digimon about to\nfade away because of the\nwaste water from the factory!\n"
  1774:  setDialogOwner 5
  1776:  showTextbox "From the factory? No way!\nThe waste water cleaning\nsystem is working fine.\n"
  1810:  setDialogOwner 253
  1812:  showTextbox "How can you know it's working\nfine if we don't check?!\n"
  1884:  playAnimation 253 19
  1888:  delay 5
  188c:  setDialogOwner 5
  188e:  showTextbox "Our computer is perfect. In\nemergencies, the Net Keeper\nwill shut down the system.\n"
  1938:  setDialogOwner 253
  193a:  showTextbox "Are you telling me that\nNet Keeper will always\nwork correctly?\n"
  19bc:  playAnimation 253 0
  19c0:  delay 5
  19c4:  setDialogOwner 5
  19c6:  showTextbox "Net Keeper is another\nname for Giromon who is\nan Ultimate Digimon.\n"
  1a50:  showTextbox "His judgement and ability\nare so perfect.\n"
  1aa8:  setDialogOwner 253
  1aaa:  showTextbox "He is a Digimon?! Oh no, we\nare in even more trouble now.\nPlease, give me permission!\n"
  1b5a:  playAnimation 253 19
  1b5e:  delay 5
  1b62:  setDialogOwner 5
  1b64:  showTextbox "Leave! Now!\n"
  1b80:  playAnimation 253 22
  1b84:  delay 10
  1b88:  setDialogOwner 253
  1b8a:  showTextbox "Sigh...Rats!\n"
  1ba8:  setTrigger 343
  1bac:  endSection
