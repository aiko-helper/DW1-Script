; source: ./extract/DIGIMON/SCN/DG.SCN
; MAP151.SCN, section 5

section_5(5):     ; len=8168
  0000:  if !trigger(240) then section_5+0x52
  000c:  speak 5 "It's all cool here.\nGood luck.\n"
  0050:  endSection
  0052:  if !trigger(330) then section_5+0x150
  005e:  speak 5 "I must help, too. I'll go\nback and forth between here\nand the city whenever I can.\n"
  010a:  playSound 8 10
  010e:  speak System "Andromon joins the city!\n"
  0146:  setTrigger 240
  014a:  pstat[1] += 3
  014e:  endSection
  0150:  if !trigger(329) then section_5+0x934
  015c:  speak 5 "Data repair is complete.\nNow, let's read data.\n"
  01c0:  setRotation 5 2048
  01c4:  delay 20
  01c8:  playSound 8 5
  01cc:  speak Player "Please.\n"
  01e2:  playSound 8 6
  01e6:  speak System "One hundred years ago,\nAnalog Humans appeared\non Digimon island.\n"
  026e:  showTextbox "Analog Humans and native\nDigimon fought very hard.\n"
  02d8:  showTextbox "After ten years of battle,\nthe Analog Humans were\ndefeated and disappeared.\n"
  0374:  showTextbox "In the next ten years,\nmysteriously, the island's\narea almost doubled in size.\n"
  0416:  playAnimation Player 16
  041a:  delay 15
  041e:  speak Player "So humans fought Digimon?\n"
  0458:  playAnimation Player 0
  045c:  speak 5 "I'm sorry. That's all the\ndata we could recover.\n"
  04c4:  setRotation 5 0
  04c8:  delay 20
  04cc:  speak Player "Don't worry. This is \nvery important information.\nNow I know so much more.\n"
  0568:  speak 5 "Is that right?\n"
  058c:  playAnimation Player 25
  0590:  delay 15
  0594:  speak Player "These humans are probably the\nones who caused confusion and\ntrouble on the island.\n"
  0640:  playAnimation Player 0
  0644:  speak 5 "Can humans live\none hundred years?\n"
  0690:  speak Player "It seems that for humans,\ntime is slow in this world.\n"
  0702:  showTextbox "I guess that's why I don't\nhave to eat or sleep here.\n"
  0772:  showTextbox "One hundred years is a\nvery long time. Those guys\nmust be very tough.\n"
  0802:  speak 5 "Do you think they are\nhiding somewhere?\n"
  0858:  speak Player "I'll find them\nand do something.\n"
  08a0:  showTextbox "Now I know why I'm here. \nSince I'm human,\nI need to deal with them.\n"
  092e:  setTrigger 330
  0932:  endSection
  0934:  if !trigger(211) OR trigger(328) then section_5+0xfd0
  0944:  speak 5 "We're so sorry. We'll close\nthe factory for a while.\n"
  09b4:  playAnimation Player 19
  09b8:  delay 15
  09bc:  speak Player "Because of the trouble now,\nno one can say what's gonna\nhappen. It's not your fault.\n"
  0a6c:  playAnimation Player 0
  0a70:  speak Player "I think there's somebody\ncontrolling Giromon.\n"
  0ad2:  showTextbox "Computers were destroyed and\nwaste water started to leak.\n"
  0b4a:  showTextbox "That water made Digimons\ninsane. I don't think\nit's a coincidence.\n"
  0bd4:  speak 5 "These computers have some\nkey importance.\n"
  0c2e:  showTextbox "It may be too late,\nbut I think someone was\ntrying to get us.\n"
  0cae:  speak Player "What?!\n"
  0cc2:  speak 5 "I think there was some data\nregarding the island's past\non these computers.\n"
  0d60:  showTextbox "But due to the Giromon's\nriot, the data was destroyed.\n"
  0dd2:  speak Player "You've never seen the data?\n"
  0e10:  speak 5 "No, but we might be able to\nrepair some of it. I'll\ntry to connect the data.\n"
  0eb0:  speak Player "I see, thank you.\nHow long will it take?\n"
  0f08:  speak 5 "It'll be a while. I'll\nreopen the town entrance,\nso come back again.\n"
  0f98:  speak Player "Thanks. I'll be back.\n"
  0fca:  setTrigger 328
  0fce:  endSection
  0fd0:  if !trigger(328) then section_5+0x10b4
  0fdc:  speak Player "Have you finish\nrepairing the data?\n"
  102a:  speak 5 "It'll take a while longer.\nCome back again.\n"
  1088:  speak Player "OK, I'll be back.\n"
  10b2:  endSection
  10b4:  if !trigger(344) OR trigger(211) OR trigger(341) then section_5+0x128c
  10c8:  playAnimation Player 7
  10cc:  delay 10
  10d0:  speak Player "Hey, hey!\n"
  10ea:  speak 5 "I have to apologize.\n"
  111a:  playAnimation Player 7
  111e:  delay 15
  1122:  speak Player "Do that later, you gotta stop\nthe factory's machines now!\n"
  119c:  playAnimation Player 0
  11a0:  speak 5 "Alright, I will.\n"
  11c8:  setRotation 5 2048
  11cc:  delay 20
  11d0:  playSound 8 5
  11d4:  speak 5 "The factory's function has\njust stopped.\n"
  122c:  speak Player "Good, I'll check the sewer.\nLaters, dude.\n"
  1286:  setTrigger 341
  128a:  endSection
  128c:  if !trigger(341) then section_5+0x1318
  1298:  speak 5 "I must apologize.\n"
  12c2:  speak Player "We don't got time\nto discuss that now!\n"
  1316:  endSection
  1318:  if !trigger(343) then section_5+0x1468
  1324:  speak 5 "Our computer is perfect.\n"
  135c:  speak Player "Is the factory really safe?\nWhat can we do now?\n"
  13c2:  playAnimation Player 16
  13c6:  delay 20
  13ca:  playAnimation Player 0
  13ce:  speak Player "OK, we gotta do something\nabout the guards. We don't\nhave any other way!\n"
  1466:  endSection
  1468:  speak 5 "How did you get into town?\n"
  14a4:  if trigger(347) then section_5+0x1518
  14b0:  speak 5 "If you don't have any\nbusiness here, leave now!\n"
  1516:  endSection
  1518:  if trigger(344) OR !trigger(347) OR trigger(343) then section_5+0x1bac
  152c:  speak Player "We can talk about that later.\nI gotta check out\nthe factory now.\n"
  15b4:  showTextbox "This is a life and death\nsituation. Give me the okay!\n"
  1624:  speak 5 "I don't quite understand\nwhat you're trying to do.\nI can't give you permission.\n"
  16ca:  speak Player "There are Digimon about to\nfade away because of the\nwaste water from the factory!\n"
  1774:  speak 5 "From the factory? No way!\nThe waste water cleaning\nsystem is working fine.\n"
  1810:  speak Player "How can you know it's working\nfine if we don't check?!\n"
  1884:  playAnimation Player 19
  1888:  delay 5
  188c:  speak 5 "Our computer is perfect. In\nemergencies, the Net Keeper\nwill shut down the system.\n"
  1938:  speak Player "Are you telling me that\nNet Keeper will always\nwork correctly?\n"
  19bc:  playAnimation Player 0
  19c0:  delay 5
  19c4:  speak 5 "Net Keeper is another\nname for Giromon who is\nan Ultimate Digimon.\n"
  1a50:  showTextbox "His judgement and ability\nare so perfect.\n"
  1aa8:  speak Player "He is a Digimon?! Oh no, we\nare in even more trouble now.\nPlease, give me permission!\n"
  1b5a:  playAnimation Player 19
  1b5e:  delay 5
  1b62:  speak 5 "Leave! Now!\n"
  1b80:  playAnimation Player 22
  1b84:  delay 10
  1b88:  speak Player "Sigh...Rats!\n"
  1ba8:  setTrigger 343
  1bac:  endSection
