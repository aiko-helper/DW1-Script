// DG093.SCN
#include "functions.dgs"
#pragma script index=93 start=0x41800 end=0x42000 headerU16=0x14 sentinelOff=0x19
#include "entities.dgs"

section onEnter(254) {
  if (trigger(322)) {
    setObjectVisibility(7, 1);
  }
  callSubroutine(49);
  if (trigger(323)) {
    callSubroutine(50);
  }
  return;
}

section(51) {
  if (trigger(323)) {
    warp(to: Map.ICSA02, spawn: 0, trigger: 255);
    return;
  }
  if (!trigger(324)) {
    rotate(entity: Entity.Player, to: 2048);
    delay(5);
    anim(Entity.Player, Animation(23), wait: 5);
    speak(Entity.Player, "Wow, it looks alive!\n");
    speak(Entity.Player, "Actually, it starts to move\nwhen we move. Hold on!\n");
    playAnimation(Entity.Player, Animation(0));
    setTrigger(Trigger(324));
    return;
  }
  return;
}

section(52) {
  if (trigger(322) && trigger(220)) {
    goto section_5;
  }
  if (!trigger(323) && trigger(324)) {
    move(entity: Entity.Partner, to: (50, 1050), sprint: 0);
    waitForEntity(Entity.Partner);
    delay(10);
    look(entity: Entity.Player, at: Entity.Partner);
    speak(Entity.Player, "What is it, <ORANGE><DIGIMON><WHITE>?\nDid you find anything?\n");
    callSubroutine(50);
    delay(20);
    speak(Entity.Player, "Wow, that's great\n<ORANGE><DIGIMON><WHITE>!\n");
    setTrigger(Trigger(323));
    return;
  }
  return;
}

section(5) {
  if (trigger(220)) {
    return;
  }
  rotate(entity: Entity.Player, to: 2048);
  delay(20);
  rotate(entity: Entity.Player, to: 1536);
  delay(10);
  rotate(entity: Entity.Player, to: 2560);
  delay(20);
  speak(Entity.Player, "Oh? About that statue...\n");
  rotate(entity: Entity.Player, to: 2048);
  anim(Entity.Player, Animation(23), wait: 20);
  panTo(x: -831, y: 2975, slowdown: 20);
  speak(Entity.Player, "Ah!\n");
  loadAndSetDigimon(Digimon.NPCAngemon, Entity(0), 0);
  playSound(8, 10);
  anim(Entity(5), Animation(28), wait: 60);
  playAnimation(Entity(5), Animation(0));
  speak(Entity(5), "Phew, well\n");
  speak(Entity.Player, "You came back to life.\nAlright!\n");
  speak(Entity(5), "I'm Angemon, an angel to\nprotect you. I've awakened\nto fulfill my duty.\n");
  speak(Entity.Player, "What's he talking about...?\n");
  speak(Entity(5), "I know the truth of heaven.\n");
  showTextbox("I offer my soul to follow\nearthly instructions.\n");
  speak(Entity.Player, "What's he talking about...?\nAre you coming to the city?\n");
  speak(Entity(5), "Thine mission is mine duty.\nI go.\n");
  speak(Entity.Player, "I'm sorry, but can you\nspeak in words I understand?\n");
  speak(Entity(5), "I'll go to the city, so\nyou must keep trying.\n");
  speak(Entity.Player, "I see. Thanks!\n");
  goto L1;

L1:
  approach(who: Entity(5), x: 47, y: -2650, tries: 3, wait: 20);
  playSound(8, 11);
  speak(Entity.System, "Angemon joins the city!\n");
  setTrigger(Trigger(220));
  addPStat(PStat(1), 2);
  followEntity(Entity.Player, speed: 10);
  return;
  garbage { 14 00 fe 00 14 00 33 00 36 00 34 00 0c 01 05 00 da 01 ff ff 19 00 00 00 42 01 18 00 24 00 19 00 57 00 07 01 64 31 19 00 00 00 43 01 18 00 34 00 19 00 64 32 fe 00 19 00 00 00 43 01 18 00 48 00 19 00 4b 62 00 ff fe 00 19 00 01 00 44 01 18 00 0a 01 19 00 4d fd 00 08 67 00 05 00 56 00 fd 17 67 00 05 00 1b fd 1a 00 82 76 82 8f 82 97 81 43 81 40 82 89 82 94 81 40 82 8c 82 8f 82 8f 82 8b 82 93 81 40 82 81 82 8c 82 89 82 96 82 85 81 49 0d 00 00 00 1b fd 1a 00 82 60 82 83 82 94 82 95 82 81 82 8c 82 8c 82 99 81 43 81 40 82 89 82 94 81 40 82 93 82 94 82 81 82 92 82 94 82 93 81 40 82 94 82 8f 81 40 82 8d 82 8f 82 96 82 85 0d 00 82 97 82 88 82 85 82 8e 81 40 82 97 82 85 81 40 82 8d 82 8f 82 96 82 85 81 42 81 40 82 67 82 8f 82 8c 82 84 81 40 82 8f 82 8e 81 49 0d 00 00 00 56 00 fd 00 1c 00 44 01 fe 00 fe 00 19 00 00 00 42 01 80 00 dc 00 18 00 20 01 19 00 16 00 da 01 19 00 01 00 43 01 80 00 44 01 18 00 d8 01 19 00 4e fc 32 00 1a 04 00 00 4a fc 67 00 0a 00 4c 00 fd fc 1b fd 1a 00 82 76 82 88 82 81 82 94 81 40 82 89 82 93 81 40 82 89 82 94 81 43 81 40 01 0a 06 00 01 01 81 48 0d 00 82 63 82 89 82 84 81 40 82 99 82 8f 82 95 81 40 82 86 82 89 82 8e 82 84 81 40 82 81 }
}
