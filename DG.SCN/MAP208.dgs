// MAP208.SCN
#include "functions.dgs"
#pragma script index=208 start=0x9b800 end=0x9c000 headerU16=0x10 sentinelOff=0x24
#include "entities.dgs"

section onEnter(254) {
  roll(pstat: PStat.RollScratch, max: 99);
  if (pstat[110] <= 4) {
    spawnItem(Item.Digimushroom, x: 39, y: 47);
    spawnItem(Item.Digimushroom, x: 39, y: 45);
    spawnItem(Item.Digimushroom, x: 39, y: 49);
  }
  spawnItemChance(max: 99, chance: 14, item: Item.Digimushroom, x: 44, y: 66);
  spawnItemChance(max: 99, chance: 3, item: Item.Happymushroom, x: 59, y: 42);
  spawnChest(Item.MediumRecovery, 938, 1239, 1024, 696);
  spawnChest(Item.MediumMP, 985, 856, 1024, 697);
  spawnChest(Item.Various, 1024, -1604, 1024, 698);
  if (trigger(152)) {
    setObjectsVisibleRange(6, 9, 0);
  }
  if (trigger(153)) {
    setObjectsVisibleRange(10, 18, 0);
  }
  return;
}

section(52) {
  if (!trigger(154) && trigger(152) && !trigger(153)) {
    goto section_51.L1;
  }
  if (trigger(153) && !trigger(228)) {
    goto section_51.L2;
  } else {
    goto section_51.L3;
  }
  return;
}

section(51) {
  {
    if (!trigger(118)) {
      break;
    }
    if (!trigger(154) && trigger(152) && !trigger(153)) {
      goto L1;
    }
    if (trigger(153) && !trigger(228)) {
      goto L2;
      break;
    }
    goto L3;
  }
  speak(Entity.System, "地面に不思議な模様がえがかれている…<NEWLINE>");
  speak(Entity.Player, "「ミステリー・サークルというやつかな?<NEWLINE> まだそんなに古いものじゃないな。」<NEWLINE>");
  setTrigger(Trigger(118));
  return;

L1:
  move(entity: Entity.Player, to: (350, -50), sprint: 0, withCamera: true);
  waitForEntity(Entity.Player);
  anim(Entity.Player, Animation(24), wait: 20);
  speak(Entity.Player, "「前に見た時より増えてる!<NEWLINE> これって謎の飛行物体ってやつと<NEWLINE> 関係あるのかな…」<NEWLINE>");
  setTrigger(Trigger(154));
  return;

L2:
  {
    move(entity: Entity.Player, to: (350, 50), sprint: 1, withCamera: true);
    waitForEntity(Entity.Player);
    anim(Entity.Player, Animation(24), wait: 20);
    speak(Entity.Player, "「うおお!?」<NEWLINE>");
    move(entity: Entity.Player, to: (-550, 50), sprint: 1, withCamera: true);
    waitForEntity(Entity.Player);
    speak(Entity.Player, "「増えてる、めちゃ増えてるよ!」<NEWLINE>");
    anim(Entity.Player, Animation(16), wait: 20);
    showTextbox("「こりゃいよいよ…」<NEWLINE>");
    playSound(8, 5);
    speak(Entity.Player, "「ん?」<NEWLINE>");
    setDigimon(Digimon.NPCVademon, Entity(0), 0);
    look(entity: Entity.Player, at: Entity(5));
    move(entity: Entity.Partner, to: (-750, -50), sprint: 1);
    panTo(x: -183, y: 723, slowdown: 20);
    waitForEntity(Entity.Partner);
    move(entity: Entity(5), to: (225, 1066), sprint: 1);
    playSound(8, 5);
    waitForEntity(Entity(5));
    move(entity: Entity(5), to: (-275, 1066), sprint: 0);
    playSound(8, 5);
    waitForEntity(Entity(5));
    move(entity: Entity(5), to: (-63, 453), sprint: 0);
    playSound(8, 5);
    waitForEntity(Entity(5));
    move(entity: Entity(5), to: (-126, 409), sprint: 0);
    look(entity: Entity.Player, at: Entity(5));
    delay(20);
    speak(Entity.Player, "「う…宇宙人!?」<NEWLINE>");
    speak(Entity(5), "「………」<NEWLINE>");
    speak(Entity.Player, "「デジモン…なのか…?」<NEWLINE>");
    speak(Entity(5), "「………」<NEWLINE>");
    speak(Entity.Player, "「あのー…」<NEWLINE>");
    speak(Entity(5), "「………」<NEWLINE>");
    sfx(8, 6, wait: 10);
    anim(Entity(5), Animation(28), wait: 10);
    anim(Entity.Player, Animation(15), wait: 10);
    speak(Entity.Player, "「わっ、ちがう、俺達は敵じゃないっ!」<NEWLINE>");
    delay(40);
    playAnimation(Entity(5), Animation(0));
    speak(Entity.Player, "「(分かってもらえたのか?よーし…)」<NEWLINE>");
    anim(Entity.Player, Animation(19), wait: 20);
    speak(Entity.System, "<LIGHTBLUE><PLAYER><WHITE>は必死に説得した!!<NEWLINE>");
    speak(Entity(5), "「………」<NEWLINE>");
    speak(Entity.Player, "「(だめか…?)」<NEWLINE>");
    anim(Entity(5), Animation(22), wait: 15);
    anim(Entity(5), Animation(22), wait: 15);
    playAnimation(Entity(5), Animation(0));
    speak(Entity(5), "「イーヨ。」<NEWLINE>");
    fadeOutHUD();
    break;
  }
  loop {
    move(entity: Entity(5), to: (155, -1177), sprint: 1);
    if (pstat[101] >= 3) break;
    addPStat(PStat.LoopIterator, 1);
    sfx(8, 5, wait: 20);
    lookPairAt(Entity(5));
  }
  waitForEntity(Entity(5));
  unloadEntity(Entity(5));
  setPStat(PStat.LoopIterator, 0);
  playSound(8, 8);
  speak(Entity.System, "ベーダモンが街に参加した!<NEWLINE>");
  speak(Entity.Player, "「あ…あいつ……」<NEWLINE>");
  showTextbox("「しゃべれるんじゃん!!」<NEWLINE>");
  setTrigger(Trigger(228));
  addPStat(PStat(1), 3);
  followEntity(Entity.Player, speed: 10);
  return;

L3:
  return;
  garbage { 10 00 fe 00 10 00 34 00 d0 00 33 00 06 01 ff ff 24 00 6e 63 19 00 0b 00 6e 04 18 00 32 00 19 00 74 2c 27 00 2f 00 74 2c 27 00 2d 00 74 2c 27 00 31 00 24 00 6e 63 19 00 0b 00 6e 0e 18 00 48 00 19 00 74 2c 2c 00 42 00 24 00 6e 63 19 00 0b 00 6e 03 18 00 5e 00 19 00 74 45 3b 00 2a 00 75 01 aa 03 00 00 d7 04 00 04 b8 02 75 05 d9 03 00 00 58 03 00 04 b9 02 75 08 00 04 00 00 bc f9 00 04 ba 02 19 00 00 00 98 00 18 00 9e 00 19 00 57 00 06 00 57 00 07 00 57 00 08 00 57 00 09 00 19 00 00 00 99 00 18 00 ce 00 19 00 57 00 0a 00 57 00 0b 00 57 00 0c 00 57 00 0d 00 57 00 0e 00 57 00 0f 00 57 00 10 00 57 00 11 00 57 00 12 00 fe 00 19 00 01 00 9a 00 80 00 98 00 81 00 99 00 18 00 e8 00 19 00 16 00 d0 01 19 00 00 00 99 00 81 00 e4 00 18 00 00 01 19 00 16 00 42 02 16 00 04 01 16 00 4e 05 fe 00 19 00 01 00 76 00 18 00 16 01 19 00 16 00 4a 01 19 00 01 00 9a 00 80 00 98 00 81 00 99 00 18 00 2e 01 19 00 16 00 d0 01 19 00 00 00 99 00 81 00 e4 00 18 00 46 01 19 00 16 00 42 02 16 00 4a 01 16 00 4e 05 1b ff 1a 00 92 6e 96 ca 82 c9 95 73 8e 76 8b 63 82 c8 96 cd 97 6c 82 aa 82 a6 82 aa 82 a9 82 ea 82 c4 82 a2 82 e9 81 63 0d 00 00 00 1b fd 1a 00 81 75 83 7e 83 58 83 65 83 8a 81 5b 81 45 83 54 81 5b 83 4e 83 8b 82 c6 82 a2 82 a4 82 e2 82 c2 82 a9 82 c8 81 48 0d 00 81 40 82 dc 82 be 82 bb 82 f1 82 c8 82 c9 8c c3 82 a2 82 e0 82 cc 82 b6 82 e1 82 c8 82 a2 82 c8 81 42 81 76 0d 00 00 00 1c 00 76 00 fe 00 52 fd 5e 01 ce ff 00 00 4a fd 56 00 fd 18 67 00 14 00 1b fd 1a 00 81 75 91 4f 82 c9 8c a9 82 bd 8e 9e 82 e6 82 e8 91 9d 82 a6 82 c4 82 e9 81 49 0d 00 81 40 82 b1 82 ea 82 c1 82 c4 93 e4 82 cc 94 f2 8d 73 95 a8 91 cc 82 c1 82 c4 82 e2 82 c2 82 c6 0d 00 81 40 8a d6 8c 57 82 a0 82 e9 82 cc 82 a9 82 c8 81 63 81 76 0d 00 00 00 1c 00 9a 00 fe 00 52 fd 5e 01 32 00 01 00 4a fd 56 00 fd 18 67 00 14 00 1b fd 1a 00 81 75 82 a4 82 a8 82 a8 81 49 81 48 81 76 0d 00 00 00 52 fd da fd 32 00 01 00 4a fd 1b fd 1a 00 81 75 91 9d 82 a6 82 c4 82 e9 81 41 82 df 82 bf 82 e1 91 9d 82 a6 82 c4 82 e9 82 e6 81 49 81 76 0d 00 00 00 56 00 fd 10 67 00 14 00 1a 00 81 75 82 b1 82 e8 82 e1 }
}
