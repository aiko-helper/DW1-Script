// MAP159.SCN
#pragma script index=159 start=0x70000 end=0x72000 headerU16=0x24 sentinelOff=0x19

function playAnimationThenDelayThenSpeak(a, b, c, d) {
    playAnimation(a, b);
    delay(c);
    speak(Entity.Player, d);
}


section onEnter(254) {
    if (trigger(320)) goto L1;
    setObjectVisibility(10, 0);
    goto L2;

L1:
    setObjectVisibility(10, 1);

L2:
    if (trigger(362)) goto L3;
    goto section_6;

L3:
    return;
}

section(5) {
    goto section_81;

L1:
    return;
}

section(81) {
    moveCamera(to: (-1143, 1558), slowdown: 10);
    look(entity: Entity.Player, at: 5);
    look(entity: Entity.Partner, at: 5);
    look(entity: 5, at: Entity.Player);
    delay(5);
    storeDigimonType(103);
    if (!trigger(363) || pstat[103] != 39) goto L1;
    playSound(8, 20);
    speak(5, "You again! Get out of here!\n");
    playAnimationThenDelayThenSpeak(Entity.Player, 16, 15, "Uhh...\n");
    playAnimation(Entity.Player, 0);
    speak(5, "You... you're a pest!\nIs that okay now?!\n");
    goto L6;
    moveCamera(to: Entity.Player, speed: 10);
    waitForEntity(200);
    return;

L1:
    if (!trigger(363)) goto L2;
    playSound(8, 20);
    speak(5, "You again! Get out of here\nright now!\n");
    moveCamera(to: Entity.Player, speed: 10);
    waitForEntity(200);
    return;

L2:
    if (pstat[103] != 39) goto L3;
    speak(5, "Good to see you, my friends.\nIf you want to live here,\nI give you permission.\n");
    setTrigger(49);
    setDialogOwner(Entity.Player);
    setSelection(L4, L5);
    showTextbox("We want to live here\nWe want to return\n");

L3:
    goto L8;

L4:
    unsetTrigger(49);
    playSound(8, 20);
    speak(5, "Hmmm, that's good. What?\nBut you are analog,\nso you can't live here.\n");
    speak(Entity.Player, "We have to be together!\n");
    speak(5, "Then, get out of here\nwith him!\n");
    moveCamera(to: Entity.Player, speed: 10);
    waitForEntity(200);
    return;

L5:
    unsetTrigger(49);
    speak(5, "What? What are you saying?\n");
    playAnimationThenDelayThenSpeak(Entity.Player, 16, 15, "He's not originally Sukamon.\nKing, please return him\nto his original form!\n");
    playAnimation(Entity.Player, 0);
    speak(5, "Isn't it great that\nhe became Sukamon?\n");
    speak(Entity.Player, "No, it's not very good\nright now. Please.\n");
    speak(5, "Only way to become Sukamon\nis to try hard.\n");
    speak(Entity.Player, "He became a Sukamon\nnaturally and\nthat's the problem.\n");
    playSound(8, 20);
    speak(5, "You guys are unbelievable!\n");

L6:
    if (pstat[200] != 39) goto L7;
    storeDigimonType(200);
    copyPStat(5, 254);

L7:
    fadeOutHUD();
    playAnimation(5, 30);
    playSound(8, 19);
    delay(60);
    callDigimonSubroutine(2);
    waitForEntity(201);
    playAnimationThenDelayThenSpeak(5, 0, 5, "Wow! King, thank you!\n");
    playSound(8, 20);
    speak(5, "Get out of here right now!\n");
    setTrigger(363);
    moveCamera(to: Entity.Player, speed: 10);
    waitForEntity(200);
    return;

L8:
    playSound(8, 20);
    speak(5, "Did you come here for\nsomething?\n");
    speak(Entity.Player, "Well...\n");
    speak(5, "If you have a request,\nforget it. Because\nI am King of Sukamon!\n");
    speak(Entity.Player, "I guess I won't be able\nto invite him to the city.\n");
    moveCamera(to: Entity.Player, speed: 10);
    waitForEntity(200);
    return;
}

section(6) {
    if (!trigger(362)) goto L2;
    speak(6, "I am collecting\nDigimon cards myself.\n");
    showTextbox("I really want a King of\nSukamon card. Will you trade\nfor my Etemon card?\n");
    if (card[21] < 1) goto L1;
    setDialogOwner(Entity.Player);
    choice { "Trade" -> L6, "Don't trade" -> L8 }
    return;

L1:
    speak(Entity.Player, "Sorry, but I don't have it.\n");
    return;

L2:
    playAnimationThenDelayThenSpeak(Entity.Player, 24, 15, "Wow it stinks! Is this\nTrash Pile?\n");
    showTextbox("I didn't know there's one\nin Digimon World.\n");
    playAnimation(Entity.Player, 0);
    storeDigimonType(103);
    if (trigger(362) || pstat[103] != 39) goto L3;
    move(entity: 6, to: (192, -2979), sprint: 0);
    waitForEntity(6);
    speak(6, "I'm glad you came.\nWe welcome new friends.\n");
    speak(Entity.Player, "Is this a community for\nthe Sukamon Tribe?\n");
    speak(6, "Exactly. This is a paradise\nfor the Sukamon Tribe,\nit's called Dust Kingdom.\n");
    showTextbox("King of Sukamon is here, too.\n");
    speak(Entity.Player, "King of Sukamon...?\n");
    speak(6, "King of Sukamon is amazing!\nIf you don't listen to him,\nyou'll be digivolved!\n");
    speak(Entity.Player, "Do you mean we turn into\nsomething besides Sukamon?\n");
    showTextbox("That means we return\nto our original form?!\n");
    speak(6, "Yeah, it's scary. Creepy.\n");
    speak(Entity.Player, "I learned something useful...\n");
    move(entity: 6, to: (189, -1273), sprint: 0);
    waitForEntity(6);
    setTrigger(362);
    return;

L3:
    if (trigger(362) || !trigger(550)) goto L4;
    move(entity: 6, to: (192, -2979), sprint: 0);
    waitForEntity(6);
    speak(Entity.Player, "Oh, Sukamon?!\n");
    speak(6, "Huh? Do you know about me?\n");
    speak(Entity.Player, "Well, kind of.\nDo we need to take Sukamon\nto the city as well?\n");
    goto L5;

L4:
    move(entity: 6, to: (192, -2979), sprint: 0);
    waitForEntity(6);
    speak(6, "Wow, this is interesting!\nI've never seen anything\nlike this!\n");
    speak(Entity.Player, "Oh my goodness! The poop\nare moving and talking!\n");
    speak(6, "Are you talking about me?\nI'm Sukamon...\nI'm a Mutant Digimon.\n");
    speak(Entity.Player, "You are not poop?\n");
    speak(6, "In a way, you are right,\ncuz we are made from\nDigital Waste.\n");
    speak(Entity.Player, "Should we ask him to come\nto the city, too? We\nshouldn't be prejudiced.\n");

L5:
    speak(6, "Are you planning to\nlive here?\n");
    speak(Entity.Player, "What? I never thought\nabout it.\n");
    speak(6, "Well, this is a paradise\nonly for the Sukamon Tribe.\nOthers can't live here.\n");
    speak(Entity.Player, "Then you can't live\nin other places?\n");
    speak(6, "Of course not!\nWhat do you think?\n");
    speak(Entity.Player, "I see. That's\nwhat I thought.\n");
    speak(6, "Well, although you\ncan't live here,\nyou can look around.\n");
    speak(Entity.Player, "Oh, just to look.Okay.\n");
    speak(6, "Oh, by the way, don't\never make the King mad.\n");
    showTextbox("You'll be turned into\nsomething miserable by the\nKing's Digivolve technique.\n");
    move(entity: 6, to: (189, -1273), sprint: 0);
    waitForEntity(6);
    setTrigger(362);
    return;

L6:
    if (card[14] < 9) goto L7;
    speak(6, "Hey, you have too many\nEtemon cards!\nDon't do it.\n");
    return;

L7:
    speak(6, "Oh, thank you!\n");
    takeCard(21);
    giveCard(14);
    return;

L8:
    return;
}

section(7) {
    if (trigger(239)) goto L1;
    setTrigger(239);
    addPStat(1, 1);
    speak(7, "Hey guys, are you from ...\nwhat-cha-ma-call-it...city?\n");
    showTextbox("This is just between\nyou and me. I'm interested\na little bit.\n");
    showTextbox("I'll visit you guys\nthere some day.\n");
    return;

L1:
    speak(7, "Hey, guys, do you know\nthe Sukamon Tribe's\nspecial Technique?\n");
    showTextbox("We absorb poop on the ground\ninto our bodies and\nturn them into energy!\n");
    return;
}

section(8) {
    speak(8, "Huh? This is Dust Kingdom.\nI know this is just\na trash pile for you.\n");
    showTextbox("But we may find something\nuseful. I saw a long rod-like\nthing over there.\n");
    return;
}

section(51) {
    if (trigger(45)) goto L1;
    speak(Entity.Player, "Wow, it's an\n<LIGHTBLUE>Old Fishrod<WHITE>!\n");
    delay(10);
    playAnimation(Entity.Player, 12);
    delay(10);
    playSound(0, 7);
    setObjectVisibility(10, 1);
    delay(10);
    setTrigger(45);
    setTrigger(320);

L1:
    return;
}

section(82) {
    rotate(entity: Entity.Player, to: 2640);
    setTextboxOrigin(1484, 0, -241);
    callSubroutine(39);
    speak(200, " <GREEN>Training: Hide In Trash <WHITE>\n");
    choice { "Begin" -> L1, "Explain" -> L2, "Quit" -> L3 }
    return;

L1:
    setDialogOwner(200);
    choice { "Normal" -> L4, "Bonus Try" -> L5, "Quit" -> L3 }
    return;

L2:
    speak(200, "Mental training by putting\nyourself in dirty trash.\nMax MP is greatly boosted.\n");
    choice { "Explain again" -> L2, "Begin" -> L1, "Quit" -> L3 }
    return;

L3:
    return;

L4:
    fadeOutHUD();
    setPStat(254, 4);
    setPStat(246, 0);
    callDigimonSubroutine(214);
    callSubroutine(7);
    return;

L5:
    setTexboxMode(1, 0);
    speak(Entity.System, " <YELLOW>Slot Game <WHITE>\nUse <LIGHTBLUE><X> <WHITE>\nto match three pictures.\n");
    setPStat(254, 4);
    setPStat(246, 1);
    callDigimonSubroutine(214);
    callSubroutine(7);
    setTexboxMode(0, 0);
    return;
    garbage { 24 00 fe 00 24 00 05 00 4e 00 51 00 54 00 06 00 82 08 07 00 a6 16 08 00 14 19 33 00 3e 1a 52 00 aa 1a ff ff 19 00 01 00 40 01 18 00 38 00 19 00 57 00 0a 00 16 00 3c 00 57 00 0a 01 19 00 01 00 6a 01 18 00 4c 00 19 00 16 00 82 08 fe 00 16 00 54 00 fe 00 4f 0a 89 fb 16 06 4c 00 fd 05 4c 00 fc 05 4c 00 05 fd 67 00 05 00 22 67 19 00 00 00 6b 01 88 00 67 27 18 00 42 01 19 00 5a 00 08 14 1b 05 1a 00 82 78 82 8f 82 95 81 40 82 81 82 87 82 81 82 89 82 8e 81 49 81 40 82 66 82 85 82 94 81 40 82 8f 82 95 82 94 81 40 82 8f 82 86 81 40 82 88 82 85 82 92 82 85 81 49 0d 00 00 00 56 00 fd 10 67 00 0f 00 1b fd 1a 00 82 74 82 88 82 88 81 42 81 42 81 42 0d 00 00 00 56 00 fd 00 1b 05 1a 00 82 78 82 8f 82 95 81 42 81 42 81 42 81 40 82 99 82 8f 82 95 81 75 82 92 82 85 81 40 82 81 81 40 82 90 82 85 82 93 82 94 81 49 0d 00 82 68 82 93 81 40 82 94 82 88 82 81 82 94 81 40 82 8f 82 8b 82 81 82 99 81 40 82 8e 82 8f 82 97 81 48 81 49 0d 00 00 00 16 00 7c 06 50 00 fd 0a 4a c8 fe 00 19 00 00 00 6b 01 18 00 ac 01 19 00 5a 00 08 14 1b 05 1a 00 82 78 82 8f 82 95 81 40 82 81 82 87 82 81 82 89 82 8e 81 49 81 40 82 66 82 85 82 94 81 40 82 8f 82 95 82 94 81 40 82 8f 82 86 81 40 82 88 82 85 82 92 82 85 0d 00 82 92 82 89 82 87 82 88 82 94 81 40 82 8e 82 8f 82 97 81 49 0d 00 00 00 50 00 fd 0a 4a c8 fe 00 19 00 08 00 67 27 18 00 b8 02 19 00 1b 05 1a 00 82 66 82 8f 82 8f 82 84 81 40 82 94 82 8f 81 40 82 93 82 85 82 85 81 40 82 99 82 8f 82 95 81 43 81 40 82 8d 82 99 81 40 82 86 82 92 82 89 82 85 82 8e 82 84 82 93 81 42 0d 00 82 68 82 86 81 40 82 99 82 8f 82 95 81 40 82 97 82 81 82 8e 82 94 81 40 82 94 82 8f 81 40 82 8c 82 89 82 96 82 85 81 40 82 88 82 85 82 92 82 85 81 43 0d 00 82 68 81 40 82 87 82 89 82 96 82 85 81 40 82 99 82 8f 82 95 81 40 82 90 82 85 82 92 82 8d 82 89 82 93 82 93 82 89 82 8f 82 8e 81 42 0d 00 00 00 1c 00 31 00 1b fd 10 02 bc 02 d8 03 1a 00 82 76 82 85 81 40 82 97 82 81 82 8e 82 94 81 40 82 94 82 8f 81 40 82 8c 82 89 82 96 82 85 81 40 82 88 82 85 82 92 82 85 0d 00 82 76 82 85 81 40 82 97 82 81 82 8e 82 94 81 40 82 94 82 8f 81 40 82 92 82 85 82 94 82 95 82 92 82 8e 0d 00 00 00 16 00 26 07 1d 00 31 00 5a 00 08 14 1b 05 1a 00 82 67 82 8d 82 8d 82 8d 81 43 81 40 82 94 82 88 82 81 82 94 81 75 82 93 81 40 82 87 82 8f 82 8f 82 84 81 42 81 40 82 76 82 88 82 81 82 94 81 48 0d 00 82 61 82 95 82 94 81 40 82 99 82 8f 82 95 81 40 82 81 82 92 82 85 81 40 82 81 82 8e 82 81 82 8c 82 8f 82 87 81 43 }
}
