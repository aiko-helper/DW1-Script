// DG187.SCN
#include "functions.dgs"
#pragma script index=187 start=0x8e000 end=0x8e800 headerU16=0xc sentinelOff=0xfe
#include "entities.dgs"

section onEnter(254) {
  return;
}

section(5) {
  {
    speak(Entity(5), "「ギギッ、待ってたぞ!」<NEWLINE>");
    speak(Entity.Player, "「む、正気にもどってるのか?」<NEWLINE>");
    playSound(8, 11);
    speak(Entity(5), "「ギャハハ。ちょっとファンキーになってた<NEWLINE> みたいだな、オレ。」<NEWLINE>");
    speak(Entity.Player, "「いや、そんな気楽なもんじゃ…」<NEWLINE>");
    speak(Entity(5), "「工場は閉鎖しちまったし、オレもヒマよ。<NEWLINE> オマエを手伝わせてもらうぜ、ギヒヒ!」<NEWLINE>");
    speak(Entity(5), "「(正気でも、あまりかわんないなー。)」<NEWLINE>");
    playSound(8, 11);
    speak(Entity(5), "「お先に失礼するぜ、ギギーーー!」<NEWLINE>");
    break;
  }
  approach(who: Entity(5), x: 3050, y: -150, tries: 3, wait: 20);
  playSound(8, 10);
  speak(Entity.System, "ギロモンが街に参加した!!!<NEWLINE>");
  followEntity(Entity.Player, speed: 10);
  setTrigger(Trigger(241));
  addPStat(PStat(1), 3);
  return;
