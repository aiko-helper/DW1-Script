// DG094.SCN
#include "functions.dgs"
#pragma script index=94 start=0x3d800 end=0x3e000 headerU16=0x2c sentinelOff=0xe75
#include "entities.dgs"

section onEnter(254) {
  spawnChest(Item.Medicine, 79, 725, 0, 665);
  return;
}

section(51) {
  move(entity: Entity.Player, to: (9, -3988), sprint: 0);
  warp(to: Map.ICSA04, spawn: 1, trigger: 255);
  return;
}

section(52) {
  warp(to: Map.ICSA02, spawn: 3, trigger: 255);
  return;
}

section(53) {
  warp(to: Map.ICSA03, spawn: 1, trigger: 255);
  return;
}

section(54) {
  warp(to: Map.ICSA01, spawn: 2, trigger: 255);
  return;
}

section(55) {
  warp(to: Map.ICSA06, spawn: 0, trigger: 255);
  return;
}

section(5) {
  speak(Entity(5), "「君は誰だ?」<NEWLINE>");
  finishEncounter(Trigger(304));
}

section(6) {
  speak(Entity(6), "「すべてがムダだよ。」<NEWLINE>");
  finishEncounter(Trigger(304));
}

section(7) {
