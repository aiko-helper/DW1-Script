// DG050.SCN
#include "functions.dgs"
#pragma script index=50 start=0x24800 end=0x25000 headerU16=0x18 sentinelOff=0xfe
#include "entities.dgs"

section onEnter(254) {
  return;
}

section(82) {
  {
    if (item[Item.MansionKey] >= 1 && !trigger(125)) {
      rotate(entity: Entity.Player, to: 3072);
      playSound(8, 3);
      speak(Entity.System, "<LIGHTBLUE>館のカギ<WHITE>を使った!<NEWLINE>");
      setTrigger(Trigger(125));
      break;
    }
    if (item[Item.MansionKey] >= 1 || trigger(125)) break;
    rotate(entity: Entity.Player, to: 3072);
    sfx(8, 2, wait: 5);
    playSound(8, 2);
    speak(Entity.System, "開かない…カギがかかっている。<NEWLINE>");
    return;
  }
  rotate3DObject(1, 1);
  sfx(8, 1, wait: 10);
  move(entity: Entity.Player, to: (2000, 2500), sprint: 0);
  warp(to: Map.YAKA24, spawn: 0, trigger: 255);
  return;
}

section(83) {
  if (!trigger(117)) {
    rotate(entity: Entity.Player, to: 1024);
    sfx(8, 2, wait: 5);
    playSound(8, 2);
    speak(Entity.System, "開かない…カギがかかっている。<NEWLINE>しかもカギ穴が無い!<NEWLINE>");
    return;
  }
  move(entity: Entity.Player, to: (-2000, 554), sprint: 0);
  rotate3DObject(2, 1);
  sfx(8, 1, wait: 10);
  warp(to: Map.YAKA23, spawn: 0, trigger: 255);
  return;
}

section(81, 0x0132) {
  {
    if (item[Item.MansionKey] >= 1 && !trigger(127)) {
      rotate(entity: Entity.Player, to: 3072);
      playSound(8, 3);
      speak(Entity.System, "<LIGHTBLUE>館のカギ<WHITE>を使った!<NEWLINE>");
      setTrigger(Trigger(127));
      break;
    }
    if (item[Item.MansionKey] >= 1 || trigger(127)) break;
    rotate(entity: Entity.Player, to: 3072);
    sfx(8, 2, wait: 5);
    playSound(8, 2);
    speak(Entity.System, "開かない…カギがかかっている。<NEWLINE>");
    return;
  }
  rotate3DObject(0, 1);
  sfx(8, 1, wait: 10);
  move(entity: Entity.Player, to: (2000, 550), sprint: 0);
  warp(to: Map.YAKA25_2, spawn: 0, trigger: 255);
  return;
}

