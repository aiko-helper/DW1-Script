// DG050.SCN
#include "functions.dgs"
#pragma script index=50 start=0x26000 end=0x26800 headerU16=0x14 sentinelOff=0x1c75
#include "entities.dgs"

section onEnter(254) {
  spawnChest(Item.MPChip, 835, 2461, 0, 650);
  spawnChest(Item.Restore, -2455, -1042, 3072, 651);
  spawnChest(Item.Autopilot, 44, -2504, 3072, 652);
  if (trigger(132)) {
    setObjectVisibility(15, 0);
  }
  return;
}

section(5) {
  speak(5, "I must protect this place.\n");
  finishEncounter(308);
}

section(6) {
  speak(6, "What was the order?\n");
  finishEncounter(308);
}

section(51) {
  if (!trigger(132)) {
    speak(Entity.Player, "What?\n");
    playSound(8, 4);
    setObjectVisibility(15, 0);
    delay(10);
    speak(Entity.Player, "Wow!\n");
    playSound(8, 5);
    warp(to: Map.YAKA23, spawn: 2, trigger: 52);
    return;
  } else {
    speak(Entity.Player, "I'm coming!\n");
    playSound(8, 4);
    playSound(8, 5);
    warp(to: Map.YAKA23, spawn: 2, trigger: 52);
    return;
  }
  return;
  garbage { 14 00 fe 00 14 00 05 00 4a 00 06 00 94 00 33 00 d0 00 ff ff 75 1c 43 03 00 00 9d 09 00 00 8a 02 75 0b 69 f6 00 00 ee fb 00 0c 8b 02 75 16 2c 00 00 00 38 f6 00 0c 8c 02 19 00 00 00 84 00 18 00 48 00 19 00 57 00 0f 00 fe 00 1b 05 1a 00 82 68 81 40 82 8d 82 95 82 93 82 94 81 40 82 90 82 92 82 8f 82 94 82 85 82 83 82 94 81 40 82 94 82 88 82 89 82 93 81 40 82 90 82 8c 82 81 82 83 82 85 81 42 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 34 01 fe 00 1b 06 1a 00 82 76 82 88 82 81 82 94 81 40 82 97 82 81 82 93 81 40 82 94 82 88 82 85 81 40 82 8f 82 92 82 84 82 85 82 92 81 48 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 34 01 fe 00 19 00 01 00 84 00 18 00 18 01 19 00 1b fd 1a 00 82 76 82 88 82 81 82 94 81 48 0d 00 00 00 5a 00 08 04 57 00 0f 00 67 00 0a 00 1b fd 1a 00 82 76 82 8f 82 97 81 49 0d 00 00 00 5a 00 08 05 4b 3f 02 34 fe 00 16 00 44 01 1b fd 1a 00 82 68 81 75 82 8d 81 40 82 83 82 8f 82 8d 82 89 82 8e 82 87 81 49 0d 00 00 00 5a 00 08 04 5a 00 08 05 4b 3f 02 34 fe 00 fe 00 ff 00 82 81 82 8e 82 87 82 95 82 81 82 87 82 85 81 48 0d 00 00 00 1b fd 1a 00 82 78 82 85 82 93 81 43 81 40 82 68 81 40 82 84 82 8f 81 42 0d 00 00 00 1b 05 1a 00 82 72 82 8f 82 8d 82 85 82 94 82 89 82 8d 82 85 82 93 81 40 82 89 82 94 81 75 82 93 81 40 82 88 82 81 82 92 82 84 81 40 82 81 82 8e 82 84 0d 00 82 68 81 40 82 84 82 8f 82 8e 81 75 82 94 81 40 82 93 82 85 82 8c 82 8c 81 40 82 8d 82 95 82 83 82 88 81 40 82 88 82 85 82 92 82 85 81 42 0d 00 00 00 1b fd 1a 00 82 68 81 40 82 93 82 85 82 85 81 42 0d 00 00 00 1b 05 1a 00 82 6c 82 81 82 8e 82 99 81 40 82 93 82 88 82 8f 82 90 82 90 82 85 82 92 82 93 81 40 82 93 82 94 82 8f 82 90 82 90 82 85 82 84 81 40 82 83 82 8f 82 8d 82 89 82 8e 82 87 81 42 0d 00 00 00 1b fd 1a 00 82 68 82 94 81 40 82 8d 82 95 82 93 82 94 81 40 82 82 82 85 81 40 82 94 82 88 82 85 81 40 82 94 82 92 82 8f 82 95 82 82 82 8c 82 85 0d 00 82 8f 82 8e 81 40 82 94 82 88 82 85 81 40 82 89 82 93 82 8c 82 81 82 8e 82 84 81 42 0d 00 00 00 1b 05 1a 00 82 67 82 85 82 8c 82 90 81 40 82 8d 82