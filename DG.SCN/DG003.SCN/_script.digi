; DG003.SCN
;!script index=3 start=0x8000 end=0x8800 headerU16=0x1c sentinelOff=0x24
;!sections onEnter section_5 section_6 section_8 section_9 section_7

onEnter:     ; len=68
  0000:  storeRandom 110 99
  0004:  if pstat[110] > 3 then onEnter+0x16
  0010:  spawnItem 48 37 33
  0016:  storeRandom 110 99
  001a:  if pstat[110] > 29 then onEnter+0x2c
  0026:  spawnItem 44 46 59
  002c:  storeRandom 110 99
  0030:  if pstat[110] > 15 then onEnter+0x42
  003c:  spawnItem 44 62 54
  0042:  endSection
