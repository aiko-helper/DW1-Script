// source: extract/DIGIMON/SCN/DG.SCN
// DG003.SCN, section 7

section section_7(7) {  // len=1790
    setTrigger(44);
    switch (pstat[32]) { case 0: goto L_0010; case 1: goto L_0038; case 2: goto L_006e; case 3: goto L_00aa; };
L_0010:
    setDialogOwner(Entity.System);
    showTextbox("<YELLOW>? ? ? <WHITE>\n...\n");
    addPStat(32, 1);
    goto L_030a;
L_0038:
    setDialogOwner(Entity.System);
    showTextbox("<YELLOW>? ? ? <WHITE>. A flower.\n");
    addPStat(32, 1);
    goto L_030a;
L_006e:
    setDialogOwner(Entity.System);
    showTextbox("<YELLOW>? ? ? <WHITE>\nI'm a flower.\n");
    addPStat(32, 1);
    goto L_030a;
L_00aa:
    setDialogOwner(Entity.System);
    showTextbox("<YELLOW>? ? ? <WHITE>\nI said I'm a flower!\nAren't you listening!?\n");
    playSound(8, 12);
    look(entity: 7, at: Entity.Player);
    delay(20);
    setTrigger(1);
    setPStat(250, 1);
    setPStat(251, 7);
    setPStat(252, 255);
    setPStat(253, 255);
    fadeOutHUD();
    delay(1);
    startBattle();
    unsetTrigger(1);
    setPStat(250, 0);
    look(entity: 7, at: Entity.Player);
    look(entity: Entity.Player, at: 7);
    look(entity: Entity.Partner, at: 7);
    waitForEntity(Entity.Player);
    waitForEntity(Entity.Partner);
    playSound(8, 12);
    setDialogOwner(7);
    showTextbox("I hate fighting.\n");
    playAnimation(Entity.Player, 19);
    setDialogOwner(Entity.Player);
    showTextbox("In that case,\ncome to the city.\n");
    playAnimation(Entity.Player, 19);
    showTextbox("It's peaceful there.\n");
    playAnimation(Entity.Player, 0);
    setDialogOwner(7);
    showTextbox("The city?\n");
    showTextbox("Sounds like fun.\nI'm Palmon.\nYou'll find me useful!\n");
    goto L_0290;
L_0290:
    move(entity: 7, to: (170, 1863), sprint: 1);
    if (pstat[101] >= 3) goto L_02b8;
    addPStat(101, 1);
    delay(18);
    look(entity: Entity.Player, at: 7);
    look(entity: Entity.Partner, at: 7);
    goto L_0290;
L_02b8:
    waitForEntity(7);
    unloadEntity(7);
    setPStat(101, 0);
    moveCamera(to: Entity.Player, speed: 10);
    playSound(8, 11);
    setDialogOwner(Entity.System);
    showTextbox("Palmon joins the city!\n");
    setPStat(32, 0);
    setTrigger(246);
    addPStat(1, 1);
    return;
L_030a:
    return;
