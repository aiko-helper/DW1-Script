// DG184.SCN
#include "functions.dgs"
#pragma script index=184 start=0x8d000 end=0x8e800 headerU16=0x10 sentinelOff=0xfe
#include "entities.dgs"

section onEnter(254) {
  return;
}

section(51) {
  if (trigger(256)) {
    return;
  }
  if (!trigger(50)) {
  } else {
    lookPairAt(Entity(8));
    delay(5);
    speak(Entity.Player, "!!!\n");
    move(entity: Entity.Player, to: (150, -1050), sprint: 1, withCamera: true);
    move(entity: Entity.Partner, to: (-250, -1050), sprint: 1);
    waitForPair();
    lookPairAt(Entity(8));
    delay(5);
    speak(Entity.Player, "An egg!\n");
    showTextbox("Could it be Machinedramon's?\n");
    anim(Entity(8), Animation(28), wait: 40);
    speak(Entity.Player, "Could be trouble!\n");
    setTrigger(Trigger(1));
    setPStat(PStat(250), 1);
    setPStat(PStat(251), 8);
    setPStat(PStat(252), 255);
    setPStat(PStat(253), 255);
    startBattle();
    unsetTrigger(Trigger(1));
    setPStat(PStat(250), 0);
    look(entity: Entity.Player, at: Entity(8));
    look(entity: Entity(8), at: Entity.Player);
    look(entity: Entity.Partner, at: Entity(8));
    playSound(8, 3);
    goto L1;

L1:
    approach(who: Entity(8), x: 0, y: -2500, tries: 3, wait: 20);
    playSound(8, 0);
    speak(Entity.System, "Digitamamon joins the city!\n");
    followEntity(Entity.Player, speed: 10);
    setTrigger(Trigger(256));
    addPStat(PStat(1), 3);
    return;
  }
  lookPairAt(Entity(6));
  delay(5);
  speak(Entity.Player, "!\n");
  move(entity: Entity.Player, to: (150, -1443), sprint: 1, withCamera: true);
  move(entity: Entity.Partner, to: (-250, -1443), sprint: 1);
  waitForPair();
  lookPairAt(Entity(6));
  delay(5);
  speak(Entity.Player, "He's there! I found him!\n");
  panTo(x: 14, y: -416, slowdown: 20);
  delay(20);
  look(entity: Entity(6), at: Entity.Partner);
  speak(Entity.Player, "You're the boss!\n");
  speak(Entity(6), "Nice to meet you.\nI'm Analogman.\n");
  speak(Entity(6), "I know all about you, but I\ndidn't know you were a kid.\n");
  showTextbox("I can't believe a kid has\nbeen messing up my plan.\n");
  showTextbox("I was so close to ruling\nthe Net World.\n");
  speak(Entity.Player, "You're a grown up! Stop\nthis, you're hurting everyone.\n");
  speak(Entity(6), "I don't care if\nI'm hurting Digimon.\n");
  anim(Entity(6), Animation(29), wait: 20);
  speak(Entity(6), "Digimon should obey\nhumans like slaves.\n");
  callSubroutine(51);
  anim(Entity.Player, Animation(19), wait: 20);
  speak(Entity.Player, "You're wrong! Digimon have\nhearts and minds!\nWe're friends!\n");
  speak(Entity(6), "Let's fight and see if\nslaves or friends are better.\n");
  move(entity: Entity(6), to: (780, 530), sprint: 0);
  waitForEntity(Entity(6));
  rotate(entity: Entity(6), to: 512);
  delay(20);
  setDigimon(Digimon.Machinedramon, Entity(0), 0);
  callSubroutine(40);
  playAnimation(Entity(6), Animation(28));
  sfx(8, 6, wait: 5);
  speak(Entity(6), "Your turn, Machinedramon!\n");
  move(entity: Entity(6), to: (1984, 1681), sprint: 0);
  waitForEntity(Entity(6));
  fadeOutHUD();
  rotate(entity: Entity(6), to: 512);
  callDigimonSubroutine(8);
  waitForEntity(Entity(201));
  delay(40);
  playAnimation(Entity(5), Animation(28));
  sfx(8, 1, wait: 40);
  setTrigger(Trigger(1));
  setPStat(PStat(250), 1);
  setPStat(PStat(251), 5);
  setPStat(PStat(252), 255);
  setPStat(PStat(253), 255);
  startBattle();
  unsetTrigger(Trigger(1));
  setPStat(PStat(250), 0);
  playAnimation(Entity(5), Animation(43));
  waitForEntity(Entity(5));
  unloadEntity(Entity(5));
  unloadModel(Digimon.Machinedramon);
  speak(Entity.Player, "We did it, <ORANGE><DIGIMON><WHITE>!\n");
  move(entity: Entity.Player, to: (-50, -261), sprint: 1);
  move(entity: Entity.Partner, to: (-50, 424), sprint: 0);
  waitForPair();
  playAnimation(Entity.Player, Animation(11));
  move(entity: Entity(6), to: (1022, 881), sprint: 0);
  waitForEntity(Entity(6));
  speak(Entity(6), "No way!\nMy most powerful slave!\n");
  look(entity: Entity.Player, at: Entity(6));
  delay(5);
  look(entity: Entity.Partner, at: Entity(6));
  delay(5);
  speak(Entity.Player, "Look, you were wrong!\n");
  move(entity: Entity(6), to: (915, 774), sprint: 0);
  waitForEntity(Entity(6));
  speak(Entity(6), "Wow, wow...\n");
  move(entity: Entity(6), to: (738, 597), sprint: 0);
  waitForEntity(Entity(6));
  move(entity: Entity.Player, to: (395, 204), sprint: 0, withCamera: true);
  waitForEntity(Entity(6));
  look(entity: Entity.Player, at: Entity(6));
  delay(5);
  panTo(x: 592, y: 994, slowdown: 20);
  speak(Entity.Player, "If you leave the island\nalone and ask for forgiveness\nthey will forgive you.\n");
  speak(Entity(6), "I shouldn't have trusted\nDigimon. I'll do it myself.\n");
  move(entity: Entity(6), to: (592, 574), sprint: 0);
  waitForEntity(Entity(6));
  rotate(entity: Entity(6), to: 2048);
  delay(5);
  playAnimation(Entity(6), Animation(28));
  sfx(8, 6, wait: 40);
  speak(Entity.Player, "What are you going to do?!\n");
  rotate(entity: Entity(6), to: 1024);
  delay(5);
  speak(Entity.System, "<YELLOW>Analogman <WHITE>\nI'm going to blow the island\nup and will escape to\nanother world. Too bad kid!\n");
  anim(Entity(6), Animation(29), wait: 40);
  playSound(8, 7);
  for x in [11, 9, 10] {
    setObjectVisibility(x, 0);
  }
  setPStat(PStat(247), 12);
  setPStat(PStat(248), 1);
  callSubroutine(21);
  setPStat(PStat(247), 9);
  setPStat(PStat(248), 10);
  callSubroutine(21);
  unloadEntity(Entity(6));
  speak(Entity.Player, "Oh Noooo!!\n");
  setObjectVisibility(0, 0);
  setPStat(PStat(247), 0);
  setPStat(PStat(248), 1);
  callSubroutine(21);
  speak(Entity.System, "<YELLOW>Analogman <WHITE>\nYou're done for now!\n");
  speak(Entity.Player, "I'm sorry guys. There's\nnothing I can do now.\n");
  anim(Entity.Player, Animation(22), wait: 20);
  speak(Entity.System, "<YELLOW>??? <WHITE>\nIt's alright.\n");
  rotate(entity: Entity.Player, to: 1024);
  delay(20);
  rotate(entity: Entity.Player, to: 3072);
  delay(20);
  speak(Entity.Player, "Huh?\n");
  setObjectVisibility(0, 1);
  setObjectVisibility(1, 0);
  setObjectVisibility(2, 0);
  setPStat(PStat(247), 1);
  setPStat(PStat(248), 2);
  callSubroutine(21);
  speak(Entity.System, "<YELLOW>Analogman <WHITE>\nIt's not transferring!\nSomething is wrong in the\nprogram. What's happening?!\n");
  rotate(entity: Entity.Player, to: 0);
  delay(20);
  speak(Entity.Player, "I can hear everyone's voices!\nWho is there?\n");
  anim(Entity.Player, Animation(23), wait: 5);
  speak(Entity.System, "<YELLOW>Jijimon <WHITE>\nI am sending our energy\nto you right now.\n");
  speak(Entity.System, "<YELLOW>Tokomon <WHITE>\nCan you hear our voices?\n");
  speak(Entity.System, "<YELLOW>Agumon <WHITE>\nI guess we made it in time!\n");
  speak(Entity.Player, "You all...\n");
  setObjectVisibility(1, 1);
  setObjectVisibility(2, 1);
  setObjectVisibility(3, 0);
  setObjectVisibility(4, 0);
  setPStat(PStat(247), 3);
  setPStat(PStat(248), 2);
  callSubroutine(21);
  speak(Entity.System, "<YELLOW>Analogman <WHITE>\nNo, this stupid thing! Help!\nHelp me! Ahhhhhhh!!!\n");
  playSound(8, 8);
  setObjectVisibility(3, 1);
  setObjectVisibility(4, 1);
  setObjectVisibility(5, 0);
  delay(40);
  setPStat(PStat(247), 5);
  setPStat(PStat(248), 1);
  callSubroutine(21);
  delay(20);
  rotate(entity: Entity.Player, to: 2048);
  setObjectVisibility(5, 1);
  setObjectsVisibleRange(9, 11, 1);
  setObjectVisibility(6, 0);
  setPStat(PStat(247), 6);
  setPStat(PStat(248), 1);
  callSubroutine(21);
  delay(4);
  setObjectVisibility(6, 1);
  setObjectVisibility(7, 0);
  setPStat(PStat(247), 7);
  setPStat(PStat(248), 1);
  callSubroutine(21);
  delay(3);
  setObjectVisibility(7, 1);
  setObjectVisibility(8, 0);
  setPStat(PStat(247), 8);
  setPStat(PStat(248), 1);
  callSubroutine(21);
  delay(3);
  setObjectVisibility(8, 1);
  delay(10);
  speak(Entity.Player, "He's gone! What happened?\n");
  speak(Entity.System, "<YELLOW>Jijimon <WHITE>\nI don't know. But...\n");
  rotate(entity: Entity.Player, to: 0);
  delay(20);
  speak(Entity.Player, "Jijimon? It's gonna blow!\nDo something!\n");
  speak(Entity.System, "<YELLOW>Jijimon <WHITE>\nHe should be here by now.\n");
  rotate(entity: Entity.Player, to: 1024);
  delay(5);
  panTo(x: -775, y: 596, slowdown: 20);
  delay(10);
  setObjectVisibility(12, 0);
  delay(20);
  loadAndSetDigimon(Digimon.NPCAirdramon, Entity(2), 0);
  lookPairAt(Entity(7));
  move(entity: Entity(7), to: (-808, 124), animDuration: 15);
  delay(40);
  move(entity: Entity.Player, to: (-358, 124), sprint: 1, withCamera: true);
  waitForEntity(Entity.Player);
  speak(Entity.Player, "Airdramon!\n");
  speak(Entity(7), "Hurry up, come on!\n");
  move(entity: Entity.Player, to: Entity(7), sprint: 1);
  move(entity: Entity.Partner, to: Entity(7), sprint: 1);
  delay(30);
  setPStat(PStat(254), 20);
  callSubroutine(45);
  sfx(8, 12, wait: 20);
  sfx(8, 13, wait: 20);
  sfx(8, 14, wait: 20);
  sfx(8, 12, wait: 20);
  speak(Entity.System, "Analogman is gone.\n");
  speak(Entity.System, "Peace has returned to\nFile Island.\n");
  speak(Entity.System, "And...\n");
  for x in [Trigger(50), Trigger(212), Trigger(207), Trigger(206)] {
    setTrigger(x);
  }
  addPStat(PStat(1), 7);
  roll(pstat: PStat(16), max: 2);
  if (pstat[16] == 0) {
    setPStat(PStat(16), 3);
  }
  setPStat(PStat(28), 0);
  if (trigger(220) || trigger(214) || pstat[1] >= 50) {
    warp(to: Map.TEND02, spawn: 0, trigger: 51);
  } else {
    warp(to: Map.TEND01, spawn: 0, trigger: 51);
  }
  return;
}

section(5) {
  return;
  garbage { 10 00 fe 00 10 00 33 00 12 00 05 00 84 11 ff ff fe 00 19 00 00 00 00 01 18 00 20 00 19 00 fe 00 19 00 01 00 32 00 18 00 30 00 19 00 16 00 aa 01 4c 00 fd 08 4c 00 fc 08 67 00 05 00 1b fd 1a 00 81 49 81 49 81 49 0d 00 00 00 52 fd 96 00 e6 fb 01 00 4e fc 06 ff e6 fb 01 00 4a fd 4a fc 4c 00 fd 08 4c 00 fc 08 67 00 05 00 1b fd 1a 00 82 60 82 8e 81 40 82 85 82 87 82 87 81 49 0d 00 00 00 1a 00 82 62 82 8f 82 95 82 8c 82 84 81 40 82 89 82 94 81 40 82 82 82 85 81 40 82 6c 82 81 82 83 82 88 82 89 82 8e 82 85 82 84 82 92 82 81 82 8d 82 8f 82 8e 81 75 82 93 81 48 0d 00 00 00 56 00 08 1c 67 00 28 00 1b fd 1a 00 82 62 82 8f 82 95 82 8c 82 84 81 40 82 82 82 85 81 40 82 94 82 92 82 8f 82 95 82 82 82 8c 82 85 81 49 0d 00 00 00 1c 00 01 00 1e 00 fa 01 1e 00 fb 08 1e 00 fc ff 1e 00 fd ff 27 00 67 00 01 00 66 00 1d 00 01 00 1e 00 fa 00 4c 00 fd 08 4c 00 08 fd 4c 00 fc 08 5a 00 08 03 16 00 28 01 4e 08 00 00 3c f6 01 00 19 00 0d 00 65 03 18 00 50 01 19 00 1f 00 65 01 67 00 14 00 4c 00 fd 08 4c 00 fc 08 16 00 28 01 4a 08 48 08 1e 00 65 00 5a 00 08 00 1b ff 1a 00 82 63 82 89 82 87 82 89 82 94 82 81 82 8d 82 81 82 8d 82 8f 82 8e 81 40 82 8a 82 8f 82 89 82 8e 82 93 81 40 82 94 82 88 82 85 81 40 82 83 82 89 82 94 82 99 81 49 0d 00 00 00 50 00 fd 0a 4a c8 1c 00 00 01 1f 00 01 03 fe 00 4c 00 fd 06 4c 00 fc 06 67 00 05 00 1b fd 1a 00 81 49 0d 00 00 00 52 fd 96 00 5d fa 01 00 4e fc 06 ff 5d fa 01 00 4a fd 4a fc 4c 00 fd 06 4c 00 fc 06 67 00 05 00 1b fd 1a 00 82 67 82 85 81 75 82 93 81 40 82 94 82 88 82 85 82 92 82 85 81 49 81 40 82 68 81 40 82 86 82 8f 82 95 82 8e 82 84 81 40 82 88 82 89 82 8d 81 49 0d 00 00 00 4f 14 0e 00 60 fe 4a c8 67 00 14 00 4c 00 06 fc 1b fd 1a 00 82 78 82 8f 82 95 81 75 82 92 82 85 81 40 82 94 82 88 82 85 81 40 82 82 82 8f 82 93 82 93 81 49 0d 00 00 00 1b 06 1a 00 82 6d 82 89 82 83 82 85 81 40 82 94 82 8f 81 40 82 8d 82 85 82 85 82 94 81 40 82 99 82 8f 82 95 81 42 0d 00 82 68 81 75 82 8d 81 40 82 60 82 8e 82 81 82 8c 82 8f 82 87 82 8d 82 81 82 8e 81 42 0d 00 00