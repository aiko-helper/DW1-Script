  001c:  setDialogOwner 5
  001e:  showTextbox "Welcome! My new business\nis 'Item Keeper'.\nI keep Items for people.\n"
  00aa:  showTextbox "I'll keep your Items for\nfree as a special service.\n"
  0116:  endSection
  0118:  setPStat 254 5
  011c:  callSubroutine 11
  011e:  endSection
