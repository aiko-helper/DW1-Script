// source: extract/DIGIMON/SCN/DG.SCN
// DG171.SCN, section 81

section section_81(81) {  // len=288
    look(entity: Entity.Player, at: 5);
    look(entity: 5, at: Entity.Player);
    delay(5);
    if (trigger(51)) goto L_0118;
    setTrigger(51);
    setDialogOwner(5);
    showTextbox("Welcome! My new business\nis 'Item Keeper'.\nI keep Items for people.\n");
    showTextbox("I'll keep your Items for\nfree as a special service.\n");
    return;
L_0118:
    setPStat(254, 5);
    callSubroutine(11);
    return;
}
