; source: ./extract/DIGIMON/SCN/DG.SCN
; DG171.SCN, section 6

section_6:     ; len=2898
  0000:  if pstat[1] < 30 then section_6+0x320
  000c:  setDialogOwner 6
  000e:  showTextbox "About Digivolution...\nRegarding the next generation\nafter Champion Digimon...\n"
  00ae:  showTextbox "It's the Ultimate Digimon.\nHe doesn't always digivolve\nafter Champion Digimon.\n"
  0150:  showTextbox "In order to digivolve,\ncertain conditions have\nto be met exactly.\n"
  01d8:  showTextbox "But once it digivolves to\nUltimate Digimon, the life\nexpectancy will grow.\n"
  0272:  showTextbox "But if you digiolve by eating\nan Digivolution Item, life\nexpectancy stays the same.\n"
  031e:  endSection
  0320:  if pstat[1] < 15 then section_6+0x7c4
  032c:  setDialogOwner 6
  032e:  showTextbox "More about digivolution.\nAbout the conditions.\n"
  0390:  showTextbox "First of all, I hear that\nthe weight has to be close\nto the target weight.\n"
  042a:  showTextbox "And the higher the parameters\nthe better.\n"
  0482:  showTextbox "But depending on which\nparameter is higher\nthe result is different.\n"
  050e:  showTextbox "About care mistakes,\nin some cases, it works\nbetter to fail on purpose.\n"
  05a2:  showTextbox "Depending on the digivolution\ntarget, some conditions\nhave to be met.\n"
  0632:  showTextbox "There are some situations\nthat can cause digivolution.\n"
  06a4:  showTextbox "Like the number of battles or\nhow well he's disciplined.\n"
  071a:  showTextbox "If those conditions are met,\neven if some others are\nnot, he still can digivolve.\n"
  07c2:  endSection
  07c4:  setDialogOwner 6
  07c6:  showTextbox "I heard from Jiji that\n<ORANGE><DIGIMON><WHITE> will digivolve.\n"
  0820:  showTextbox "From Fresh Digimon to\nIn-Training Digimon,\nit only takes six hours.\n"
  08ac:  showTextbox "From there to Rookie\nDigimon, it takes about\na day to digivolve.\n"
  0932:  showTextbox "Then to the next Champion\nDigimon, it takes about\nthree days to digivolve.\n"
  09cc:  showTextbox "And what was the next\ngeneration? I forgot,\nbut there's more.\n"
  0a4c:  showTextbox "Digivolution is related to\nweight, parameters,\nand care mistakes.\n"
  0ad4:  showTextbox "I don't understand\nvery well. I'll ask Jiji\nmy next chance.\n"
  0b50:  endSection
