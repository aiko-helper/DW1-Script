; DG042.SCN
;!script index=42 start=0x21800 end=0x22000 headerU16=0x24 sentinelOff=0x24
;!sections onEnter section_5 section_6 section_7 section_8 section_9 section_10 section_51

onEnter:     ; len=68
  0000:  storeRandom 110 99
  0004:  if pstat[110] > 9 then onEnter+0x16
  0010:  spawnItem 44 79 63
  0016:  storeRandom 110 99
  001a:  if pstat[110] > 14 then onEnter+0x2c
  0026:  spawnItem 44 48 37
  002c:  storeRandom 110 99
  0030:  if pstat[110] > 0 then onEnter+0x42
  003c:  spawnItem 46 48 51
  0042:  endSection
