#pragma script index=123 start=0x57800 end=0x58000 headerU16=0x24 sentinelOff=0x24
#pragma sections section_0254 section_0005 section_0006 section_0007 section_0081 section_0082 section_0051 section_0052

section onEnter(254) {  // len=50
    roll(pstat: 110, max: 99);
    if (pstat[110] > 9) goto L_0016;
    spawnItem(Item.Digimushroom, 48, 68);
L_0016:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 3) goto L_002c;
    spawnItem(Item.Pricklypear, 76, 49);
L_002c:
    unsetTrigger(98);
    return;
}
