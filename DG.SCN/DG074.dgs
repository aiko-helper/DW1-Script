// DG074.SCN
#pragma script index=74 start=0x34800 end=0x35000 headerU16=0x20 sentinelOff=0x24

section onEnter(254) {
    roll(pstat: 110, max: 99);
    if (pstat[110] > 14) goto L1;
    spawnItem(Item.Digimushroom, x: 27, y: 77);

L1:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 10) goto L2;
    spawnItem(Item.Digimushroom, x: 62, y: 58);

L2:
    return;
}

section(5) {
    speak(5, "Forget it! This is a waste!\n");
    startBattle();
    setTrigger(275);
    return;
}

section(6) {
    speak(6, "Let me eat!\n");
    startBattle();
    setTrigger(297);
    return;
}

section(7) {
    speak(7, "The ceremony is starting.\n");
    startBattle();
    setTrigger(297);
    return;
}

section(8) {
    speak(8, "How about trusting me?\n");
    startBattle();
    setTrigger(275);
    return;
}

section(9) {
    speak(9, "Ha ha, Huh?\n");
    startBattle();
    setTrigger(297);
    return;
}

section(10) {
    speak(10, "I win. You lose.\n");
    startBattle();
    setTrigger(297);
    return;
