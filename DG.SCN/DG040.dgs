// DG040.SCN
#include "functions.dgs"
#pragma script index=40 start=0x1f000 end=0x1f800 headerU16=0x24 sentinelOff=0x24
#include "entities.dgs"

section onEnter(254) {
  spawnItemChance(max: 99, chance: 9, item: Item.Digimushroom, x: 79, y: 63);
  spawnItemChance(max: 99, chance: 14, item: Item.Digimushroom, x: 48, y: 37);
  spawnItemChance(max: 99, chance: 0, item: Item.DeluxeMushroom, x: 48, y: 51);
  return;
}

section(5) {
  speak(Entity(5), "「シュワー!」<NEWLINE>");
  finishEncounter(Trigger(302));
}

section(6) {
  speak(Entity(6), "「シャシャシャーッ!」<NEWLINE>");
  finishEncounter(Trigger(302));
}

section(7) {
  speak(Entity(7), "「ケガはないようだね?」<NEWLINE>");
  finishEncounter(Trigger(299));
}

section(8) {
  speak(Entity(8), "「べんきょうしまっせ。」<NEWLINE>");
  finishEncounter(Trigger(268));
}

section(9) {
  speak(Entity(9), "「なめてもろたらこまりますわ!」<NEWLINE>");
  finishEncounter(Trigger(268));
}

section(10) {
  speak(Entity(10), "「生きてかえれるとは思うなよ。」<NEWLINE>");
  finishEncounter(Trigger(305));
}

section(51) {
  storeDigimonType(PStat(103));
  {
    if (pstat[103] == 6 || pstat[103] == 7 || pstat[103] == 12 || pstat[103] == 19 || pstat[103] == 20) {
      break;
    }
    if (pstat[103] == 21 || pstat[103] == 28 || pstat[103] == 33 || pstat[103] == 37 || pstat[103] == 41) {
      break;
    }
    if (pstat[103] == 45 || pstat[103] == 31 || pstat[103] == 51 || pstat[103] == 54 || pstat[103] == 55) {
      break;
    }
    goto L1;
  }
  anim(Entity.Player, Animation(18), wait: 20);
  speak(Entity.Player, "「いってーーーーっ!」<NEWLINE>");
  setPStat(PStat(254), 253);
  callSubroutine(55);
  speak(Entity.Player, "「…でもあんなに高いところから<NEWLINE> 落ちたわりには…平気だな。」<NEWLINE>");
  look(entity: Entity.Player, at: Entity.Partner);
  delay(20);
  look(entity: Entity.Partner, at: Entity.Player);
  anim(Entity.Player, Animation(19), wait: 15);
  speak(Entity.Player, "「っと、<ORANGE><DIGIMON><WHITE>、大丈夫か?!」<NEWLINE>");
  playAnimation(Entity.Player, Animation(0));
  showTextbox("「ん?全然平気みたいじゃん。」<NEWLINE>");
  showTextbox("「あ、おまえ飛んだな?ずるいなー。<NEWLINE> …って別にずるくはないか。」<NEWLINE>");
  rotate(entity: Entity.Player, to: 2002);
  delay(20);
  speak(Entity.Player, "「さぁ、行こう。」<NEWLINE>");
  return;

L1:
  playAnimation(Entity.Partner, Animation(43));
  anim(Entity.Player, Animation(18), wait: 40);
  anim(Entity.Partner, Animation(44), wait: 40);
  playAnimation(Entity.Partner, Animation(0));
  speak(Entity.Player, "「いってーーーーっ!」<NEWLINE>");
  setPStat(PStat(254), 253);
  callSubroutine(55);
  speak(Entity.Player, "「…でもあんなに高いところから<NEWLINE> 落ちたわりには…平気だな。」<NEWLINE>");
  rotate(entity: Entity.Player, to: 2002);
  delay(20);
  anim(Entity.Player, Animation(19), wait: 15);
  speak(Entity.Player, "「っと、<ORANGE><DIGIMON><WHITE>、大丈夫か?!」<NEWLINE>");
  playAnimation(Entity.Player, Animation(0));
  showTextbox("「ちょっと痛かったみたいだな。ごめん。」<NEWLINE>");
  speak(Entity.Player, "「さぁ、行こう。」<NEWLINE>");
  return;
  garbage { 24 00 fe 00 24 00 05 00 68 00 06 00 8c 00 07 00 b8 00 08 00 e6 00 09 00 14 01 0a 00 4a 01 33 00 80 01 ff ff 24 00 6e 63 19 00 0b 00 6e 09 18 00 3a 00 19 00 74 2c 4f 00 3f 00 24 00 6e 63 19 00 0b 00 6e 0e 18 00 50 00 19 00 74 2c 30 00 25 00 24 00 6e 63 19 00 0b 00 6e 00 18 00 66 00 19 00 74 2e 30 00 33 00 fe 00 1b 05 1a 00 81 75 83 56 83 85 83 8f 81 5b 81 49 81 76 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 2e 01 fe 00 1b 06 1a 00 81 75 83 56 83 83 83 56 83 83 83 56 83 83 81 5b 83 62 81 49 81 76 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 2e 01 fe 00 1b 07 1a 00 81 75 83 50 83 4b 82 cd 82 c8 82 a2 82 e6 82 a4 82 be 82 cb 81 48 81 76 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 2b 01 fe 00 1b 08 1a 00 81 75 82 d7 82 f1 82 ab 82 e5 82 a4 82 b5 82 dc 82 c1 82 b9 81 42 81 76 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 0c 01 fe 00 1b 09 1a 00 81 75 82 c8 82 df 82 c4 82 e0 82 eb 82 bd 82 e7 82 b1 82 dc 82 e8 82 dc 82 b7 82 ed 81 49 81 76 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 0c 01 fe 00 1b 0a 1a 00 81 75 90 b6 82 ab 82 c4 82 a9 82 a6 82 ea 82 e9 82 c6 82 cd 8e 76 82 a4 82 c8 82 e6 81 42 81 76 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 31 01 fe 00 22 67 19 00 08 00 67 06 48 00 67 07 48 00 67 0c 48 00 67 13 48 00 67 14 18 00 a2 01 19 00 16 00 e6 01 19 00 08 00 67 15 48 00 67 1c 48 00 67 21 48 00 67 25 48 00 67 29 18 00 c2 01 19 00 16 00 e6 01 19 00 08 00 67 2d 48 00 67 1f 48 00 67 33 48 00 67 36 48 00 67 37 18 00 e2 01 19 00 16 00 e6 01 16 00 26 03 56 00 fd 12 67 00 14 00 1b fd 1a 00 81 75 82 a2 82 c1 82 c4 81 5b 81 5b 81 5b 81 5b 82 c1 81 49 81 76 0d 00 00 00 1e 00 fe fd 64 37 1b fd 1a 00 81 75 81 63 82 c5 82 e0 82 a0 82 f1 82 c8 82 c9 8d 82 82 a2 82 c6 82 b1 82 eb 82 a9 82 e7 0d 00 81 40 97 8e 82 bf 82 bd 82 ed 82 e8 82 c9 82 cd 81 63 95 bd 8b 43 82 be 82 c8 81 42 81 76 0d 00 00 00 4c 00 fd fc 67 00 14 00 4c 00 fc fd 56 00 fd 13 67 00 0f 00 1b fd 1a 00 81 75 82 c1 82 c6 81 41 01 0a 06 00 01 01 81 41 91 e5 8f e4 95 76 82 a9 81 48 81 49 81 76 0d 00 00 00 56 00 fd 00 1a