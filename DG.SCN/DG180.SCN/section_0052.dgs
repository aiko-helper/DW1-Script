// source: extract/DIGIMON/SCN/DG.SCN
// DG180.SCN, section 52

section section_52(52) {  // len=230
    setTrigger(340);
    delay(20);
    move(entity: Entity.Player, to: (1931, -482), sprint: 0, withCamera: true);
    move(entity: Entity.Partner, to: (1822, -891), sprint: 0);
    waitForEntity(Entity.Player);
    waitForEntity(Entity.Partner);
    setDialogOwner(Entity.Player);
    showTextbox("What's this?\n");
    playAnimation(Entity.Partner, 23);
    delay(40);
    look(entity: Entity.Player, at: Entity.Partner);
    delay(5);
    setDialogOwner(Entity.Player);
    showTextbox("What happened, <ORANGE><DIGIMON><WHITE>?!\n");
    playAnimation(Entity.Player, 16);
    delay(20);
    setDialogOwner(Entity.Player);
    showTextbox("This fog stinks!\n");
    setDialogOwner(Entity.Player);
    showTextbox("It's weird, kinda nasty.\n");
    return;
}
