;!script index=116 start=0x54000 end=0x54800 headerU16=0x1c sentinelOff=0x24
;!sections onEnter section_6 section_7 section_8 section_9 section_5

onEnter:     ; len=68
  0000:  storeRandom 110 99
  0004:  if pstat[110] > 13 then onEnter+0x16
  0010:  spawnItem 44 53 64
  0016:  storeRandom 110 99
  001a:  if pstat[110] > 8 then onEnter+0x2c
  0026:  spawnItem 44 50 36
  002c:  storeRandom 110 99
  0030:  if pstat[110] > 2 then onEnter+0x42
  003c:  spawnItem 69 42 75
  0042:  endSection
