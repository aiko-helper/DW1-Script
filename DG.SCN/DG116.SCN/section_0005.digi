; source: ./extract/DIGIMON/SCN/DG.SCN
; DG116.SCN, section 5

section_5(5):     ; len=1734
  0000:  speak 5 "...!\n"
  0010:  setTrigger 1
  0014:  pstat[250] = 1
  0018:  pstat[251] = 5
  001c:  pstat[252] = 255
  0020:  pstat[253] = 255
  0024:  fadeOutHUD
  0026:  delay 1
  002a:  startBattle
  002c:  unsetTrigger 1
  0030:  pstat[250] = 0
  0034:  lookAt 5 Player
  0038:  lookAt Player 5
  003c:  lookAt Partner 5
  0040:  waitForEntity Player
  0042:  waitForEntity Partner
  0044:  speak 5 "No, I don't want to!\nI don't want to fight!\n"
  00a2:  speak Player "If you don't want to\nfight, then run away.\n"
  00fe:  speak 5 "That's too bad.\n"
  0124:  playAnimation Player 16
  0128:  delay 20
  012c:  speak Player "I don't understand you.\n"
  0162:  showTextbox "Oh well, why don't you come\nto our city? Better than\nhiding out here.\n"
  01f2:  speak 5 "Uh, city?\n"
  020c:  playAnimation Player 19
  0210:  delay 20
  0214:  speak Player "We are not going to\nforce you.\n"
  0258:  speak 5 "That makes me want to go.\nOkay, I'll go!\n"
  02b0:  fadeOutHUD
  02b2:  jump section_5+0x2b6
  02b6:  entityWalkTo 5 -330 -2751 1
  02be:  if pstat[101] >= 5 then section_5+0x2de
  02ca:  pstat[101] += 1
  02ce:  delay 20
  02d2:  lookAt Player 5
  02d6:  lookAt Partner 5
  02da:  jump section_5+0x2b6
  02de:  waitForEntity 5
  02e0:  unloadEntity 5
  02e2:  pstat[101] = 0
  02e6:  playSound 8 10
  02ea:  speak System "Gabumon joins the city!\n"
  0320:  playAnimation Player 16
  0324:  delay 20
  0328:  speak Player "What a weird fellow.\n"
  0358:  moveCameraToEntity Player 10
  035c:  waitForEntity 200
  035e:  setTrigger 217
  0362:  pstat[1] += 1
  0366:  endSection
