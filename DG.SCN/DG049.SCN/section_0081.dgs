section section_81(81) {  // len=1642
    if (!trigger(247)) goto L_000e;
    return;
L_000e:
    look(entity: Entity.Player, at: 5);
    if (!trigger(136)) goto L_0022;
    goto L_063a;
L_0022:
    setTrigger(136);
    setDialogOwner(5);
    showTextbox("Welcome. I've never seen you\nbefore. Where are you from?\n");
    setDialogOwner(Entity.Player);
    showTextbox("The city. Actually, I'm\nfrom another world.\n");
    setDialogOwner(5);
    showTextbox("You understand my language?\n");
    setDialogOwner(Entity.Player);
    showTextbox("Yes, I do.\n");
    setDialogOwner(5);
    showTextbox("Sometimes it's hard and\nI don't sell much here.\n");
    setDialogOwner(Entity.Player);
    showTextbox("I see.\n");
    setDialogOwner(5);
    showTextbox("Many shoppers stopped coming.\n");
    setDialogOwner(Entity.Player);
    showTextbox("It must be the trouble\non the island.\n");
    setDialogOwner(5);
    showTextbox("Help me do something.\n");
    setDialogOwner(Entity.Player);
    showTextbox("What is it?\n");
    setDialogOwner(5);
    showTextbox("Can you work in my shop?\n");
    setDialogOwner(Entity.Player);
    showTextbox("Your shop?\n");
    setDialogOwner(5);
    showTextbox("Half day? The more you sell,\nthe more I'll pay you.\nYou know our language.\n");
    setDialogOwner(Entity.Player);
    showTextbox("You might lose money.\n");
    setDialogOwner(5);
    showTextbox("Don't worry. It'll be good\nfor me. How about eight hours?\n");
L_0450:
    setDialogOwner(Entity.Player);
    setSelection(L_0488, L_05d6);
    showTextbox("I'll try\nNo thanks\n");
    waitForSelectionChoice();
    goto L_05d6;
L_0488:
    fadeOutHUD();
    move(entity: 5, to: (133, 292), sprint: 0);
    move(entity: Entity.Player, to: (-980, -432), sprint: 0);
    waitForEntity(Entity.Player);
    waitForEntity(5);
    setPStat(247, 9);
    setPStat(248, 12);
    callSubroutine(21);
    setObjectVisibility(33, 1);
    setObjectVisibility(34, 1);
    setObjectVisibility(35, 1);
    setObjectVisibility(9, 0);
    setObjectVisibility(10, 0);
    setObjectVisibility(11, 0);
    setObjectVisibility(12, 0);
    setObjectVisibility(13, 0);
    setObjectVisibility(14, 0);
    setObjectVisibility(15, 0);
    setObjectVisibility(16, 0);
    setObjectVisibility(17, 0);
    setObjectVisibility(18, 0);
    setObjectVisibility(19, 0);
    setObjectVisibility(20, 0);
    look(entity: 5, at: Entity.Player);
    move(entity: Entity.Player, to: (-980, 292), sprint: 0);
    move(entity: Entity.Partner, to: (-980, -432), sprint: 0);
    waitForEntity(Entity.Player);
    waitForEntity(Entity.Partner);
    look(entity: 5, at: Entity.Player);
    move(entity: Entity.Player, to: (-341, 292), sprint: 0);
    move(entity: Entity.Partner, to: (-980, 292), sprint: 0);
    waitForEntity(Entity.Player);
    waitForEntity(Entity.Partner);
    setPStat(247, 21);
    setPStat(248, 12);
    callSubroutine(21);
    setObjectVisibility(9, 1);
    setObjectVisibility(10, 1);
    setObjectVisibility(11, 1);
    setObjectVisibility(12, 1);
    setObjectVisibility(13, 1);
    setObjectVisibility(14, 1);
    setObjectVisibility(15, 1);
    setObjectVisibility(16, 1);
    setObjectVisibility(17, 1);
    setObjectVisibility(18, 1);
    setObjectVisibility(19, 1);
    setObjectVisibility(20, 1);
    setObjectVisibility(21, 0);
    setObjectVisibility(22, 0);
    setObjectVisibility(23, 0);
    setObjectVisibility(24, 0);
    setObjectVisibility(25, 0);
    setObjectVisibility(26, 0);
    setObjectVisibility(27, 0);
    setObjectVisibility(28, 0);
    setObjectVisibility(29, 0);
    setObjectVisibility(30, 0);
    setObjectVisibility(31, 0);
    setObjectVisibility(32, 0);
    delay(60);
    rotate(entity: Entity.Player, to: 0);
    look(entity: Entity.Partner, at: Entity.Player);
    waitForEntity(Entity.Player);
    setObjectVisibility(21, 1);
    setObjectVisibility(22, 1);
    setObjectVisibility(23, 1);
    setObjectVisibility(24, 1);
    setObjectVisibility(25, 1);
    setObjectVisibility(26, 1);
    setObjectVisibility(27, 1);
    setObjectVisibility(28, 1);
    setObjectVisibility(29, 1);
    setObjectVisibility(30, 1);
    setObjectVisibility(31, 1);
    setObjectVisibility(32, 1);
    setObjectVisibility(33, 0);
    setObjectVisibility(34, 0);
    setObjectVisibility(35, 0);
    callSubroutine(30);
    setPStat(123, 0);
    unsetTrigger(101);
    goto section_82;
L_05d6:
    setDialogOwner(5);
    showTextbox("That's too bad. Come back\nwhen you have time.\n");
    return;
L_063a:
    setDialogOwner(5);
    showTextbox("You want to work?\n");
    goto L_0450;
    return;
