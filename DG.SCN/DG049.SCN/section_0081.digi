  0026:  setDialogOwner 5
  0028:  showTextbox "Welcome. I've never seen you\nbefore. Where are you from?\n"
  009e:  setDialogOwner Player
  00a0:  showTextbox "The city. Actually, I'm\nfrom another world.\n"
  00fc:  setDialogOwner 5
