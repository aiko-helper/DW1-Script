  01b6:  fadeOutHUD
  01b8:  jump section_82+0x72
  01bc:  speak 5 "I haven't had this much\nbusiness in a long time.\nKeep it up!\n"
  023c:  setRotation Player 80
  0240:  fadeOutHUD
  0242:  jump section_82+0x72
  0246:  delay 40
  024a:  speak 5 "I think it's time.\nThank you for your work.\n"
  02a8:  callSubroutine 56
  02aa:  if pstat[243] > 6 then section_82+0x388
  02b6:  speak 5 "It could have been better,\nbut it wasn't that bad.\nDon't give up.\n"
