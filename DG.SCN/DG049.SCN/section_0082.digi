section_82:     ; len=2420
  0000:  if pstat[123] < 20 then section_82+0x10
  000c:  jump section_82+0x246
  0010:  if pstat[123] < 10 OR trigger(101) then section_82+0x72
  0020:  setTrigger 101
  0024:  setDialogOwner 5
  0026:  showTextbox "Well, it's half way done.\n \n"
  0062:  lookAt 5 253
  0066:  lookAt 253 5
  006a:  delay 10
  006e:  jump section_82+0xb4
  0072:  storeRandom 110 8
  0076:  if pstat[110] > 2 then section_82+0x88
  0082:  jumpToScriptSection 199 51
  0088:  if pstat[110] > 5 then section_82+0x9a
  0094:  jumpToScriptSection 200 51
  009a:  if pstat[110] > 7 then section_82+0xac
  00a6:  jumpToScriptSection 201 51
  00ac:  jumpToScriptSection 202 51
  00b2:  endSection
  00b4:  callSubroutine 56
  00b6:  if pstat[243] > 2 then section_82+0x148
  00c2:  setDialogOwner 5
  00c4:  showTextbox "The way it's going, we won't\nmake any money. Try harder.\n \n"
  013e:  setRotation 253 80
  0142:  fadeOutHUD
  0144:  jump section_82+0x72
  0148:  if pstat[243] > 5 then section_82+0x1bc
  0154:  setDialogOwner 5
  0156:  showTextbox "The sales are good.\nWe can make some money.\n"
  01b2:  setRotation 253 80
  01b6:  fadeOutHUD
  01b8:  jump section_82+0x72
  01bc:  setDialogOwner 5
  01be:  showTextbox "I haven't had this much\nbusiness in a long time.\nKeep it up!\n"
  023c:  setRotation 253 80
  0240:  fadeOutHUD
  0242:  jump section_82+0x72
  0246:  delay 40
  024a:  setDialogOwner 5
  024c:  showTextbox "I think it's time.\nThank you for your work.\n"
  02a8:  callSubroutine 56
  02aa:  if pstat[243] > 6 then section_82+0x388
  02b6:  setDialogOwner 5
  02b8:  showTextbox "It could have been better,\nbut it wasn't that bad.\nDon't give up.\n"
  0340:  addMoney 500
  0346:  setDialogOwner 255
  0348:  showTextbox "I got five hund bits!\n"
  0378:  storeDate 105
  037a:  addMinutesToDate 105 480
  0380:  advanceToDate 105
  0382:  warpTo 44 2 255
  0386:  endSection
  0388:  if pstat[243] > 11 then section_82+0x440
  0394:  setDialogOwner 5
  0396:  showTextbox "You can do better.\nI want you to work more.\n"
  03f2:  addMoney 1500
  03f8:  setDialogOwner 255
  03fa:  showTextbox "I got fifteen hund bits!\n"
  0430:  storeDate 105
  0432:  addMinutesToDate 105 480
  0438:  advanceToDate 105
  043a:  warpTo 44 2 255
  043e:  endSection
  0440:  setDialogOwner 5
  0442:  showTextbox "Your wisdom, character and\nguts are what we need to\nsave this island.\n"
  04d2:  setDialogOwner 253
  04d4:  showTextbox "What are you talking about?\n"
  0510:  setDialogOwner 5
  0512:  showTextbox "I was testing you to see if\nyou are capable of saving us.\n"
  058a:  setDialogOwner 5
  058c:  showTextbox "It's important to be\ngood in battle.\n"
  05da:  setDialogOwner 5
  05dc:  showTextbox "Besides power, courage and\nwisdom are also needed.\n"
  0646:  setDialogOwner 253
  0648:  showTextbox "Did we pass the test?\n"
  0678:  setDialogOwner 5
  067a:  showTextbox "Yes, I'll help you\nas much as I can.\n"
  06c8:  setDialogOwner 253
  06ca:  showTextbox "Will you come to the city?\nWhat will you do\nwith the shop?\n"
  0744:  setDialogOwner 5
  0746:  showTextbox "I can open a shop later.\nThis shop's duty is done.\n"
  07b0:  playSound 8 10
  07b4:  setDialogOwner 255
  07b6:  showTextbox "Monochromon joins the city!\n"
  07f2:  showTextbox "I got two thous bits!\n"
