// MAP216.SCN
#include "functions.dgs"
#pragma script index=216 start=0xa1000 end=0xa1800 headerU16=0x24 sentinelOff=0x6c75
#include "entities.dgs"

section onEnter(254) {
  spawnChest(Item.RayGun, -2240, 1956, 3072, 707);
  return;
}

section(51) {
  move(entity: Entity.Player, to: (2718, 1041), sprint: 0);
  switch pstat[16] {
    1 => {
      warp(to: Map.FRZL05, spawn: 1, trigger: 255);
    }
    2 => {
      warp(to: Map.DGHA02, spawn: 1, trigger: 255);
    }
    3 => {
      warp(to: Map.GCAN05, spawn: 1, trigger: 255);
    }
  }
  return;
}

section(52) {
  move(entity: Entity.Player, to: (-2786, 1100), sprint: 0);
  warp(to: Map.MGEN12, spawn: 1, trigger: 255);
  return;
}

section(60) {
  rotate(entity: Entity.Player, to: 1024);
  delay(40);
  speak(Entity.Player, "「ここは…!」<NEWLINE>");
  move(entity: Entity.Player, to: (2150, 1950), sprint: 0, withCamera: true);
  waitForEntity(Entity.Player);
  speak(Entity.Player, "「そうか、この奥に…」<NEWLINE>");
  return;
}

section(5) {
  speak(Entity(5), "「私の本当の力を見せましょう。」<NEWLINE>");
  finishEncounter(Trigger(285));
}

section(6) {
  speak(Entity(6), "「全力で戦える時が来るとは…」<NEWLINE>");
  finishEncounter(Trigger(285));
}

section(7) {
  speak(Entity(7), "「…おまえ…死ぬな。」<NEWLINE>");
  finishEncounter(Trigger(300));
}

section(8) {
  speak(Entity(8), "「ここからが本当のジゴクさ…」<NEWLINE>");
  finishEncounter(Trigger(300));
