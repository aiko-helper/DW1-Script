; source: ./extract/DIGIMON/SCN/DG.SCN
; DG108.SCN, section 5

section_5:     ; len=3520
  0000:  if pstat[1] < 40 then section_5+0x106
  000c:  setDialogOwner 5
  000e:  showTextbox "Hey, here's new info.\n"
  003e:  showTextbox "For Fresh or In-Training\nDigimon, try to repeat\nthe same training.\n"
  00c8:  showTextbox "Something good will happen.\n"
  0104:  endSection
  0106:  if pstat[1] < 20 then section_5+0x1e2
  0112:  setDialogOwner 5
  0114:  showTextbox "Here's new info.\n"
  013a:  showTextbox "For Bonus try, if you line\nup the same pictures, his\nability is boosted greatly.\n"
  01e0:  endSection
  01e2:  if pstat[1] < 5 then section_5+0x5ca
  01ee:  setDialogOwner 5
  01f0:  showTextbox "Oh, I was supposed to\ntalk about Techniques.\n"
  024e:  showTextbox "Techniques that an enemy\nuses can be mastered\nif you win a battle.\n"
  02d8:  showTextbox "But Techniques are limited\nto those which can be\nadded at that time.\n"
  0366:  showTextbox "You can't master everything.\nBut battling is the fastest\nway to master Techniques.\n"
  0410:  showTextbox "You can also master them thru\ntraining, but chances are low.\n"
  048e:  showTextbox "When you get smarter, take\n<LIGHTBLUE><PLAYER><WHITE>'s classroom and you\nmay learn a Technique.\n"
  0526:  showTextbox "Chances of you learning are\nlow, so don't expect too much.\nTrain with balance!\n"
  05c8:  endSection
  05ca:  setDialogOwner 5
  05cc:  showTextbox "Hey, I'm Koromon.\nJiji told me to tell you\nabout training.\n"
  0646:  showTextbox "Wanna ask me something?\n"
  067a:  setDialogOwner 253
  067c:  setSelection section_5+0x6f0 section_5+0x8de section_5+0xd62
  0684:  showTextbox "What training?\nTeach me how to train\nNo, nothing\n"
  06ea:  waitForSelectionChoice
  06ec:  jump section_5+0xd62
  06f0:  setDialogOwner 5
  06f2:  showTextbox "If you train here,\nyou can boost your\nDigimon's abilities.\n"
  076c:  showTextbox "Training makes you tired,\nbut you'll get more out of\nit than actual battle.\n"
  0808:  showTextbox "Also, though very rare, you\ncan master new Techniques.\n"
  087a:  showTextbox "I'll tell you more about\nTechniques next time.\n"
  08dc:  endSection
  08de:  setDialogOwner 5
  08e0:  showTextbox "There are six training\nstations here and they\nhave signs near by.\n"
  0968:  setDialogOwner 5
  096a:  showTextbox "Try pushing <LIGHTBLUE><X> <WHITE>\nin front of the sign.\n"
  09bc:  showTextbox "Read the signs, and you'll\nknow which abilities\nyou can boost.\n"
  0a3e:  showTextbox "Depending on your Digimon's\nSpecialty, some abilities are\nboosted more than others.\n"
  0aea:  showTextbox "You won't know for sure\nuntil you try though.\n"
  0b4a:  showTextbox "After 'Begin'\nchoose 'Normal' and\ntrain for one hour.\n"
  0bba:  showTextbox "While training, with\n<GREEN><TRIANGLE> <WHITE>you can\nfast forward time.\n"
  0c26:  showTextbox "Oh yeah, I have to tell you\nabout 'Bonus Try'.\n"
  0c88:  showTextbox "If successful, Bonus Try\ngreatly boosts your power,\nbut little if you fail.\n"
  0d24:  showTextbox "Try it once and you'll see.\n"
  0d60:  endSection
  0d62:  setDialogOwner 5
  0d64:  showTextbox "Well, I'll get more new\ninfo for you soon.\n"
  0dbe:  endSection
