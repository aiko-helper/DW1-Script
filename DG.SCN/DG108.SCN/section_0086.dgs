// source: extract/DIGIMON/SCN/DG.SCN
// DG108.SCN, section 86

section section_86(86) {  // len=618
    rotate(entity: Entity.Player, to: 1536);
    setTextboxOrigin(-1779, 0, 2084);
    callSubroutine(39);
    if (!trigger(219)) goto L_0074;
    setDialogOwner(200);
    showTextbox("<GREEN>Training:\n<LIGHTBLUE><PLAYER><WHITE>'s <GREEN>Classroom,\nrevision <WHITE>\n");
    goto L_00b6;
L_0074:
    setDialogOwner(200);
    showTextbox("<GREEN>Training:\n<LIGHTBLUE><PLAYER><WHITE>'s <GREEN>Classroom <WHITE>\n");
L_00b6:
    setSelection(L_00ec, L_012a, L_01de);
    showTextbox("Begin\nExplain\nQuit\n");
    waitForSelectionChoice();
    return;
L_00ec:
    setDialogOwner(200);
    setSelection(L_01e0, L_01f0, L_01de);
    showTextbox("Normal\nBonus Try\nQuit\n");
    waitForSelectionChoice();
    return;
L_012a:
    setDialogOwner(200);
    showTextbox("<LIGHTBLUE><PLAYER><WHITE> will teach many\nthings. Boosts\nBrains and Max MP.\n");
    setSelection(L_012a, L_00ec, L_01de);
    showTextbox("Explain again\nBegin\nQuit\n");
    waitForSelectionChoice();
    return;
L_01de:
    return;
L_01e0:
    fadeOutHUD();
    setPStat(254, 5);
    setPStat(246, 0);
    callDigimonSubroutine(214);
    callSubroutine(7);
    return;
L_01f0:
    setTexboxMode(1, 0);
    setDialogOwner(Entity.System);
    showTextbox("<YELLOW>Slot Game <WHITE>\nUse <LIGHTBLUE><X> <WHITE>\nto match three pictures.\n");
    setPStat(254, 5);
    setPStat(246, 1);
    callDigimonSubroutine(214);
    callSubroutine(7);
    setTexboxMode(0, 0);
    return;
}
