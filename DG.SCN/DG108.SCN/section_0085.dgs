// source: extract/DIGIMON/SCN/DG.SCN
// DG108.SCN, section 85

section section_85(85) {  // len=578
    rotate(entity: Entity.Player, to: 2048);
    setTextboxOrigin(12, 0, 445);
    callSubroutine(39);
    if (!trigger(219)) goto L_0062;
    setDialogOwner(200);
    showTextbox("<GREEN>Training:\nRunning, revision <WHITE>\n");
    goto L_0092;
L_0062:
    setDialogOwner(200);
    showTextbox("<GREEN>Training: Running <WHITE>\n");
L_0092:
    setSelection(L_00c8, L_0106, L_01b6);
    showTextbox("Begin\nExplain\nQuit\n");
    waitForSelectionChoice();
    return;
L_00c8:
    setDialogOwner(200);
    setSelection(L_01b8, L_01c8, L_01b6);
    showTextbox("Normal\nBonus Try\nQuit\n");
    waitForSelectionChoice();
    return;
L_0106:
    setDialogOwner(200);
    showTextbox("Run around course.\nGreatly boosts\nSpeed and Max HP.\n");
    setSelection(L_0106, L_00c8, L_01b6);
    showTextbox("Explain again\nBegin\nQuit\n");
    waitForSelectionChoice();
    return;
L_01b6:
    return;
L_01b8:
    fadeOutHUD();
    setPStat(254, 2);
    setPStat(246, 0);
    callDigimonSubroutine(214);
    callSubroutine(7);
    return;
L_01c8:
    setTexboxMode(1, 0);
    setDialogOwner(Entity.System);
    showTextbox("<YELLOW>Slot Game <WHITE>\nUse <LIGHTBLUE><X> <WHITE>\nto match three pictures.\n");
    setPStat(254, 2);
    setPStat(246, 1);
    callDigimonSubroutine(214);
    callSubroutine(7);
    setTexboxMode(0, 0);
    return;
}
