// source: extract/DIGIMON/SCN/DG.SCN
// DG108.SCN, section 84

section section_84(84) {  // len=646
    rotate(entity: Entity.Player, to: 2048);
    setTextboxOrigin(-789, 0, -875);
    callSubroutine(39);
    if (!trigger(219)) goto L_0070;
    setDialogOwner(200);
    showTextbox("<GREEN>Training: Punching Glove,\nrevision <WHITE>\n");
    goto L_00ae;
L_0070:
    setDialogOwner(200);
    showTextbox("<GREEN>Training: Punching Glove <WHITE>\n");
L_00ae:
    setSelection(L_00e4, L_0122, L_01fa);
    showTextbox("Begin\nExplain\nQuit\n");
    waitForSelectionChoice();
    return;
L_00e4:
    setDialogOwner(200);
    setSelection(L_01fc, L_020c, L_01fa);
    showTextbox("Normal\nBonus Try\nQuit\n");
    waitForSelectionChoice();
    return;
L_0122:
    setDialogOwner(200);
    showTextbox("Gain strength with punching\nmachine. Boosts Defensive\nPower and Brains.\n");
    setSelection(L_0122, L_00e4, L_01fa);
    showTextbox("Explain again\nBegin\nQuit\n");
    waitForSelectionChoice();
    return;
L_01fa:
    return;
L_01fc:
    fadeOutHUD();
    setPStat(254, 3);
    setPStat(246, 0);
    callDigimonSubroutine(214);
    callSubroutine(7);
    return;
L_020c:
    setTexboxMode(1, 0);
    setDialogOwner(Entity.System);
    showTextbox("<YELLOW>Slot Game <WHITE>\nUse <LIGHTBLUE><X> <WHITE>\nto match three pictures.\n");
    setPStat(254, 3);
    setPStat(246, 1);
    callDigimonSubroutine(214);
    callSubroutine(7);
    setTexboxMode(0, 0);
    return;
}
