// source: extract/DIGIMON/SCN/DG.SCN
// DG108.SCN, section 82

section section_82(82) {  // len=604
    rotate(entity: Entity.Player, to: 2048);
    setTextboxOrigin(1432, 0, 1276);
    callSubroutine(39);
    if (!trigger(219)) goto L_0066;
    setDialogOwner(200);
    showTextbox("<GREEN>Training:\nWaterfall, revision <WHITE>\n");
    goto L_009a;
L_0066:
    setDialogOwner(200);
    showTextbox("<GREEN>Training: Waterfall <WHITE>\n");
L_009a:
    setSelection(L_00d0, L_010e, L_01d0);
    showTextbox("Begin\nExplain\nQuit\n");
    waitForSelectionChoice();
    return;
L_00d0:
    setDialogOwner(200);
    setSelection(L_01d2, L_01e2, L_01d0);
    showTextbox("Normal\nBonus Try\nQuit\n");
    waitForSelectionChoice();
    return;
L_010e:
    setDialogOwner(200);
    showTextbox("Get hit by Waterfall.\nBoosts maximum MP\nand Defensive Power.\n");
    setSelection(L_010e, L_00d0, L_01d0);
    showTextbox("Explain again\nBegin\nQuit\n");
    waitForSelectionChoice();
    return;
L_01d0:
    return;
L_01d2:
    fadeOutHUD();
    setPStat(254, 4);
    setPStat(246, 0);
    callDigimonSubroutine(214);
    callSubroutine(7);
    return;
L_01e2:
    setTexboxMode(1, 0);
    setDialogOwner(Entity.System);
    showTextbox("<YELLOW>Slot Game <WHITE>\nUse <LIGHTBLUE><X> <WHITE>\nto match three pictures.\n");
    setPStat(254, 4);
    setPStat(246, 1);
    callDigimonSubroutine(214);
    callSubroutine(7);
    setTexboxMode(0, 0);
    return;
}
