// source: extract/DIGIMON/SCN/DG.SCN
// DG108.SCN, section 5

section section_5(5) {  // len=3520
    if (pstat[1] < 40) goto L_0106;
    setDialogOwner(5);
    showTextbox("Hey, here's new info.\n");
    showTextbox("For Fresh or In-Training\nDigimon, try to repeat\nthe same training.\n");
    showTextbox("Something good will happen.\n");
    return;
L_0106:
    if (pstat[1] < 20) goto L_01e2;
    setDialogOwner(5);
    showTextbox("Here's new info.\n");
    showTextbox("For Bonus try, if you line\nup the same pictures, his\nability is boosted greatly.\n");
    return;
L_01e2:
    if (pstat[1] < 5) goto L_05ca;
    setDialogOwner(5);
    showTextbox("Oh, I was supposed to\ntalk about Techniques.\n");
    showTextbox("Techniques that an enemy\nuses can be mastered\nif you win a battle.\n");
    showTextbox("But Techniques are limited\nto those which can be\nadded at that time.\n");
    showTextbox("You can't master everything.\nBut battling is the fastest\nway to master Techniques.\n");
    showTextbox("You can also master them thru\ntraining, but chances are low.\n");
    showTextbox("When you get smarter, take\n<LIGHTBLUE><PLAYER><WHITE>'s classroom and you\nmay learn a Technique.\n");
    showTextbox("Chances of you learning are\nlow, so don't expect too much.\nTrain with balance!\n");
    return;
L_05ca:
    setDialogOwner(5);
    showTextbox("Hey, I'm Koromon.\nJiji told me to tell you\nabout training.\n");
    showTextbox("Wanna ask me something?\n");
    setDialogOwner(Entity.Player);
    setSelection(L_06f0, L_08de, L_0d62);
    showTextbox("What training?\nTeach me how to train\nNo, nothing\n");
    waitForSelectionChoice();
    goto L_0d62;
L_06f0:
    setDialogOwner(5);
    showTextbox("If you train here,\nyou can boost your\nDigimon's abilities.\n");
    showTextbox("Training makes you tired,\nbut you'll get more out of\nit than actual battle.\n");
    showTextbox("Also, though very rare, you\ncan master new Techniques.\n");
    showTextbox("I'll tell you more about\nTechniques next time.\n");
    return;
L_08de:
    setDialogOwner(5);
    showTextbox("There are six training\nstations here and they\nhave signs near by.\n");
    setDialogOwner(5);
    showTextbox("Try pushing <LIGHTBLUE><X> <WHITE>\nin front of the sign.\n");
    showTextbox("Read the signs, and you'll\nknow which abilities\nyou can boost.\n");
    showTextbox("Depending on your Digimon's\nSpecialty, some abilities are\nboosted more than others.\n");
    showTextbox("You won't know for sure\nuntil you try though.\n");
    showTextbox("After 'Begin'\nchoose 'Normal' and\ntrain for one hour.\n");
    showTextbox("While training, with\n<GREEN><TRIANGLE> <WHITE>you can\nfast forward time.\n");
    showTextbox("Oh yeah, I have to tell you\nabout 'Bonus Try'.\n");
    showTextbox("If successful, Bonus Try\ngreatly boosts your power,\nbut little if you fail.\n");
    showTextbox("Try it once and you'll see.\n");
    return;
L_0d62:
    setDialogOwner(5);
    showTextbox("Well, I'll get more new\ninfo for you soon.\n");
    return;
}
