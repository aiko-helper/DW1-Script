// source: extract/DIGIMON/SCN/DG.SCN
// DG108.SCN, section 83

section section_83(83) {  // len=632
    rotate(entity: Entity.Player, to: 2048);
    setTextboxOrigin(-506, 0, -1937);
    callSubroutine(39);
    if (!trigger(219)) goto L_006a;
    setDialogOwner(200);
    showTextbox("<GREEN>Training:\nTree Striking, revise <WHITE>\n");
    goto L_00a6;
L_006a:
    setDialogOwner(200);
    showTextbox("<GREEN>Training: Tree Striking <WHITE>\n");
L_00a6:
    setSelection(L_00dc, L_011a, L_01ee);
    showTextbox("Begin\nExplain\nQuit\n");
    waitForSelectionChoice();
    return;
L_00dc:
    setDialogOwner(200);
    setSelection(L_01f0, L_0200, L_01ee);
    showTextbox("Normal\nBonus Try\nQuit\n");
    waitForSelectionChoice();
    return;
L_011a:
    setDialogOwner(200);
    showTextbox("Strike a tree for practice.\nGreatly boosts Offensive\nPower and Speed.\n");
    setSelection(L_011a, L_00dc, L_01ee);
    showTextbox("Explain again\nBegin\nQuit\n");
    waitForSelectionChoice();
    return;
L_01ee:
    return;
L_01f0:
    fadeOutHUD();
    setPStat(254, 1);
    setPStat(246, 0);
    callDigimonSubroutine(214);
    callSubroutine(7);
    return;
L_0200:
    setTexboxMode(1, 0);
    setDialogOwner(Entity.System);
    showTextbox("<YELLOW>Slot Game <WHITE>\nUse <LIGHTBLUE><X> <WHITE>\nto match three pictures\n");
    setPStat(254, 1);
    setPStat(246, 1);
    callDigimonSubroutine(214);
    callSubroutine(7);
    setTexboxMode(0, 0);
    return;
}
