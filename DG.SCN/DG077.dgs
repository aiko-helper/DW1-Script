// DG077.SCN
#pragma script index=77 start=0x37000 end=0x37800 headerU16=0x20 sentinelOff=0x24

section onEnter(254) {
    roll(pstat: 110, max: 99);
    if (pstat[110] > 14) goto L1;
    spawnItem(Item.Digimushroom, x: 30, y: 89);

L1:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 8) goto L2;
    spawnItem(Item.Digimushroom, x: 55, y: 61);

L2:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 13) goto L3;
    spawnItem(Item.Digimushroom, x: 26, y: 52);

L3:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 2) goto L4;
    spawnItem(Item.RedBerry, x: 44, y: 17);

L4:
    return;
}

section(5) {
    speak(5, "Give me your best shot!\n");
    startBattle();
    setTrigger(288);
    return;
}

section(6) {
    speak(6, "Boom, boom, boom!\n");
    startBattle();
    setTrigger(267);
    return;
}

section(7) {
    speak(7, "Don't stand behind me.\n");
    startBattle();
    setTrigger(288);
    return;
}

section(8) {
    speak(8, "Shuwaaaa!\n");
    startBattle();
    setTrigger(267);
    return;
}

section(9) {
    speak(9, "I'm burning, I'm boiling!\n");
    startBattle();
    setTrigger(267);
    return;
}

section(10) {
    speak(10, "Win! Win! Win! I will win!\n");
    startBattle();
    setTrigger(267);
    return;
