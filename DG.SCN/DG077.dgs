// DG077.SCN
#include "functions.dgs"
#pragma script index=77 start=0x35000 end=0x35800 headerU16=0x24 sentinelOff=0x1e
#include "entities.dgs"

section onEnter(254) {
  setPStat(PStat(254), 1);
  callSubroutine(25);
  return;
}

section(5) {
  speak(Entity(5), "「お命…もらいまっせ。」<NEWLINE>");
  finishEncounter(Trigger(268));
}

section(6) {
  speak(Entity(6), "「死にに来はりましたん?」<NEWLINE>");
  finishEncounter(Trigger(268));
}

section(7) {
  speak(Entity(7), "「ひょう、やってくれるぜ!」<NEWLINE>");
  finishEncounter(Trigger(306));
}

section(8) {
  speak(Entity(8), "「フッ、そんなに死にたいか?」<NEWLINE>");
  finishEncounter(Trigger(301));
}

section(9) {
  speak(Entity(9), "「オマエには消えてもらう…」<NEWLINE>");
  finishEncounter(Trigger(301));
}

section(10) {
  speak(Entity(10), "「ちょっと、そこどいておくんなはれ。」<NEWLINE>");
  finishEncounter(Trigger(268));
}

section(51) {
  if (trigger(188)) {
    return;
  }
  anim(Entity.Player, Animation(24), wait: 20);
  speak(Entity.Player, "「うっわ、こりゃたしかに<NEWLINE> 時代がちがうって感じだ。」<NEWLINE>");
  playAnimation(Entity.Player, Animation(0));
  showTextbox("「…と、いけね!<NEWLINE> ぼやぼやしてらんないんだ。<NEWLINE> いん石、いん石っと。」<NEWLINE>");
  setTrigger(Trigger(188));
  return;
