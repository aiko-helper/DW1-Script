section section_85(85) {  // len=1648
    rotate(entity: Entity.Player, to: 2560);
    setTextboxOrigin(766, 0, 106);
    callSubroutine(39);
    setDialogOwner(200);
    showTextbox("<GREEN>Training: \nSavanna Course <WHITE>\n");
    setSelection(L_0084, L_00c2, L_01ae);
    showTextbox("Begin\nExplain\nQuit\n");
    waitForSelectionChoice();
    return;
L_0084:
    setDialogOwner(200);
    setSelection(L_01b0, L_01c0, L_01ae);
    showTextbox("Normal\nBonus Try\nQuit\n");
    waitForSelectionChoice();
    return;
L_00c2:
    setDialogOwner(200);
    showTextbox("Run around Savanna Course.\n");
    showTextbox("This will boost Speed greatly\nand boost Max HP also.\n");
    setSelection(L_00c2, L_0084, L_01ae);
    showTextbox("Explain again\nBegin\nQuit\n");
    waitForSelectionChoice();
    return;
L_01ae:
    return;
L_01b0:
    fadeOutHUD();
    setPStat(254, 2);
    setPStat(246, 0);
    callDigimonSubroutine(214);
    callSubroutine(7);
    return;
L_01c0:
    setTexboxMode(1, 0);
    setDialogOwner(Entity.System);
    showTextbox("<YELLOW>Slot Game <WHITE>\nUse <LIGHTBLUE><X> <WHITE>to\nmatch three pictures.\n");
    setPStat(254, 2);
    setPStat(246, 1);
    callDigimonSubroutine(214);
    callSubroutine(7);
    setTexboxMode(0, 0);
    return;
