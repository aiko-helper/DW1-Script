onEnter:     ; len=68
  0000:  storeRandom 110 99
  0004:  if pstat[110] > 8 then onEnter+0x16
  0010:  spawnItem 44 33 39
  0016:  storeRandom 110 99
  001a:  if pstat[110] > 16 then onEnter+0x2c
  0026:  spawnItem 44 33 22
  002c:  storeRandom 110 99
  0030:  if pstat[110] > 2 then onEnter+0x42
  003c:  spawnItem 52 52 35
  0042:  endSection
