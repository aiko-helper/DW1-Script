// source: extract/DIGIMON/SCN/DG.SCN
// DG075.SCN, section 83

section section_83(83) {  // len=586
    rotate(entity: Entity.Player, to: 2048);
    setTextboxOrigin(-829, 0, 4099);
    callSubroutine(39);
    setDialogOwner(200);
    showTextbox("<GREEN>Training:\nStriking Special <WHITE>\n");
    setSelection(L_0086, L_00c4, L_01c0);
    showTextbox("Begin\nExplain\nQuit\n");
    waitForSelectionChoice();
    return;
L_0086:
    setDialogOwner(200);
    setSelection(L_01c2, L_01d2, L_01c0);
    showTextbox("Normal\nBonus Try\nQuit\n");
    waitForSelectionChoice();
    return;
L_00c4:
    setDialogOwner(200);
    showTextbox("Using a concrete bag,\nstrike at full force.\n");
    showTextbox("This will boost Offensive\nPower and Max HP.\n");
    setSelection(L_00c4, L_0086, L_01c0);
    showTextbox("Explain again\nBegin\nQuit\n");
    waitForSelectionChoice();
    return;
L_01c0:
    return;
L_01c2:
    fadeOutHUD();
    setPStat(254, 1);
    setPStat(246, 0);
    callDigimonSubroutine(214);
    callSubroutine(7);
    return;
L_01d2:
    setTexboxMode(1, 0);
    setDialogOwner(Entity.System);
    showTextbox("<YELLOW>Slot Game <WHITE>\nUse <LIGHTBLUE><X> <WHITE>to\nmatch three pictures.\n");
    setPStat(254, 1);
    setPStat(246, 1);
    callDigimonSubroutine(214);
    callSubroutine(7);
    setTexboxMode(0, 0);
    return;
}
