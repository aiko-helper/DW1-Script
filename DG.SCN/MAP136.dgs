section onEnter(254) {
  if (trigger(224)) {
    setObjectsVisibleRange(105, 109, 1);
    setObjectsVisibleRange(39, 56, 1);
    setObjectsVisibleRange(24, 28, 0);
  }
  if (trigger(224)) {
    move(entity: Entity(5), to: (1457, 2916), animDuration: 2);
    delay(10);
  }
  return;
}

section(61) {
