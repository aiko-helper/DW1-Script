section(81) {
  {
    speak(Entity(5), "Going back to the city?\n");
    setDialogOwner(Entity.Player);
    choice { "I'm going back" -> L1, "I'm not" -> L_0168 }
    break;

L1:
    if (!trigger(203)) {
      warp(to: Map.TWNA01, spawn: 0, trigger: 255);
    }
    if (trigger(220) || trigger(214) || pstat[1] >= 50) {
      goto L5;
      goto L2;
    }
    goto L2;

L2:
    if (trigger(221)) {
      goto L4;
      goto L3;
    }
    goto L3;

L3:
    if (trigger(225)) {
      warp(to: Map.TWNA04, spawn: 0, trigger: 255);
    }
    if (trigger(246)) {
      warp(to: Map.TWNA03, spawn: 0, trigger: 255);
    }
    warp(to: Map.TWNA02, spawn: 0, trigger: 255);

