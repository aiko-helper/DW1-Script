// DG024.SCN
#pragma script index=24 start=0x17000 end=0x17800 headerU16=0x2c sentinelOff=0x24

function speakThenStartBattleThenSetTrigger(a, b, c) {
    speak(a, b);
    startBattle();
    setTrigger(c);
}


section onEnter(254) {  // len=68
    roll(pstat: 110, max: 99);
    if (pstat[110] > 7) goto L1;
    spawnItem(Item.Digimushroom, x: 44, y: 33);

L1:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 15) goto L2;
    spawnItem(Item.Digimushroom, x: 23, y: 49);

L2:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 3) goto L3;
    spawnItem(Item.BigBerry, x: 25, y: 74);

L3:
    return;
}

section(5) {  // len=50
    speakThenStartBattleThenSetTrigger(5, "Hot! It's hot!\n", 269);
    return;
}

section(6) {  // len=60
    speakThenStartBattleThenSetTrigger(6, "It started boiling!\n", 269);
    return;
}

section(7) {  // len=42
    speakThenStartBattleThenSetTrigger(7, "Oh, I see.\n", 286);
    return;
}

section(8) {  // len=56
    speakThenStartBattleThenSetTrigger(8, "Alright, come on!\n", 286);
    return;
}

section(9) {  // len=54
    speakThenStartBattleThenSetTrigger(9, "I've had enough!\n", 296);
    return;
}

section(10) {  // len=42
    speakThenStartBattleThenSetTrigger(10, "No thanks!\n", 296);
    return;
}

section(11) {  // len=32
    speakThenStartBattleThenSetTrigger(11, "What?\n", 280);
    return;
}

section(12) {  // len=34
    speakThenStartBattleThenSetTrigger(12, "Mmmmm!\n", 280);
    return;
}

section(51) {  // len=1566
    if (!trigger(150) || trigger(234)) goto L1;
    speak(Entity.Player, "I got bad feeling.\n");
    look(entity: Entity.Player, at: Entity.Partner);
    look(entity: Entity.Partner, at: Entity.Player);
    delay(5);
    speak(Entity.Player, "You too? I thought so.\n");
    move(entity: Entity.Player, to: (1745, -1614), sprint: 0);
    waitForEntity(Entity.Player);
    return;

L1:
    if (!trigger(238)) goto L2;
    if (trigger(150) && !trigger(234)) goto L2;
    speak(Entity.Player, "There's nothing in the\ntunnel. Should we go thru?\n");
    choice { "Go" -> L3, "Don't go" -> L4 }
    goto L4;

L2:
    return;

L3:
    move(entity: Entity.Player, to: (2876, -1583), sprint: 1);
    warp(to: Map.MAYO11, spawn: 1, trigger: 255);

L4:
    move(entity: Entity.Player, to: (2876, -1583), sprint: 0);
    warp(to: Map.TUNN09, spawn: 1, trigger: 255);
    return;
    garbage { 2c 00 fe 00 2c 00 05 00 70 00 06 00 a2 00 07 00 de 00 08 00 08 01 09 00 40 01 0a 00 76 01 0b 00 a0 01 0c 00 c0 01 33 00 e2 01 ff ff 24 00 6e 63 19 00 0b 00 6e 07 18 00 42 00 19 00 74 2c 2c 00 21 00 24 00 6e 63 19 00 0b 00 6e 0f 18 00 58 00 19 00 74 2c 17 00 31 00 24 00 6e 63 19 00 0b 00 6e 03 18 00 6e 00 19 00 74 33 19 00 4a 00 fe 00 1b 05 1a 00 82 67 82 8f 82 94 81 49 81 40 82 68 82 94 81 75 82 93 81 40 82 88 82 8f 82 94 81 49 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 0d 01 fe 00 1b 06 1a 00 82 68 82 94 81 40 82 93 82 94 82 81 82 92 82 94 82 85 82 84 81 40 82 82 82 8f 82 89 82 8c 82 89 82 8e 82 87 81 49 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 0d 01 fe 00 1b 07 1a 00 82 6e 82 88 81 43 81 40 82 68 81 40 82 93 82 85 82 85 81 42 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 1e 01 fe 00 1b 08 1a 00 82 60 82 8c 82 92 82 89 82 87 82 88 82 94 81 43 81 40 82 83 82 8f 82 8d 82 85 81 40 82 8f 82 8e 81 49 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 1e 01 fe 00 1b 09 1a 00 82 68 81 75 82 96 82 85 81 40 82 88 82 81 82 84 81 40 82 85 82 8e 82 8f 82 95 82 87 82 88 81 49 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 28 01 fe 00 1b 0a 1a 00 82 6d 82 8f 81 40 82 94 82 88 82 81 82 8e 82 8b 82 93 81 49 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 28 01 fe 00 1b 0b 1a 00 82 76 82 88 82 81 82 94 81 48 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 18 01 fe 00 1b 0c 1a 00 82 6c 82 8d 82 8d 82 8d 82 8d 81 49 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 18 01 fe 00 19 00 00 00 96 00 81 00 ea 00 18 00 6a 02 19 00 1b fd 1a 00 82 68 81 40 82 87 82 8f 82 94 81 40 82 82 82 81 82 84 81 40 82 86 82 85 82 85 82 8c 82 89 82 8e 82 87 81 42 0d 00 00 00 4c 00 fd fc 4c 00 fc fd 67 00 05 00 1b fd 1a 00 82 78 82 8f 82 95 81 40 82 94 82 8f 82 8f 81 48 81 40 82 68 81 40 82 94 82 88 82 8f 82 95 82 87 82 88 82 94 81 40 82 93 82 8f 81 42 0d 00 00 00 4e fd d1 06 b2 f9 00 00 4a fd fe 00 19 00 00 00 ee 00 18 00 18 03 19 00 19 00 01 00 96 00 40 00 ea 00 18 00 18 03 19 00 1b fd 1a 00 82 73 82 88 82 85 82 92 82 85 81 75 