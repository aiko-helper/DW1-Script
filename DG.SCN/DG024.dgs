// DG024.SCN
#include "functions.dgs"
#pragma script index=24 start=0x16000 end=0x16800 headerU16=0x14 sentinelOff=0x1a64
#include "entities.dgs"

section onEnter(254) {
  callSubroutine(26);
  switch pstat[17] {
    3 => {
      setPStat(PStat(254), 0);
      callSubroutine(19);
      setAutotalk(Entity(5), 0);
    }
    4 => {
      setPStat(PStat(254), 1);
      callSubroutine(19);
      setAutotalk(Entity(5), 0);
    }
  }
  return;
}

section(5) {
  if (pstat[17] >= 3) {
    speak(Entity(5), "「そら、がんばれ!」<NEWLINE>");
    return;
  }
  speak(Entity(5), "「おめぇ、よそもんだな!」<NEWLINE>");
  finishEncounter(Trigger(280));
}

section(51) {
  if (pstat[17] == 3) {
    move(entity: Entity.Partner, to: Entity.Player, sprint: 1);
    waitForEntity(Entity.Partner);
    move(entity: Entity.Partner, to: (1200, 1583), sprint: 0);
    waitForEntity(Entity.Partner);
    speak(Entity.System, "土を捨てた<NEWLINE>");
    setPStat(PStat(254), 1);
    callSubroutine(19);
    move(entity: Entity.Partner, to: Entity.Player, sprint: 1);
    setPStat(PStat(17), 4);
  }
  return;
}

section(52) {
  if (pstat[17] == 4) {
    speak(Entity.Player, "「おっと、土箱をドリモゲモンに<NEWLINE> 返さなきゃ!」<NEWLINE>");
    move(entity: Entity.Player, to: (453, 1815), sprint: 1);
    waitForEntity(Entity.Player);
    followEntity(Entity.Player, speed: 10);
  }
  return;
