// DG021.SCN
#pragma script index=21 start=0x15000 end=0x15800 headerU16=0x1c sentinelOff=0x24
#pragma sections section_0254 section_0005 section_0006 section_0007 section_0008 section_0051

section onEnter(254) {  // len=68
    roll(pstat: 110, max: 99);
    if (pstat[110] > 6) goto L_0016;
    spawnItem(Item.Digimushroom, 52, 26);
L_0016:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 14) goto L_002c;
    spawnItem(Item.Digimushroom, 40, 61);
L_002c:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 1) goto L_0042;
    spawnItem(Item.DeluxeMushroom, 64, 61);
L_0042:
    return;
}
