; DG021.SCN
;!script index=21 start=0x15000 end=0x15800 headerU16=0x1c sentinelOff=0x24
;!sections onEnter section_5 section_6 section_7 section_8 section_51

onEnter:     ; len=68
  0000:  storeRandom 110 99
  0004:  if pstat[110] > 6 then onEnter+0x16
  0010:  spawnItem Digimushroom 52 26
  0016:  storeRandom 110 99
  001a:  if pstat[110] > 14 then onEnter+0x2c
  0026:  spawnItem Digimushroom 40 61
  002c:  storeRandom 110 99
  0030:  if pstat[110] > 1 then onEnter+0x42
  003c:  spawnItem DeluxeMushroom 64 61
  0042:  endSection
