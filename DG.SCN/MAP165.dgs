// MAP165.SCN
#include "functions.dgs"
#pragma script index=165 start=0x79800 end=0x7a800 headerU16=0x30 sentinelOff=0xfe

section onEnter(254) {
    return;
}

section(54) {
    jumpToScriptSection(193, 55);
    return;
}

section(5) {
    if (trigger(202) || trigger(215) || pstat[16] == 0) goto L1;
    if (!trigger(201) || !trigger(243)) goto L1;
    speak(5, "You came here at the perfect\ntime! I have a big favor to\nask that only you can do.\n");
    speak(Entity.Player, "What is it?\n");
    speak(5, "It's the same evil\nI felt from Analogman\nand Machinedramon.\n");
    showTextbox("But I can't tell\nwhere it's coming from.\n");
    speak(Entity.Player, "Alright, leave it to me!\n");
    speak(5, "Thank you. By the way...\n");
    goto L5;

L1:
    if (!trigger(202) || trigger(215)) goto L4;
    speak(5, "I heard that you\nbeat Machinedramon!\n");
    speak(Entity.Player, "Yeah, but I don't get it.\nIt seemed like the\ncurse of Analogman.\n");
    speak(5, "His grudge was so strong.\nMaybe we can have peace now.\n");
    speak(Entity.Player, "If Machinedramon returns,\nwe can beat him again.\n");
    speak(5, "You are trustworthy. Here's\na sign of my gratitude.\nIt grew in our Meat farm.\n");
    speak(Entity.Player, "Woah! A <LIGHTBLUE>Chained\nMelon<WHITE>?\n");
    giveItem(Item.ChainMelon, 1);
    if (!trigger(0)) goto L3;
    if (item[Item.SpikeClub] < 99) goto L2;
    return;

L2:
    speak(Entity.Player, "I have too many Items.\n");
    setTrigger(3);
    callSubroutine(0);
    callSubroutine(13);
    giveItem(Item.ChainMelon, 1);

L3:
    speak(Entity.Player, "I gladly accept, thank you!\n");
    setPStat(28, 0);
    setTrigger(215);
    return;

L4:
    if (!trigger(50) || trigger(201)) goto L5;
    speak(5, "Oh, you're back!\nThis is something I can't\nask anybody else.\n");
    speak(Entity.Player, "Okay. Do you mean\nAnalogman is back?\n");
    speak(5, "I felt his evil, but\nI can't tell where it is.\n");
    speak(Entity.Player, "Alright, leave it to me!\nI'll go find him and\ntake care of it.\n");
    speak(5, "Oh, thank you. By the way...\n");
    setTrigger(201);

L5:
    if (!trigger(203)) goto L6;
    jumpToScriptSection(210, 51);

L6:
    return;
}

section(6) {
    jumpToScriptSection(211, 8);
    return;
}

section(20) {
    moveCamera(to: (183, 221), slowdown: 20);
    waitForEntity(200);
    delay(20);
    addStats(currentHP: 9999, currentMP: 9999);
    unsetTrigger(1);
    playAnimation(5, 29);
    delay(5);
    speak(5, "You woke up. I'm so sorry.\n");
    playAnimation(5, 0);
    return;
}

section(71) {
    jumpToScriptSection(212, 71);
    return;
}

section(72) {
    jumpToScriptSection(212, 72);
    return;
}

section(73) {
    jumpToScriptSection(212, 73);
    return;
}

section(85) {
    if (trigger(94)) goto L1;
    setTrigger(94);
    speak(Entity.Player, "What's this machine?\n");
    look(entity: 5, at: Entity.Player);
    look(entity: Entity.Player, at: 5);
    delay(5);
    speak(5, "That's a <PINK>Save Machine\nfor Memory Card Battle\nData<WHITE>.\n");
    showTextbox("Using that machine, you can\nsave your current partner's\ndata for battle.\n");
    showTextbox("All you have to do is press\n<LIGHTBLUE><X> <WHITE>and the machine\nwill tell you what to do.\n");
    rotate(entity: Entity.Player, to: 0);
    delay(5);
    return;

L1:
    speak(Entity.System, "Do you want to use the\n<PINK>Save Machine for\nMemory Card Battle<WHITE>?\n");
    choice { "Yes" -> L2, "No" -> L3 }
    return;

L2:
    fadeOutHUD();
    callSubroutine(48);
    return;

L3:
    return;
}

section(7) {
    if (trigger(224) || !trigger(175)) goto L1;
    speak(7, "Sounds like Yuramon has\ngathered more rumors.\n");
    return;

L1:
    if (!trigger(124) || !trigger(103)) goto L2;
    speak(7, "I heard Yuramon\nknows some new rumors.\n");
    return;

L2:
    if (pstat[1] < 6) goto L3;
    speak(7, "The city's starting to\ngrow and change\nnow that we're here.\n");
    return;

L3:
    speak(7, "<LIGHTBLUE><PLAYER><WHITE>, you have a\nway different\napproach to adventure.\n");
    return;
}

section(51) {
    move(entity: Entity.Player, to: (-470, -1970), sprint: 0);
    if (trigger(203)) goto L1;
    warp(to: Map.TWNA01, spawn: 2, trigger: 255);

L1:
    if (!trigger(220) && !trigger(214) && pstat[1] < 50) goto L2;
    goto L11;
    goto L3;

