section section_20(20) {  // len=98
    moveCamera(to: (183, 221), slowdown: 20);
    waitForEntity(200);
    delay(20);
    addStats(Stat.CurrentHP, 9999);
    addStats(Stat.CurrentMP, 9999);
    unsetTrigger(1);
    playAnimation(5, 29);
    delay(5);
    setDialogOwner(5);
    showTextbox("You woke up. I'm so sorry.\n");
    playAnimation(5, 0);
    return;
}

