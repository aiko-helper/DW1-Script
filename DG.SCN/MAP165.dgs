// MAP165.SCN
#include "functions.dgs"
#pragma script index=165 start=0x73000 end=0x73800 headerU16=0x28 sentinelOff=0x2875
#include "entities.dgs"

section onEnter(254) {
  spawnChest(Item.Sirloin, 3758, 1159, 1024, 686);
  if (!trigger(321)) {
    playAnimation(Entity(10), Animation(28));
    return;
  }
  return;
}

section(51) {
  move(entity: Entity.Player, to: (3588, 1931), sprint: 0);
  warp(to: Map.MGEN07, spawn: 1, trigger: 255);
  return;
}

section(52) {
  move(entity: Entity.Player, to: (-4289, 1108), sprint: 0);
  warp(to: Map.MGEN05, spawn: 1, trigger: 255);
  return;
}

section(5) {
  speak(Entity(5), "「どぉぉりゃぁぁ~!」<NEWLINE>");
  finishEncounter(Trigger(288));
}

section(6) {
  speak(Entity(6), "「くいあらためましょう。」<NEWLINE>");
  finishEncounter(Trigger(285));
}

section(7) {
  speak(Entity(7), "「かみさまは、ウソをつきません。」<NEWLINE>");
  finishEncounter(Trigger(285));
}

section(8) {
  speak(Entity(8), "「ええい!きさま、ばけものか!?」<NEWLINE>");
  finishEncounter(Trigger(288));
}

section(9) {
  speak(Entity(9), "「私にしたがいなさい。さすれば…」<NEWLINE>");
  finishEncounter(Trigger(285));
}

section(53) {
  if (trigger(321)) {
    return;
  }
  {
    speak(Entity(10), "「ふははははははは!」<NEWLINE>");
    playAnimation(Entity(10), Animation(28));
    move(entity: Entity(10), axis: 1, to: 0, speed: 20);
    delay(60);
    speak(Entity.Player, "「おまえは!」<NEWLINE>");
    speak(Entity(10), "「だまってあの世にいくんだな!」<NEWLINE>");
    setTrigger(Trigger(1));
    setPStat(PStat(250), 1);
    setPStat(PStat(251), 10);
    setPStat(PStat(252), 255);
    setPStat(PStat(253), 255);
    startBattle();
    unsetTrigger(Trigger(1));
    setPStat(PStat(250), 0);
    look(entity: Entity.Player, at: Entity(10));
    look(entity: Entity(10), at: Entity.Player);
    look(entity: Entity.Partner, at: Entity(10));
    speak(Entity(10), "「く…俺としたことが、あんなヤツに操られて<NEWLINE> いたとは…ヤキがまわったぜ!」<NEWLINE>");
    speak(Entity(10), "「しかし…ヤツは強い。おまえはヤツを倒せる<NEWLINE> というのか?なんのためにそこまでする?」<NEWLINE>");
    speak(Entity.Player, "「決着をつける…それで島は元に戻るはず。<NEWLINE> 全てのデジモンのため、ファイル島のため、<NEWLINE> 俺は戦うんだ。」<NEWLINE>");
    speak(Entity(10), "「ふん、たしかに誰かに支配されるのは<NEWLINE> まっぴらだ。あまり期待せずに待ってて<NEWLINE> やろうじゃないか。ククク…」<NEWLINE>");
    break;
  }
  loop {
    playAnimation(Entity(10), Animation(28));
    move(entity: Entity(10), to: (-4562, 41), animDuration: 20);
    if (pstat[101] >= 3) break;
    addPStat(PStat.LoopIterator, 1);
    delay(20);
    lookPairAt(Entity(10));
  }
  waitForEntity(Entity(10));
  unloadEntity(Entity(10));
  setPStat(PStat.LoopIterator, 0);
  followEntity(Entity.Player, speed: 10);
  setTrigger(Trigger(321));
  return;
  garbage { 28 00 fe 00 28 00 33 00 48 00 34 00 56 00 05 00 64 00 06 00 90 00 07 00 c0 00 08 00 f8 00 09 00 30 01 35 00 68 01 ff ff 75 28 ae 0e 00 00 87 04 00 04 ae 02 19 00 01 00 41 01 18 00 46 00 19 00 56 00 0a 1c fe 00 fe 00 4e fd 04 0e 8b 07 00 00 4b f8 01 ff fe 00 4e fd 3f ef 54 04 00 00 4b db 01 ff fe 00 1b 05 1a 00 81 75 82 c7 82 a7 82 a7 82 e8 82 e1 82 9f 82 9f 81 60 81 49 81 76 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 20 01 fe 00 1b 06 1a 00 81 75 82 ad 82 a2 82 a0 82 e7 82 bd 82 df 82 dc 82 b5 82 e5 82 a4 81 42 81 76 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 1d 01 fe 00 1b 07 1a 00 81 75 82 a9 82 dd 82 b3 82 dc 82 cd 81 41 83 45 83 5c 82 f0 82 c2 82 ab 82 dc 82 b9 82 f1 81 42 81 76 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 1d 01 fe 00 1b 08 1a 00 81 75 82 a6 82 a6 82 a2 81 49 82 ab 82 b3 82 dc 81 41 82 ce 82 af 82 e0 82 cc 82 a9 81 49 81 48 81 76 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 20 01 fe 00 1b 09 1a 00 81 75 8e 84 82 c9 82 b5 82 bd 82 aa 82 a2 82 c8 82 b3 82 a2 81 42 82 b3 82 b7 82 ea 82 ce 81 63 81 76 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 1d 01 fe 00 19 00 00 00 41 01 18 00 76 01 19 00 fe 00 1b 0a 1a 00 81 75 82 d3 82 cd 82 cd 82 cd 82 cd 82 cd 82 cd 82 cd 81 49 81 76 0d 00 00 00 56 00 0a 1c 72 0a 00 00 01 14 67 00 3c 00 1b fd 1a 00 81 75 82 a8 82 dc 82 a6 82 cd 81 49 81 76 0d 00 00 00 1b 0a 1a 00 81 75 82 be 82 dc 82 c1 82 c4 82 a0 82 cc 90 a2 82 c9 82 a2 82 ad 82 f1 82 be 82 c8 81 49 81 76 0d 00 00 00 1c 00 01 00 1e 00 fa 01 1e 00 fb 0a 1e 00 fc ff 1e 00 fd ff 27 00 67 00 01 00 66 00 1d 00 01 00 1e 00 fa 00 4c 00 fd 0a 4c 00 0a fd 4c 00 fc 0a 1b 0a 1a 00 81 75 82 ad 81 63 89 b4 82 c6 82 b5 82 bd 82 b1 82 c6 82 aa 81 41 82 a0 82 f1 82 c8 83 84 83 63 82 c9 91 80 82 e7 82 ea 82 c4 0d 00 81 40 82 a2 82 bd 82 c6 82 cd 81 63 83 84 83 4c 82 aa 82 dc 82 ed 82 c1 82 bd 82 ba 81 49 81 76 0d 00 00 00 1b 0a 1a 00 81 75 82 b5 82 a9 82 b5 81 63 83 84 83 63 82 cd 8b ad 82 a2 81 42 82 a8 82 dc 82 a6 82 cd 83 84 83 63 82 f0 93 7c 82 b9 82 e9 0d 00 81 40 82