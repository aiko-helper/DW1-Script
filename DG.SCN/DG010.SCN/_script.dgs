// DG010.SCN
#pragma script index=10 start=0xd000 end=0xe000 headerU16=0x20 sentinelOff=0x19
#pragma sections section_0254 section_0005 section_0007 section_0055 section_0051 section_0008 section_0052

section onEnter(254) {  // len=110
    if (!trigger(232)) goto L_001c;
    setObjectVisibility(68, 1);
    setObjectVisibility(69, 1);
    setObjectVisibility(70, 1);
    goto L_0024;
L_001c:
    setRectImpassible(22, 16, 3, 12);
L_0024:
    if (!trigger(232) || pstat[1] < 35) goto L_0040;
    setObjectVisibility(71, 0);
    setObjectVisibility(72, 0);
    setObjectVisibility(73, 0);
L_0040:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 39) goto L_0056;
    spawnItem(Item.Digimushroom, 37, 48);
L_0056:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 3) goto L_006c;
    spawnItem(Item.BlueApple, 38, 52);
L_006c:
    return;
}
