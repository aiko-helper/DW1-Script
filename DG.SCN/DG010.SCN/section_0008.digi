; source: ./extract/DIGIMON/SCN/DG.SCN
; DG010.SCN, section 8

section_8:     ; len=956
  0000:  setDialogOwner 8
  0002:  showTextbox "Hey, you!\n"
  001a:  showTextbox "What do you mean?\nWhy are you here?\n"
  0066:  showTextbox "Hey, <LIGHTBLUE><PLAYER><WHITE>!\n"
  007e:  showTextbox "When I tried to make\nmy own harem in the city,\nI was kicked out!\n"
  0104:  if money >= 50000 then section_8+0x116
  0114:  endSection
  0116:  setDialogOwner 8
  0118:  showTextbox "I hear you're doing\nreal good these days.\nI'll sell you something good!\n"
  01ac:  showTextbox "It's the extremely valuable\n<LIGHTBLUE>Golden Banana<WHITE>.\n"
  020a:  showTextbox "That'll be fifty thous bits.\nNo loans, please.\n"
  026c:  setDialogOwner 253
  026e:  setSelection section_8+0x29a section_8+0x378
  0274:  showTextbox "Pay\nDon't pay\n"
  0294:  waitForSelectionChoice
  0296:  jump section_8+0x378
  029a:  reduceMoney 50000
  02a0:  giveItem 109 1
  02a4:  if !trigger(0) then section_8+0x346
  02b0:  if item[109] < 99 then section_8+0x306
  02be:  setDialogOwner 8
  02c0:  showTextbox "You fool! You have too much!\n"
  02fe:  addMoney 50000
  0304:  endSection
  0306:  setDialogOwner 253
  0308:  showTextbox "Oops, I have too much!\n"
  033a:  setTrigger 3
  033e:  callSubroutine 0
  0340:  callSubroutine 13
  0342:  giveItem 109 1
  0346:  setDialogOwner 8
  0348:  showTextbox "Thank you very much!\n"
  0376:  endSection
  0378:  setDialogOwner 8
  037a:  showTextbox "Humans should use live money.\n"
  03ba:  endSection
