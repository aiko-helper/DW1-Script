section section_51(51) {  // len=816
    if (trigger(149)) goto L_0086;
    moveCamera(to: (-5000, 2000), slowdown: 30);
    rotate(entity: Entity.Player, to: 1117);
    waitForEntity(200);
    delay(50);
    setDialogOwner(Entity.Player);
    showTextbox("Drill Tunnel\n");
    moveCamera(to: Entity.Player, speed: 20);
    waitForEntity(200);
    setTrigger(149);
    if (trigger(54)) goto L_0086;
    setDialogOwner(Entity.Player);
    setSelection(L_009c, L_009e);
    showTextbox("Normal\nOgre mode\n");
    waitForSelectionChoice();
    goto L_009c;
L_0086:
    if (!trigger(150) || trigger(151)) goto L_009a;
    goto L_009e;
L_009a:
    return;
L_009c:
    return;
L_009e:
    setTrigger(151);
    setObjectVisibility(5, 1);
    setObjectVisibility(6, 0);
    moveCamera(to: (-5000, 2000), slowdown: 30);
    rotate(entity: Entity.Player, to: 1117);
    waitForEntity(200);
    delay(50);
    setDialogOwner(Entity.Player);
    showTextbox("Oh that jerk! How rude!\n");
    moveCamera(to: (-2900, 0), slowdown: 30);
    waitForEntity(200);
    delay(20);
    setDialogOwner(Entity.Player);
    showTextbox("Huh?\n");
    setDigimon(Digimon.MarketManager, 0, 0);
    move(entity: 5, to: (-2028, -842), sprint: 0);
    rotate(entity: Entity.Player, to: 1117);
    waitForEntity(5);
    rotate(entity: 5, to: 1117);
    waitForEntity(5);
    delay(10);
    setDialogOwner(Entity.System);
    showTextbox("<YELLOW>Market manager <WHITE>\nI didn't know we'd have to\npay to get thru!\n");
    move(entity: 5, to: (-1323, -815), sprint: 0);
    waitForEntity(5);
    look(entity: 5, at: Entity.Player);
    waitForEntity(5);
    moveCamera(to: Entity.Player, speed: 20);
    waitForEntity(200);
    look(entity: Entity.Player, at: 5);
    setDialogOwner(Entity.System);
    showTextbox("<YELLOW>Market manager <WHITE>\nHey, aren't you... yes!\nDo something!\n");
    setDialogOwner(Entity.Player);
    showTextbox("How are the Drimogemon\ninside?\n");
    setDialogOwner(Entity.System);
    showTextbox("<YELLOW>Market manager <WHITE>\nI don't know.\n");
    setDialogOwner(Entity.Player);
    showTextbox("I hope they are alright.\nOkay, here I go!\n");
    move(entity: 5, to: (-2333, 59), sprint: 0);
    waitForEntity(5);
    rotate(entity: 5, to: 4000);
    waitForEntity(5);
    return;
