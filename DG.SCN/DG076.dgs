// DG076.SCN
#include "functions.dgs"
#pragma script index=76 start=0x36000 end=0x37000 headerU16=0x1c sentinelOff=0x24
#include "entities.dgs"

section onEnter(254) {
  roll(pstat: 110, max: 99);
  if (pstat[110] > 9) goto L1;
  spawnItem(Item.Digimushroom, x: 34, y: 56);

L1:
  roll(pstat: 110, max: 99);
  if (pstat[110] > 5) goto L2;
  spawnItem(Item.Digimushroom, x: 37, y: 43);

L2:
  setPStat(254, 2);
  callSubroutine(25);
  return;
}

section(6) {
  speak(6, "Taaa!\n");
  startBattle();
  setTrigger(288);
  return;
}

section(7) {
  speak(7, "Alright, take that!\n");
  startBattle();
  setTrigger(288);
  return;
}

section(8) {
  speak(8, "Shaaaa!\n");
  startBattle();
  setTrigger(267);
  return;
}

section(9) {
  speak(9, "Buooon!\n");
  startBattle();
  setTrigger(267);
  return;
}

section(51) {
  if (trigger(144)) goto L2;
  move(entity: 5, to: (-421, 374), sprint: 1);
  waitForEntity(5);
  look(entity: 5, at: Entity.Player);
  look(entity: Entity.Player, at: 5);
  look(entity: Entity.Partner, at: 5);
  waitForEntity(5);
  playSound(8, 10);
  speak(5, "Who are you? I won't let\nanyone mess up this place!\n");
  playAnimation(Entity.Player, 19);
  delay(15);
  speak(Entity.Player, "Don't worry. We're just\ntravelling through\nto save the island.\n");
  playAnimation(Entity.Player, 0);
  playSound(8, 10);
  speak(5, "I don't trust you, get lost!\n");
  speak(Entity.Player, "Wait a sec.\n");
  setTrigger(1);
  setPStat(250, 1);
  setPStat(251, 5);
  setPStat(252, 255);
  setPStat(253, 255);
  startBattle();
  unsetTrigger(1);
  setPStat(250, 0);
  move(entity: Entity.Player, to: (-97, -448), sprint: 0);
  move(entity: Entity.Partner, to: (-597, -443), sprint: 0);
  move(entity: 5, to: (-421, 374), sprint: 1);
  for x in [Entity.Player, Entity.Partner, 5] {
    waitForEntity(x);
  }
  look(entity: Entity.Player, at: 5);
  look(entity: 5, at: Entity.Player);
  look(entity: Entity.Partner, at: 5);
  speak(5, "Are you by any chance...?\n");
  playAnimation(Entity.Player, 7);
  delay(15);
  speak(Entity.Player, "I told you so!\n");
  playAnimation(Entity.Player, 0);
  speak(5, "I'm sorry. We don't get\nvisitors often, so I get\nexcited about my new job.\n");
  speak(Entity.Player, "Job?\n");
  speak(5, "I'm guarding a place called\nAncient Dino Region.\n");
  showTextbox("It's an unexplored region.\n");
  speak(Entity.Player, "Will you show me around?\n");
  speak(5, "Ancient Dino Region is\ndivided in two sections.\n");
  showTextbox("Where we live is called\nGlacial Time Zone.\n");
  showTextbox("It's a special place\nwhere time goes slow.\n");
  playAnimation(Entity.Player, 16);
  delay(15);
  speak(Entity.Player, "Time goes slow?\n");
  playAnimation(Entity.Player, 0);
  speak(5, "The other place is\nSpeedy Time Zone.\n");
  showTextbox("It's dangerous and further\nthan the Glacial Time Zone.\n");
  showTextbox("It's dangerous cuz\ntime goes very fast.\n");
  showTextbox("The land is bare. Bones\nand fossils everywhere.\n");
  speak(Entity.Player, "That's cuz time passes faster\nthere than in other places?\n");
  speak(5, "Right. Don't stay there long.\n");
  showTextbox("Since I'm blocking your\nway, you can't go there.\n");
  speak(Entity.Player, "You lost.\n");
  playSound(8, 10);
  speak(5, "I was unlucky! It doesn't\nhappen often.\n");
  speak(Entity.Player, "Is that right?\n");
  speak(5, "I have to go back home.\nAsk other Digimon\nif you have questions.\n");
  setTrigger(144);
  goto L1;

L1:
  loop {
    move(entity: 5, to: (-293, 1172), sprint: 1);
    if (pstat[101] >= 3) break;
    addPStat(101, 1);
    delay(20);
    look(entity: Entity.Player, at: 5);
    look(entity: Entity.Partner, at: 5);
  }
  waitForEntity(5);
  unloadEntity(5);
  setPStat(101, 0);
  moveCamera(to: Entity.Player, speed: 10);
  waitForEntity(200);
  return;

L2:
  return;
  garbage { 1c 00 fe 00 1c 00 06 00 50 00 07 00 70 00 08 00 ac 00 09 00 d0 00 33 00 f4 00 ff ff 24 00 6e 63 19 00 0b 00 6e 09 18 00 32 00 19 00 74 2c 22 00 38 00 24 00 6e 63 19 00 0b 00 6e 05 18 00 48 00 19 00 74 2c 25 00 2b 00 1e 00 fe 02 64 19 fe 00 1b 06 1a 00 82 73 82 81 82 81 82 81 81 49 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 20 01 fe 00 1b 07 1a 00 82 60 82 8c 82 92 82 89 82 87 82 88 82 94 81 43 81 40 82 94 82 81 82 8b 82 85 81 40 82 94 82 88 82 81 82 94 81 49 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 20 01 fe 00 1b 08 1a 00 82 72 82 88 82 81 82 81 82 81 82 81 81 49 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 0b 01 fe 00 1b 09 1a 00 82 61 82 95 82 8f 82 8f 82 8f 82 8e 81 49 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 0b 01 fe 00 19 00 01 00 90 00 18 00 02 0a 19 00 4e 05 5b fe 76 01 01 00 4a 05 4c 00 05 fd 4c 00 fd 05 4c 00 fc 05 4a 05 5a 00 08 0a 1b 05 1a 00 82 76 82 88 82 8f 81 40 82 81 82 92 82 85 81 40 82 99 82 8f 82 95 81 48 81 40 82 68 81 40 82 97 82 8f 82 8e 81 75 82 94 81 40 82 8c 82 85 82 94 0d 00 82 81 82 8e 82 99 82 8f 82 8e 82 85 81 40 82 8d 82 85 82 93 82 93 81 40 82 95 82 90 81 40 82 94 82 88 82 89 82 93 81 40 82 90 82 8c 82 81 82 83 82 85 81 49 0d 00 00 00 56 00 fd 13 67 00 0f 00 1b fd 1a 00 82 63 82 8f 82 8e 81 75 82 94 81 40 82 97 82 8f 82 92 82 92 82 99 81 42 81 40 82 76 82 85 81 75 82 92 82 85 81 40 82 8a 82 95 82 93 82 94 0d 00 82 94 82 92 82 81 82 96 82 85 82 8c 82 8c 82 89 82 8e 82 87 81 40 82 94 82 88 82 92 82 8f 82 95 82 87 82 88 0d 00 82 94 82 8f 81 40 82 93 82 81 82 96 82 85 81 40 82 94 82 88 82 85 81 40 82 89 82 93 82 8c 82 81 82 8e 82 84 81 42 0d 00 00 00 56 00 fd 00 5a 00 08 0a 1b 05 1a 00 82 68 81 40 82 84 82 8f 82 8e 81 75 82 94 81 40 82 94 82 92 82 95 82 93 82 94 81 40 82 99 82 8f 82 95 81 43 81 40 82 87 82 85 82 94 81 40 82 8c 82 8f 82 93 82 94 81 49 0d 00 00 00 1b fd 1a 00 82 76 82 81 82 89 82 94 81 40 82 81 81 40 82 93 82 85 82 83 81 42 0d 00 00 00 1c 00 01 00 1e 00 fa 01 1e 00 fb 05 1e 00 fc ff 1e 00 fd ff 27 00 67 00 01 00 66