// DG076.SCN
#include "functions.dgs"
#pragma script index=76 start=0x34000 end=0x35000 headerU16=0x1c sentinelOff=0x24
#include "entities.dgs"

section onEnter(254) {
  spawnItemChance(max: 99, chance: 15, item: Item.Digimushroom, x: 54, y: 55);
  spawnItemChance(max: 99, chance: 6, item: Item.Digimushroom, x: 40, y: 47);
  spawnItemChance(max: 99, chance: 17, item: Item.Digimushroom, x: 39, y: 46);
  spawnItemChance(max: 99, chance: 3, item: Item.Happymushroom, x: 58, y: 34);
  setPStat(PStat(254), 0);
  callSubroutine(25);
  return;
}

section(51) {
  if (trigger(187)) {
    return;
  }
  move(entity: Entity.Partner, to: Entity.Player, sprint: 1);
  waitForPair();
  lookPairAt(Entity(5));
  speak(Entity(5), "「お、おまえらか。この先は時急域だぞ。<NEWLINE> あまり近よるな。」<NEWLINE>");
  anim(Entity.Player, Animation(19), wait: 15);
  speak(Entity.Player, "「前にも言ったけど…俺達の目的は2つ。<NEWLINE> 異変の原因を探ること。それとデジモンを<NEWLINE> 街へ集めること。」<NEWLINE>");
  playAnimation(Entity.Player, Animation(0));
  speak(Entity(5), "「あー、そーだったな。で?」<NEWLINE>");
  setDialogOwner(Entity.Player);
  setSelection(L1, L3);
  showTextbox("「協力してくれないか?」<NEWLINE>「いや…なんでも無い…」<NEWLINE>");

L1:
  speak(Entity(5), "「俺はダメだぜ。この森の守護ってぇ<NEWLINE> 大事な役割があるからな。」<NEWLINE>");
  speak(Entity.Player, "「じゃ島の異変について…<NEWLINE> 何か知ってることは無いか?」<NEWLINE>");
  speak(Entity(5), "「知らねえなあ……ん…?待てよ…」<NEWLINE>");
  showTextbox("「そういえば少し前に空からでけえ石が<NEWLINE> 落ちてきたことがあったな…。<NEWLINE> あれは…」<NEWLINE>");
  speak(Entity.Player, "「えっ、どこに落ちた?!」<NEWLINE>");
  speak(Entity(5), "「……時急域。この向こうさ…」<NEWLINE>");
  anim(Entity.Player, Animation(19), wait: 15);
  speak(Entity.Player, "「頼む、行かせてくれ!何か手がかりが<NEWLINE> あるかもしれないんだ!」<NEWLINE>");
  playAnimation(Entity.Player, Animation(0));
  speak(Entity(5), "「…………………」<NEWLINE>");
  showTextbox("「はー…そんなに言うなら仕方ねえか…。<NEWLINE> 俺、おまえらに負けたしなー。<NEWLINE> ま、せいぜい調べてきなよ。」<NEWLINE>");
  move(entity: Entity(5), to: (-740, 2145), sprint: 1);
  waitForEntity(Entity(5));
  look(entity: Entity(5), at: Entity.Player);
  setTrigger(Trigger(187));

L2:
  speak(Entity(5), "「この奥は時間の早さが外の2倍だ。<NEWLINE> 食料はじゅうぶん持ってけよ。<NEWLINE> 寿命に気をつけるのは当然としてな。」<NEWLINE>");
  return;

L3:
  speak(Entity(5), "「他をあたったほうがいいんじゃねえか。」<NEWLINE>");
  move(entity: Entity.Player, to: (-326, 1203), sprint: 0, withCamera: true);
  waitForEntity(Entity.Player);
  return;
}

section(5) {
  goto section_51.L2;

L1:
  return;
}

section(6) {
  if (!trigger(188)) {
    speak(Entity(6), "「この奥は時間の早さが外の2倍だ。<NEWLINE> 食料はじゅうぶん持ってけよ。<NEWLINE> 寿命に気をつけるのは当然としてな。」<NEWLINE>");
    return;
  }
  if (!trigger(313)) {
    speak(Entity(6), "「どうだ?何かあったのか?」<NEWLINE>");
    speak(Entity.Player, "「いや、まだ…」<NEWLINE>");
    speak(Entity(6), "「前にここの番をしてた<NEWLINE> 俺の師匠によると、『かくしつうろ』が<NEWLINE> あるらしいぜ。」<NEWLINE>");
    showTextbox("「どこって言われても知らねえがな。」<NEWLINE>");
    return;
  }
  if (trigger(313) && trigger(208)) {
    return;
  }
  {
    speak(Entity(6), "「おっ、何だよ…」<NEWLINE>");
    speak(Entity.Player, "「いん石…カンケー無かったみたい。はぁ…」<NEWLINE>");
    playAnimation(Entity.Player, Animation(22));
    speak(Entity(6), "「はーん。そうか。ま、残念だったな。<NEWLINE> わりぃけど、俺はもう何も知らんよ。」<NEWLINE>");
    speak(Entity.Player, "「……。それじゃな。」<NEWLINE>");
    setDigimon(Digimon.MasterTyrannomon, Entity(2), 0);
    playSound(8, 7);
    speak(Entity(7), "「くぉらぁーーーっ!!」<NEWLINE>");
    lookPairAt(Entity(7));
    look(entity: Entity(6), at: Entity(7));
    for x in [Entity.Player, Entity.Partner, Entity(6)] {
      waitForEntity(x);
    }
    move(entity: Entity(7), to: (64, 1093), sprint: 0);
    delay(15);
    playSound(8, 6);
    lookPairAt(Entity(7));
    look(entity: Entity(6), at: Entity(7));
    move(entity: Entity(7), to: (64, 1093), sprint: 0);
    delay(15);
    playSound(8, 6);
    lookPairAt(Entity(7));
    look(entity: Entity(6), at: Entity(7));
    move(entity: Entity(7), to: (64, 1093), sprint: 0);
    delay(15);
    playSound(8, 6);
    lookPairAt(Entity(7));
    look(entity: Entity(6), at: Entity(7));
    move(entity: Entity(7), to: (64, 1093), sprint: 0);
    waitForEntity(Entity(7));
    playSound(8, 6);
    lookPairAt(Entity(7));
    look(entity: Entity(6), at: Entity(7));
    look(entity: Entity(7), at: Entity.Player);
    for x in [Entity.Player, Entity.Partner, Entity(6), Entity(7)] {
      waitForEntity(x);
    }
    playAnimation(Entity.Player, Animation(23));
    showTextbox("「だーーからおまえは!<NEWLINE> 半人前だというのだっ!」<NEWLINE>");
    speak(Entity(6), "「し、し、師匠!?」<NEWLINE>");
    speak(Entity(7), "「このボンクラが!<NEWLINE> まだこんな所におるとはあきれるわ!」<NEWLINE>");
    playSound(8, 8);
    anim(Entity.Player, Animation(16), wait: 15);
    speak(Entity.Player, "「(師匠だって?!何なんだ?!)」<NEWLINE>");
    playAnimation(Entity.Player, Animation(0));
    speak(Entity(6), "「し、しかしダイノ古代境の守護が…」<NEWLINE>");
    speak(Entity(7), "「バカもーん!今はこの島の一大事だという<NEWLINE> ときに!おまえは街に行って皆様の役に<NEWLINE> たたんか、たわけめ!」<NEWLINE>");
    playSound(8, 8);
    speak(Entity(6), "「は…はい…」<NEWLINE>");
    look(entity: Entity.Player, at: Entity(6));
    delay(10);
    speak(Entity.Player, "「えっ、ホントか?!」<NEWLINE>");
    look(entity: Entity.Player, at: Entity(7));
    waitForEntity(Entity.Player);
    speak(Entity(7), "「アナログの少年よ、まだこいつは未熟者<NEWLINE> だが、街で働かしてやってくれんか。<NEWLINE> ここの番はワシがやるから。」<NEWLINE>");
    playSound(8, 7);
    speak(Entity(6), "「師匠…」<NEWLINE>");
    look(entity: Entity(6), at: Entity.Player);
    waitForEntity(Entity(6));
    speak(Entity(6), "「<LIGHTBLUE><PLAYER><WHITE>、そういうわけで俺、<NEWLINE> 街へ行っていいか?」<NEWLINE>");
    look(entity: Entity.Player, at: Entity(6));
    waitForEntity(Entity.Player);
    playAnimation(Entity.Player, Animation(19));
    speak(Entity.Player, "「もちろん。ちゃんと働いてくれよ。」<NEWLINE>");
    speak(Entity(6), "「おう、任せな!<NEWLINE> 師匠、それでは行ってきます!」<NEWLINE>");
    break;
  }
  loop {
    move(entity: Entity(6), to: (-243, -614), sprint: 1);
    if (pstat[101] >= 6) break;
    addPStat(PStat.LoopIterator, 1);
    delay(10);
    lookPairAt(Entity(6));
    look(entity: Entity(7), at: Entity(6));
  }
  waitForEntity(Entity(6));
  unloadEntity(Entity(6));
  setPStat(PStat.LoopIterator, 0);
  playSound(8, 9);
  speak(Entity.System, "ティラノモンが街に参加した!<NEWLINE>");
  setTrigger(Trigger(208));
  addPStat(PStat(1), 2);
  speak(Entity(7), "「(どこまでやってくれるか…フッ…。)」<NEWLINE>");
  return;
}

section(7) {
  look(entity: Entity.Player, at: Entity(7));
  waitForEntity(Entity.Player);
  playAnimation(Entity.Player, Animation(23));
  speak(Entity(7), "「フフ…ここの番をするのも何年ぶりか。<NEWLINE> ああ、おぬしらはここは自由に行き来して<NEWLINE> かまわんよ。存分に活用するがいい。」<NEWLINE>");
  return;
}

section(8) {
  look(entity: Entity.Player, at: Entity(8));
  waitForEntity(Entity.Player);
  playAnimation(Entity.Player, Animation(23));
  speak(Entity(8), "「フフ…ここの番をするのも何年ぶりか。<NEWLINE> ああ、おぬしらはここは自由に行き来して<NEWLINE> かまわんよ。存分に活用するがいい。」<NEWLINE>");
  return;
  garbage { 1c 00 fe 00 1c 00 33 00 7c 00 05 00 aa 04 06 00 b0 04 07 00 14 0b 08 00 a0 0b ff ff 24 00 6e 63 19 00 0b 00 6e 0f 18 00 32 00 19 00 74 2c 36 00 37 00 24 00 6e 63 19 00 0b 00 6e 06 18 00 48 00 19 00 74 2c 28 00 2f 00 24 00 6e 63 19 00 0b 00 6e 11 18 00 5e 00 19 00 74 2c 27 00 2e 00 24 00 6e 63 19 00 0b 00 6e 03 18 00 74 00 19 00 74 45 3a 00 22 00 1e 00 fe 00 64 19 fe 00 19 00 00 00 bb 00 18 00 8a 00 19 00 fe 00 51 fc 01 fd 4a fd 4a fc 4c 00 fd 05 4c 00 fc 05 1b 05 1a 00 81 75 82 a8 81 41 82 a8 82 dc 82 a6 82 e7 82 a9 81 42 82 b1 82 cc 90 e6 82 cd 8e 9e 8b 7d 88 e6 82 be 82 bc 81 42 0d 00 81 40 82 a0 82 dc 82 e8 8b df 82 e6 82 e9 82 c8 81 42 81 76 0d 00 00 00 56 00 fd 13 67 00 0f 00 1b fd 1a 00 81 75 91 4f 82 c9 82 e0 8c be 82 c1 82 bd 82 af 82 c7 81 63 89 b4 92 42 82 cc 96 da 93 49 82 cd 82 51 82 c2 81 42 0d 00 81 40 88 d9 95 cf 82 cc 8c b4 88 f6 82 f0 92 54 82 e9 82 b1 82 c6 81 42 82 bb 82 ea 82 c6 83 66 83 57 83 82 83 93 82 f0 0d 00 81 40 8a 58 82 d6 8f 57 82 df 82 e9 82 b1 82 c6 81 42 81 76 0d 00 00 00 56 00 fd 00 1b 05 1a 00 81 75 82 a0 81 5b 81 41 82 bb 81 5b 82 be 82 c1 82 bd 82 c8 81 42 82 c5 81 48 81 76 0d 00 00 00 1b fd 10 02 bc 01 6e 04 1a 00 81 75 8b a6 97 cd 82 b5 82 c4 82 ad 82 ea 82 c8 82 a2 82 a9 81 48 81 76 0d 00 81 75 82 a2 82 e2 81 63 82 c8 82 f1 82 c5 82 e0 96 b3 82 a2 81 63 81 76 0d 00 00 00 1b 05 1a 00 81 75 89 b4 82 cd 83 5f 83 81 82 be 82 ba 81 42 82 b1 82 cc 90 58 82 cc 8e e7 8c ec 82 c1 82 c4 82 a5 0d 00 81 40 91 e5 8e 96 82 c8 96 f0 8a 84 82 aa 82 a0 82 e9 82 a9 82 e7 82 c8 81 42 81 76 0d 00 00 00 1b fd 1a 00 81 75 82 b6 82 e1 93 87 82 cc 88 d9 95 cf 82 c9 82 c2 82 a2 82 c4 81 63 0d 00 81 40 89 bd 82 a9 92 6d 82 c1 82 c4 82 e9 82 b1 82 c6 82 cd 96 b3 82 a2 82 a9 81 48 81 76 0d 00 00 00 1b 05 1a 00 81 75 92 6d 82 e7 82 cb 82 a6 82 c8 82 a0 81 63 81 63 82 f1 81 63 81 48 91 d2 82 c4 82 e6 81 63 81 76 0d 00 00 00 1a 00 81 75 82 bb 82 a4 82 a2 82 a6 82 ce 8f ad 82 b5 91 4f 82 c9 8b f3 82 a9 82 e7 82 c5 82 af 82 a6 90 ce 82 aa 0d 00 81