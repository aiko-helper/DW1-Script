// MAP213.SCN
#include "functions.dgs"
#pragma script index=213 start=0x9f800 end=0xa0000 headerU16=0x10 sentinelOff=0x575
#include "entities.dgs"

section onEnter(254) {
  spawnChest(Item.MediumMP, -1511, 1093, 0, 706);
  spawnItemChance(max: 99, chance: 14, item: Item.Digimushroom, x: 74, y: 62);
  spawnItemChance(max: 99, chance: 24, item: Item.Digimushroom, x: 31, y: 45);
  return;
}

section(81) {
  {
    {
      speak(Entity.System, " <NEWLINE>       自動はん売機<NEWLINE>");
      rotate(entity: Entity.Player, to: 2048);
      delay(5);
      speak(Entity.Player, "「げぇ、高いはん売機だなー。」<NEWLINE>");
      setSelection(L1, L2, L3);
      showTextbox("肉              300<B><it><NEWLINE>デジタケ           600<B><it><NEWLINE>買わない<NEWLINE>");
      waitForSelectionChoice();
      goto L3;
      return;

L1:
      if (money >= 300) {
        goto L4;
        break;
      }
      speak(Entity.Player, "「お金が足りないか。」<NEWLINE>");
      return;

L2:
    }
    if (money >= 600) {
      goto L5;
      break;
    }
    speak(Entity.Player, "「お金が足りないか。」<NEWLINE>");
    return;

L3:
  }
  return;

L4:
  reduceMoney(300);
  speak(Entity.System, "<LIGHTBLUE>肉<WHITE>が出てきた!<NEWLINE>");
  giveItem(Item.Meat, 1);
  if (trigger(0)) {
    if (item[Item.Meat] >= 99) {
      return;
    }
    speak(Entity.Player, "「いけね、持ち物がいっぱいだ。」<NEWLINE>");
    inventoryFullBailout();
    giveItem(Item.Meat, 1);
  }
  return;

L5:
  reduceMoney(600);
  speak(Entity.System, "<LIGHTBLUE>デジタケ<WHITE>が出てきた!<NEWLINE>");
  giveItem(Item.Digimushroom, 1);
  if (trigger(0)) {
    if (item[Item.Digimushroom] >= 99) {
      return;
    }
    speak(Entity.Player, "「いけね、持ち物がいっぱいだ。」<NEWLINE>");
    inventoryFullBailout();
    giveItem(Item.Digimushroom, 1);
  }
  return;
}

section(82) {
  rotate(entity: Entity.Player, to: 2048);
  delay(5);
  setTextboxSize(19, 7);
  showTextbox("       釣りの説明<NEWLINE> <NEWLINE> まず、『さお』を用意します。<NEWLINE> するとサブメニュー(<GREEN><TRIANGLE><WHITE><ボき><ヌン>)に釣りの<NEWLINE> アイコンが出ます。押してください。<NEWLINE> <ORANGE><CIRCLE><WHITE><ボき><ヌン>でエサつけになります。<NEWLINE> 持っている食べ物からひとつ選びます。<NEWLINE>");
  showTextbox(" <NEWLINE> 次に方向キー左右で向きを変えます。<NEWLINE> 決めたら<ORANGE><CIRCLE><WHITE><ボき><ヌン>でさおをふりかぶり、<NEWLINE> もう一度<ORANGE><CIRCLE><WHITE><ボき><ヌン>で投げます。<NEWLINE> あとはウキがしずむのをまちます。<NEWLINE> ウキがしずむと魚がエサに食いついて<NEWLINE> います。<ORANGE><CIRCLE><WHITE><ボき><ヌン>でひっぱりましょう。<NEWLINE>");
  showTextbox(" <NEWLINE> このとき左上に出るゲージを見て、<NEWLINE> ゲージがいっぱいになる前に<ORANGE><CIRCLE><WHITE><ボき><ヌン>を<NEWLINE> 放さないと、いとが切れてしまうので<NEWLINE> 気をつけましょう。近くまで<NEWLINE> ウキをひきよせきれば、魚を<NEWLINE> 釣りあげたことになります。<NEWLINE>");
  showTextbox(" <NEWLINE> もし魚影にバツが表示されたら、<NEWLINE> 今のエサではその魚は釣れないことを<NEWLINE> 意味します。<NEWLINE> <NEWLINE> <NEWLINE> <NEWLINE>");
  fadeOutHUD();
  return;
  garbage { 10 00 fe 00 10 00 51 00 4a 00 52 00 74 02 ff ff 75 05 19 fa 00 00 45 04 00 00 c2 02 24 00 6e 63 19 00 0b 00 6e 0e 18 00 32 00 19 00 74 2c 4a 00 3e 00 24 00 6e 63 19 00 0b 00 6e 18 18 00 48 00 19 00 74 2c 1f 00 2d 00 fe 00 1b ff 1a 00 81 40 0d 00 81 40 81 40 81 40 81 40 81 40 81 40 81 40 8e a9 93 ae 82 cd 82 f1 94 84 8b 40 0d 00 00 00 4d fd 00 08 67 00 05 00 1b fd 1a 00 81 75 82 b0 82 a5 81 41 8d 82 82 a2 82 cd 82 f1 94 84 8b 40 82 be 82 c8 81 5b 81 42 81 76 0d 00 00 00 10 03 10 01 48 01 80 01 1a 00 93 f7 81 40 81 40 81 40 81 40 81 40 81 40 81 40 81 40 81 40 81 40 81 40 81 40 81 40 81 40 82 52 82 4f 82 4f 81 6f 81 70 0d 00 83 66 83 57 83 5e 83 50 81 40 81 40 81 40 81 40 81 40 81 40 81 40 81 40 81 40 81 40 81 40 82 55 82 4f 82 4f 81 6f 81 70 0d 00 94 83 82 ed 82 c8 82 a2 0d 00 00 00 12 00 16 00 80 01 fe 00 19 00 25 00 00 02 2c 01 00 00 18 00 28 01 19 00 16 00 82 01 16 00 48 01 1b fd 1a 00 81 75 82 a8 8b e0 82 aa 91 ab 82 e8 82 c8 82 a2 82 a9 81 42 81 76 0d 00 00 00 fe 00 19 00 25 00 00 02 58 02 00 00 18 00 60 01 19 00 16 00 f8 01 16 00 80 01 1b fd 1a 00 81 75 82 a8 8b e0 82 aa 91 ab 82 e8 82 c8 82 a2 82 a9 81 42 81 76 0d 00 00 00 fe 00 fe 00 2b 00 2c 01 00 00 1b ff 1a 00 01 06 93 f7 01 01 82 aa 8f 6f 82 c4 82 ab 82 bd 81 49 0d 00 00 00 28 00 26 01 19 00 00 00 00 00 18 00 f6 01 19 00 19 00 24 00 26 02 63 00 18 00 c2 01 19 00 fe 00 1b fd 1a 00 81 75 82 a2 82 af 82 cb 81 41 8e 9d 82 bf 95 a8 82 aa 82 a2 82 c1 82 cf 82 a2 82 be 81 42 81 76 0d 00 00 00 1c 00 03 00 64 00 64 0d 28 00 26 01 fe 00 2b 00 58 02 00 00 1b ff 1a 00 01 06 83 66 83 57 83 5e 83 50 01 01 82 aa 8f 6f 82 c4 82 ab 82 bd 81 49 0d 00 00 00 28 00 2c 01 19 00 00 00 00 00 18 00 72 02 19 00 19 00 24 00 2c 02 63 00 18 00 3e 02 19 00 fe 00 1b fd 1a 00 81 75 82 a2 82 af 82 cb 81 41 8e 9d 82 bf 95 a8 82 aa 82 a2 82 c1 82 cf 82 a2 82 be 81 42 81 76 0d 00 00 00 1c 00 03 00 }
