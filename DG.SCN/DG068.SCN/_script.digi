; DG068.SCN
;!script index=68 start=0x31000 end=0x31800 headerU16=0x28 sentinelOff=0x24
;!sections onEnter section_5 section_6 section_7 section_8 section_9 section_10 section_11 section_51

onEnter:     ; len=96
  0000:  storeRandom 110 99
  0004:  if pstat[110] > 8 then onEnter+0x16
  0010:  spawnItem 44 57 61
  0016:  storeRandom 110 99
  001a:  if pstat[110] > 19 then onEnter+0x2c
  0026:  spawnItem 44 35 43
  002c:  storeRandom 110 99
  0030:  if pstat[110] > 2 then onEnter+0x42
  003c:  spawnItem 52 39 18
  0042:  if !trigger(328) then onEnter+0x52
  004e:  jump onEnter+0x5e
  0052:  setObjectVisibility 38 1
  0056:  setObjectVisibility 39 1
  005a:  setObjectVisibility 40 1
  005e:  endSection
