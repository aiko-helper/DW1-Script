// DG177.SCN
#include "functions.dgs"
#pragma script index=177 start=0x86000 end=0x87000 headerU16=0x14 sentinelOff=0xfe
#include "entities.dgs"

section onEnter(254) {
  return;
}

section(51) {
  warp(to: Map.ROOM06, spawn: 1, trigger: 255);
  return;
}

section(6) {
  if (pstat[44] == 0) {
    speak(Entity(6), "I know about Items.\n");
    showTextbox("There are one hund and twenty\neight kinds of Items in all.\n");
    showTextbox("Thirty two are food.\n");
    showTextbox("Rare Items grow naturally\nin some areas and can't be\nfound in others.\n");
    showTextbox("For example, you can\nfind a Blue Apple in\nNative Forest.\n");
    showTextbox("These foods have special\neffects, so be careful on\nthe timing of eating them.\n");
    setPStat(PStat(44), 1);
    return;
  }
  if (pstat[44] == 1) {
    speak(Entity(6), "Now I'll talk about\nDigivolution Items.\n");
    showTextbox("Digivolution Items make\nDigimon digivolve, as the\nname suggests.\n");
    showTextbox("There are many different\nkinds of Digivolution Items.\n");
    showTextbox("Each kind causes Digimon\nto digivolve into different\ntypes of Digimon.\n");
    showTextbox("For example, if you use\nGrey Claws, the Digimon\nwill turn into Greymon.\n");
    showTextbox("Digivolution Items are\nItems of legend and some\nare one of a kind.\n");
    showTextbox("But sometimes you don't get\nany bonus ability like\nduring normal Digivolution.\n");
    showTextbox("Also, Happiness level goes\ndown, so they're not perfect.\n");
    showTextbox("At the same time, it's nice\nto digivolve into the kind of\nDigimon you want to be.\n");
    showTextbox("You can only digivolve from\none generation before the\nDigimon you want to become.\n");
    showTextbox("So be careful.\n");
    setPStat(PStat(44), 0);
  }
  return;
}

section(5) {
  look(entity: Entity.Player, at: Entity(5));
  look(entity: Entity(5), at: Entity.Player);
  if (trigger(70) || trigger(71) || trigger(72) || trigger(73)) {
    goto L1;
  }
  if (trigger(211) && !trigger(70) && pstat[24] == 0) {
    speak(Entity(5), "Hey! Hola amigos!\n");
    showTextbox("What kind of shop is this?\nIt's my shop?\nBuy something please.\n");
    setTrigger(Trigger(70));
    return;
  }
  if (trigger(252) && !trigger(71) && pstat[24] == 1) {
    speak(Entity(5), "Look <LIGHTBLUE><PLAYER><WHITE>! My shop\nsells interesting stuff. I\nhope you'll come here a lot.\n");
    setTrigger(Trigger(71));
    return;
  }
  if (trigger(213) && !trigger(72) && pstat[24] == 2) {
    speak(Entity(5), "The stuff you see here\nisn't ordinary stuff,\nso go ahead and shop!\n");
    setTrigger(Trigger(72));
    return;
  }
  if (!trigger(206) || trigger(73) || pstat[24] != 3) goto L1;
  speak(Entity(5), "Hey stranger! I knew\nyou'd come <LIGHTBLUE><PLAYER><WHITE>.\nDon't look so surprised.\n");
  showTextbox("Can you master how to use\nmy Items? The answer depends\non your ability as a Tamer.\n");
  setTrigger(Trigger(73));
  return;

L1:
  if (trigger(211) && !trigger(70) && pstat[24] == 0) {
    speak(Entity(5), "Where am I?\nI love dark places and this\nshop shows that very well!\n");
    setTrigger(Trigger(70));
    return;
  }
  if (trigger(252) && !trigger(71) && pstat[24] == 1) {
    speak(Entity(5), "Alright <LIGHTBLUE><PLAYER><WHITE>, thanks\nfor coming. Since you're here,\nwhy don't you buy something?\n");
    setTrigger(Trigger(71));
    return;
  }
  if (trigger(213) && !trigger(72) && pstat[24] == 2) {
    speak(Entity(5), "Hey, <LIGHTBLUE><PLAYER><WHITE>. You're here!\nCome on, get some of my\nvery useful Items.\n");
    setTrigger(Trigger(72));
    return;
  }
  if (trigger(206) && !trigger(73) && pstat[24] == 3) {
    speak(Entity(5), "Hey stranger!\nI knew you'd come <LIGHTBLUE><PLAYER><WHITE>.\nDon't look so surprised.\n");
    showTextbox("Can you master how to use\nmy Items? The answer depends\non your ability as a Tamer.\n");
    setTrigger(Trigger(73));
    return;
  }
  if (pstat[24] == 0) {
    setTrigger(Trigger(419));
    setTrigger(Trigger(420));
    unsetTrigger(Trigger(3));
    setPStat(PStat(254), 5);
    callSubroutine(8);
    unsetTrigger(Trigger(419));
    unsetTrigger(Trigger(420));
    return;
  }
  if (pstat[24] == 1) {
    setTrigger(Trigger(418));
    setTrigger(Trigger(421));
    unsetTrigger(Trigger(3));
    setPStat(PStat(254), 5);
    callSubroutine(8);
    unsetTrigger(Trigger(418));
    unsetTrigger(Trigger(421));
    return;
  }
  if (pstat[24] == 2) {
    for id in Trigger(402)..Trigger(405) {
      setTrigger(id);
    }
    unsetTrigger(Trigger(3));
    setPStat(PStat(254), 5);
    callSubroutine(8);
    for id in Trigger(402)..Trigger(405) {
      unsetTrigger(id);
    }
    return;
  }
  if (pstat[24] == 3) {
    for id in Trigger(413)..Trigger(415) {
      setTrigger(id);
    }
    unsetTrigger(Trigger(3));
    setPStat(PStat(254), 5);
    callSubroutine(8);
    for id in Trigger(413)..Trigger(415) {
      unsetTrigger(id);
    }
    return;
  }
  return;
  garbage { 14 00 fe 00 14 00 33 00 16 00 06 00 1c 00 05 00 42 08 ff ff fe 00 4b d8 01 ff fe 00 19 00 08 00 2c 00 18 00 aa 02 19 00 }
}
