    showTextbox("Hey stranger! I knew\nyou'd come <LIGHTBLUE><PLAYER><WHITE>.\nDon't look so surprised.\n");
    showTextbox("Can you master how to use\nmy Items? The answer depends\non your ability as a Tamer.\n");
    setTrigger(73);
