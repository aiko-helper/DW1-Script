// DG177.SCN
#pragma script index=177 start=0x86000 end=0x87000 headerU16=0x14 sentinelOff=0xfe

section onEnter(254) {  // len=2
    return;
}

section(51) {  // len=6
    warp(to: Map.ROOM06, spawn: 1, trigger: 255);
    return;
}

section(6) {  // len=2086
    if (pstat[44] != 0) goto L1;
    speak(6, "I know about Items.\n");
    showTextbox("There are one hund and twenty\neight kinds of Items in all.\n");
    showTextbox("Thirty two are food.\n");
    showTextbox("Rare Items grow naturally\nin some areas and can't be\nfound in others.\n");
    showTextbox("For example, you can\nfind a Blue Apple in\nNative Forest.\n");
    showTextbox("These foods have special\neffects, so be careful on\nthe timing of eating them.\n");
    setPStat(44, 1);
    return;

L1:
    if (pstat[44] != 1) goto L2;
    speak(6, "Now I'll talk about\nDigivolution Items.\n");
    showTextbox("Digivolution Items make\nDigimon digivolve, as the\nname suggests.\n");
    showTextbox("There are many different\nkinds of Digivolution Items.\n");
    showTextbox("Each kind causes Digimon\nto digivolve into different\ntypes of Digimon.\n");
    showTextbox("For example, if you use\nGrey Claws, the Digimon\nwill turn into Greymon.\n");
    showTextbox("Digivolution Items are\nItems of legend and some\nare one of a kind.\n");
    showTextbox("But sometimes you don't get\nany bonus ability like\nduring normal Digivolution.\n");
    showTextbox("Also, Happiness level goes\ndown, so they're not perfect.\n");
    showTextbox("At the same time, it's nice\nto digivolve into the kind of\nDigimon you want to be.\n");
    showTextbox("You can only digivolve from\none generation before the\nDigimon you want to become.\n");
    showTextbox("So be careful.\n");
    setPStat(44, 0);

L2:
    return;
}

section(5) {  // len=1982
    look(entity: Entity.Player, at: 5);
    look(entity: 5, at: Entity.Player);
    if (!trigger(70) && !trigger(71) && !trigger(72) && !trigger(73)) goto L1;
    goto L5;

L1:
    if (!trigger(211) || trigger(70) || pstat[24] != 0) goto L2;
    speak(5, "Hey! Hola amigos!\n");
    showTextbox("What kind of shop is this?\nIt's my shop?\nBuy something please.\n");
    setTrigger(70);
    return;

L2:
    if (!trigger(252) || trigger(71) || pstat[24] != 1) goto L3;
    speak(5, "Look <LIGHTBLUE><PLAYER><WHITE>! My shop\nsells interesting stuff. I\nhope you'll come here a lot.\n");
    setTrigger(71);
    return;

L3:
    if (!trigger(213) || trigger(72) || pstat[24] != 2) goto L4;
    speak(5, "The stuff you see here\nisn't ordinary stuff,\nso go ahead and shop!\n");
    setTrigger(72);
    return;

L4:
    if (!trigger(206) || trigger(73) || pstat[24] != 3) goto L5;
    speak(5, "Hey stranger! I knew\nyou'd come <LIGHTBLUE><PLAYER><WHITE>.\nDon't look so surprised.\n");
    showTextbox("Can you master how to use\nmy Items? The answer depends\non your ability as a Tamer.\n");
    setTrigger(73);
    return;

L5:
    if (!trigger(211) || trigger(70) || pstat[24] != 0) goto L6;
    speak(5, "Where am I?\nI love dark places and this\nshop shows that very well!\n");
    setTrigger(70);
    return;

L6:
    if (!trigger(252) || trigger(71) || pstat[24] != 1) goto L7;
    speak(5, "Alright <LIGHTBLUE><PLAYER><WHITE>, thanks\nfor coming. Since you're here,\nwhy don't you buy something?\n");
    setTrigger(71);
    return;

L7:
    if (!trigger(213) || trigger(72) || pstat[24] != 2) goto L8;
    speak(5, "Hey, <LIGHTBLUE><PLAYER><WHITE>. You're here!\nCome on, get some of my\nvery useful Items.\n");
    setTrigger(72);
    return;

L8:
    if (!trigger(206) || trigger(73) || pstat[24] != 3) goto L9;
    speak(5, "Hey stranger!\nI knew you'd come <LIGHTBLUE><PLAYER><WHITE>.\nDon't look so surprised.\n");
    showTextbox("Can you master how to use\nmy Items? The answer depends\non your ability as a Tamer.\n");
    setTrigger(73);
    return;

L9:
    if (pstat[24] != 0) goto L10;
    setTrigger(419);
    setTrigger(420);
    unsetTrigger(3);
    setPStat(254, 5);
    callSubroutine(8);
    unsetTrigger(419);
    unsetTrigger(420);
    return;

L10:
    if (pstat[24] != 1) goto L11;
    setTrigger(418);
    setTrigger(421);
    unsetTrigger(3);
    setPStat(254, 5);
    callSubroutine(8);
    unsetTrigger(418);
    unsetTrigger(421);
    return;

L11:
    if (pstat[24] != 2) goto L12;
    for id in 402..405 { setTrigger(id); }
    unsetTrigger(3);
    setPStat(254, 5);
    callSubroutine(8);
    for id in 402..405 { unsetTrigger(id); }
    return;

L12:
    if (pstat[24] != 3) goto L13;
    for id in 413..415 { setTrigger(id); }
    unsetTrigger(3);
    setPStat(254, 5);
    callSubroutine(8);
    for id in 413..415 { unsetTrigger(id); }
    return;

L13:
    return;
    garbage { 14 00 fe 00 14 00 33 00 16 00 06 00 1c 00 05 00 42 08 ff ff fe 00 4b d8 01 ff fe 00 19 00 08 00 2c 00 18 00 aa 02 19 00 }
}
