// source: extract/DIGIMON/SCN/DG.SCN
// DG013.SCN, section 5

section section_5(5) {  // len=828
    setDialogOwner(5);
    showTextbox("Hey, are you the one\nbuilding a city?\n");
    setDialogOwner(Entity.Player);
    showTextbox("Yes.\n");
    playSound(8, 6);
    setDialogOwner(5);
    showTextbox("Uh, you're real lucky\nto meet me.\n");
    showTextbox("I don't look it, but I'm an\nUltimate Digimon. If you\nbeat me, I'll help you.\n");
    playAnimation(Entity.Player, 16);
    setDialogOwner(Entity.Player);
    setSelection(L_0196, L_02b6);
    showTextbox("Okay, I accept\nNo thanks\n");
    waitForSelectionChoice();
    goto L_02b6;
L_0196:
    setTrigger(1);
    setPStat(250, 1);
    setPStat(251, 5);
    setPStat(252, 255);
    setPStat(253, 255);
    fadeOutHUD();
    delay(1);
    startBattle();
    unsetTrigger(1);
    setPStat(250, 0);
    look(entity: Entity.Player, at: 5);
    look(entity: 5, at: Entity.Player);
    look(entity: Entity.Partner, at: 5);
    look(entity: Entity.Player, at: 5);
    look(entity: Entity.Partner, at: 5);
    look(entity: 5, at: Entity.Player);
    waitForEntity(Entity.Player);
    setDialogOwner(5);
    showTextbox("Wow, I lost! Well, I'll\nsee you in the city.\n");
    goto L_0238;
L_0238:
    move(entity: 5, to: (-2444, -3233), sprint: 1);
    if (pstat[101] >= 10) goto L_0260;
    addPStat(101, 1);
    delay(10);
    look(entity: Entity.Player, at: 5);
    look(entity: Entity.Partner, at: 5);
    goto L_0238;
L_0260:
    waitForEntity(5);
    unloadEntity(5);
    setPStat(101, 0);
    playSound(8, 3);
    setDialogOwner(Entity.System);
    showTextbox("Piximon joins the city!\n");
    unsetTrigger(1);
    setTrigger(255);
    addPStat(1, 3);
    moveCamera(to: Entity.Player, speed: 10);
    waitForEntity(200);
    return;
L_02b6:
    setDialogOwner(5);
    showTextbox("Oh, what a coward!\nLet's meet again!\n");
    goto L_030a;
L_030a:
    move(entity: 5, to: (-2444, -3233), sprint: 1);
    if (pstat[101] >= 10) goto L_0332;
    addPStat(101, 1);
    delay(10);
    look(entity: Entity.Player, at: 5);
    look(entity: Entity.Partner, at: 5);
    goto L_030a;
L_0332:
    waitForEntity(5);
    unloadEntity(5);
    setPStat(101, 0);
    return;
}
