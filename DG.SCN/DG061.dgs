// DG061.SCN
#pragma script index=61 start=0x2d000 end=0x2d800 headerU16=0x14 sentinelOff=0xe75

section onEnter(254) {  // len=14
    spawnChest(Item.Medicine, -503, -2215, 3072, 656);
    return;
}

section(81) {  // len=26
    rotate3DObject(1, 1);
    playSound(8, 1);
    delay(10);
    move(entity: Entity.Player, to: (336, 1300), sprint: 0);
    warp(to: Map.YAKA22, spawn: 0, trigger: 255);
    return;
}

section(82) {  // len=194
    if (trigger(117)) goto L1;
    rotate(entity: Entity.Player, to: 3072);
    playSound(8, 2);
    delay(5);
    playSound(8, 2);
    playAnimation(Entity.Player, 16);
    delay(15);
    setDialogOwner(Entity.Player);
    showTextbox("I think it's locked.\n");
    playAnimation(Entity.Player, 0);
    showTextbox("Will the knob open?\n");
    playSound(8, 3);
    setDialogOwner(Entity.Player);
    showTextbox("It opened!\n");
    setTrigger(117);

L1:
    rotate3DObject(0, 1);
    playSound(8, 1);
    delay(10);
    move(entity: Entity.Player, to: (1700, 226), sprint: 0);
    warp(to: Map.YAKA11B, spawn: 2, trigger: 255);
    return;
}

section(52) {  // len=1794
    if (trigger(132)) goto L1;
    playAnimation(Entity.Player, 18);
    playAnimation(Entity.Partner, 43);
    delay(20);
    playAnimation(Entity.Partner, 44);
    setPStat(200, 30);
    dealMapDamage(200);
    setPStat(254, 253);
    callSubroutine(55);
    setDialogOwner(Entity.Player);
    showTextbox("Are you alright, <ORANGE><DIGIMON><WHITE>?\n");
    playAnimation(Entity.Player, 24);
    delay(15);
    showTextbox("What kind of place is this?\n");
    playAnimation(Entity.Player, 0);
    move(entity: Entity.Player, to: (150, -340), sprint: 0, withCamera: true);
    waitForEntity(Entity.Player);
    rotate(entity: Entity.Player, to: 1260);
    delay(10);
    rotate(entity: Entity.Player, to: 2796);
    delay(10);
    look(entity: Entity.Player, at: Entity.Partner);
    setDialogOwner(Entity.Player);
    showTextbox("Looks like we entered a room\nwe've never been to before.\n");
    setTrigger(132);
    return;
    goto L2;

L1:
    setDialogOwner(Entity.Player);
    showTextbox("Good landing!\n");
    return;

L2:
    return;
