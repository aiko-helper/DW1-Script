; source: ./extract/DIGIMON/SCN/DG.SCN
; DG220.SCN, section 83

section_83:     ; len=4082
  0000:  if !trigger(203) then section_83+0xe
  000c:  endSection
  000e:  playSound 0 0
  0012:  setDialogOwner 255
  0014:  showTextbox "<YELLOW>Poyomon <WHITE>\nPoyomon. My name is Poyomon.\n"
  0068:  if pstat[1] < 30 then section_83+0x354
  0074:  setDialogOwner 255
  0076:  showTextbox "<YELLOW>Poyomon <WHITE>\nI'll talk about digivolution.\nWell... It's about the next\nstage after Champion Digimon.\n"
  0140:  showTextbox "<YELLOW>Poyomon <WHITE>\nIt's called Ultimate Digimon.\nBut there is no guarantee a\nChampion always digivolves.\n"
  0206:  showTextbox "<YELLOW>Poyomon <WHITE>\nConditions to digivolve are\ntough, but once at Ultimate,\nyour life span gets longer.\n"
  02ca:  showTextbox "<YELLOW>Poyomon <WHITE>\nWith Digivolution Items,\nlife span doesn't increase.\n"
  034e:  playSound 0 1
  0352:  endSection
  0354:  if pstat[1] < 15 then section_83+0x81a
  0360:  setDialogOwner 255
  0362:  showTextbox "<YELLOW>Poyomon <WHITE>\nI'll talk about digivolution.\nWell... It's about the \nconditions to digivolve.\n"
  041a:  showTextbox "<YELLOW>Poyomon <WHITE>\nFirst, weight has to be close\nto next stage weight range.\n"
  04a8:  showTextbox "<YELLOW>Poyomon <WHITE>\nNext, higher parameters are\nbetter, but the effects of\neach are different.\n"
  0558:  showTextbox "<YELLOW>Poyomon <WHITE>\nCare mistakes. Depending on\nthe kind of Digimon you want,\nsometimes mistakes are good.\n"
  0620:  showTextbox "<YELLOW>Poyomon <WHITE>\nOh yeah, there are other\nspecial conditions to\nbecome certain Digimon.\n"
  06c8:  showTextbox "<YELLOW>Poyomon <WHITE>\nLike, especially high\nDiscipline, or many battles.\n"
  0748:  showTextbox "<YELLOW>Poyomon <WHITE>\nIf you do this, even if the\nthree basic conditions are not\nfully met, you can digivolve.\n"
  0814:  playSound 0 1
  0818:  endSection
  081a:  setDialogOwner 255
  081c:  showTextbox "<YELLOW>Poyomon <WHITE>\nJiji told me that <ORANGE><DIGIMON><WHITE>\nwould be digivolving.\n"
  088e:  showTextbox "<YELLOW>Poyomon <WHITE>\nIt takes six hours from Baby\nto In-Training Digimon.\n"
  0912:  showTextbox "<YELLOW>Poyomon <WHITE>\nAnd it only takes one day to\ngo to Rookie Digimon stage.\n"
  099e:  showTextbox "<YELLOW>Poyomon <WHITE>\nThe next stage of Champion\ntakes about three days.\n"
  0a1e:  showTextbox "<YELLOW>Poyomon <WHITE>\nHow long to next stage? I\nforgot, but it takes longer.\n"
  0aa6:  showTextbox "<YELLOW>Poyomon <WHITE>\nWeight, Parameters and Care\nMistakes affect digivolution.\n"
  0b34:  showTextbox "<YELLOW>Poyomon <WHITE>\nI'm not sure on details, so\nI'll ask Jiji next time.\n"
  0bb8:  playSound 0 1
  0bbc:  endSection
