// source: extract/DIGIMON/SCN/DG.SCN
// DG107.SCN, section 5

section section_5(5) {  // len=400
    storeDate(105);
    setDialogOwner(5);
    showTextbox("The present time is\n<YEAR>month, <DAY>day,\n<HOUR>hours, <MINUTE>minutes.\n");
    storeDigimonType(103);
    storeDigimonTypus(103, 109);
    if (pstat[109] != 1) goto L_00ce;
    setDialogOwner(5);
    showTextbox("<ORANGE><DIGIMON><WHITE> is a Data\nType Digimon, right?\n");
L_00ce:
    if (pstat[109] != 2) goto L_012c;
    setDialogOwner(5);
    showTextbox("<ORANGE><DIGIMON><WHITE> is a Vaccine\nType Digimon, right?\n");
L_012c:
    if (pstat[109] != 3) goto L_0186;
    setDialogOwner(5);
    showTextbox("<ORANGE><DIGIMON><WHITE> is a Virus\nType Digimon, right?\n");
L_0186:
    addStats(Stat.Tiredness, 10);
    reduceStats(Stat.Happiness, 10);
    return;
}
