section section_6(6) {  // len=1414
    setDialogOwner(6);
    showTextbox("I am useful for many things.\nWhat do you want me to do?\n");
    setDialogOwner(Entity.Player);
    setSelection(L_0110, L_019a, L_02bc);
    showTextbox("Change his Parameters\nSpeed up time for us\nChange this into a store\n");
    waitForSelectionChoice();
    return;
L_0110:
    setDialogOwner(Entity.Player);
    setSelection(L_0256, L_0278, L_029a);
    showTextbox("Make him most powerful\nMake him super weak\nMake him average\n");
    waitForSelectionChoice();
    return;
L_019a:
    setDialogOwner(Entity.Player);
    setSelection(L_0232, L_023e, L_024a);
    showTextbox("Make one hour pass\nMake six hours pass\nMake twenty four hours pass\n");
    waitForSelectionChoice();
    return;
L_0232:
    storeDate(105);
    addMinutesToDate(105, 60);
    advanceToDate(105);
    return;
L_023e:
    storeDate(105);
    addMinutesToDate(105, 360);
    advanceToDate(105);
    return;
L_024a:
    storeDate(105);
    addMinutesToDate(105, 1440);
    advanceToDate(105);
    return;
L_0256:
    setStats(Stat.Offense, 999);
    setStats(Stat.Defense, 999);
    setStats(Stat.Speed, 999);
    setStats(Stat.Brains, 999);
    setStats(Stat.MaxHP, 9999);
    setStats(Stat.MaxMP, 9999);
    setStats(Stat.CurrentHP, 9999);
    setStats(Stat.CurrentMP, 9999);
    return;
L_0278:
    setStats(Stat.Offense, 1);
    setStats(Stat.Defense, 1);
    setStats(Stat.Speed, 1);
    setStats(Stat.Brains, 1);
    setStats(Stat.MaxHP, 1);
    setStats(Stat.MaxMP, 1);
    setStats(Stat.CurrentHP, 1);
    setStats(Stat.CurrentMP, 1);
    return;
L_029a:
    setStats(Stat.Offense, 500);
    setStats(Stat.Defense, 500);
    setStats(Stat.Speed, 500);
    setStats(Stat.Brains, 500);
    setStats(Stat.MaxHP, 5000);
    setStats(Stat.MaxMP, 5000);
    setStats(Stat.CurrentHP, 5000);
    setStats(Stat.CurrentMP, 5000);
    return;
L_02bc:
    jumpToScriptSection(205, 6);
    return;
