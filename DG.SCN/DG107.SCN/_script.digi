;!script index=107 start=0x4c800 end=0x4d000 headerU16=0x14 sentinelOff=0x24
;!sections onEnter section_51 section_5 section_6

onEnter:     ; len=68
  0000:  storeRandom 110 99
  0004:  if pstat[110] > 19 then onEnter+0x16
  0010:  spawnItem Digimushroom 61 54
  0016:  storeRandom 110 99
  001a:  if pstat[110] > 4 then onEnter+0x2c
  0026:  spawnItem Happymushroom 39 46
  002c:  storeRandom 110 99
  0030:  if pstat[110] > 14 then onEnter+0x42
  003c:  spawnItem Digimushroom 55 63
  0042:  endSection
