section_6(6):     ; len=1262
  0000:  setDialogOwner 6
  0002:  showTextbox "The Insectoid Warrior\nTournament takes place here\nevery year...\n"
  0086:  showTextbox "...on days with two two's.\nThe winner gets great stuff!\n"
  00fa:  showTextbox "But only Insectoid\nDigimon can enter.\n"
  014a:  if !trigger(346) then section_6+0x2e0
  0156:  setDialogOwner 6
  0158:  showTextbox "There's Kabuterimon,\nKuragamon, Kunemon,\nand one other Insectoid.\n"
  01e0:  showTextbox "But, no Numemon.\n"
  0206:  showTextbox "On days with two two's, the\nInsectoid Warrior Contest\ntakes place every year.\n"
  02a6:  showTextbox "You've won before, right?\n"
  02de:  endSection
  02e0:  setDialogOwner 6
  02e2:  showTextbox "There's Kabuterimon,\nKuragamon, Kunemon,\nand one other Insectoid.\n"
  036a:  showTextbox "That's HerculesKabuterimon.\n"
  03a6:  showTextbox "Hercules-Kabuterimon is\nsuper strong.\n"
  03f6:  showTextbox "The contest winner can\nbecome Hercules-Kabuterimon\nand get Items.\n"
  047e:  showTextbox "You can enter Insectoid\nWarrior Contests many times.\n"
  04ec:  endSection
