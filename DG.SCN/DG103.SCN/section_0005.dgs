// source: extract/DIGIMON/SCN/DG.SCN
// DG103.SCN, section 5

section section_5(5) {  // len=778
    setDialogOwner(5);
    showTextbox("I'm tired of training here.\nWhat should I do?\n");
    setDialogOwner(Entity.Player);
    showTextbox("What to do?\n");
    setDialogOwner(5);
    showTextbox("Where do you train?\n");
    if (trigger(205)) goto L_0160;
    setDialogOwner(Entity.Player);
    showTextbox("Is that a training ground?\n");
    setDialogOwner(5);
    showTextbox("I'm tired of training.\nI want to do live battle.\n");
    return;
L_0160:
    setDialogOwner(Entity.Player);
    setSelection(L_01ce, L_0238);
    showTextbox("Maybe it's a training ground\nMaybe it's an Arena\n");
L_01ce:
    setDialogOwner(5);
    showTextbox("I'm tired of training.\nI want to do live battle.\n");
    return;
L_0238:
    setDialogOwner(5);
    showTextbox("I want to go there.\nI'll train there.\n");
    goto L_028e;
L_028e:
    move(entity: 5, to: (-1342, -2147), sprint: 1);
    if (pstat[101] >= 3) goto L_02b6;
    addPStat(101, 1);
    delay(20);
    look(entity: Entity.Player, at: 5);
    look(entity: Entity.Partner, at: 5);
    goto L_028e;
L_02b6:
    waitForEntity(5);
    unloadEntity(5);
    setPStat(101, 0);
    playSound(8, 17);
    setDialogOwner(Entity.System);
    showTextbox("Kabuterimon joins the city!\n");
    setTrigger(219);
    addPStat(1, 2);
    return;
}
