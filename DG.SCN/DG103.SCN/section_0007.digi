section_7(7):     ; len=910
  0000:  if hasTech(MassMorph) == 0 then section_7+0x6e
  000c:  speak 7 "You're strong.\nThere's nothing to teach you.\n"
  006c:  endSection
  006e:  speak 7 "We're researching Techniques.\nIt's difficult to master\nhard Techniques.\n"
  0104:  showTextbox "If you have ability, you\nmight master the Techniques.\nWant to master the hard ones?\n"
  01b0:  setDialogOwner Player
  01b2:  setSelection section_7+0x1ee section_7+0x38c
  01b8:  showTextbox "Of course!\nNo, I don't\n"
  01ea:  waitForSelectionChoice
  01ec:  endSection
  01ee:  speak 7 "Then I'll try it.\n"
  0218:  if stat[Defense] >= 500 then section_7+0x27a
  0226:  speak 7 "You lack Defensive Power.\nTrain more.\n"
  0278:  endSection
  027a:  if stat[Speed] >= 500 then section_7+0x2c8
  0288:  speak 7 "You lack Speed.\nTrain more.\n"
  02c6:  endSection
  02c8:  if stat[MaxHP] >= 500 then section_7+0x310
  02d6:  speak 7 "You lack HP.\nTrain more.\n"
  030e:  endSection
  0310:  learnMove MassMorph
  0312:  speak 7 "You mastered a Technique.\n"
  034c:  speak System "You mastered the 'Bug'!\n"
  0382:  waitForEntity 7
