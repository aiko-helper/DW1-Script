// DG103.SCN, section 83

section section_83(83) {  // len=592
    rotate(entity: Entity.Player, to: 1968);
    setTextboxOrigin(-1330, 0, 1434);
    callSubroutine(39);
    setDialogOwner(200);
    showTextbox("<GREEN>Training: Striking <WHITE>\n");
    setSelection(L_0076, L_00b4, L_018e);
    showTextbox("Begin\nExplain\nQuit\n");
    waitForSelectionChoice();
    return;
L_0076:
    setDialogOwner(200);
    setSelection(L_0190, L_01a0, L_018e);
    showTextbox("Normal\nBonus Try\nQuit\n");
    waitForSelectionChoice();
    return;
L_00b4:
    setDialogOwner(200);
    showTextbox("Using a dummy, strike at\nfull force. Offensive Power\nis boosted greatly.\n");
    setSelection(L_00b4, L_0076, L_018e);
    showTextbox("Explain again\nBegin\nQuit\n");
    waitForSelectionChoice();
    return;
L_018e:
    return;
L_0190:
    fadeOutHUD();
    setPStat(254, 1);
    setPStat(246, 0);
    callDigimonSubroutine(214);
    callSubroutine(7);
    return;
L_01a0:
    setTexboxMode(1, 0);
    setDialogOwner(Entity.System);
    showTextbox("<YELLOW>slot game <WHITE>\nUse <LIGHTBLUE><X> <WHITE>to\nmatch three pictures.\n");
    setPStat(254, 1);
    setPStat(246, 1);
    callDigimonSubroutine(214);
    callSubroutine(7);
    setTexboxMode(0, 0);
    return;
    garbage { 1c 00 fe 00 1c 00 05 00 1e 00 06 00 28 03 07 00 16 08 51 00 a4 0b 53 00 b0 0d ff ff fe 00 1b 05 1a 00 82 68 81 75 82 8d 81 40 82 94 82 89 82 92 82 85 82 84 81 40 };
}
