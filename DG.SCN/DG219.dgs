// DG219.SCN
#include "functions.dgs"
#pragma script index=219 start=0xbf800 end=0xc1000 headerU16=0xc sentinelOff=0xfe
#include "entities.dgs"

section onEnter(254) {
  return;
}

section(51) {
  speak(Entity.Player, "It's a Digimon card vending\nmachine. I think you can\nget a card for one hund bits.\n");
