    showTextbox("Let's try it");
    dead_string("??one hund bits.\nNot now\n");
    waitForSelectionChoice();
    return;

L1:
    if (money >= 100) goto L2;
    speak(Entity.Player, "I don't have enough bits.\n");
    return;

L2:
    reduceMoney(100);
    roll(pstat: 110, max: 99);
    if (pstat[110] > 0) goto L3;
    goto L8;

L3:
    if (pstat[110] > 2) goto L4;
    goto L13;

L4:
    if (pstat[110] > 9) goto L5;
    goto L33;

L5:
