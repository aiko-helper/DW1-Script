  showTextbox("Let's try it");
  dead_string("??one hund bits.\nNot now\n");
  waitForSelectionChoice();
  return;

L1:
  if (money < 100) {
    speak(Entity.Player, "I don't have enough bits.\n");
    return;
  }
  reduceMoney(100);
  roll(pstat: PStat.RollScratch, max: 99);
  if (pstat[110] <= 0) {
  } else {
    if (pstat[110] <= 2) { goto L3; }
    if (pstat[110] <= 9) { goto L4; }
    if (pstat[110] <= 29) { goto L5; }
    if (pstat[110] <= 99) {
      goto L6;

L2:
    }
    return;
  }
  roll(pstat: PStat.RollScratch, max: 4);
