// DG029.SCN
#include "functions.dgs"
#pragma script index=29 start=0x1a000 end=0x1b000 headerU16=0x18 sentinelOff=0x1a64
#include "entities.dgs"

section onEnter(254) {
  callSubroutine(26);
  callSubroutine(27);
  if (pstat[30] < 5 || pstat[17] >= 3 || pstat[17] < 1) goto L1;
  callSubroutine(20);
  callSubroutine(20);
  callSubroutine(20);
  callSubroutine(20);
  callSubroutine(20);
  callSubroutine(20);
  callSubroutine(20);
  callSubroutine(20);
  callSubroutine(20);
  callSubroutine(20);
  setPStat(254, 2);
  callSubroutine(19);
  setPStat(19, 2);
  setObjectVisibility(19, 1);
  setObjectVisibility(18, 1);
  setPStat(18, 10);
  return;

L1:
  playAnimation(5, 29);
  setObjectVisibility(19, 1);
  setObjectVisibility(18, 0);
  if (pstat[18] < 5) goto L2;
  setObjectVisibility(19, 0);
  setObjectVisibility(18, 1);
  setPStat(19, 1);

L2:
  if (pstat[18] < 10) goto L3;
  if (pstat[17] >= 3) goto L3;
  setObjectVisibility(19, 1);
  setObjectVisibility(18, 1);
  setPStat(19, 2);

L3:
  if (pstat[17] != 3) goto L4;
  setPStat(254, 0);
  callSubroutine(19);

L4:
  if (pstat[17] != 4) goto L5;
  setPStat(254, 1);
  callSubroutine(19);

L5:
  if (pstat[18] >= 8) goto L6;
  setRectImpassible(69, 41, 3, 2);

L6:
  return;
}

section(52) {
  if (pstat[19] < 2) goto L1;
  return;

L1:
  goto section_51.L1;
}

section(51) {
  if (pstat[19] < 1) goto L1;
  return;

L1:
  look(entity: 5, at: Entity.Player);
  look(entity: Entity.Player, at: 5);
  waitForEntity(5);
  if (pstat[18] < 10) goto L2;
  speak(5, "I think we're finished moving\nout most of the dirt.\n");
  showTextbox("Our job is going well.\nThanks.\nPlease wait a little more.\n");
  rotate(entity: 5, to: 1900);
  waitForEntity(5);
  move(entity: Entity.Player, to: (2735, 1203), sprint: 0, withCamera: true);
  waitForEntity(Entity.Player);
  playAnimation(5, 29);
  return;

L2:
  if (pstat[17] != 4) goto L3;
  speak(5, "Thanks for your work.\nHere's your payment.\n");
  setPStat(254, 2);
  callSubroutine(19);
  addMoney(500);
  addStats(offense: 5, defense: 5, maxHP: 50, tiredness: 10);
  speak(Entity.System, "I got five hund bits\nfor work!\n");
  showTextbox("HP is up by fifty!\nOffense Power is up five!\nDefense Power is up five!\n");
  addPStat(18, 1);
  setPStat(17, 1);
  rotate(entity: 5, to: 1900);
  waitForEntity(5);
  move(entity: Entity.Player, to: (2735, 1203), sprint: 0, withCamera: true);
  waitForEntity(Entity.Player);
  playAnimation(5, 29);
  return;

L3:
  if (pstat[17] != 3) goto L4;
  speak(5, "Please dump the dirt\noutside the tunnel.\n");
  move(entity: Entity.Player, to: (2735, 1203), sprint: 0, withCamera: true);
  waitForEntity(Entity.Player);
  rotate(entity: 5, to: 1900);
  return;

L4:
  if (pstat[17] != 2) goto L5;
  speak(5, "Take it from the pile of dirt.\n");
  rotate(entity: 5, to: 1900);
  waitForEntity(5);
  move(entity: Entity.Player, to: (2735, 1203), sprint: 0, withCamera: true);
  waitForEntity(Entity.Player);
  playAnimation(5, 29);
  return;

L5:
  if (pstat[17] != 1 || stat[Stat.Tiredness] < 70) goto L6;
  speak(5, "Are you going to carry dirt?\n");
  showTextbox("Your Digimon looks tired.\nWhy don't you rest him first.\n");
  rotate(entity: 5, to: 1900);
  waitForEntity(5);
  move(entity: Entity.Player, to: (2735, 1203), sprint: 0, withCamera: true);
  waitForEntity(Entity.Player);
  playAnimation(5, 29);
  return;

L6:
  if (pstat[17] != 1) goto L7;
  speak(5, "Are you going to carry dirt?\n");
  setDialogOwner(Entity.Player);
  choice { "Yes" -> L9, "No" -> L10 }
  goto L10;

L7:
  if (trigger(140)) goto L8;
  speak(5, "This is not a place for\namateurs. Stay away,\nit's too dangerous.\n");
  move(entity: Entity.Player, to: (2735, 1203), sprint: 0, withCamera: true);
  waitForEntity(Entity.Player);
  rotate(entity: 5, to: 1900);
  waitForEntity(5);
  playAnimation(5, 29);
  return;

L8:
  setPStat(17, 1);
  setPStat(30, 0);
  speak(5, "This tunnel hasn't been\nopened yet. Don't get\nin our way.\n");
  speak(Entity.Player, "I'm sorry. Do you know\nwhen it will be?\n");
  speak(5, "I don't know,\nit will take a while.\n");
  speak(Entity.Player, "That's a problem.\nCan we help?\n");
  speak(5, "Are you trying to\nsteal our fun?\nMaybe you can carry dirt.\n");
  speak(Entity.Player, "What is it?\n");
  moveCamera(to: (2027, 764), slowdown: 20);
  waitForEntity(200);
  delay(30);
  speak(5, "I dug up that dirt.\nYou can carry it out\nand dump it.\n");
  moveCamera(to: Entity.Player, speed: 20);
  waitForEntity(200);
  speak(5, "It's a hard job, so I'll\npay you five hund bits\nfor each round trip.\n");
  speak(Entity.Player, "This will make digging go\nfaster. I can make money,\nand it's good training.\n");
  setDialogOwner(Entity.Player);
  choice { "OK" -> L9, "No thanks" -> L10 }
  goto L10;

L9:
  setTextboxSize(21, 6);
  showTextbox("Dirt Transport Job\nUse <LIGHTBLUE><X> <WHITE>to set a\ndirt box in front of dirt.\nDump dirt outside tunnel.\nOnce you finish a round,\nplease tell Drimogemon.\n");
  fadeOutHUD();
  move(entity: Entity.Player, to: (2735, 1203), sprint: 0, withCamera: true);
  waitForEntity(Entity.Player);
  setPStat(17, 2);
  return;

L10:
  speak(5, "Are you scared?\n");
  rotate(entity: 5, to: 1900);
  waitForEntity(5);
  move(entity: Entity.Player, to: (2735, 1203), sprint: 0, withCamera: true);
  waitForEntity(Entity.Player);
  playAnimation(5, 29);
  return;
}

section(81) {
  if (pstat[17] != 2) goto L1;
  speak(Entity.System, "Dirt box is added.\n");
  setPStat(17, 3);
  setPStat(254, 0);
  callSubroutine(19);
  callSubroutine(20);

L1:
  return;
}

section(5) {
  return;
  garbage { 18 00 fe 00 18 00 34 00 de 00 33 00 f0 00 51 00 a0 0b 05 00 e6 0b ff ff 64 1a 64 1b 19 00 0a 00 1e 05 8d 00 11 03 8a 00 11 01 18 00 5c 00 19 00 64 14 64 14 64 14 64 14 64 14 64 14 64 14 64 14 64 14 64 14 1e 00 fe 02 64 13 1e 00 13 02 57 00 13 01 57 00 12 01 1e 00 12 0a fe 00 56 00 05 1d 57 00 13 01 57 00 12 00 19 00 0a 00 12 05 18 00 80 00 19 00 57 00 13 00 57 00 12 01 1e 00 13 01 19 00 0a 00 12 0a 18 00 a4 00 19 00 19 00 0d 00 11 03 18 00 a4 00 19 00 57 00 13 01 57 00 12 01 1e 00 13 02 19 00 08 00 11 03 18 00 b6 00 19 00 1e 00 fe 00 64 13 19 00 08 00 11 04 18 00 c8 00 19 00 1e 00 fe 01 64 13 19 00 0d 00 12 08 18 00 dc 00 19 00 7c 00 45 00 29 00 03 02 fe 00 19 00 0a 00 13 02 18 00 ec 00 19 00 fe 00 16 00 fe 00 19 00 0a 00 13 01 18 00 fe 00 19 00 fe 00 4c 00 05 fd 4c 00 fd 05 4a 05 19 00 0a 00 12 0a 18 00 10 02 19 00 1b 05 1a 00 82 68 81 40 82 94 82 88 82 89 82 8e 82 8b 81 40 82 97 82 85 81 75 82 92 82 85 81 40 82 86 82 89 82 8e 82 89 82 93 82 88 82 85 82 84 81 40 82 8d 82 8f 82 96 82 89 82 8e 82 87 0d 00 82 8f 82 95 82 94 81 40 82 8d 82 8f 82 93 82 94 81 40 82 8f 82 86 81 40 82 94 82 88 82 85 81 40 82 84 82 89 82 92 82 94 81 42 0d 00 00 00 1a 00 82 6e 82 95 82 92 81 40 82 8a 82 8f 82 82 81 40 82 89 82 93 81 40 82 87 82 8f 82 89 82 8e 82 87 81 40 82 97 82 85 82 8c 82 8c 81 42 0d 00 82 73 82 88 82 81 82 8e 82 8b 82 93 81 42 0d 00 82 6f 82 8c 82 85 82 81 82 93 82 85 81 40 82 97 82 81 82 89 82 94 81 40 82 81 81 40 82 8c 82 89 82 94 82 94 82 8c 82 85 81 40 82 8d 82 8f 82 92 82 85 81 42 0d 00 00 00 4d 05 6c 07 4a 05 52 fd af 0a b3 04 00 00 4a fd 56 00 05 1d fe 00 19 00 08 00 11 04 18 00 88 03 19 00 1b 05 1a 00 82 73 82 88 82 81 82 8e 82 8b 82 93 81 40 82 86 82 8f 82 92 81 40 82 99 82 8f 82 95 82 92 81 40 82 97 82 8f 82 92 82 8b 81 42 0d 00 82 67 82 85 82 92 82 85 81 75 82 93 81 40 82 99 82 8f 82 95 82 92 81 40 82 90 82 81 82 99 82 8d 82 85 82 8e 82 94 81 42 0d 00 00 00 1e 00 fe 02 64 13 2a 00 f4 01 00 00 35 00 05 00 35 01 05 00 35 04 32 00 35 08 0a 00 1b ff 1a