// DG029.SCN
#include "functions.dgs"
#pragma script index=29 start=0x19800 end=0x1a000 headerU16=0x10 sentinelOff=0x19
#include "entities.dgs"

section onEnter(254) {
  if (!trigger(120)) {
    spawnBoulder();
    setRectImpassible(42, 39, 9, 6);
  }
  setObjectVisibility(0, 1);
  return;
}

section(51) {
  if (!trigger(209)) {
    warp(to: Map.TUNN07, spawn: 0, trigger: 255);
    return;
  }
  warp(to: Map.TUNN07_2, spawn: 0, trigger: 255);
  return;
}

section(5) {
  {
    if (!trigger(120)) {
      break;
    } else {
      goto L1;
    }
    return;
  }
  speak(Entity(5), "「やべえ、硬い大岩に当たっちまった!」<NEWLINE>");
  showTextbox("「こいつぁ、俺っちでも掘るのはムリだ。」<NEWLINE>");
  speak(Entity.Player, "「えっ、無理って…そんなぁ!」<NEWLINE>");
  speak(Entity(5), "「どうにか押してどかすしかねえ…。<NEWLINE> おめえら、できるか?」<NEWLINE>");
  anim(Entity.Player, Animation(19), wait: 20);
  speak(Entity.Player, "「う~ん?!」<NEWLINE>");
  look(entity: Entity.Player, at: Entity.Partner);
  anim(Entity.Player, Animation(14), wait: 20);
  speak(Entity.Player, "「<ORANGE><DIGIMON><WHITE>、頼むぞ!」<NEWLINE>");
  move(entity: Entity.Partner, to: (-337, 170), sprint: 0);
  look(entity: Entity.Player, at: Entity.Partner);
  waitForEntity(Entity.Partner);
  delay(20);
  rotate(entity: Entity.Partner, to: 2000);
  look(entity: Entity(5), at: Entity.Partner);
  look(entity: Entity.Player, at: Entity.Partner);
  storeDigimonType(PStat(103));
  {
    if (pstat[103] == 1 || pstat[103] == 2 || pstat[103] == 3 || pstat[103] == 4 || pstat[103] == 15) {
      break;
    }
    if (pstat[103] == 16 || pstat[103] == 17 || pstat[103] == 18 || pstat[103] == 29 || pstat[103] == 30) {
      break;
    }
    if (pstat[103] == 31 || pstat[103] == 32 || pstat[103] == 43 || pstat[103] == 44 || pstat[103] == 45) {
      break;
    }
    if (pstat[103] == 46 || pstat[103] == 57) {
      break;
    }
    playAnimation(Entity.Partner, Animation(27));
    setObjectVisibility(0, 0);
    moveBoulder(0, 50);
    sfx(8, 3, wait: 20);
    moveBoulder(0, 100);
    move(entity: Entity.Partner, to: (-337, 270), sprint: 0);
    sfx(8, 3, wait: 20);
    moveBoulder(0, 100);
    move(entity: Entity.Partner, to: (-337, 370), sprint: 0);
    sfx(8, 3, wait: 20);
    moveBoulder(0, 100);
    move(entity: Entity.Partner, to: (-337, 470), sprint: 0);
    sfx(8, 3, wait: 20);
    moveBoulder(10, 200);
    move(entity: Entity.Partner, to: (-337, 670), sprint: 0);
    sfx(8, 3, wait: 5);
    moveBoulder(50, 300);
    sfx(8, 3, wait: 5);
    moveBoulder(60, 400);
    sfx(8, 3, wait: 5);
    moveBoulder(80, 500);
    sfx(8, 3, wait: 3);
    moveBoulder(80, 600);
    sfx(8, 3, wait: 3);
    moveBoulder(80, 600);
    sfx(8, 3, wait: 3);
    moveBoulder(120, 300);
    sfx(8, 3, wait: 2);
    moveBoulder(120, 100);
    sfx(8, 3, wait: 2);
    moveBoulder(120, 100);
    sfx(8, 3, wait: 1);
    despawnBoulder();
    sfx(8, 3, wait: 20);
    anim(Entity.Partner, Animation(0), wait: 5);
    setObjectVisibility(0, 1);
    speak(Entity.Player, "「やったー!」<NEWLINE>");
    speak(Entity(5), "「ひょお、すげえ力だ!岩が動いたぜ。」<NEWLINE>");
    speak(Entity.Player, "「奥は空洞らしいぞ…」<NEWLINE>");
    rotate(entity: Entity.Player, to: 2000);
    move(entity: Entity.Player, to: (-131, 1250), sprint: 0);
    waitForEntity(Entity.Player);
    rotate(entity: Entity.Player, to: 2000);
    speak(Entity.Player, "「わ、溶岩の川だ!危ない危ない。」<NEWLINE>");
    showTextbox("「川べりの道が奥へ続いてる…行こう!」<NEWLINE>");
    speak(Entity(5), "「おい、中へ行くのか?気をつけろ!」<NEWLINE>");
    setTrigger(Trigger(120));
    warp(to: Map.TUNN07, spawn: 0, trigger: 255);
    return;

L1:
    speak(Entity(5), "「おい、中へ行くのか?気をつけろ!」<NEWLINE>");
    return;
  }
  delay(20);
  anim(Entity.Partner, Animation(27), wait: 20);
  anim(Entity.Partner, Animation(1), wait: 30);
  speak(Entity(5), "「だめだな…<ORANGE><DIGIMON><WHITE>がもう少し<NEWLINE> 成長したらまた来てくれ。」<NEWLINE>");
  move(entity: Entity.Player, to: (-337, 0), sprint: 0);
  waitForEntity(Entity.Player);
  return;
