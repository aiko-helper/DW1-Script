// source: extract/DIGIMON/SCN/DG.SCN
// DG029.SCN, section 51

section section_51(51) {  // len=2736
    if (pstat[19] < 1) goto L_000e;
    return;
L_000e:
    look(entity: 5, at: Entity.Player);
    look(entity: Entity.Player, at: 5);
    waitForEntity(5);
    if (pstat[18] < 10) goto L_0120;
    setDialogOwner(5);
    showTextbox("I think we're finished moving\nout most of the dirt.\n");
    showTextbox("Our job is going well.\nThanks.\nPlease wait a little more.\n");
    rotate(entity: 5, to: 1900);
    waitForEntity(5);
    move(entity: Entity.Player, to: (2735, 1203), sprint: 0, withCamera: true);
    waitForEntity(Entity.Player);
    playAnimation(5, 29);
    return;
L_0120:
    if (pstat[17] != 4) goto L_0298;
    setDialogOwner(5);
    showTextbox("Thanks for your work.\nHere's your payment.\n");
    setPStat(254, 2);
    callSubroutine(19);
    addMoney(500);
    addStats(Stat.Offense, 5);
    addStats(Stat.Defense, 5);
    addStats(Stat.MaxHP, 50);
    addStats(Stat.Tiredness, 10);
    setDialogOwner(Entity.System);
    showTextbox("I got five hund bits\nfor work!\n");
    showTextbox("HP is up by fifty!\nOffense Power is up five!\nDefense Power is up five!\n");
    addPStat(18, 1);
    setPStat(17, 1);
    rotate(entity: 5, to: 1900);
    waitForEntity(5);
    move(entity: Entity.Player, to: (2735, 1203), sprint: 0, withCamera: true);
    waitForEntity(Entity.Player);
    playAnimation(5, 29);
    return;
L_0298:
    if (pstat[17] != 3) goto L_030c;
    setDialogOwner(5);
    showTextbox("Please dump the dirt\noutside the tunnel.\n");
    move(entity: Entity.Player, to: (2735, 1203), sprint: 0, withCamera: true);
    waitForEntity(Entity.Player);
    rotate(entity: 5, to: 1900);
    return;
L_030c:
    if (pstat[17] != 2) goto L_0372;
    setDialogOwner(5);
    showTextbox("Take it from the pile of dirt.\n");
    rotate(entity: 5, to: 1900);
    waitForEntity(5);
    move(entity: Entity.Player, to: (2735, 1203), sprint: 0, withCamera: true);
    waitForEntity(Entity.Player);
    playAnimation(5, 29);
    return;
L_0372:
    if (pstat[17] != 1 || stat[Stat.Tiredness] < 70) goto L_044e;
    setDialogOwner(5);
    showTextbox("Are you going to carry dirt?\n");
    showTextbox("Your Digimon looks tired.\nWhy don't you rest him first.\n");
    rotate(entity: 5, to: 1900);
    waitForEntity(5);
    move(entity: Entity.Player, to: (2735, 1203), sprint: 0, withCamera: true);
    waitForEntity(Entity.Player);
    playAnimation(5, 29);
    return;
L_044e:
    if (pstat[17] != 1) goto L_04ba;
    setDialogOwner(5);
    showTextbox("Are you going to carry dirt?\n");
    setDialogOwner(Entity.Player);
    setSelection(L_0946, L_0a74);
    showTextbox("Yes\nNo\n");
    waitForSelectionChoice();
    goto L_0a74;
L_04ba:
    if (trigger(140)) goto L_0564;
    setDialogOwner(5);
    showTextbox("This is not a place for\namateurs. Stay away,\nit's too dangerous.\n");
    move(entity: Entity.Player, to: (2735, 1203), sprint: 0, withCamera: true);
    waitForEntity(Entity.Player);
    rotate(entity: 5, to: 1900);
    waitForEntity(5);
    playAnimation(5, 29);
    return;
L_0564:
    setPStat(17, 1);
    setPStat(30, 0);
    setDialogOwner(5);
    showTextbox("This tunnel hasn't been\nopened yet. Don't get\nin our way.\n");
    setDialogOwner(Entity.Player);
    showTextbox("I'm sorry. Do you know\nwhen it will be?\n");
    setDialogOwner(5);
    showTextbox("I don't know,\nit will take a while.\n");
    setDialogOwner(Entity.Player);
    showTextbox("That's a problem.\nCan we help?\n");
    setDialogOwner(5);
    showTextbox("Are you trying to\nsteal our fun?\nMaybe you can carry dirt.\n");
    setDialogOwner(Entity.Player);
    showTextbox("What is it?\n");
    moveCamera(to: (2027, 764), slowdown: 20);
    waitForEntity(200);
    delay(30);
    setDialogOwner(5);
    showTextbox("I dug up that dirt.\nYou can carry it out\nand dump it.\n");
    moveCamera(to: Entity.Player, speed: 20);
    waitForEntity(200);
    setDialogOwner(5);
    showTextbox("It's a hard job, so I'll\npay you five hund bits\nfor each round trip.\n");
    setDialogOwner(Entity.Player);
    showTextbox("This will make digging go\nfaster. I can make money,\nand it's good training.\n");
    setDialogOwner(Entity.Player);
    setSelection(L_0946, L_0a74);
    showTextbox("OK\nNo thanks\n");
    waitForSelectionChoice();
    goto L_0a74;
L_0946:
    setTextboxSize(21, 6);
    showTextbox("Dirt Transport Job\nUse <LIGHTBLUE><X> <WHITE>to set a\ndirt box in front of dirt.\nDump dirt outside tunnel.\nOnce you finish a round,\nplease tell Drimogemon.\n");
    fadeOutHUD();
    move(entity: Entity.Player, to: (2735, 1203), sprint: 0, withCamera: true);
    waitForEntity(Entity.Player);
    setPStat(17, 2);
    return;
L_0a74:
    setDialogOwner(5);
    showTextbox("Are you scared?\n");
    rotate(entity: 5, to: 1900);
    waitForEntity(5);
    move(entity: Entity.Player, to: (2735, 1203), sprint: 0, withCamera: true);
    waitForEntity(Entity.Player);
    playAnimation(5, 29);
    return;
}
