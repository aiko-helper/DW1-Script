// DG097.SCN
#pragma script index=97 start=0x43800 end=0x44000 headerU16=0x2c sentinelOff=0xe75

function speakThenStartBattleThenSetTrigger(a, b, c) {
    speak(a, b);
    startBattle();
    setTrigger(c);
}


section onEnter(254) {
    spawnChest(Item.Medicine, 79, 725, 0, 665);
    return;
}

section(51) {
    move(entity: Entity.Player, to: (9, -3988), sprint: 0);
    warp(to: Map.ICSA04, spawn: 1, trigger: 255);
    return;
}

section(52) {
    warp(to: Map.ICSA02, spawn: 3, trigger: 255);
    return;
}

section(53) {
    warp(to: Map.ICSA03, spawn: 1, trigger: 255);
    return;
}

section(54) {
    warp(to: Map.ICSA01, spawn: 2, trigger: 255);
    return;
}

section(55) {
    warp(to: Map.ICSA06, spawn: 0, trigger: 255);
    return;
}

section(5) {
    speakThenStartBattleThenSetTrigger(5, "Who are you?\n", 304);
    return;
}

section(6) {
    speakThenStartBattleThenSetTrigger(6, "It's all a waste of time.\n", 304);
    return;
}

section(7) {
    speakThenStartBattleThenSetTrigger(7, "Looks like I caught a cold.\n", 294);
    return;
}

