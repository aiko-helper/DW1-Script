// DG097.SCN
#include "functions.dgs"
#pragma script index=97 start=0x3f000 end=0x3f800 headerU16=0x30 sentinelOff=0x24
#include "entities.dgs"

section onEnter(254) {
  spawnItemChance(max: 99, chance: 3, item: Item.GoldAcorn, x: 36, y: 69);
  return;
}

section(81) {
  if (item[Item.BlueFlute] >= 1) {
    speak(Entity.System, "<LIGHTBLUE>湖のぬしの笛<WHITE>をつかいますか?<NEWLINE>");
    setDialogOwner(Entity.Player);
    setSelection(L2, L1);
    showTextbox("「笛をふく。」<NEWLINE>「笛をふかない。」<NEWLINE>");
    waitForSelectionChoice();
    return;
  }
  return;

L1:
  return;
  return;

L2:
  delay(60);
  warp(to: Map.MAYO06, spawn: 0, trigger: 255);
}

section(51) {
  move(entity: Entity.Player, to: (-1061, -331), sprint: 0);
  warp(to: Map.FACT03, spawn: 3, trigger: 255);
  return;
}

section(5) {
  speak(Entity(5), "「ほうこく、ほうこく。」<NEWLINE>");
  finishEncounter(Trigger(311));
}

section(6) {
  speak(Entity(6), "「てき はっけん!」<NEWLINE>");
  finishEncounter(Trigger(311));
}

section(7) {
  speak(Entity(7), "「ワッセ、ワッセ。」<NEWLINE>");
  finishEncounter(Trigger(311));
}

section(8) {
  speak(Entity(8), "「今日はつごうがわるいのに。」<NEWLINE>");
  finishEncounter(Trigger(274));
}

section(9) {
  speak(Entity(9), "「ドクククク…」<NEWLINE>");
  finishEncounter(Trigger(274));
}

section(10) {
  speak(Entity(10), "「ふこうへいじゃないか?」<NEWLINE>");
  finishEncounter(Trigger(274));
}

section(11) {
  speak(Entity(9), "「くいとめろ!」<NEWLINE>");
  finishEncounter(Trigger(311));
}

section(12) {
  speak(Entity(10), "「いそがしい、いそがしい。」<NEWLINE>");
  finishEncounter(Trigger(311));
