section section_60(60) {  // len=260
    move(entity: Entity.Player, axis: 1, to: -150, speed: 1);
    move(entity: Entity.Partner, axis: 1, to: -150, speed: 1);
    delay(20);
    playSound(8, 3);
    move(entity: 5, to: (1457, 2916), animDuration: 30);
    delay(10);
    moveCamera(to: (651, 406), slowdown: 99);
    delay(40);
    setObjectVisibility(105, 0);
    setObjectVisibility(106, 0);
    setObjectVisibility(107, 0);
    setObjectVisibility(108, 0);
    setObjectVisibility(109, 0);
    setPStat(247, 105);
    setPStat(248, 5);
    callSubroutine(21);
    delay(30);
    move(entity: Entity.Player, axis: 1, to: 0, speed: 1);
    move(entity: Entity.Partner, axis: 1, to: 0, speed: 1);
    waitForEntity(Entity.Player);
    waitForEntity(Entity.Partner);
    move(entity: Entity.Player, to: (734, 2222), animDuration: 1);
    move(entity: Entity.Partner, to: (839, 2689), animDuration: 1);
    delay(20);
    move(entity: Entity.Player, to: (832, 804), sprint: 1);
    move(entity: Entity.Partner, to: (300, 805), sprint: 1);
    waitForEntity(Entity.Player);
    waitForEntity(Entity.Partner);
    delay(10);
    moveCamera(to: Entity.Player, speed: 20);
    waitForEntity(200);
    setDialogOwner(Entity.Player);
    showTextbox("I hear a voice coming from\nbehind. The voice is...!\n");
    moveCamera(to: Entity.Player, speed: 10);
    waitForEntity(200);
    return;
}
