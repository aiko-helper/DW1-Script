// DG068.SCN
#include "functions.dgs"
#pragma script index=68 start=0x31000 end=0x31800 headerU16=0x28 sentinelOff=0x24
#include "entities.dgs"

section onEnter(254) {
  roll(pstat: 110, max: 99);
  if (pstat[110] > 8) goto L1;
  spawnItem(Item.Digimushroom, x: 57, y: 61);

L1:
  roll(pstat: 110, max: 99);
  if (pstat[110] > 19) goto L2;
  spawnItem(Item.Digimushroom, x: 35, y: 43);

L2:
  roll(pstat: 110, max: 99);
  if (pstat[110] > 2) goto L3;
  spawnItem(Item.SweetNut, x: 39, y: 18);

L3:
  if (!trigger(328)) goto L4;
  goto L5;

L4:
  for id in 38..40 {
    setObjectVisibility(id, 1);
  }

L5:
  return;
}

section(5) {
  switch (pstat[33]) { case 0: goto L1; case 1: goto L2; case 2: goto L3; }

L1:
  delay(1);
  setPStat(200, 20);
  dealMapDamage(200);
  setObjectVisibility(41, 0);
  setPStat(247, 41);
  setPStat(248, 1);
  callSubroutine(21);
  spawnSpriteAtEntity(5, 10498);
  playSound(8, 0);
  playAnimation(Entity.Partner, 40);
  delay(3);
  playAnimation(Entity.Player, 17);
  look(entity: 5, at: Entity.Player);
  waitForEntity(5);
  setObjectVisibility(41, 1);
  setObjectVisibility(42, 1);
  speak(5, "Ha ha, touch me and\nyou'll get shocked.\n");
  moveCamera(to: Entity.Player, speed: 10);
  waitForEntity(200);
  addPStat(33, 1);
  return;

L2:
  delay(1);
  setPStat(200, 20);
  dealMapDamage(200);
  setObjectVisibility(41, 0);
  setPStat(247, 41);
  setPStat(248, 1);
  callSubroutine(21);
  spawnSpriteAtEntity(5, 10498);
  playSound(8, 0);
  playAnimation(Entity.Partner, 40);
  delay(3);
  playAnimation(Entity.Player, 17);
  look(entity: 5, at: Entity.Player);
  waitForEntity(5);
  setObjectVisibility(41, 1);
  setObjectVisibility(42, 1);
  speak(5, "Don't you wanna be here?\n");
  moveCamera(to: Entity.Player, speed: 10);
  waitForEntity(200);
  addPStat(33, 1);
  return;

L3:
  delay(1);
  setPStat(200, 20);
  dealMapDamage(200);
  setObjectVisibility(41, 0);
  setPStat(247, 41);
  setPStat(248, 1);
  callSubroutine(21);
  spawnSpriteAtEntity(5, 10498);
  playSound(8, 0);
  playAnimation(Entity.Partner, 40);
  delay(3);
  playAnimation(Entity.Player, 17);
  look(entity: 5, at: Entity.Player);
  waitForEntity(5);
  setObjectVisibility(41, 1);
  setObjectVisibility(42, 1);
  moveCamera(to: Entity.Player, speed: 10);
  waitForEntity(200);
  speak(5, "Wow, amazing! He's got guts.\n");
  showTextbox("You're gonna be somebody!\nAlright, I'll help you.\n");
  playAnimation(Entity.Player, 19);
  speak(Entity.Player, "Won't you use your electric\npower for the city?\n");
  speak(5, "City? What's that?\nSounds familiar, but...\n");
  showTextbox("I'll help. I'm Elecmon,\nnice to meet you.\n");
  goto L4;

L4:
  move(entity: 5, to: (-171, -2105), sprint: 1);
  if (pstat[101] >= 6) goto L5;
  addPStat(101, 1);
  delay(10);
  look(entity: Entity.Player, at: 5);
  look(entity: Entity.Partner, at: 5);
  goto L4;

L5:
  waitForEntity(5);
  unloadEntity(5);
  setPStat(101, 0);
  playSound(8, 5);
  speak(Entity.System, "Elecmon joins the city!\n");
  setTrigger(218);
  addPStat(1, 1);
  moveCamera(to: Entity.Player, speed: 10);
  waitForEntity(200);
  return;
}

section(6) {
  speak(6, "Ugghh!\n");
  startBattle();
  setTrigger(295);
  return;
}

section(7) {
  speak(7, "Ahhh!\n");
  startBattle();
  setTrigger(295);
  return;
}

section(8) {
  speak(8, "You're dead meat!\n");
  startBattle();
  setTrigger(297);
  return;
}

section(9) {
  speak(9, "Not Bad.\n");
  startBattle();
  setTrigger(282);
  return;
}

section(10) {
  speak(10, "You got poor taste.\n");
  startBattle();
  setTrigger(282);
  return;
}

section(11) {
  speak(11, "You're cocky! I'll teach you.\n");
  startBattle();
  setTrigger(295);
  return;
}

section(51) {
  if (!trigger(328)) goto L1;
  move(entity: Entity.Player, to: (1020, 4048), sprint: 0);
  warp(to: Map.FACT05, spawn: 1, trigger: 255);

L1:
  rotate(entity: Entity.Player, to: 2048);
  delay(10);
  speak(Entity.Player, "This iron door is hard.\nIf it doesn't open,\nwe can't get in.\n");
  move(entity: Entity.Player, to: (946, 2852), sprint: 1, withCamera: true);
  waitForEntity(Entity.Player);
  return;
