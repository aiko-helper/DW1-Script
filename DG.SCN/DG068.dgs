    playSound(8, 0);
    playAnimation(Entity.Partner, 40);
    delay(3);
    playAnimation(Entity.Player, 17);
    look(entity: 5, at: Entity.Player);
    waitForEntity(5);
    setObjectVisibility(41, 1);
    setObjectVisibility(42, 1);
    setDialogOwner(5);
    showTextbox("Ha ha, touch me and\nyou'll get shocked.\n");
    moveCamera(to: Entity.Player, speed: 10);
    waitForEntity(200);
    addPStat(33, 1);
    return;
L_00a6:
    delay(1);
    setPStat(200, 20);
    dealMapDamage(200);
    setObjectVisibility(41, 0);
    setPStat(247, 41);
    setPStat(248, 1);
    callSubroutine(21);
    spawnSpriteAtEntity(5, 10498);
    playSound(8, 0);
    playAnimation(Entity.Partner, 40);
    delay(3);
    playAnimation(Entity.Player, 17);
    look(entity: 5, at: Entity.Player);
    waitForEntity(5);
    setObjectVisibility(41, 1);
    setObjectVisibility(42, 1);
    setDialogOwner(5);
    showTextbox("Don't you wanna be here?\n");
    moveCamera(to: Entity.Player, speed: 10);
    waitForEntity(200);
    addPStat(33, 1);
