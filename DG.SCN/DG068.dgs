section onEnter(254) {  // len=96
    roll(pstat: 110, max: 99);
    if (pstat[110] > 8) goto L_0016;
    spawnItem(Item.Digimushroom, 57, 61);
L_0016:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 19) goto L_002c;
    spawnItem(Item.Digimushroom, 35, 43);
L_002c:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 2) goto L_0042;
    spawnItem(Item.SweetNut, 39, 18);
L_0042:
    if (!trigger(328)) goto L_0052;
    goto L_005e;
L_0052:
    setObjectVisibility(38, 1);
    setObjectVisibility(39, 1);
    setObjectVisibility(40, 1);
L_005e:
    return;
}

section section_5(5) {  // len=936
    switch (pstat[33]) { case 0: goto L_000a; case 1: goto L_00a6; case 2: goto L_0124; };
L_000a:
    delay(1);
    setPStat(200, 20);
    dealMapDamage(200);
    setObjectVisibility(41, 0);
    setPStat(247, 41);
    setPStat(248, 1);
