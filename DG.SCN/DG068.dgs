L_0124:
    delay(1);
    setPStat(200, 20);
    dealMapDamage(200);
    setObjectVisibility(41, 0);
    setPStat(247, 41);
    setPStat(248, 1);
    callSubroutine(21);
    spawnSpriteAtEntity(5, 10498);
    playSound(8, 0);
    playAnimation(Entity.Partner, 40);
    delay(3);
    playAnimation(Entity.Player, 17);
    look(entity: 5, at: Entity.Player);
    waitForEntity(5);
    setObjectVisibility(41, 1);
    setObjectVisibility(42, 1);
    moveCamera(to: Entity.Player, speed: 10);
    waitForEntity(200);
    setDialogOwner(5);
    showTextbox("Wow, amazing! He's got guts.\n");
    showTextbox("You're gonna be somebody!\nAlright, I'll help you.\n");
    playAnimation(Entity.Player, 19);
    setDialogOwner(Entity.Player);
    showTextbox("Won't you use your electric\npower for the city?\n");
    setDialogOwner(5);
    showTextbox("City? What's that?\nSounds familiar, but...\n");
    showTextbox("I'll help. I'm Elecmon,\nnice to meet you.\n");
    goto L_032e;
L_032e:
    move(entity: 5, to: (-171, -2105), sprint: 1);
    if (pstat[101] >= 6) goto L_0356;
    addPStat(101, 1);
    delay(10);
    look(entity: Entity.Player, at: 5);
    look(entity: Entity.Partner, at: 5);
    goto L_032e;
L_0356:
    waitForEntity(5);
    unloadEntity(5);
    setPStat(101, 0);
    playSound(8, 5);
    setDialogOwner(Entity.System);
    showTextbox("Elecmon joins the city!\n");
    setTrigger(218);
    addPStat(1, 1);
    moveCamera(to: Entity.Player, speed: 10);
    waitForEntity(200);
    return;
}

