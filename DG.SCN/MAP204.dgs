// MAP204.SCN
#include "functions.dgs"
#pragma script index=204 start=0x99000 end=0x99800 headerU16=0x10 sentinelOff=0xfe
#include "entities.dgs"

section onEnter(254) {
  return;
}

section(51) {
    // (empty)
}

section(60) {
  setDigimon(Digimon.NPCMyotismon, Entity(0), 0);
  move(entity: Entity.Player, to: (276, -1057), animDuration: 6);
  move(entity: Entity.Partner, to: (-688, 481), animDuration: 6);
  waitForPair();
  rotate(entity: Entity.Player, to: 2128);
  rotate(entity: Entity.Partner, to: 3072);
  speak(Entity.Player, "(モグモグ…)<NEWLINE>");
  speak(Entity(5), "「さて…」<NEWLINE>");
  look(entity: Entity(5), at: Entity.Player);
  speak(Entity(5), "「話を聞いてもらうとしようか。」<NEWLINE>");
  speak(Entity.Player, "(ムシャムシャ…)<NEWLINE>");
  speak(Entity(5), "「最近私の部下達は、私の言うことを<NEWLINE> 聞かなくなってきている。」<NEWLINE>");
  showTextbox("「反抗的ではないが、命令を<NEWLINE> ぽっかり忘れているようなのだ。」<NEWLINE>");
  showTextbox("「忘れるいぜんに、理解すらしていない時も<NEWLINE> ある。で、本来私の食事は部下が運んで<NEWLINE> くることになっているのだが…」<NEWLINE>");
  speak(Entity.Player, "(パクパク…)<NEWLINE>");
  speak(Entity(5), "「私が研究に熱中する間、食事は全く<NEWLINE> 運ばれてこず…私も熱中のあまり、空腹<NEWLINE> を忘れていたと。で、ああなった。」<NEWLINE>");
  look(entity: Entity.Player, at: Entity(5));
  speak(Entity.Player, "「………熱中しすぎだよ、それは。」<NEWLINE>");
  speak(Entity(5), "「いや、おはずかしい。」<NEWLINE>");
  speak(Entity.Player, "「しかし館の中でも外と同じ異変が<NEWLINE> 起きてるみたいだね。」<NEWLINE>");
  speak(Entity(5), "「ほう、島の異変とは、みんなが<NEWLINE> 私の部下と同じ状態になっている<NEWLINE> ということかね?」<NEWLINE>");
  speak(Entity.Player, "「うん。種族が孤立して、記憶が無く<NEWLINE> なって。まだみんながそうじゃない<NEWLINE> けど、このままだと…」<NEWLINE>");
  speak(Entity(5), "「誰かが、そうなるように仕向けて<NEWLINE> いるのだろうか?うーむ。<NEWLINE> だとしたら何が目的なのか…」<NEWLINE>");
  speak(Entity.Player, "「うーん…」<NEWLINE>");
  speak(Entity(5), "「私は島のために何をすればよいか?」<NEWLINE>");
  speak(Entity.Player, "「俺達は、デジモンの心を一つにする<NEWLINE> ために街をつくっている。島をめぐって<NEWLINE> いるのもその仲間さがしのためさ。」<NEWLINE>");
  speak(Entity(5), "「なるほど。しかし困った。私はともかく<NEWLINE> 部下達は戦うことぐらいしか能の無い<NEWLINE> 連中ばかりだからな。」<NEWLINE>");
  if (!trigger(205)) {
    showTextbox("「かといって部下を置いていく<NEWLINE> わけにもいかん…」<NEWLINE>");
    speak(Entity.Player, "「そうか…」<NEWLINE>");
    speak(Entity(5), "「それについてはいずれ答えをだそう。<NEWLINE> 私もここでやることがあるのでね。<NEWLINE> 本当にすまないが…」<NEWLINE>");
    speak(Entity.Player, "「わかった。じゃあまた来るよ。<NEWLINE> ごはんはちゃんと食べろよな!」<NEWLINE>");
  } else {
    speak(Entity.Player, "「それなら闘技場に出てみたら?」<NEWLINE>");
    speak(Entity(5), "「ほう…闘技場?それは面白いな。<NEWLINE> 部下にカツを入れるにはちょうどよい。<NEWLINE> 私もたまには体を動かしたいしな。」<NEWLINE>");
    speak(Entity.Player, "「じゃあ、参加してくれるのか?!」<NEWLINE>");
    speak(Entity(5), "「ああ、ただ私はここで研究したいものが<NEWLINE> 残っているので、その合間に街に行くこと<NEWLINE> にするよ。よろしく。」<NEWLINE>");
    setTrigger(Trigger(266));
  }
  warp(to: Map.YAKA11A, spawn: 4, trigger: 255);
  return;
  garbage { 10 00 fe 00 10 00 33 00 12 00 3c 00 12 00 ff ff fe 00 47 b1 00 00 6c fd 14 01 df fb 06 00 6c fc 50 fd e1 01 06 00 4a fd 4a fc 4d fd 50 08 4d fc 00 0c 1b fd 1a 00 81 69 83 82 83 4f 83 82 83 4f 81 63 81 6a 0d 00 00 00 1b 05 1a 00 81 75 82 b3 82 c4 81 63 81 76 0d 00 00 00 4c 00 05 fd 1b 05 1a 00 81 75 98 62 82 f0 95 b7 82 a2 82 c4 82 e0 82 e7 82 a4 82 c6 82 b5 82 e6 82 a4 82 a9 81 42 81 76 0d 00 00 00 1b fd 1a 00 81 69 83 80 83 56 83 83 83 80 83 56 83 83 81 63 81 6a }
}
