// source: extract/DIGIMON/SCN/DG.SCN
// DG132.SCN, section 51

section section_51(51) {  // len=1598
    removeCondition(Condition.Injured);
    removeCondition(Condition.Sick);
    look(entity: 5, at: Entity.Player);
    look(entity: Entity.Partner, at: Entity.Player);
    playAnimation(Entity.Player, 24);
    delay(15);
    setDialogOwner(Entity.Player);
    showTextbox("Where are we?\nIs this a dream?\n");
    playAnimation(Entity.Player, 0);
    rotate(entity: Entity.Player, to: 1050);
    delay(20);
    rotate(entity: Entity.Player, to: 1561);
    delay(20);
    look(entity: Entity.Player, at: 5);
    playAnimation(Entity.Player, 15);
    delay(15);
    setDialogOwner(Entity.Player);
    showTextbox("Wow! Who are you?\nWhere is <ORANGE><DIGIMON><WHITE>?\n");
    playAnimation(Entity.Player, 0);
    rotate(entity: Entity.Player, to: 1050);
    delay(5);
    look(entity: Entity.Player, at: 5);
    setDialogOwner(5);
    showTextbox("Calm down. My name is\nFrigimon. This is my house.\nI'm an Ice Snow Digimon.\n");
    showTextbox("You were out cold in the\nsnow. I picked you up\nand took care of you.\n");
    rotate(entity: Entity.Player, to: 25);
    delay(5);
    look(entity: Entity.Player, at: Entity.Partner);
    setDialogOwner(Entity.Player);
    showTextbox("Oh, <ORANGE><DIGIMON><WHITE>.\nI'm glad you're safe!\n");
    setDialogOwner(5);
    showTextbox("Hey, are you listening?\nIf I didn't find you,\nyou'd be dead by now!\n");
    look(entity: Entity.Player, at: 5);
    playAnimation(Entity.Player, 25);
    delay(15);
    setDialogOwner(Entity.Player);
    showTextbox("Oh, sorry. Gee thanks.\n");
    playAnimation(Entity.Player, 0);
    delay(30);
    look(entity: Entity.Player, at: Entity.Partner);
    playAnimation(Entity.Player, 7);
    delay(15);
    setDialogOwner(Entity.Player);
    showTextbox("Hey, <ORANGE><DIGIMON><WHITE>,\nI even hit my head when\nyou suddenly fell down.\n");
    playAnimation(Entity.Player, 0);
    storeDigimonType(103);
    setDialogOwner(5);
    showTextbox("<DIGIMONTYPE2>can't stand cold.\nYou are so reckless.\nIt's all your fault.\n");
    look(entity: Entity.Player, at: 5);
    delay(20);
    look(entity: Entity.Player, at: Entity.Partner);
    playAnimation(Entity.Player, 19);
    delay(15);
    setDialogOwner(Entity.Player);
    showTextbox("I didn't know.\nI'm sorry, <ORANGE><DIGIMON><WHITE>.\n");
    playAnimation(Entity.Player, 0);
    look(entity: Entity.Player, at: 5);
    setDialogOwner(Entity.Player);
    showTextbox("Thanks, Frigimon. Can I ask\nyou one more favor?\n");
    setDialogOwner(5);
    showTextbox("What will you do if\n<DIGIMONTYPE2>falls down again?\nYou'd better go home soon!\n");
    setDialogOwner(Entity.Player);
    showTextbox("Alright, I got it.\nI'll digivolve <ORANGE><DIGIMON><WHITE>\ninto another Digimon.\n");
    move(entity: Entity.Player, to: (93, -1700), sprint: 1);
    delay(20);
    move(entity: Entity.Partner, to: (93, -1700), sprint: 1);
    delay(20);
    look(entity: 5, at: Entity.Player);
    waitForEntity(Entity.Player);
    waitForEntity(Entity.Partner);
    setDialogOwner(5);
    showTextbox("Digivolve?\n");
    setTrigger(133);
    warp(to: Map.FRZL07, spawn: 2, trigger: 255);
    return;
}
