; source: ./extract/DIGIMON/SCN/DG.SCN
; DG132.SCN, section 51

section_51(51):     ; len=1598
  0000:  removeCondition Injured
  0002:  removeCondition Sick
  0004:  lookAt 5 Player
  0008:  lookAt Partner Player
  000c:  playAnimation Player 24
  0010:  delay 15
  0014:  speak Player "Where are we?\nIs this a dream?\n"
  0058:  playAnimation Player 0
  005c:  setRotation Player 1050
  0060:  delay 20
  0064:  setRotation Player 1561
  0068:  delay 20
  006c:  lookAt Player 5
  0070:  playAnimation Player 15
  0074:  delay 15
  0078:  speak Player "Wow! Who are you?\nWhere is <ORANGE><DIGIMON><WHITE>?\n"
  00be:  playAnimation Player 0
  00c2:  setRotation Player 1050
  00c6:  delay 5
  00ca:  lookAt Player 5
  00ce:  speak 5 "Calm down. My name is\nFrigimon. This is my house.\nI'm an Ice Snow Digimon.\n"
  016a:  showTextbox "You were out cold in the\nsnow. I picked you up\nand took care of you.\n"
  01f8:  setRotation Player 25
  01fc:  delay 5
  0200:  lookAt Player Partner
  0204:  speak Player "Oh, <ORANGE><DIGIMON><WHITE>.\nI'm glad you're safe!\n"
  0248:  speak 5 "Hey, are you listening?\nIf I didn't find you,\nyou'd be dead by now!\n"
  02d6:  lookAt Player 5
  02da:  playAnimation Player 25
  02de:  delay 15
  02e2:  speak Player "Oh, sorry. Gee thanks.\n"
  0316:  playAnimation Player 0
  031a:  delay 30
  031e:  lookAt Player Partner
  0322:  playAnimation Player 7
  0326:  delay 15
  032a:  speak Player "Hey, <ORANGE><DIGIMON><WHITE>,\nI even hit my head when\nyou suddenly fell down.\n"
  03a4:  playAnimation Player 0
  03a8:  storeDigimonType 103
  03aa:  speak 5 "<DIGIMONTYPE2>can't stand cold.\nYou are so reckless.\nIt's all your fault.\n"
  042a:  lookAt Player 5
  042e:  delay 20
  0432:  lookAt Player Partner
  0436:  playAnimation Player 19
  043a:  delay 15
  043e:  speak Player "I didn't know.\nI'm sorry, <ORANGE><DIGIMON><WHITE>.\n"
  0482:  playAnimation Player 0
  0486:  lookAt Player 5
  048a:  speak Player "Thanks, Frigimon. Can I ask\nyou one more favor?\n"
  04f0:  speak 5 "What will you do if\n<DIGIMONTYPE2>falls down again?\nYou'd better go home soon!\n"
  057a:  speak Player "Alright, I got it.\nI'll digivolve <ORANGE><DIGIMON><WHITE>\ninto another Digimon.\n"
  05f8:  entityWalkTo Player 93 -1700 1
  0600:  delay 20
  0604:  entityWalkTo Partner 93 -1700 1
  060c:  delay 20
  0610:  lookAt 5 Player
  0614:  waitForEntity Player
  0616:  waitForEntity Partner
  0618:  speak 5 "Digivolve?\n"
  0634:  setTrigger 133
  0638:  warpTo FRZL07 2 255
  063c:  endSection
