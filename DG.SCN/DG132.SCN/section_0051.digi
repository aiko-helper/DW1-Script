  031e:  lookAt Player Partner
  0322:  playAnimation Player 7
  0326:  delay 15
  032a:  setDialogOwner Player
  032c:  showTextbox "Hey, <ORANGE><DIGIMON><WHITE>,\nI even hit my head when\nyou suddenly fell down.\n"
  03a4:  playAnimation Player 0
  03a8:  storeDigimonType 103
  03aa:  setDialogOwner 5
  03ac:  showTextbox "<DIGIMONTYPE2>can't stand cold.\nYou are so reckless.\nIt's all your fault.\n"
  042a:  lookAt Player 5
