  0432:  lookAt Player Partner
  0436:  playAnimation Player 19
  043a:  delay 15
  043e:  setDialogOwner Player
  0440:  showTextbox "I didn't know.\nI'm sorry, <ORANGE><DIGIMON><WHITE>.\n"
  0482:  playAnimation Player 0
  0486:  lookAt Player 5
  048a:  setDialogOwner Player
  048c:  showTextbox "Thanks, Frigimon. Can I ask\nyou one more favor?\n"
  04f0:  setDialogOwner 5
  04f2:  showTextbox "What will you do if\n<DIGIMONTYPE2>falls down again?\nYou'd better go home soon!\n"
  057a:  setDialogOwner Player
  057c:  showTextbox "Alright, I got it.\nI'll digivolve <ORANGE><DIGIMON><WHITE>\ninto another Digimon.\n"
