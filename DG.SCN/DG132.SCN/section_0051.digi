  0078:  setDialogOwner Player
  007a:  showTextbox "Wow! Who are you?\nWhere is <ORANGE><DIGIMON><WHITE>?\n"
  00be:  playAnimation Player 0
  00c2:  setRotation Player 1050
  00c6:  delay 5
  00ca:  lookAt Player 5
  00ce:  setDialogOwner 5
  00d0:  showTextbox "Calm down. My name is\nFrigimon. This is my house.\nI'm an Ice Snow Digimon.\n"
  016a:  showTextbox "You were out cold in the\nsnow. I picked you up\nand took care of you.\n"
  01f8:  setRotation Player 25
  01fc:  delay 5
  0200:  lookAt Player Partner
  0204:  setDialogOwner Player
  0206:  showTextbox "Oh, <ORANGE><DIGIMON><WHITE>.\nI'm glad you're safe!\n"
  0248:  setDialogOwner 5
  024a:  showTextbox "Hey, are you listening?\nIf I didn't find you,\nyou'd be dead by now!\n"
  02d6:  lookAt Player 5
  02da:  playAnimation Player 25
  02de:  delay 15
  02e2:  setDialogOwner Player
  02e4:  showTextbox "Oh, sorry. Gee thanks.\n"
  0316:  playAnimation Player 0
