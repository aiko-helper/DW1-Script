  0064:  setRotation 253 1561
  0068:  delay 20
  006c:  lookAt 253 5
  0070:  playAnimation 253 15
  0074:  delay 15
  0078:  setDialogOwner 253
  007a:  showTextbox "Wow! Who are you?\nWhere is <ORANGE><DIGIMON><WHITE>?\n"
  00be:  playAnimation 253 0
  00c2:  setRotation 253 1050
  00c6:  delay 5
  00ca:  lookAt 253 5
  00ce:  setDialogOwner 5
  00d0:  showTextbox "Calm down. My name is\nFrigimon. This is my house.\nI'm an Ice Snow Digimon.\n"
  016a:  showTextbox "You were out cold in the\nsnow. I picked you up\nand took care of you.\n"
  01f8:  setRotation 253 25
  01fc:  delay 5
  0200:  lookAt 253 252
  0204:  setDialogOwner 253
  0206:  showTextbox "Oh, <ORANGE><DIGIMON><WHITE>.\nI'm glad you're safe!\n"
  0248:  setDialogOwner 5
  024a:  showTextbox "Hey, are you listening?\nIf I didn't find you,\nyou'd be dead by now!\n"
  02d6:  lookAt 253 5
  02da:  playAnimation 253 25
  02de:  delay 15
  02e2:  setDialogOwner 253
  02e4:  showTextbox "Oh, sorry. Gee thanks.\n"
  0316:  playAnimation 253 0
  031a:  delay 30
  031e:  lookAt 253 252
  0322:  playAnimation 253 7
  0326:  delay 15
  032a:  setDialogOwner 253
  032c:  showTextbox "Hey, <ORANGE><DIGIMON><WHITE>,\nI even hit my head when\nyou suddenly fell down.\n"
  03a4:  playAnimation 253 0
  03a8:  storeDigimonType 103
  03aa:  setDialogOwner 5
  03ac:  showTextbox "<DIGIMONTYPE2>can't stand cold.\nYou are so reckless.\nIt's all your fault.\n"
  042a:  lookAt 253 5
  042e:  delay 20
  0432:  lookAt 253 252
  0436:  playAnimation 253 19
  043a:  delay 15
  043e:  setDialogOwner 253
  0440:  showTextbox "I didn't know.\nI'm sorry, <ORANGE><DIGIMON><WHITE>.\n"
  0482:  playAnimation 253 0
  0486:  lookAt 253 5
  048a:  setDialogOwner 253
  048c:  showTextbox "Thanks, Frigimon. Can I ask\nyou one more favor?\n"
  04f0:  setDialogOwner 5
  04f2:  showTextbox "What will you do if\n<DIGIMONTYPE2>falls down again?\nYou'd better go home soon!\n"
  057a:  setDialogOwner 253
  057c:  showTextbox "Alright, I got it.\nI'll digivolve <ORANGE><DIGIMON><WHITE>\ninto another Digimon.\n"
