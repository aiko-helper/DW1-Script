  0114:  lookAt 5 Partner
  0118:  setDialogOwner 5
  011a:  showTextbox "Huh? Is that right?\nI don't get it.\n"
  0166:  lookAt 5 Player
  016a:  setDialogOwner Player
  016c:  showTextbox "I came here cuz I have\na favor to ask. I want you\nto come to the city.\n"
  01fe:  setDialogOwner 5
  0200:  showTextbox "What's there for me?\nSomething interesting?\n"
  025c:  playAnimation Player 19
  0260:  delay 15
  0264:  setDialogOwner Player
  0266:  showTextbox "Well, you can open\nany shop you want.\n"
  02b6:  playAnimation Player 0
  02ba:  playAnimation 5 11
  02be:  delay 5
  02c2:  setDialogOwner 5
  02c4:  showTextbox "Wow, I always wanted to do\nthat. Alright, I'll go!\n"
  032e:  setDialogOwner Player
  0330:  showTextbox "OK, that sounds good.\nThen let's go now.\n"
  0386:  setDialogOwner 5
  0388:  showTextbox "A shop! Snow cones and\nice cream. This is\ngonna be great!\n"
