section_7(7):     ; len=470
  0000:  speak 7 "Shogun is collecting\nrare Items. He used to\ncollect Items.\n"
  007c:  showTextbox "But now he's really\ninto Digimon cards.\n"
  00d0:  speak 7 "If you bring a rare card,\nhe will give you\nMerit points.\n"
  0148:  speak 7 "You can collect"
  016c:  .string "?"  ; dead string
  0170:  .string "? card,\nMerit points and\ntrade them for Items.\n"  ; dead string
  01d0:  setTrigger 122
  01d4:  endSection
