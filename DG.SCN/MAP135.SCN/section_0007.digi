section_7(7):     ; len=470
  0000:  setDialogOwner 7
  0002:  showTextbox "Shogun is collecting\nrare Items. He used to\ncollect Items.\n"
  007c:  showTextbox "But now he's really\ninto Digimon cards.\n"
  00d0:  setDialogOwner 7
  00d2:  showTextbox "If you bring a rare card,\nhe will give you\nMerit points.\n"
  0148:  setDialogOwner 7
  014a:  showTextbox "You can collect"
  016c:  .string "?"  ; dead string
  0170:  .string "? card,\nMerit points and\ntrade them for Items.\n"  ; dead string
  01d0:  setTrigger 122
  01d4:  endSection
