// source: extract/DIGIMON/SCN/DG.SCN
// MAP135.SCN, section 81

section section_81(81) {  // len=792
    look(entity: Entity.Player, at: 5);
    look(entity: Entity.Partner, at: 5);
    delay(10);
    moveCamera(to: (-400, 2100), slowdown: 20);
    waitForEntity(200);
    playSound(8, 1);
    storeDigimonType(103);
    if (!trigger(116) || pstat[103] == 14) goto L_01f2;
    setDialogOwner(5);
    showTextbox("Looks like you got a problem.\nAbout the costume, right?\n");
    setDialogOwner(Entity.Player);
    showTextbox("You know about it?\n");
    setDialogOwner(5);
    showTextbox("Don't underrate me. Numemon\nwill be able to wear it.\n");
    showTextbox("Shocked? Not only that, once\nhe wears it... You won't\nbelieve... Well, try it out.\n");
    unsetTrigger(116);
    moveCamera(to: Entity.Player, speed: 10);
    waitForEntity(200);
    return;
L_01f2:
    if (!trigger(122)) goto L_02e4;
    setPStat(254, 5);
    callSubroutine(1);
    moveCamera(to: Entity.Player, speed: 10);
    waitForEntity(200);
    if (item[Item.AmazingRod] < 1) goto L_02e2;
    removeItem(Item.AmazingRod, 1);
    setTrigger(46);
    setDialogOwner(5);
    showTextbox("By the way, I'll remove the\n<LIGHTBLUE>Amazing Rod <WHITE>for\nFishing from your Items.\n");
    showTextbox("It's a Special Item.\n");
L_02e2:
    return;
L_02e4:
    if (!trigger(319)) goto section_6;
    playSound(8, 1);
    setDialogOwner(5);
    showTextbox("Good luck!\n");
    moveCamera(to: Entity.Player, speed: 10);
    waitForEntity(200);
    return;
}
