; source: ./extract/DIGIMON/SCN/DG.SCN
; MAP135.SCN, section 5

section_5(5):     ; len=3342
  0000:  entityWalkToWithCamera Player -77 119 0
  0008:  entityWalkTo Partner 397 151 0
  0010:  waitForEntity Player
  0012:  waitForEntity Partner
  0014:  lookAt Player 5
  0018:  lookAt Partner 5
  001c:  delay 10
  0020:  moveCameraTo 20 -400 2100
  0026:  waitForEntity 200
  0028:  playSound 8 1
  002c:  speak 5 " <LIGHTBLUE><PLAYER><WHITE> and <ORANGE><DIGIMON><WHITE>,\nright? Thanks for coming\nto Volume Villa!\n"
  00a2:  playAnimation Player 22
  00a6:  delay 20
  00aa:  speak Player "I'm sorry for what\nwe did to Otamamon.\n"
  00fe:  playAnimation Player 0
  0102:  speak 5 "Never mind.\n"
  0120:  playAnimation Player 23
  0124:  delay 20
  0128:  speak Player "Huh?\n"
  0138:  playAnimation Player 0
  013c:  playAnimation 5 5
  0140:  delay 38
  0144:  playAnimation 5 0
  0148:  speak 5 "I'm grateful. I heard that\nyou've been working hard\nto save this island.\n"
  01e0:  speak Player "You did?\n"
  01f8:  speak 5 "I've been wanting to help you.\nHave you been to Misty Trees\njust north of here?\n"
  029e:  if trigger(112) then section_5+0x2c2
  02aa:  speak Player "Not yet.\n"
  02c2:  if !trigger(112) then section_5+0x2de
  02ce:  speak Player "Yes.\n"
  02de:  speak 5 "It's always foggy there.\nIt'll probably be hard\nfor you to get around.\n"
  0372:  showTextbox "But you should meet\nCherrymon, who is the\nforest chief.\n"
  03e6:  if !trigger(147) then section_5+0x3f6
  03f2:  jump section_5+0x954
  03f6:  playAnimation Player 16
  03fa:  delay 20
  03fe:  speak Player "Cherrymon? I've never heard\nof such a Digimon.\n"
  0462:  speak 5 "Cherrymon makes the fog\nin Misty Trees.\n"
  04b8:  showTextbox "He created fog to protect\nthe forest from danger.\n"
  0520:  playAnimation Player 25
  0524:  delay 20
  0528:  speak Player "But that's a problem for us.\n"
  0568:  playAnimation 5 5
  056c:  delay 38
  0570:  playAnimation 5 0
  0574:  speak 5 "I think Cherrymon knows\nsomething about the cause\nof the island's trouble.\n"
  0610:  showTextbox "It's worth going thru\nthe fog to see him.\n"
  0668:  speak Player "If we can do something\nabout the fog.\n"
  06ba:  speak 5 "The only one who can get rid\nof the fog is Cherrymon.\n"
  072c:  showTextbox "But here's a way to get thru.\nI'll put a spell on you.\n"
  079e:  speak Player "What's gonna happen?\n"
  07ce:  speak 5 "You'll be able to see\nthe road even in the fog.\n"
  0834:  playAnimation 5 0
  0838:  playAnimation Player 19
  083c:  delay 20
  0840:  speak Player "Oh, that's good!\n"
  0868:  speak 5 "OK, then I'll start.\n"
  0898:  speak 5 "Ribbit, ribbit!\n"
  08be:  playAnimation 5 31
  08c2:  playSound 8 0
  08c6:  delay 70
  08ca:  playAnimation 5 0
  08ce:  playAnimation Player 15
  08d2:  delay 30
  08d6:  speak 5 "Good. That's perfect.\nNow, go to Misty Trees.\n"
  0938:  playAnimation 5 30
  093c:  delay 55
  0940:  playAnimation 5 0
  0944:  setTrigger 319
  0948:  setTrigger 114
  094c:  moveCameraToEntity Player 10
  0950:  waitForEntity 200
  0952:  endSection
  0954:  speak Player "I met him.\nThe fog is gone now.\n"
  099a:  speak 5 "Wow, that's amazing! Well,\nwhat can I do to help you?\n"
  0a0c:  showTextbox "Okay, let me give you this.\n"
  0a48:  playAnimation 5 0
  0a4c:  speak System "I got a\n<LIGHTBLUE>Digital Sea Bass<WHITE>!\n"
  0a8a:  if !trigger(0) OR item[Digiseabass] >= 1 then section_5+0xae0
  0a9c:  speak System "Throw away something else.\n"
  0ad8:  unsetTrigger 3
  0adc:  callSubroutine 0
  0ade:  callSubroutine 13
  0ae0:  giveItem Digiseabass 1
  0ae4:  speak 5 "It's a very rare thing.\nIt'll be useful to you.\n"
  0b4a:  playAnimation Player 19
  0b4e:  delay 20
  0b52:  speak Player "Thanks. So why don't you\ncome to the city, Shogun?\n"
  0bbe:  speak 5 "I'm chief of a hund Gekomon\nin Geko Swamp. I'm sorry,\nbut I can't come with you.\n"
  0c66:  showTextbox "But instead, I'll do\nanything I can from here.\nCome anytime you want.\n"
  0cf6:  playAnimation 5 30
  0cfa:  delay 55
  0cfe:  playAnimation 5 0
  0d02:  setTrigger 319
  0d06:  moveCameraToEntity Player 10
  0d0a:  waitForEntity 200
  0d0c:  endSection
