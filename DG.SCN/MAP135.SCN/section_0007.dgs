section section_7(7) {  // len=470
    setDialogOwner(7);
    showTextbox("Shogun is collecting\nrare Items. He used to\ncollect Items.\n");
    showTextbox("But now he's really\ninto Digimon cards.\n");
    setDialogOwner(7);
    showTextbox("If you bring a rare card,\nhe will give you\nMerit points.\n");
    setDialogOwner(7);
    showTextbox("You can collect");
    dead_string("?");
    dead_string("? card,\nMerit points and\ntrade them for Items.\n");
    setTrigger(122);
    return;
}
