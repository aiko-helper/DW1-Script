// source: extract/DIGIMON/SCN/DG.SCN
// MAP135.SCN, section 5

section section_5(5) {  // len=3342
    move(entity: Entity.Player, to: (-77, 119), sprint: 0, withCamera: true);
    move(entity: Entity.Partner, to: (397, 151), sprint: 0);
    waitForEntity(Entity.Player);
    waitForEntity(Entity.Partner);
    look(entity: Entity.Player, at: 5);
    look(entity: Entity.Partner, at: 5);
    delay(10);
    moveCamera(to: (-400, 2100), slowdown: 20);
    waitForEntity(200);
    playSound(8, 1);
    setDialogOwner(5);
    showTextbox(" <LIGHTBLUE><PLAYER><WHITE> and <ORANGE><DIGIMON><WHITE>,\nright? Thanks for coming\nto Volume Villa!\n");
    playAnimation(Entity.Player, 22);
    delay(20);
    setDialogOwner(Entity.Player);
    showTextbox("I'm sorry for what\nwe did to Otamamon.\n");
    playAnimation(Entity.Player, 0);
    setDialogOwner(5);
    showTextbox("Never mind.\n");
    playAnimation(Entity.Player, 23);
    delay(20);
    setDialogOwner(Entity.Player);
    showTextbox("Huh?\n");
    playAnimation(Entity.Player, 0);
    playAnimation(5, 5);
    delay(38);
    playAnimation(5, 0);
    setDialogOwner(5);
    showTextbox("I'm grateful. I heard that\nyou've been working hard\nto save this island.\n");
    setDialogOwner(Entity.Player);
    showTextbox("You did?\n");
    setDialogOwner(5);
    showTextbox("I've been wanting to help you.\nHave you been to Misty Trees\njust north of here?\n");
    if (trigger(112)) goto L_02c2;
    setDialogOwner(Entity.Player);
    showTextbox("Not yet.\n");
L_02c2:
    if (!trigger(112)) goto L_02de;
    setDialogOwner(Entity.Player);
    showTextbox("Yes.\n");
L_02de:
    setDialogOwner(5);
    showTextbox("It's always foggy there.\nIt'll probably be hard\nfor you to get around.\n");
    showTextbox("But you should meet\nCherrymon, who is the\nforest chief.\n");
    if (!trigger(147)) goto L_03f6;
    goto L_0954;
L_03f6:
    playAnimation(Entity.Player, 16);
    delay(20);
    setDialogOwner(Entity.Player);
    showTextbox("Cherrymon? I've never heard\nof such a Digimon.\n");
    setDialogOwner(5);
    showTextbox("Cherrymon makes the fog\nin Misty Trees.\n");
    showTextbox("He created fog to protect\nthe forest from danger.\n");
    playAnimation(Entity.Player, 25);
    delay(20);
    setDialogOwner(Entity.Player);
    showTextbox("But that's a problem for us.\n");
    playAnimation(5, 5);
    delay(38);
    playAnimation(5, 0);
    setDialogOwner(5);
    showTextbox("I think Cherrymon knows\nsomething about the cause\nof the island's trouble.\n");
    showTextbox("It's worth going thru\nthe fog to see him.\n");
    setDialogOwner(Entity.Player);
    showTextbox("If we can do something\nabout the fog.\n");
    setDialogOwner(5);
    showTextbox("The only one who can get rid\nof the fog is Cherrymon.\n");
    showTextbox("But here's a way to get thru.\nI'll put a spell on you.\n");
    setDialogOwner(Entity.Player);
    showTextbox("What's gonna happen?\n");
    setDialogOwner(5);
    showTextbox("You'll be able to see\nthe road even in the fog.\n");
    playAnimation(5, 0);
    playAnimation(Entity.Player, 19);
    delay(20);
    setDialogOwner(Entity.Player);
    showTextbox("Oh, that's good!\n");
    setDialogOwner(5);
    showTextbox("OK, then I'll start.\n");
    setDialogOwner(5);
    showTextbox("Ribbit, ribbit!\n");
    playAnimation(5, 31);
    playSound(8, 0);
    delay(70);
    playAnimation(5, 0);
    playAnimation(Entity.Player, 15);
    delay(30);
    setDialogOwner(5);
    showTextbox("Good. That's perfect.\nNow, go to Misty Trees.\n");
    playAnimation(5, 30);
    delay(55);
    playAnimation(5, 0);
    setTrigger(319);
    setTrigger(114);
    moveCamera(to: Entity.Player, speed: 10);
    waitForEntity(200);
    return;
L_0954:
    setDialogOwner(Entity.Player);
    showTextbox("I met him.\nThe fog is gone now.\n");
    setDialogOwner(5);
    showTextbox("Wow, that's amazing! Well,\nwhat can I do to help you?\n");
    showTextbox("Okay, let me give you this.\n");
    playAnimation(5, 0);
    setDialogOwner(Entity.System);
    showTextbox("I got a\n<LIGHTBLUE>Digital Sea Bass<WHITE>!\n");
    if (!trigger(0) || item[Item.Digiseabass] >= 1) goto L_0ae0;
    setDialogOwner(Entity.System);
    showTextbox("Throw away something else.\n");
    unsetTrigger(3);
    callSubroutine(0);
    callSubroutine(13);
L_0ae0:
    giveItem(Item.Digiseabass, 1);
    setDialogOwner(5);
    showTextbox("It's a very rare thing.\nIt'll be useful to you.\n");
    playAnimation(Entity.Player, 19);
    delay(20);
    setDialogOwner(Entity.Player);
    showTextbox("Thanks. So why don't you\ncome to the city, Shogun?\n");
    setDialogOwner(5);
    showTextbox("I'm chief of a hund Gekomon\nin Geko Swamp. I'm sorry,\nbut I can't come with you.\n");
    showTextbox("But instead, I'll do\nanything I can from here.\nCome anytime you want.\n");
    playAnimation(5, 30);
    delay(55);
    playAnimation(5, 0);
    setTrigger(319);
    moveCamera(to: Entity.Player, speed: 10);
    waitForEntity(200);
    return;
}
