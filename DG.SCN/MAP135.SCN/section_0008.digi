section_8(8):     ; len=1362
  0000:  if trigger(205) then section_8+0x4e
  000c:  speak 8 "Well... no, nothing. Ribbit.\n"
  004c:  endSection
  004e:  speak 8 "Excuse me... I want to go to\nthe city. Ribbit!\n"
  00b2:  speak Player "OK, but what happened?\n"
  00e6:  speak 8 "I wanna fight at the Arena.\nIt seems like we,\nthe Gekomon Tribe,"
  016c:  .string "? Arena.\n"  ; dead string
  0180:  showTextbox "are looked down upon\nas country Digimon. Ribbit.\n"
  01e6:  showTextbox "Yeah, we're from the country,\nbut we have our pride too!"
  025a:  .string "?,\nRibbit.\n"  ; dead string
  0272:  speak Player "I see how you feel.\nThen, try it. Good luck!\n"
  02d2:  speak System "Gekomon joined the Arena!\n"
  030c:  endSection
