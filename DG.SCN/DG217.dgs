#pragma script index=217 start=0xbc000 end=0xbd800 headerU16=0xc sentinelOff=0xfe

function reduceMoneyThenSpeakThenShowTextboxThenPlayAnimationThenWaitForEntity(a, b, c) {
    reduceMoney(a);
    speak(Entity.System, b);
    showTextbox(c);
    playAnimation(Entity.Partner, 11);
    waitForEntity(Entity.Partner);
}

function playAnimationThenWaitForEntityThenSpeak() {
    playAnimation(Entity.Partner, 13);
    waitForEntity(Entity.System);
    speak(5, "<ORANGE><DIGIMON><WHITE> doesn't seem\nto be hungry.\n");
}


