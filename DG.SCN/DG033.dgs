// DG033.SCN
#include "functions.dgs"
#pragma script index=33 start=0x1d000 end=0x1d800 headerU16=0x10 sentinelOff=0x1775
#include "entities.dgs"

section onEnter(254) {
  spawnChest(Item.OffenseChip, 2483, 247, 1024, 658);
  spawnChest(Item.SpeedChip, 2544, -110, 1024, 659);
  return;
}

section(5) {
  speak(Entity(5), "Are you still hot?\nSome Digimon can't handle\nthe heat and get sick.\n");
  return;
}

