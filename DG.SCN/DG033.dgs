// DG033.SCN
#include "functions.dgs"
#pragma script index=33 start=0x1b800 end=0x1c000 headerU16=0x28 sentinelOff=0x24
#include "entities.dgs"

section onEnter(254) {
  spawnItemChance(max: 99, chance: 9, item: Item.Digimushroom, x: 56, y: 78);
  spawnItemChance(max: 99, chance: 19, item: Item.Digimushroom, x: 24, y: 44);
  spawnItemChance(max: 99, chance: 4, item: Item.SuperVeggy, x: 36, y: 24);
  spawnItemChance(max: 99, chance: 2, item: Item.Happymushroom, x: 79, y: 6);
  if (trigger(348) && !trigger(128)) {
    spawnItem(Item.Steak, x: 48, y: 32);
  }
  return;
}

section(6) {
  speak(Entity(6), "「ヒヒッ、恐いんだろう?」<NEWLINE>");
  finishEncounter(Trigger(296));
}

section(7) {
  speak(Entity(7), "「早くお家に帰った方がいいぞ!」<NEWLINE>");
  finishEncounter(Trigger(296));
}

section(8) {
  speak(Entity(8), "「1度入ったら、2度と出られないよ…」<NEWLINE>");
  finishEncounter(Trigger(296));
}

section(9) {
  speak(Entity(9), "「ヒヒヒヒヒヒ~!」<NEWLINE>");
  finishEncounter(Trigger(307));
}

section(10) {
  speak(Entity(10), "「ま~て~。」<NEWLINE>");
  finishEncounter(Trigger(307));
}

section(11) {
  speak(Entity(11), "「とりつくぞ~。」<NEWLINE>");
  finishEncounter(Trigger(307));
}

section(5) {
  anim(Entity(5), Animation(11), wait: 50);
  playAnimation(Entity(5), Animation(0));
  speak(Entity(5), "「バケバケ?」<NEWLINE>");
  playAnimation(Entity.Player, Animation(16));
  speak(Entity.Player, "「(何だ?何か質問してるみたいだが…)」<NEWLINE>");
  setTrigger(Trigger(49));
  setSelection(L1, L4);
  showTextbox("「??…はい。」<NEWLINE>「??…いいえ。」<NEWLINE>");

L1:
  anim(Entity(5), Animation(11), wait: 45);
  playAnimation(Entity(5), Animation(0));
  speak(Entity(5), "「バケッ!バケバケ?」<NEWLINE>");
  setDialogOwner(Entity.Player);
  setSelection(L2, L4);
  showTextbox("「うーん……はい。」<NEWLINE>「えーと…いいえ。」<NEWLINE>");

L2:
  anim(Entity(5), Animation(12), wait: 58);
  playAnimation(Entity(5), Animation(0));
  playAnimation(Entity.Player, Animation(15));
  speak(Entity(5), "「バケー…バケバケ。バケー?」<NEWLINE>");
  playAnimation(Entity.Player, Animation(16));
  setDialogOwner(Entity.Player);
  setSelection(L4, L3);
  showTextbox("「むむむ……はい。」<NEWLINE>「うっ……いいえ。」<NEWLINE>");

L3:
  {
    anim(Entity(5), Animation(13), wait: 34);
    playAnimation(Entity(5), Animation(13));
    speak(Entity(5), "「バケバケ!バケーバケバケー!」<NEWLINE>");
    break;
  }
  loop {
    unsetTrigger(Trigger(49));
    move(entity: Entity(5), to: (1299, -1074), sprint: 1);
    if (pstat[101] >= 10) break;
    addPStat(PStat.LoopIterator, 1);
    delay(5);
    lookPairAt(Entity(5));
  }
  waitForEntity(Entity(5));
  unloadEntity(Entity(5));
  setPStat(PStat.LoopIterator, 0);
  playSound(8, 11);
  speak(Entity.System, "バケモンが街に参加した!!!<NEWLINE>");
  playAnimation(Entity.Player, Animation(16));
  speak(Entity.Player, "「何かうまくいった……気がする。」<NEWLINE>");
  setTrigger(Trigger(237));
  addPStat(PStat(1), 2);
  return;

L4:
  unsetTrigger(Trigger(49));
  playAnimation(Entity(5), Animation(29));
  sfx(8, 0, wait: 40);
  waitForEntity(Entity(5));
  unloadEntity(Entity(5));
  speak(Entity.Player, "「何だ…?おこらせちゃったかな?」<NEWLINE>");
  return;
}

section(51) {
  if (pstat[16] == 2) {
    move(entity: Entity.Player, to: (-140, 4669), sprint: 0);
    warp(to: Map.MGEN11, spawn: 0, trigger: 60);
  }
  storeDigimonType(PStat(103));
  storeDigimonTypus(103, PStat(109));
  if (pstat[109] == 3) {
    move(entity: Entity.Player, to: (0, 5000), sprint: 0);
    move(entity: Entity.Partner, to: (0, 5000), sprint: 0);
    playSound(8, 1);
    warp(to: Map.YAKA11A, spawn: 0, trigger: 255);
    return;
  } else {
    speak(Entity.System, "謎の黒い力にさえぎられた!<NEWLINE>");
    fadeOutHUD();
    move(entity: Entity.Player, to: (-200, 3658), sprint: 1, withCamera: true);
    move(entity: Entity.Partner, to: (100, 3658), sprint: 1);
    waitForPair();
    delay(10);
    rotate(entity: Entity.Player, to: 3100);
    delay(10);
    rotate(entity: Entity.Player, to: 2076);
    speak(Entity.Player, "「な、何だ?足が勝手に…」<NEWLINE>");
  }
  return;
  garbage { 28 00 fe 00 28 00 06 00 98 00 07 00 c8 00 08 00 fe 00 09 00 3a 01 0a 00 64 01 0b 00 88 01 05 00 b0 01 33 00 1a 04 ff ff 24 00 6e 63 19 00 0b 00 6e 09 18 00 3e 00 19 00 74 2c 38 00 4e 00 24 00 6e 63 19 00 0b 00 6e 13 18 00 54 00 19 00 74 2c 18 00 2c 00 24 00 6e 63 19 00 0b 00 6e 04 18 00 6a 00 19 00 74 35 24 00 18 00 24 00 6e 63 19 00 0b 00 6e 02 18 00 80 00 19 00 74 45 4f 00 06 00 19 00 00 00 5c 01 81 00 80 00 18 00 96 00 19 00 74 7a 30 00 20 00 fe 00 1b 06 1a 00 81 75 83 71 83 71 83 62 81 41 8b b0 82 a2 82 f1 82 be 82 eb 82 a4 81 48 81 76 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 28 01 fe 00 1b 07 1a 00 81 75 91 81 82 ad 82 a8 89 c6 82 c9 8b 41 82 c1 82 bd 95 fb 82 aa 82 a2 82 a2 82 bc 81 49 81 76 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 28 01 fe 00 1b 08 1a 00 81 75 82 50 93 78 93 fc 82 c1 82 bd 82 e7 81 41 82 51 93 78 82 c6 8f 6f 82 e7 82 ea 82 c8 82 a2 82 e6 81 63 81 76 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 28 01 fe 00 1b 09 1a 00 81 75 83 71 83 71 83 71 83 71 83 71 83 71 81 60 81 49 81 76 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 33 01 fe 00 1b 0a 1a 00 81 75 82 dc 81 60 82 c4 81 60 81 42 81 76 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 33 01 fe 00 1b 0b 1a 00 81 75 82 c6 82 e8 82 c2 82 ad 82 bc 81 60 81 42 81 76 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 33 01 fe 00 56 00 05 0b 67 00 32 00 56 00 05 00 1b 05 1a 00 81 75 83 6f 83 50 83 6f 83 50 81 48 81 76 0d 00 00 00 56 00 fd 10 1b fd 1a 00 81 75 81 69 89 bd 82 be 81 48 89 bd 82 a9 8e bf 96 e2 82 b5 82 c4 82 e9 82 dd 82 bd 82 a2 82 be 82 aa 81 63 81 6a 81 76 0d 00 00 00 1c 00 31 00 10 02 3a 02 da 03 1a 00 81 75 81 48 81 48 81 63 82 cd 82 a2 81 42 81 76 0d 00 81 75 81 48 81 48 81 63 82 a2 82 a2 82 a6 81 42 81 76 0d 00 00 00 56 00 05 0b 67 00 2d 00 56 00 05 00 1b 05 1a 00 81 75 83 6f 83 50 83 62 81 49 83 6f 83 50 83 6f 83 50 81 48 81 76 0d 00 00 00 1b fd 10 02 9c 02 da 03 1a 00 81 75 82 a4 81 5b 82 f1 81 63 81 63 82 cd 82 a2 81 42 81 76 0d 00 81 75 82 a6 81 5b 82 c6 81 63 82 a2 82 a2 82 a6 81 42 81