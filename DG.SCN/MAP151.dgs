// MAP151.SCN
#include "functions.dgs"
#pragma script index=151 start=0x6a800 end=0x6c800 headerU16=0x10 sentinelOff=0xfe
#include "entities.dgs"

section onEnter(254) {
  return;
}

section(51) {
  warp(to: Map.FACT03, spawn: 2, trigger: 255);
  return;
}

section(5) {
  if (!trigger(240)) goto L1;
  speak(5, "It's all cool here.\nGood luck.\n");
  return;

L1:
  if (!trigger(330)) goto L2;
  speak(5, "I must help, too. I'll go\nback and forth between here\nand the city whenever I can.\n");
  playSound(8, 10);
  speak(Entity.System, "Andromon joins the city!\n");
  setTrigger(240);
  addPStat(1, 3);
  return;

L2:
  if (!trigger(329)) goto L3;
  speak(5, "Data repair is complete.\nNow, let's read data.\n");
  rotate(entity: 5, to: 2048);
  delay(20);
  playSound(8, 5);
  speak(Entity.Player, "Please.\n");
  playSound(8, 6);
  speak(Entity.System, "One hundred years ago,\nAnalog Humans appeared\non Digimon island.\n");
  showTextbox("Analog Humans and native\nDigimon fought very hard.\n");
  showTextbox("After ten years of battle,\nthe Analog Humans were\ndefeated and disappeared.\n");
  showTextbox("In the next ten years,\nmysteriously, the island's\narea almost doubled in size.\n");
  anim(Entity.Player, 16, wait: 15);
  speak(Entity.Player, "So humans fought Digimon?\n");
  playAnimation(Entity.Player, 0);
  speak(5, "I'm sorry. That's all the\ndata we could recover.\n");
  rotate(entity: 5, to: 0);
  delay(20);
  speak(Entity.Player, "Don't worry. This is \nvery important information.\nNow I know so much more.\n");
  speak(5, "Is that right?\n");
  anim(Entity.Player, 25, wait: 15);
  speak(Entity.Player, "These humans are probably the\nones who caused confusion and\ntrouble on the island.\n");
  playAnimation(Entity.Player, 0);
  speak(5, "Can humans live\none hundred years?\n");
  speak(Entity.Player, "It seems that for humans,\ntime is slow in this world.\n");
  showTextbox("I guess that's why I don't\nhave to eat or sleep here.\n");
  showTextbox("One hundred years is a\nvery long time. Those guys\nmust be very tough.\n");
  speak(5, "Do you think they are\nhiding somewhere?\n");
  speak(Entity.Player, "I'll find them\nand do something.\n");
  showTextbox("Now I know why I'm here. \nSince I'm human,\nI need to deal with them.\n");
  setTrigger(330);
  return;

L3:
  if (!trigger(211) || trigger(328)) goto L4;
  speak(5, "We're so sorry. We'll close\nthe factory for a while.\n");
  anim(Entity.Player, 19, wait: 15);
  speak(Entity.Player, "Because of the trouble now,\nno one can say what's gonna\nhappen. It's not your fault.\n");
  playAnimation(Entity.Player, 0);
  speak(Entity.Player, "I think there's somebody\ncontrolling Giromon.\n");
  showTextbox("Computers were destroyed and\nwaste water started to leak.\n");
  showTextbox("That water made Digimons\ninsane. I don't think\nit's a coincidence.\n");
  speak(5, "These computers have some\nkey importance.\n");
  showTextbox("It may be too late,\nbut I think someone was\ntrying to get us.\n");
  speak(Entity.Player, "What?!\n");
  speak(5, "I think there was some data\nregarding the island's past\non these computers.\n");
  showTextbox("But due to the Giromon's\nriot, the data was destroyed.\n");
  speak(Entity.Player, "You've never seen the data?\n");
  speak(5, "No, but we might be able to\nrepair some of it. I'll\ntry to connect the data.\n");
  speak(Entity.Player, "I see, thank you.\nHow long will it take?\n");
  speak(5, "It'll be a while. I'll\nreopen the town entrance,\nso come back again.\n");
  speak(Entity.Player, "Thanks. I'll be back.\n");
  setTrigger(328);
  return;

L4:
  if (!trigger(328)) goto L5;
  speak(Entity.Player, "Have you finish\nrepairing the data?\n");
  speak(5, "It'll take a while longer.\nCome back again.\n");
  speak(Entity.Player, "OK, I'll be back.\n");
  return;

L5:
  if (!trigger(344) || trigger(211) || trigger(341)) goto L6;
  anim(Entity.Player, 7, wait: 10);
  speak(Entity.Player, "Hey, hey!\n");
  speak(5, "I have to apologize.\n");
  anim(Entity.Player, 7, wait: 15);
  speak(Entity.Player, "Do that later, you gotta stop\nthe factory's machines now!\n");
  playAnimation(Entity.Player, 0);
  speak(5, "Alright, I will.\n");
  rotate(entity: 5, to: 2048);
  delay(20);
  playSound(8, 5);
  speak(5, "The factory's function has\njust stopped.\n");
  speak(Entity.Player, "Good, I'll check the sewer.\nLaters, dude.\n");
  setTrigger(341);
  return;

L6:
  if (!trigger(341)) goto L7;
  speak(5, "I must apologize.\n");
  speak(Entity.Player, "We don't got time\nto discuss that now!\n");
  return;

L7:
  if (!trigger(343)) goto L8;
  speak(5, "Our computer is perfect.\n");
  speak(Entity.Player, "Is the factory really safe?\nWhat can we do now?\n");
  anim(Entity.Player, 16, wait: 20);
  playAnimation(Entity.Player, 0);
  speak(Entity.Player, "OK, we gotta do something\nabout the guards. We don't\nhave any other way!\n");
  return;

L8:
  speak(5, "How did you get into town?\n");
  if (trigger(347)) goto L9;
  speak(5, "If you don't have any\nbusiness here, leave now!\n");
  return;

L9:
  if (trigger(344) || !trigger(347) || trigger(343)) goto L10;
  speak(Entity.Player, "We can talk about that later.\nI gotta check out\nthe factory now.\n");
  showTextbox("This is a life and death\nsituation. Give me the okay!\n");
  speak(5, "I don't quite understand\nwhat you're trying to do.\nI can't give you permission.\n");
  speak(Entity.Player, "There are Digimon about to\nfade away because of the\nwaste water from the factory!\n");
  speak(5, "From the factory? No way!\nThe waste water cleaning\nsystem is working fine.\n");
  speak(Entity.Player, "How can you know it's working\nfine if we don't check?!\n");
  anim(Entity.Player, 19, wait: 5);
  speak(5, "Our computer is perfect. In\nemergencies, the Net Keeper\nwill shut down the system.\n");
  speak(Entity.Player, "Are you telling me that\nNet Keeper will always\nwork correctly?\n");
  anim(Entity.Player, 0, wait: 5);
  speak(5, "Net Keeper is another\nname for Giromon who is\nan Ultimate Digimon.\n");
  showTextbox("His judgement and ability\nare so perfect.\n");
  speak(Entity.Player, "He is a Digimon?! Oh no, we\nare in even more trouble now.\nPlease, give me permission!\n");
  anim(Entity.Player, 19, wait: 5);
  speak(5, "Leave! Now!\n");
  anim(Entity.Player, 22, wait: 10);
  speak(Entity.Player, "Sigh...Rats!\n");
  setTrigger(343);

L10:
  return;
  garbage { 10 00 fe 00 10 00 33 00 12 00 05 00 18 00 ff ff fe 00 4b 9a 02 ff fe 00 19 00 00 00 f0 00 18 00 6a 00 19 00 1b 05 1a 00 82 68 82 94 81 75 82 93 81 40 82 81 82 8c 82 8c 81 40 82 83 82 8f 82 8f 82 8c 81 40 82 88 82 85 82 92 82 85 81 42 0d 00 82 66 82 8f 82 8f 82 84 81 40 82 8c 82 95 82 83 82 8b 81 42 0d 00 00 00 fe 00 19 00 00 00 4a 01 18 00 68 01 19 00 1b 05 1a 00 82 68 81 40 82 8d 82 95 82 93 82 94 81 40 82 88 82 85 82 8c 82 90 81 43 81 40 82 94 82 8f 82 8f 81 42 81 40 82 68 81 75 82 8c 82 8c 81 40 82 87 82 8f 0d 00 82 82 82 81 82 83 82 8b 81 40 82 81 82 8e 82 84 81 40 82 86 82 8f 82 92 82 94 82 88 81 40 82 82 82 85 82 94 82 97 82 85 82 85 82 8e 81 40 82 88 82 85 82 92 82 85 0d 00 82 81 82 8e 82 84 81 40 82 94 82 88 82 85 81 40 82 83 82 89 82 94 82 99 81 40 82 97 82 88 82 85 82 8e 82 85 82 96 82 85 82 92 81 40 82 68 81 40 82 83 82 81 82 8e 81 42 0d 00 00 00 5a 00 08 0a 1b ff 1a 00 82 60 82 8e 82 84 82 92 82 8f 82 8d 82 8f 82 8e 81 40 82 8a 82 8f 82 89 82 8e 82 93 81 40 82 94 82 88 82 85 81 40 82 83 82 89 82 94 82 99 81 49 0d 00 00 00 1c 00 f0 00 1f 00 01 03 fe 00 19 00 00 00 49 01 18 00 4c 09 19 00 1b 05 1a 00 82 63 82 81 82 94 82 81 81 40 82 92 82 85 82 90 82 81 82 89 82 92 81 40 82 89 82 93 81 40 82 83 82 8f 82 8d 82 90 82 8c 82 85 82 94 82 85 81 42 0d 00 82 6d 82 8f 82 97 81 43 81 40 82 8c 82 85 82 94 81 75 82 93 81 40 82 92 82 85 82 81 82 84 81 40 82 84 82 81 82 94 82 81 81 42 0d 00 00 00 4d 05 00 08 67 00 14 00 5a 00 08 05 1b fd 1a 00 82 6f 82 8c 82 85 82 81 82 93 82 85 81 42 0d 00 00 00 5a 00 08 06 1b ff 1a 00 82 6e 82 8e 82 85 81 40 82 88 82 95 82 8e 82 84 82 92 82 85 82 84 81 40 82 99 82 85 82 81 82 92 82 93 81 40 82 81 82 87 82 8f 81 43 0d 00 82 60 82 8e 82 81 82 8c 82 8f 82 87 81 40 82 67 82 95 82 8d 82 81 82 8e 82 93 81 40 82 81 82 90 82 90 82 85 82 81 82 92 82 85 82 84 0d 00 82 8f 82 8e 81 40 82 63 82 89 82 87 82 89 82 8d 82 8f 82 8e 81 40 82 89 82 93 82 8c 82 81 82 8e 82 84 81 42 0d 00 00 00 1a 00 82 60 82 8e 82 81 82 8c 82 8f 82 87 81 40 82 67 82 95 82 8d 82 81 82 8e 82 93 81 40 82 81 82 8e 82 84 81 40 82 8e 82 81 82 94 82 89 82 96 82 85 0d 00 82 63 82 89 82 87 82 89 82 8d 82 8f 82 8e 81 40 82 86 82 8f 82 95 82 87 82 88 82 94 81 40 82 96 82 85 82 92 82 99 81 40 82 88 82 81 82 92 82 84 81 42 0d 00 00 00 1a 00 82 60 82 86 82 94 82 85 82 92 81 40 82 94 82 85 82 8e 81 40 82 99 82 85 82 81 82 92 82 93 81 40 82 8f 82 86 81 40 82 82 82 81 82 94 82 94 82 8c 82 85 81 43 0d 00 82 94 82 88 82 85 81 40 82 60 82 8e 82 81 82 8c 82 8f 82 87 81 40 82 67 82 95 82 8d 82 81 82 8e 82 93 81 40 82 97 82 85 82 92 82 85 0d 00 82 84 82 85 82 86 82 85 82 81 82 94 82 85 82 84 81 40 82 81 82 8e 82 84 81 40 82 84 82 89 82 93 82 81 82 90 82 90 82 85 82 81 82 92 82 85 82 84 81 42 0d 00 00 00 1a 00 82 68 82 8e 81 40 82 94 82 88 82 85 81 40 82 8e 82 85 82 98 82 94 81 40 82 94 82 85 82 8e 81 40 82 99 82 85 82 81 82 92 82 93 81 43 0d 00 82 8d 82 99 82 93 82 94 82 85 82 92 82 89 82 8f 82 95 82 93 82 8c 82 99 81 43 81 40 82 94 82 88 82 85 81 40 82 89 82 93 82 8c 82 81 82 8e 82 84 81 75 82 93 0d 00 82 81 82 92 82 85 82 81 81 40 82 81 82 8c 82 8d 82 8f 82 93 82 94 81 40 82 84 82 8f 82 95 82 82 82 8c 82 85 82 84 81 40 82 89 82 8e 81 40 82 93 82 89 82 9a 82 85 81 42 0d 00 00 00 56 00 fd 10 67 00 0f 00 1b fd }
}
