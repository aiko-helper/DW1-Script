// MAP151.SCN
#include "functions.dgs"
#pragma script index=151 start=0x66800 end=0x67000 headerU16=0x18 sentinelOff=0x19
#include "entities.dgs"

section onEnter(254) {
  if (trigger(88) && !trigger(50)) {
    playAnimation(Entity(7), Animation(30));
  }
  if (trigger(214)) {
    playAnimation(Entity(6), Animation(30));
  }
  return;
}

section(60) {
  {
    unloadEntity(Entity(5));
    unloadModel(Digimon.Botamon);
    loadAndSetDigimon(Digimon.Jijimon, Entity(3), 0);
    look(entity: Entity(8), at: Entity.Player);
    delay(20);
    speak(Entity(8), "「うむ、とりあえずは大丈夫なようじゃ。」<NEWLINE>");
    speak(Entity.Player, "「ふぅ、よかった…」<NEWLINE>");
    speak(Entity(8), "「こいつのためにも、いっこくも早く親玉を<NEWLINE> 倒さねばなるまいて。」<NEWLINE>");
    speak(Entity.Player, "「…わかってるって。」<NEWLINE>");
    delay(40);
    if (trigger(220) || trigger(214) || pstat[1] >= 50) goto L2; else break;
  }
  {
    if (trigger(221)) goto L1; else break;
  }
  if (trigger(225)) {
    warp(to: Map.TWNA04, spawn: 2, trigger: 255);
  }
  if (trigger(246)) {
    warp(to: Map.TWNA03, spawn: 2, trigger: 255);
  }
  warp(to: Map.TWNA02, spawn: 2, trigger: 255);

L1:
  if (trigger(225)) {
    warp(to: Map.TWNA07, spawn: 2, trigger: 255);
  }
  if (trigger(246)) {
    warp(to: Map.TWNA06, spawn: 2, trigger: 255);
  }
  {
    warp(to: Map.TWNA05, spawn: 2, trigger: 255);

L2:
    if (trigger(221)) goto L3; else break;
  }
  if (trigger(225)) {
    warp(to: Map.TWNA10, spawn: 2, trigger: 255);
  }
  if (trigger(246)) {
    warp(to: Map.TWNA09, spawn: 2, trigger: 255);
  }
  warp(to: Map.TWNA08, spawn: 2, trigger: 255);

L3:
  if (trigger(225)) {
    warp(to: Map.TWNA13, spawn: 2, trigger: 255);
  }
  if (trigger(246)) {
    warp(to: Map.TWNA12, spawn: 2, trigger: 255);
  }
  warp(to: Map.TWNA11, spawn: 2, trigger: 255);
  return;
}

section(5) {
  speak(Entity(5), "「みんながんばってるでしゅ。」<NEWLINE>");
  return;
}

section(6) {
  setTrigger(Trigger(44));
  speak(Entity.Player, "「中身は無いみたいだ。」<NEWLINE>");
  return;
}

section(7) {
  setTrigger(Trigger(44));
  speak(Entity.System, " エアドラモンは眠っている…<NEWLINE>");
  return;
