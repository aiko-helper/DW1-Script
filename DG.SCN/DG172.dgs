    warp(to: Map.MGEN05, spawn: 0, trigger: 255);
    return;
}

section(52) {  // len=14
    move(entity: Entity.Player, to: (-260, 387), sprint: 0);
    warp(to: Map.MGEN03, spawn: 1, trigger: 255);
    return;
}

section(5) {  // len=68
    speak(5, "Just leave it up to me!\n");
    fadeOutHUD();
    delay(1);
    startBattle();
    setTrigger(288);
    return;
}

section(6) {  // len=54
    speak(6, "Get out of here!\n");
    fadeOutHUD();
    delay(1);
    startBattle();
    setTrigger(305);
    return;
}

