    speak(7, "You won't stop me!\n");
    fadeOutHUD();
    delay(1);
    startBattle();
    setTrigger(288);
    return;
}

section(8) {  // len=70
    speak(8, "Alright then, take this!\n");
    fadeOutHUD();
    delay(1);
    startBattle();
    setTrigger(288);
    return;
}

