L13:
    if (!trigger(225)) goto L14;
    warp(to: Map.TWNA10, spawn: 9, trigger: 255);

L14:
    if (!trigger(246)) goto L15;
    warp(to: Map.TWNA09, spawn: 9, trigger: 255);

L15:
    warp(to: Map.TWNA08, spawn: 9, trigger: 255);

L16:
    if (!trigger(225)) goto L17;
    warp(to: Map.TWNA13, spawn: 9, trigger: 255);

L17:
    if (!trigger(246)) goto L18;
    warp(to: Map.TWNA12, spawn: 9, trigger: 255);

L18:
    warp(to: Map.TWNA11, spawn: 9, trigger: 255);
    return;
}

section(5) {  // len=58
    setDialogOwner(5);
    showTextbox("Leave it up to me!\n");
    fadeOutHUD();
    delay(1);
    startBattle();
    setTrigger(288);
    return;
}

section(6) {  // len=74
