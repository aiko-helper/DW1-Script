// MAP160.SCN
#pragma script index=160 start=0x72000 end=0x72800 headerU16=0x24 sentinelOff=0x1275

section onEnter(254) {  // len=14
    spawnChest(Item.OmniDisk, -2663, 277, 3072, 680);
    return;
}

section(51) {  // len=14
    move(entity: Entity.Player, to: (2099, -558), sprint: 0);
    warp(to: Map.MGEN02, spawn: 1, trigger: 255);
    return;
}

section(52) {  // len=250
    move(entity: Entity.Player, to: (-1958, 2679), sprint: 0);
    if (trigger(203)) goto L1;
    warp(to: Map.TWNA01, spawn: 0, trigger: 255);

L1:
