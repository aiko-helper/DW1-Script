  0000:  setTrigger 44
  0004:  if !trigger(229) then section_5+0xb6
  0010:  playSound 8 9
  0014:  speak 5 "Did you bring something\nto treat the wound?\n"
  0072:  speak Player "Wait a second. Let me see...\n"
  00b2:  jump section_5+0x1d0
  00b6:  playSound 8 9
  00ba:  speak 5 "My wing hurts!\n"
  00de:  speak Player "What happened?\n"
  0102:  speak 5 "I hurt my wing. Do you got\nsomething to treat my wound?\n"
  0178:  speak Player "It looks bad. Hold on.\nWhat should I do?\n"
  01d0:  playAnimation Player 4
  01d4:  delay 10
  01d8:  setTrigger 3
  01dc:  callSubroutine 0
  01de:  if !trigger(3) then section_5+0x226
  01ea:  speak Player "I got nothing right now.\n"
  0222:  jump section_5+0x570
  0226:  if pstat[254] != 0 AND pstat[254] != 1 AND pstat[254] != 2 AND pstat[254] != 3 then section_5+0x244
  023e:  callSubroutine 12
  0240:  jump section_5+0x2a0
  0244:  if pstat[254] != 7 AND pstat[254] != 9 AND pstat[254] != 13 AND pstat[254] != 14 then section_5+0x266
  025c:  callSubroutine 12
  025e:  jump section_5+0x2a0
  0262:  jump section_5+0x2a0
  0266:  speak Player "No good. This won't do!\n"
  029c:  jump section_5+0x570
  02a0:  playAnimation Player 5
  02a4:  delay 20
  02a8:  playAnimation Player 0
  02ac:  delay 5
  02b0:  playSound 8 9
  02b4:  speak 5 "It's much better. Thanks.\n"
  02ee:  playAnimation 5 29
  02f2:  waitForEntity 5
  02f4:  speak Player "Can you fly already?\n"
  0324:  speak 5 "I don't think I can fly far.\n"
  0364:  speak Player "There's a clinic in city.\nYou should go there.\nIt isn't far from here.\n"
  03f8:  speak 5 "I heard about the city.\nIt's bigger than I thought.\n"
  0466:  speak Player "Go to the city and rest.\n"
  049e:  playSound 8 9
  04a2:  speak 5 "Thanks. Maybe\nI can help you someday.\n"
  04f4:  jump section_5+0x4f8
  04f8:  entityWalkTo 5 -93 -1821 1
  0500:  if pstat[101] >= 3 then section_5+0x524
  050c:  pstat[101] += 1
