section(68) {
  if (trigger(236)) {
    return;
  }
  if (pstat[116] == 0) {
    speak(Entity.Player, "'!!\"\n");
    sfx(8, 2, wait: 20);
    setObjectVisibility(38, 1);
    move(entity: Entity.Player, to: (-1750, 3600), sprint: 1, withCamera: true);
    move(entity: Entity.Partner, to: (-1450, 3600), sprint: 1);
    waitForEntity(Entity.Partner);
    waitForEntity(Entity.Player);
    rotate(entity: Entity.Player, to: 2048);
    rotate(entity: Entity.Partner, to: 2048);
    setDigimon(Digimon.NPCCentarumon, Entity(0), 0);
    move(entity: Entity(5), to: (-1600, 4300), sprint: 0);
    waitForEntity(Entity(5));
    speak(Entity(5), "「この森をぬけてくるとは、<NEWLINE> さすがというべきだな。」<NEWLINE>");
    showTextbox("「私はケンタルモン。今までの無礼を<NEWLINE> わびよう。すまなかった。」<NEWLINE>");
    showTextbox("「私はきまぐれに君たちを試したのではない。<NEWLINE> これからは君たちに協力するつもりだ。」<NEWLINE>");
    setTrigger(Trigger(236));
    addPStat(PStat(1), 2);
    showTextbox("「さあ、行きたまえ。<NEWLINE> 私は街で待っているよ。」<NEWLINE>");
    goto L1;

L1:
    approach(who: Entity(5), x: -1600, y: 1000, tries: 4, wait: 20);
    playSound(8, 9);
    speak(Entity.System, "ケンタルモンが街に参加した!!!<NEWLINE>");
    followEntity(Entity.Player, speed: 10);
    look(entity: Entity.Player, at: Entity.Partner);
    look(entity: Entity.Partner, at: Entity.Player);
    delay(5);
    speak(Entity.Player, "「<ORANGE><DIGIMON><WHITE>、<NEWLINE> 俺達けっこう有名になってる<NEWLINE> みたいだぜ、へへ!」<NEWLINE>");
    playAnimation(Entity.Player, Animation(11));
    speak(Entity.Player, "「この調子でいこうぜ!」<NEWLINE>");
    move(entity: Entity.Player, to: (-1600, 5200), sprint: 0);
    delay(20);
    move(entity: Entity.Partner, to: (-1600, 5200), sprint: 0);
    delay(20);
    warp(to: Map.KODA00, spawn: 0, trigger: 255);
    return;
  } else {
    playSound(0, 11);
    speak(Entity.System, "はずれ!<NEWLINE>");
    warp(to: Map.TROP06, spawn: 0, trigger: 255);
  }
  return;
}

