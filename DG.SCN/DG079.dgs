// DG079.SCN
#include "functions.dgs"
#pragma script index=79 start=0x38800 end=0x3a000 headerU16=0x1c sentinelOff=0x24
#include "entities.dgs"

section onEnter(254) {
  spawnItemChance(max: 99, chance: 15, item: Item.Digimushroom, x: 54, y: 55);
  spawnItemChance(max: 99, chance: 6, item: Item.Digimushroom, x: 40, y: 47);
  spawnItemChance(max: 99, chance: 17, item: Item.Digimushroom, x: 39, y: 46);
  spawnItemChance(max: 99, chance: 3, item: Item.Happymushroom, x: 58, y: 34);
  setPStat(PStat(254), 0);
  callSubroutine(25);
  return;
}

section(51) {
  if (trigger(187)) {
    return;
  }
  move(entity: Entity.Partner, to: Entity.Player, sprint: 1);
  waitForPair();
  lookPairAt(Entity(5));
  speak(Entity(5), "It's the Speedy Time Zone\nbeyond this point.\nDon't get too close.\n");
  anim(Entity.Player, Animation(19), wait: 15);
  speak(Entity.Player, "There are two goals for me.\nOne is to find the\nIsland's danger.\n");
  showTextbox("The other is to get\nDigimon into the city.\n");
  playAnimation(Entity.Player, Animation(0));
  speak(Entity(5), "And your point is?\n");
  setDialogOwner(Entity.Player);
  setSelection(L1, L3);
  showTextbox("Please help me\nOh, never mind\n");

L1:
  speak(Entity(5), "I can't. I gotta guard\nthis forest.\n");
  speak(Entity.Player, "Then, do you know anything\nabout the island's danger?\n");
  speak(Entity(5), "I know nothing. Wait up.\n");
  showTextbox("I remember a big rock\nfalling from the sky\nnot too long ago.\n");
  speak(Entity.Player, "Where did it fall?\n");
  speak(Entity(5), "In Speedy Time Zone. On\nthe other side of the forest.\n");
  anim(Entity.Player, Animation(19), wait: 15);
  speak(Entity.Player, "Let me go! I may be able\nto find some clues!\n");
  playAnimation(Entity.Player, Animation(0));
  speak(Entity(5), "...\n");
  showTextbox("If you insist.\nGo ahead and check it out.\n");
  move(entity: Entity(5), to: (-740, 2145), sprint: 1);
  waitForEntity(Entity(5));
  look(entity: Entity(5), at: Entity.Player);
  setTrigger(Trigger(187));

L2:
  speak(Entity(5), "Beyond this point,\ntime goes twice as fast.\nTake enough food with you.\n");
  showTextbox("You must also watch out\nfor growing too old.\n");
  return;

L3:
  speak(Entity(5), "You should check\nout other places.\n");
  move(entity: Entity.Player, to: (-326, 1203), sprint: 0, withCamera: true);
  waitForEntity(Entity.Player);
  return;
}

section(5) {
  goto section_51.L2;

L1:
  return;
}

section(6) {
  if (!trigger(188)) {
    speak(Entity(6), "Beyond this point,\ntime goes twice as fast.\nTake enough food with you.\n");
    showTextbox("You must also watch out for\ngrowing too old.\n");
    return;
  }
  if (!trigger(313)) {
    speak(Entity(6), "Has anything happened?\n");
    speak(Entity.Player, "Not yet.\n");
    speak(Entity(6), "According to my master,\nthere's a secret passage.\n");
    showTextbox("But I don't know where.\n");
    return;
  }
  if (trigger(313) && trigger(208)) {
    return;
  }
  speak(Entity(6), "What is it?\n");
  speak(Entity.Player, "Looks like a meteorite!\nIt's nothing to worry about.\n");
  playAnimation(Entity.Player, Animation(22));
  speak(Entity(6), "Sorry, but that's\nall I know.\n");
  speak(Entity.Player, "Thanks anyway.\n");
  setDigimon(Digimon.MasterTyrannomon, Entity(2), 0);
  playSound(8, 7);
  speak(Entity(7), "Get this!\n");
  lookPairAt(Entity(7));
  look(entity: Entity(6), at: Entity(7));
  for x in [Entity.Player, Entity.Partner, Entity(6)] {
    waitForEntity(x);
  }
  move(entity: Entity(7), to: (64, 1093), sprint: 0);
  delay(15);
  playSound(8, 6);
  lookPairAt(Entity(7));
  look(entity: Entity(6), at: Entity(7));
  move(entity: Entity(7), to: (64, 1093), sprint: 0);
  delay(15);
  playSound(8, 6);
  lookPairAt(Entity(7));
  look(entity: Entity(6), at: Entity(7));
  move(entity: Entity(7), to: (64, 1093), sprint: 0);
  delay(15);
  playSound(8, 6);
  lookPairAt(Entity(7));
  look(entity: Entity(6), at: Entity(7));
  move(entity: Entity(7), to: (64, 1093), sprint: 0);
  waitForEntity(Entity(7));
  playSound(8, 6);
  lookPairAt(Entity(7));
  look(entity: Entity(6), at: Entity(7));
  look(entity: Entity(7), at: Entity.Player);
  for x in [Entity.Player, Entity.Partner, Entity(6), Entity(7)] {
    waitForEntity(x);
  }
  playAnimation(Entity.Player, Animation(23));
  showTextbox("You're worthless!\n");
  speak(Entity(6), "Master?!\n");
  speak(Entity(7), "I can't believe\nyou're still here!\n");
  playSound(8, 8);
  anim(Entity.Player, Animation(16), wait: 15);
  speak(Entity.Player, "Master? Who is he?\n");
  playAnimation(Entity.Player, Animation(0));
  speak(Entity(6), "But Master, who will guard\nthe Ancient Dino Region?\n");
  speak(Entity(7), "This is a critical time\nfor the island. Go to the\ncity and help the others!\n");
  playSound(8, 8);
  speak(Entity(6), "Yes sir!\n");
  look(entity: Entity.Player, at: Entity(6));
  delay(10);
  speak(Entity.Player, "Are you sure it's okay?!\n");
  look(entity: Entity.Player, at: Entity(7));
  waitForEntity(Entity.Player);
  speak(Entity(7), "He is still young, but\nplease put him to work.\nI will stand guard here.\n");
  playSound(8, 7);
  speak(Entity(6), "Master...\n");
  look(entity: Entity(6), at: Entity.Player);
  waitForEntity(Entity(6));
  speak(Entity(6), "<LIGHTBLUE><PLAYER><WHITE>, that's the story,\nso can I go to the city?\n");
  look(entity: Entity.Player, at: Entity(6));
  waitForEntity(Entity.Player);
  playAnimation(Entity.Player, Animation(19));
  speak(Entity.Player, "You must work hard.\n");
  speak(Entity(6), "I will!\nMaster, see you later!\n");
  goto L1;

L1:
  loop {
    move(entity: Entity(6), to: (-243, -614), sprint: 1);
    if (pstat[101] >= 6) break;
    addPStat(PStat.LoopIterator, 1);
    delay(10);
    lookPairAt(Entity(6));
    look(entity: Entity(7), at: Entity(6));
  }
  waitForEntity(Entity(6));
  unloadEntity(Entity(6));
  setPStat(PStat.LoopIterator, 0);
  playSound(8, 9);
  speak(Entity.System, "Tyrannomon joins the city!\n");
  setTrigger(Trigger(208));
  addPStat(PStat(1), 2);
  speak(Entity(7), "I wonder what he can do?\n");
  return;
}

section(7) {
  look(entity: Entity.Player, at: Entity(7));
  waitForEntity(Entity.Player);
  playAnimation(Entity.Player, Animation(23));
  speak(Entity(7), "It's been a while\nsince I guarded this place.\n");
  showTextbox("You can pass thru anytime.\n");
  return;
}

section(8) {
  look(entity: Entity.Player, at: Entity(8));
  waitForEntity(Entity.Player);
  playAnimation(Entity.Player, Animation(23));
  speak(Entity(8), "It's been a while\nsince I guarded this place.\n");
  showTextbox("You can pass thru anytime.\n");
  return;
