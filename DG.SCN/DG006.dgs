// DG006.SCN
#include "functions.dgs"
#pragma script index=6 start=0x9000 end=0xa000 headerU16=0x20 sentinelOff=0x24
#include "entities.dgs"

section onEnter(254) {
  spawnItemChance(max: 99, chance: 29, item: Item.Digimushroom, x: 42, y: 54);
  spawnItemChance(max: 99, chance: 59, item: Item.Digimushroom, x: 34, y: 30);
  spawnItemChance(max: 99, chance: 9, item: Item.Digimushroom, x: 53, y: 47);
  spawnItemChance(max: 99, chance: 19, item: Item.Digimushroom, x: 69, y: 60);
  if (trigger(185) && !trigger(249)) {
    setObjectsVisibleRange(13, 28, 0);
  }
  pstat[:SavedTime] = time();
  if (pstat[107] >= 15 && pstat[107] <= 19 && !trigger(249)) {
    setObjectsVisibleRange(13, 28, 0);
  }
  return;
}

section(6) {
  speak(Entity(6), "「まけるもんか~!」<NEWLINE>");
  startBattle();
  return;
}

section(7) {
  speak(Entity(7), "「こっちくんな!あっちへ行けよっ!」<NEWLINE>");
  startBattle();
  return;
}

section(8) {
  speak(Entity(8), "「もう、あったまきたかんな~!」<NEWLINE>");
  startBattle();
  return;
}

section(9) {
  speak(Entity(9), "「一発ぶったら、一発ぶつぞ!」<NEWLINE>");
  startBattle();
  return;
}

section(10) {
  speak(Entity(10), "「やれるもんなら、やってみろよ!」<NEWLINE>");
  startBattle();
  return;
}

