// MAP155.SCN
#include "functions.dgs"
#pragma script index=155 start=0x6a800 end=0x6b000 headerU16=0x24 sentinelOff=0x975
#include "entities.dgs"

section onEnter(254) {
  spawnChest(Item.Omnipotent, 474, 444, 3072, 682);
  return;
}

section(51) {
  move(entity: Entity.Player, to: (2989, 2649), sprint: 0);
  warp(to: Map.MGEN04, spawn: 0, trigger: 255);
  return;
}

section(52) {
  move(entity: Entity.Player, to: (-2579, -427), sprint: 0);
  warp(to: Map.MGEN02, spawn: 0, trigger: 255);
  return;
}

section(5) {
  speak(Entity(5), "「だめだ。とまれ。」<NEWLINE>");
  finishEncounter(Trigger(308));
}

section(6) {
  speak(Entity(6), "「カミのおもむくままに…」<NEWLINE>");
  finishEncounter(Trigger(285));
}

section(7) {
  speak(Entity(7), "「ここをまもっている。」<NEWLINE>");
  finishEncounter(Trigger(308));
}

section(8) {
  speak(Entity(8), "「なんじはカミを信じま~すか?」<NEWLINE>");
  finishEncounter(Trigger(285));
}

section(9) {
  speak(Entity(9), "「ぼうりょくはいけません、ぼうりょくは!」<NEWLINE>");
