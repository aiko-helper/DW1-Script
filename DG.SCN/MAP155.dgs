// MAP155.SCN
#pragma script index=155 start=0x6e000 end=0x6e800 headerU16=0x20 sentinelOff=0x1c

function speakThenStartBattleThenSetTrigger(a, b, c) {
    speak(a, b);
    startBattle();
    setTrigger(c);
}


section onEnter(254) {  // len=30
    setTrigger(332);
    spawnChest(Item.HPChip, -2886, -683, 2048, 677);
    spawnChest(Item.MPChip, -3672, -683, 2048, 678);
    return;
}

