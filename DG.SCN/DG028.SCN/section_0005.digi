  014c:  lookAt 253 5
  0150:  lookAt 5 253
  0154:  lookAt 252 5
  0158:  setDialogOwner 5
  015a:  showTextbox "I got weird\nbecause of the heat.\n"
  01a0:  playAnimation 253 25
  01a4:  delay 20
  01a8:  setDialogOwner 253
  01aa:  showTextbox "I know it's hot, but...\nbe cool man!\n"
  01f8:  setDialogOwner 5
  01fa:  showTextbox "The more we dig, the hotter\nit gets. The tunnel\nis in a volcano.\n"
  0280:  setDialogOwner 5
  0282:  showTextbox "I don't think it's the only\nreason. Maybe there's\na fire nearby.\n"
  0308:  playAnimation 253 16
  030c:  delay 20
  0310:  setDialogOwner 253
  0312:  showTextbox "Hmmm\n"
  0320:  setDialogOwner 5
  0322:  showTextbox "I don't got a choice.\nI must bear this heat\nand keep on digging.\n"
  03a8:  playAnimation 253 19
  03ac:  delay 20
  03b0:  setDialogOwner 253
  03b2:  showTextbox "We'll check out the cause.\nIt'd be great if\nthe tunnel goes thru.\n"
  043a:  setDialogOwner 5
  043c:  showTextbox "You are a nice guy.\nI'll hurry and\ndig this tunnel!\n"
  04a8:  delay 10
