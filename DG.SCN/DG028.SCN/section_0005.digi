section_5:     ; len=2018
  0000:  if !trigger(234) then section_5+0x4a
  000c:  setDialogOwner 5
  000e:  showTextbox "I fixed the entrance sign.\n"
  0048:  endSection
  004a:  if trigger(140) then section_5+0x5a
