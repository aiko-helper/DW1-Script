section_5(5):     ; len=2018
  0000:  if !trigger(234) then section_5+0x4a
  000c:  speak 5 "I fixed the entrance sign.\n"
  0048:  endSection
  004a:  if trigger(140) then section_5+0x5a
  0056:  jump section_5+0x5e
  005a:  jump section_5+0x4ee
  005e:  playAnimation 5 28
  0062:  playSound 8 10
  0066:  speak 5 "It's hot! Do something!\n"
  009c:  playAnimation 5 28
  00a0:  playAnimation Player 16
  00a4:  delay 20
  00a8:  speak Player "What's going on?\n"
  00d0:  playSound 8 10
  00d4:  speak 5 "It's too hot!\nI can't take it anymore!\n"
  0128:  setTrigger 1
  012c:  pstat[250] = 1
  0130:  pstat[251] = 5
  0134:  pstat[252] = 255
  0138:  pstat[253] = 255
  013c:  fadeOutHUD
  013e:  delay 1
  0142:  startBattle
  0144:  unsetTrigger 1
  0148:  pstat[250] = 0
  014c:  lookAt Player 5
  0150:  lookAt 5 Player
  0154:  lookAt Partner 5
  0158:  speak 5 "I got weird\nbecause of the heat.\n"
  01a0:  playAnimation Player 25
  01a4:  delay 20
  01a8:  speak Player "I know it's hot, but...\nbe cool man!\n"
  01f8:  speak 5 "The more we dig, the hotter\nit gets. The tunnel\nis in a volcano.\n"
  0280:  speak 5 "I don't think it's the only\nreason. Maybe there's\na fire nearby.\n"
  0308:  playAnimation Player 16
  030c:  delay 20
  0310:  speak Player "Hmmm\n"
  0320:  speak 5 "I don't got a choice.\nI must bear this heat\nand keep on digging.\n"
  03a8:  playAnimation Player 19
  03ac:  delay 20
  03b0:  speak Player "We'll check out the cause.\nIt'd be great if\nthe tunnel goes thru.\n"
  043a:  speak 5 "You are a nice guy.\nI'll hurry and\ndig this tunnel!\n"
  04a8:  delay 10
  04ac:  playAnimation Player 0
  04b0:  jump section_5+0x4b4
  04b4:  entityWalkTo 5 1061 -767 0
  04bc:  if pstat[101] >= 3 then section_5+0x4dc
  04c8:  pstat[101] += 1
  04cc:  delay 20
  04d0:  lookAt Player 5
  04d4:  lookAt Partner 5
  04d8:  jump section_5+0x4b4
  04dc:  pstat[101] = 0
  04e0:  waitForEntity 5
  04e2:  moveCameraToEntity Player 10
  04e6:  waitForEntity 200
  04e8:  setTrigger 140
  04ec:  endSection
  04ee:  speak 5 "Today, I'm in charge\nof cooking.\n"
