  005e:  playAnimation 5 28
  0062:  playSound 8 10
  0066:  setDialogOwner 5
  0068:  showTextbox "It's hot! Do something!\n"
  009c:  playAnimation 5 28
  00a0:  playAnimation 253 16
  00a4:  delay 20
  00a8:  setDialogOwner 253
  00aa:  showTextbox "What's going on?\n"
  00d0:  playSound 8 10
  00d4:  setDialogOwner 5
  00d6:  showTextbox "It's too hot!\nI can't take it anymore!\n"
  0128:  setTrigger 1
  012c:  setPStat 250 1
  0130:  setPStat 251 5
  0134:  setPStat 252 255
  0138:  setPStat 253 255
