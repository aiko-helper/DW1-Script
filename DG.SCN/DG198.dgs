// DG198.SCN
#include "functions.dgs"
#pragma script index=198 start=0x96000 end=0x96800 headerU16=0x2c sentinelOff=0x1b75

section onEnter(254) {
    spawnChest(Item.HPChip, -373, 4348, 0, 690);
    spawnChest(Item.MPChip, 384, 4392, 0, 691);
    return;
}

section(51) {
    move(entity: Entity.Player, to: (-2748, 3453), sprint: 0);
    warp(to: Map.MGEN98, spawn: 0, trigger: 255);
    return;
}

section(52) {
    move(entity: Entity.Player, to: (2801, 3497), sprint: 0);
    warp(to: Map.MGEN09, spawn: 1, trigger: 255);
    return;
}

section(5) {
    speak(5, "This's the last one.\n");
    startBattle();
    setTrigger(285);
    return;
}

section(6) {
    speak(6, "We are here at last!\n");
    startBattle();
    setTrigger(305);
    return;
}

section(7) {
    speak(7, "Pathway is clear!\n");
    startBattle();
    setTrigger(285);
    return;
}

section(8) {
    speak(8, "Let's make it easy.\n");
    startBattle();
    setTrigger(305);
    return;
}

section(9) {
    speak(9, "This is the last chance!\n");
    startBattle();
    setTrigger(285);
    return;
}

section(10) {
    speak(10, "Are you really going?\n");
    startBattle();
    setTrigger(305);
    return;
}

section(53) {
    if (!trigger(254)) goto L1;
    return;

L1:
    look(entity: Entity.Player, at: 11);
    delay(5);
    speak(Entity.Player, "How scary! I feel it\nin my bones.\n");
    speak(11, "...\n");
    speak(Entity.Player, "Why doesn't he attack me?\n");
    speak(11, "...\n");
    speak(Entity.Player, "Don't you need to fight?\n");
    setDialogOwner(Entity.Player);
    choice { "We should hurry up and go." -> L5, "We have to test our skills." -> L2 }
    goto L2;

L2:
    speak(Entity.Player, "Let's go, <ORANGE><DIGIMON><WHITE>!\n");
    setTrigger(1);
    setPStat(250, 1);
    setPStat(251, 11);
    setPStat(252, 255);
    setPStat(253, 255);
    startBattle();
    unsetTrigger(1);
    setPStat(250, 0);
    look(entity: Entity.Player, at: 11);
    look(entity: 11, at: Entity.Player);
    look(entity: Entity.Partner, at: 11);
    speak(11, "...\n");
    goto L3;

L3:
    move(entity: 11, to: (0, 0), sprint: 1);
    if (pstat[101] >= 3) goto L4;
    addPStat(101, 1);
    delay(20);
    look(entity: Entity.Player, at: 11);
    look(entity: Entity.Partner, at: 11);
    goto L3;

L4:
    waitForEntity(11);
    unloadEntity(11);
    setPStat(101, 0);
    speak(Entity.Player, "Did we win?\n");
    setTrigger(254);
    addPStat(1, 3);
    moveCamera(to: Entity.Player, speed: 15);
    waitForEntity(200);
    return;

L5:
    move(entity: Entity.Player, to: (43, 1754), sprint: 1, withCamera: true);
    waitForEntity(Entity.Player);
    return;
    garbage { 2c 00 fe 00 2c 00 33 00 46 00 34 00 54 00 05 00 62 00 06 00 a0 00 07 00 de 00 08 00 16 01 09 00 52 01 0a 00 98 01 35 00 d8 01 ff ff 75 1b 8b fe 00 00 fc 10 00 00 b2 02 75 1c 80 01 00 00 28 11 00 00 b3 02 fe 00 4e fd 44 f5 7d 0d 00 00 4b de 00 ff fe 00 4e fd f1 0a a9 0d 00 00 4b fd 01 ff fe 00 1b 05 1a 00 82 73 82 88 82 89 82 93 81 75 82 93 81 40 82 94 82 88 82 85 81 40 82 8c 82 81 82 93 82 94 81 40 82 8f 82 8e 82 85 81 42 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 1d 01 fe 00 1b 06 1a 00 82 76 82 85 81 40 82 81 82 92 82 85 81 40 82 88 82 85 82 92 82 85 81 40 82 81 82 94 81 40 82 8c 82 81 82 93 82 94 81 49 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 31 01 fe 00 1b 07 1a 00 82 6f 82 81 82 94 82 88 82 97 82 81 82 99 81 40 82 89 82 93 81 40 82 83 82 8c 82 85 82 81 82 92 81 49 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 1d 01 fe 00 1b 08 1a 00 82 6b 82 85 82 94 81 75 82 93 81 40 82 8d 82 81 82 8b 82 85 81 40 82 89 82 94 81 40 82 85 82 81 82 93 82 99 81 42 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 31 01 fe 00 1b 09 1a 00 82 73 82 88 82 89 82 93 81 40 82 89 82 93 81 40 82 94 82 88 82 85 81 40 82 8c 82 81 82 93 82 94 81 40 82 83 82 88 82 81 82 8e 82 83 82 85 81 49 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 1d 01 fe 00 1b 0a 1a 00 82 60 82 92 82 85 81 40 82 99 82 8f 82 95 81 40 82 92 82 85 82 81 82 8c 82 8c 82 99 81 40 82 87 82 8f 82 89 82 8e 82 87 81 48 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 31 01 fe 00 19 00 00 00 fe 00 18 00 e6 01 19 00 fe 00 4c 00 fd 0b 67 00 05 00 1b fd 1a 00 82 67 82 8f 82 97 81 40 82 93 82 83 82 81 82 92 82 99 81 49 81 40 82 68 81 40 82 86 82 85 82 85 82 8c 81 40 82 89 82 94 0d 00 82 89 82 8e 81 40 82 8d 82 99 81 40 82 82 82 8f 82 8e 82 85 82 93 81 42 0d 00 00 00 1b 0b 1a 00 81 42 81 42 81 42 0d 00 00 00 1b fd 1a 00 82 76 82 88 82 99 81 40 82 84 82 8f 82 85 82 93 82 8e 81 75 82 94 81 40 82 88 82 85 81 40 82 81 82 94 82 94 82 81 82 83 82 8b 81 40 82 8d 82 85 81 48 0d 00 00 00 1b 0b 1a 00 81 42 81 42 81 42 0d 00 00 00 1b fd 1a 00 82 63 82 8f 