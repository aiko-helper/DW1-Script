; DG079.SCN
;!script index=79 start=0x38800 end=0x3a000 headerU16=0x1c sentinelOff=0x24
;!sections onEnter section_51 section_5 section_6 section_7 section_8

onEnter:     ; len=96
  0000:  storeRandom 110 99
  0004:  if pstat[110] > 15 then onEnter+0x16
  0010:  spawnItem Digimushroom 54 55
  0016:  storeRandom 110 99
  001a:  if pstat[110] > 6 then onEnter+0x2c
  0026:  spawnItem Digimushroom 40 47
  002c:  storeRandom 110 99
  0030:  if pstat[110] > 17 then onEnter+0x42
  003c:  spawnItem Digimushroom 39 46
  0042:  storeRandom 110 99
  0046:  if pstat[110] > 3 then onEnter+0x58
  0052:  spawnItem Happymushroom 58 34
  0058:  pstat[254] = 0
  005c:  callSubroutine 25
  005e:  endSection
