  000e:  entityWalkToEntity 252 1 253
  0012:  waitForEntity 253
  0014:  waitForEntity 252
  0016:  lookAt 253 5
  001a:  lookAt 252 5
  001e:  setDialogOwner 5
  0020:  showTextbox "It's the Speedy Time Zone\nbeyond this point.\nDon't get too close.\n"
  00a8:  playAnimation 253 19
  00ac:  delay 15
  00b0:  setDialogOwner 253
  00b2:  showTextbox "There are two goals for me.\nOne is to find the\nIsland's danger.\n"
  0136:  showTextbox "The other is to get\nDigimon into the city.\n"
  0190:  playAnimation 253 0
  0194:  setDialogOwner 5
  0196:  showTextbox "And your point is?\n"
  01c0:  setDialogOwner 253
  01c2:  setSelection section_51+0x208 section_51+0x5f4
  01c8:  showTextbox "Please help me\nOh, never mind\n"
  0208:  setDialogOwner 5
  020a:  showTextbox "I can't. I gotta guard\nthis forest.\n"
  0256:  setDialogOwner 253
  0258:  showTextbox "Then, do you know anything\nabout the island's danger?\n"
  02c8:  setDialogOwner 5
  02ca:  showTextbox "I know nothing. Wait up.\n"
  0300:  showTextbox "I remember a big rock\nfalling from the sky\nnot too long ago.\n"
  037e:  setDialogOwner 253
  0380:  showTextbox "Where did it fall?\n"
  03aa:  setDialogOwner 5
  03ac:  showTextbox "In Speedy Time Zone. On\nthe other side of the forest.\n"
  041c:  playAnimation 253 19
  0420:  delay 15
  0424:  setDialogOwner 253
  0426:  showTextbox "Let me go! I may be able\nto find some clues!\n"
  0484:  playAnimation 253 0
  0488:  setDialogOwner 5
  048a:  showTextbox "...\n"
  0496:  showTextbox "If you insist.\nGo ahead and check it out.\n"
  04ee:  entityWalkTo 5 -740 2145 1
  04f6:  waitForEntity 5
  04f8:  lookAt 5 253
  04fc:  setTrigger 187
  0500:  setDialogOwner 5
  0502:  showTextbox "Beyond this point,\ntime goes twice as fast.\nTake enough food with you.\n"
  0594:  showTextbox "You must also watch out\nfor growing too old.\n"
  05f2:  endSection
  05f4:  setDialogOwner 5
  05f6:  showTextbox "You should check\nout other places.\n"
