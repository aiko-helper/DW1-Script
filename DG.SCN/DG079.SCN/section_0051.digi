  0016:  lookAt Player 5
  001a:  lookAt Partner 5
  001e:  speak 5 "It's the Speedy Time Zone\nbeyond this point.\nDon't get too close.\n"
  00a8:  playAnimation Player 19
  00ac:  delay 15
  00b0:  speak Player "There are two goals for me.\nOne is to find the\nIsland's danger.\n"
  0136:  showTextbox "The other is to get\nDigimon into the city.\n"
  0190:  playAnimation Player 0
  0194:  speak 5 "And your point is?\n"
  01c0:  setDialogOwner Player
  01c2:  setSelection section_51+0x208 section_51+0x5f4
  01c8:  showTextbox "Please help me\nOh, never mind\n"
  0208:  speak 5 "I can't. I gotta guard\nthis forest.\n"
  0256:  speak Player "Then, do you know anything\nabout the island's danger?\n"
  02c8:  speak 5 "I know nothing. Wait up.\n"
  0300:  showTextbox "I remember a big rock\nfalling from the sky\nnot too long ago.\n"
  037e:  speak Player "Where did it fall?\n"
  03aa:  speak 5 "In Speedy Time Zone. On\nthe other side of the forest.\n"
  041c:  playAnimation Player 19
  0420:  delay 15
  0424:  speak Player "Let me go! I may be able\nto find some clues!\n"
  0484:  playAnimation Player 0
  0488:  speak 5 "...\n"
  0496:  showTextbox "If you insist.\nGo ahead and check it out.\n"
  04ee:  entityWalkTo 5 -740 2145 1
  04f6:  waitForEntity 5
  04f8:  lookAt 5 Player
  04fc:  setTrigger 187
  0500:  speak 5 "Beyond this point,\ntime goes twice as fast.\nTake enough food with you.\n"
  0594:  showTextbox "You must also watch out\nfor growing too old.\n"
  05f2:  endSection
  05f4:  speak 5 "You should check\nout other places.\n"
