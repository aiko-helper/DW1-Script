  05ae:  showTextbox "Are you sure it's okay?!\n"
  05e4:  lookAt 253 7
  05e8:  waitForEntity 253
  05ea:  setDialogOwner 7
  05ec:  showTextbox "He is still young, but\nplease put him to work.\nI will stand guard here.\n"
  0680:  playSound 8 7
  0684:  setDialogOwner 6
  0686:  showTextbox "Master...\n"
  069e:  lookAt 6 253
  06a2:  waitForEntity 6
  06a4:  setDialogOwner 6
  06a6:  showTextbox "<LIGHTBLUE><PLAYER><WHITE>, that's the story,\nso can I go to the city?\n"
