section_6:     ; len=2112
  0000:  if trigger(188) then section_6+0x100
  000c:  setDialogOwner 6
  000e:  showTextbox "Beyond this point,\ntime goes twice as fast.\nTake enough food with you.\n"
  00a0:  showTextbox "You must also watch out for\ngrowing too old.\n"
  00fe:  endSection
  0100:  if trigger(313) then section_6+0x1f8
  010c:  setDialogOwner 6
  010e:  showTextbox "Has anything happened?\n"
  0140:  setDialogOwner 253
  0142:  showTextbox "Not yet.\n"
  0158:  setDialogOwner 6
  015a:  showTextbox "According to my master,\nthere's a secret passage.\n"
  01c2:  showTextbox "But I don't know where.\n"
  01f6:  endSection
  01f8:  if !trigger(313) OR !trigger(208) then section_6+0x20a
  0208:  endSection
  020a:  setDialogOwner 6
  020c:  showTextbox "What is it?\n"
  0228:  setDialogOwner 253
  022a:  showTextbox "Looks like a meteorite!\nIt's nothing to worry about.\n"
  0298:  playAnimation 253 22
  029c:  setDialogOwner 6
  029e:  showTextbox "Sorry, but that's\nall I know.\n"
  02de:  setDialogOwner 253
  02e0:  showTextbox "Thanks anyway.\n"
  0302:  setDigimon 124 2 0
  0306:  playSound 8 7
  030a:  setDialogOwner 7
  030c:  showTextbox "Get this!\n"
