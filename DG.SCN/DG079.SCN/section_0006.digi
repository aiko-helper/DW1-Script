  03b0:  playAnimation 253 23
  03b4:  showTextbox "You're worthless!\n"
  03dc:  setDialogOwner 6
  03de:  showTextbox "Master?!\n"
  03f4:  setDialogOwner 7
  03f6:  showTextbox "I can't believe\nyou're still here!\n"
  0440:  playSound 8 8
  0444:  playAnimation 253 16
  0448:  delay 15
  044c:  setDialogOwner 253
  044e:  showTextbox "Master? Who is he?\n"
  0478:  playAnimation 253 0
  047c:  setDialogOwner 6
  047e:  showTextbox "But Master, who will guard\nthe Ancient Dino Region?\n"
  04ea:  setDialogOwner 7
  04ec:  showTextbox "This is a critical time\nfor the island. Go to the\ncity and help the others!\n"
  0588:  playSound 8 8
