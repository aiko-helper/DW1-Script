// source: extract/DIGIMON/SCN/DG.SCN
// DG079.SCN, section 6

section section_6(6) {  // len=2112
    if (trigger(188)) goto L_0100;
    setDialogOwner(6);
    showTextbox("Beyond this point,\ntime goes twice as fast.\nTake enough food with you.\n");
    showTextbox("You must also watch out for\ngrowing too old.\n");
    return;
L_0100:
    if (trigger(313)) goto L_01f8;
    setDialogOwner(6);
    showTextbox("Has anything happened?\n");
    setDialogOwner(Entity.Player);
    showTextbox("Not yet.\n");
    setDialogOwner(6);
    showTextbox("According to my master,\nthere's a secret passage.\n");
    showTextbox("But I don't know where.\n");
    return;
L_01f8:
    if (!trigger(313) || !trigger(208)) goto L_020a;
    return;
L_020a:
    setDialogOwner(6);
    showTextbox("What is it?\n");
    setDialogOwner(Entity.Player);
    showTextbox("Looks like a meteorite!\nIt's nothing to worry about.\n");
    playAnimation(Entity.Player, 22);
    setDialogOwner(6);
    showTextbox("Sorry, but that's\nall I know.\n");
    setDialogOwner(Entity.Player);
    showTextbox("Thanks anyway.\n");
    setDigimon(Digimon.MasterTyrannomon, 2, 0);
    playSound(8, 7);
    setDialogOwner(7);
    showTextbox("Get this!\n");
    look(entity: Entity.Player, at: 7);
    look(entity: Entity.Partner, at: 7);
    look(entity: 6, at: 7);
    waitForEntity(Entity.Player);
    waitForEntity(Entity.Partner);
    waitForEntity(6);
    move(entity: 7, to: (64, 1093), sprint: 0);
    delay(15);
    playSound(8, 6);
    look(entity: Entity.Player, at: 7);
    look(entity: Entity.Partner, at: 7);
    look(entity: 6, at: 7);
    move(entity: 7, to: (64, 1093), sprint: 0);
    delay(15);
    playSound(8, 6);
    look(entity: Entity.Player, at: 7);
    look(entity: Entity.Partner, at: 7);
    look(entity: 6, at: 7);
    move(entity: 7, to: (64, 1093), sprint: 0);
    delay(15);
    playSound(8, 6);
    look(entity: Entity.Player, at: 7);
    look(entity: Entity.Partner, at: 7);
    look(entity: 6, at: 7);
    move(entity: 7, to: (64, 1093), sprint: 0);
    waitForEntity(7);
    playSound(8, 6);
    look(entity: Entity.Player, at: 7);
    look(entity: Entity.Partner, at: 7);
    look(entity: 6, at: 7);
    look(entity: 7, at: Entity.Player);
    waitForEntity(Entity.Player);
    waitForEntity(Entity.Partner);
    waitForEntity(6);
    waitForEntity(7);
    playAnimation(Entity.Player, 23);
    showTextbox("You're worthless!\n");
    setDialogOwner(6);
    showTextbox("Master?!\n");
    setDialogOwner(7);
    showTextbox("I can't believe\nyou're still here!\n");
    playSound(8, 8);
    playAnimation(Entity.Player, 16);
    delay(15);
    setDialogOwner(Entity.Player);
    showTextbox("Master? Who is he?\n");
    playAnimation(Entity.Player, 0);
    setDialogOwner(6);
    showTextbox("But Master, who will guard\nthe Ancient Dino Region?\n");
    setDialogOwner(7);
    showTextbox("This is a critical time\nfor the island. Go to the\ncity and help the others!\n");
    playSound(8, 8);
    setDialogOwner(6);
    showTextbox("Yes sir!\n");
    look(entity: Entity.Player, at: 6);
    delay(10);
    setDialogOwner(Entity.Player);
    showTextbox("Are you sure it's okay?!\n");
    look(entity: Entity.Player, at: 7);
    waitForEntity(Entity.Player);
    setDialogOwner(7);
    showTextbox("He is still young, but\nplease put him to work.\nI will stand guard here.\n");
    playSound(8, 7);
    setDialogOwner(6);
    showTextbox("Master...\n");
    look(entity: 6, at: Entity.Player);
    waitForEntity(6);
    setDialogOwner(6);
    showTextbox("<LIGHTBLUE><PLAYER><WHITE>, that's the story,\nso can I go to the city?\n");
    look(entity: Entity.Player, at: 6);
    waitForEntity(Entity.Player);
    playAnimation(Entity.Player, 19);
    setDialogOwner(Entity.Player);
    showTextbox("You must work hard.\n");
    setDialogOwner(6);
    showTextbox("I will!\nMaster, see you later!\n");
    goto L_078a;
L_078a:
    move(entity: 6, to: (-243, -614), sprint: 1);
    if (pstat[101] >= 6) goto L_07b6;
    addPStat(101, 1);
    delay(10);
    look(entity: Entity.Player, at: 6);
    look(entity: Entity.Partner, at: 6);
    look(entity: 7, at: 6);
    goto L_078a;
L_07b6:
    waitForEntity(6);
    unloadEntity(6);
    setPStat(101, 0);
    playSound(8, 9);
    setDialogOwner(Entity.System);
    showTextbox("Tyrannomon joins the city!\n");
    setTrigger(208);
    addPStat(1, 2);
    setDialogOwner(7);
    showTextbox("I wonder what he can do?\n");
    return;
}
