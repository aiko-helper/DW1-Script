// DG123.SCN
#include "functions.dgs"
#pragma script index=123 start=0x57800 end=0x58000 headerU16=0x24 sentinelOff=0x24
#include "entities.dgs"

section onEnter(254) {
  roll(pstat: 110, max: 99);
  if (pstat[110] <= 9) {
    spawnItem(Item.Digimushroom, x: 48, y: 68);
  }
  roll(pstat: 110, max: 99);
  if (pstat[110] <= 3) {
    spawnItem(Item.Pricklypear, x: 76, y: 49);
  }
  unsetTrigger(98);
  return;
}

section(5) {
  speak(5, "Hey!\n");
  finishEncounter(280);
}

section(6) {
  speak(6, "Haaaa!\n");
  finishEncounter(280);
}

section(7) {
  speak(7, "Wow!\n");
  finishEncounter(280);
}

section(81) {
  rotate(entity: Entity.Player, to: 1944);
  waitForEntity(Entity.Player);
  speak(Entity.System, "East: Elevator\nWest: Danger!!\nBeware of cliff.\n");
  if (trigger(54)) {
    return;
  }
  setDialogOwner(Entity.System);
  setSelection(L1, L2);
  showTextbox("Ogre Mode:ON\nOgre Mode:OFF\n");

L1:
  setTrigger(197);
  warp(to: Map.GCAN08_2, spawn: 0, trigger: 255);
  return;

L2:
  unsetTrigger(197);
  warp(to: Map.GCAN08_2, spawn: 0, trigger: 255);
  return;
}

section(82) {
  rotate(entity: Entity.Player, to: 1944);
  waitForEntity(Entity.Player);
  speak(Entity.System, "Beware of cave-ins!\n");
  return;
}

section(51) {
  if (!trigger(197)) {
    return;
  }
  if (trigger(198)) {
    return;
  }
  if (trigger(98)) {
    return;
  }
  rotate(entity: Entity.Player, to: 1944);
  moveCamera(to: (2000, 173), slowdown: 30);
  waitForEntity(200);
  speak(Entity.Player, "Rumor is that this is the\nroad where bandits attack.\n");
  showTextbox("Alright, let's go <ORANGE><DIGIMON><WHITE>.\n");
  move(entity: Entity.Player, to: (1925, 468), sprint: 0);
  move(entity: Entity.Partner, to: (1925, 78), sprint: 0);
  waitForPair();
  loadDigimon(Digimon.NPCOgremon);
  loadDigimon(Digimon.Agumon);
  setDigimon(Digimon.NPCOgremon, 3, 0);
  setDigimon(Digimon.Agumon, 4, 0);
  setDigimon(Digimon.Agumon, 5, 0);
  speak(9, "Yoo-hoo!\n");
  playSound(8, 11);
  speak(8, "Ha ha ha!\n");
  speak(10, "Yaa-hoo!\n");
  delay(10);
  playSound(8, 1);
  playAnimation(8, 31);
  move(entity: 8, to: (1000, 1288), animDuration: 30);
  move(entity: 9, to: (2067, 1561), sprint: 1);
  move(entity: 10, to: (2059, -383), sprint: 1);
  for id in 8..10 {
    waitForEntity(id);
  }
  look(entity: 8, at: Entity.Player);
  look(entity: 9, at: Entity.Player);
  look(entity: 10, at: Entity.Player);
  look(entity: Entity.Player, at: 8);
  look(entity: Entity.Partner, at: 9);
  delay(10);
  playSound(8, 11);
  speak(8, "Give up and leave your stuff\nhere or you'll regret it!\n");
  anim(Entity.Player, 20, wait: 15);
  speak(Entity.Player, "Give up!\n");
  playAnimation(Entity.Player, 0);
  speak(8, "What?! You...\n");
  speak(8, "It can't be!\n");
  speak(9, "Boss, what'll we do?\n");
  look(entity: 9, at: 8);
  speak(8, "Don't panic! We are\nstronger and there are more\nof us! Go get 'em!\n");
  look(entity: 8, at: 9);
  setTrigger(1);
  setPStat(250, 1);
  setPStat(251, 8);
  setPStat(252, 9);
  setPStat(253, 10);
  startBattle();
  unsetTrigger(1);
  setPStat(250, 0);
  look(entity: Entity.Player, at: 8);
  look(entity: 8, at: Entity.Player);
  look(entity: Entity.Partner, at: 8);
  move(entity: 9, to: (1350, 2350), sprint: 1);
  move(entity: 10, to: (1850, 2350), sprint: 1);
  waitForEntity(9);
  waitForEntity(10);
  unloadEntity(9);
  unloadEntity(10);
  speak(8, "I'll get even someday!\n");
  move(entity: 8, to: (1650, 2350), sprint: 1);
  waitForEntity(8);
  unloadEntity(8);
  speak(Entity.Player, "Look at them go! They won't\nbe back for a while.\n");
  moveCamera(to: Entity.Player, speed: 10);
  waitForEntity(200);
  for x in [198, 142, 155] {
    setTrigger(x);
  }
  return;
}

section(52) {
  setTrigger(98);
  return;
