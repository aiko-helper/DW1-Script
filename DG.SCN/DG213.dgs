    showTextbox("Oh, <LIGHTBLUE><PLAYER><WHITE>, <ORANGE><DIGIMON><WHITE>\nyou came. Look at this great\nFile City Arena. Cool, huh!\n");
    showTextbox("Soon contestants and fans will\nfill this up. You will also\nbring joy to the fans, right?!\n");
