// DG129.SCN
#pragma script index=129 start=0x5b000 end=0x5b800 headerU16=0x18 sentinelOff=0x24

section onEnter(254) {  // len=136
    roll(pstat: 110, max: 99);
    if (pstat[110] > 10) goto L_0016;
    spawnItem(Item.Digimushroom, 40, 54);
L_0016:
    setPStat(113, 0);
    if (!trigger(5) && !trigger(6) && !trigger(7)) goto L_0032;
    playAnimation(5, 29);
L_0032:
    if (!trigger(5) || !trigger(6)) goto L_0046;
    playAnimation(5, 30);
L_0046:
    if (!trigger(5) || !trigger(7)) goto L_005a;
    playAnimation(5, 30);
L_005a:
    if (!trigger(6) || !trigger(7)) goto L_006e;
    playAnimation(5, 30);
L_006e:
    if ((!trigger(5) ?? !trigger(6)) || !trigger(7)) goto L_0086;
    playAnimation(5, 31);
L_0086:
    return;
}

section section_6(6) {  // len=12
    setPStat(113, 1);
    jumpToScriptSection(206, 6);
    return;
}

section section_10(10) {  // len=8
    jumpToScriptSection(206, 10);
    return;
}

section section_7(7) {  // len=820
    if (!trigger(5) || !trigger(6)) goto L_002e;
    setDialogOwner(7);
    showTextbox("Hey, <LIGHTBLUE><PLAYER><WHITE>!\n");
    goto L_0104;
L_002e:
    if (!trigger(5) || !trigger(7)) goto L_005c;
    setDialogOwner(7);
    showTextbox("Hey, <LIGHTBLUE><PLAYER><WHITE>!\n");
    goto L_0104;
L_005c:
    if (!trigger(6) || !trigger(7)) goto L_008a;
    setDialogOwner(7);
    showTextbox("Hey, <LIGHTBLUE><PLAYER><WHITE>!\n");
    goto L_0104;
L_008a:
    if (!trigger(5) && !trigger(6) && !trigger(7)) goto L_00da;
    setDialogOwner(7);
    showTextbox("Thanks for coming again.\n");
    goto L_0104;
L_00da:
    setDialogOwner(7);
    showTextbox("Hi, I'm Mojyamon!\n");
L_0104:
    setPStat(254, 7);
    setPStat(249, 0);
    callSubroutine(2);
    if (!trigger(5) && !trigger(6) && !trigger(7)) goto L_0126;
    playAnimation(5, 29);
L_0126:
    if (!trigger(5) || !trigger(6)) goto L_013a;
    playAnimation(5, 30);
L_013a:
    if (!trigger(5) || !trigger(7)) goto L_014e;
    playAnimation(5, 30);
L_014e:
    if (!trigger(6) || !trigger(7)) goto L_0162;
    playAnimation(5, 30);
L_0162:
    if ((!trigger(5) ?? !trigger(6)) || !trigger(7)) goto L_017a;
    playAnimation(5, 31);
L_017a:
    if (trigger(5) && trigger(6) && trigger(7)) goto L_0190;
    return;
L_0190:
    if (trigger(8) && trigger(9) && trigger(10)) goto L_01a6;
    return;
L_01a6:
    if (trigger(11) && trigger(12) && trigger(13)) goto L_01bc;
    return;
L_01bc:
    if (!trigger(252)) goto L_01ca;
    return;
L_01ca:
    setDialogOwner(7);
    showTextbox("<LIGHTBLUE><PLAYER><WHITE>, I'm so happy!\nYou've done so much for us.\n");
    showTextbox("I've decided I'm going\nto the city. We'll work\ntogether, alright?\n");
    goto L_02ba;
L_02ba:
    move(entity: 7, to: (-1300, -1351), sprint: 1);
    if (pstat[101] >= 3) goto L_02e2;
    addPStat(101, 1);
    delay(20);
    look(entity: Entity.Player, at: 7);
    look(entity: Entity.Partner, at: 7);
    goto L_02ba;
L_02e2:
    waitForEntity(7);
    unloadEntity(7);
    setPStat(101, 0);
    playSound(8, 11);
    setDialogOwner(Entity.System);
    showTextbox("Mojyamon joins the city!\n");
    setTrigger(252);
    setTrigger(107);
    addPStat(1, 2);
    return;
}

section section_51(51) {  // len=1048
    if ((cond & 0x40) == 0x01 && !trigger(133)) goto L_0012;
    return;
L_0012:
    storeDigimonType(103);
    if (pstat[103] != 3 && pstat[103] != 5 && pstat[103] != 8 && pstat[103] != 9 && pstat[103] != 47) goto L_0036;
