// DG026.SCN
#include "functions.dgs"
#pragma script index=26 start=0x17800 end=0x18000 headerU16=0xc sentinelOff=0x56
#include "entities.dgs"

section onEnter(254) {
  playAnimation(Entity(5), Animation(29));
  return;
}

section(5) {
  setTrigger(Trigger(44));
  look(entity: Entity.Player, at: Entity(5));
  delay(10);
  sfx(8, 1, wait: 10);
  sfx(8, 1, wait: 10);
  speak(Entity(5), "「今日も~穴掘り~」<NEWLINE>");
  sfx(8, 1, wait: 10);
  sfx(8, 1, wait: 10);
  speak(Entity(5), "「明日も~穴掘り~」<NEWLINE>");
  sfx(8, 1, wait: 10);
  sfx(8, 1, wait: 10);
  speak(Entity(5), "「た~のし~いな~」<NEWLINE>");
  sfx(8, 1, wait: 10);
  look(entity: Entity(5), at: Entity.Player);
  showTextbox("「ん?何だ?ここはまだしばらく<NEWLINE> かかるぜ。他のとこに行きな。」<NEWLINE>");
  rotate(entity: Entity(5), to: 296);
  delay(20);
  playAnimation(Entity(5), Animation(29));
  return;
