// DG026.SCN
#include "functions.dgs"
#pragma script index=26 start=0x18000 end=0x19000 headerU16=0x28 sentinelOff=0x1a64
#include "entities.dgs"

section onEnter(254) {
  callSubroutine(26);
  switch pstat[17] {
    3 => {
      setPStat(PStat(254), 0);
      callSubroutine(19);
      for id in Entity(5)..Entity(7) {
        setAutotalk(id, 0);
      }
    }
    4 => {
      setPStat(PStat(254), 1);
      callSubroutine(19);
      for id in Entity(5)..Entity(7) {
        setAutotalk(id, 0);
      }
    }
  }
  return;
}

section(5) {
  if (pstat[17] >= 3) {
    speak(Entity(5), "Oh, thanks so much!\n");
    return;
  }
  speak(Entity(5), "What? You wanna fight?\n");
  finishEncounter(Trigger(280));
}

section(6) {
  if (pstat[17] >= 3) {
    speak(Entity(6), "Oh, thanks a lot!\n");
    return;
  }
  speak(Entity(6), "Leave it!\n");
  finishEncounter(Trigger(280));
}

section(7) {
  if (pstat[17] >= 3) {
    speak(Entity(7), "Don't push yourself!\n");
    return;
  }
  speak(Entity(7), "Let's fight, punk!\n");
  finishEncounter(Trigger(280));
}

section(9) {
  speak(Entity(9), "I give up!\n");
  return;
}

section(10) {
  speak(Entity(10), "The boss is gone.\n");
  return;
}

section(51) {
  if (!trigger(150) || trigger(234)) {
    return;
  }
  {
    move(entity: Entity.Player, to: (-165, 221), sprint: 0, withCamera: true);
    move(entity: Entity.Partner, to: (171, 615), sprint: 0);
    waitForPair();
    move(entity: Entity(9), to: (-323, 93), sprint: 0);
    move(entity: Entity(10), to: (498, -51), sprint: 0);
    move(entity: Entity(8), to: (160, -193), sprint: 0);
    for x in [Entity(5), Entity(6), Entity(8)] {
      waitForEntity(x);
    }
    rotate(entity: Entity.Player, to: 100);
    rotate(entity: Entity.Partner, to: 100);
    look(entity: Entity(9), at: Entity.Player);
    look(entity: Entity(10), at: Entity.Player);
    look(entity: Entity(8), at: Entity.Player);
    speak(Entity(8), "Hey guys, if you want\nto get thru here,");
    dead_string("?nt\nleave all your stuff!\n");
    speak(Entity.Player, "Long time no see.\n");
    speak(Entity(8), "Mmm. You guys again!\n");
    speak(Entity.Player, "That's my line!\nIt was so easy to find you.\nReady to lose?\n");
    playAnimation(Entity(8), Animation(32));
    speak(Entity(8), "Lose? No way!\nI'll show you what I do\nwhen I get serious!\n");
    playAnimation(Entity(8), Animation(0));
    speak(Entity.Player, "Let's settle this\nonce and for all!\n");
    setTrigger(Trigger(1));
    setPStat(PStat(250), 1);
    setPStat(PStat(251), 9);
    setPStat(PStat(252), 10);
    setPStat(PStat(253), 8);
    startBattle();
    unsetTrigger(Trigger(1));
    setPStat(PStat(250), 0);
    playAnimation(Entity(9), Animation(43));
    playAnimation(Entity(10), Animation(43));
    move(entity: Entity(8), to: (89, -659), sprint: 0);
    waitForEntity(Entity(8));
    rotate(entity: Entity(8), to: 100);
    lookPairAt(Entity(8));
    waitForEntity(Entity(8));
    anim(Entity(8), Animation(28), wait: 30);
    speak(Entity(8), "How come...I can't win?\n");
    playAnimation(Entity(8), Animation(29));
    anim(Entity.Player, Animation(19), wait: 20);
    speak(Entity.Player, "What's wrong?\nAren't you going to run?\n");
    playAnimation(Entity.Player, Animation(0));
    speak(Entity(8), "I'm too tired.\n");
    speak(Entity.Player, "...\n");
    speak(Entity(8), "I became a bandit cuz I\nthought this island was done\nfor, so I just did whatever.\n");
    speak(Entity.Player, "Did you know the island\nwas in trouble?\n");
    speak(Entity(8), "Yes, then you showed up.\nI guess it's dumb to\nstart helping you now.\n");
    anim(Entity.Player, Animation(19), wait: 15);
    speak(Entity.Player, "I don't think so.\nCome to the city.\n");
    playAnimation(Entity.Player, Animation(0));
    speak(Entity(8), "No, I can't. Plus, I don't\nthink anybody would forgive\nme for what I've done.\n");
    anim(Entity.Player, Animation(7), wait: 15);
    speak(Entity.Player, "Oh, just be quiet\nand come with me!\n");
    playAnimation(Entity.Player, Animation(0));
    move(entity: Entity.Player, to: (160, -193), sprint: 1, withCamera: true);
    waitForEntity(Entity.Player);
    rotate(entity: Entity.Player, to: 100);
    showTextbox("You can be helpful!\nEveryone has something\nto offer!\n");
    speak(Entity(8), "!!!\n");
    playAnimation(Entity(8), Animation(30));
    look(entity: Entity(8), at: Entity.Player);
    speak(Entity(8), "Can this island be saved?\nYou're going to save it\nfor us, right?!\n");
    move(entity: Entity(8), to: (119, -494), sprint: 1);
    waitForEntity(Entity(8));
    look(entity: Entity(8), at: Entity.Player);
    speak(Entity.Player, "Of course! You know\nwhere the city is, right?\n");
    speak(Entity(8), "Ohhhhh!\nI'll be there!\n");
    break;
  }
  move(entity: Entity(8), to: (155, 873), sprint: 1);
  if (pstat[101] < 6) {
    addPStat(PStat.LoopIterator, 1);
    delay(10);
    lookPairAt(Entity(8));
  }
  waitForEntity(Entity(8));
  unloadEntity(Entity(8));
  setPStat(PStat.LoopIterator, 0);
  playSound(8, 8);
  speak(Entity.System, "Ogremon joins the city!\n");
  setTrigger(Trigger(234));
  addPStat(PStat(1), 2);
  followEntity(Entity.Player, speed: 10);
  return;
}

section(52) {
  switch pstat[17] {
    3 => {
      speak(Entity.Player, "Ooops!\nExit isn't this way!\n");
      move(entity: Entity.Player, to: (-51, -1550), sprint: 1);
      waitForEntity(Entity.Player);
      followEntity(Entity.Player, speed: 10);
      return;
    }
    4 => {
      speak(Entity.Player, "Oh no! I have to return\nthe dirt box to Drimogemon!\n");
      move(entity: Entity.Player, to: (-51, -1550), sprint: 1);
      waitForEntity(Entity.Player);
      followEntity(Entity.Player, speed: 10);
      return;
    }
  }
  if (trigger(209) && pstat[1] >= 45) {
    move(entity: Entity.Player, to: (-105, -2200), sprint: 0);
    warp(to: Map.TUNN03_2, spawn: 0, trigger: 255);
  }
  move(entity: Entity.Player, to: (-105, -2200), sprint: 0);
  warp(to: Map.TUNN03, spawn: 0, trigger: 255);
}

section(53) {
  switch pstat[17] {
    3 => {
      speak(Entity.Player, "Ooops! Exit isn't this way!\n");
      move(entity: Entity.Player, to: (-2253, 359), sprint: 1);
      waitForEntity(Entity.Player);
      followEntity(Entity.Player, speed: 10);
      return;
    }
    4 => {
      speak(Entity.Player, "Oh no! I have to return\nthe dirt box to Drimogemon!\n");
      move(entity: Entity.Player, to: (-2253, 359), sprint: 1);
      waitForEntity(Entity.Player);
      followEntity(Entity.Player, speed: 10);
      return;
    }
  }
  return;
