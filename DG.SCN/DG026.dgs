// DG026.SCN
#pragma script index=26 start=0x18000 end=0x19000 headerU16=0x28 sentinelOff=0x1a64

section onEnter(254) {  // len=64
    callSubroutine(26);
    if (pstat[17] != 3) goto L1;
    setPStat(254, 0);
    callSubroutine(19);
    for id in 5..7 { setAutotalk(id, 0); }

L1:
    if (pstat[17] != 4) goto L2;
    setPStat(254, 1);
    callSubroutine(19);
    for id in 5..7 { setAutotalk(id, 0); }

L2:
    return;
}

section(5) {  // len=126
    if (pstat[17] < 3) goto L1;
    setDialogOwner(5);
    showTextbox("Oh, thanks so much!\n");
    return;

L1:
    setDialogOwner(5);
    showTextbox("What? You wanna fight?\n");
    fadeOutHUD();
    delay(1);
    startBattle();
    setTrigger(280);
    return;
}

section(6) {  // len=96
    if (pstat[17] < 3) goto L1;
    setDialogOwner(6);
    showTextbox("Oh, thanks a lot!\n");
    return;

L1:
    setDialogOwner(6);
    showTextbox("Leave it!\n");
    fadeOutHUD();
    delay(1);
    startBattle();
    setTrigger(280);
    return;
}

section(7) {  // len=120
    if (pstat[17] < 3) goto L1;
    setDialogOwner(7);
    showTextbox("Don't push yourself!\n");
    return;

L1:
    setDialogOwner(7);
    showTextbox("Let's fight, punk!\n");
    fadeOutHUD();
    delay(1);
    startBattle();
    setTrigger(280);
    return;
}

section(9) {  // len=30
    setDialogOwner(9);
    showTextbox("I give up!\n");
    return;
}

section(10) {  // len=44
    setDialogOwner(10);
    showTextbox("The boss is gone.\n");
    return;
}

section(51) {  // len=2240
    if (trigger(150) && !trigger(234)) goto L1;
    return;

L1:
    move(entity: Entity.Player, to: (-165, 221), sprint: 0, withCamera: true);
    move(entity: Entity.Partner, to: (171, 615), sprint: 0);
    waitForEntity(Entity.Player);
    waitForEntity(Entity.Partner);
    move(entity: 9, to: (-323, 93), sprint: 0);
    move(entity: 10, to: (498, -51), sprint: 0);
    move(entity: 8, to: (160, -193), sprint: 0);
    waitForEntity(5);
    waitForEntity(6);
    waitForEntity(8);
    rotate(entity: Entity.Player, to: 100);
    rotate(entity: Entity.Partner, to: 100);
    look(entity: 9, at: Entity.Player);
    look(entity: 10, at: Entity.Player);
    look(entity: 8, at: Entity.Player);
    setDialogOwner(8);
    showTextbox("Hey guys, if you want\nto get thru here,");
    dead_string("?nt\nleave all your stuff!\n");
    setDialogOwner(Entity.Player);
    showTextbox("Long time no see.\n");
    setDialogOwner(8);
    showTextbox("Mmm. You guys again!\n");
    setDialogOwner(Entity.Player);
    showTextbox("That's my line!\nIt was so easy to find you.\nReady to lose?\n");
    playAnimation(8, 32);
    setDialogOwner(8);
    showTextbox("Lose? No way!\nI'll show you what I do\nwhen I get serious!\n");
    playAnimation(8, 0);
    setDialogOwner(Entity.Player);
    showTextbox("Let's settle this\nonce and for all!\n");
    setTrigger(1);
    setPStat(250, 1);
    setPStat(251, 9);
    setPStat(252, 10);
    setPStat(253, 8);
    fadeOutHUD();
    delay(1);
    startBattle();
    unsetTrigger(1);
    setPStat(250, 0);
    playAnimation(9, 43);
    playAnimation(10, 43);
    move(entity: 8, to: (89, -659), sprint: 0);
    waitForEntity(8);
    rotate(entity: 8, to: 100);
    look(entity: Entity.Player, at: 8);
    look(entity: Entity.Partner, at: 8);
    waitForEntity(8);
    playAnimation(8, 28);
    delay(30);
    setDialogOwner(8);
    showTextbox("How come...I can't win?\n");
    playAnimation(8, 29);
    playAnimation(Entity.Player, 19);
    delay(20);
    setDialogOwner(Entity.Player);
    showTextbox("What's wrong?\nAren't you going to run?\n");
    playAnimation(Entity.Player, 0);
    setDialogOwner(8);
    showTextbox("I'm too tired.\n");
    setDialogOwner(Entity.Player);
    showTextbox("...\n");
    setDialogOwner(8);
    showTextbox("I became a bandit cuz I\nthought this island was done\nfor, so I just did whatever.\n");
    setDialogOwner(Entity.Player);
    showTextbox("Did you know the island\nwas in trouble?\n");
    setDialogOwner(8);
    showTextbox("Yes, then you showed up.\nI guess it's dumb to\nstart helping you now.\n");
    playAnimation(Entity.Player, 19);
    delay(15);
    setDialogOwner(Entity.Player);
    showTextbox("I don't think so.\nCome to the city.\n");
    playAnimation(Entity.Player, 0);
    setDialogOwner(8);
    showTextbox("No, I can't. Plus, I don't\nthink anybody would forgive\nme for what I've done.\n");
    playAnimation(Entity.Player, 7);
    delay(15);
    setDialogOwner(Entity.Player);
    showTextbox("Oh, just be quiet\nand come with me!\n");
    playAnimation(Entity.Player, 0);
    move(entity: Entity.Player, to: (160, -193), sprint: 1, withCamera: true);
    waitForEntity(Entity.Player);
    rotate(entity: Entity.Player, to: 100);
    showTextbox("You can be helpful!\nEveryone has something\nto offer!\n");
    setDialogOwner(8);
    showTextbox("!!!\n");
    playAnimation(8, 30);
    look(entity: 8, at: Entity.Player);
    setDialogOwner(8);
    showTextbox("Can this island be saved?\nYou're going to save it\nfor us, right?!\n");
    move(entity: 8, to: (119, -494), sprint: 1);
    waitForEntity(8);
    look(entity: 8, at: Entity.Player);
    setDialogOwner(Entity.Player);
    showTextbox("Of course! You know\nwhere the city is, right?\n");
    setDialogOwner(8);
    showTextbox("Ohhhhh!\nI'll be there!\n");
    goto L2;

L2:
    move(entity: 8, to: (155, 873), sprint: 1);
    if (pstat[101] >= 6) goto L3;
    addPStat(101, 1);
    delay(10);
    look(entity: Entity.Player, at: 8);
    look(entity: Entity.Partner, at: 8);

L3:
    waitForEntity(8);
    unloadEntity(8);
    setPStat(101, 0);
    playSound(8, 8);
    setDialogOwner(Entity.System);
    showTextbox("Ogremon joins the city!\n");
    setTrigger(234);
    addPStat(1, 2);
    moveCamera(to: Entity.Player, speed: 10);
    waitForEntity(200);
    return;
}

section(52) {  // len=272
    if (pstat[17] != 3) goto L1;
    setDialogOwner(Entity.Player);
    showTextbox("Ooops!\nExit isn't this way!\n");
    move(entity: Entity.Player, to: (-51, -1550), sprint: 1);
    waitForEntity(Entity.Player);
    moveCamera(to: Entity.Player, speed: 10);
    waitForEntity(200);
    return;

L1:
    if (pstat[17] != 4) goto L2;
    setDialogOwner(Entity.Player);
    showTextbox("Oh no! I have to return\nthe dirt box to Drimogemon!\n");
    move(entity: Entity.Player, to: (-51, -1550), sprint: 1);
    waitForEntity(Entity.Player);
    moveCamera(to: Entity.Player, speed: 10);
    waitForEntity(200);
    return;

L2:
    if (!trigger(209) || pstat[1] < 45) goto L3;
    move(entity: Entity.Player, to: (-105, -2200), sprint: 0);
    warp(to: Map.TUNN03_2, spawn: 0, trigger: 255);

L3:
    move(entity: Entity.Player, to: (-105, -2200), sprint: 0);
    warp(to: Map.TUNN03, spawn: 0, trigger: 255);
}

