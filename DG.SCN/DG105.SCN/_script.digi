; DG105.SCN
;!script index=105 start=0x4b000 end=0x4c000 headerU16=0x24 sentinelOff=0x19
;!sections onEnter section_5 section_6 section_7 section_8 section_9 section_51 section_52

onEnter:     ; len=136
  0000:  if pstat[1] >= 10 then onEnter+0x18
  000c:  setObjectVisibility 18 0
  0010:  setObjectVisibility 23 1
  0014:  jump onEnter+0x20
  0018:  setObjectVisibility 18 1
  001c:  setObjectVisibility 23 0
  0020:  storeRandom 110 99
  0024:  if pstat[110] > 2 then onEnter+0x36
  0030:  spawnItem 69 61 64
  0036:  storeRandom 110 99
  003a:  if pstat[110] > 29 then onEnter+0x4c
  0046:  spawnItem 44 55 71
  004c:  storeRandom 110 99
  0050:  if pstat[110] > 39 then onEnter+0x62
  005c:  spawnItem 44 36 44
  0062:  if pstat[1] < 25 then onEnter+0x86
  006e:  setObjectVisibility 28 0
  0072:  setObjectVisibility 29 0
  0076:  setObjectVisibility 30 0
  007a:  setObjectVisibility 31 0
  007e:  setObjectVisibility 32 0
  0082:  setObjectVisibility 33 0
  0086:  endSection
