// DG084.SCN
#include "functions.dgs"
#pragma script index=84 start=0x38800 end=0x39000 headerU16=0x24 sentinelOff=0x24
#include "entities.dgs"

section onEnter(254) {
  spawnItemChance(max: 99, chance: 17, item: Item.Digimushroom, x: 49, y: 27);
  spawnItemChance(max: 99, chance: 8, item: Item.Digimushroom, x: 39, y: 50);
  spawnItemChance(max: 99, chance: 1, item: Item.IceMushroom, x: 53, y: 70);
  return;
}

section(5) {
  speak(Entity(5), "「お前の持ち物、もらった!」<NEWLINE>");
  finishEncounter(Trigger(303));
}

section(6) {
  speak(Entity(6), "「へへ、悪いな!」<NEWLINE>");
  finishEncounter(Trigger(303));
}

section(7) {
  speak(Entity(7), "「俺さまにかなうわけねーだろ!」<NEWLINE>");
  finishEncounter(Trigger(272));
}

section(8) {
  speak(Entity(8), "「地獄へ落ちろ!」<NEWLINE>");
  finishEncounter(Trigger(300));
}

section(9) {
  speak(Entity(9), "「フッ、わらわせるな。」<NEWLINE>");
  finishEncounter(Trigger(300));
}

section(10) {
  speak(Entity(10), "「この先に進ませるわけにはいかない。」<NEWLINE>");
  finishEncounter(Trigger(300));
}

