// DG084.SCN
#include "functions.dgs"
#pragma script index=84 start=0x3c800 end=0x3d000 headerU16=0x24 sentinelOff=0x24
#include "entities.dgs"

section onEnter(254) {
  roll(pstat: 110, max: 99);
  if (pstat[110] > 17) goto L1;
  spawnItem(Item.Digimushroom, x: 43, y: 35);

L1:
  roll(pstat: 110, max: 99);
  if (pstat[110] > 10) goto L2;
  spawnItem(Item.Digimushroom, x: 38, y: 67);

L2:
  roll(pstat: 110, max: 99);
  if (pstat[110] > 7) goto L3;
  spawnItem(Item.Digimushroom, x: 50, y: 81);

L3:
  return;
}

section(5) {
  speak(5, "Ahhh, it's warm!\n");
  startBattle();
  setTrigger(271);
  return;
}

section(6) {
  speak(6, "So you want to go thru here?\nDon't even think about it!\n");
  startBattle();
  setTrigger(303);
  return;
}

section(7) {
  speak(7, "Oh, poor thing, ha ha ha!\n");
  startBattle();
  setTrigger(300);
  return;
}

section(8) {
  speak(8, "I'll beat you!\n");
  startBattle();
  setTrigger(300);
  return;
}

section(81) {
  rotate(entity: Entity.Player, to: 943);
  speak(Entity.System, "Very cold beyond here.\nUnless <RED>he can stand\ncold <WHITE>don't enter.\n");
  return;
}

section(53) {
  if ((cond & 0x40) == 0x01 && !trigger(133)) goto L1;
  return;

L1:
  storeDigimonType(103);
  if (pstat[103] != 3 && pstat[103] != 5 && pstat[103] != 8 && pstat[103] != 9 && pstat[103] != 47) goto L2;
  jumpToScriptSection(203, 51);

L2:
  if (pstat[103] != 19 && pstat[103] != 32 && pstat[103] != 51 && pstat[103] != 1 && pstat[103] != 2) goto L3;
  jumpToScriptSection(203, 51);

L3:
  if (pstat[103] != 15 && pstat[103] != 16 && pstat[103] != 29 && pstat[103] != 30 && pstat[103] != 43) goto L4;
  jumpToScriptSection(203, 51);

L4:
  if (pstat[103] != 44 && pstat[103] != 21) goto L5;
  jumpToScriptSection(203, 51);

L5:
  return;
}

section(51) {
  move(entity: Entity.Player, to: (-1100, -5300), sprint: 0);
  if (trigger(180)) goto L1;
  warp(to: Map.GCAN04_2, spawn: 1, trigger: 255);

