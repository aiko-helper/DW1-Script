// DG084.SCN
#pragma script index=84 start=0x3c800 end=0x3d000 headerU16=0x24 sentinelOff=0x24

section onEnter(254) {  // len=68
    roll(pstat: 110, max: 99);
    if (pstat[110] > 17) goto L_0016;
    spawnItem(Item.Digimushroom, 43, 35);
L_0016:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 10) goto L_002c;
    spawnItem(Item.Digimushroom, 38, 67);
L_002c:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 7) goto L_0042;
    spawnItem(Item.Digimushroom, 50, 81);
L_0042:
    return;
}

section section_5(5) {  // len=54
    setDialogOwner(5);
    showTextbox("Ahhh, it's warm!\n");
    fadeOutHUD();
    delay(1);
    startBattle();
    setTrigger(271);
    return;
}

section section_6(6) {  // len=132
    setDialogOwner(6);
    showTextbox("So you want to go thru here?\nDon't even think about it!\n");
    fadeOutHUD();
    delay(1);
    startBattle();
    setTrigger(303);
    return;
}

section section_7(7) {  // len=72
    setDialogOwner(7);
    showTextbox("Oh, poor thing, ha ha ha!\n");
    fadeOutHUD();
    delay(1);
    startBattle();
    setTrigger(300);
    return;
}

section section_8(8) {  // len=50
    setDialogOwner(8);
    showTextbox("I'll beat you!\n");
    fadeOutHUD();
    delay(1);
    startBattle();
    setTrigger(300);
    return;
}

section section_81(81) {  // len=138
    rotate(entity: Entity.Player, to: 943);
    setDialogOwner(Entity.System);
    showTextbox("Very cold beyond here.\nUnless <RED>he can stand\ncold <WHITE>don't enter.\n");
    return;
}

section section_53(53) {  // len=146
    if ((cond & 0x40) == 0x01 && !trigger(133)) goto L_0012;
    return;
L_0012:
    storeDigimonType(103);
    if (pstat[103] != 3 && pstat[103] != 5 && pstat[103] != 8 && pstat[103] != 9 && pstat[103] != 47) goto L_0036;
    jumpToScriptSection(203, 51);
L_0036:
    if (pstat[103] != 19 && pstat[103] != 32 && pstat[103] != 51 && pstat[103] != 1 && pstat[103] != 2) goto L_0058;
    jumpToScriptSection(203, 51);
L_0058:
    if (pstat[103] != 15 && pstat[103] != 16 && pstat[103] != 29 && pstat[103] != 30 && pstat[103] != 43) goto L_007a;
    jumpToScriptSection(203, 51);
L_007a:
    if (pstat[103] != 44 && pstat[103] != 21) goto L_0090;
    jumpToScriptSection(203, 51);
L_0090:
    return;
}

