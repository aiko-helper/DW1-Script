// MAP137.SCN
#include "functions.dgs"
#pragma script index=137 start=0x61800 end=0x62000 headerU16=0xc sentinelOff=0x6e75
#include "entities.dgs"

section onEnter(254) {
  spawnChest(Item.MystyEgg, 1667, -1966, 2048, 672);
  return;
}

section(51) {
  if (trigger(150)) goto L1;
  speak(Entity.Player, "Uggh!\n");
  move(entity: Entity.Player, to: (1104, 243), sprint: 1);
  move(entity: Entity.Partner, to: (675, 290), sprint: 1);
  waitForEntity(Entity.Player);
  moveCamera(to: (1156, -416), slowdown: 20);
  waitForEntity(200);
  look(entity: Entity.Player, at: 5);
  look(entity: Entity.Partner, at: 5);
  delay(5);
  speak(5, "What?\n");
  look(entity: 5, at: Entity.Player);
  look(entity: 6, at: Entity.Player);
  look(entity: 7, at: Entity.Player);
  speak(5, "What?!\n");
  look(entity: 7, at: 5);
  delay(10);
  look(entity: 7, at: Entity.Player);
  speak(7, "Oh Boss, we're in trouble!\n");
  playAnimation(Entity.Player, 20);
  delay(15);
  speak(Entity.Player, "What are you guys doing?\n");
  playAnimation(Entity.Player, 0);
  speak(5, "I'm impressed. You found\nthe New Ogre Fortress!\n");
  playAnimation(Entity.Player, 7);
  delay(15);
  speak(Entity.Player, "Going to commit more crimes?\n");
  playAnimation(Entity.Player, 0);
  speak(5, "Of course! He he!\n");
  speak(Entity.Player, "I won't let you do that!\nYou'd better get out\nof this cave!\n");
  speak(5, "This time, it's different!\n");
  look(entity: 6, at: 5);
  look(entity: 5, at: 6);
  delay(10);
  speak(6, "Boss, is that it?\n");
  delay(10);
  speak(5, "Yeah. Go!\n");
  move(entity: 6, to: (861, -1338), sprint: 1);
  waitForEntity(6);
  unloadEntity(6);
  move(entity: 7, to: (8, -717), sprint: 1);
  waitForEntity(7);
  look(entity: 7, at: Entity.Player);
  delay(5);
  setDigimon(Digimon.WaruSeadramon, 3, 0);
  move(entity: 8, to: (586, -461), sprint: 0);
  waitForEntity(8);
  look(entity: 8, at: Entity.Player);
  delay(5);
  speak(Entity.Player, "What the?!\n");
  look(entity: 5, at: 8);
  delay(5);
  speak(5, "Master WaruSeadramon!\nGo ahead and do it, please!\n");
  speak(Entity.Player, "He's your bodyguard, huh?\n");
  look(entity: 5, at: Entity.Player);
  delay(5);
  speak(5, "He he he! You're finished!\n");
  setTrigger(1);
  setPStat(250, 1);
  setPStat(251, 5);
  setPStat(252, 7);
  setPStat(253, 8);
  startBattle();
  unsetTrigger(1);
  setPStat(250, 0);
  look(entity: Entity.Player, at: 5);
  look(entity: 5, at: Entity.Player);
  look(entity: Entity.Partner, at: 5);
  move(entity: 5, to: (1100, 1000), sprint: 1);
  move(entity: 7, to: (1100, 1000), sprint: 1);
  move(entity: 8, to: (1100, 1000), sprint: 1);
  speak(5, "Darn!\n");
  speak(7, "Ahhhhhh!\n");
  for x in [5, 7, 8] {
    waitForEntity(x);
  }
  for x in [5, 7, 8] {
    unloadEntity(x);
  }
  speak(Entity.Player, "I won't let you get away!\n");
  setTrigger(150);
  move(entity: Entity.Player, to: (1100, 1000), sprint: 1);
  delay(10);
  move(entity: Entity.Partner, to: (1100, 1000), sprint: 1);
  warp(to: Map.OGRE10, spawn: 0, trigger: 6);

L1:
  return;
  garbage { 0c 00 fe 00 0c 00 33 00 1a 00 ff ff 75 6e 83 06 00 00 52 f8 00 08 a0 02 fe 00 19 00 01 00 96 00 18 00 1a 05 19 00 1b fd 1a 00 82 74 82 87 82 87 82 88 81 49 0d 00 00 00 4e fd 50 04 f3 00 01 00 4e fc a3 02 22 01 01 00 4a fd 4f 14 84 04 60 fe 4a c8 4c 00 fd 05 4c 00 fc 05 67 00 05 00 1b 05 1a 00 82 76 82 88 82 81 82 94 81 48 0d 00 00 00 4c 00 05 fd 4c 00 06 fd 4c 00 07 fd 1b 05 1a 00 82 76 82 88 82 81 82 94 81 48 81 49 0d 00 00 00 4c 00 07 05 67 00 0a 00 4c 00 07 fd 1b 07 1a 00 82 6e 82 88 81 40 82 61 82 8f 82 93 82 93 81 43 81 40 82 97 82 85 81 75 82 92 82 85 81 40 82 89 82 8e 81 40 82 94 82 92 82 8f 82 95 82 82 82 8c 82 85 81 49 0d 00 00 00 56 00 fd 14 67 00 0f 00 1b fd 1a 00 82 76 82 88 82 81 82 94 81 40 82 81 82 92 82 85 81 40 82 99 82 8f 82 95 81 40 82 87 82 95 82 99 82 93 81 40 82 84 82 8f 82 89 82 8e 82 87 81 48 0d 00 00 00 56 00 fd 00 1b 05 1a 00 82 68 81 75 82 8d 81 40 82 89 82 8d 82 90 82 92 82 85 82 93 82 93 82 85 82 84 81 42 81 40 82 78 82 8f 82 95 81 40 82 86 82 8f 82 95 82 8e 82 84 0d 00 82 94 82 88 82 85 81 40 82 6d 82 85 82 97 81 40 82 6e 82 87 82 92 82 85 81 40 82 65 82 8f 82 92 82 94 82 92 82 85 82 93 82 93 81 49 0d 00 00 00 56 00 fd 07 67 00 0f 00 1b fd 1a 00 82 66 82 8f 82 89 82 8e 82 87 81 40 82 94 82 8f 81 40 82 83 82 8f 82 8d 82 8d 82 89 82 94 81 40 82 8d 82 8f 82 92 82 85 81 40 82 83 82 92 82 89 82 8d 82 85 82 93 81 48 0d 00 00 00 56 00 fd 00 1b 05 1a 00 82 6e 82 86 81 40 82 83 82 8f 82 95 82 92 82 93 82 85 81 49 81 40 82 67 82 85 81 40 82 88 82 85 81 49 0d 00 00 00 1b fd 1a 00 82 68 81 40 82 97 82 8f 82 8e 81 75 82 94 81 40 82 8c 82 85 82 94 81 40 82 99 82 8f 82 95 81 40 82 84 82 8f 81 40 82 94 82 88 82 81 82 94 81 49 0d 00 82 78 82 8f 82 95 81 75 82 84 81 40 82 82 82 85 82 94 82 94 82 85 82 92 81 40 82 87 82 85 82 94 81 40 82 8f 82 95 82 94 0d 00 82 8f 82 86 81 40 82 94 82 88 82 89 82 93 81 40 82 83 82 81 82 96 82 85 81 49 0d 00 00 00 1b 05 1a 00 82 73 82 88 82 89 82 93 81 40 82 94 82 89 82 8d 82 85 81 43 81 40 82 89 82 94 81 75 82