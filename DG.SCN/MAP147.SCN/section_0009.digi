section_9:     ; len=1804
  0000:  setDialogOwner 9
  0002:  showTextbox "Who are you?\n"
  0020:  showTextbox "I'm MetalMamemon, unbeaten\nin ninety nine battles!\nYou will be one hundred!\n"
  00bc:  showTextbox "I don't believe anyone like\n<LIGHTBLUE><PLAYER><WHITE>would run away.\n"
  011e:  setDialogOwner 253
