// DG066.SCN
#pragma script index=66 start=0x30000 end=0x30800 headerU16=0x1c sentinelOff=0x24

section onEnter(254) {  // len=68
    roll(pstat: 110, max: 99);
    if (pstat[110] > 9) goto L1;
    spawnItem(Item.Digimushroom, x: 65, y: 67);

L1:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 2) goto L2;
    spawnItem(Item.Happymushroom, x: 57, y: 49);

L2:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 0) goto L3;
    spawnItem(Item.PowerIce, x: 32, y: 88);

L3:
    return;
}

section(5) {  // len=56
    speak(5, "I love the ocean.\n");
    fadeOutHUD();
    delay(1);
    startBattle();
    setTrigger(275);
    return;
}

section(6) {  // len=58
    speak(6, "Get out of my way!\n");
    fadeOutHUD();
    delay(1);
    startBattle();
    setTrigger(275);
    return;
}

section(7) {  // len=56
    speak(7, "I have good news.\n");
    fadeOutHUD();
    delay(1);
    startBattle();
    setTrigger(296);
    return;
}

section(8) {  // len=68
    speak(8, "Well, it's pretty good.\n");
    fadeOutHUD();
    delay(1);
    startBattle();
    setTrigger(279);
    return;
}

section(51) {  // len=1714
    move(entity: Entity.Player, to: (200, -4700), sprint: 0);
    if (!trigger(353) || pstat[30] < 3) goto L1;
    setTrigger(126);

L1:
    if (!trigger(126)) goto L2;
    warp(to: Map.MIHA04B, spawn: 1, trigger: 255);

