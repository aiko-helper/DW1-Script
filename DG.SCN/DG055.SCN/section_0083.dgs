// source: extract/DIGIMON/SCN/DG.SCN
// DG055.SCN, section 83

section section_83(83) {  // len=810
    rotate(entity: Entity.Player, to: 1024);
    delay(5);
    if (!trigger(348)) goto L_00e8;
    if (trigger(100)) goto L_0028;
    rotate3DObject(2, 1);
    rotate3DObject(3, 1);
L_0028:
    delay(20);
    setDialogOwner(Entity.Player);
    showTextbox("What does it say?\n");
    setDialogOwner(Entity.System);
    showTextbox("Return to the position\nwhere you got the points\nfrom the dumb one.\n");
    setTrigger(100);
    return;
L_00e8:
    if (item[Item.FridgeKey] < 1 || trigger(348)) goto L_0282;
    setTrigger(100);
    playSound(8, 3);
    setDialogOwner(Entity.System);
    showTextbox("I used a <LIGHTBLUE>\nrefrigerator key. <WHITE>\n");
    rotate3DObject(2, 1);
    rotate3DObject(3, 1);
    delay(60);
    removeItem(Item.FridgeKey, 1);
    playAnimation(Entity.Player, 24);
    delay(15);
    setDialogOwner(Entity.Player);
    showTextbox("I don't see it.\n");
    playAnimation(Entity.Player, 0);
    setDialogOwner(Entity.Player);
    showTextbox("There's a memo.\n");
    setDialogOwner(Entity.System);
    showTextbox("Return to the position\nwhere you got the points\nfrom the dumb one.\n");
    setDialogOwner(Entity.Player);
    showTextbox("I should listen to this memo.\n");
    setTrigger(348);
    return;
L_0282:
    if (item[Item.FridgeKey] >= 1 || trigger(348)) goto L_0328;
    setDialogOwner(Entity.Player);
    showTextbox("It's a refrigerator.\n");
    setDialogOwner(Entity.Player);
    showTextbox("It's locked. I've never seen\na locked fridge.\n");
    return;
L_0328:
    return;
}
