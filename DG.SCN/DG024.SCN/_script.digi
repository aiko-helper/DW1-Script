; DG024.SCN
;!script index=24 start=0x17000 end=0x17800 headerU16=0x2c sentinelOff=0x24
;!sections onEnter section_5 section_6 section_7 section_8 section_9 section_10 section_11 section_12 section_51

onEnter:     ; len=68
  0000:  storeRandom 110 99
  0004:  if pstat[110] > 7 then onEnter+0x16
  0010:  spawnItem 44 44 33
  0016:  storeRandom 110 99
  001a:  if pstat[110] > 15 then onEnter+0x2c
  0026:  spawnItem 44 23 49
  002c:  storeRandom 110 99
  0030:  if pstat[110] > 3 then onEnter+0x42
  003c:  spawnItem 51 25 74
  0042:  endSection
