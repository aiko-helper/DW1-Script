// source: extract/DIGIMON/SCN/DG.SCN
// DG024.SCN, section 51

section section_51(51) {  // len=1566
    if (!trigger(150) || trigger(234)) goto L_0088;
    setDialogOwner(Entity.Player);
    showTextbox("I got bad feeling.\n");
    look(entity: Entity.Player, at: Entity.Partner);
    look(entity: Entity.Partner, at: Entity.Player);
    delay(5);
    setDialogOwner(Entity.Player);
    showTextbox("You too? I thought so.\n");
    move(entity: Entity.Player, to: (1745, -1614), sprint: 0);
    waitForEntity(Entity.Player);
    return;
L_0088:
    if (!trigger(238)) goto L_0136;
    if (trigger(150) && !trigger(234)) goto L_0136;
    setDialogOwner(Entity.Player);
    showTextbox("There's nothing in the\ntunnel. Should we go thru?\n");
    setSelection(L_0138, L_0144);
    showTextbox("Go\nDon't go\n");
    waitForSelectionChoice();
    goto L_0144;
L_0136:
    return;
L_0138:
    move(entity: Entity.Player, to: (2876, -1583), sprint: 1);
    warp(to: Map.MAYO11, spawn: 1, trigger: 255);
L_0144:
    move(entity: Entity.Player, to: (2876, -1583), sprint: 0);
    warp(to: Map.TUNN09, spawn: 1, trigger: 255);
    return;
