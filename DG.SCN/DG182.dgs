// DG182.SCN
#pragma script index=182 start=0x8b800 end=0x8c000 headerU16=0x14 sentinelOff=0xfe

section onEnter(254) {  // len=2
    return;
}

section section_51(51) {  // len=14
    move(entity: Entity.Player, to: (-370, -4600), sprint: 0);
    warp(to: Map.MGEN10, spawn: 1, trigger: 255);
    return;
}

section section_52(52) {  // len=14
    move(entity: Entity.Player, to: (-400, 4800), sprint: 0);
    warp(to: Map.MGEN99, spawn: 0, trigger: 255);
    return;
}

section section_53(53) {  // len=1998
    if (!trigger(326)) goto L_000e;
    return;
L_000e:
    look(entity: Entity.Player, at: 5);
    moveCamera(to: (-400, 2400), slowdown: 15);
    waitForEntity(200);
    look(entity: 5, at: Entity.Player);
    delay(5);
    setDialogOwner(5);
    showTextbox("We're here at last.\n");
    playAnimation(Entity.Player, 20);
    delay(15);
    setDialogOwner(Entity.Player);
    showTextbox("Are you the boss?\n");
    playAnimation(Entity.Player, 0);
    setDialogOwner(5);
    showTextbox("I'm sorry, I'm not.\nI'm MetalGreymon!\n");
    setDialogOwner(Entity.Player);
    playAnimation(Entity.Player, 19);
    delay(15);
    showTextbox("I'll deal with you later!\nMove!\n");
    playAnimation(Entity.Player, 0);
    setDialogOwner(5);
    showTextbox("I will not move for you.\nYou won't get past me.\n");
    setDialogOwner(Entity.Player);
    showTextbox("I want to save energy.\nFighting him won't help me.\n");
    setDialogOwner(5);
    showTextbox("I'm coming to get you!\n");
    setTrigger(1);
    setPStat(250, 1);
    setPStat(251, 5);
    setPStat(252, 255);
    setPStat(253, 255);
    fadeOutHUD();
    delay(1);
    startBattle();
    unsetTrigger(1);
    setPStat(250, 0);
    look(entity: Entity.Player, at: 5);
    look(entity: 5, at: Entity.Player);
    look(entity: Entity.Partner, at: 5);
    setDialogOwner(5);
    showTextbox("Huh? Where am I?\n");
    setDialogOwner(Entity.Player);
    showTextbox("You regained your senses!\n");
    setDialogOwner(5);
    showTextbox("I guess so...\n");
    showTextbox("If you beat them\nmaybe I'll see you again.\nUntil then, I'm gone.\n");
    goto L_036e;
L_036e:
    move(entity: 5, to: (-400, -500), sprint: 0);
    if (pstat[101] >= 3) goto L_0396;
    addPStat(101, 1);
    delay(20);
    look(entity: Entity.Player, at: 5);
    look(entity: Entity.Partner, at: 5);
    goto L_036e;
L_0396:
    waitForEntity(5);
    unloadEntity(5);
    setPStat(101, 0);
    moveCamera(to: Entity.Player, speed: 10);
    waitForEntity(200);
    setTrigger(326);
    return;
