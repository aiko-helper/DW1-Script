// DG182.SCN
#include "functions.dgs"
#pragma script index=182 start=0x8b800 end=0x8c000 headerU16=0x14 sentinelOff=0xfe
#include "entities.dgs"

section onEnter(254) {
  return;
}

section(51) {
  move(entity: Entity.Player, to: (-370, -4600), sprint: 0);
  warp(to: Map.MGEN10, spawn: 1, trigger: 255);
  return;
}

section(52) {
  move(entity: Entity.Player, to: (-400, 4800), sprint: 0);
  warp(to: Map.MGEN99, spawn: 0, trigger: 255);
  return;
}

section(53) {
  if (trigger(326)) {
    return;
  }
  {
    look(entity: Entity.Player, at: Entity(5));
    panTo(x: -400, y: 2400, slowdown: 15);
    look(entity: Entity(5), at: Entity.Player);
    delay(5);
    speak(Entity(5), "We're here at last.\n");
    anim(Entity.Player, Animation(20), wait: 15);
    speak(Entity.Player, "Are you the boss?\n");
    playAnimation(Entity.Player, Animation(0));
    speak(Entity(5), "I'm sorry, I'm not.\nI'm MetalGreymon!\n");
    setDialogOwner(Entity.Player);
    anim(Entity.Player, Animation(19), wait: 15);
    showTextbox("I'll deal with you later!\nMove!\n");
    playAnimation(Entity.Player, Animation(0));
    speak(Entity(5), "I will not move for you.\nYou won't get past me.\n");
    speak(Entity.Player, "I want to save energy.\nFighting him won't help me.\n");
    speak(Entity(5), "I'm coming to get you!\n");
    setTrigger(Trigger(1));
    setPStat(PStat(250), 1);
    setPStat(PStat(251), 5);
    setPStat(PStat(252), 255);
    setPStat(PStat(253), 255);
    startBattle();
    unsetTrigger(Trigger(1));
    setPStat(PStat(250), 0);
    look(entity: Entity.Player, at: Entity(5));
    look(entity: Entity(5), at: Entity.Player);
    look(entity: Entity.Partner, at: Entity(5));
    speak(Entity(5), "Huh? Where am I?\n");
    speak(Entity.Player, "You regained your senses!\n");
    speak(Entity(5), "I guess so...\n");
    showTextbox("If you beat them\nmaybe I'll see you again.\nUntil then, I'm gone.\n");
    break;
  }
  loop {
    move(entity: Entity(5), to: (-400, -500), sprint: 0);
    if (pstat[101] >= 3) break;
    addPStat(PStat.LoopIterator, 1);
    delay(20);
    lookPairAt(Entity(5));
  }
  waitForEntity(Entity(5));
  unloadEntity(Entity(5));
  setPStat(PStat.LoopIterator, 0);
  followEntity(Entity.Player, speed: 10);
  setTrigger(Trigger(326));
  return;
  garbage { 14 00 fe 00 14 00 33 00 16 00 34 00 24 00 35 00 32 00 ff ff fe 00 4e fd 8e fe 08 ee 00 00 4b fe 01 ff fe 00 4e fd 70 fe c0 12 00 00 4b e1 00 ff fe 00 19 00 00 00 46 01 18 00 40 00 19 00 fe 00 4c 00 fd 05 4f 0f 70 fe 60 09 4a c8 4c 00 05 fd 67 00 05 00 1b 05 1a 00 82 76 82 85 81 75 82 92 82 85 81 40 82 88 82 85 82 92 82 85 81 40 82 81 82 94 81 40 82 8c 82 81 82 93 82 94 81 42 0d 00 00 00 56 00 fd 14 67 00 0f 00 1b fd 1a 00 82 60 82 92 82 85 81 40 82 99 82 8f 82 95 81 40 82 94 82 88 82 85 81 40 82 82 82 8f 82 93 82 93 81 48 0d 00 00 00 56 00 fd 00 1b 05 1a 00 82 68 81 75 82 8d 81 40 82 93 82 8f 82 92 82 92 82 99 81 43 81 40 82 68 81 75 82 8d 81 40 82 8e 82 8f 82 94 81 42 0d 00 82 68 81 75 82 8d 81 40 82 6c 82 85 82 94 82 81 82 8c 82 66 82 92 82 85 82 99 82 8d 82 8f 82 8e 81 49 0d 00 00 00 1b fd 56 00 fd 13 67 00 0f 00 1a 00 82 68 81 75 82 8c 82 8c 81 40 82 84 82 85 82 81 82 8c 81 40 82 97 82 89 82 94 82 88 81 40 82 99 82 8f 82 95 81 40 82 8c 82 81 82 94 82 85 82 92 81 49 0d 00 82 6c 82 8f 82 96 82 85 81 49 0d 00 00 00 56 00 fd 00 1b 05 1a 00 82 68 81 40 82 97 82 89 82 8c 82 8c 81 40 82 8e 82 8f 82 94 81 40 82 8d 82 8f 82 96 82 85 81 40 82 86 82 8f 82 92 81 40 82 99 82 8f 82 95 81 42 0d 00 82 78 82 8f 82 95 81 40 82 97 82 8f 82 8e 81 75 82 94 81 40 82 87 82 85 82 94 81 40 82 90 82 81 82 93 82 94 81 40 82 8d 82 85 81 42 0d 00 00 00 1b fd 1a 00 82 68 81 40 82 97 82 81 82 8e 82 94 81 40 82 94 82 8f 81 40 82 93 82 81 82 96 82 85 81 40 82 85 82 8e 82 85 82 92 82 87 82 99 81 42 0d 00 82 65 82 89 82 87 82 88 82 94 82 89 82 8e 82 87 81 40 82 88 82 89 82 8d 81 40 82 97 82 8f 82 8e 81 75 82 94 81 40 82 88 82 85 82 8c 82 90 81 40 82 8d 82 85 81 42 0d 00 00 00 1b 05 1a 00 82 68 81 75 82 8d 81 40 82 83 82 8f 82 8d 82 89 82 8e 82 87 81 40 82 94 82 8f 81 40 82 87 82 85 82 94 81 40 82 99 82 8f 82 95 81 49 0d 00 00 00 1c 00 01 00 1e 00 fa 01 1e 00 fb 05 1e 00 fc ff 1e 00 fd ff 27 00 67 00 01 00 66 00 1d 00 01 00 1e 00 fa 00 4c 00 fd 05 4c 00 05 fd 4c 00 fc 05 1b 05 1a 00 82