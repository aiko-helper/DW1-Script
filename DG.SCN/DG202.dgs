      speak(Entity.System, "How about one thousand bit\n<LIGHTBLUE>Medicine<WHITE>,\nfor nine hundred bits?\n");
      setDialogOwner(Entity.System);
      choice { "Lower one thous to nine hund" -> L44, "Let me rethink this" -> L_2194 }
      continue;
    }
    if (pstat[110] <= 1) {
      setPStat(PStat(247), 9);
      setPStat(PStat(248), 0);
      callSubroutine(28);
      speak(Entity.System, "How's one thousand bit\n<LIGHTBLUE>Medicine<WHITE>,\nfor eight hundred bits?\n");
      setPStat(PStat(117), 8);
      setDialogOwner(Entity.System);
      choice { "Lower one thous to eight hund" -> L45, "Let me rethink this" -> L_2194 }
      continue;
    }
    if (pstat[110] > 2) goto L38;
    setPStat(PStat(247), 9);
    setPStat(PStat(248), 0);
    callSubroutine(28);
    speak(Entity.System, "How about one thousand bit\n<LIGHTBLUE>Medicine<WHITE>,\nfor seven hundred bits?\n");
    setPStat(PStat(117), 9);
    setDialogOwner(Entity.System);
    choice { "Lower one thous to seven hund" -> L46, "Let me rethink this" -> L_2194 }
    continue;

L38:
    roll(pstat: PStat.RollScratch, max: 99);
    if (pstat[110] <= 44) {
      goto L47;
    }
    goto L48;

L39:
    roll(pstat: PStat.RollScratch, max: 99);
    if (pstat[110] <= 49) {
      goto L47;
    }
    goto L48;

L40:
    roll(pstat: PStat.RollScratch, max: 99);
    if (pstat[110] <= 54) {
      goto L47;
    }
    goto L48;

L41:
    roll(pstat: PStat.RollScratch, max: 99);
    if (pstat[110] <= 59) {
      goto L47;
    }
    goto L48;

L42:
    roll(pstat: PStat.RollScratch, max: 99);
    if (pstat[110] <= 64) {
      goto L47;
    }
    goto L48;

L43:
    roll(pstat: PStat.RollScratch, max: 99);
    if (pstat[110] <= 69) {
      goto L47;
    }
    goto L48;

L44:
    roll(pstat: PStat.RollScratch, max: 99);
    if (pstat[110] <= 74) {
      goto L47;
    }
    goto L48;

L45:
    roll(pstat: PStat.RollScratch, max: 99);
    if (pstat[110] <= 79) {
      goto L47;
    }
    goto L48;

L46:
    roll(pstat: PStat.RollScratch, max: 99);
    if (pstat[110] <= 84) {
      goto L47;
    }
    goto L48;

L47:
    setDialogOwner(Entity(9));
    sfx(8, 6, wait: 10);
    setTextboxSize(12, 3);
    if (pstat[117] == 1) {
      setPStat(PStat(243), 3);
      setPStat(PStat(244), 32);
      callSubroutine(31);
      showTextbox("Total Profit: <DISCOUNT>\nProfit:\neight hundred\n");
    }
    if (pstat[117] == 2) {
      setPStat(PStat(243), 2);
      setPStat(PStat(244), 188);
      callSubroutine(31);
      showTextbox("Total Profit: <DISCOUNT>\nProfit:\nseven hundred\n");
    }
    if (pstat[117] == 3) {
      setPStat(PStat(243), 2);
      setPStat(PStat(244), 88);
      callSubroutine(31);
      showTextbox("Total Profit: <DISCOUNT>\nProfit:\nsix hundred\n");
    }
    if (pstat[117] == 4) {
      setPStat(PStat(243), 1);
      setPStat(PStat(244), 244);
      callSubroutine(31);
      showTextbox("Total Profit: <DISCOUNT>\nProfit:\nfive hundred\n");
    }
    if (pstat[117] == 5) {
      setPStat(PStat(243), 1);
      setPStat(PStat(244), 144);
      callSubroutine(31);
      showTextbox("Total Profit: <DISCOUNT>\nProfit:\nfour hundred\n");
    }
    if (pstat[117] == 6) {
      setPStat(PStat(243), 1);
      setPStat(PStat(244), 44);
      callSubroutine(31);
      showTextbox("Total Profit: <DISCOUNT>\nProfit:\nthree hundred\n");
    }
    if (pstat[117] == 7) {
      setPStat(PStat(243), 0);
      setPStat(PStat(244), 200);
      callSubroutine(31);
      showTextbox("Total Profit: <DISCOUNT>\nProfit:\ntwo hundred\n");
    }
    if (pstat[117] == 8) {
      setPStat(PStat(243), 0);
      setPStat(PStat(244), 100);
      callSubroutine(31);
      showTextbox("Total Profit: <DISCOUNT>\nProfit:\none hundred\n");
    }
    if (pstat[117] == 9) {
      showTextbox("Total Profit: <DISCOUNT>\nProfit:\nzero\n");
    }
    goto L14;

L48:
    setPStat(PStat(247), 9);
    setPStat(PStat(248), 5);
    callSubroutine(28);
    addPStat(PStat(119), 1);
    roll(pstat: PStat.RollScratch, max: 99);
    if (pstat[110] <= 99 && pstat[119] >= 3) {
      goto L16;
    }
    if (pstat[110] <= 49 && pstat[119] == 2) {
      goto L16;
    }
    if (pstat[110] <= 49 && pstat[119] == 1) {
      goto L16;
    }
    goto L49;

L49:
    speak(Entity(9), "That's a bit high.\n");
    speak(Entity.Player, "Do you think so? Well then...\n");
  }
