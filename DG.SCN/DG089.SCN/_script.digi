; DG089.SCN
;!script index=89 start=0x3f000 end=0x3f800 headerU16=0x28 sentinelOff=0x24
;!sections onEnter section_5 section_6 section_7 section_8 section_9 section_10 section_81 section_53

onEnter:     ; len=72
  0000:  storeRandom 110 99
  0004:  if pstat[110] > 11 then onEnter+0x16
  0010:  spawnItem Digimushroom 72 53
  0016:  storeRandom 110 99
  001a:  if pstat[110] > 17 then onEnter+0x2c
  0026:  spawnItem Digimushroom 48 45
  002c:  storeRandom 110 99
  0030:  if pstat[110] > 3 then onEnter+0x42
  003c:  spawnItem IceMushroom 35 91
  0042:  setTrigger 351
  0046:  endSection
