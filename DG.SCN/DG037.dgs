// DG037.SCN
#include "functions.dgs"
#pragma script index=37 start=0x1d800 end=0x1e000 headerU16=0x10 sentinelOff=0x1875
#include "entities.dgs"

section onEnter(254) {
  spawnChest(Item.DefenseChip, 1460, -443, 3072, 666);
  return;
}

section(6) {
  speak(Entity(6), "「ジャマ?」<NEWLINE>");
  finishEncounter(Trigger(280));
}

section(51) {
  if (trigger(175) && trigger(180) && !trigger(182)) {
  } else {
    if (trigger(181) && trigger(182) && !trigger(235)) {
      return;
    }
    return;
  }
  playSound(8, 12);
  speak(Entity.System, "<YELLOW>???<WHITE><NEWLINE>「たすけてくれーー!」<NEWLINE>");
  rotate(entity: Entity.Player, to: 1321);
  rotate(entity: Entity.Partner, to: 1321);
  delay(10);
  anim(Entity.Player, Animation(23), wait: 15);
  speak(Entity.Player, "「ん、上のほうから声が…。<NEWLINE> 誰かいるのかー?」<NEWLINE>");
  anim(Entity.Player, Animation(0), wait: 10);
  speak(Entity.System, "<YELLOW>???<WHITE><NEWLINE>「やっ、そこにだれかいるのですかー!?」<NEWLINE>");
  delay(10);
  speak(Entity.Player, "「いるよー。」<NEWLINE>");
  delay(10);
  speak(Entity.System, "<YELLOW>???<WHITE><NEWLINE>「助けてくれーー。<NEWLINE> 急に地面がせり上がったですー。」<NEWLINE>");
  delay(10);
  speak(Entity.Player, "「そんなバカなー。」<NEWLINE>");
  delay(10);
  playSound(8, 11);
  speak(Entity.System, "<YELLOW>???<WHITE><NEWLINE>「本当ですー。<NEWLINE> 何か、機械が動くような音がしたですー。」<NEWLINE>");
  delay(10);
  anim(Entity.Player, Animation(16), wait: 15);
  speak(Entity.Player, "「機械…オーガモンのアジトかなぁー。」<NEWLINE>");
  anim(Entity.Player, Animation(0), wait: 10);
  speak(Entity.System, "<YELLOW>???<WHITE><NEWLINE>「そこで何か、いつもとちがうことをした<NEWLINE> のではないですかー?」<NEWLINE>");
  delay(10);
  speak(Entity.Player, "「それは色々あるなぁ。エレベーターとか…。<NEWLINE> じゃあアジトにもどってさぐってみるー。」<NEWLINE>");
  delay(10);
  playSound(8, 11);
  speak(Entity.System, "<YELLOW>???<WHITE><NEWLINE>「たのむですー。」<NEWLINE>");
  delay(10);
  setTrigger(Trigger(182));
  return;
