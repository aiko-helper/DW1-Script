// source: extract/DIGIMON/SCN/DG.SCN
// MAP164.SCN, section 9

section section_9(9) {  // len=1314
    setDialogOwner(9);
    showTextbox("OK, I'll explain to you the\nsurroundings of this city.\n");
    showTextbox("Native Forest\nsurrounds the city.\n");
    showTextbox("The Digimon around there\nare not very strong.\n");
    showTextbox("There's a Training Camp on\nthe west side. I think you\nwill go there often.\n");
    showTextbox("Tropical Jungle is on the\neast side, across the river.\n");
    showTextbox("I don't know what's past that.\n");
    showTextbox("There's a mountain and lake\non the west side\nand it's a dead end.\n");
    showTextbox("If you keep going south,\nthere's an ocean.\n");
    showTextbox("And there's a high mountain\nin the north. It's also\na dead end.\n");
    showTextbox("Since this city is the center\nof the island, there must be \nvast areas in the north.\n");
    showTextbox("I'll check out the rumors\nabout the outside area.\nCome back and find out more.\n");
    return;
}
