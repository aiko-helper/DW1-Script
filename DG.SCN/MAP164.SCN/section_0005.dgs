    setStats(Stat.TournamentsLost, 99);
    setDialogOwner(5);
    showTextbox("<WHITE>White White White\n<BLUE>Blue Blue Blue\n<RED>Red Red Red\n<PINK>Pink <GREEN>Green\n<LIGHTBLUE>LightBlue LightBlue\n<YELLOW>Yellow <ORANGE>Orange\n<ORANGE>a <LIGHTBLUE>b <PINK>c <GREEN>d\n");
