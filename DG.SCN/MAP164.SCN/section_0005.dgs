    showTextbox("I'm Mr. Warp.\nWhere do you want to go?\n");
    setDialogOwner(Entity.Player);
    setSelection(L_01f4, L_0272, L_02e0);
    showTextbox("Near\nFar away\nVery far away\n");
    waitForSelectionChoice();
    return;
