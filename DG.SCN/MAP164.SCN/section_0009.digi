; source: extract/DIGIMON/SCN/DG.SCN
; MAP164.SCN, section 9

section_9(9):     ; len=1314
  0000:  setDialogOwner 9
  0002:  showTextbox "OK, I'll explain to you the\nsurroundings of this city.\n"
  0074:  showTextbox "Native Forest\nsurrounds the city.\n"
  00bc:  showTextbox "The Digimon around there\nare not very strong.\n"
  011c:  showTextbox "There's a Training Camp on\nthe west side. I think you\nwill go there often.\n"
  01b6:  showTextbox "Tropical Jungle is on the\neast side, across the river.\n"
  0228:  showTextbox "I don't know what's past that.\n"
  026a:  showTextbox "There's a mountain and lake\non the west side\nand it's a dead end.\n"
  02f2:  showTextbox "If you keep going south,\nthere's an ocean.\n"
  034c:  showTextbox "And there's a high mountain\nin the north. It's also\na dead end.\n"
  03d0:  showTextbox "Since this city is the center\nof the island, there must be \nvast areas in the north.\n"
  047e:  showTextbox "I'll check out the rumors\nabout the outside area.\nCome back and find out more.\n"
  0520:  endSection
