// source: extract/DIGIMON/SCN/DG.SCN
// MAP164.SCN, section 6

section section_6(6) {  // len=226
    setStats(Stat.Lives, 3);
    setDialogOwner(5);
    showTextbox("Life three\n");
    setDialogOwner(6);
    showTextbox("I'm Mr. Digivolution.\nWhat do you want to be?\n");
    setDialogOwner(Entity.Player);
    setSelection(L_00c4, L_00ce, L_00d8);
    showTextbox("Numemon\nSukamon\nBotamon\n");
    waitForSelectionChoice();
    return;
L_00c4:
    setPStat(254, 11);
    callDigimonSubroutine(10);
    waitForEntity(Entity.System);
    return;
L_00ce:
    setPStat(254, 39);
    callDigimonSubroutine(10);
    waitForEntity(Entity.System);
    return;
L_00d8:
    setPStat(254, 1);
    callDigimonSubroutine(10);
    waitForEntity(Entity.System);
    return;
}
