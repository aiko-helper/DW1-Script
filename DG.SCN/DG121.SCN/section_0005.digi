section_5:     ; len=2022
  0000:  setDialogOwner 5
  0002:  showTextbox "Hello there. Do you know\nabout Digimon cards?\n"
  0062:  showTextbox "I collect Meramon Cards.\nBring me one and I'll buy\nit for fifteen hund bits.\n"
  0100:  if card[30] < 1 then section_5+0x142
  010e:  setDialogOwner 253
  0110:  setSelection section_5+0x144 section_5+0x172
  0116:  showTextbox "Here you go\nSorry\n"
  013e:  waitForSelectionChoice
  0140:  endSection
  0142:  endSection
  0144:  setDialogOwner 5
  0146:  showTextbox "Great! Thanks.\n"
  0168:  takeCard 30
  016a:  addMoney 1500
  0170:  endSection
  0172:  endSection
