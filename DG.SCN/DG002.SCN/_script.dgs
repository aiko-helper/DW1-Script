// DG002.SCN
#pragma script index=2 start=0x7800 end=0x8000 headerU16=0x20 sentinelOff=0x24
#pragma sections section_0254 section_0005 section_0007 section_0008 section_0009 section_0006 section_0051

section onEnter(254) {  // len=62
    roll(pstat: 110, max: 99);
    if (pstat[110] > 24) goto L_0016;
    spawnItem(Item.Digimushroom, 46, 45);
L_0016:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 4) goto L_002c;
    spawnItem(Item.Happymushroom, 60, 59);
L_002c:
    if (trigger(232)) goto L_003c;
    playAnimation(6, 28);
L_003c:
    return;
}
