; DG002.SCN
;!script index=2 start=0x7800 end=0x8000 headerU16=0x20 sentinelOff=0x24
;!sections onEnter section_5 section_7 section_8 section_9 section_6 section_51

onEnter:     ; len=62
  0000:  storeRandom 110 99
  0004:  if pstat[110] > 24 then onEnter+0x16
  0010:  spawnItem 44 46 45
  0016:  storeRandom 110 99
  001a:  if pstat[110] > 4 then onEnter+0x2c
  0026:  spawnItem 69 60 59
  002c:  if trigger(232) then onEnter+0x3c
  0038:  playAnimation 6 28
  003c:  endSection
