; DG072.SCN
;!script index=72 start=0x33800 end=0x34000 headerU16=0x18 sentinelOff=0x24
;!sections onEnter section_7 section_8 section_9 section_10

onEnter:     ; len=46
  0000:  storeRandom 110 99
  0004:  if pstat[110] > 16 then onEnter+0x16
  0010:  spawnItem Digimushroom 49 70
  0016:  storeRandom 110 99
  001a:  if pstat[110] > 2 then onEnter+0x2c
  0026:  spawnItem Happymushroom 25 68
  002c:  endSection
