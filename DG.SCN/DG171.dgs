// DG171.SCN
#pragma script index=171 start=0x80000 end=0x81000 headerU16=0x14 sentinelOff=0xfe

section onEnter(254) {  // len=2
    return;
}

section section_81(81) {  // len=288
    look(entity: Entity.Player, at: 5);
    look(entity: 5, at: Entity.Player);
    delay(5);
    if (trigger(51)) goto L_0118;
    setTrigger(51);
    setDialogOwner(5);
    showTextbox("Welcome! My new business\nis 'Item Keeper'.\nI keep Items for people.\n");
    showTextbox("I'll keep your Items for\nfree as a special service.\n");
    return;
L_0118:
    setPStat(254, 5);
    callSubroutine(11);
    return;
}

section section_6(6) {  // len=2898
    if (pstat[1] < 30) goto L_0320;
    setDialogOwner(6);
    showTextbox("About Digivolution...\nRegarding the next generation\nafter Champion Digimon...\n");
    showTextbox("It's the Ultimate Digimon.\nHe doesn't always digivolve\nafter Champion Digimon.\n");
    showTextbox("In order to digivolve,\ncertain conditions have\nto be met exactly.\n");
    showTextbox("But once it digivolves to\nUltimate Digimon, the life\nexpectancy will grow.\n");
    showTextbox("But if you digiolve by eating\nan Digivolution Item, life\nexpectancy stays the same.\n");
    return;
L_0320:
    if (pstat[1] < 15) goto L_07c4;
    setDialogOwner(6);
    showTextbox("More about digivolution.\nAbout the conditions.\n");
    showTextbox("First of all, I hear that\nthe weight has to be close\nto the target weight.\n");
    showTextbox("And the higher the parameters\nthe better.\n");
    showTextbox("But depending on which\nparameter is higher\nthe result is different.\n");
    showTextbox("About care mistakes,\nin some cases, it works\nbetter to fail on purpose.\n");
    showTextbox("Depending on the digivolution\ntarget, some conditions\nhave to be met.\n");
    showTextbox("There are some situations\nthat can cause digivolution.\n");
    showTextbox("Like the number of battles or\nhow well he's disciplined.\n");
    showTextbox("If those conditions are met,\neven if some others are\nnot, he still can digivolve.\n");
    return;
L_07c4:
    setDialogOwner(6);
    showTextbox("I heard from Jiji that\n<ORANGE><DIGIMON><WHITE> will digivolve.\n");
    showTextbox("From Fresh Digimon to\nIn-Training Digimon,\nit only takes six hours.\n");
    showTextbox("From there to Rookie\nDigimon, it takes about\na day to digivolve.\n");
    showTextbox("Then to the next Champion\nDigimon, it takes about\nthree days to digivolve.\n");
    showTextbox("And what was the next\ngeneration? I forgot,\nbut there's more.\n");
    showTextbox("Digivolution is related to\nweight, parameters,\nand care mistakes.\n");
    showTextbox("I don't understand\nvery well. I'll ask Jiji\nmy next chance.\n");
    return;
}

