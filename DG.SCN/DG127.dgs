// DG127.SCN
#include "functions.dgs"
#pragma script index=127 start=0x53000 end=0x53800 headerU16=0x1c sentinelOff=0x24
#include "entities.dgs"

section onEnter(254) {
  spawnItemChance(max: 99, chance: 11, item: Item.Digimushroom, x: 59, y: 50);
  spawnItemChance(max: 99, chance: 17, item: Item.Digimushroom, x: 33, y: 42);
  spawnItemChance(max: 99, chance: 2, item: Item.Happymushroom, x: 37, y: 61);
  if (trigger(319)) {
    setObjectsVisibleRange(24, 27, 1);
  } else {
    setRectImpassible(32, 39, 9, 8);
    setRectImpassible(35, 34, 8, 8);
  }
  return;
}

section(5) {
  speak(Entity(5), "「シャカシャカ!」<NEWLINE>");
  finishEncounter(Trigger(267));
}

section(6) {
  speak(Entity(6), "「シュルーーーー…」<NEWLINE>");
  finishEncounter(Trigger(267));
}

section(7) {
  speak(Entity(7), "「ケロッ?」<NEWLINE>");
  startBattle();
  return;
}

section(8) {
  speak(Entity(8), "「やらねばやられるでケロ!」<NEWLINE>");
  startBattle();
  return;
}

section(9) {
  speak(Entity(9), "「やーいやーい!」<NEWLINE>");
  speak(Entity(9), "「よわむしー!」<NEWLINE>");
  speak(Entity(9), "「いくじなしー!」<NEWLINE>");
  speak(Entity(9), "「へっぽこー!」<NEWLINE>");
  speak(Entity(9), "「のろまー!」<NEWLINE>");
  speak(Entity(9), "「まぬけー!」<NEWLINE>");
  speak(Entity.Player, "「な、なんだとー!」<NEWLINE>");
  setSelection(L1, L2);
  showTextbox("「ここまで言われてがまんできるか!」<NEWLINE>「相手はこどもだし、相手にしないよ。」<NEWLINE>");

L1:
  {
    setTrigger(Trigger(1));
    setPStat(PStat(250), 1);
    setPStat(PStat(251), 9);
    setPStat(PStat(252), 255);
    setPStat(PStat(253), 255);
    startBattle();
    unsetTrigger(Trigger(1));
    setPStat(PStat(250), 0);
    look(entity: Entity.Player, at: Entity(9));
    look(entity: Entity(9), at: Entity.Player);
    look(entity: Entity.Partner, at: Entity(9));
    speak(Entity(9), "「うわーん、いじめられたよー!」<NEWLINE>");
    anim(Entity.Player, Animation(15), wait: 20);
    setTrigger(Trigger(309));
    break;
  }
  approach(who: Entity(9), x: -174, y: -388, tries: 3, wait: 20);
  followEntity(Entity.Player, speed: 10);
  speak(Entity.Player, "「ん、何だ?」<NEWLINE>");
  loadAndSetDigimon(Digimon.Gekomon, Entity(3), 0);
  for id in Entity(5)..Entity(7) {
    setDigimon(Digimon.Gekomon, id, 0);
  }
  delay(40);
  anim(Entity.Player, Animation(24), wait: 20);
  speak(Entity.Player, "'!!\"\n");
  move(entity: Entity(8), to: Entity.Player, sprint: 1);
  move(entity: Entity(10), to: Entity.Player, sprint: 1);
  move(entity: Entity(11), to: Entity.Player, sprint: 1);
  move(entity: Entity(12), to: Entity.Player, sprint: 1);
  delay(40);
  speak(Entity(8), "「わが殿が呼んでいるケロ。<NEWLINE> 来てもらうケロ。」<NEWLINE>");
  anim(Entity.Player, Animation(25), wait: 20);
  speak(Entity.Player, "「し、しまったぁ…」<NEWLINE>");
  warp(to: Map.GKYO02, spawn: 0, trigger: 5);

L2:
  anim(Entity.Player, Animation(25), wait: 20);
  speak(Entity.Player, "「ふふふ、強がっちゃって。<NEWLINE> こどもは相手にしないのさ!」<NEWLINE>");
  return;
  startBattle();
  return;
  garbage { 1c 00 fe 00 1c 00 05 00 90 00 06 00 b8 00 07 00 e2 00 08 00 00 01 09 00 2e 01 ff ff 24 00 6e 63 19 00 0b 00 6e 0b 18 00 32 00 19 00 74 2c 3b 00 32 00 24 00 6e 63 19 00 0b 00 6e 11 18 00 48 00 19 00 74 2c 21 00 2a 00 24 00 6e 63 19 00 0b 00 6e 02 18 00 5e 00 19 00 74 45 25 00 3d 00 19 00 00 00 3f 01 18 00 7e 00 19 00 57 00 18 01 57 00 19 01 57 00 1a 01 57 00 1b 01 16 00 8e 00 7c 00 20 00 27 00 09 08 7c 00 23 00 22 00 08 08 fe 00 1b 05 1a 00 81 75 83 56 83 83 83 4a 83 56 83 83 83 4a 81 49 81 76 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 0b 01 fe 00 1b 06 1a 00 81 75 83 56 83 85 83 8b 81 5b 81 5b 81 5b 81 5b 81 63 81 76 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 0b 01 fe 00 1b 07 1a 00 81 75 83 50 83 8d 83 62 81 48 81 76 0d 00 00 00 27 00 67 00 01 00 66 00 fe 00 1b 08 1a 00 81 75 82 e2 82 e7 82 cb 82 ce 82 e2 82 e7 82 ea 82 e9 82 c5 83 50 83 8d 81 49 81 76 0d 00 00 00 27 00 67 00 01 00 66 00 fe 00 1b 09 1a 00 81 75 82 e2 81 5b 82 a2 82 e2 81 5b 82 a2 81 49 81 76 0d 00 00 00 1b 09 1a 00 81 75 82 e6 82 ed 82 de 82 b5 81 5b 81 49 81 76 0d 00 00 00 1b 09 1a 00 81 75 82 a2 82 ad 82 b6 82 c8 82 b5 81 5b 81 49 81 76 0d 00 00 00 1b 09 1a 00 81 75 82 d6 82 c1 82 db 82 b1 81 5b 81 49 81 76 0d 00 00 00 1b 09 1a 00 81 75 82 cc 82 eb 82 dc 81 5b 81 49 81 76 0d 00 00 00 1b 09 1a 00 81 75 82 dc 82 ca 82 af 81 5b 81 49 81 76 0d 00 00 00 1b fd 1a 00 81 75 82 c8 81 41 82 c8 82 f1 82 be 82 c6 81 5b 81 49 81 76 0d 00 00 00 10 02 32 02 88 03 1a 00 81 75 82 b1 82 b1 82 dc 82 c5 8c be 82 ed 82 ea 82 c4 82 aa 82 dc 82 f1 82 c5 82 ab 82 e9 82 a9 81 49 81 76 0d 00 81 75 91 8a 8e e8 82 cd 82 b1 82 c7 82 e0 82 be 82 b5 81 41 91 8a 8e e8 82 c9 82 b5 82 c8 82 a2 82 e6 81 42 81 76 0d 00 00 00 1c 00 01 00 1e 00 fa 01 1e 00 fb 09 1e 00 fc ff 1e 00 fd ff 27 00 67 00 01 00 66 00 1d 00 01 00 1e 00 fa 00 4c 00 fd 09 4c 00 09 fd 4c 00 fc 09 1b 09 1a 00 81 75 82 a4 82 ed 81 5b 82 f1 81 41 82 a2 82 b6 82 df 82 e7 82 ea 82 bd 82 e6 81 5b 81 49 81 76 0d 00 00 00 56 00 fd 0f 67 00 14 00 1c 00 35 01 16