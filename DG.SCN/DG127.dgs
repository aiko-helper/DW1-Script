// DG127.SCN
#pragma script index=127 start=0x59800 end=0x5a000 headerU16=0x1c sentinelOff=0x24

function speakThenStartBattleThenSetTrigger(a, b, c) {
    speak(a, b);
    startBattle();
    setTrigger(c);
}


section onEnter(254) {  // len=46
    roll(pstat: 110, max: 99);
    if (pstat[110] > 18) goto L1;
    spawnItem(Item.Digimushroom, x: 68, y: 27);

L1:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 3) goto L2;
    spawnItem(Item.IceMushroom, x: 54, y: 40);

L2:
    return;
}

section(5) {  // len=60
    speakThenStartBattleThenSetTrigger(5, "Can I give a nudge?\n", 272);
    return;
}

section(6) {  // len=68
    speakThenStartBattleThenSetTrigger(6, "Don't get carried away!\n", 272);
    return;
}

section(7) {  // len=68
    speakThenStartBattleThenSetTrigger(7, "Don't get carried away!\n", 300);
    return;
}

section(8) {  // len=60
    speakThenStartBattleThenSetTrigger(8, "It's not that easy.\n", 300);
    return;
}

