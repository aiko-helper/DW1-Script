// DG122.SCN
#include "functions.dgs"
#pragma script index=122 start=0x57000 end=0x57800 headerU16=0x10 sentinelOff=0x1875
#include "entities.dgs"

section onEnter(254) {
  spawnChest(Item.DefenseChip, 1460, -443, 3072, 666);
  return;
}

section(6) {
  speak(6, "Am I in the way?\n");
  startBattle();
  setTrigger(280);
  return;
}

section(5) {
  speak(5, "You saved me!\n");
  speak(Entity.Player, "So it was you.\n");
  speak(5, "This is perfect.\n");
  playAnimation(Entity.Player, 19);
  delay(15);
  speak(Entity.Player, "What?\n");
  playAnimation(Entity.Player, 0);
  speak(5, "I was headed toward\nyour city to put my talent\nto good use!\n");
  speak(Entity.Player, "What kind of talent?\n");
  speak(5, "Oh, you don't know about me?\nI'm famous with Digimon\nas a know-it-all!\n");
  speak(Entity.Player, "Really?\nI've never heard of you.\n");
  speak(5, "I'm ready to go to the city.\n");
  playAnimation(Entity.Player, 16);
  delay(15);
  speak(Entity.Player, "Is she really\ngoing to be useful?\n");
  playAnimation(Entity.Player, 0);
  speak(5, "See ya!\n");
  goto L1;

L1:
  loop {
    move(entity: 5, to: (-111, -2962), sprint: 1);
    if (pstat[101] >= 3) break;
    addPStat(PStat.LoopIterator, 1);
    delay(20);
    look(entity: Entity.Player, at: 5);
    look(entity: Entity.Partner, at: 5);
  }
  waitForEntity(5);
  unloadEntity(5);
  setPStat(PStat.LoopIterator, 0);
  playSound(8, 10);
  speak(Entity.System, "Shellmon joins the city!\n");
  setTrigger(235);
  addPStat(1, 2);
  return;
  garbage { 10 00 fe 00 10 00 06 00 1e 00 05 00 54 00 ff ff 75 18 b4 05 00 00 45 fe 00 0c 9a 02 fe 00 1b 06 1a 00 82 60 82 8d 81 40 82 68 81 40 82 89 82 8e 81 40 82 94 82 88 82 85 81 40 82 97 82 81 82 99 81 48 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 18 01 fe 00 1b 05 1a 00 82 78 82 8f 82 95 81 40 82 93 82 81 82 96 82 85 82 84 81 40 82 8d 82 85 81 49 0d 00 00 00 1b fd 1a 00 82 72 82 8f 81 40 82 89 82 94 81 40 82 97 82 81 82 93 81 40 82 99 82 8f 82 95 81 42 0d 00 00 00 1b 05 1a 00 82 73 82 88 82 89 82 93 81 40 82 89 82 93 81 40 82 90 82 85 82 92 82 86 82 85 82 83 82 94 81 42 0d 00 00 00 56 00 fd 13 67 00 0f 00 1b fd 1a 00 82 76 82 88 82 81 82 94 81 48 0d 00 00 00 56 00 fd 00 1b 05 1a 00 82 68 81 40 82 97 82 81 82 93 81 40 82 88 82 85 82 81 82 84 82 85 82 84 81 40 82 94 82 8f 82 97 82 81 82 92 82 84 0d 00 82 99 82 8f 82 95 82 92 81 40 82 83 82 89 82 94 82 99 81 40 82 94 82 8f 81 40 82 90 82 95 82 94 81 40 82 8d 82 99 81 40 82 94 82 81 82 8c 82 85 82 8e 82 94 0d 00 82 94 82 8f 81 40 82 87 82 8f 82 8f 82 84 81 40 82 95 82 93 82 85 81 49 0d 00 00 00 1b fd 1a 00 82 76 82 88 82 81 82 94 81 40 82 8b 82 89 82 8e 82 84 81 40 82 8f 82 86 81 40 82 94 82 81 82 8c 82 85 82 8e 82 94 81 48 0d 00 00 00 1b 05 1a 00 82 6e 82 88 81 43 81 40 82 99 82 8f 82 95 81 40 82 84 82 8f 82 8e 81 75 82 94 81 40 82 8b 82 8e 82 8f 82 97 81 40 82 81 82 82 82 8f 82 95 82 94 81 40 82 8d 82 85 81 48 0d 00 82 68 81 75 82 8d 81 40 82 86 82 81 82 8d 82 8f 82 95 82 93 81 40 82 97 82 89 82 94 82 88 81 40 82 63 82 89 82 87 82 89 82 8d 82 8f 82 8e 0d 00 82 81 82 93 81 40 82 81 81 40 82 8b 82 8e 82 8f 82 97 81 7c 82 89 82 94 81 7c 82 81 82 8c 82 8c 81 49 0d 00 00 00 1b fd 1a 00 82 71 82 85 82 81 82 8c 82 8c 82 99 81 48 0d 00 82 68 81 75 82 96 82 85 81 40 82 8e 82 85 82 96 82 85 82 92 81 40 82 88 82 85 82 81 82 92 82 84 81 40 82 8f 82 86 81 40 82 99 82 8f 82 95 81 42 0d 00 00 00 1b 05 1a 00 82 68 81 75 82 8d 81 40 82 92 82 85 82 81 82 84 82 99 81 40 82 94 82 8f 81 40 82 87 82 8f 81 40 82 94 82 8f 81 40 82 94 82