// DG122.SCN
#include "functions.dgs"
#pragma script index=122 start=0x50000 end=0x50800 headerU16=0x18 sentinelOff=0x24
#include "entities.dgs"

section onEnter(254) {
  spawnItemChance(max: 99, chance: 10, item: Item.Digimushroom, x: 40, y: 54);
  setPStat(PStat(113), 0);
  if (trigger(5) || trigger(6) || trigger(7)) {
    playAnimation(Entity(5), Animation(29));
  }
  if (trigger(5) && trigger(6)) {
    playAnimation(Entity(5), Animation(30));
  }
  if (trigger(5) && trigger(7)) {
    playAnimation(Entity(5), Animation(30));
  }
  if (trigger(6) && trigger(7)) {
    playAnimation(Entity(5), Animation(30));
  }
  if (trigger(5) ?? !trigger(6) && trigger(7)) {
    playAnimation(Entity(5), Animation(31));
  }
  return;
}

section(6) {
  setPStat(PStat(113), 1);
  jumpToScriptSection(176, 6);
  return;
}

section(10) {
  jumpToScriptSection(176, 10);
  return;
}

section(7) {
  {
    if (trigger(5) && trigger(6)) {
      speak(Entity(7), "「よう、<LIGHTBLUE><PLAYER><WHITE>どんでねえか!」<NEWLINE>");
      break;
    }
    if (trigger(5) && trigger(7)) {
      speak(Entity(7), "「よう、<LIGHTBLUE><PLAYER><WHITE>どんでねえか!」<NEWLINE>");
      break;
    }
    if (trigger(6) && trigger(7)) {
      speak(Entity(7), "「よう、<LIGHTBLUE><PLAYER><WHITE>どんでねえか!」<NEWLINE>");
      break;
    }
    if (trigger(5) || trigger(6) || trigger(7)) {
      speak(Entity(7), "「よう、また来てくれただな!」<NEWLINE>");
      break;
    }
    speak(Entity(7), "「よう、オラぁ、モジャモンだ!」<NEWLINE>");
  }
  setPStat(PStat(254), 7);
  setPStat(PStat(249), 0);
  callSubroutine(2);
  if (trigger(5) || trigger(6) || trigger(7)) {
    playAnimation(Entity(5), Animation(29));
  }
  if (trigger(5) && trigger(6)) {
    playAnimation(Entity(5), Animation(30));
  }
  if (trigger(5) && trigger(7)) {
    playAnimation(Entity(5), Animation(30));
  }
  if (trigger(6) && trigger(7)) {
    playAnimation(Entity(5), Animation(30));
  }
  if (trigger(5) ?? !trigger(6) && trigger(7)) {
    playAnimation(Entity(5), Animation(31));
  }
  if (!trigger(5) || !trigger(6) || !trigger(7)) {
    return;
  }
  if (!trigger(8) || !trigger(9) || !trigger(10)) {
    return;
  }
  if (!trigger(11) || !trigger(12) || !trigger(13)) {
    return;
  }
  if (trigger(252)) {
    return;
  }
  {
    speak(Entity(7), "「<LIGHTBLUE><PLAYER><WHITE>どん、オラぁ、本当に<NEWLINE> カンゲキしただ!<NEWLINE> オラたちのために色々してくれて…」<NEWLINE>");
    showTextbox("「オラぁ決めただ。街へ行くだよ。<NEWLINE> よろしくたのむだよ!」<NEWLINE>");
    break;
  }
  approach(who: Entity(7), x: -1300, y: -1351, tries: 3, wait: 20);
  playSound(8, 11);
  speak(Entity.System, "モジャモンが街に参加した!!!<NEWLINE>");
  setTrigger(Trigger(252));
  setTrigger(Trigger(107));
  addPStat(PStat(1), 2);
  return;
}

section(51) {
  {
    if ((cond & 0x40) == 0x01 && !trigger(133)) break;
    return;
  }
  storeDigimonType(PStat(103));
  if (pstat[103] == 3 || pstat[103] == 5 || pstat[103] == 8 || pstat[103] == 9 || pstat[103] == 47) {
    jumpToScriptSection(174, 51);
  }
  if (pstat[103] == 19 || pstat[103] == 32 || pstat[103] == 51 || pstat[103] == 1 || pstat[103] == 2) {
    jumpToScriptSection(174, 51);
  }
  if (pstat[103] == 15 || pstat[103] == 16 || pstat[103] == 29 || pstat[103] == 30 || pstat[103] == 43) {
    jumpToScriptSection(174, 51);
  }
  if (pstat[103] == 44) {
    jumpToScriptSection(174, 51);
  }
  return;
  garbage { 18 00 fe 00 18 00 06 00 a0 00 0a 00 ac 00 07 00 b4 00 33 00 98 03 ff ff 24 00 6e 63 19 00 0b 00 6e 0a 18 00 2e 00 19 00 74 2c 28 00 36 00 1e 00 71 00 19 00 00 00 05 00 40 00 06 00 40 00 07 00 18 00 4a 00 19 00 56 00 05 1d 19 00 00 00 05 00 80 00 06 00 18 00 5e 00 19 00 56 00 05 1e 19 00 00 00 05 00 80 00 07 00 18 00 72 00 19 00 56 00 05 1e 19 00 00 00 06 00 80 00 07 00 18 00 86 00 19 00 56 00 05 1e 19 00 00 00 05 00 00 00 06 00 80 00 07 00 18 00 9e 00 19 00 56 00 05 1f fe 00 1e 00 71 01 17 00 b0 00 06 00 fe 00 17 00 b0 00 0a 00 fe 00 19 00 00 00 05 00 80 00 06 00 18 00 ee 00 19 00 1b 07 1a 00 81 75 82 e6 82 a4 81 41 01 06 05 00 01 01 82 c7 82 f1 82 c5 82 cb 82 a6 82 a9 81 49 81 76 0d 00 00 00 16 00 c8 01 19 00 00 00 05 00 80 00 07 00 18 00 28 01 19 00 1b 07 1a 00 81 75 82 e6 82 a4 81 41 01 06 05 00 01 01 82 c7 82 f1 82 c5 82 cb 82 a6 82 a9 81 49 81 76 0d 00 00 00 16 00 c8 01 19 00 00 00 06 00 80 00 07 00 18 00 62 01 19 00 1b 07 1a 00 81 75 82 e6 82 a4 81 41 01 06 05 00 01 01 82 c7 82 f1 82 c5 82 cb 82 a6 82 a9 81 49 81 76 0d 00 00 00 16 00 c8 01 19 00 00 00 05 00 40 00 06 00 40 00 07 00 18 00 a0 01 19 00 1b 07 1a 00 81 75 82 e6 82 a4 81 41 82 dc 82 bd 97 88 82 c4 82 ad 82 ea 82 bd 82 be 82 c8 81 49 81 76 0d 00 00 00 16 00 c8 01 1b 07 1a 00 81 75 82 e6 82 a4 81 41 83 49 83 89 82 9f 81 41 83 82 83 57 83 83 83 82 83 93 82 be 81 49 81 76 0d 00 00 00 1e 00 fe 07 1e 00 f9 00 64 02 19 00 00 00 05 00 40 00 06 00 40 00 07 00 18 00 ea 01 19 00 56 00 05 1d 19 00 00 00 05 00 80 00 06 00 18 00 fe 01 19 00 56 00 05 1e 19 00 00 00 05 00 80 00 07 00 18 00 12 02 19 00 56 00 05 1e 19 00 00 00 06 00 80 00 07 00 18 00 26 02 19 00 56 00 05 1e 19 00 00 00 05 00 00 00 06 00 80 00 07 00 18 00 3e 02 19 00 56 00 05 1f 19 00 01 00 05 00 41 00 06 00 41 00 07 00 18 00 54 02 19 00 fe 00 19 00 01 00 08 00 41 00 09 00 41 00 0a 00 18 00 6a 02 19 00 fe 00 19 00 01 00 0b 00 41 00 0c 00 41 00 0d 00 18 00 80 02 19 00 fe 00 19 00 00 00 fc 00 18 00 8e 02 19 00 fe 00 1b 07 1a 00 81 75 01 06 05