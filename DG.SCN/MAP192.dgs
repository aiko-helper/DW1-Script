// MAP192.SCN
#include "functions.dgs"
#pragma script index=192 start=0x92000 end=0x92800 headerU16=0xc sentinelOff=0xfe
#include "entities.dgs"

section onEnter(254) {
  return;
}

section(51) {
  callSubroutine(52);
  look(entity: 5, at: Entity.Player);
  look(entity: 6, at: Entity.Player);
  look(entity: 7, at: Entity.Player);
  move(entity: Entity.Partner, to: (-340, -2263), sprint: 0);
  moveCamera(to: (172, -1848), slowdown: 2);
  waitForEntity(200);
  delay(20);
  speak(5, "The time has come.\n");
  speak(Entity.Player, "I wish I could stay,\nbut my mom worries.\n");
  speak(5, "Thank you <LIGHTBLUE><PLAYER><WHITE>,\nI wish I could repay you.\n");
  speak(Entity.System, "<YELLOW>Tokomon <WHITE>\nDon't forget us!\n");
  speak(7, "We'll see each other again.\nI know it.\n");
  rotate(entity: Entity.Player, to: 0);
  delay(30);
  rotate(entity: Entity.Player, to: 1024);
  delay(30);
  rotate(entity: Entity.Player, to: 2048);
  delay(30);
  rotate(entity: Entity.Player, to: 3072);
  delay(30);
  speak(Entity.Player, "I had great time. Thanks.\n");
  speak(5, "We should have a\ngood bye ceremony.\n");
  fadeOutHUD();
  callSubroutine(54);
  look(entity: Entity.Player, at: Entity.Partner);
  look(entity: Entity.Partner, at: Entity.Player);
  delay(40);
  speak(Entity.Player, "<ORANGE><DIGIMON><WHITE>, our\nadventure was grand!\n");
  fadeOutHUD();
  delay(30);
  anim(5, 32, wait: 40);
  callSubroutine(53);
  return;
