// MAP192.SCN
#include "functions.dgs"
#pragma script index=192 start=0x90800 end=0x91800 headerU16=0x1c sentinelOff=0x19
#include "entities.dgs"

section onEnter(254) {
  if (!trigger(340)) {
    goto section_52;
  }
  if (trigger(341) && !trigger(211)) {
    goto section_6;
  }
  return;
}

section(51) {
  move(entity: Entity.Player, to: (1482, -663), sprint: 0);
  waitForEntity(Entity.Player);
  move(entity: Entity.Player, to: (551, 87), sprint: 0);
  warp(to: Map.FACT11A, spawn: 1, trigger: 255);
  return;
}

section(5) {
  if (!trigger(342)) {
    setTrigger(Trigger(342));
    speak(Entity(5), "「へこへこへこ。あー調子わるぅー。」<NEWLINE>");
    speak(Entity.Player, "「ん、大丈夫か?」<NEWLINE>");
    speak(Entity(5), "「へこへこ。とにかく調子わるいのじゃー。」<NEWLINE>");
    speak(Entity.Player, "「おまえ、こんなとこに住んでんの?」<NEWLINE>");
    speak(Entity(5), "「あ~気持ちわる。だるいわぁ~。」<NEWLINE>");
    speak(Entity.Player, "「うーん。とにかく調子悪そうだ。いつもこう<NEWLINE> ってわけじゃないだろうし。ちょっと…<NEWLINE> 青ざめているように…見えなくもない。」<NEWLINE>");
  }
  speak(Entity(5), "「へこへこ。<NEWLINE> どんどん調子わるくなってくわ。」<NEWLINE>");
  speak(Entity.Player, "「むー。何か原因をさぐらないとダメか…」<NEWLINE>");
  speak(Entity.Player, "「この排水はどこから来てるのかな。<NEWLINE> さぐってみよう!」<NEWLINE>");
  return;
}

section(52) {
  setTrigger(Trigger(340));
  delay(20);
  move(entity: Entity.Player, to: (1931, -482), sprint: 0, withCamera: true);
  move(entity: Entity.Partner, to: (1822, -891), sprint: 0);
  waitForPair();
  speak(Entity.Player, "「う、なんだこりゃ。」<NEWLINE>");
  anim(Entity.Partner, Animation(23), wait: 40);
  look(entity: Entity.Player, at: Entity.Partner);
  delay(5);
  speak(Entity.Player, "「!どうした、<ORANGE><DIGIMON><WHITE>!?」<NEWLINE>");
  anim(Entity.Player, Animation(16), wait: 20);
  speak(Entity.Player, "「この霧の…においか…?」<NEWLINE>");
  speak(Entity.Player, "「うむ…怪しいな。何かやばいものが<NEWLINE> まじってるとか…」<NEWLINE>");
  return;
}

section(6) {
  {
    delay(20);
    speak(Entity.Player, "「よし、普通の下水にもどってるな。」<NEWLINE>");
    showTextbox("「原因は解決したし。<NEWLINE> きっとあいつも元気になって…」<NEWLINE>");
    panTo(x: 2381, y: -698, slowdown: 20);
    playSound(8, 13);
    anim(Entity(6), Animation(15), wait: 20);
    speak(Entity.Player, "「だぁ!?何か変だ!」<NEWLINE>");
    look(entity: Entity(6), at: Entity.Player);
    delay(10);
    playSound(8, 11);
    playAnimation(Entity(6), Animation(28));
    sfx(8, 13, wait: 40);
    speak(Entity(6), "「ど・ど・ど・どどどどど!」<NEWLINE>");
    setTrigger(Trigger(1));
    setPStat(PStat(250), 1);
    setPStat(PStat(251), 6);
    setPStat(PStat(252), 255);
    setPStat(PStat(253), 255);
    startBattle();
    unsetTrigger(Trigger(1));
    setPStat(PStat(250), 0);
    move(entity: Entity.Player, to: (2387, -771), sprint: 0);
    move(entity: Entity.Partner, to: (1865, -772), sprint: 0);
    move(entity: Entity(6), to: (2795, -771), sprint: 0);
    for x in [Entity.Player, Entity.Partner, Entity(6)] {
      waitForEntity(x);
    }
    look(entity: Entity.Player, at: Entity(6));
    look(entity: Entity(6), at: Entity.Player);
    look(entity: Entity.Partner, at: Entity(6));
    delay(5);
    speak(Entity(6), "「ふぁ~~あ……へこへこ。おんや?<NEWLINE> どーしました皆の衆?」<NEWLINE>");
    speak(Entity.Player, "「おっ!何かアホっぽくなったぞ!<NEWLINE> 正気に帰ったのか?」<NEWLINE>");
    speak(Entity(6), "「あ?アホとはシツレイだに~。おりは<NEWLINE> ヌメモンっていうかヌメモン?」<NEWLINE>");
    speak(Entity.Player, "「(うっ…こいつはアホというより…)<NEWLINE> あーオホン。ヌメモン、おまえを助けて<NEWLINE> あげたのは誰だかわかるかな?」<NEWLINE>");
    speak(Entity(6), "「ひょ?助けてほしーの?別にえーど。」<NEWLINE>");
    speak(Entity.Player, "「げげっ、何かかんちがいしすぎ!<NEWLINE> まあ最終的には問題ないんだけどさ。」<NEWLINE>");
    speak(Entity(6), "「助っ人だね。いや、助っモンかな。<NEWLINE> へこへこへこへこ。へこへこ。へこ!」<NEWLINE>");
    setDialogOwner(Entity.Player);
    anim(Entity.Player, Animation(19), wait: 15);
    showTextbox("「…………。まあ、とにかく俺達の街に<NEWLINE> きてくれ。あれ、場所知ってる?」<NEWLINE>");
    playAnimation(Entity.Player, Animation(0));
    speak(Entity(6), "「知ってるっちゅうの!わりかし。」<NEWLINE>");
    break;
  }
  approach(who: Entity(6), x: -137, y: 34, tries: 6, wait: 10);
  playSound(8, 10);
  speak(Entity.System, "ヌメモンが街に参加した!!!<NEWLINE>");
  followEntity(Entity.Player, speed: 10);
  setTrigger(Trigger(211));
  addPStat(PStat(1), 1);
  return;
}

section(7) {
  delay(10);
  anim(Entity(7), Animation(28), wait: 10);
  speak(Entity.Player, "「ん?なにもんだ?!」<NEWLINE>");
  speak(Entity(7), "「ナニモンだァ!」<NEWLINE>");
  rotate(entity: Entity(7), to: 1276);
  delay(5);
  rotate(entity: Entity(7), to: 2300);
  delay(5);
  rotate(entity: Entity(7), to: 3324);
  delay(5);
  rotate(entity: Entity(7), to: 252);
  delay(5);
  rotate(entity: Entity(7), to: 1276);
  delay(5);
  rotate(entity: Entity(7), to: 2300);
  delay(5);
  rotate(entity: Entity(7), to: 3324);
  delay(5);
  rotate(entity: Entity(7), to: 252);
  delay(5);
  move(entity: Entity(7), to: (2392, -114), sprint: 1);
  waitForEntity(Entity(7));
  unloadEntity(Entity(7));
  switch pstat[21] {
    0 => {
      setObjectVisibility(23, 0);
      move(entity: Entity.Player, to: (2068, 760), sprint: 1);
      waitForEntity(Entity.Player);
      anim(Entity.Player, Animation(12), wait: 10);
      setObjectVisibility(23, 1);
      playSound(0, 7);
      speak(Entity.System, "『<PINK>次元キーホルダー<WHITE>』を<NEWLINE> 手に入れた!<NEWLINE> アイテムを20個まで持てるぞ!<NEWLINE>");
      playSound(0, 7);
      setInventorySize(20);
      setTrigger(Trigger(47));
    }
    4 => {
      setObjectVisibility(22, 0);
      move(entity: Entity.Player, to: (2068, 760), sprint: 1);
      waitForEntity(Entity.Player);
      anim(Entity.Player, Animation(12), wait: 10);
      setObjectVisibility(22, 1);
      playSound(0, 7);
      speak(Entity.System, "『<PINK>次元キーホルダー<WHITE>』を<NEWLINE> 手に入れた!<NEWLINE> アイテムを30個まで持てるぞ!<NEWLINE>");
      setTrigger(Trigger(48));
      setInventorySize(30);
      setTrigger(Trigger(253));
      addPStat(PStat(1), 1);
    }
  }
  addPStat(PStat(21), 1);
  setTrigger(Trigger(336));
  return;
  garbage { 1c 00 fe 00 1c 00 33 00 42 00 05 00 5a 00 34 00 66 02 06 00 3e 03 07 00 74 07 ff ff 19 00 01 00 54 01 18 00 2c 00 19 00 16 00 66 02 19 00 00 00 55 01 81 00 d3 00 18 00 40 00 19 00 16 00 3e 03 fe 00 4e fd ca 05 69 fd 00 00 4a fd 4e fd 27 02 57 00 00 00 4b a3 01 ff fe 00 19 00 01 00 56 01 18 00 bc 01 19 00 1c 00 56 01 1b 05 1a 00 81 75 82 d6 82 b1 82 d6 82 b1 82 d6 82 b1 81 42 82 a0 81 5b 92 b2 8e 71 82 ed 82 e9 82 a3 81 5b 81 42 81 76 0d 00 00 00 1b fd 1a 00 81 75 82 f1 81 41 91 e5 8f e4 95 76 82 a9 81 48 81 76 0d 00 00 00 1b 05 1a 00 81 75 82 d6 82 b1 82 d6 82 b1 81 42 82 c6 82 c9 82 a9 82 ad 92 b2 8e 71 82 ed 82 e9 82 a2 82 cc 82 b6 82 e1 81 5b 81 42 81 76 0d 00 00 00 1b fd 1a 00 81 75 82 a8 82 dc 82 a6 81 41 82 b1 82 f1 82 c8 82 c6 82 b1 82 c9 8f 5a 82 f1 82 c5 82 f1 82 cc 81 48 81 76 0d 00 00 00 1b 05 1a 00 81 75 82 a0 81 60 8b 43 8e 9d 82 bf 82 ed 82 e9 81 42 82 be 82 e9 82 a2 82 ed 82 9f 81 60 81 42 81 76 0d 00 00 00 1b fd 1a 00 81 75 82 a4 81 5b 82 f1 81 42 82 c6 82 c9 82 a9 82 ad 92 b2 8e 71 88 ab 82 bb 82 a4 82 be 81 42 82 a2 82 c2 82 e0 82 b1 82 a4 0d 00 81 40 82 c1 82 c4 82 ed 82 af 82 b6 82 e1 82 c8 82 a2 82 be 82 eb 82 a4 82 b5 81 42 82 bf 82 e5 82 c1 82 c6 81 63 0d 00 81 40 90 c2 82 b4 82 df 82 c4 82 a2 82 e9 82 e6 82 a4 82 c9 81 63 8c a9 82 a6 82 c8 82 ad 82 e0 82 c8 82 a2 81 42 81 76 0d 00 00 00 1b 05 1a 00 81 75 82 d6 82 b1 82 d6 82 b1 81 42 0d 00 81 40 82 c7 82 f1 82 c7 82 f1 92 b2 8e 71 82 ed 82 e9 82 ad 82 c8 82 c1 82 c4 82 ad 82 ed 81 42 81 76 0d 00 00 00 1b fd 1a 00 81 75 82 de 81 5b 81 42 89 bd 82 a9 8c b4 88 f6 82 f0 82 b3 82 ae 82 e7 82 c8 82 a2 82 c6 83 5f 83 81 82 a9 81 63 81 76 0d 00 00 00 1b fd 1a 00 81 75 82 b1 82 cc 94 72 90 85 82 cd 82 c7 82 b1 82 a9 82 e7 97 88 82 c4 82 e9 82 cc 82 a9 82 c8 81 42 0d 00 81 40 82 b3 82 ae 82 c1 82 c4 82 dd 82 e6 82 a4 81 49 81 76 0d 00 00 00 fe 00 1c 00 54 01 67 00 14 00 52 fd 8b 07 1e fe 00 00 4e fc 1e 07 85 fc 00 00 4a fd 4a fc 1b fd 1a 00 81 75 82 a4 81 41 82 c8 82 f1 82 be 82 b1 82 e8 82