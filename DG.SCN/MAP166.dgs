// MAP166.SCN
#pragma script index=166 start=0x7a800 end=0x7b000 headerU16=0x18 sentinelOff=0x19

section onEnter(254) {  // len=38
    if (!trigger(88) || trigger(50)) goto L1;
    playAnimation(7, 30);

L1:
    if (!trigger(214)) goto L2;
    playAnimation(6, 30);

L2:
    return;
}

section(60) {  // len=448
    unloadEntity(5);
    unloadModel(Digimon.Botamon);
    loadDigimon(Digimon.Jijimon);
    setDigimon(Digimon.Jijimon, 3, 0);
    look(entity: 8, at: Entity.Player);
    delay(20);
    speak(8, "I think all is OK now.\n");
    speak(Entity.Player, "I'm glad.\n");
    speak(8, "We must defeat the boss\nas soon as possible.\n");
    speak(Entity.Player, "I know...\n");
    delay(40);
    if (!trigger(220) && !trigger(214) && pstat[1] < 50) goto L1;
    goto L10;
    goto L2;

L1:
    goto L2;

L2:
    if (!trigger(221)) goto L3;
    goto L7;
    goto L4;

L3:
    goto L4;

L4:
    if (!trigger(225)) goto L5;
    warp(to: Map.TWNA04, spawn: 2, trigger: 255);

L5:
    if (!trigger(246)) goto L6;
    warp(to: Map.TWNA03, spawn: 2, trigger: 255);

L6:
    warp(to: Map.TWNA02, spawn: 2, trigger: 255);

L7:
    if (!trigger(225)) goto L8;
    warp(to: Map.TWNA07, spawn: 2, trigger: 255);

L8:
    if (!trigger(246)) goto L9;
    warp(to: Map.TWNA06, spawn: 2, trigger: 255);

L9:
    warp(to: Map.TWNA05, spawn: 2, trigger: 255);

L10:
    if (!trigger(221)) goto L11;
    goto L15;
    goto L12;

L11:
    goto L12;

L12:
    if (!trigger(225)) goto L13;
    warp(to: Map.TWNA10, spawn: 2, trigger: 255);

L13:
    if (!trigger(246)) goto L14;
    warp(to: Map.TWNA09, spawn: 2, trigger: 255);

L14:
    warp(to: Map.TWNA08, spawn: 2, trigger: 255);

L15:
    if (!trigger(225)) goto L16;
    warp(to: Map.TWNA13, spawn: 2, trigger: 255);

L16:
    if (!trigger(246)) goto L17;
    warp(to: Map.TWNA12, spawn: 2, trigger: 255);

L17:
    warp(to: Map.TWNA11, spawn: 2, trigger: 255);
    return;
}

section(5) {  // len=54
    speak(5, "We're all trying hard.\n");
    return;
}

section(6) {  // len=36
    setTrigger(44);
    speak(Entity.Player, "It's empty.\n");
    return;
}

section(7) {  // len=1448
    setTrigger(44);
    speak(Entity.System, "Airdramon is asleep.\n");
