#pragma script index=166 start=0x73800 end=0x74000 headerU16=0x1c sentinelOff=0x1675
#include "entities.dgs"

section onEnter(254) {
  spawnChest(Item.Autopilot, -2681, -404, 2048, 687);
  return;
}

section(51) {
  move(entity: Entity.Player, to: (2133, -489), sprint: 0);
  warp(to: Map.MGEN08, spawn: 0, trigger: 255);
  return;
}

section(52) {
  move(entity: Entity.Player, to: (2909, 268), sprint: 0);
  warp(to: Map.MGEN06, spawn: 1, trigger: 255);
  return;
}

section(5) {
  speak(Entity(5), "「かえってください。」<NEWLINE>");
  finishEncounter(Trigger(308));
}

section(6) {
  speak(Entity(6), "「しかたないから、たたかう。」<NEWLINE>");
  finishEncounter(Trigger(308));
}

