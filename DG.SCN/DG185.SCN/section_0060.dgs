section section_60(60) {  // len=160
    rotate(entity: Entity.Player, to: 1024);
    delay(40);
    setDialogOwner(Entity.Player);
    showTextbox("What kind of place is this?\n");
    move(entity: Entity.Player, to: (2150, 1950), sprint: 0, withCamera: true);
    waitForEntity(Entity.Player);
    setDialogOwner(Entity.Player);
    showTextbox("I see. In the back of\nthis place...\n");
    return;
}
