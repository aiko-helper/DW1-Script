; DG129.SCN
;!script index=129 start=0x5b000 end=0x5b800 headerU16=0x18 sentinelOff=0x24
;!sections onEnter section_6 section_10 section_7 section_51

onEnter:     ; len=136
  0000:  storeRandom 110 99
  0004:  if pstat[110] > 10 then onEnter+0x16
  0010:  spawnItem 44 40 54
  0016:  setPStat 113 0
  001a:  if !trigger(5) AND !trigger(6) AND !trigger(7) then onEnter+0x32
  002e:  playAnimation 5 29
  0032:  if !trigger(5) OR !trigger(6) then onEnter+0x46
  0042:  playAnimation 5 30
  0046:  if !trigger(5) OR !trigger(7) then onEnter+0x5a
  0056:  playAnimation 5 30
  005a:  if !trigger(6) OR !trigger(7) then onEnter+0x6e
  006a:  playAnimation 5 30
  006e:  if (!trigger(5) ?? !trigger(6)) OR !trigger(7) then onEnter+0x86
  0082:  playAnimation 5 31
  0086:  endSection
