// DG206.SCN
#include "functions.dgs"
#pragma script index=206 start=0xa7800 end=0xa9800 headerU16=0x1c sentinelOff=0xfe
#include "entities.dgs"

section onEnter(254) {
  return;
}

section(6) {
  setPStat(PStat(122), 0);
  if (!trigger(257) && !trigger(357)) {
    speak(Entity(6), "Hey, do you want to play a\nmatch with me? If you win,\nI'll do whatever you say.\n");
    speak(Entity.Player, "What kind of match?\n");
    speak(Entity(6), "What I call...\nDigimon Curling! \nI'll tell you more inside.\n");
    speak(Entity.Player, "Hmm, what happens if I lose?\n");
    speak(Entity(6), "Nothing the first time.\nBut next time you have to\ngive me a fish first.\n");
    speak(Entity.Player, "Then if I win, you come to\nthe city with me. OK?");
    dead_string("? to\nThen, let's do it.\n");
    speak(Entity(6), "Alright, that's fine. \nLet's go inside.\n");
    setTrigger(Trigger(357));
    move(entity: Entity(6), to: (1905, 1667), sprint: 0);
    delay(10);
    move(entity: Entity.Player, to: (1905, 1667), sprint: 0);
    delay(10);
    move(entity: Entity.Partner, to: (1905, 1667), sprint: 0);
    delay(10);
    warp(to: Map.FRZL17, spawn: 1, trigger: 255);
    return;
  }
  {
    if (!trigger(257)) {
      speak(Entity(6), "Hey, do you want to play a\nmatch with me? Give me a\nfish and you can play me.\n");
      setDialogOwner(Entity.Player);
      choice { "I'll get you" -> L1, "No thanks" -> L_061e }
      return;
    }
    if (!trigger(92)) {
      setTrigger(Trigger(92));
      speak(Entity(6), "Hey bro! I made a\nskating rink here.\n");
      showTextbox("One fish for one match.\nBut if you win, I'll give\nyou a nice prize.\n");
    }
    setPStat(PStat(122), 0);
    speak(Entity(6), "Hey dude, don't you want to\nhave a match with me? You can\nchallenge me with one fish.\n");
    setDialogOwner(Entity.Player);
    choice { "You're on" -> L1, "No thanks" -> L_061e }
    return;
  }
  setPStat(PStat(113), 0);
  speak(Entity(6), "Shoot, that's no fun.\n");
  return;

L1:
  speak(Entity(6), "Give me a fish!\n");
  setTrigger(Trigger(3));
  callSubroutine(0);
  {
    if (trigger(3)) {
      speak(Entity.Player, "I don't got anything now...\n");
      break;
    }
    {
      if (pstat[254] == 62 || pstat[254] == 63 || pstat[254] == 64 || pstat[254] == 65) {
        callSubroutine(12);
        break;
      }
      if (pstat[254] == 66 || pstat[254] == 67) {
        callSubroutine(12);
        break;
      }
      if (pstat[254] == 255) {
        goto L2;
        break;
      }
      speak(Entity.Player, "Oh no, giving you this\ndoesn't do any good.\n");
      goto L2;
    }
    speak(Entity(6), "Wow, it looks tasty. Ooops,\nwe have to have a match first.\nLet's go inside.\n");
    warp(to: Map.FRZL17, spawn: 1, trigger: 255);
    return;

L2:
  }
  setPStat(PStat(113), 0);
  speak(Entity(6), "Oh come on, dude.\nWhy don't you go fishing\nat Dragon Eye Lake.\n");
  return;
  return;
}

section(10) {
  if (pstat[121] == 0) {
    speak(Entity(6), "Sorry bro. Come back again\nto challenge me. And don't\nforget to bring another fish.\n");
    return;
  }
  {
    if (pstat[121] != 2) break;
    speak(Entity(6), "Impressive! Perfect score!\nAre you by any chance...\na professional?\n");
    if (trigger(372)) break;
    setTrigger(Trigger(372));
    playSound(0, 7);
    speak(Entity.System, "<YELLOW>Congratulations!\nHere's a Medal for your\ngreat competition! <WHITE>\n");
  }
  speak(Entity(6), "Amazing dude. I lost a\nmatch for the first time.\n");
  speak(Entity.Player, "Alright, now come to the city\nwith me as you promised.\n");
  speak(Entity(6), "Oh well, I guess I have to.\nBut I already decided what\nI'm going to do in the city.\n");
  goto L1;

L1:
  approach(who: Entity(6), x: -105, y: 1821, tries: 3, wait: 20);
  playSound(8, 11);
  speak(Entity.System, "Penguinmon joins the city!\n");
  followEntity(Entity.Player, speed: 10);
  setTrigger(Trigger(257));
  addPStat(PStat(1), 1);
  return;
}

section(11) {
  if (pstat[121] == 0) {
    speak(Entity(6), "Sorry bro. Come back again\nto challenge me. And don't\nforget to bring a fish.\n");
    return;
  }
  {
    if (pstat[121] != 2) break;
    speak(Entity(6), "Impressive! Perfect score!\nAre you by any chance...\na professional?\n");
    if (trigger(372)) break;
    setTrigger(Trigger(372));
    playSound(0, 7);
    speak(Entity.System, "<YELLOW>Congratulations!\nHere's a Medal for your\ngreat competition! <WHITE>\n");
  }
  speak(Entity(6), "Wow, you're amazing, man. \nI lost again.\n");
  speak(Entity(6), "Well, what can I say.\nHere's your prize.\n");
  roll(pstat: PStat(102), max: 49);
  loop {
    {
      if (pstat[102] <= 0) {
        giveItem(Item.Rooster, 1);
        setPStat(PStat.RollScratch, 85);
        break;
      }
      if (pstat[102] <= 5) {
        giveItem(Item.Restore, 1);
        setPStat(PStat.RollScratch, 11);
        break;
      }
      if (pstat[102] <= 15) {
        giveItem(Item.OmniDisk, 1);
        setPStat(PStat.RollScratch, 18);
        break;
      }
      if (pstat[102] <= 22) {
        giveItem(Item.GiantMeat, 1);
        setPStat(PStat.RollScratch, 39);
        break;
      }
      if (pstat[102] <= 30) {
        giveItem(Item.LargeRecovery, 1);
        setPStat(PStat.RollScratch, 2);
        break;
      }
      if (pstat[102] > 50) break;
      giveItem(Item.MediumMP, 1);
      setPStat(PStat.RollScratch, 5);
      break;
    }
    if (!trigger(0)) break;
    speak(Entity(6), "You have too many Items!\n");
    unsetTrigger(Trigger(3));
    callSubroutine(0);
    callSubroutine(13);
  }
  speak(Entity.System, "I got a <LIGHTBLUE><TREASURE ITEM><WHITE>!\n");
  followEntity(Entity.Player, speed: 10);
  return;
  return;
}

section(7) {
  setPStat(PStat(122), 1);
  speak(Entity(6), "Hey <LIGHTBLUE><PLAYER><WHITE>. I'm watching\nthe shop now as a favor for\nPenguinmon.\n");
  showTextbox("Have a match with me!\nIf you win, I'll give you my\nspecial prize. How's that?\n");
  setDialogOwner(Entity.Player);
  choice { "Alright, let's do it" -> L1, "No thanks" -> L3 }
  return;

L1:
  speak(Entity(6), "Let me get the fish\nbefore the match.\n");
  setTrigger(Trigger(3));
  callSubroutine(0);
  {
    if (trigger(3)) {
      speak(Entity.Player, "Oh, I don't have\nanything right now.\n");
      break;
    }
    {
      if (pstat[254] == 62 || pstat[254] == 63 || pstat[254] == 64 || pstat[254] == 65) {
        callSubroutine(12);
        break;
      }
      if (pstat[254] == 66 || pstat[254] == 67) {
        callSubroutine(12);
        break;
      }
      if (pstat[254] == 255) {
        goto L2;
        break;
      }
      speak(Entity.Player, "Giving this to you\nwon't do any good.\n");
      goto L2;
    }
    speak(Entity(6), "Well, this time, I'm gonna\nwin. Let's go inside.\n");
    warp(to: Map.FRZL17, spawn: 1, trigger: 255);
    return;

L2:
  }
  setPStat(PStat(113), 0);
  speak(Entity(6), "I can't have a match\nwithout a fish. Come back\nagain some other time.\n");
  return;

L3:
  speak(Entity(6), "What? Are you\nturning me down?\n");
  return;
}

section(12) {
  if (pstat[121] == 0) {
    speak(Entity(6), "If you want to win against\nme, you better use your head!\nI'll see you again someday.\n");
    return;
  }
  {
    if (pstat[121] != 2) break;
    speak(Entity(6), "You got a perfect score\nagainst me!! Are you\na Curling genius?!\n");
    if (trigger(372)) break;
    setTrigger(Trigger(372));
    playSound(0, 7);
    speak(Entity.System, "<YELLOW>Congratulations!\nHere's a Medal for your\ngreat competition! <WHITE>\n");
  }
  speak(Entity(6), "You are good, <LIGHTBLUE><PLAYER><WHITE>!\nHere's the prize\nI promised you!\n");
  roll(pstat: PStat(102), max: 49);
  loop {
    {
      if (pstat[102] <= 0) {
        giveItem(Item.SilverBall, 1);
        setPStat(PStat.RollScratch, 103);
        break;
      }
      if (pstat[102] <= 1) {
        giveItem(Item.MetalArmor, 1);
        setPStat(PStat.RollScratch, 104);
        break;
      }
      if (pstat[102] <= 2) {
        giveItem(Item.Chainsaw, 1);
        setPStat(PStat.RollScratch, 105);
        break;
      }
      if (pstat[102] <= 3) {
        giveItem(Item.SmallSpear, 1);
        setPStat(PStat.RollScratch, 106);
        break;
      }
      if (pstat[102] <= 11) {
        giveItem(Item.SuperRecovery, 1);
        setPStat(PStat.RollScratch, 3);
        break;
      }
      if (pstat[102] <= 21) {
        giveItem(Item.Restore, 1);
        setPStat(PStat.RollScratch, 11);
        break;
      }
      if (pstat[102] <= 33) {
        giveItem(Item.Omnipotent, 1);
        setPStat(PStat.RollScratch, 9);
        break;
      }
      if (pstat[102] > 49) break;
      giveItem(Item.Sirloin, 1);
      setPStat(PStat.RollScratch, 40);
      break;
    }
    if (!trigger(0)) break;
    speak(Entity(6), "You have too many Items.\n");
    unsetTrigger(Trigger(3));
    callSubroutine(0);
    callSubroutine(13);
  }
  speak(Entity.System, "I got a <LIGHTBLUE><TREASURE ITEM><WHITE>!\n");
  followEntity(Entity.Player, speed: 10);
  return;
