section onEnter(254) {
    spawnChest(Item.DoubleFloppy, -2816, 318, 3072, 688);
    return;
}

section(51) {
    move(entity: Entity.Player, to: (2759, 254), sprint: 0);
    warp(to: Map.MGEN09, spawn: 0, trigger: 255);
    return;
}

section(52) {
    move(entity: Entity.Player, to: (-1123, -532), sprint: 0);
    warp(to: Map.MGEN07, spawn: 0, trigger: 255);
    return;
}

section(5) {
    speak(5, "I'm gonna miss you.\n");
    startBattle();
    setTrigger(305);
    return;
}

section(6) {
    speak(6, "I won't let you get away!\n");
    startBattle();
    setTrigger(305);
    return;
}

section(7) {
    speak(7, "Can you survive?\n");
    startBattle();
    setTrigger(288);
    return;
}

section(8) {
