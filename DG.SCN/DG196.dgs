// DG196.SCN
#include "functions.dgs"
#pragma script index=196 start=0x93000 end=0x93800 headerU16=0x14 sentinelOff=0xfe
#include "entities.dgs"

section onEnter(254) {
  return;
}

section(51) {
  move(entity: Entity.Player, to: (-370, -4600), sprint: 0);
  warp(to: Map.MGEN10, spawn: 1, trigger: 255);
  return;
}

section(52) {
  move(entity: Entity.Player, to: (-400, 4800), sprint: 0);
  warp(to: Map.MGEN99, spawn: 0, trigger: 255);
  return;
}

section(53) {
  if (trigger(326)) {
    return;
  }
  {
    look(entity: Entity.Player, at: Entity(5));
    panTo(x: -400, y: 2400, slowdown: 15);
    look(entity: Entity(5), at: Entity.Player);
    delay(5);
    speak(Entity(5), "「ついに…ここまで来てしまったのか。」<NEWLINE>");
    anim(Entity.Player, Animation(20), wait: 15);
    speak(Entity.Player, "「お前が親玉かっ!?」<NEWLINE>");
    playAnimation(Entity.Player, Animation(0));
    speak(Entity(5), "「残念だが、ちがうな。<NEWLINE> 俺はメタルグレイモン!」<NEWLINE>");
    setDialogOwner(Entity.Player);
    anim(Entity.Player, Animation(19), wait: 15);
    showTextbox("「お前の相手は後でする!どいてくれ!」<NEWLINE>");
    playAnimation(Entity.Player, Animation(0));
    speak(Entity(5), "「そうはいかん。おまえ達をここから先へ<NEWLINE> 行かせないのが俺の仕事だ。」<NEWLINE>");
    speak(Entity.Player, "「(く…ここはなるべく戦力を温存したいが、<NEWLINE> そうもいきそうにない相手だな…。)」<NEWLINE>");
    speak(Entity(5), "「いざ、行くぞ!」<NEWLINE>");
    setTrigger(Trigger(1));
    setPStat(PStat(250), 1);
    setPStat(PStat(251), 5);
    setPStat(PStat(252), 255);
    setPStat(PStat(253), 255);
    startBattle();
    unsetTrigger(Trigger(1));
    setPStat(PStat(250), 0);
    look(entity: Entity.Player, at: Entity(5));
    look(entity: Entity(5), at: Entity.Player);
    look(entity: Entity.Partner, at: Entity(5));
    speak(Entity(5), "「う…む…ここは…?」<NEWLINE>");
    speak(Entity.Player, "「正気に戻ったのか!」<NEWLINE>");
    speak(Entity(5), "「そういうことらしい…」<NEWLINE>");
    showTextbox("「フ…おまえ達がやつを倒したなら<NEWLINE> また会うこともあるだろう。それまで俺は<NEWLINE> 消えるとするぜ。」<NEWLINE>");
    break;
  }
  loop {
    move(entity: Entity(5), to: (-400, -500), sprint: 0);
    if (pstat[101] >= 3) break;
    addPStat(PStat.LoopIterator, 1);
    delay(20);
    lookPairAt(Entity(5));
  }
  waitForEntity(Entity(5));
  unloadEntity(Entity(5));
  setPStat(PStat.LoopIterator, 0);
  followEntity(Entity.Player, speed: 10);
  setTrigger(Trigger(326));
  return;
  garbage { 14 00 fe 00 14 00 33 00 16 00 34 00 24 00 35 00 32 00 ff ff fe 00 4e fd 8e fe 08 ee 00 00 4b fe 01 ff fe 00 4e fd 70 fe c0 12 00 00 4b e1 00 ff fe 00 19 00 00 00 46 01 18 00 40 00 19 00 fe 00 4c 00 fd 05 4f 0f 70 fe 60 09 4a c8 4c 00 05 fd 67 00 05 00 1b 05 1a 00 81 75 82 c2 82 a2 82 c9 81 63 82 b1 82 b1 82 dc 82 c5 97 88 82 c4 82 b5 82 dc 82 c1 82 bd 82 cc 82 a9 81 42 81 76 0d 00 00 00 56 00 fd 14 67 00 0f 00 1b fd 1a 00 81 75 82 a8 91 4f 82 aa 90 65 8b ca 82 a9 82 c1 81 49 81 48 81 76 0d 00 00 00 56 00 fd 00 1b 05 1a 00 81 75 8e 63 94 4f 82 be 82 aa 81 41 82 bf 82 aa 82 a4 82 c8 81 42 0d 00 81 40 89 b4 82 cd 83 81 83 5e 83 8b 83 4f 83 8c 83 43 83 82 83 93 81 49 81 76 0d 00 00 00 1b fd 56 00 fd 13 67 00 0f 00 1a 00 81 75 82 a8 91 4f 82 cc 91 8a 8e e8 82 cd 8c e3 82 c5 82 b7 82 e9 81 49 82 c7 82 a2 82 c4 82 ad 82 ea 81 49 81 76 0d 00 00 00 56 00 fd 00 1b 05 1a 00 81 75 82 bb 82 a4 82 cd 82 a2 82 a9 82 f1 81 42 82 a8 82 dc 82 a6 92 42 82 f0 82 b1 82 b1 82 a9 82 e7 90 e6 82 d6 0d 00 81 40 8d 73 82 a9 82 b9 82 c8 82 a2 82 cc 82 aa 89 b4 82 cc 8e 64 8e 96 82 be 81 42 81 76 0d 00 00 00 1b fd 1a 00 81 75 81 69 82 ad 81 63 82 b1 82 b1 82 cd 82 c8 82 e9 82 d7 82 ad 90 ed 97 cd 82 f0 89 b7 91 b6 82 b5 82 bd 82 a2 82 aa 81 41 0d 00 81 40 82 bb 82 a4 82 e0 82 a2 82 ab 82 bb 82 a4 82 c9 82 c8 82 a2 91 8a 8e e8 82 be 82 c8 81 63 81 42 81 6a 81 76 0d 00 00 00 1b 05 1a 00 81 75 82 a2 82 b4 81 41 8d 73 82 ad 82 bc 81 49 81 76 0d 00 00 00 1c 00 01 00 1e 00 fa 01 1e 00 fb 05 1e 00 fc ff 1e 00 fd ff 27 00 67 00 01 00 66 00 1d 00 01 00 1e 00 fa 00 4c 00 fd 05 4c 00 05 fd 4c 00 fc 05 1b 05 1a 00 81 75 82 a4 81 63 82 de 81 63 82 b1 82 b1 82 cd 81 63 81 48 81 76 0d 00 00 00 1b fd 1a 00 81 75 90 b3 8b 43 82 c9 96 df 82 c1 82 bd 82 cc 82 a9 81 49 81 76 0d 00 00 00 1b 05 1a 00 81 75 82 bb 82 a4 82 a2 82 a4 82 b1 82 c6 82 e7 82 b5 82 a2 81 63 81 76 0d 00 00 00 1a 00 81 75 83 74 81 63 82 a8 82 dc 82 a6 92 42 82 aa 82 e2 82 c2 82 f0 93 7c 82 b5 82 bd 82 c8 82 e7 0d 00 81 40 82 dc 82