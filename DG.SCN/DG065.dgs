section onEnter(254) {
  spawnItemChance(max: 99, chance: 8, item: Item.Digimushroom, x: 57, y: 61);
  spawnItemChance(max: 99, chance: 19, item: Item.Digimushroom, x: 35, y: 43);
  spawnItemChance(max: 99, chance: 2, item: Item.SweetNut, x: 39, y: 18);
  if (trigger(328)) {
  } else {
    setObjectsVisibleRange(38, 40, 1);
  }
  return;
}

section(5) {
  {
    switch (pstat[33]) { case 0: break; case 1: goto L1; case 2: goto L2; }
  }
  delay(1);
  setPStat(PStat(200), 20);
  dealMapDamage(PStat(200));
  setObjectVisibility(41, 0);
  setPStat(PStat(247), 41);
  setPStat(PStat(248), 1);
  callSubroutine(21);
  spawnSpriteAtEntity(5, 10498);
  playSound(8, 0);
  anim(Entity.Partner, Animation(40), wait: 3);
  playAnimation(Entity.Player, Animation(17));
  look(entity: Entity(5), at: Entity.Player);
  waitForEntity(Entity(5));
  setObjectVisibility(41, 1);
  setObjectVisibility(42, 1);
  speak(Entity(5), "「あはは、ボクにさわると バチッ と<NEWLINE> くるだろ。」<NEWLINE>");
  followEntity(Entity.Player, speed: 10);
  addPStat(PStat(33), 1);
  return;

L1:
  delay(1);
  setPStat(PStat(200), 20);
  dealMapDamage(PStat(200));
  setObjectVisibility(41, 0);
  setPStat(PStat(247), 41);
  setPStat(PStat(248), 1);
  callSubroutine(21);
  spawnSpriteAtEntity(5, 10498);
  playSound(8, 0);
  anim(Entity.Partner, Animation(40), wait: 3);
  playAnimation(Entity.Player, Animation(17));
  look(entity: Entity(5), at: Entity.Player);
  waitForEntity(Entity(5));
  setObjectVisibility(41, 1);
  setObjectVisibility(42, 1);
  speak(Entity(5), "「おいおいオマエ…<NEWLINE> いたくないのかよ?」<NEWLINE>");
  followEntity(Entity.Player, speed: 10);
  addPStat(PStat(33), 1);
  return;

L2:
  {
    delay(1);
    setPStat(PStat(200), 20);
    dealMapDamage(PStat(200));
    setObjectVisibility(41, 0);
    setPStat(PStat(247), 41);
    setPStat(PStat(248), 1);
    callSubroutine(21);
    spawnSpriteAtEntity(5, 10498);
    playSound(8, 0);
    anim(Entity.Partner, Animation(40), wait: 3);
    playAnimation(Entity.Player, Animation(17));
    look(entity: Entity(5), at: Entity.Player);
    waitForEntity(Entity(5));
    setObjectVisibility(41, 1);
    setObjectVisibility(42, 1);
    followEntity(Entity.Player, speed: 10);
    speak(Entity(5), "「うわっ、すげー、根性あるなあ。」<NEWLINE>");
    showTextbox("「おまえ、見所あるよ!<NEWLINE> よーし、何か力になっちゃる。」<NEWLINE>");
    playAnimation(Entity.Player, Animation(19));
    speak(Entity.Player, "「…その電気の力、街づくりに役立てて<NEWLINE> みないか?」<NEWLINE>");
    speak(Entity(5), "「…街?あれ、なんだろ……<NEWLINE> 懐かしいひびきがするな。何でかな?」<NEWLINE>");
    showTextbox("「んー。そいじゃ、おまえに協力する。<NEWLINE> ボク、エレキモン。よろしくな。」<NEWLINE>");
    break;
  }
  approach(who: Entity(5), x: -171, y: -2105, tries: 6, wait: 10);
  playSound(8, 5);
  speak(Entity.System, "エレキモンが街に参加した!!!<NEWLINE>");
  setTrigger(Trigger(218));
  addPStat(PStat(1), 1);
  followEntity(Entity.Player, speed: 10);
  return;
}

section(6) {
