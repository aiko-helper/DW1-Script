; DG069.SCN
;!script index=69 start=0x31800 end=0x32000 headerU16=0x1c sentinelOff=0x24
;!sections onEnter section_5 section_6 section_7 section_8 section_9

onEnter:     ; len=68
  0000:  storeRandom 110 99
  0004:  if pstat[110] > 12 then onEnter+0x16
  0010:  spawnItem Digimushroom 44 56
  0016:  storeRandom 110 99
  001a:  if pstat[110] > 8 then onEnter+0x2c
  0026:  spawnItem Digimushroom 74 50
  002c:  storeRandom 110 99
  0030:  if pstat[110] > 1 then onEnter+0x42
  003c:  spawnItem Happymushroom 45 46
  0042:  endSection
