// source: extract/DIGIMON/SCN/DG.SCN
// DG069.SCN, section 5

section section_5(5) {  // len=1172
    playSound(8, 7);
    setDialogOwner(5);
    showTextbox("I'm gonna knock you out!\n");
    setTrigger(1);
    setPStat(250, 1);
    setPStat(251, 5);
    setPStat(252, 255);
    setPStat(253, 255);
    fadeOutHUD();
    delay(1);
    startBattle();
    unsetTrigger(1);
    setPStat(250, 0);
    look(entity: Entity.Player, at: 5);
    look(entity: 5, at: Entity.Player);
    look(entity: Entity.Partner, at: 5);
    setDialogOwner(5);
    showTextbox("Let's do it again.\n");
    setDialogOwner(Entity.Player);
    setSelection(L_00b6, L_0466);
    showTextbox("OK\nNo\n");
    waitForSelectionChoice();
    goto L_0466;
L_00b6:
    setTrigger(1);
    setPStat(250, 1);
    setPStat(251, 5);
    setPStat(252, 255);
    setPStat(253, 255);
    fadeOutHUD();
    delay(1);
    startBattle();
    unsetTrigger(1);
    setPStat(250, 0);
    look(entity: Entity.Player, at: 5);
    look(entity: 5, at: Entity.Player);
    look(entity: Entity.Partner, at: 5);
    setDialogOwner(5);
    showTextbox("Just a little more...\nCome on, one more time!\n");
    playAnimation(Entity.Player, 16);
    setDialogOwner(Entity.Player);
    setSelection(L_016a, L_0466);
    showTextbox("OK\nNo\n");
    waitForSelectionChoice();
    goto L_0466;
L_016a:
    setTrigger(1);
    setPStat(250, 1);
    setPStat(251, 5);
    setPStat(252, 255);
    setPStat(253, 255);
    fadeOutHUD();
    delay(1);
    startBattle();
    unsetTrigger(1);
    setPStat(250, 0);
    look(entity: Entity.Player, at: 5);
    look(entity: 5, at: Entity.Player);
    look(entity: Entity.Partner, at: 5);
    delay(5);
    playAnimation(5, 28);
    playSound(8, 7);
    delay(40);
    setDialogOwner(5);
    showTextbox("I can't win!\n");
    playAnimation(Entity.Player, 8);
    setDialogOwner(Entity.Player);
    showTextbox("Why do you want to win?\n");
    playAnimation(5, 0);
    playAnimation(Entity.Player, 0);
    setDialogOwner(5);
    showTextbox("What should I do?\n");
    setDialogOwner(Entity.Player);
    showTextbox("What do you mean?\nYou don't have anything?\n");
    setDialogOwner(5);
    showTextbox("I've got lots of time.\n");
    playAnimation(Entity.Player, 19);
    setDialogOwner(Entity.Player);
    showTextbox("If you have too much time,\ncome to the city. There're\nall kinds of Digimon there.\n");
    setDialogOwner(5);
    showTextbox("Sounds good. I'll go.\nMy name's Patamon.\nSee ya later.\n");
    goto L_03ec;
L_03ec:
    move(entity: 5, to: (-1673, 122), sprint: 1);
    if (pstat[101] >= 10) goto L_0414;
    addPStat(101, 1);
    delay(10);
    look(entity: Entity.Player, at: 5);
    look(entity: Entity.Partner, at: 5);
    goto L_03ec;
L_0414:
    waitForEntity(5);
    unloadEntity(5);
    setPStat(101, 0);
    playSound(8, 5);
    setDialogOwner(Entity.System);
    showTextbox("Patamon joins the city!\n");
    moveCamera(to: Entity.Player, speed: 10);
    waitForEntity(200);
    setTrigger(231);
    addPStat(1, 1);
    return;
L_0466:
    setDialogOwner(5);
    showTextbox("That's not fun!\n");
    moveCamera(to: Entity.Player, speed: 10);
    waitForEntity(200);
    return;
}
