#pragma script index=47 start=0x24000 end=0x24800 headerU16=0x18 sentinelOff=0xfe

function delayThenSetTriggerThenSetPStatThenSetPStatThenSetPStat(a, b, c) {
    delay(a);
    setTrigger(1);
    setPStat(250, 1);
    setPStat(251, b);
    setPStat(252, c);
}


section onEnter(254) {  // len=2
    return;
}

section(5) {  // len=136
    speak(5, "Formation C!\n");
    move(entity: 6, to: (-230, 547), sprint: 1);
    move(entity: 7, to: (483, 70), sprint: 1);
    waitForEntity(6);
    waitForEntity(7);
    delayThenSetTriggerThenSetPStatThenSetPStatThenSetPStat(10, 5, 6);
    setPStat(253, 7);
    startBattle();
    setPStat(250, 0);
    unsetTrigger(1);
    move(entity: 5, to: (550, -2050), sprint: 1);
    move(entity: 6, to: (550, -2050), sprint: 1);
    move(entity: 7, to: (550, -2050), sprint: 1);
    for id in 5..7 { waitForEntity(id); }
    for id in 5..7 { unloadEntity(id); }
    moveCamera(to: Entity.Player, speed: 10);
    waitForEntity(200);
    return;
}

