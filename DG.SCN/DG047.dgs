section(7) {
  speak(Entity(7), "Formation B!\n");
  move(entity: Entity(6), to: (702, 855), sprint: 1);
  move(entity: Entity(5), to: (29, 586), sprint: 1);
  waitForEntity(Entity(5));
  waitForEntity(Entity(6));
