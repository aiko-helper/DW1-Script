// DG047.SCN
#include "functions.dgs"
#pragma script index=47 start=0x22800 end=0x23800 headerU16=0x10 sentinelOff=0x19
#include "entities.dgs"

section onEnter(254) {
  if (!trigger(247)) {
    playAnimation(Entity(5), Animation(28));
  }
  return;
}

section(81) {
  if (trigger(247)) {
    return;
  }
  look(entity: Entity.Player, at: Entity(5));
  if (trigger(136)) {
    goto L3;
  }
  setTrigger(Trigger(136));
  speak(Entity(5), "「いらっしゃい…おや?<NEWLINE> お客さん、初めてみるけど、遠くから?」<NEWLINE>");
  speak(Entity.Player, "「街から来た。いや、元は別世界からか。」<NEWLINE>");
  speak(Entity(5), "「私の言葉がわかるんですな。」<NEWLINE>");
  speak(Entity.Player, "「そりゃ…あ、当たり前…じゃないのかぁ…。<NEWLINE> 言葉が通じなくてお店やってけるの?」<NEWLINE>");
  speak(Entity(5), "「まあけいけんと身ぶりでね。<NEWLINE> でも、やはりつらいときもありますよ。<NEWLINE> 売り上げはなかなかのびないし…」<NEWLINE>");
  speak(Entity.Player, "「なるほどなー。」<NEWLINE>");
  speak(Entity(5), "「最近はマンネリのうえ、前は来てた<NEWLINE> お客さんも、来なくなってきてね…」<NEWLINE>");
  speak(Entity.Player, "「(島の異変のせいだな……)」<NEWLINE>");
  speak(Entity(5), "「そこで君に、ちょっと協力してほしい<NEWLINE> ことがあるんだがね。」<NEWLINE>");
  speak(Entity.Player, "「何だ?」<NEWLINE>");
  speak(Entity(5), "「うちの店で働いてみないかね?」<NEWLINE>");
  speak(Entity.Player, "「え、店で?」<NEWLINE>");
  speak(Entity(5), "「半日でいいんだ。賃金は売り上げに応じて<NEWLINE> 上げる。君なら言葉もわかるし、なにか<NEWLINE> 才能がある気がしてね。」<NEWLINE>");
  speak(Entity.Player, "「んー。そんしても知らないよ…」<NEWLINE>");
  speak(Entity(5), "「そういう心配はいいよ。どんな結果に<NEWLINE> なっても参考になると思うから。<NEWLINE> 8時間ほどだが、やってくれるかい?」<NEWLINE>");
  loop {
    setDialogOwner(Entity.Player);
    setSelection(L1, L2);
    showTextbox("「やってみる。」<NEWLINE>「今ちょっと余裕が無い。」<NEWLINE>");
    waitForSelectionChoice();
    goto L2;

L1:
    fadeOutHUD();
    move(entity: Entity(5), to: (133, 292), sprint: 0);
    move(entity: Entity.Player, to: (-980, -432), sprint: 0);
    waitForEntity(Entity.Player);
    waitForEntity(Entity(5));
    setPStat(PStat(247), 9);
    setPStat(PStat(248), 12);
    callSubroutine(21);
    setObjectsVisibleRange(33, 35, 1);
    setObjectsVisibleRange(9, 20, 0);
    look(entity: Entity(5), at: Entity.Player);
    move(entity: Entity.Player, to: (-980, 292), sprint: 0);
    move(entity: Entity.Partner, to: (-980, -432), sprint: 0);
    waitForPair();
    look(entity: Entity(5), at: Entity.Player);
    move(entity: Entity.Player, to: (-341, 292), sprint: 0);
    move(entity: Entity.Partner, to: (-980, 292), sprint: 0);
    waitForPair();
    setPStat(PStat(247), 21);
    setPStat(PStat(248), 12);
    callSubroutine(21);
    setObjectsVisibleRange(9, 20, 1);
    setObjectsVisibleRange(21, 32, 0);
    delay(60);
    rotate(entity: Entity.Player, to: 0);
    look(entity: Entity.Partner, at: Entity.Player);
    waitForEntity(Entity.Player);
    setObjectsVisibleRange(21, 32, 1);
    setObjectsVisibleRange(33, 35, 0);
    callSubroutine(30);
    setPStat(PStat(123), 0);
    unsetTrigger(Trigger(101));
    goto section_82;

L2:
    speak(Entity(5), "「そうか…それは仕方ない。余裕が<NEWLINE> できたら、また来てくれないかな。」<NEWLINE>");
    return;

L3:
    speak(Entity(5), "「おっ、アルバイトやる気になったかい?」<NEWLINE>");
  }
  return;
}

section(82) {
  if (pstat[123] >= 20) {
  } else {
    if (pstat[123] >= 10 && !trigger(101)) {
      setTrigger(Trigger(101));
      speak(Entity(5), "「ふむ、今ちょうど半分すぎた<NEWLINE> ところだね。」<NEWLINE>");
      look(entity: Entity(5), at: Entity.Player);
      look(entity: Entity.Player, at: Entity(5));
      delay(10);
      goto L1;
    }
    loop {
      roll(pstat: PStat.RollScratch, max: 8);
      if (pstat[110] <= 2) {
        jumpToScriptSection(170, 51);
      }
      if (pstat[110] <= 5) {
        jumpToScriptSection(171, 51);
      }
      if (pstat[110] <= 7) {
        jumpToScriptSection(172, 51);
      }
      jumpToScriptSection(173, 51);
      return;

L1:
      callSubroutine(56);
      if (pstat[243] <= 2) {
        speak(Entity(5), "「うむ、今の感じでは…<NEWLINE> もうけがでないかもしれないよ。<NEWLINE> がんばってくれ。」<NEWLINE>");
        rotate(entity: Entity.Player, to: 80);
        fadeOutHUD();
        continue;
      }
      if (pstat[243] <= 5) {
        speak(Entity(5), "「ふむ、まあまあ好調な売りあげだね。<NEWLINE> これならもうけが出そうかな。」<NEWLINE>");
        rotate(entity: Entity.Player, to: 80);
        fadeOutHUD();
        continue;
      }
      speak(Entity(5), "「ふーむ!こんなに売れゆきがいいのは<NEWLINE> めったにないことだよ。<NEWLINE> この調子で最後までいこう。」<NEWLINE>");
      rotate(entity: Entity.Player, to: 80);
      fadeOutHUD();
    }
  }
  delay(40);
  speak(Entity(5), "「さて、時間が来たようだ。」<NEWLINE>");
  callSubroutine(56);
  if (pstat[243] <= 6) {
    speak(Entity(5), "「うーむ、もう少しやれると思ってたんだが<NEWLINE> まあ、運が悪いとダメな日もあるし…。<NEWLINE> また頼むよ。」<NEWLINE>");
    addMoney(500);
    speak(Entity.System, "500<B><it>てにいれた!<NEWLINE>");
    pstat[:SavedTime] = time();
    addMinutesToDate(PStat.SavedTime, 480);
    advanceToDate(PStat.SavedTime);
    warp(to: Map.GCAN09, spawn: 2, trigger: 255);
    return;
  }
  if (pstat[243] <= 11) {
    speak(Entity(5), "「うん、思った通りの売り上げだよ。<NEWLINE> でも君の実力からするとまだまだ<NEWLINE> ものたりないね。また頼むよ。」<NEWLINE>");
    addMoney(1500);
    speak(Entity.System, "1500<B><it>てにいれた!<NEWLINE>");
    pstat[:SavedTime] = time();
    addMinutesToDate(PStat.SavedTime, 480);
    advanceToDate(PStat.SavedTime);
    warp(to: Map.GCAN09, spawn: 2, trigger: 255);
    return;
  }
  speak(Entity(5), "「さすがと言うほか無いね。君の知恵、<NEWLINE> やる気、人徳は島を救うのにじゅうぶん<NEWLINE> だと言える。」<NEWLINE>");
  speak(Entity.Player, "「えっ?」<NEWLINE>");
  speak(Entity(5), "「すまない。私は君をテストした。<NEWLINE> 島を救うのにじゅうぶんな器かどうか。<NEWLINE> 確かに、戦闘に強いことは重要だよ。」<NEWLINE>");
  speak(Entity(5), "「だが、力にくわえて知恵や勇気が無いと<NEWLINE> 島を救うのは難しいだろうと私は考えて<NEWLINE> いたんだ。だまっていてすまなかった。」<NEWLINE>");
  speak(Entity.Player, "「で、俺達は合格なのか?」<NEWLINE>");
  speak(Entity(5), "「全く想像以上だ。今後は私は君たちの<NEWLINE> ために全力で協力させてもらう。」<NEWLINE>");
  speak(Entity.Player, "「じゃあ、街に来てくれるんだな。<NEWLINE> ん?このお店はどうするんだ?」<NEWLINE>");
  speak(Entity(5), "「なに、店などいつでも建てられる。<NEWLINE> この店は役目を終えたよ。」<NEWLINE>");
  playSound(8, 10);
  speak(Entity.System, "モノクロモンが街に参加した!!!<NEWLINE>");
  showTextbox("2000<B><it>てにいれた!<NEWLINE>");
  addMoney(2000);
  addPStat(PStat(1), 2);
  setTrigger(Trigger(247));
  pstat[:SavedTime] = time();
  addMinutesToDate(PStat.SavedTime, 480);
  advanceToDate(PStat.SavedTime);
  warp(to: Map.GCAN09, spawn: 2, trigger: 255);
  return;
  garbage { 10 00 fe 00 10 00 51 00 22 00 52 00 fc 05 ff ff 19 00 01 00 f7 00 18 00 20 00 19 00 56 00 05 1c fe 00 19 00 00 00 f7 00 18 00 30 00 19 00 fe 00 4c 00 fd 05 19 00 00 00 88 00 18 00 44 00 19 00 16 00 c6 05 1c 00 88 00 1b 05 1a 00 81 75 82 a2 82 e7 82 c1 82 b5 82 e1 82 a2 81 63 82 a8 82 e2 81 48 0d 00 81 40 82 a8 8b 71 82 b3 82 f1 81 41 8f 89 82 df 82 c4 82 dd 82 e9 82 af 82 c7 81 41 89 93 82 ad 82 a9 82 e7 81 48 81 76 0d 00 00 00 1b fd 1a 00 81 75 8a 58 82 a9 82 e7 97 88 82 bd 81 42 82 a2 82 e2 81 41 8c b3 82 cd 95 ca 90 a2 8a 45 82 a9 82 e7 82 a9 81 42 81 76 0d 00 00 00 1b 05 1a 00 81 75 8e 84 82 cc 8c be 97 74 82 aa 82 ed 82 a9 82 e9 82 f1 82 c5 82 b7 82 c8 81 42 81 76 0d 00 00 00 1b fd 1a 00 81 75 82 bb 82 e8 82 e1 81 63 82 a0 81 41 93 96 82 bd 82 e8 91 4f 81 63 82 b6 82 e1 82 c8 82 a2 82 cc 82 a9 82 9f 81 63 81 42 0d 00 81 40 8c be 97 74 82 aa 92 ca 82 b6 82 c8 82 ad 82 c4 82 a8 93 58 82 e2 82 c1 82 c4 82 af 82 e9 82 cc 81 48 81 76 0d 00 00 00 1b 05 1a 00 81 75 82 dc 82 a0 82 af 82 a2 82 af 82 f1 82 c6 90 67 82 d4 82 e8 82 c5 82 cb 81 42 0d 00 81 40 82 c5 82 e0 81 41 82 e2 82 cd 82 e8 82 c2 82 e7 82 a2 82 c6 82 ab 82 e0 82 a0 82 e8 82 dc 82 b7 82 e6 81 42 0d 00 81 40 94 84 82 e8 8f e3 82 b0 82 cd 82 c8 82 a9 82 c8 82 a9 82 cc 82 d1 82 c8 82 a2 82 b5 81 63 81 76 0d 00 00 00 1b fd 1a 00 81 75 82 c8 82 e9 82 d9 82 c7 82 c8 81 5b 81 42 81 76 0d 00 00 00 1b 05 1a 00 81 75 8d c5 8b df 82 cd 83 7d 83 93 83 6c 83 8a 82 cc 82 a4 82 a6 81 41 91 4f 82 cd 97 88 82 c4 82 bd 0d 00 81 40 82 a8 8b 71 82 b3 82 f1 82 e0 81 41 97 88 82 c8 82 ad 82 c8 82 c1 82 c4 82 ab 82 c4 82 cb 81 63 81 76 0d 00 00 00 1b fd 1a 00 81 75 81 69 93 87 82 cc 88 d9 95 cf 82 cc 82 b9 82 a2 82 be 82 c8 81 63 81 63 81 6a 81 76 0d 00 00 00 1b 05 1a 00 81 75 82 bb 82 b1 82 c5 8c 4e 82 c9 81 41 82 bf 82 e5 82 c1 82 c6 8b a6 97 cd 82 b5 82 c4 82 d9 82 b5 82 a2 0d 00 81 40 82 b1 82 c6 82 aa 82 a0 82 e9 82 f1 82 be 82 aa 82 cb 81 42 81 76 0d 00 00 00 1b fd 1a 00 81 75 89 bd 82 be 81 48 81 76 0d 00 00