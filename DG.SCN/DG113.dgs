// DG113.SCN
#include "functions.dgs"
#pragma script index=113 start=0x51000 end=0x52000 headerU16=0x38 sentinelOff=0x24
#include "entities.dgs"

section onEnter(254) {
  spawnItemChance(max: 99, chance: 19, item: Item.Digimushroom, x: 37, y: 84);
  spawnItemChance(max: 99, chance: 16, item: Item.Digimushroom, x: 33, y: 67);
  spawnItemChance(max: 99, chance: 12, item: Item.Digimushroom, x: 56, y: 63);
  spawnItemChance(max: 99, chance: 2, item: Item.Digipine, x: 56, y: 83);
  return;
}

section(6) {
  speak(Entity(6), "Go straight ahead and\nmake a right. He he he...\n");
  finishEncounter(Trigger(280));
}

section(7) {
  speak(Entity(7), "Make a right and\na quick left. He he...\n");
  finishEncounter(Trigger(280));
}

section(8) {
  speak(Entity(8), "You won't get out of\nthis forest. He he he...\n");
  finishEncounter(Trigger(280));
}

section(9) {
  speak(Entity(9), "I got lost!\n");
  finishEncounter(Trigger(291));
}

section(10) {
  speak(Entity(10), "Lately, I've been tired.\n");
  finishEncounter(Trigger(291));
}

section(11) {
  speak(Entity(11), "You? No way!?\n");
  finishEncounter(Trigger(280));
}

section(12) {
  speak(Entity(12), "Be careful where you walk.\n");
  finishEncounter(Trigger(280));
}

section(5) {
  playSound(8, 11);
  speak(Entity(5), "Hey you!\n");
  setTrigger(Trigger(1));
  setPStat(PStat(250), 1);
  setPStat(PStat(251), 5);
  setPStat(PStat(252), 255);
  setPStat(PStat(253), 255);
  startBattle();
  unsetTrigger(Trigger(1));
  setPStat(PStat(250), 0);
  look(entity: Entity(5), at: Entity.Player);
  lookPairAt(Entity(5));
  delay(10);
  speak(Entity(5), "Hmm, you're something else!\nThat was pretty good for\nso early in the morning.\n");
  anim(Entity.Player, Animation(16), wait: 20);
  speak(Entity.Player, "Hey, hey, don't act like it's\nsomebody else's business!\n");
  speak(Entity(5), "I know! I know what you're\ntalking about.\n");
  showTextbox("I hear you're working\nhard for the island\nby gathering Digimons.\n");
  anim(Entity.Player, Animation(19), wait: 20);
  speak(Entity.Player, "So you know. Well,\nwhy don't you help me.\n");
  speak(Entity(5), "And, where am I supposed\nto do what?\n");
  anim(Entity.Player, Animation(7), wait: 20);
  speak(Entity.Player, "Oh you just don't get it!\nYou're supposed to work\nin the city, remember?!\n");
  speak(Entity(5), "Well, like they say...\nthe early bird gets the bug.\n");
  anim(Entity.Player, Animation(7), wait: 20);
  speak(Entity.Player, "That has nothing to do with\nanything! On top of that,\nit's a worm not a bug!\n");
  anim(Entity.Partner, Animation(11), wait: 5);
  speak(Entity(5), "I'm just joking. Well,\nI'll see you in the city...\n");
  fadeOutHUD();
  goto L1;

L1:
  approach(who: Entity(5), x: -330, y: -2751, tries: 10, wait: 10);
  playSound(8, 10);
  speak(Entity.System, "Kokatorimon joins the city!\n");
  anim(Entity.Player, Animation(16), wait: 20);
  speak(Entity.Player, "Can we really trust him?\nI wonder...\n");
  followEntity(Entity.Player, speed: 10);
  setTrigger(Trigger(250));
  addPStat(PStat(1), 2);
  return;
}

section(54) {
  anim(Entity.Player, Animation(24), wait: 20);
  speak(Entity.Player, "Hey, a bird's feathers are\nfallen here. They are still\nfresh. Are we too late?\n");
  return;
}

section(52) {
  pstat[:SavedTime] = time();
  if (!trigger(174) && !trigger(250) && pstat[107] >= 4 && pstat[107] <= 6) {
    setDigimon(Digimon.Devimon, Entity(0), 1);
    setTrigger(Trigger(174));
  }
  return;
}

section(51) {
  move(entity: Entity.Player, to: (-2500, -2900), sprint: 0);
  if (trigger(114) || trigger(147)) {
    warp(to: Map.MIST02, spawn: 1, trigger: 255);
  }
  roll(pstat: PStat.RollScratch, max: 99);
  if (pstat[110] < 49) {
    warp(to: Map.MIST02, spawn: 1, trigger: 255);
    goto section_53;
  }
  warp(to: Map.MIST07, spawn: 2, trigger: 255);
}

section(53) {
  move(entity: Entity.Player, to: (2600, -2550), sprint: 0);
  if (trigger(114) || trigger(147)) {
    warp(to: Map.MIST07, spawn: 0, trigger: 255);
  }
  roll(pstat: PStat.RollScratch, max: 99);
  if (pstat[110] < 69) {
    warp(to: Map.MIST07, spawn: 0, trigger: 255);
  } else {
    warp(to: Map.MIST02, spawn: 0, trigger: 255);
  }
  garbage { 38 00 fe 00 38 00 06 00 92 00 07 00 06 01 08 00 6a 01 09 00 da 01 0a 00 06 02 0b 00 4c 02 0c 00 7c 02 05 00 c6 02 36 00 d4 08 34 00 82 09 33 00 a6 09 35 00 de 09 ff ff 24 00 6e 63 19 00 0b 00 6e 13 18 00 4e 00 19 00 74 2c 25 00 54 00 24 00 6e 63 19 00 0b 00 6e 10 18 00 64 00 19 00 74 2c 21 00 43 00 24 00 6e 63 19 00 0b 00 6e 0c 18 00 7a 00 19 00 74 2c 38 00 3f 00 24 00 6e 63 19 00 0b 00 6e 02 18 00 90 00 19 00 74 2f 38 00 53 00 fe 00 1b 06 1a 00 82 66 82 8f 81 40 82 93 82 94 82 92 82 81 82 89 82 87 82 88 82 94 81 40 82 81 82 88 82 85 82 81 82 84 81 40 82 81 82 8e 82 84 0d 00 82 8d 82 81 82 8b 82 85 81 40 82 81 81 40 82 92 82 89 82 87 82 88 82 94 81 42 81 40 82 67 82 85 81 40 82 88 82 85 81 40 82 88 82 85 81 42 81 42 81 42 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 18 01 fe 00 1b 07 1a 00 82 6c 82 81 82 8b 82 85 81 40 82 81 81 40 82 92 82 89 82 87 82 88 82 94 81 40 82 81 82 8e 82 84 0d 00 82 81 81 40 82 91 82 95 82 89 82 83 82 8b 81 40 82 8c 82 85 82 86 82 94 81 42 81 40 82 67 82 85 81 40 82 88 82 85 81 42 81 42 81 42 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 18 01 fe 00 1b 08 1a 00 82 78 82 8f 82 95 81 40 82 97 82 8f 82 8e 81 75 82 94 81 40 82 87 82 85 82 94 81 40 82 8f 82 95 82 94 81 40 82 8f 82 86 0d 00 82 94 82 88 82 89 82 93 81 40 82 86 82 8f 82 92 82 85 82 93 82 94 81 42 81 40 82 67 82 85 81 40 82 88 82 85 81 40 82 88 82 85 81 42 81 42 81 42 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 18 01 fe 00 1b 09 1a 00 82 68 81 40 82 87 82 8f 82 94 81 40 82 8c 82 8f 82 93 82 94 81 49 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 23 01 fe 00 1b 0a 1a 00 82 6b 82 81 82 94 82 85 82 8c 82 99 81 43 81 40 82 68 81 75 82 96 82 85 81 40 82 82 82 85 82 85 82 8e 81 40 82 94 82 89 82 92 82 85 82 84 81 42 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 23 01 fe 00 1b 0b 1a 00 82 78 82 8f 82 95 81 48 81 40 82 6d 82 8f 81 40 82 97 82 81 82 99 81 49 81 48 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 18 01 fe 00 1b 0c 1a 00 82 61 82 85 81 40 82 83 82 81 82 92 82 85 82 86 82 95 82 8c 81 40 82