// DG113.SCN
#include "functions.dgs"
#pragma script index=113 start=0x4b800 end=0x4c000 headerU16=0x30 sentinelOff=0x24
#include "entities.dgs"

section onEnter(254) {
  spawnItemChance(max: 99, chance: 4, item: Item.Digimushroom, x: 35, y: 19);
  spawnItemChance(max: 99, chance: 16, item: Item.Digimushroom, x: 55, y: 50);
  spawnItemChance(max: 99, chance: 6, item: Item.Digimushroom, x: 47, y: 4);
  spawnItemChance(max: 99, chance: 3, item: Item.Digipine, x: 40, y: 45);
  setTrigger(Trigger(112));
  return;
}

section(5) {
  speak(Entity(5), "「誰だ?」<NEWLINE>");
  finishEncounter(Trigger(289));
}

section(6) {
  speak(Entity(6), "「いきまーーーす!なんてな。」<NEWLINE>");
  finishEncounter(Trigger(289));
}

section(7) {
  speak(Entity(7), "「ガハハハハ、ゆかいゆかい。」<NEWLINE>");
  finishEncounter(Trigger(289));
}

section(8) {
  speak(Entity(8), "「うほーっ、はりきっちゃうね。」<NEWLINE>");
  finishEncounter(Trigger(280));
}

section(9) {
  speak(Entity(9), "「マジかよっ!」<NEWLINE>");
  finishEncounter(Trigger(280));
}

section(10) {
  speak(Entity(10), "「おいおい、本気かよっ?」<NEWLINE>");
  finishEncounter(Trigger(289));
}

section(11) {
  speak(Entity(11), "「だまれ、だまれ~!」<NEWLINE>");
  finishEncounter(Trigger(296));
}

section(12) {
  speak(Entity(12), "「ボクだって、やる時はやるんだぞ!」<NEWLINE>");
  finishEncounter(Trigger(296));
}

section(51) {
  move(entity: Entity.Player, to: (-1700, -1800), sprint: 0);
  if (trigger(114) || trigger(147)) {
    warp(to: Map.MIST03, spawn: 1, trigger: 255);
  }
  roll(pstat: PStat.RollScratch, max: 99);
  if (pstat[110] < 69) {
    warp(to: Map.MIST03, spawn: 1, trigger: 255);
    goto section_52;
  }
  warp(to: Map.MIST04, spawn: 1, trigger: 255);
}

section(52) {
  move(entity: Entity.Player, to: (-2600, 4000), sprint: 0);
  if (trigger(114) || trigger(147)) {
    warp(to: Map.MIST05, spawn: 1, trigger: 255);
  }
  addPStat(PStat(120), 1);
  if (pstat[120] == 10) {
    setPStat(PStat(120), 0);
    warp(to: Map.MIST05, spawn: 1, trigger: 255);
  }
  roll(pstat: PStat.RollScratch, max: 99);
  if (pstat[110] < 69) {
    warp(to: Map.MIST03, spawn: 1, trigger: 255);
  } else {
    warp(to: Map.MIST07, spawn: 2, trigger: 255);
  }
