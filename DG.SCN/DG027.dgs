// DG027.SCN
#include "functions.dgs"
#pragma script index=27 start=0x18000 end=0x18800 headerU16=0xc sentinelOff=0x19
#include "entities.dgs"

section onEnter(254) {
  if (!trigger(140)) {
    playAnimation(Entity(5), Animation(28));
  }
  return;
}

section(5) {
  if (trigger(234)) {
    speak(Entity(5), "「入り口のカンバンはもとにもどして<NEWLINE> おいたよ。ったく…」<NEWLINE>");
    return;
  }
  {
    if (!trigger(140)) {
    } else {
      break;
    }
    {
      playAnimation(Entity(5), Animation(28));
      playSound(8, 10);
      speak(Entity(5), "「あつい!暑い!!熱~い!!!<NEWLINE> 何とかしてくれ~!」<NEWLINE>");
      playAnimation(Entity(5), Animation(28));
      anim(Entity.Player, Animation(16), wait: 20);
      speak(Entity.Player, "「なんだよいったい…」<NEWLINE>");
      playSound(8, 10);
      speak(Entity(5), "「熱いんだよ!もうたえられねー!」<NEWLINE>");
      setTrigger(Trigger(1));
      setPStat(PStat(250), 1);
      setPStat(PStat(251), 5);
      setPStat(PStat(252), 255);
      setPStat(PStat(253), 255);
      startBattle();
      unsetTrigger(Trigger(1));
      setPStat(PStat(250), 0);
      look(entity: Entity.Player, at: Entity(5));
      look(entity: Entity(5), at: Entity.Player);
      look(entity: Entity.Partner, at: Entity(5));
      speak(Entity(5), "「わ、わりぃ、どうにも熱くて変になってた<NEWLINE> みてえだ。」<NEWLINE>");
      anim(Entity.Player, Animation(25), wait: 20);
      speak(Entity.Player, "「たしかに熱いけど…」<NEWLINE>");
      speak(Entity(5), "「ここのトンネルはよ…掘れば掘るほど<NEWLINE> 熱くなってきて…火山の中だから当たり前<NEWLINE> なんだがな。」<NEWLINE>");
      speak(Entity(5), "「でも最近はそんだけじゃねえみたいなんだ。<NEWLINE> なんかよ、急~激に熱いんだ。<NEWLINE> 炎がおこってるっていうのかな…」<NEWLINE>");
      anim(Entity.Player, Animation(16), wait: 20);
      speak(Entity.Player, "「ふーむ。」<NEWLINE>");
      speak(Entity(5), "「けっきょくはガマンして掘るしかねえ。<NEWLINE> ま、がんばってみるわ。」<NEWLINE>");
      anim(Entity.Player, Animation(19), wait: 20);
      speak(Entity.Player, "「そうか。俺達も何か原因を調べてみるよ。<NEWLINE> このトンネルが開通してくれると<NEWLINE> 助かるし。」<NEWLINE>");
      speak(Entity(5), "「おめえ、いいヤツだなあ。よーし、<NEWLINE> トンネル掘りは急いでやるからな!」<NEWLINE>");
      delay(10);
      playAnimation(Entity.Player, Animation(0));
      break;
    }
    loop {
      move(entity: Entity(5), to: (1061, -767), sprint: 0);
      if (pstat[101] >= 3) break;
      addPStat(PStat.LoopIterator, 1);
      delay(20);
      lookPairAt(Entity(5));
    }
    setPStat(PStat.LoopIterator, 0);
    waitForEntity(Entity(5));
    followEntity(Entity.Player, speed: 10);
    setTrigger(Trigger(140));
    return;
  }
  speak(Entity(5), "「今日は俺っち、メシたんとう。」<NEWLINE>");
  return;
  garbage { 0c 00 fe 00 0c 00 05 00 1e 00 ff ff 19 00 01 00 8c 00 18 00 1c 00 19 00 56 00 05 1c fe 00 19 00 00 00 ea 00 18 00 6e 00 19 00 1b 05 1a 00 81 75 93 fc 82 e8 8c fb 82 cc 83 4a 83 93 83 6f 83 93 82 cd 82 e0 82 c6 82 c9 82 e0 82 c7 82 b5 82 c4 0d 00 81 40 82 a8 82 a2 82 bd 82 e6 81 42 82 c1 82 bd 82 ad 81 63 81 76 0d 00 00 00 fe 00 19 00 01 00 8c 00 18 00 7e 00 19 00 16 00 82 00 16 00 fa 03 56 00 05 1c 5a 00 08 0a 1b 05 1a 00 81 75 82 a0 82 c2 82 a2 81 49 8f 8b 82 a2 81 49 81 49 94 4d 81 60 82 a2 81 49 81 49 81 49 0d 00 81 40 89 bd 82 c6 82 a9 82 b5 82 c4 82 ad 82 ea 81 60 81 49 81 76 0d 00 00 00 56 00 05 1c 56 00 fd 10 67 00 14 00 1b fd 1a 00 81 75 82 c8 82 f1 82 be 82 e6 82 a2 82 c1 82 bd 82 a2 81 63 81 76 0d 00 00 00 5a 00 08 0a 1b 05 1a 00 81 75 94 4d 82 a2 82 f1 82 be 82 e6 81 49 82 e0 82 a4 82 bd 82 a6 82 e7 82 ea 82 cb 81 5b 81 49 81 76 0d 00 00 00 1c 00 01 00 1e 00 fa 01 1e 00 fb 05 1e 00 fc ff 1e 00 fd ff 27 00 67 00 01 00 66 00 1d 00 01 00 1e 00 fa 00 4c 00 fd 05 4c 00 05 fd 4c 00 fc 05 1b 05 1a 00 81 75 82 ed 81 41 82 ed 82 e8 82 a1 81 41 82 c7 82 a4 82 c9 82 e0 94 4d 82 ad 82 c4 95 cf 82 c9 82 c8 82 c1 82 c4 82 bd 0d 00 81 40 82 dd 82 c4 82 a6 82 be 81 42 81 76 0d 00 00 00 56 00 fd 19 67 00 14 00 1b fd 1a 00 81 75 82 bd 82 b5 82 a9 82 c9 94 4d 82 a2 82 af 82 c7 81 63 81 76 0d 00 00 00 1b 05 1a 00 81 75 82 b1 82 b1 82 cc 83 67 83 93 83 6c 83 8b 82 cd 82 e6 81 63 8c 40 82 ea 82 ce 8c 40 82 e9 82 d9 82 c7 0d 00 81 40 94 4d 82 ad 82 c8 82 c1 82 c4 82 ab 82 c4 81 63 89 ce 8e 52 82 cc 92 86 82 be 82 a9 82 e7 93 96 82 bd 82 e8 91 4f 0d 00 81 40 82 c8 82 f1 82 be 82 aa 82 c8 81 42 81 76 0d 00 00 00 1b 05 1a 00 81 75 82 c5 82 e0 8d c5 8b df 82 cd 82 bb 82 f1 82 be 82 af 82 b6 82 e1 82 cb 82 a6 82 dd 82 bd 82 a2 82 c8 82 f1 82 be 81 42 0d 00 81 40 82 c8 82 f1 82 a9 82 e6 81 41 8b 7d 81 60 8c 83 82 c9 94 4d 82 a2 82 f1 82 be 81 42 0d 00 81 40 89 8a 82 aa 82 a8 82 b1 82 c1 82 c4 82 e9 82 c1 82 c4 82 a2 82 a4 82 cc 82 a9 82 c8 81 63 81 76 0d 00 00 00 56 00 fd