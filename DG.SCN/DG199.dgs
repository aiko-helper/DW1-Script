L42:
    roll(pstat: 110, max: 99);
    if (pstat[110] <= 84) {
      goto L47;
    }
    goto L48;

L43:
    roll(pstat: 110, max: 99);
    if (pstat[110] <= 94) {
      goto L47;
    }
    goto L48;

L44:
    roll(pstat: 110, max: 99);
    if (pstat[110] <= 96) {
      goto L47;
    }
    goto L48;

L45:
    roll(pstat: 110, max: 99);
    if (pstat[110] <= 98) {
      goto L47;
    }
    goto L48;

L46:
    roll(pstat: 110, max: 99);
    if (pstat[110] <= 99) {
      goto L47;
    }
    goto L48;

L47:
    speak(6, "Okay! I'll take it.\n");
    sfx(8, 6, wait: 10);
    setTextboxSize(12, 3);
    if (pstat[117] == 1) {
      setPStat(243, 3);
      setPStat(244, 32);
      callSubroutine(31);
      showTextbox("Total Profit: <DISCOUNT>\nProfit:\neight hundred\n");
    }
    if (pstat[117] == 2) {
      setPStat(243, 2);
      setPStat(244, 188);
      callSubroutine(31);
      showTextbox("Total Profit: <DISCOUNT>\nProfit:\nseven hundred\n");
    }
    if (pstat[117] == 3) {
      setPStat(243, 2);
      setPStat(244, 88);
      callSubroutine(31);
      showTextbox("Total Profit: <DISCOUNT>\nProfit:\nsix hundred\n");
    }
    if (pstat[117] == 4) {
      setPStat(243, 1);
      setPStat(244, 244);
      callSubroutine(31);
      showTextbox("Total Profit: <DISCOUNT>\nProfit:\nfive hundred\n");
    }
    if (pstat[117] == 5) {
      setPStat(243, 1);
      setPStat(244, 144);
      callSubroutine(31);
      showTextbox("Total Profit: <DISCOUNT>\nProfit:\nfour hundred\n");
    }
    if (pstat[117] == 6) {
      setPStat(243, 1);
      setPStat(244, 44);
      callSubroutine(31);
      showTextbox("Total Profit: <DISCOUNT>\nProfit:\nthree hundred\n");
    }
    if (pstat[117] == 7) {
      setPStat(243, 0);
      setPStat(244, 200);
      callSubroutine(31);
      showTextbox("Total Profit: <DISCOUNT>\nProfit:\ntwo hundred\n");
    }
    if (pstat[117] == 8) {
      setPStat(243, 0);
      setPStat(244, 100);
      callSubroutine(31);
      showTextbox("Total Profit: <DISCOUNT>\nProfit:\none hundred\n");
    }
    if (pstat[117] == 9) {
      showTextbox("Total Profit: <DISCOUNT>\nProfit:\nzero\n");
    }
    goto L14;

L48:
    setPStat(247, 6);
    setPStat(248, 5);
    callSubroutine(28);
    addPStat(119, 1);
    roll(pstat: 110, max: 99);
    if (pstat[110] <= 49 && pstat[119] >= 3) {
      goto L16;
    }
    if (pstat[110] <= 14 && pstat[119] == 2) {
      goto L16;
    }
    if (pstat[110] <= 4 && pstat[119] == 1) {
      goto L16;
    }
    goto L49;

L49:
    speak(6, "You charge too much.\n");
    speak(Entity.Player, "Really? Well then...\n");
  }
