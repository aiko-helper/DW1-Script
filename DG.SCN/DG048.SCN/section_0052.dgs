// source: extract/DIGIMON/SCN/DG.SCN
// DG048.SCN, section 52

section section_52(52) {  // len=1022
    if (trigger(175)) goto L_0010;
    goto L_0012;
L_0010:
    return;
L_0012:
    moveCamera(to: (40, 2922), slowdown: 30);
    waitForEntity(200);
    look(entity: Entity.Player, at: 7);
    look(entity: Entity.Partner, at: 7);
    playAnimation(Entity.Player, 7);
    delay(15);
    setDialogOwner(Entity.Player);
    showTextbox("Hey!\n");
    playAnimation(Entity.Player, 0);
    look(entity: 7, at: Entity.Player);
    look(entity: 8, at: Entity.Player);
    look(entity: 9, at: Entity.Player);
    setDialogOwner(7);
    showTextbox("What?\n");
    showTextbox("Did you come here to lose?\n");
    playSound(8, 11);
    playAnimation(Entity.Player, 20);
    delay(15);
    setDialogOwner(Entity.Player);
    showTextbox("That's my line!\n");
    playAnimation(Entity.Player, 0);
    setDialogOwner(7);
    showTextbox("I'm holding nothing back\nthis time. I'll make you cry!\n");
    setTrigger(1);
    setPStat(250, 1);
    setPStat(251, 7);
    setPStat(252, 8);
    setPStat(253, 9);
    fadeOutHUD();
    delay(1);
    startBattle();
    unsetTrigger(1);
    setPStat(250, 0);
    look(entity: Entity.Player, at: 7);
    look(entity: 7, at: Entity.Player);
    look(entity: Entity.Partner, at: 7);
    setDialogOwner(8);
    showTextbox("Wow!\n");
    setDialogOwner(9);
    showTextbox("Oh no!\n");
    move(entity: 8, to: (224, -784), sprint: 1);
    move(entity: 9, to: (116, -784), sprint: 1);
    waitForEntity(8);
    waitForEntity(9);
    unloadEntity(8);
    unloadEntity(9);
    setDialogOwner(7);
    showTextbox("Darn it!\n");
    playAnimation(7, 46);
    delay(30);
    playSound(8, 9);
    setObjectVisibility(0, 0);
    setObjectVisibility(1, 0);
    setObjectVisibility(2, 0);
    setObjectVisibility(3, 0);
    setObjectVisibility(4, 0);
    setObjectVisibility(5, 0);
    setObjectVisibility(6, 0);
    setObjectVisibility(7, 0);
    setObjectVisibility(8, 0);
    setObjectVisibility(9, 0);
    setObjectVisibility(10, 0);
    setObjectVisibility(11, 0);
    setObjectVisibility(12, 0);
    setObjectVisibility(13, 0);
    setObjectVisibility(14, 0);
    setObjectVisibility(15, 0);
    setObjectVisibility(16, 0);
    setObjectVisibility(17, 0);
    setObjectVisibility(18, 0);
    setObjectVisibility(19, 0);
    setObjectVisibility(20, 0);
    setObjectVisibility(21, 0);
    setObjectVisibility(22, 0);
    setObjectVisibility(23, 0);
    setObjectVisibility(24, 0);
    setObjectVisibility(25, 0);
    delay(40);
    setPStat(254, 40);
    callSubroutine(45);
    delay(40);
    unloadEntity(7);
    playAnimation(Entity.Player, 24);
    delay(15);
    setDialogOwner(Entity.Player);
    showTextbox("What is it?\n");
    playAnimation(Entity.Player, 0);
    setObjectVisibility(0, 1);
    setObjectVisibility(1, 1);
    setObjectVisibility(2, 1);
    setObjectVisibility(3, 1);
    setObjectVisibility(4, 1);
    setObjectVisibility(5, 1);
    setObjectVisibility(6, 1);
    setObjectVisibility(7, 1);
    setObjectVisibility(8, 1);
    setObjectVisibility(9, 1);
    setObjectVisibility(10, 1);
    setObjectVisibility(11, 1);
    setObjectVisibility(12, 1);
    setObjectVisibility(13, 1);
    setObjectVisibility(14, 1);
    setObjectVisibility(15, 1);
    setObjectVisibility(16, 1);
    setObjectVisibility(17, 1);
    setObjectVisibility(18, 1);
    setObjectVisibility(19, 1);
    setObjectVisibility(20, 1);
    setObjectVisibility(21, 1);
    setObjectVisibility(22, 1);
    setObjectVisibility(23, 1);
    setObjectVisibility(24, 1);
    setObjectVisibility(25, 1);
    setDigimon(Digimon.NPCOgremon, 5, 0);
    rotate(entity: 10, to: 0);
    moveObjectTo(0, 45, 1, 10, 0, 385, -50);
    delay(10);
    callSubroutine(46);
    delay(40);
    playSound(8, 11);
    setDialogOwner(10);
    showTextbox("Bye, dumb guys!\n");
    look(entity: Entity.Player, at: 10);
    playSound(8, 5);
    waitForEntity(10);
    unloadEntity(10);
    setTrigger(176);
    setDialogOwner(Entity.Player);
    showTextbox("Darn, he got away!\n");
    move(entity: Entity.Player, to: (1234, 2267), sprint: 1, withCamera: true);
    move(entity: Entity.Partner, to: (774, 2251), sprint: 1);
    waitForEntity(Entity.Player);
    waitForEntity(Entity.Partner);
    rotate(entity: Entity.Player, to: 2037);
    rotate(entity: Entity.Partner, to: 2300);
    setDialogOwner(Entity.Player);
    showTextbox("There is an escape elevator.\nChasing him will do no good.\n");
    setTrigger(175);
    moveCamera(to: Entity.Player, speed: 10);
    waitForEntity(200);
    return;
}
