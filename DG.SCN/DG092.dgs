// DG092.SCN
#include "functions.dgs"
#pragma script index=92 start=0x41000 end=0x41800 headerU16=0x1c sentinelOff=0x24
#include "entities.dgs"

section onEnter(254) {
  spawnItemChance(max: 99, chance: 9, item: Item.Digimushroom, x: 57, y: 76);
  spawnItemChance(max: 99, chance: 4, item: Item.Digimushroom, x: 51, y: 36);
  return;
}

section(5) {
  speak(Entity(5), "I'm going all the way!\n");
  finishEncounter(Trigger(271));
}

section(6) {
  speak(Entity(6), "That gets me mad!\n");
  finishEncounter(Trigger(271));
}

section(7) {
  speak(Entity(7), "Don't say 'cold'!\n");
  finishEncounter(Trigger(303));
}

section(8) {
  speak(Entity(8), "Don't be reckless!\n");
  finishEncounter(Trigger(303));
}

