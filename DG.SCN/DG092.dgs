// DG092.SCN
#include "functions.dgs"
#pragma script index=92 start=0x3c800 end=0x3d000 headerU16=0x14 sentinelOff=0xfe
#include "entities.dgs"

section onEnter(254) {
  return;
}

section(51) {
  move(entity: Entity.Player, to: (969, -3260), sprint: 0);
  warp(to: Map.ICSA02, spawn: 1, trigger: 255);
  return;
}

section(81) {
  rotate(entity: Entity.Player, to: 2048);
  setTextboxOrigin(-11, 0, 1049);
  callSubroutine(39);
  speak(Entity(200), " <NEWLINE><GREEN>    トレーニング・氷動かし<WHITE><NEWLINE>");
  setSelection(L1, L2, L3);
  showTextbox("トレーニング開始<NEWLINE>このトレーニングの説明<NEWLINE>やめる<NEWLINE>");
  waitForSelectionChoice();
  return;

L1:
  setSelection(L4, L5, L3);
  showTextbox("ノーマルトレーニング<NEWLINE>ボーナストライトレーニング<NEWLINE>やっぱりやめる<NEWLINE>");
  waitForSelectionChoice();
  return;

L2:
  showTextbox("大きな氷を押すことで、体力をつけます。<NEWLINE>最大HPが大きくアップ、防御力もアップ<NEWLINE>します。<NEWLINE>");
  setSelection(L2, L1, L3);
  showTextbox("もう一度説明<NEWLINE>トレーニング開始<NEWLINE>やめる<NEWLINE>");
  waitForSelectionChoice();
  return;

L3:
  return;

L4:
  fadeOutHUD();
  setPStat(PStat(254), 0);
  setPStat(PStat(246), 0);
  callDigimonSubroutine(214);
  callSubroutine(7);
  return;

L5:
  setTexboxMode(1, 0);
  speak(Entity.System, "       <YELLOW>スロットゲーム<WHITE><NEWLINE> <NEWLINE>   <ORANGE><CIRCLE><WHITE><ボき><ヌン>で3つのスロットを止めて、<NEWLINE>    うまく絵をそろえてください。<NEWLINE>");
  setPStat(PStat(254), 0);
  setPStat(PStat(246), 1);
  callDigimonSubroutine(214);
  callSubroutine(7);
  setTexboxMode(0, 0);
  return;
}

section(84) {
  rotate(entity: Entity.Player, to: 2048);
  setTextboxOrigin(1574, 0, 116);
  callSubroutine(39);
  speak(Entity(200), " <NEWLINE><GREEN>   トレーニング・アイシクルフォール<WHITE><NEWLINE>");
  setSelection(L1, L2, L3);
  showTextbox("トレーニング開始<NEWLINE>このトレーニングの説明<NEWLINE>やめる<NEWLINE>");
  waitForSelectionChoice();
  return;

L1:
  setDialogOwner(Entity(200));
  setSelection(L4, L5, L3);
  showTextbox("ノーマルトレーニング<NEWLINE>ボーナストライトレーニング<NEWLINE>やっぱりやめる<NEWLINE>");
  waitForSelectionChoice();
  return;

L2:
  speak(Entity(200), "大きなつららを受け止めるたん練を行います。<NEWLINE>防御力が大きくアップ、すばやさもアップ<NEWLINE>します。<NEWLINE>");
  setSelection(L2, L1, L3);
  showTextbox("もう一度説明<NEWLINE>トレーニング開始<NEWLINE>やめる<NEWLINE>");
  waitForSelectionChoice();
  return;

L3:
  return;

L4:
  fadeOutHUD();
  setPStat(PStat(254), 3);
  setPStat(PStat(246), 0);
  callDigimonSubroutine(214);
  callSubroutine(7);
  return;

L5:
  setTexboxMode(1, 0);
  speak(Entity.System, "       <YELLOW>スロットゲーム<WHITE><NEWLINE> <NEWLINE>   <ORANGE><CIRCLE><WHITE><ボき><ヌン>で3つのスロットを止めて、<NEWLINE>    うまく絵をそろえてください。<NEWLINE>");
  setPStat(PStat(254), 3);
  setPStat(PStat(246), 1);
  callDigimonSubroutine(214);
  callSubroutine(7);
  setTexboxMode(0, 0);
  return;
