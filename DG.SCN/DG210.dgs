// DG210.SCN
#include "functions.dgs"
#pragma script index=210 start=0xaf000 end=0xb0000 headerU16=0x10 sentinelOff=0x6722

section onEnter(254) {
    // (empty)
}

section(51) {
    storeDigimonType(103);
    if (pstat[103] != 1 && pstat[103] != 2 && pstat[103] != 3 && pstat[103] != 4) goto L1;
    jumpToScriptSection(221, 5);

L1:
    if (pstat[103] != 15 && pstat[103] != 16 && pstat[103] != 17 && pstat[103] != 18) goto L2;
    jumpToScriptSection(221, 5);

L2:
    if (pstat[103] != 29 && pstat[103] != 30 && pstat[103] != 31 && pstat[103] != 32) goto L3;
    jumpToScriptSection(221, 5);

L3:
    if (pstat[103] != 43 && pstat[103] != 44 && pstat[103] != 45 && pstat[103] != 46) goto L4;
    jumpToScriptSection(221, 5);

L4:
    if (trigger(87) || trigger(205) || pstat[1] < 15) goto L5;
    setTrigger(87);

L5:
    if (trigger(354) || pstat[1] < 50 || !trigger(205)) goto L6;
    setTrigger(354);
    speak(5, "I was waiting for you,\n<LIGHTBLUE><PLAYER><WHITE>.\nFinally, this day has come\n");
    speak(Entity.Player, "What happened?\n");
    speak(5, "The entrance to Mt. Infinity\nappeared.\n");
    speak(Entity.Player, "What? Really? Where?\n");
    speak(5, "It's beyond the falls\nof the city.\n");
    speak(Entity.Player, "Gosh, it's so close!\n");
    speak(5, "The way I see it, the last\nenemy is on Mt. Infinity.\n");
    speak(Entity.Player, "So it's the Last Dungeon.\nI'll do it!\n");
    speak(5, "Good luck! But don't be\nhasty. Don't make a move\nuntil you're fully prepared.\n");
    return;

L6:
    if (!trigger(354) || trigger(50) || !trigger(205)) goto L7;
    speak(5, "On the other side of the\nwaterfall, in the city, is\nthe entrance to Mt. Infinity.\n");
    speak(5, "The way I see it, the last\nenemy is on Mt. Infinity.\n");
    showTextbox("Go there fully prepared!\n");
    showTextbox("In any case...\n");

L7:
    jumpToScriptSection(221, 5);
}

section(77) {
    speak(5, "The prosperity rate of\nthe current city is <PROSPERITY>.\n");
    if (pstat[1] > 10) goto L1;
    speak(5, "It's far from\nhow it used to look.\n");
    return;

L1:
    if (pstat[1] > 30) goto L2;
    speak(5, "It's finally taking shape.\n");
    return;

L2:
    if (pstat[1] > 50) goto L3;
    speak(5, "It's developing well.\n");
    return;

L3:
    if (pstat[1] > 70) goto L4;
    speak(5, "It's becoming a fine city.\n");
    return;

L4:
    if (pstat[1] > 99) goto L5;
    speak(5, "You've done a fine job.\nSplendid!\n");
    return;

L5:
    if (pstat[1] > 100) goto L6;
    speak(5, "There's nothing more I need\nto say. It's fantastic!\n");
    if (stat[Stat.TamerLevel] == 10 || trigger(216)) goto L6;
    addStats(tamerLevel: 1);
    speak(Entity.System, "<YELLOW>Tamer Level\nhas gone up! <WHITE>\n");
    setTrigger(216);
    setTrigger(375);
    playSound(0, 7);
    speak(Entity.System, "<YELLOW>Congratulations!\nHere's a medal\nfor your great work! <WHITE>\n");

L6:
    return;
    garbage { 10 00 fe 00 10 00 33 00 10 00 4d 00 44 05 ff ff 22 67 19 00 08 00 67 01 48 00 67 02 48 00 67 03 48 00 67 04 18 00 30 00 19 00 17 00 dd 00 05 00 19 00 08 00 67 0f 48 00 67 10 48 00 67 11 48 00 67 12 18 00 4e 00 19 00 17 00 dd 00 05 00 19 00 08 00 67 1d 48 00 67 1e 48 00 67 1f 48 00 67 20 18 00 6c 00 19 00 17 00 dd 00 05 00 19 00 08 00 67 2b 48 00 67 2c 48 00 67 2d 48 00 67 2e 18 00 8a 00 19 00 17 00 dd 00 05 00 19 00 01 00 57 00 81 00 cd 00 8a 00 01 0f 18 00 a2 00 19 00 1c 00 57 00 19 00 01 00 62 01 8a 00 01 32 80 00 cd 00 18 00 b8 03 19 00 1c 00 62 01 1b 05 1a 00 82 68 81 40 82 97 82 81 82 93 81 40 82 97 82 81 82 89 82 94 82 89 82 8e 82 87 81 40 82 86 82 8f 82 92 81 40 82 99 82 8f 82 95 81 43 0d 00 01 06 05 00 01 01 81 42 0d 00 82 65 82 89 82 8e 82 81 82 8c 82 8c 82 99 81 43 81 40 82 94 82 88 82 89 82 93 81 40 82 84 82 81 82 99 81 40 82 88 82 81 82 93 81 40 82 83 82 8f 82 8d 82 85 0d 00 00 00 1b fd 1a 00 82 76 82 88 82 81 82 94 81 40 82 88 82 81 82 90 82 90 82 85 82 8e 82 85 82 84 81 48 0d 00 00 00 1b 05 1a 00 82 73 82 88 82 85 81 40 82 85 82 8e 82 94 82 92 82 81 82 8e 82 83 82 85 81 40 82 94 82 8f 81 40 82 6c 82 94 81 42 81 40 82 68 82 8e 82 86 82 89 82 8e 82 89 82 94 82 99 0d 00 82 81 82 90 82 90 82 85 82 81 82 92 82 85 82 84 81 42 0d 00 00 00 1b fd 1a 00 82 76 82 88 82 81 82 94 81 48 81 40 82 71 82 85 82 81 82 8c 82 8c 82 99 81 48 81 40 82 76 82 88 82 85 82 92 82 85 81 48 0d 00 00 00 1b 05 1a 00 82 68 82 94 81 75 82 93 81 40 82 82 82 85 82 99 82 8f 82 8e 82 84 81 40 82 94 82 88 82 85 81 40 82 86 82 81 82 8c 82 8c 82 93 0d 00 82 8f 82 86 81 40 82 94 82 88 82 85 81 40 82 83 82 89 82 94 82 99 81 42 0d 00 00 00 1b fd 1a 00 82 66 82 8f 82 93 82 88 81 43 81 40 82 89 82 94 81 75 82 93 81 40 82 93 82 8f 81 40 82 83 82 8c 82 8f 82 93 82 85 81 49 0d 00 00 00 1b 05 1a 00 82 73 82 88 82 85 81 40 82 97 82 81 82 99 81 40 82 68 81 40 82 93 82 85 82 85 81 40 82 89 82 94 81 43 81 40 82 94 82 88 82 85 81 40 82 8c 82 81 82 93 82 94 0d 00 82 85 82 8e 82 85 82 8d 82 99 