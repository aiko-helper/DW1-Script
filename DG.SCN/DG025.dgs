// DG025.SCN
#include "functions.dgs"
#pragma script index=25 start=0x17800 end=0x18000 headerU16=0x14 sentinelOff=0x1a64
#include "entities.dgs"

section onEnter(254) {
  callSubroutine(26);
  if (pstat[17] == 3) {
    setPStat(254, 0);
    callSubroutine(19);
    setAutotalk(5, 0);
  }
  if (pstat[17] == 4) {
    setPStat(254, 1);
    callSubroutine(19);
    setAutotalk(5, 0);
  }
  return;
}

section(5) {
  if (pstat[17] >= 3) {
    speak(5, "Come on, keep up!\n");
    return;
  }
  speak(5, "You must be an outsider!\n");
  finishEncounter(280);
}

section(51) {
  if (pstat[17] == 3) {
    move(entity: Entity.Partner, to: Entity.Player, sprint: 1);
    waitForEntity(Entity.Partner);
    move(entity: Entity.Partner, to: (1200, 1583), sprint: 0);
    waitForEntity(Entity.Partner);
    speak(Entity.System, "Dumped the dirt.\n");
    setPStat(254, 1);
    callSubroutine(19);
    move(entity: Entity.Partner, to: Entity.Player, sprint: 1);
    setPStat(17, 4);
  }
  return;
}

section(52) {
  if (pstat[17] == 4) {
    speak(Entity.Player, "Ooops, I must return\nthe dirt box to Drimogemon.\n");
    move(entity: Entity.Player, to: (453, 1815), sprint: 1);
    waitForEntity(Entity.Player);
    moveCamera(to: Entity.Player, speed: 10);
    waitForEntity(200);
  }
  return;
  garbage { 14 00 fe 00 14 00 05 00 44 00 33 00 c2 00 34 00 16 01 ff ff 64 1a 19 00 08 00 11 03 18 00 2c 00 19 00 1e 00 fe 00 64 13 6a 00 05 00 19 00 08 00 11 04 18 00 42 00 19 00 1e 00 fe 01 64 13 6a 00 05 00 fe 00 19 00 0a 00 11 03 18 00 7c 00 19 00 1b 05 1a 00 82 62 82 8f 82 8d 82 85 81 40 82 8f 82 8e 81 43 81 40 82 8b 82 85 82 85 82 90 81 40 82 95 82 90 81 49 0d 00 00 00 fe 00 1b 05 1a 00 82 78 82 8f 82 95 81 40 82 8d 82 95 82 93 82 94 81 40 82 82 82 85 81 40 82 81 82 8e 81 40 82 8f 82 95 82 94 82 93 82 89 82 84 82 85 82 92 81 49 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 18 01 fe 00 19 00 08 00 11 03 18 00 14 01 19 00 51 fc 01 fd 4a fc 4e fc b0 04 2f 06 00 00 4a fc 1b ff 1a 00 82 63 82 95 82 8d 82 90 82 85 82 84 81 40 82 94 82 88 82 85 81 40 82 84 82 89 82 92 82 94 81 42 0d 00 00 00 1e 00 fe 01 64 13 51 fc 01 fd 1e 00 11 04 fe 00 19 00 08 00 11 04 18 00 9a 01 19 00 1b fd 1a 00 82 6e 82 8f 82 8f 82 90 82 93 81 43 81 40 82 68 81 40 82 8d 82 95 82 93 82 94 81 40 82 92 82 85 82 94 82 95 82 92 82 8e 0d 00 82 94 82 88 82 85 81 40 82 84 82 89 82 92 82 94 81 40 82 82 82 8f 82 98 81 40 82 94 82 8f 81 40 82 63 82 92 82 89 82 8d 82 8f 82 87 82 85 82 8d 82 8f 82 8e 81 42 0d 00 00 00 4e fd c5 01 17 07 01 00 4a fd 50 00 fd 0a 4a c8 fe 00 ff 00 fe 00 1b 0b 1a 00 82 76 82 88 82 81 82 94 81 48 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 18 01 fe 00 1b 0c 1a 00 82 6c 82 8d 82 8d 82 8d 82 8d 81 49 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 18 01 fe 00 19 00 00 00 96 00 81 00 ea 00 18 00 6a 02 19 00 1b fd 1a 00 82 68 81 40 82 87 82 8f 82 94 81 40 82 82 82 81 82 84 81 40 82 86 82 85 82 85 82 8c 82 89 82 8e 82 87 81 42 0d 00 00 00 4c 00 fd fc 4c 00 fc fd 67 00 05 00 1b fd 1a 00 82 78 82 8f 82 95 81 40 82 94 82 8f 82 8f 81 48 81 40 82 68 81 40 82 94 82 88 82 8f 82 95 82 87 82 88 82 94 81 40 82 93 82 8f 81 42 0d 00 00 00 4e fd d1 06 b2 f9 00 00 4a fd fe 00 19 00 00 00 ee 00 18 00 18 03 19 00 19 00 01 00 96 00 40 00 ea 00 18 00 18 03 19 00 1b fd 1a 00 82 73 82 88 82 85 82 92 82 85 81 75 82