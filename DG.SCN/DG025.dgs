// DG025.SCN
#include "functions.dgs"
#pragma script index=25 start=0x16800 end=0x17800 headerU16=0x28 sentinelOff=0x1a64
#include "entities.dgs"

section onEnter(254) {
  callSubroutine(26);
  switch pstat[17] {
    3 => {
      setPStat(PStat(254), 0);
      callSubroutine(19);
      for id in Entity(5)..Entity(7) {
        setAutotalk(id, 0);
      }
    }
    4 => {
      setPStat(PStat(254), 1);
      callSubroutine(19);
      for id in Entity(5)..Entity(7) {
        setAutotalk(id, 0);
      }
    }
  }
  return;
}

section(5) {
  if (pstat[17] >= 3) {
    speak(Entity(5), "「へっへっへ、ごくろうさん!」<NEWLINE>");
    return;
  }
  speak(Entity(5), "「あんだ?やんのか!」<NEWLINE>");
  finishEncounter(Trigger(280));
}

section(6) {
  if (pstat[17] >= 3) {
    speak(Entity(6), "「いやー、ごくろうね!」<NEWLINE>");
    return;
  }
  speak(Entity(6), "「ほっとけよ!」<NEWLINE>");
  finishEncounter(Trigger(280));
}

section(7) {
  if (pstat[17] >= 3) {
    speak(Entity(7), "「ムリしちゃって!」<NEWLINE>");
    return;
  }
  speak(Entity(7), "「せーなー!」<NEWLINE>");
  finishEncounter(Trigger(280));
}

section(9) {
  speak(Entity(9), "「もう、こうさんだよ~」<NEWLINE>");
  return;
}

section(10) {
  speak(Entity(10), "「かしら、行っちゃったなあ。」<NEWLINE>");
  return;
}

section(51) {
  if (!trigger(150) || trigger(234)) {
    return;
  }
  {
    move(entity: Entity.Player, to: (-165, 221), sprint: 0, withCamera: true);
    move(entity: Entity.Partner, to: (171, 615), sprint: 0);
    waitForPair();
    move(entity: Entity(9), to: (-323, 93), sprint: 0);
    move(entity: Entity(10), to: (498, -51), sprint: 0);
    move(entity: Entity(8), to: (160, -193), sprint: 0);
    for x in [Entity(5), Entity(6), Entity(8)] {
      waitForEntity(x);
    }
    rotate(entity: Entity.Player, to: 100);
    rotate(entity: Entity.Partner, to: 100);
    look(entity: Entity(9), at: Entity.Player);
    look(entity: Entity(10), at: Entity.Player);
    look(entity: Entity(8), at: Entity.Player);
    speak(Entity(8), "「ぐへへ、貴様ら、ここを通りたきゃ、荷物<NEWLINE> 全部置いてきな!」<NEWLINE>");
    speak(Entity.Player, "「おまえとも長いつきあいだな。」<NEWLINE>");
    speak(Entity(8), "「むぐ!またキサマらか…!」<NEWLINE>");
    speak(Entity.Player, "「それはこっちのセリフだ!こーんな分かり<NEWLINE> やすい場所にこもって…。<NEWLINE> 覚悟を決めているようだな!」<NEWLINE>");
    playAnimation(Entity(8), Animation(32));
    speak(Entity(8), "「ふぁははは!覚悟だと?<NEWLINE> 俺様が本気になったらどうなるか!<NEWLINE> 見るがいいぜ!」<NEWLINE>");
    playAnimation(Entity(8), Animation(0));
    speak(Entity.Player, "「終わりにしようぜ!」<NEWLINE>");
    setTrigger(Trigger(1));
    setPStat(PStat(250), 1);
    setPStat(PStat(251), 9);
    setPStat(PStat(252), 10);
    setPStat(PStat(253), 8);
    startBattle();
    unsetTrigger(Trigger(1));
    setPStat(PStat(250), 0);
    playAnimation(Entity(9), Animation(43));
    playAnimation(Entity(10), Animation(43));
    move(entity: Entity(8), to: (89, -659), sprint: 0);
    waitForEntity(Entity(8));
    rotate(entity: Entity(8), to: 100);
    lookPairAt(Entity(8));
    waitForEntity(Entity(8));
    anim(Entity(8), Animation(28), wait: 30);
    speak(Entity(8), "「…なぜ…勝てねえ…」<NEWLINE>");
    playAnimation(Entity(8), Animation(29));
    anim(Entity.Player, Animation(19), wait: 20);
    speak(Entity.Player, "「どうした?逃げ出さないのか?」<NEWLINE>");
    playAnimation(Entity.Player, Animation(0));
    speak(Entity(8), "「疲れちまった…」<NEWLINE>");
    speak(Entity.Player, "「………」<NEWLINE>");
    speak(Entity(8), "「俺様が山賊になったのはな、この島は<NEWLINE> もうだめだ、ならば好き放題やってやる…<NEWLINE> そう思ったからなのさ…」<NEWLINE>");
    speak(Entity.Player, "「この島がやばいってこと、知ってたのか。」<NEWLINE>");
    speak(Entity(8), "「たりめえよ。だけどな、お前らみたいな奴が<NEWLINE> でてきてな…。いまさら力を合わせてなんて<NEWLINE> みっともねえじゃねえか…」<NEWLINE>");
    anim(Entity.Player, Animation(19), wait: 15);
    speak(Entity.Player, "「そんなことは無いさ。街へ来いよ。」<NEWLINE>");
    playAnimation(Entity.Player, Animation(0));
    speak(Entity(8), "「ダメさ…俺なんてよ。何の役にも…<NEWLINE> それに俺がゆるしてもらえるわけが…」<NEWLINE>");
    anim(Entity.Player, Animation(7), wait: 15);
    speak(Entity.Player, "「るせーっ!!!<NEWLINE> ガタガタ言ってねーで来い!!!」<NEWLINE>");
    playAnimation(Entity.Player, Animation(0));
    move(entity: Entity.Player, to: (160, -193), sprint: 1, withCamera: true);
    waitForEntity(Entity.Player);
    rotate(entity: Entity.Player, to: 100);
    showTextbox("「お前は役に立つ!<NEWLINE> 今この島に役に立たない奴なんて<NEWLINE> いやしねーんだ!同じだみんな!」<NEWLINE>");
    speak(Entity(8), "'!!!\"\n");
    playAnimation(Entity(8), Animation(30));
    look(entity: Entity(8), at: Entity.Player);
    speak(Entity(8), "「助かる…?この島は助かるのかっ!<NEWLINE> おまえ達がよ、助けてくれるんだな!<NEWLINE> ええ!?」<NEWLINE>");
    move(entity: Entity(8), to: (119, -494), sprint: 1);
    waitForEntity(Entity(8));
    look(entity: Entity(8), at: Entity.Player);
    speak(Entity.Player, "「ったりめえよ!!!!!!!<NEWLINE> …街の場所、分かるな?」<NEWLINE>");
    speak(Entity(8), "「おおおおお!<NEWLINE> 待ってろよ、俺様のシゴトよぉー!」<NEWLINE>");
    break;
  }
  move(entity: Entity(8), to: (155, 873), sprint: 1);
  if (pstat[101] < 6) {
    addPStat(PStat.LoopIterator, 1);
    delay(10);
    lookPairAt(Entity(8));
  }
  waitForEntity(Entity(8));
  unloadEntity(Entity(8));
  setPStat(PStat.LoopIterator, 0);
  playSound(8, 8);
  speak(Entity.System, "オーガモンが街に参加した!!!<NEWLINE>");
  setTrigger(Trigger(234));
  addPStat(PStat(1), 2);
  followEntity(Entity.Player, speed: 10);
  return;
}

section(52) {
  switch pstat[17] {
    3 => {
      speak(Entity.Player, "「っと!出口はこっちじゃない!」<NEWLINE>");
      move(entity: Entity.Player, to: (-51, -1550), sprint: 1);
      waitForEntity(Entity.Player);
      followEntity(Entity.Player, speed: 10);
      return;
    }
    4 => {
      speak(Entity.Player, "「っと!ドリモゲモンに土箱を<NEWLINE> 返さなきゃ!」<NEWLINE>");
      move(entity: Entity.Player, to: (-51, -1550), sprint: 1);
      waitForEntity(Entity.Player);
      followEntity(Entity.Player, speed: 10);
      return;
    }
  }
  if (trigger(209) && pstat[1] >= 45) {
    move(entity: Entity.Player, to: (-105, -2200), sprint: 0);
    warp(to: Map.TUNN03_2, spawn: 0, trigger: 255);
  }
  move(entity: Entity.Player, to: (-105, -2200), sprint: 0);
  warp(to: Map.TUNN03, spawn: 0, trigger: 255);
}

section(53) {
  switch pstat[17] {
    3 => {
      speak(Entity.Player, "「っと!出口はこっちじゃない!」<NEWLINE>");
      move(entity: Entity.Player, to: (-2253, 359), sprint: 1);
      waitForEntity(Entity.Player);
      followEntity(Entity.Player, speed: 10);
      return;
    }
    4 => {
      speak(Entity.Player, "「っと!ドリモゲモンに土箱を<NEWLINE> 返さなきゃ!」<NEWLINE>");
      move(entity: Entity.Player, to: (-2253, 359), sprint: 1);
      waitForEntity(Entity.Player);
      followEntity(Entity.Player, speed: 10);
      return;
    }
  }
  return;
