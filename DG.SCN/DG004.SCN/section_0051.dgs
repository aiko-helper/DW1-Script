// source: extract/DIGIMON/SCN/DG.SCN
// DG004.SCN, section 51

section section_51(51) {  // len=842
    if (!trigger(242) && pstat[1] >= 50) goto L_0012;
    return;
L_0012:
    move(entity: Entity.Partner, to: Entity.Player, sprint: 1);
    waitForEntity(Entity.Partner);
    rotate(entity: Entity.Partner, to: 2048);
    delay(5);
    setDialogOwner(Entity.System);
    showTextbox("<YELLOW>? ? ? <WHITE>\nEven monkeys fall from trees.\n");
    showTextbox("<YELLOW>? ? ? <WHITE>\nFlying knee drop!\n");
    playSound(8, 5);
    playAnimation(5, 29);
    move(entity: 5, axis: 1, to: 0, speed: 12);
    waitForEntity(5);
    playAnimation(5, 0);
    playSound(8, 6);
    setPStat(200, 30);
    dealMapDamage(200);
    playAnimation(Entity.Player, 15);
    playAnimation(Entity.Partner, 40);
    delay(30);
    setTrigger(1);
    setPStat(250, 1);
    setPStat(251, 5);
    setPStat(252, 255);
    setPStat(253, 255);
    fadeOutHUD();
    delay(1);
    startBattle();
    unsetTrigger(1);
    setPStat(250, 0);
    look(entity: Entity.Player, at: 5);
    look(entity: 5, at: Entity.Player);
    look(entity: Entity.Partner, at: 5);
    setDialogOwner(5);
    showTextbox("I lost, but\nyou guys are nothing!\n");
    playSound(8, 13);
    playAnimation(Entity.Player, 20);
    delay(15);
    setDialogOwner(Entity.Player);
    showTextbox("Don't be a sore loser.\nYou even sneak attacked us\nby surprise.\n");
    playAnimation(Entity.Player, 0);
    playSound(8, 13);
    playAnimation(5, 7);
    setDialogOwner(5);
    showTextbox("Ugh! You leave me\nno choice but to...\n");
    showTextbox("In that city of yours,\nI'll show you how strong\nI am! Just you watch!\n");
    goto L_02d4;
L_02d4:
    move(entity: 5, to: (0, 0), sprint: 1);
    if (pstat[101] >= 4) goto L_02fc;
    addPStat(101, 1);
    delay(20);
    look(entity: Entity.Player, at: 5);
    look(entity: Entity.Partner, at: 5);
    goto L_02d4;
L_02fc:
    waitForEntity(5);
    unloadEntity(5);
    setPStat(101, 0);
    moveCamera(to: Entity.Player, speed: 10);
    playSound(8, 11);
    setDialogOwner(Entity.System);
    showTextbox("Etemon joins the city!\n");
    setTrigger(242);
    addPStat(1, 3);
    return;
}
