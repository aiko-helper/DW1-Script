; DG004.SCN
;!script index=4 start=0x8800 end=0x9000 headerU16=0x24 sentinelOff=0x24
;!sections onEnter section_81 section_51 section_6@0x49e section_6@0x4de section_7 section_8 section_9

onEnter:     ; len=90
  0000:  storeRandom 110 99
  0004:  if pstat[110] > 2 then onEnter+0x16
  0010:  spawnItem BlueApple 44 31
  0016:  storeRandom 110 99
  001a:  if pstat[110] > 24 then onEnter+0x2c
  0026:  spawnItem Digimushroom 42 57
  002c:  storeRandom 110 99
  0030:  if pstat[110] > 2 then onEnter+0x42
  003c:  spawnItem DeluxeMushroom 52 51
  0042:  storeRandom 110 99
  0046:  if pstat[110] > 59 then onEnter+0x58
  0052:  spawnItem Digimushroom 65 41
  0058:  endSection
