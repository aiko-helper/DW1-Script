// DG101.SCN
#include "functions.dgs"
#pragma script index=101 start=0x45800 end=0x46000 headerU16=0x30 sentinelOff=0x24

section onEnter(254) {
  roll(pstat: 110, max: 99);
  if (pstat[110] > 3) goto L1;
  spawnItem(Item.GoldAcorn, x: 36, y: 69);

L1:
  return;
}

section(81) {
  if (item[Item.BlueFlute] < 1) goto L1;
  speak(Entity.System, "Will you play the Lake\nGuardian's <LIGHTBLUE>Blue Flute<WHITE>?\n");
  setDialogOwner(Entity.Player);
  choice { "Play" -> L3, "Don't play" -> L2 }
  return;

L1:
  return;

L2:
  return;
  return;

L3:
  delay(60);
  warp(to: Map.MAYO06, spawn: 0, trigger: 255);
}

section(51) {
  move(entity: Entity.Player, to: (-1061, -331), sprint: 0);
  warp(to: Map.FACT03, spawn: 3, trigger: 255);
  return;
}

section(5) {
  speak(5, "Reporting, reporting!\n");
  startBattle();
  setTrigger(311);
  return;
}

section(6) {
  speak(6, "Enemy ahead!\n");
  startBattle();
  setTrigger(311);
  return;
}

section(7) {
  speak(7, "Hee-how!\n");
  startBattle();
  setTrigger(311);
  return;
}

section(8) {
  speak(8, "Today's not a good day.\n");
  startBattle();
  setTrigger(274);
  return;
}

section(9) {
  speak(9, " ??? \n");
  startBattle();
  setTrigger(274);
  return;
}

section(10) {
  speak(10, "Don't you think it's unfair?\n");
  startBattle();
  setTrigger(274);
  return;
}

section(11) {
  speak(9, "Stop them!\n");
  startBattle();
  setTrigger(311);
  return;
}

section(12) {
  speak(10, "So busy!\n");
  startBattle();
  setTrigger(311);
  return;
