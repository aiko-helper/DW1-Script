section(51) {
  move(entity: Entity.Player, to: (-32, -2500), sprint: 0);
  warp(to: Map.OMOC05, spawn: 3, trigger: 255);
  return;
}

section(5) {
  speak(Entity(5), "「テキをハイジョせよ!」<NEWLINE>");
  finishEncounter(Trigger(276));
}

