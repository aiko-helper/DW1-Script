; source: ./extract/DIGIMON/SCN/DG.SCN
; MAP138.SCN, section 7

section_7(7):     ; len=1346
  0000:  speak 7 "I don't know if it helps, but\nhere are some fishing tips.\n"
  007a:  showTextbox "First, a fishing rod.\nA good one can fly far\nand has enough flex.\n"
  0102:  showTextbox "Next, bait. Remember which\nfish you caught with\nwhich bait.\n"
  017e:  showTextbox "When you throw the rod,\nrelease with <LIGHTBLUE><X> <WHITE>\nto let it fly at full power!\n"
  0210:  showTextbox "About the Lake Guardian...\nHe appears in the morning\nand late afternoon everyday.\n"
  02b8:  endSection
