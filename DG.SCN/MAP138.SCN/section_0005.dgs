// source: extract/DIGIMON/SCN/DG.SCN
// MAP138.SCN, section 5

section section_5(5) {  // len=480
    setDialogOwner(5);
    showTextbox("I'm a Digimon card collector.\n");
    showTextbox("Give me Hagurumon,\nToyAgumon and WaruMonzaemon,\nthen I'll give you one.\n");
    if (card[19] < 1 || card[24] < 1 || card[57] < 1) goto L_0120;
    setDialogOwner(Entity.Player);
    setSelection(L_015a, L_01de);
    showTextbox("Give\nDon't give\n");
    waitForSelectionChoice();
    return;
L_0120:
    setDialogOwner(Entity.Player);
    showTextbox("Sorry, I don't have any.\n");
    return;
L_015a:
    giveItem(Item.XBandage, 1);
    setDialogOwner(5);
    showTextbox("Here. An <LIGHTBLUE>X Bandage<WHITE>.\n");
    if (!trigger(0)) goto L_01d2;
    setDialogOwner(Entity.Player);
    showTextbox("I have too many Items.\n");
    return;
L_01d2:
    playSound(0, 7);
    takeCard(19);
    takeCard(24);
    takeCard(57);
    return;
L_01de:
    return;
}
