; source: ./extract/DIGIMON/SCN/DG.SCN
; DG071.SCN, section 82

section_82(82):     ; len=548
  0000:  speak System "MP Stand\n"
  0018:  setRotation Player 2048
  001c:  speak Player "Can this machine recover MP?\n"
  005c:  setSelection section_82+0xea section_82+0x182 section_82+0x21a
  0064:  showTextbox "Hund MP: two hund bits\nThous MP:eighteen hund bits\nDon't use\n"
  00e2:  waitForSelectionChoice
  00e4:  jump section_82+0x21a
  00e8:  endSection
  00ea:  if money < 200 then section_82+0x146
  00fa:  addStats CurrentMP 100
  00fe:  reduceMoney 200
  0104:  speak System "Our MP level has recovered!\n"
  0142:  jump section_82+0x180
  0146:  speak Player "I don't got enough bits.\n"
  017e:  endSection
  0180:  endSection
  0182:  if money < 1800 then section_82+0x1de
  0192:  addStats CurrentMP 1000
  0196:  reduceMoney 1800
  019c:  speak System "Our MP level has recovered!\n"
  01da:  jump section_82+0x218
  01de:  speak Player "I don't got enough bits.\n"
  0216:  endSection
  0218:  endSection
  021a:  endSection
