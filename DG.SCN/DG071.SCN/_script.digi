; DG071.SCN
;!script index=71 start=0x33000 end=0x33800 headerU16=0x28 sentinelOff=0x24
;!sections onEnter section_5 section_6 section_7 section_8 section_9 section_10 section_81 section_82

onEnter:     ; len=90
  0000:  storeRandom 110 99
  0004:  if pstat[110] > 11 then onEnter+0x16
  0010:  spawnItem Digimushroom 68 50
  0016:  storeRandom 110 99
  001a:  if pstat[110] > 17 then onEnter+0x2c
  0026:  spawnItem Digimushroom 46 29
  002c:  storeRandom 110 99
  0030:  if pstat[110] > 3 then onEnter+0x42
  003c:  spawnItem SweetNut 46 73
  0042:  storeRandom 110 99
  0046:  if pstat[110] > 0 then onEnter+0x58
  0052:  spawnItem ChainMelon 57 83
  0058:  endSection
