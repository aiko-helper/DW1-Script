#pragma script index=124 start=0x58000 end=0x58800 headerU16=0x14 sentinelOff=0xfe
#include "entities.dgs"

section onEnter(254) {
  return;
}

section(51) {
  if (trigger(221)) {
    return;
  }
  delay(20);
  move(entity: Entity.Player, to: (-142, -455), sprint: 0, withCamera: true);
  move(entity: Entity.Partner, to: (421, -421), sprint: 0);
  waitForPair();
  delay(20);
  move(entity: Entity.Player, to: (58, -920), sprint: 0, withCamera: true);
  move(entity: Entity.Partner, to: (-142, -455), sprint: 0);
  waitForPair();
  delay(20);
  move(entity: Entity.Player, to: (578, -695), sprint: 0);
  move(entity: Entity.Partner, to: (58, -920), sprint: 0);
  waitForPair();
  delay(20);
  move(entity: Entity.Player, to: (615, -211), sprint: 0);
  move(entity: Entity.Partner, to: (578, -695), sprint: 0);
  waitForPair();
  delay(20);
  playAnimation(Entity.Player, Animation(16));
  speak(Entity.Player, "Hmm\n");
  delay(20);
  look(entity: Entity.Player, at: Entity.Partner);
  look(entity: Entity.Partner, at: Entity.Player);
  waitForPair();
  anim(Entity.Player, Animation(19), wait: 15);
  speak(Entity.Player, "It looks like a bird's nest.\nWhat do you think?\n");
  playAnimation(Entity.Player, Animation(0));
  anim(Entity.Player, Animation(24), wait: 5);
  sfx(8, 13, wait: 20);
  speak(Entity.Player, "I hear noise.\n");
  setDigimon(Digimon.NPCBirdramon, Entity(0), 0);
  delay(10);
  followEntity(Entity(5), speed: 10);
  move(entity: Entity(5), to: (278, -490), sprint: 1, withCamera: true);
  waitForEntity(Entity(5));
  panTo(x: -83, y: -1182, slowdown: 20);
  look(entity: Entity.Player, at: Entity(5));
  look(entity: Entity(5), at: Entity.Player);
  look(entity: Entity.Partner, at: Entity(5));
  delay(20);
  setTrigger(Trigger(1));
  setPStat(PStat(250), 1);
  setPStat(PStat(251), 5);
  setPStat(PStat(252), 255);
  setPStat(PStat(253), 255);
  startBattle();
  unsetTrigger(Trigger(1));
  setPStat(PStat(250), 0);
  look(entity: Entity.Player, at: Entity(5));
  look(entity: Entity(5), at: Entity.Player);
  look(entity: Entity.Partner, at: Entity(5));
  delay(20);
  anim(Entity(5), Animation(28), wait: 40);
  speak(Entity(5), "You're good.\n");
  speak(Entity.Player, "So it was your nest.\n");
  speak(Entity(5), "Yeah.\n");
  playAnimation(Entity.Player, Animation(20));
  speak(Entity.Player, "Sorry to enter without asking.\n");
  playAnimation(Entity.Player, Animation(0));
  speak(Entity(5), "Oh, don't worry about it.\n");
  speak(Entity.Player, "?\n");
  speak(Entity(5), "I've heard of you.\n");
  speak(Entity.Player, "I didn't know I was famous.\n");
  speak(Entity(5), "You're probably the only\nhuman left on the island.\n");
  playAnimation(Entity.Player, Animation(16));
  speak(Entity.Player, "Left...? There've been\nothers before me?\n");
  speak(Entity(5), "Aren't you going to\ninvite me to the city?\n");
  playAnimation(Entity.Player, Animation(19));
  speak(Entity.Player, "Oh, yeah, won't you come\nto the city?\n");
  speak(Entity(5), "Okay. Then let's get down\nto business. Hold on tight.\n");
  move(entity: Entity(5), to: (167, -665), sprint: 0);
  waitForEntity(Entity(5));
  followEntity(Entity(5), speed: 20);
  move(entity: Entity.Player, to: (367, -815), sprint: 0);
  move(entity: Entity.Partner, to: (437, -445), sprint: 0);
  waitForPair();
  look(entity: Entity(5), at: Entity.Player);
  delay(5);
  playSound(8, 10);
  speak(Entity.System, "Birdramon joins the city!\n");
  setTrigger(Trigger(221));
  addPStat(PStat(1), 2);
  anim(Entity(5), Animation(29), wait: 40);
  if (trigger(220) || trigger(214) || pstat[1] >= 50) {
    goto L4;
    goto L1;
  }
  goto L1;

L1:
  if (trigger(221)) {
    goto L3;
    goto L2;
  }
  goto L2;

L2:
  if (trigger(225)) {
    warp(to: Map.TWNA04, spawn: 0, trigger: 255);
  }
  if (trigger(246)) {
    warp(to: Map.TWNA03, spawn: 0, trigger: 255);
  }
  warp(to: Map.TWNA02, spawn: 0, trigger: 255);

L3:
  if (trigger(225)) {
    warp(to: Map.TWNA07, spawn: 0, trigger: 255);
  }
  if (trigger(246)) {
    warp(to: Map.TWNA06, spawn: 0, trigger: 255);
  }
  warp(to: Map.TWNA05, spawn: 0, trigger: 255);

L4:
  if (trigger(221)) {
    goto L6;
    goto L5;
  }
  goto L5;

L5:
  if (trigger(225)) {
    warp(to: Map.TWNA10, spawn: 0, trigger: 255);
  }
  if (trigger(246)) {
    warp(to: Map.TWNA09, spawn: 0, trigger: 255);
  }
  warp(to: Map.TWNA08, spawn: 0, trigger: 255);

L6:
  if (trigger(225)) {
    warp(to: Map.TWNA13, spawn: 0, trigger: 255);
  }
  if (trigger(246)) {
    warp(to: Map.TWNA12, spawn: 0, trigger: 255);
  }
  warp(to: Map.TWNA11, spawn: 0, trigger: 255);
  return;
}

section(52) {
