    rotate3DObject(0, 1);
    delay(1);
    rotate3DObject(1, 1);
    delay(1);
    rotate3DObject(0, 1);
    delay(1);
    rotate3DObject(1, 1);
    delay(1);
    rotate3DObject(0, 1);
    delay(1);
    rotate3DObject(1, 1);
    delay(1);
    playSound(8, 5);
    warp(to: Map.GCAN06, spawn: 2, trigger: 53);
