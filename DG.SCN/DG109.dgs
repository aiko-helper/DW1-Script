// DG109.SCN
#pragma script index=109 start=0x4f000 end=0x4f800 headerU16=0x14 sentinelOff=0x19

section onEnter(254) {  // len=18
    if (!trigger(135)) goto L1;
    setObjectVisibility(2, 1);

L1:
    return;
}

section(51) {  // len=88
    if (trigger(134)) goto L1;
    rotate(entity: Entity.Player, to: 1900);
    waitForEntity(Entity.Player);
    setDialogOwner(Entity.Player);
    showTextbox("Wow, it's amazing!\n");
    moveCamera(to: (-400, 4000), slowdown: 50);
    waitForEntity(200);
    delay(40);
    moveCamera(to: Entity.Player, speed: 20);
    waitForEntity(200);
    setTrigger(134);
    return;

L1:
    return;
}

section(52) {  // len=558
    if (trigger(135)) goto L2;
    rotate(entity: Entity.Player, to: 1900);
    waitForEntity(Entity.Player);
    setDialogOwner(Entity.Player);
    showTextbox("Hey, there's a stone tablet.\nLet's see...\n");
    move(entity: Entity.Player, to: (-477, 2801), sprint: 0, withCamera: true);
    waitForEntity(Entity.Player);
    rotate(entity: Entity.Player, to: 1900);
    delay(10);
    playAnimation(Entity.Player, 25);
    delay(10);
    playSound(8, 7);
    setObjectVisibility(2, 1);
    delay(10);
    setDialogOwner(Entity.Player);
    showTextbox("It says Leomon.\nI can't read the rest.\n");
    playAnimation(Entity.Player, 16);
    delay(15);
    showTextbox("I can understand speech,\nbut not writing...\n");
    playAnimation(Entity.Player, 0);
    showTextbox("Let's take it.\n");
    giveItem(Item.Leomonstone, 1);
    if (!trigger(0)) goto L1;
    setDialogOwner(Entity.Player);
    showTextbox("Oops, I have to throw\nsomething away.\n");
    unsetTrigger(3);
    callSubroutine(0);
    callSubroutine(13);
    giveItem(Item.Leomonstone, 1);

L1:
    playSound(0, 7);
    setDialogOwner(Entity.System);
    showTextbox("I got <LIGHTBLUE>Leomon's\nStone<WHITE> Tablet!\n");
    setTrigger(135);
    return;

L2:
    return;
}

section(5) {  // len=1364
    delay(10);
    playAnimation(5, 28);
    delay(10);
    setDialogOwner(Entity.Player);
    showTextbox("Who are you?\n");
    setDialogOwner(5);
    showTextbox("Who are you!\n");
    rotate(entity: 5, to: 1276);
    delay(5);
    rotate(entity: 5, to: 2300);
    delay(5);
    rotate(entity: 5, to: 3324);
    delay(5);
    rotate(entity: 5, to: 252);
    delay(5);
    rotate(entity: 5, to: 1276);
    delay(5);
    rotate(entity: 5, to: 2300);
    delay(5);
    rotate(entity: 5, to: 3324);
    delay(5);
    rotate(entity: 5, to: 252);
    delay(5);
    move(entity: 5, to: (-1412, 1251), sprint: 1);
    waitForEntity(5);
    unloadEntity(5);
    if (pstat[21] != 0) goto L1;
    setObjectVisibility(3, 0);
    move(entity: Entity.Player, to: (-1878, 2900), sprint: 1);
    waitForEntity(Entity.Player);
    playAnimation(Entity.Player, 12);
    delay(10);
    setObjectVisibility(3, 1);
    playSound(0, 7);
    setDialogOwner(Entity.System);
    showTextbox("I got a <PINK>Dimensional\nKey Chain<WHITE>! I can now\ncarry up to twenty Items!\n");
    playSound(0, 7);
    setInventorySize(20);
    setTrigger(47);

L1:
    if (pstat[21] != 4) goto L2;
    setObjectVisibility(4, 0);
    move(entity: Entity.Player, to: (-1878, 2900), sprint: 1);
    waitForEntity(Entity.Player);
    playAnimation(Entity.Player, 12);
    delay(10);
    setObjectVisibility(4, 1);
    playSound(0, 7);
    setDialogOwner(Entity.System);
    showTextbox("I got a <PINK>Dimensional\nKey Chain<WHITE>! I can now\ncarry up to thirty Items!\n");
    setTrigger(48);
    setInventorySize(30);
    setTrigger(253);
    addPStat(1, 1);

L2:
    addPStat(21, 1);
    setTrigger(333);
    return;
