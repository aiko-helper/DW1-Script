    setTrigger(581);
    return;
  }
  if (trigger(251) && !trigger(619)) {
    speak(5, "Kuwagamon came here asking\nwhere Kabuterimon is.\n");
    showTextbox("Where did he go?\n");
    setTrigger(619);
    return;
  }
  if (trigger(241) && !trigger(611)) {
    speak(5, "Giromon came here and said\nto make a request!\n");
    showTextbox("So make a request.\n");
    setTrigger(611);
    return;
  }
  if (trigger(234) && !trigger(604)) {
    speak(5, "Ogremon came here, and\nasked me to buy his arm.\n");
    showTextbox("His eyes were glaring!\n");
    setTrigger(604);
    return;
  }
  if (trigger(248) && !trigger(616)) {
    speak(5, "Leomon came here and asked\na lot about the city.\n");
    showTextbox("It seems the Savanna Patrol\nis still going!\n");
    setTrigger(616);
    return;
  }
  if (trigger(255) && !trigger(623)) {
    speak(5, "Piximon came here, and asked:\n'Mister, do you want a\nsecret item?'\n");
    showTextbox("He worries me.\n");
    setTrigger(623);
    return;
  }
  if (trigger(242) && !trigger(612)) {
    speak(5, "Etemon came here talking\nabout opening a cool shop.\n");
    showTextbox("Sounds suspicious.\n");
    setTrigger(612);
    return;
  }
  if (trigger(227) && !trigger(599)) {
    speak(5, "MetalMamemon came here\nasking if there were any jobs\nthat compete with <LIGHTBLUE><PLAYER><WHITE>.\n");
    showTextbox("He's got competitive spirit.\n");
    setTrigger(599);
    return;
  }
  if (trigger(228) && !trigger(600)) {
    speak(5, "Vademon came here, and\nwait, did he come?\n");
    showTextbox("I can't seem to remember.\n");
    setTrigger(600);
    return;
  }
  if (trigger(212) && !trigger(584)) {
    speak(5, "MetalGreymon came here\nand talked about modeling\n");
    showTextbox("Thinks he's big stuff!\n");
    setTrigger(584);
    return;
  }
  if (trigger(253) && !trigger(621)) {
    speak(5, "Nanimon came and then left.\n");
    showTextbox("I wonder where he is?\n");
    setTrigger(621);
    return;
  }
  if (trigger(214) && !trigger(615)) {
    speak(5, "Monzaemon came here or\nshould I say his outer shell\nsuddenly appeared.\n");
    showTextbox("He decided to leave it at home.\n");
    setTrigger(615);
    return;
  }
  if (trigger(206) && !trigger(578)) {
    speak(5, "Devimon came here talking\nabout a really fantastic Item.\n");
    showTextbox("I guess it's fantastic.\n");
    setTrigger(578);
    return;
  }
  if (trigger(207) && !trigger(579)) {
    speak(5, "Airdramon is healed now,\nand talked about working.\n");
    showTextbox("It's good he's back to normal.\n");
    setTrigger(579);
    return;
  }
  if (trigger(256) && !trigger(624)) {
    speak(5, "Digitamamon came here and\nleft at the speed of light.\n");
    showTextbox("He's still somewhere\nin the city.\n");
    setTrigger(624);
    return;
  }
  if (trigger(226) && !trigger(598)) {
    speak(5, "SkullGreymon came here,\nsaying he'll compete\nin the Arena.\n");
    showTextbox("Myotismon interpreted for me.\n");
    setTrigger(598);
    return;
  }
  if (trigger(240) && !trigger(610)) {
    speak(5, "Andromon came here,\nsaying it was nice to meet.\n");
    showTextbox("He can't seem to\nstay for a very long.\n");
    setTrigger(610);
    return;
  }
  jumpToScriptSection(210, 77);
  return;
