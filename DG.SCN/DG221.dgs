// DG221.SCN
#pragma script index=221 start=0xc2000 end=0xc4800 headerU16=0xc sentinelOff=0x19

function speakThenShowTextboxThenSetTrigger(a, b, c) {
    speak(5, a);
    showTextbox(b);
    setTrigger(c);
}


section onEnter(254) {  // len=0
    // (empty)
}

section(5) {  // len=10228
    if (!trigger(203) || trigger(575)) goto L1;
    speak(5, "<LIGHTBLUE><PLAYER><WHITE>, you did it!\n");
    showTextbox("Agumon came to the city.\nHe started a business\nover there.\n");
    showTextbox("Hopefully more Digimon\nwill be like him!\n");
    setTrigger(575);
    return;

L1:
    if (!trigger(246) || trigger(614)) goto L2;
    speakThenShowTextboxThenSetTrigger("Palmon came here, and plans\nto expand the Meat field.\n", "Then we can get lots of Meat!\n", 614);
    return;

L2:
    if (!trigger(232) || trigger(602)) goto L3;
    speakThenShowTextboxThenSetTrigger("Kunemon came here, and\nwants to eat grass.\n", "I hope he'll eat the weeds!\n", 602);
    return;

L3:
    if (!trigger(236) || trigger(606)) goto L4;
    speakThenShowTextboxThenSetTrigger("Centarumon came here, and\nplans to open up a clinic.\n", "No more worrying about\ngetting sick or hurt!\n", 606);
    return;

L4:
    if (!trigger(249) || trigger(617)) goto L5;
    speakThenShowTextboxThenSetTrigger("Coelamon came here and\nhe wants to start a shop.\n", "The city will flourish!\n", 617);
    return;

L5:
    if (!trigger(204) || trigger(576)) goto L6;
    speakThenShowTextboxThenSetTrigger("Betamon came here and said\nhe'd like to start a shop.\n", "The city will flourish!\n", 576);
    return;

L6:
    if (!trigger(237) || trigger(607)) goto L7;
    speakThenShowTextboxThenSetTrigger("Bakemon came here and said\nsomething I didn't understand.\n", "Yes, well that's okay.\n", 607);
    return;

L7:
    if (!trigger(225) || trigger(597)) goto L8;
    speakThenShowTextboxThenSetTrigger("Vegiemon came here. He plans\nto expand the Meat field more.\n", "No more worries about food.\n", 597);
    return;

L8:
    if (!trigger(208) || trigger(580)) goto L9;
    speakThenShowTextboxThenSetTrigger("Tyrannomon came here and\nsaid his cooking is the best.\n", "Well, it has its appeal.\n", 580);
    return;

L9:
    if (!trigger(209) || trigger(581)) goto L10;
    speakThenShowTextboxThenSetTrigger("Meramon came here and said\nthat he is the chief of flames.\n", "He's fueled with motivation!\n", 581);
    return;

L10:
    if (!trigger(223) || trigger(595)) goto L11;
    speakThenShowTextboxThenSetTrigger("Frigimon came here and said\nsomething about snacks.\n", "I love snacks.\n", 595);
    return;

L11:
    if (!trigger(222) || trigger(594)) goto L12;
    speakThenShowTextboxThenSetTrigger("Garurumon came here and\nsaid that he can cook.\n", "He's quite skillful.\n", 594);
    return;

L12:
    if (!trigger(221) || trigger(593)) goto L13;
    speakThenShowTextboxThenSetTrigger("Birdramon came saying\nhe will be a Messenger.\n", "Sounds good.\n", 593);
    return;

L13:
    if (!trigger(235) || trigger(605)) goto L14;
    speakThenShowTextboxThenSetTrigger("Shellmon came here saying\nhe will build bulletin boards.\n", "A step towards\nan information society!\n", 605);
    return;

L14:
    if (!trigger(218) || trigger(580)) goto L15;
    speakThenShowTextboxThenSetTrigger("Elecmon came here and will\nturn on the electricity.\n", "I hope the city is well lit.\n", 580);
    return;

L15:
    if (!trigger(250) || trigger(618)) goto L16;
    speakThenShowTextboxThenSetTrigger("Kokatorimon came here and\ntalked about making a statue.\n", "A place where you can relax.\n", 618);
    return;

L16:
    if (!trigger(247) || trigger(588)) goto L17;
    speak(5, "Monochromon came here talking\nabout working as an");
    dead_string("? talking\nItem Shop manager.\n");
    showTextbox("He's a professional.\n");
    setTrigger(588);
    return;

L17:
    if (!trigger(233) || trigger(603)) goto L18;
    speakThenShowTextboxThenSetTrigger("Unimon came here talking\nabout being useful in business.\n", "A good attitude to have.\n", 603);
    return;

L18:
    if (!trigger(231) || trigger(601)) goto L19;
    speakThenShowTextboxThenSetTrigger("Patamon came here asking\nabout interesting jobs.\n", "I suggested an Item Shop.\n", 601);
    return;

L19:
    if (!trigger(245) || trigger(613)) goto L20;
    speakThenShowTextboxThenSetTrigger("Biyomon came here asking\nabout jobs that I'd recommend.\n", "I suggested an Item Shop.\n", 613);
    return;

L20:
    if (!trigger(205) || trigger(577)) goto L21;
    speakThenShowTextboxThenSetTrigger("Greymon came here talking\nabout making an Arena.\n", "I definitely want\nto see that.\n", 577);
    return;

L21:
    if (!trigger(257) || trigger(625)) goto L22;
    speakThenShowTextboxThenSetTrigger("Penguinmon came here\ntalking about making\na Curling stadium.\n", "We're getting a big variety.\n", 625);
    return;

L22:
    if (!trigger(220) || trigger(592)) goto L23;
    speakThenShowTextboxThenSetTrigger("Angemon came here talked\nabout recording\nconversations.\n", "He's close by.\n", 592);
    return;

L23:
    if (!trigger(238) || trigger(608)) goto L24;
    speakThenShowTextboxThenSetTrigger("Drimogemon came here and\ntalked about making treasure\nhunting a full-time job.\n", "A big job!\n", 608);
    return;

L24:
    if (!trigger(217) || trigger(589)) goto L25;
    speakThenShowTextboxThenSetTrigger("Gabumon came here and\ntalked about being worried\nover doing something.\n", "I told him to choose\na large scale job.\n", 589);
    return;

L25:
    if (!trigger(258) || trigger(626)) goto L26;
    speakThenShowTextboxThenSetTrigger("Ninjamon came here and\ntalked about training.\n", "It's good to see hard workers.\n", 626);
    return;

L26:
    if (!trigger(224) || trigger(596)) goto L27;
    speakThenShowTextboxThenSetTrigger("Whamon came here talking\nabout taking the\nplace of a ferry boat.\n", "Great!\n", 596);
    return;

L27:
    if (!trigger(252) || trigger(620)) goto L28;
    speakThenShowTextboxThenSetTrigger("Mojyamon came here taking\nabout opening\nan Everything Shop.\n", "Something is different\nabout it, though.\n", 620);
    return;

L28:
    if (!trigger(213) || trigger(587)) goto L29;
    speakThenShowTextboxThenSetTrigger("Mamemon came here talking\nabout selling treasured Items.\n", "I wonder what\n'treasured' means?\n", 587);
    return;

L29:
    if (!trigger(211) || trigger(583)) goto L30;
    speakThenShowTextboxThenSetTrigger("Numemon came here talking\nabout opening a shop.\nbut it's a secret.\n", "It's no longer a secret.\n", 583);
    return;

L30:
    if (!trigger(219) || trigger(581)) goto L31;
    speakThenShowTextboxThenSetTrigger("Kabuterimon came here talking\nabout training and remodeling.\n", "Did he go to the Green Gym?\n", 581);
    return;

L31:
    if (!trigger(251) || trigger(619)) goto L32;
    speakThenShowTextboxThenSetTrigger("Kuwagamon came here asking\nwhere Kabuterimon is.\n", "Where did he go?\n", 619);
    return;

L32:
    if (!trigger(241) || trigger(611)) goto L33;
    speakThenShowTextboxThenSetTrigger("Giromon came here and said\nto make a request!\n", "So make a request.\n", 611);
    return;

L33:
    if (!trigger(234) || trigger(604)) goto L34;
    speakThenShowTextboxThenSetTrigger("Ogremon came here, and\nasked me to buy his arm.\n", "His eyes were glaring!\n", 604);
    return;

L34:
    if (!trigger(248) || trigger(616)) goto L35;
    speakThenShowTextboxThenSetTrigger("Leomon came here and asked\na lot about the city.\n", "It seems the Savanna Patrol\nis still going!\n", 616);
    return;

L35:
    if (!trigger(255) || trigger(623)) goto L36;
    speakThenShowTextboxThenSetTrigger("Piximon came here, and asked:\n'Mister, do you want a\nsecret item?'\n", "He worries me.\n", 623);
    return;

L36:
    if (!trigger(242) || trigger(612)) goto L37;
    speakThenShowTextboxThenSetTrigger("Etemon came here talking\nabout opening a cool shop.\n", "Sounds suspicious.\n", 612);
    return;

L37:
    if (!trigger(227) || trigger(599)) goto L38;
    speakThenShowTextboxThenSetTrigger("MetalMamemon came here\nasking if there were any jobs\nthat compete with <LIGHTBLUE><PLAYER><WHITE>.\n", "He's got competitive spirit.\n", 599);
    return;

L38:
    if (!trigger(228) || trigger(600)) goto L39;
    speakThenShowTextboxThenSetTrigger("Vademon came here, and\nwait, did he come?\n", "I can't seem to remember.\n", 600);
    return;

L39:
    if (!trigger(212) || trigger(584)) goto L40;
    speakThenShowTextboxThenSetTrigger("MetalGreymon came here\nand talked about modeling\n", "Thinks he's big stuff!\n", 584);
    return;

L40:
    if (!trigger(253) || trigger(621)) goto L41;
    speakThenShowTextboxThenSetTrigger("Nanimon came and then left.\n", "I wonder where he is?\n", 621);
    return;

L41:
    if (!trigger(214) || trigger(615)) goto L42;
    speakThenShowTextboxThenSetTrigger("Monzaemon came here or\nshould I say his outer shell\nsuddenly appeared.\n", "He decided to leave it at home.\n", 615);
    return;

L42:
    if (!trigger(206) || trigger(578)) goto L43;
    speakThenShowTextboxThenSetTrigger("Devimon came here talking\nabout a really fantastic Item.\n", "I guess it's fantastic.\n", 578);
    return;

L43:
    if (!trigger(207) || trigger(579)) goto L44;
    speakThenShowTextboxThenSetTrigger("Airdramon is healed now,\nand talked about working.\n", "It's good he's back to normal.\n", 579);
    return;

L44:
    if (!trigger(256) || trigger(624)) goto L45;
    speakThenShowTextboxThenSetTrigger("Digitamamon came here and\nleft at the speed of light.\n", "He's still somewhere\nin the city.\n", 624);
    return;

L45:
    if (!trigger(226) || trigger(598)) goto L46;
    speakThenShowTextboxThenSetTrigger("SkullGreymon came here,\nsaying he'll compete\nin the Arena.\n", "Myotismon interpreted for me.\n", 598);
    return;

L46:
    if (!trigger(240) || trigger(610)) goto L47;
    speakThenShowTextboxThenSetTrigger("Andromon came here,\nsaying it was nice to meet.\n", "He can't seem to\nstay for a very long.\n", 610);
    return;

L47:
    jumpToScriptSection(210, 77);
    return;
