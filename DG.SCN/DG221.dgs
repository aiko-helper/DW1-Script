    showTextbox("He's close by.\n");
    setTrigger(592);
    return;
  }
  if (trigger(238) && !trigger(608)) {
    speak(5, "Drimogemon came here and\ntalked about making treasure\nhunting a full-time job.\n");
    showTextbox("A big job!\n");
    setTrigger(608);
    return;
  }
  if (trigger(217) && !trigger(589)) {
    speak(5, "Gabumon came here and\ntalked about being worried\nover doing something.\n");
    showTextbox("I told him to choose\na large scale job.\n");
    setTrigger(589);
    return;
  }
  if (trigger(258) && !trigger(626)) {
    speak(5, "Ninjamon came here and\ntalked about training.\n");
    showTextbox("It's good to see hard workers.\n");
    setTrigger(626);
    return;
  }
  if (trigger(224) && !trigger(596)) {
    speak(5, "Whamon came here talking\nabout taking the\nplace of a ferry boat.\n");
    showTextbox("Great!\n");
    setTrigger(596);
    return;
  }
  if (trigger(252) && !trigger(620)) {
    speak(5, "Mojyamon came here taking\nabout opening\nan Everything Shop.\n");
    showTextbox("Something is different\nabout it, though.\n");
    setTrigger(620);
    return;
  }
  if (trigger(213) && !trigger(587)) {
    speak(5, "Mamemon came here talking\nabout selling treasured Items.\n");
    showTextbox("I wonder what\n'treasured' means?\n");
    setTrigger(587);
    return;
  }
  if (trigger(211) && !trigger(583)) {
    speak(5, "Numemon came here talking\nabout opening a shop.\nbut it's a secret.\n");
    showTextbox("It's no longer a secret.\n");
    setTrigger(583);
    return;
  }
  if (trigger(219) && !trigger(581)) {
    speak(5, "Kabuterimon came here talking\nabout training and remodeling.\n");
