// DG221.SCN
#include "functions.dgs"
#pragma script index=221 start=0xc2000 end=0xc4800 headerU16=0xc sentinelOff=0x19
#include "entities.dgs"

section onEnter(254) {
    // (empty)
}

section(5) {
  if (trigger(203) && !trigger(575)) {
    speak(5, "<LIGHTBLUE><PLAYER><WHITE>, you did it!\n");
    showTextbox("Agumon came to the city.\nHe started a business\nover there.\n");
    showTextbox("Hopefully more Digimon\nwill be like him!\n");
    setTrigger(575);
    return;
  }
  if (trigger(246) && !trigger(614)) {
    speak(5, "Palmon came here, and plans\nto expand the Meat field.\n");
    showTextbox("Then we can get lots of Meat!\n");
    setTrigger(614);
    return;
  }
  if (trigger(232) && !trigger(602)) {
    speak(5, "Kunemon came here, and\nwants to eat grass.\n");
    showTextbox("I hope he'll eat the weeds!\n");
    setTrigger(602);
    return;
  }
  if (trigger(236) && !trigger(606)) {
    speak(5, "Centarumon came here, and\nplans to open up a clinic.\n");
    showTextbox("No more worrying about\ngetting sick or hurt!\n");
    setTrigger(606);
    return;
  }
  if (trigger(249) && !trigger(617)) {
    speak(5, "Coelamon came here and\nhe wants to start a shop.\n");
    showTextbox("The city will flourish!\n");
    setTrigger(617);
    return;
  }
  if (trigger(204) && !trigger(576)) {
    speak(5, "Betamon came here and said\nhe'd like to start a shop.\n");
    showTextbox("The city will flourish!\n");
    setTrigger(576);
    return;
  }
  if (trigger(237) && !trigger(607)) {
    speak(5, "Bakemon came here and said\nsomething I didn't understand.\n");
    showTextbox("Yes, well that's okay.\n");
    setTrigger(607);
    return;
  }
  if (trigger(225) && !trigger(597)) {
    speak(5, "Vegiemon came here. He plans\nto expand the Meat field more.\n");
    showTextbox("No more worries about food.\n");
    setTrigger(597);
    return;
  }
  if (trigger(208) && !trigger(580)) {
    speak(5, "Tyrannomon came here and\nsaid his cooking is the best.\n");
    showTextbox("Well, it has its appeal.\n");
    setTrigger(580);
    return;
  }
  if (trigger(209) && !trigger(581)) {
    speak(5, "Meramon came here and said\nthat he is the chief of flames.\n");
    showTextbox("He's fueled with motivation!\n");
    setTrigger(581);
    return;
  }
  if (trigger(223) && !trigger(595)) {
    speak(5, "Frigimon came here and said\nsomething about snacks.\n");
    showTextbox("I love snacks.\n");
    setTrigger(595);
    return;
  }
  if (trigger(222) && !trigger(594)) {
    speak(5, "Garurumon came here and\nsaid that he can cook.\n");
    showTextbox("He's quite skillful.\n");
    setTrigger(594);
    return;
  }
  if (trigger(221) && !trigger(593)) {
    speak(5, "Birdramon came saying\nhe will be a Messenger.\n");
    showTextbox("Sounds good.\n");
    setTrigger(593);
    return;
  }
  if (trigger(235) && !trigger(605)) {
    speak(5, "Shellmon came here saying\nhe will build bulletin boards.\n");
    showTextbox("A step towards\nan information society!\n");
    setTrigger(605);
    return;
  }
  if (trigger(218) && !trigger(580)) {
    speak(5, "Elecmon came here and will\nturn on the electricity.\n");
    showTextbox("I hope the city is well lit.\n");
    setTrigger(580);
    return;
  }
  if (trigger(250) && !trigger(618)) {
    speak(5, "Kokatorimon came here and\ntalked about making a statue.\n");
    showTextbox("A place where you can relax.\n");
    setTrigger(618);
    return;
  }
  if (trigger(247) && !trigger(588)) {
    speak(5, "Monochromon came here talking\nabout working as an");
    dead_string("? talking\nItem Shop manager.\n");
    showTextbox("He's a professional.\n");
    setTrigger(588);
    return;
  }
  if (trigger(233) && !trigger(603)) {
    speak(5, "Unimon came here talking\nabout being useful in business.\n");
    showTextbox("A good attitude to have.\n");
    setTrigger(603);
    return;
  }
  if (trigger(231) && !trigger(601)) {
    speak(5, "Patamon came here asking\nabout interesting jobs.\n");
    showTextbox("I suggested an Item Shop.\n");
    setTrigger(601);
    return;
  }
  if (trigger(245) && !trigger(613)) {
    speak(5, "Biyomon came here asking\nabout jobs that I'd recommend.\n");
    showTextbox("I suggested an Item Shop.\n");
    setTrigger(613);
    return;
  }
  if (trigger(205) && !trigger(577)) {
    speak(5, "Greymon came here talking\nabout making an Arena.\n");
    showTextbox("I definitely want\nto see that.\n");
    setTrigger(577);
    return;
  }
  if (trigger(257) && !trigger(625)) {
    speak(5, "Penguinmon came here\ntalking about making\na Curling stadium.\n");
