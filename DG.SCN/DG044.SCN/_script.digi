; DG044.SCN
;!script index=44 start=0x22800 end=0x23000 headerU16=0x20 sentinelOff=0x24
;!sections onEnter section_5 section_6 section_7 section_8 section_51 section_52

onEnter:     ; len=68
  0000:  storeRandom 110 99
  0004:  if pstat[110] > 9 then onEnter+0x16
  0010:  spawnItem Digimushroom 29 31
  0016:  storeRandom 110 99
  001a:  if pstat[110] > 14 then onEnter+0x2c
  0026:  spawnItem Digimushroom 27 93
  002c:  storeRandom 110 99
  0030:  if pstat[110] > 4 then onEnter+0x42
  003c:  spawnItem Pricklypear 35 67
  0042:  endSection
