// MAP158.SCN
#pragma script index=158 start=0x6f800 end=0x70000 headerU16=0x20 sentinelOff=0x6925

function speakThenStartBattleThenSetTrigger(a, b, c) {
    speak(a, b);
    startBattle();
    setTrigger(c);
}


section onEnter(254) {
    storeDate(105);
    if (pstat[107] not in 7..19) goto L1;
    goto L2;

L1:
    for id in 19..22 { setObjectVisibility(id, 0); }

L2:
    return;
}

section(5) {
    speakThenStartBattleThenSetTrigger(5, "You don't have any talent!\n", 282);
    return;
}

section(6) {
    speakThenStartBattleThenSetTrigger(6, "Biepi!\n", 287);
    return;
}

section(7) {
    speakThenStartBattleThenSetTrigger(7, "Basuppi, bosuppi!\n", 287);
    return;
}

section(8) {
    speakThenStartBattleThenSetTrigger(8, "Bopeeee!\n", 287);
    return;
}

section(9) {
    speakThenStartBattleThenSetTrigger(9, "Is that all you got?\n", 282);
    return;
}

section(10) {
    speakThenStartBattleThenSetTrigger(10, "Go wash your face and\ncome back again!\n", 282);
