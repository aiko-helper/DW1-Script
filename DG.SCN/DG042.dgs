// DG042.SCN
#include "functions.dgs"
#pragma script index=42 start=0x20000 end=0x20800 headerU16=0x20 sentinelOff=0x24
#include "entities.dgs"

section onEnter(254) {
  spawnItemChance(max: 99, chance: 9, item: Item.Digimushroom, x: 29, y: 31);
  spawnItemChance(max: 99, chance: 14, item: Item.Digimushroom, x: 27, y: 93);
  spawnItemChance(max: 99, chance: 4, item: Item.Pricklypear, x: 35, y: 67);
  return;
}

section(5) {
  speak(Entity(5), "「どつかせんかい!」<NEWLINE>");
  finishEncounter(Trigger(268));
}

section(6) {
  speak(Entity(6), "「おてやわらかにたのむよ。」<NEWLINE>");
  finishEncounter(Trigger(299));
}

section(7) {
  speak(Entity(7), "「ねらったエモノは逃さない。」<NEWLINE>");
  finishEncounter(Trigger(305));
}

section(8) {
  speak(Entity(8), "「フッ、終わりだな…」<NEWLINE>");
  finishEncounter(Trigger(305));
}

section(51) {
  if (!trigger(103)) {
    return;
  }
  move(entity: Entity.Player, to: (10000, -2800), sprint: 0);
  warp(to: Map.GCAN01, spawn: 1, trigger: 255);
}

