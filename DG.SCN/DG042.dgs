    showTextbox("You're not gonna\nmake it home alive!\n");
    fadeOutHUD();
    delay(1);
    startBattle();
    setTrigger(305);
    return;
}

section section_51(51) {  // len=1550
    storeDigimonType(103);
    if (pstat[103] != 6 && pstat[103] != 7 && pstat[103] != 12 && pstat[103] != 19 && pstat[103] != 20) goto L_0022;
    goto L_0066;
L_0022:
    if (pstat[103] != 21 && pstat[103] != 28 && pstat[103] != 33 && pstat[103] != 37 && pstat[103] != 41) goto L_0042;
    goto L_0066;
L_0042:
    if (pstat[103] != 45 && pstat[103] != 31 && pstat[103] != 51 && pstat[103] != 54 && pstat[103] != 55) goto L_0062;
    goto L_0066;
L_0062:
    goto L_01de;
L_0066:
    playAnimation(Entity.Player, 18);
    delay(20);
    setDialogOwner(Entity.Player);
    showTextbox("Ouch!\n");
    setPStat(254, 253);
    callSubroutine(55);
    setDialogOwner(Entity.Player);
    showTextbox("For such a big fall,\nyou look okay.\n");
    look(entity: Entity.Player, at: Entity.Partner);
    delay(20);
    look(entity: Entity.Partner, at: Entity.Player);
    playAnimation(Entity.Player, 19);
    delay(15);
    setDialogOwner(Entity.Player);
    showTextbox("<ORANGE><DIGIMON><WHITE>,\nare you alright?\n");
    playAnimation(Entity.Player, 0);
    showTextbox("Wow, you look okay!\n");
    showTextbox("You flew? That's cheating!\nWell, not really, I guess.\n");
    rotate(entity: Entity.Player, to: 2002);
    delay(20);
    setDialogOwner(Entity.Player);
    showTextbox("Let's go!\n");
    return;
L_01de:
    playAnimation(Entity.Partner, 43);
    playAnimation(Entity.Player, 18);
    delay(40);
    playAnimation(Entity.Partner, 44);
    delay(40);
    playAnimation(Entity.Partner, 0);
    setDialogOwner(Entity.Player);
    showTextbox("Ouch!\n");
    setPStat(254, 253);
    callSubroutine(55);
    setDialogOwner(Entity.Player);
    showTextbox("For such a big fall,\nhe looks okay.\n");
    rotate(entity: Entity.Player, to: 2002);
    delay(20);
    playAnimation(Entity.Player, 19);
    delay(15);
    setDialogOwner(Entity.Player);
    showTextbox("<ORANGE><DIGIMON><WHITE>,\nare you alright?\n");
    playAnimation(Entity.Player, 0);
    showTextbox("I guess it hurts. I'm sorry.\n");
    setDialogOwner(Entity.Player);
    showTextbox("Let's go!\n");
    return;
