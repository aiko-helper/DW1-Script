// DG042.SCN
#include "functions.dgs"
#pragma script index=42 start=0x21800 end=0x22000 headerU16=0x24 sentinelOff=0x24
#include "entities.dgs"

section onEnter(254) {
  spawnItemChance(max: 99, chance: 9, item: Item.Digimushroom, x: 79, y: 63);
  spawnItemChance(max: 99, chance: 14, item: Item.Digimushroom, x: 48, y: 37);
  spawnItemChance(max: 99, chance: 0, item: Item.DeluxeMushroom, x: 48, y: 51);
  return;
}

section(5) {
  speak(5, "Shwaa!\n");
  finishEncounter(302);
}

section(6) {
  speak(6, "Sha sha shaaaa!\n");
  finishEncounter(302);
}

section(7) {
  speak(7, "Doesn't look like he's hurt.\n");
  finishEncounter(299);
}

section(8) {
  speak(8, "I'll give you a discount.\n");
  finishEncounter(268);
}

section(9) {
  speak(9, "Don't make fun of us!\n");
  finishEncounter(268);
}

section(10) {
  speak(10, "You're not gonna\nmake it home alive!\n");
  finishEncounter(305);
}

section(51) {
  storeDigimonType(103);
  if (pstat[103] == 6 || pstat[103] == 7 || pstat[103] == 12 || pstat[103] == 19 || pstat[103] == 20) {
    goto L1;
  }
  if (pstat[103] == 21 || pstat[103] == 28 || pstat[103] == 33 || pstat[103] == 37 || pstat[103] == 41) {
    goto L1;
  }
  if (pstat[103] == 45 || pstat[103] == 31 || pstat[103] == 51 || pstat[103] == 54 || pstat[103] == 55) {
    goto L1;
  }
  goto L2;

L1:
  anim(Entity.Player, 18, wait: 20);
  speak(Entity.Player, "Ouch!\n");
  setPStat(254, 253);
  callSubroutine(55);
  speak(Entity.Player, "For such a big fall,\nyou look okay.\n");
  look(entity: Entity.Player, at: Entity.Partner);
  delay(20);
  look(entity: Entity.Partner, at: Entity.Player);
  anim(Entity.Player, 19, wait: 15);
  speak(Entity.Player, "<ORANGE><DIGIMON><WHITE>,\nare you alright?\n");
  playAnimation(Entity.Player, 0);
  showTextbox("Wow, you look okay!\n");
  showTextbox("You flew? That's cheating!\nWell, not really, I guess.\n");
  rotate(entity: Entity.Player, to: 2002);
  delay(20);
  speak(Entity.Player, "Let's go!\n");
  return;

L2:
  playAnimation(Entity.Partner, 43);
  anim(Entity.Player, 18, wait: 40);
  anim(Entity.Partner, 44, wait: 40);
  playAnimation(Entity.Partner, 0);
  speak(Entity.Player, "Ouch!\n");
  setPStat(254, 253);
  callSubroutine(55);
  speak(Entity.Player, "For such a big fall,\nhe looks okay.\n");
  rotate(entity: Entity.Player, to: 2002);
  delay(20);
  anim(Entity.Player, 19, wait: 15);
  speak(Entity.Player, "<ORANGE><DIGIMON><WHITE>,\nare you alright?\n");
  playAnimation(Entity.Player, 0);
  showTextbox("I guess it hurts. I'm sorry.\n");
  speak(Entity.Player, "Let's go!\n");
  return;
  garbage { 24 00 fe 00 24 00 05 00 68 00 06 00 8a 00 07 00 be 00 08 00 0c 01 09 00 54 01 0a 00 94 01 33 00 f2 01 ff ff 24 00 6e 63 19 00 0b 00 6e 09 18 00 3a 00 19 00 74 2c 4f 00 3f 00 24 00 6e 63 19 00 0b 00 6e 0e 18 00 50 00 19 00 74 2c 30 00 25 00 24 00 6e 63 19 00 0b 00 6e 00 18 00 66 00 19 00 74 2e 30 00 33 00 fe 00 1b 05 1a 00 82 72 82 88 82 97 82 81 82 81 81 49 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 2e 01 fe 00 1b 06 1a 00 82 72 82 88 82 81 81 40 82 93 82 88 82 81 81 40 82 93 82 88 82 81 82 81 82 81 82 81 81 49 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 2e 01 fe 00 1b 07 1a 00 82 63 82 8f 82 85 82 93 82 8e 81 75 82 94 81 40 82 8c 82 8f 82 8f 82 8b 81 40 82 8c 82 89 82 8b 82 85 81 40 82 88 82 85 81 75 82 93 81 40 82 88 82 95 82 92 82 94 81 42 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 2b 01 fe 00 1b 08 1a 00 82 68 81 75 82 8c 82 8c 81 40 82 87 82 89 82 96 82 85 81 40 82 99 82 8f 82 95 81 40 82 81 81 40 82 84 82 89 82 93 82 83 82 8f 82 95 82 8e 82 94 81 42 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 0c 01 fe 00 1b 09 1a 00 82 63 82 8f 82 8e 81 75 82 94 81 40 82 8d 82 81 82 8b 82 85 81 40 82 86 82 95 82 8e 81 40 82 8f 82 86 81 40 82 95 82 93 81 49 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 0c 01 fe 00 1b 0a 1a 00 82 78 82 8f 82 95 81 75 82 92 82 85 81 40 82 8e 82 8f 82 94 81 40 82 87 82 8f 82 8e 82 8e 82 81 0d 00 82 8d 82 81 82 8b 82 85 81 40 82 89 82 94 81 40 82 88 82 8f 82 8d 82 85 81 40 82 81 82 8c 82 89 82 96 82 85 81 49 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 31 01 fe 00 22 67 19 00 08 00 67 06 48 00 67 07 48 00 67 0c 48 00 67 13 48 00 67 14 18 00 14 02 19 00 16 00 58 02 19 00 08 00 67 15 48 00 67 1c 48 00 67 21 48 00 67 25 48 00 67 29 18 00 34 02 19 00 16 00 58 02 19 00 08 00 67 2d 48 00 67 1f 48 00 67 33 48 00 67 36 48 00 67 37 18 00 54 02 19 00 16 00 58 02 16 00 d0 03 56 00 fd 12 67 00 14 00 1b fd 1a 00 82 6e 82 95 82 83 82 88 81 49 0d 00 00 00 1e 00 fe fd 64 37 1b fd 1a 00 82 65 82 8f 82 92 81 40 82 93 82 95 82 83 82 88 81 40 82 81 81 40 82 82 82 89 82