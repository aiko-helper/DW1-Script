// DG042.SCN
#pragma script index=42 start=0x21800 end=0x22000 headerU16=0x24 sentinelOff=0x24

section onEnter(254) {  // len=68
    roll(pstat: 110, max: 99);
    if (pstat[110] > 9) goto L_0016;
    spawnItem(Item.Digimushroom, 79, 63);
L_0016:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 14) goto L_002c;
    spawnItem(Item.Digimushroom, 48, 37);
L_002c:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 0) goto L_0042;
    spawnItem(Item.DeluxeMushroom, 48, 51);
L_0042:
    return;
}

section section_5(5) {  // len=34
    setDialogOwner(5);
    showTextbox("Shwaa!\n");
    fadeOutHUD();
    delay(1);
    startBattle();
    setTrigger(302);
    return;
}

