// source: extract/DIGIMON/SCN/DG.SCN
// DG047.SCN, section 5

section section_5(5) {  // len=136
    setDialogOwner(5);
    showTextbox("Formation C!\n");
    move(entity: 6, to: (-230, 547), sprint: 1);
    move(entity: 7, to: (483, 70), sprint: 1);
    waitForEntity(6);
    waitForEntity(7);
    delay(10);
    setTrigger(1);
    setPStat(250, 1);
    setPStat(251, 5);
    setPStat(252, 6);
    setPStat(253, 7);
    fadeOutHUD();
    delay(1);
    startBattle();
    setPStat(250, 0);
    unsetTrigger(1);
    move(entity: 5, to: (550, -2050), sprint: 1);
    move(entity: 6, to: (550, -2050), sprint: 1);
    move(entity: 7, to: (550, -2050), sprint: 1);
    waitForEntity(5);
    waitForEntity(6);
    waitForEntity(7);
    unloadEntity(5);
    unloadEntity(6);
    unloadEntity(7);
    moveCamera(to: Entity.Player, speed: 10);
    waitForEntity(200);
    return;
}
