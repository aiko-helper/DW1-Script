// DG003.SCN
#include "functions.dgs"
#pragma script index=3 start=0x8000 end=0x8800 headerU16=0x1c sentinelOff=0x24
#include "entities.dgs"

section onEnter(254) {
  roll(pstat: 110, max: 99);
  if (pstat[110] > 3) goto L1;
  spawnItem(Item.BlueApple, x: 37, y: 33);

L1:
  roll(pstat: 110, max: 99);
  if (pstat[110] > 29) goto L2;
  spawnItem(Item.Digimushroom, x: 46, y: 59);

L2:
  roll(pstat: 110, max: 99);
  if (pstat[110] > 15) goto L3;
  spawnItem(Item.Digimushroom, x: 62, y: 54);

L3:
  return;
}

section(5) {
  speak(5, "Get away!\n");
  startBattle();
  setTrigger(280);
  return;
}

section(6) {
  speak(6, "Get lost!\n");
  startBattle();
  setTrigger(280);
  return;
}

section(8) {
  speak(8, "It's mine!\n");
  startBattle();
  setTrigger(280);
  return;
}

section(9) {
  speak(9, "I got it!\n");
  startBattle();
  setTrigger(280);
  return;
}

section(7) {
  setTrigger(44);
  switch (pstat[32]) { case 0: goto L1; case 1: goto L2; case 2: goto L3; case 3: goto L4; }

L1:
  speak(Entity.System, "<YELLOW>? ? ? <WHITE>\n...\n");
  addPStat(32, 1);
  goto L6;

L2:
  speak(Entity.System, "<YELLOW>? ? ? <WHITE>. A flower.\n");
  addPStat(32, 1);
  goto L6;

L3:
  speak(Entity.System, "<YELLOW>? ? ? <WHITE>\nI'm a flower.\n");
  addPStat(32, 1);
  goto L6;

L4:
  speak(Entity.System, "<YELLOW>? ? ? <WHITE>\nI said I'm a flower!\nAren't you listening!?\n");
  playSound(8, 12);
  look(entity: 7, at: Entity.Player);
  delay(20);
  setTrigger(1);
  setPStat(250, 1);
  setPStat(251, 7);
  setPStat(252, 255);
  setPStat(253, 255);
  startBattle();
  unsetTrigger(1);
  setPStat(250, 0);
  look(entity: 7, at: Entity.Player);
  look(entity: Entity.Player, at: 7);
  look(entity: Entity.Partner, at: 7);
  waitForEntity(Entity.Player);
  waitForEntity(Entity.Partner);
  playSound(8, 12);
  speak(7, "I hate fighting.\n");
  playAnimation(Entity.Player, 19);
  speak(Entity.Player, "In that case,\ncome to the city.\n");
  playAnimation(Entity.Player, 19);
  showTextbox("It's peaceful there.\n");
  playAnimation(Entity.Player, 0);
  speak(7, "The city?\n");
  showTextbox("Sounds like fun.\nI'm Palmon.\nYou'll find me useful!\n");
  goto L5;

L5:
  approach(who: 7, x: 170, y: 1863, tries: 3, wait: 18);
  moveCamera(to: Entity.Player, speed: 10);
  playSound(8, 11);
  speak(Entity.System, "Palmon joins the city!\n");
  setPStat(32, 0);
  setTrigger(246);
  addPStat(1, 1);
  return;

L6:
  return;
  garbage { 1c 00 fe 00 1c 00 05 00 60 00 06 00 88 00 08 00 b0 00 09 00 da 00 07 00 02 01 ff ff 24 00 6e 63 19 00 0b 00 6e 03 18 00 32 00 19 00 74 30 25 00 21 00 24 00 6e 63 19 00 0b 00 6e 1d 18 00 48 00 19 00 74 2c 2e 00 3b 00 24 00 6e 63 19 00 0b 00 6e 0f 18 00 5e 00 19 00 74 2c 3e 00 36 00 fe 00 1b 05 1a 00 82 66 82 85 82 94 81 40 82 81 82 97 82 81 82 99 81 49 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 18 01 fe 00 1b 06 1a 00 82 66 82 85 82 94 81 40 82 8c 82 8f 82 93 82 94 81 49 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 18 01 fe 00 1b 08 1a 00 82 68 82 94 81 75 82 93 81 40 82 8d 82 89 82 8e 82 85 81 49 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 18 01 fe 00 1b 09 1a 00 82 68 81 40 82 87 82 8f 82 94 81 40 82 89 82 94 81 49 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 18 01 fe 00 1c 00 2c 00 18 20 04 00 12 01 3a 01 70 01 ac 01 1b ff 1a 00 01 07 81 48 81 40 81 48 81 40 81 48 81 40 01 01 0d 00 81 42 81 42 81 42 0d 00 00 00 1f 00 20 01 16 00 0c 04 1b ff 1a 00 01 07 81 48 81 40 81 48 81 40 81 48 81 40 01 01 81 42 81 40 82 60 81 40 82 86 82 8c 82 8f 82 97 82 85 82 92 81 42 0d 00 00 00 1f 00 20 01 16 00 0c 04 1b ff 1a 00 01 07 81 48 81 40 81 48 81 40 81 48 81 40 01 01 0d 00 82 68 81 75 82 8d 81 40 82 81 81 40 82 86 82 8c 82 8f 82 97 82 85 82 92 81 42 0d 00 00 00 1f 00 20 01 16 00 0c 04 1b ff 1a 00 01 07 81 48 81 40 81 48 81 40 81 48 81 40 01 01 0d 00 82 68 81 40 82 93 82 81 82 89 82 84 81 40 82 68 81 75 82 8d 81 40 82 81 81 40 82 86 82 8c 82 8f 82 97 82 85 82 92 81 49 0d 00 82 60 82 92 82 85 82 8e 81 75 82 94 81 40 82 99 82 8f 82 95 81 40 82 8c 82 89 82 93 82 94 82 85 82 8e 82 89 82 8e 82 87 81 49 81 48 0d 00 00 00 5a 00 08 0c 4c 00 07 fd 67 00 14 00 1c 00 01 00 1e 00 fa 01 1e 00 fb 07 1e 00 fc ff 1e 00 fd ff 27 00 67 00 01 00 66 00 1d 00 01 00 1e 00 fa 00 4c 00 07 fd 4c 00 fd 07 4c 00 fc 07 4a fd 4a fc 5a 00 08 0c 1b 07 1a 00 82 68 81 40 82 88 82 81 82 94 82 85 81 40 82 86 82 89 82 87 82 88 82 94 82 89 82 8e 82 87 81 42 0d 00 00 00 56 00 fd 13 1b fd 1a 00 82 68 82 8e 81 40 82