// DG003.SCN
#include "functions.dgs"
#pragma script index=3 start=0x7800 end=0x8000 headerU16=0x1c sentinelOff=0x24
#include "entities.dgs"

section onEnter(254) {
  spawnItemChance(max: 99, chance: 3, item: Item.BlueApple, x: 37, y: 33);
  spawnItemChance(max: 99, chance: 29, item: Item.Digimushroom, x: 46, y: 59);
  spawnItemChance(max: 99, chance: 15, item: Item.Digimushroom, x: 62, y: 54);
  return;
}

section(5) {
  speak(Entity(5), "「おらおらー!」<NEWLINE>");
  finishEncounter(Trigger(280));
}

section(6) {
  speak(Entity(6), "「っだらぁー!」<NEWLINE>");
  finishEncounter(Trigger(280));
}

section(8) {
  speak(Entity(8), "「いただき!」<NEWLINE>");
  finishEncounter(Trigger(280));
}

section(9) {
  speak(Entity(9), "「もらったぁーっ!」<NEWLINE>");
  finishEncounter(Trigger(280));
}

section(7) {
  {
    setTrigger(Trigger(44));
    switch (pstat[32]) { case 0: break; case 1: goto L1; case 2: goto L2; case 3: goto L3; }
  }
  {
    speak(Entity.System, "<YELLOW>???<WHITE><NEWLINE>「…………」<NEWLINE>");
    addPStat(PStat(32), 1);
    break;

L1:
    speak(Entity.System, "<YELLOW>???<WHITE><NEWLINE>「………花です。」<NEWLINE>");
    addPStat(PStat(32), 1);
    break;

L2:
    speak(Entity.System, "<YELLOW>???<WHITE><NEWLINE>「………ボクは花ですよ。」<NEWLINE>");
    addPStat(PStat(32), 1);
    break;

L3:
    {
      speak(Entity.System, "<YELLOW>???<WHITE><NEWLINE>「花なんだってば!しつこいなー!」<NEWLINE>");
      playSound(8, 12);
      look(entity: Entity(7), at: Entity.Player);
      delay(20);
      setTrigger(Trigger(1));
      setPStat(PStat(250), 1);
      setPStat(PStat(251), 7);
      setPStat(PStat(252), 255);
      setPStat(PStat(253), 255);
      startBattle();
      unsetTrigger(Trigger(1));
      setPStat(PStat(250), 0);
      look(entity: Entity(7), at: Entity.Player);
      lookPairAt(Entity(7));
      waitForPair();
      playSound(8, 12);
      speak(Entity(7), "「あーもう!僕は戦いがキライなんだよー。」<NEWLINE>");
      playAnimation(Entity.Player, Animation(19));
      speak(Entity.Player, "「じゃあさ…」<NEWLINE>");
      playAnimation(Entity.Player, Animation(19));
      showTextbox("「街に来なよ。街の中は平和だぜ。」<NEWLINE>");
      playAnimation(Entity.Player, Animation(0));
      speak(Entity(7), "「街?」<NEWLINE>");
      showTextbox("「面白そうだなー。いいかもね、うん!<NEWLINE> ボク、パルモン。役に立ってみせるよ!」<NEWLINE>");
      break;
    }
    approach(who: Entity(7), x: 170, y: 1863, tries: 3, wait: 18);
    followEntity(Entity.Player, speed: 10);
    playSound(8, 11);
    speak(Entity.System, "パルモンが街に参加した!!!<NEWLINE>");
    setPStat(PStat(32), 0);
    setTrigger(Trigger(246));
    addPStat(PStat(1), 1);
    return;
  }
  return;
  garbage { 1c 00 fe 00 1c 00 05 00 60 00 06 00 86 00 08 00 ac 00 09 00 d0 00 07 00 fa 00 ff ff 24 00 6e 63 19 00 0b 00 6e 03 18 00 32 00 19 00 74 30 25 00 21 00 24 00 6e 63 19 00 0b 00 6e 1d 18 00 48 00 19 00 74 2c 2e 00 3b 00 24 00 6e 63 19 00 0b 00 6e 0f 18 00 5e 00 19 00 74 2c 3e 00 36 00 fe 00 1b 05 1a 00 81 75 82 a8 82 e7 82 a8 82 e7 81 5b 81 49 81 76 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 18 01 fe 00 1b 06 1a 00 81 75 82 c1 82 be 82 e7 82 9f 81 5b 81 49 81 76 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 18 01 fe 00 1b 08 1a 00 81 75 82 a2 82 bd 82 be 82 ab 81 49 81 76 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 18 01 fe 00 1b 09 1a 00 81 75 82 e0 82 e7 82 c1 82 bd 82 9f 81 5b 82 c1 81 49 81 76 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 18 01 fe 00 1c 00 2c 00 18 20 04 00 0a 01 32 01 60 01 96 01 1b ff 1a 00 01 07 81 48 81 48 81 48 01 01 0d 00 81 75 81 63 81 63 81 63 81 63 81 76 0d 00 00 00 1f 00 20 01 16 00 60 03 1b ff 1a 00 01 07 81 48 81 48 81 48 01 01 0d 00 81 75 81 63 81 63 81 63 89 d4 82 c5 82 b7 81 42 81 76 0d 00 00 00 1f 00 20 01 16 00 60 03 1b ff 1a 00 01 07 81 48 81 48 81 48 01 01 0d 00 81 75 81 63 81 63 81 63 83 7b 83 4e 82 cd 89 d4 82 c5 82 b7 82 e6 81 42 81 76 0d 00 00 00 1f 00 20 01 16 00 60 03 1b ff 1a 00 01 07 81 48 81 48 81 48 01 01 0d 00 81 75 89 d4 82 c8 82 f1 82 be 82 c1 82 c4 82 ce 81 49 82 b5 82 c2 82 b1 82 a2 82 c8 81 5b 81 49 81 76 0d 00 00 00 5a 00 08 0c 4c 00 07 fd 67 00 14 00 1c 00 01 00 1e 00 fa 01 1e 00 fb 07 1e 00 fc ff 1e 00 fd ff 27 00 67 00 01 00 66 00 1d 00 01 00 1e 00 fa 00 4c 00 07 fd 4c 00 fd 07 4c 00 fc 07 4a fd 4a fc 5a 00 08 0c 1b 07 1a 00 81 75 82 a0 81 5b 82 e0 82 a4 81 49 96 6c 82 cd 90 ed 82 a2 82 aa 83 4c 83 89 83 43 82 c8 82 f1 82 be 82 e6 81 5b 81 42 81 76 0d 00 00 00 56 00 fd 13 1b fd 1a 00 81 75 82 b6 82 e1 82 a0 82 b3 81 63 81 76 0d 00 00 00 56 00 fd 13 1a 00 81 75 8a 58 82 c9 97 88 82 c8 82 e6 81 42 8a 58 82 cc 92 86 82 cd 95 bd 98 61 82 be 82 ba 81 42 81 76 0d 00 00 00 56 00 fd 00 1b 07 1a 00 81 75 8a 58 81 48 81