// DG080.SCN
#pragma script index=80 start=0x3a000 end=0x3a800 headerU16=0x24 sentinelOff=0x1e

section onEnter(254) {  // len=8
    setPStat(254, 1);
    callSubroutine(25);
    return;
}

section(5) {  // len=58
    setDialogOwner(5);
    showTextbox("I'm gonna get you.\n");
    fadeOutHUD();
    delay(1);
    startBattle();
    setTrigger(268);
    return;
}

section(6) {  // len=74
    setDialogOwner(6);
    showTextbox("Did you come here to lose?\n");
    fadeOutHUD();
    delay(1);
    startBattle();
    setTrigger(268);
    return;
}

section(7) {  // len=64
    setDialogOwner(7);
    showTextbox("You're pretty shabby!\n");
    fadeOutHUD();
    delay(1);
    startBattle();
    setTrigger(306);
    return;
}

section(8) {  // len=78
    setDialogOwner(8);
    showTextbox("Hmmm, you really wanna lose?\n");
    fadeOutHUD();
    delay(1);
    startBattle();
    setTrigger(301);
    return;
}

section(9) {  // len=58
    setDialogOwner(9);
    showTextbox("You're going down!\n");
    fadeOutHUD();
    delay(1);
    startBattle();
    setTrigger(301);
    return;
}

section(10) {  // len=58
    setDialogOwner(10);
    showTextbox("Get out of my way!\n");
    fadeOutHUD();
    delay(1);
    startBattle();
    setTrigger(268);
    return;
}

section(51) {  // len=1614
