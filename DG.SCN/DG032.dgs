// DG032.SCN
#include "functions.dgs"
#pragma script index=32 start=0x1b000 end=0x1b800 headerU16=0x28 sentinelOff=0x24
#include "entities.dgs"

section onEnter(254) {
  spawnItemChance(max: 99, chance: 14, item: Item.Digimushroom, x: 21, y: 31);
  spawnItemChance(max: 99, chance: 7, item: Item.Digimushroom, x: 59, y: 78);
  spawnItemChance(max: 99, chance: 0, item: Item.DeluxeMushroom, x: 60, y: 51);
  return;
}

section(5) {
  speak(Entity(5), "「今日がキミの最後の日になる。」<NEWLINE>");
  finishEncounter(Trigger(301));
}

section(6) {
  speak(Entity(6), "「私の後ろに立つなっ!」<NEWLINE>");
  finishEncounter(Trigger(301));
}

section(7) {
  speak(Entity(7), "「私のかおを見たからには……」<NEWLINE>");
  finishEncounter(Trigger(301));
}

section(8) {
  speak(Entity(8), "「この私にミスは許されない。」<NEWLINE>");
  finishEncounter(Trigger(301));
}

section(9) {
  speak(Entity(9), "「残念だが…キミには消えてもらう!」<NEWLINE>");
  finishEncounter(Trigger(301));
}

section(10) {
  speak(Entity(10), "「逃がさんぞっ!」<NEWLINE>");
  finishEncounter(Trigger(301));
}

section(11) {
  speak(Entity(11), "「うわぁ~ん、負けるもんかぁ!」<NEWLINE>");
  finishEncounter(Trigger(296));
}

section(12) {
  speak(Entity(12), "「もう、絶交だかんなっ!」<NEWLINE>");
  finishEncounter(Trigger(296));
