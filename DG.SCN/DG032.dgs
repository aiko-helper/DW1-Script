// DG032.SCN
#pragma script index=32 start=0x1c800 end=0x1d000 headerU16=0x14 sentinelOff=0x19

section onEnter(254) {  // len=66
    if (!trigger(353) || pstat[30] < 3) goto L_002c;
    setTrigger(126);
    setObjectVisibility(4, 1);
    move(entity: 5, to: (-1134, -566), animDuration: 3);
    delay(5);
    rotate(entity: 5, to: 3072);
    delay(5);
L_002c:
    if (pstat[30] >= 3 || trigger(238)) goto L_0040;
    playAnimation(5, 29);
L_0040:
    return;
}

section section_52(52) {  // len=976
    if (!trigger(238)) goto L_000e;
    return;
L_000e:
    look(entity: 5, at: Entity.Player);
    look(entity: Entity.Player, at: 5);
    delay(5);
    if (trigger(353)) goto L_007e;
    setDialogOwner(5);
    showTextbox("Hey, it'll be open soon!\n");
    rotate(entity: 5, to: 512);
    delay(5);
    playAnimation(5, 29);
    setTrigger(353);
    setPStat(30, 0);
    move(entity: Entity.Player, to: (-334, -853), sprint: 0);
    waitForEntity(Entity.Player);
    return;
L_007e:
    if (!trigger(353) || pstat[30] < 3) goto L_030a;
    setDialogOwner(5);
    showTextbox("We've been waiting for this!\nThe tunnel is open!\n");
    setDialogOwner(Entity.Player);
    showTextbox("We don't have to go over the\nmountain anymore. Thanks.\n");
    setDialogOwner(5);
    showTextbox("Thanks. I couldn't have\nmoved the big rock by myself.\n");
    setDialogOwner(5);
    showTextbox("What should I do now?\n");
    playAnimation(Entity.Player, 19);
    delay(15);
    setDialogOwner(Entity.Player);
    showTextbox("You should come to the city.\nYou'll find things to do!\n");
    playAnimation(Entity.Player, 0);
    setDialogOwner(5);
    showTextbox("I still have lots of energy.\nI gladly accept your offer.\n");
    goto L_0350;
L_030a:
    setDialogOwner(5);
    showTextbox("It'll be open soon!\n");
    rotate(entity: 5, to: 512);
    playAnimation(5, 29);
    delay(5);
    move(entity: Entity.Player, to: (-334, -853), sprint: 0);
    waitForEntity(Entity.Player);
    return;
L_0350:
    move(entity: 5, to: (600, 1700), sprint: 1);
    if (pstat[101] >= 3) goto L_0378;
    addPStat(101, 1);
    delay(25);
    look(entity: Entity.Player, at: 5);
    look(entity: Entity.Partner, at: 5);
    goto L_0350;
L_0378:
    waitForEntity(5);
    unloadEntity(5);
    setPStat(101, 0);
    playSound(8, 8);
    setDialogOwner(Entity.System);
    showTextbox("Drimogemon joins the city!\n");
    moveCamera(to: Entity.Player, speed: 10);
    waitForEntity(200);
    setTrigger(238);
    addPStat(1, 2);
    return;
}

section section_5(5) {  // len=6
    goto section_52;
L_0004:
    return;
}

section section_51(51) {  // len=980
    move(entity: Entity.Player, to: (-1996, -2148), sprint: 0);
    warp(to: Map.MIHA04B, spawn: 2, trigger: 255);
    return;
