// DG032.SCN
#include "functions.dgs"
#pragma script index=32 start=0x1c800 end=0x1d000 headerU16=0x14 sentinelOff=0x19
#include "entities.dgs"

section onEnter(254) {
  if (trigger(353) && pstat[30] >= 3) {
    setTrigger(Trigger(126));
    setObjectVisibility(4, 1);
    move(entity: Entity(5), to: (-1134, -566), animDuration: 3);
    delay(5);
    rotate(entity: Entity(5), to: 3072);
    delay(5);
  }
  if (pstat[30] < 3 && !trigger(238)) {
    playAnimation(Entity(5), Animation(29));
  }
  return;
}

section(52) {
  if (trigger(238)) {
    return;
  }
  look(entity: Entity(5), at: Entity.Player);
  look(entity: Entity.Player, at: Entity(5));
  delay(5);
  if (!trigger(353)) {
    speak(Entity(5), "Hey, it'll be open soon!\n");
    rotate(entity: Entity(5), to: 512);
    delay(5);
    playAnimation(Entity(5), Animation(29));
    setTrigger(Trigger(353));
    setPStat(PStat(30), 0);
    move(entity: Entity.Player, to: (-334, -853), sprint: 0);
    waitForEntity(Entity.Player);
    return;
  }
  if (trigger(353) && pstat[30] >= 3) {
    speak(Entity(5), "We've been waiting for this!\nThe tunnel is open!\n");
    speak(Entity.Player, "We don't have to go over the\nmountain anymore. Thanks.\n");
    speak(Entity(5), "Thanks. I couldn't have\nmoved the big rock by myself.\n");
    speak(Entity(5), "What should I do now?\n");
    anim(Entity.Player, Animation(19), wait: 15);
    speak(Entity.Player, "You should come to the city.\nYou'll find things to do!\n");
    playAnimation(Entity.Player, Animation(0));
    speak(Entity(5), "I still have lots of energy.\nI gladly accept your offer.\n");
  } else {
    speak(Entity(5), "It'll be open soon!\n");
    rotate(entity: Entity(5), to: 512);
    anim(Entity(5), Animation(29), wait: 5);
    move(entity: Entity.Player, to: (-334, -853), sprint: 0);
    waitForEntity(Entity.Player);
    return;
  }
  approach(who: Entity(5), x: 600, y: 1700, tries: 3, wait: 25);
  playSound(8, 8);
  speak(Entity.System, "Drimogemon joins the city!\n");
  followEntity(Entity.Player, speed: 10);
  setTrigger(Trigger(238));
  addPStat(PStat(1), 2);
  return;
}

section(5) {
  goto section_52;

L1:
  return;
}

section(51) {
  move(entity: Entity.Player, to: (-1996, -2148), sprint: 0);
  warp(to: Map.MIHA04B, spawn: 2, trigger: 255);
  return;
