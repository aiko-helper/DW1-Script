// DG032.SCN
#include "functions.dgs"
#pragma script index=32 start=0x1c800 end=0x1d000 headerU16=0x14 sentinelOff=0x19
#include "entities.dgs"

section onEnter(254) {
  if (!trigger(353) || pstat[30] < 3) goto L1;
  setTrigger(126);
  setObjectVisibility(4, 1);
  move(entity: 5, to: (-1134, -566), animDuration: 3);
  delay(5);
  rotate(entity: 5, to: 3072);
  delay(5);

L1:
  if (pstat[30] >= 3 || trigger(238)) goto L2;
  playAnimation(5, 29);

L2:
  return;
}

section(52) {
  if (!trigger(238)) goto L1;
  return;

L1:
  look(entity: 5, at: Entity.Player);
  look(entity: Entity.Player, at: 5);
  delay(5);
  if (trigger(353)) goto L2;
  speak(5, "Hey, it'll be open soon!\n");
  rotate(entity: 5, to: 512);
  delay(5);
  playAnimation(5, 29);
  setTrigger(353);
  setPStat(30, 0);
  move(entity: Entity.Player, to: (-334, -853), sprint: 0);
  waitForEntity(Entity.Player);
  return;

L2:
  if (!trigger(353) || pstat[30] < 3) goto L3;
  speak(5, "We've been waiting for this!\nThe tunnel is open!\n");
  speak(Entity.Player, "We don't have to go over the\nmountain anymore. Thanks.\n");
  speak(5, "Thanks. I couldn't have\nmoved the big rock by myself.\n");
  speak(5, "What should I do now?\n");
  playAnimation(Entity.Player, 19);
  delay(15);
  speak(Entity.Player, "You should come to the city.\nYou'll find things to do!\n");
  playAnimation(Entity.Player, 0);
  speak(5, "I still have lots of energy.\nI gladly accept your offer.\n");
  goto L4;

L3:
  speak(5, "It'll be open soon!\n");
  rotate(entity: 5, to: 512);
  playAnimation(5, 29);
  delay(5);
  move(entity: Entity.Player, to: (-334, -853), sprint: 0);
  waitForEntity(Entity.Player);
  return;

L4:
  approach(who: 5, x: 600, y: 1700, tries: 3, wait: 25);
  playSound(8, 8);
  speak(Entity.System, "Drimogemon joins the city!\n");
  moveCamera(to: Entity.Player, speed: 10);
  waitForEntity(200);
  setTrigger(238);
  addPStat(1, 2);
  return;
}

section(5) {
  goto section_52;

L1:
  return;
}

section(51) {
  move(entity: Entity.Player, to: (-1996, -2148), sprint: 0);
  warp(to: Map.MIHA04B, spawn: 2, trigger: 255);
  return;
