; DG040.SCN
;!script index=40 start=0x20800 end=0x21000 headerU16=0x10 sentinelOff=0x24
;!sections onEnter section_5 section_51

onEnter:     ; len=98
  0000:  storeRandom 110 99
  0004:  if pstat[110] > 9 then onEnter+0x16
  0010:  spawnItem 44 76 78
  0016:  storeRandom 110 99
  001a:  if pstat[110] > 4 then onEnter+0x2c
  0026:  spawnItem 44 31 68
  002c:  storeRandom 110 99
  0030:  if pstat[110] > 6 then onEnter+0x42
  003c:  spawnItem 54 66 68
  0042:  storeRandom 110 99
  0046:  if pstat[110] > 2 then onEnter+0x58
  0052:  spawnItem 69 22 75
  0058:  rotate3DObject 0 1
  005c:  delay 20
  0060:  endSection
