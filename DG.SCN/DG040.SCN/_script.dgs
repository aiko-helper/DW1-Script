// DG040.SCN
#pragma script index=40 start=0x20800 end=0x21000 headerU16=0x10 sentinelOff=0x24
#pragma sections section_0254 section_0005 section_0051

section onEnter(254) {  // len=98
    roll(pstat: 110, max: 99);
    if (pstat[110] > 9) goto L_0016;
    spawnItem(Item.Digimushroom, 76, 78);
L_0016:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 4) goto L_002c;
    spawnItem(Item.Digimushroom, 31, 68);
L_002c:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 6) goto L_0042;
    spawnItem(Item.Pricklypear, 66, 68);
L_0042:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 2) goto L_0058;
    spawnItem(Item.Happymushroom, 22, 75);
L_0058:
    rotate3DObject(0, 1);
    delay(20);
    return;
}
