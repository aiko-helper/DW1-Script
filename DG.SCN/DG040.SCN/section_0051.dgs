    move(entity: Entity.Player, to: (-250, -250), sprint: 0);
    warp(to: Map.OGRE00, spawn: 0, trigger: 255);
L_0030:
    return;
    garbage { 10 00 fe 00 10 00 05 00 72 00 33 00 7e 07 ff ff 24 00 6e 63 19 00 0b 00 6e 09 18 00 26 00 19 00 74 2c 4c 00 4e 00 24 00 6e 63 19 00 0b 00 6e 04 18 00 3c 00 19 00 74 2c 1f 00 44 00 24 00 6e 63 19 00 0b 00 6e 06 18 00 52 00 19 00 74 36 };
