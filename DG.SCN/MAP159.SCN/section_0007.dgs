section section_7(7) {  // len=622
    if (trigger(239)) goto L_0156;
    setTrigger(239);
    addPStat(1, 1);
    setDialogOwner(7);
    showTextbox("Hey guys, are you from ...\nwhat-cha-ma-call-it...city?\n");
    showTextbox("This is just between\nyou and me. I'm interested\na little bit.\n");
    showTextbox("I'll visit you guys\nthere some day.\n");
    return;
L_0156:
    setDialogOwner(7);
    showTextbox("Hey, guys, do you know\nthe Sukamon Tribe's\nspecial Technique?\n");
    showTextbox("We absorb poop on the ground\ninto our bodies and\nturn them into energy!\n");
    return;
}
