section section_82(82) {  // len=1366
    rotate(entity: Entity.Player, to: 2640);
    setTextboxOrigin(1484, 0, -241);
    callSubroutine(39);
    setDialogOwner(200);
    showTextbox(" <GREEN>Training: Hide In Trash <WHITE>\n");
    setSelection(L_0082, L_00c0, L_01a6);
    showTextbox("Begin\nExplain\nQuit\n");
    waitForSelectionChoice();
    return;
L_0082:
    setDialogOwner(200);
    setSelection(L_01a8, L_01b8, L_01a6);
    showTextbox("Normal\nBonus Try\nQuit\n");
    waitForSelectionChoice();
    return;
L_00c0:
    setDialogOwner(200);
    showTextbox("Mental training by putting\nyourself in dirty trash.\nMax MP is greatly boosted.\n");
    setSelection(L_00c0, L_0082, L_01a6);
    showTextbox("Explain again\nBegin\nQuit\n");
    waitForSelectionChoice();
    return;
L_01a6:
    return;
L_01a8:
    fadeOutHUD();
    setPStat(254, 4);
    setPStat(246, 0);
    callDigimonSubroutine(214);
    callSubroutine(7);
    return;
L_01b8:
    setTexboxMode(1, 0);
    setDialogOwner(Entity.System);
    showTextbox(" <YELLOW>Slot Game <WHITE>\nUse <LIGHTBLUE><X> <WHITE>\nto match three pictures.\n");
    setPStat(254, 4);
    setPStat(246, 1);
    callDigimonSubroutine(214);
    callSubroutine(7);
    setTexboxMode(0, 0);
    return;
