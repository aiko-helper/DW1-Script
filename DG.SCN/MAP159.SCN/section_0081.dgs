// source: extract/DIGIMON/SCN/DG.SCN
// MAP159.SCN, section 81

section section_81(81) {  // len=2094
    moveCamera(to: (-1143, 1558), slowdown: 10);
    look(entity: Entity.Player, at: 5);
    look(entity: Entity.Partner, at: 5);
    look(entity: 5, at: Entity.Player);
    delay(5);
    storeDigimonType(103);
    if (!trigger(363) || pstat[103] != 39) goto L_00ee;
    playSound(8, 20);
    setDialogOwner(5);
    showTextbox("You again! Get out of here!\n");
    playAnimation(Entity.Player, 16);
    delay(15);
    setDialogOwner(Entity.Player);
    showTextbox("Uhh...\n");
    playAnimation(Entity.Player, 0);
    setDialogOwner(5);
    showTextbox("You... you're a pest!\nIs that okay now?!\n");
    goto L_0628;
    moveCamera(to: Entity.Player, speed: 10);
    waitForEntity(200);
    return;
L_00ee:
    if (!trigger(363)) goto L_0158;
    playSound(8, 20);
    setDialogOwner(5);
    showTextbox("You again! Get out of here\nright now!\n");
    moveCamera(to: Entity.Player, speed: 10);
    waitForEntity(200);
    return;
L_0158:
    if (pstat[103] != 39) goto L_0264;
    setDialogOwner(5);
    showTextbox("Good to see you, my friends.\nIf you want to live here,\nI give you permission.\n");
    setTrigger(49);
    setDialogOwner(Entity.Player);
    setSelection(L_0268, L_0384);
    showTextbox("We want to live here\nWe want to return\n");
L_0264:
    goto L_06d2;
L_0268:
    unsetTrigger(49);
    playSound(8, 20);
    setDialogOwner(5);
    showTextbox("Hmmm, that's good. What?\nBut you are analog,\nso you can't live here.\n");
    setDialogOwner(Entity.Player);
    showTextbox("We have to be together!\n");
    setDialogOwner(5);
    showTextbox("Then, get out of here\nwith him!\n");
    moveCamera(to: Entity.Player, speed: 10);
    waitForEntity(200);
    return;
L_0384:
    unsetTrigger(49);
    setDialogOwner(5);
    showTextbox("What? What are you saying?\n");
    playAnimation(Entity.Player, 16);
    delay(15);
    setDialogOwner(Entity.Player);
    showTextbox("He's not originally Sukamon.\nKing, please return him\nto his original form!\n");
    playAnimation(Entity.Player, 0);
    setDialogOwner(5);
    showTextbox("Isn't it great that\nhe became Sukamon?\n");
    setDialogOwner(Entity.Player);
    showTextbox("No, it's not very good\nright now. Please.\n");
    setDialogOwner(5);
    showTextbox("Only way to become Sukamon\nis to try hard.\n");
    setDialogOwner(Entity.Player);
    showTextbox("He became a Sukamon\nnaturally and\nthat's the problem.\n");
    playSound(8, 20);
    setDialogOwner(5);
    showTextbox("You guys are unbelievable!\n");
L_0628:
    if (pstat[200] != 39) goto L_063a;
    storeDigimonType(200);
    copyPStat(5, 254);
L_063a:
    fadeOutHUD();
    playAnimation(5, 30);
    playSound(8, 19);
    delay(60);
    callDigimonSubroutine(2);
    waitForEntity(201);
    playAnimation(5, 0);
    delay(5);
    setDialogOwner(Entity.Player);
    showTextbox("Wow! King, thank you!\n");
    playSound(8, 20);
    setDialogOwner(5);
    showTextbox("Get out of here right now!\n");
    setTrigger(363);
    moveCamera(to: Entity.Player, speed: 10);
    waitForEntity(200);
    return;
L_06d2:
    playSound(8, 20);
    setDialogOwner(5);
    showTextbox("Did you come here for\nsomething?\n");
    setDialogOwner(Entity.Player);
    showTextbox("Well...\n");
    setDialogOwner(5);
    showTextbox("If you have a request,\nforget it. Because\nI am King of Sukamon!\n");
    setDialogOwner(Entity.Player);
    showTextbox("I guess I won't be able\nto invite him to the city.\n");
    moveCamera(to: Entity.Player, speed: 10);
    waitForEntity(200);
    return;
}
