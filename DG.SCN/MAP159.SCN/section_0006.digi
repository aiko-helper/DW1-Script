  0000:  if !trigger(362) then section_6+0x176
  000c:  speak 6 "I am collecting\nDigimon cards myself.\n"
  005e:  showTextbox "I really want a King of\nSukamon card. Will you trade\nfor my Etemon card?\n"
  00f4:  if card[21] < 1 then section_6+0x136
  0102:  setDialogOwner Player
  0104:  setSelection section_6+0xd7e section_6+0xe22
  010a:  showTextbox "Trade\nDon't trade\n"
  0132:  waitForSelectionChoice
  0134:  endSection
  0136:  speak Player "Sorry, but I don't have it.\n"
  0174:  endSection
  0176:  playAnimation Player 24
  017a:  delay 15
  017e:  speak Player "Wow it stinks! Is this\nTrash Pile?\n"
  01ca:  showTextbox "I didn't know there's one\nin Digimon World.\n"
  0226:  playAnimation Player 0
  022a:  storeDigimonType 103
  022c:  if trigger(362) OR pstat[103] != 39 then section_6+0x604
  023c:  entityWalkTo 6 192 -2979 0
  0244:  waitForEntity 6
  0246:  speak 6 "I'm glad you came.\nWe welcome new friends.\n"
  02a2:  speak Player "Is this a community for\nthe Sukamon Tribe?\n"
  02fe:  speak 6 "Exactly. This is a paradise\nfor the Sukamon Tribe,\nit's called Dust Kingdom.\n"
  039e:  showTextbox "King of Sukamon is here, too.\n"
  03de:  speak Player "King of Sukamon...?\n"
  040c:  speak 6 "King of Sukamon is amazing!\nIf you don't listen to him,\nyou'll be digivolved!\n"
  04ae:  speak Player "Do you mean we turn into\nsomething besides Sukamon?\n"
  051c:  showTextbox "That means we return\nto our original form?!\n"
  0578:  speak 6 "Yeah, it's scary. Creepy.\n"
  05b2:  speak Player "I learned something useful...\n"
  05f4:  entityWalkTo 6 189 -1273 0
  05fc:  waitForEntity 6
  05fe:  setTrigger 362
  0602:  endSection
  0604:  if trigger(362) OR !trigger(550) then section_6+0x704
  0614:  entityWalkTo 6 192 -2979 0
  061c:  waitForEntity 6
  061e:  speak Player "Oh, Sukamon?!\n"
  0640:  speak 6 "Huh? Do you know about me?\n"
  067c:  speak Player "Well, kind of.\nDo we need to take Sukamon\nto the city as well?\n"
  0700:  jump section_6+0x9bc
  0704:  entityWalkTo 6 192 -2979 0
  070c:  waitForEntity 6
  070e:  speak 6 "Wow, this is interesting!\nI've never seen anything\nlike this!\n"
  0790:  speak Player "Oh my goodness! The poop\nare moving and talking!\n"
  07f8:  speak 6 "Are you talking about me?\nI'm Sukamon...\nI'm a Mutant Digimon.\n"
  087c:  speak Player "You are not poop?\n"
  08a6:  speak 6 "In a way, you are right,\ncuz we are made from\nDigital Waste.\n"
  0926:  speak Player "Should we ask him to come\nto the city, too? We\nshouldn't be prejudiced.\n"
  09bc:  speak 6 "Are you planning to\nlive here?\n"
  0a00:  speak Player "What? I never thought\nabout it.\n"
  0a46:  speak 6 "Well, this is a paradise\nonly for the Sukamon Tribe.\nOthers can't live here.\n"
  0ae6:  speak Player "Then you can't live\nin other places?\n"
  0b36:  speak 6 "Of course not!\nWhat do you think?\n"
  0b80:  speak Player "I see. That's\nwhat I thought.\n"
  0bc2:  speak 6 "Well, although you\ncan't live here,\nyou can look around.\n"
  0c3a:  speak Player "Oh, just to look.Okay.\n"
  0c6e:  speak 6 "Oh, by the way, don't\never make the King mad.\n"
  0cd0:  showTextbox "You'll be turned into\nsomething miserable by the\nKing's Digivolve technique.\n"
  0d6e:  entityWalkTo 6 189 -1273 0
