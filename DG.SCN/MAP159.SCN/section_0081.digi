  0156:  endSection
  0158:  if pstat[103] != 39 then section_81+0x264
  0164:  speak 5 "Good to see you, my friends.\nIf you want to live here,\nI give you permission.\n"
  0206:  setTrigger 49
  020a:  setDialogOwner Player
  020c:  setSelection section_81+0x268 section_81+0x384
  0212:  showTextbox "We want to live here\nWe want to return\n"
  0264:  jump section_81+0x6d2
  0268:  unsetTrigger 49
  026c:  playSound 8 20
  0270:  speak 5 "Hmmm, that's good. What?\nBut you are analog,\nso you can't live here.\n"
  0300:  speak Player "We have to be together!\n"
  0336:  speak 5 "Then, get out of here\nwith him!\n"
  037c:  moveCameraToEntity Player 10
  0380:  waitForEntity 200
  0382:  endSection
  0384:  unsetTrigger 49
  0388:  speak 5 "What? What are you saying?\n"
  03c4:  playAnimation Player 16
  03c8:  delay 15
  03cc:  speak Player "He's not originally Sukamon.\nKing, please return him\nto his original form!\n"
  0468:  playAnimation Player 0
  046c:  speak 5 "Isn't it great that\nhe became Sukamon?\n"
  04c0:  speak Player "No, it's not very good\nright now. Please.\n"
  051a:  speak 5 "Only way to become Sukamon\nis to try hard.\n"
  0576:  speak Player "He became a Sukamon\nnaturally and\nthat's the problem.\n"
  05e8:  playSound 8 20
  05ec:  speak 5 "You guys are unbelievable!\n"
  0628:  if pstat[200] != 39 then section_81+0x63a
