  06ce:  waitForEntity 200
  06d0:  endSection
  06d2:  playSound 8 20
  06d6:  speak 5 "Did you come here for\nsomething?\n"
  071e:  speak Player "Well...\n"
  0734:  speak 5 "If you have a request,\nforget it. Because\nI am King of Sukamon!\n"
