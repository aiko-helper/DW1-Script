  0268:  unsetTrigger 49
  026c:  playSound 8 20
  0270:  setDialogOwner 5
  0272:  showTextbox "Hmmm, that's good. What?\nBut you are analog,\nso you can't live here.\n"
  0300:  setDialogOwner Player
  0302:  showTextbox "We have to be together!\n"
  0336:  setDialogOwner 5
  0338:  showTextbox "Then, get out of here\nwith him!\n"
