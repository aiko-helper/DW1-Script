  03c8:  delay 15
  03cc:  setDialogOwner Player
  03ce:  showTextbox "He's not originally Sukamon.\nKing, please return him\nto his original form!\n"
  0468:  playAnimation Player 0
  046c:  setDialogOwner 5
  046e:  showTextbox "Isn't it great that\nhe became Sukamon?\n"
  04c0:  setDialogOwner Player
  04c2:  showTextbox "No, it's not very good\nright now. Please.\n"
  051a:  setDialogOwner 5
  051c:  showTextbox "Only way to become Sukamon\nis to try hard.\n"
