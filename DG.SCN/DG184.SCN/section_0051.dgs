// source: extract/DIGIMON/SCN/DG.SCN
// DG184.SCN, section 51

section section_51(51) {  // len=4466
    if (!trigger(256)) goto L_000e;
    return;
L_000e:
    if (trigger(50)) goto L_001e;
    goto L_0198;
L_001e:
    look(entity: Entity.Player, at: 8);
    look(entity: Entity.Partner, at: 8);
    delay(5);
    setDialogOwner(Entity.Player);
    showTextbox("!!!\n");
    move(entity: Entity.Player, to: (150, -1050), sprint: 1, withCamera: true);
    move(entity: Entity.Partner, to: (-250, -1050), sprint: 1);
    waitForEntity(Entity.Player);
    waitForEntity(Entity.Partner);
    look(entity: Entity.Player, at: 8);
    look(entity: Entity.Partner, at: 8);
    delay(5);
    setDialogOwner(Entity.Player);
    showTextbox("An egg!\n");
    showTextbox("Could it be Machinedramon's?\n");
    playAnimation(8, 28);
    delay(40);
    setDialogOwner(Entity.Player);
    showTextbox("Could be trouble!\n");
    setTrigger(1);
    setPStat(250, 1);
    setPStat(251, 8);
    setPStat(252, 255);
    setPStat(253, 255);
    fadeOutHUD();
    delay(1);
    startBattle();
    unsetTrigger(1);
    setPStat(250, 0);
    look(entity: Entity.Player, at: 8);
    look(entity: 8, at: Entity.Player);
    look(entity: Entity.Partner, at: 8);
    playSound(8, 3);
    goto L_0116;
L_0116:
    move(entity: 8, to: (0, -2500), sprint: 1);
    if (pstat[101] >= 3) goto L_013e;
    addPStat(101, 1);
    delay(20);
    look(entity: Entity.Player, at: 8);
    look(entity: Entity.Partner, at: 8);
    goto L_0116;
L_013e:
    waitForEntity(8);
    unloadEntity(8);
    setPStat(101, 0);
    playSound(8, 0);
    setDialogOwner(Entity.System);
    showTextbox("Digitamamon joins the city!\n");
    moveCamera(to: Entity.Player, speed: 10);
    waitForEntity(200);
    setTrigger(256);
    addPStat(1, 3);
    return;
L_0198:
    look(entity: Entity.Player, at: 6);
    look(entity: Entity.Partner, at: 6);
    delay(5);
    setDialogOwner(Entity.Player);
    showTextbox("!\n");
    move(entity: Entity.Player, to: (150, -1443), sprint: 1, withCamera: true);
    move(entity: Entity.Partner, to: (-250, -1443), sprint: 1);
    waitForEntity(Entity.Player);
    waitForEntity(Entity.Partner);
    look(entity: Entity.Player, at: 6);
    look(entity: Entity.Partner, at: 6);
    delay(5);
    setDialogOwner(Entity.Player);
    showTextbox("He's there! I found him!\n");
    moveCamera(to: (14, -416), slowdown: 20);
    waitForEntity(200);
    delay(20);
    look(entity: 6, at: Entity.Partner);
    setDialogOwner(Entity.Player);
    showTextbox("You're the boss!\n");
    setDialogOwner(6);
    showTextbox("Nice to meet you.\nI'm Analogman.\n");
    setDialogOwner(6);
    showTextbox("I know all about you, but I\ndidn't know you were a kid.\n");
    showTextbox("I can't believe a kid has\nbeen messing up my plan.\n");
    showTextbox("I was so close to ruling\nthe Net World.\n");
    setDialogOwner(Entity.Player);
    showTextbox("You're a grown up! Stop\nthis, you're hurting everyone.\n");
    setDialogOwner(6);
    showTextbox("I don't care if\nI'm hurting Digimon.\n");
    playAnimation(6, 29);
    delay(20);
    setDialogOwner(6);
    showTextbox("Digimon should obey\nhumans like slaves.\n");
    callSubroutine(51);
    playAnimation(Entity.Player, 19);
    delay(20);
    setDialogOwner(Entity.Player);
    showTextbox("You're wrong! Digimon have\nhearts and minds!\nWe're friends!\n");
    setDialogOwner(6);
    showTextbox("Let's fight and see if\nslaves or friends are better.\n");
    move(entity: 6, to: (780, 530), sprint: 0);
    waitForEntity(6);
    rotate(entity: 6, to: 512);
    delay(20);
    setDigimon(Digimon.Machinedramon, 0, 0);
    callSubroutine(40);
    playAnimation(6, 28);
    playSound(8, 6);
    delay(5);
    setDialogOwner(6);
    showTextbox("Your turn, Machinedramon!\n");
    move(entity: 6, to: (1984, 1681), sprint: 0);
    waitForEntity(6);
    fadeOutHUD();
    rotate(entity: 6, to: 512);
    callDigimonSubroutine(8);
    waitForEntity(201);
    delay(40);
    playAnimation(5, 28);
    playSound(8, 1);
    delay(40);
    setTrigger(1);
    setPStat(250, 1);
    setPStat(251, 5);
    setPStat(252, 255);
    setPStat(253, 255);
    fadeOutHUD();
    delay(1);
    startBattle();
    unsetTrigger(1);
    setPStat(250, 0);
    playAnimation(5, 43);
    waitForEntity(5);
    unloadEntity(5);
    unloadModel(Digimon.Machinedramon);
    setDialogOwner(Entity.Player);
    showTextbox("We did it, <ORANGE><DIGIMON><WHITE>!\n");
    move(entity: Entity.Player, to: (-50, -261), sprint: 1);
    move(entity: Entity.Partner, to: (-50, 424), sprint: 0);
    waitForEntity(Entity.Player);
    waitForEntity(Entity.Partner);
    playAnimation(Entity.Player, 11);
    move(entity: 6, to: (1022, 881), sprint: 0);
    waitForEntity(6);
    setDialogOwner(6);
    showTextbox("No way!\nMy most powerful slave!\n");
    look(entity: Entity.Player, at: 6);
    delay(5);
    look(entity: Entity.Partner, at: 6);
    delay(5);
    setDialogOwner(Entity.Player);
    showTextbox("Look, you were wrong!\n");
    move(entity: 6, to: (915, 774), sprint: 0);
    waitForEntity(6);
    setDialogOwner(6);
    showTextbox("Wow, wow...\n");
    move(entity: 6, to: (738, 597), sprint: 0);
    waitForEntity(6);
    move(entity: Entity.Player, to: (395, 204), sprint: 0, withCamera: true);
    waitForEntity(6);
    look(entity: Entity.Player, at: 6);
    delay(5);
    moveCamera(to: (592, 994), slowdown: 20);
    waitForEntity(200);
    setDialogOwner(Entity.Player);
    showTextbox("If you leave the island\nalone and ask for forgiveness\nthey will forgive you.\n");
    setDialogOwner(6);
    showTextbox("I shouldn't have trusted\nDigimon. I'll do it myself.\n");
    move(entity: 6, to: (592, 574), sprint: 0);
    waitForEntity(6);
    rotate(entity: 6, to: 2048);
    delay(5);
    playAnimation(6, 28);
    playSound(8, 6);
    delay(40);
    setDialogOwner(Entity.Player);
    showTextbox("What are you going to do?!\n");
    rotate(entity: 6, to: 1024);
    delay(5);
    setDialogOwner(Entity.System);
    showTextbox("<YELLOW>Analogman <WHITE>\nI'm going to blow the island\nup and will escape to\nanother world. Too bad kid!\n");
    playAnimation(6, 29);
    delay(40);
    playSound(8, 7);
    setObjectVisibility(11, 0);
    setObjectVisibility(9, 0);
    setObjectVisibility(10, 0);
    setPStat(247, 12);
    setPStat(248, 1);
    callSubroutine(21);
    setPStat(247, 9);
    setPStat(248, 10);
    callSubroutine(21);
    unloadEntity(6);
    setDialogOwner(Entity.Player);
    showTextbox("Oh Noooo!!\n");
    setObjectVisibility(0, 0);
    setPStat(247, 0);
    setPStat(248, 1);
    callSubroutine(21);
    setDialogOwner(Entity.System);
    showTextbox("<YELLOW>Analogman <WHITE>\nYou're done for now!\n");
    setDialogOwner(Entity.Player);
    showTextbox("I'm sorry guys. There's\nnothing I can do now.\n");
    playAnimation(Entity.Player, 22);
    delay(20);
    setDialogOwner(Entity.System);
    showTextbox("<YELLOW>??? <WHITE>\nIt's alright.\n");
    rotate(entity: Entity.Player, to: 1024);
    delay(20);
    rotate(entity: Entity.Player, to: 3072);
    delay(20);
    setDialogOwner(Entity.Player);
    showTextbox("Huh?\n");
    setObjectVisibility(0, 1);
    setObjectVisibility(1, 0);
    setObjectVisibility(2, 0);
    setPStat(247, 1);
    setPStat(248, 2);
    callSubroutine(21);
    setDialogOwner(Entity.System);
    showTextbox("<YELLOW>Analogman <WHITE>\nIt's not transferring!\nSomething is wrong in the\nprogram. What's happening?!\n");
    rotate(entity: Entity.Player, to: 0);
    delay(20);
    setDialogOwner(Entity.Player);
    showTextbox("I can hear everyone's voices!\nWho is there?\n");
    playAnimation(Entity.Player, 23);
    delay(5);
    setDialogOwner(Entity.System);
    showTextbox("<YELLOW>Jijimon <WHITE>\nI am sending our energy\nto you right now.\n");
    setDialogOwner(Entity.System);
    showTextbox("<YELLOW>Tokomon <WHITE>\nCan you hear our voices?\n");
    setDialogOwner(Entity.System);
    showTextbox("<YELLOW>Agumon <WHITE>\nI guess we made it in time!\n");
    setDialogOwner(Entity.Player);
    showTextbox("You all...\n");
    setObjectVisibility(1, 1);
    setObjectVisibility(2, 1);
    setObjectVisibility(3, 0);
    setObjectVisibility(4, 0);
    setPStat(247, 3);
    setPStat(248, 2);
    callSubroutine(21);
    setDialogOwner(Entity.System);
    showTextbox("<YELLOW>Analogman <WHITE>\nNo, this stupid thing! Help!\nHelp me! Ahhhhhhh!!!\n");
    playSound(8, 8);
    setObjectVisibility(3, 1);
    setObjectVisibility(4, 1);
    setObjectVisibility(5, 0);
    delay(40);
    setPStat(247, 5);
    setPStat(248, 1);
    callSubroutine(21);
    delay(20);
    rotate(entity: Entity.Player, to: 2048);
    setObjectVisibility(5, 1);
    setObjectVisibility(9, 1);
    setObjectVisibility(10, 1);
    setObjectVisibility(11, 1);
    setObjectVisibility(6, 0);
    setPStat(247, 6);
    setPStat(248, 1);
    callSubroutine(21);
    delay(4);
    setObjectVisibility(6, 1);
    setObjectVisibility(7, 0);
    setPStat(247, 7);
    setPStat(248, 1);
    callSubroutine(21);
    delay(3);
    setObjectVisibility(7, 1);
    setObjectVisibility(8, 0);
    setPStat(247, 8);
    setPStat(248, 1);
    callSubroutine(21);
    delay(3);
    setObjectVisibility(8, 1);
    delay(10);
    setDialogOwner(Entity.Player);
    showTextbox("He's gone! What happened?\n");
    setDialogOwner(Entity.System);
    showTextbox("<YELLOW>Jijimon <WHITE>\nI don't know. But...\n");
    rotate(entity: Entity.Player, to: 0);
    delay(20);
    setDialogOwner(Entity.Player);
    showTextbox("Jijimon? It's gonna blow!\nDo something!\n");
    setDialogOwner(Entity.System);
    showTextbox("<YELLOW>Jijimon <WHITE>\nHe should be here by now.\n");
    rotate(entity: Entity.Player, to: 1024);
    delay(5);
    moveCamera(to: (-775, 596), slowdown: 20);
    waitForEntity(200);
    delay(10);
    setObjectVisibility(12, 0);
    delay(20);
    loadDigimon(Digimon.NPCAirdramon);
    setDigimon(Digimon.NPCAirdramon, 2, 0);
    look(entity: Entity.Player, at: 7);
    look(entity: Entity.Partner, at: 7);
    move(entity: 7, to: (-808, 124), animDuration: 15);
    delay(40);
    move(entity: Entity.Player, to: (-358, 124), sprint: 1, withCamera: true);
    waitForEntity(Entity.Player);
    setDialogOwner(Entity.Player);
    showTextbox("Airdramon!\n");
    setDialogOwner(7);
    showTextbox("Hurry up, come on!\n");
    move(entity: Entity.Player, to: 7, sprint: 1);
    move(entity: Entity.Partner, to: 7, sprint: 1);
    delay(30);
    setPStat(254, 20);
    callSubroutine(45);
    playSound(8, 12);
    delay(20);
    playSound(8, 13);
    delay(20);
    playSound(8, 14);
    delay(20);
    playSound(8, 12);
    delay(20);
    setDialogOwner(Entity.System);
    showTextbox("Analogman is gone.\n");
    setDialogOwner(Entity.System);
    showTextbox("Peace has returned to\nFile Island.\n");
    setDialogOwner(Entity.System);
    showTextbox("And...\n");
    setTrigger(50);
    setTrigger(212);
    setTrigger(207);
    setTrigger(206);
    addPStat(1, 7);
    roll(pstat: 16, max: 2);
    if (pstat[16] != 0) goto L_114c;
    setPStat(16, 3);
L_114c:
    setPStat(28, 0);
    if (!trigger(220) && !trigger(214) && pstat[1] < 50) goto L_116c;
    warp(to: Map.TEND02, spawn: 0, trigger: 51);
    goto L_1170;
L_116c:
    warp(to: Map.TEND01, spawn: 0, trigger: 51);
L_1170:
    return;
}
