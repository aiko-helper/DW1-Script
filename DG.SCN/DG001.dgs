// DG001.SCN
#include "functions.dgs"
#pragma script index=1 start=0x7000 end=0x7800 headerU16=0x2c sentinelOff=0x24

section onEnter(254) {
    roll(pstat: 110, max: 99);
    if (pstat[110] > 39) goto L1;
    spawnItem(Item.Digimushroom, x: 78, y: 31);

L1:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 1) goto L2;
    spawnItem(Item.DeluxeMushroom, x: 39, y: 43);

L2:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 9) goto L3;
    spawnItem(Item.Digimushroom, x: 35, y: 88);
    spawnItem(Item.Digimushroom, x: 31, y: 85);
    spawnItem(Item.Digimushroom, x: 30, y: 79);

L3:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 14) goto L4;
    spawnItem(Item.Digimushroom, x: 68, y: 84);

L4:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 24) goto L5;
    spawnItem(Item.Digimushroom, x: 49, y: 46);

L5:
    return;
}

section(5) {
    speak(5, "We're ready to begin!\n");
    startBattle();
    setTrigger(283);
    return;
}

section(6) {
    speak(6, "Heave-ho, heave-ho.\n");
    startBattle();
    setTrigger(283);
    return;
}

section(7) {
    speak(7, "I'm going to eat it!\n");
    startBattle();
    setTrigger(277);
    return;
}

section(8) {
    speak(8, "Wait a minute.\n");
    startBattle();
    setTrigger(277);
    return;
}

section(9) {
    speak(9, "Here I go!\n");
    startBattle();
    setTrigger(283);
    return;
}

section(10) {
    speak(10, "Hey, what's the big idea?\n");
    startBattle();
    setTrigger(274);
    return;
}

section(11) {
    speak(11, "Rats! I shouldn't have\ndone it.\n");
    startBattle();
    setTrigger(274);
    return;
}

section(12) {
    speak(12, "Rats, grumble, grumble.\n");
    startBattle();
    setTrigger(274);
    return;
}

section(51) {
    if (!trigger(106)) goto L1;
    move(entity: Entity.Player, to: (-2315, 4000), sprint: 0);
    warp(to: Map.MAYO02_2, spawn: 3, trigger: 255);

L1:
    move(entity: Entity.Player, to: (-2315, 4000), sprint: 0);
    warp(to: Map.MAYO01_2, spawn: 2, trigger: 255);
