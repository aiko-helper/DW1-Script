// DG001.SCN
#include "functions.dgs"
#pragma script index=1 start=0x6800 end=0x7000 headerU16=0x2c sentinelOff=0x24
#include "entities.dgs"

section onEnter(254) {
  spawnItemChance(max: 99, chance: 39, item: Item.Digimushroom, x: 78, y: 31);
  spawnItemChance(max: 99, chance: 1, item: Item.DeluxeMushroom, x: 39, y: 43);
  roll(pstat: PStat.RollScratch, max: 99);
  if (pstat[110] <= 9) {
    spawnItem(Item.Digimushroom, x: 35, y: 88);
    spawnItem(Item.Digimushroom, x: 31, y: 85);
    spawnItem(Item.Digimushroom, x: 30, y: 79);
  }
  spawnItemChance(max: 99, chance: 14, item: Item.Digimushroom, x: 68, y: 84);
  spawnItemChance(max: 99, chance: 24, item: Item.Digimushroom, x: 49, y: 46);
  return;
}

section(5) {
  speak(Entity(5), "「さあ、これからだよ!」<NEWLINE>");
  finishEncounter(Trigger(283));
}

section(6) {
  speak(Entity(6), "「よいしょ、よいしょ。」<NEWLINE>");
  finishEncounter(Trigger(283));
}

section(7) {
  speak(Entity(7), "「食べちゃいマスネ!」<NEWLINE>");
  finishEncounter(Trigger(277));
}

section(8) {
  speak(Entity(8), "「チョット、マッテクダサ~イデス。」<NEWLINE>");
  finishEncounter(Trigger(277));
}

section(9) {
  speak(Entity(9), "「いっくよー!」<NEWLINE>");
  finishEncounter(Trigger(283));
}

section(10) {
  speak(Entity(10), "「何だよっ、俺が何したのさ?」<NEWLINE>");
  finishEncounter(Trigger(274));
}

section(11) {
  speak(Entity(11), "「やっぱり、止めときゃよかった…」<NEWLINE>");
  finishEncounter(Trigger(274));
}

section(12) {
  speak(Entity(12), "「まったく…、ブツブツブツブツ…」<NEWLINE>");
  finishEncounter(Trigger(274));
}

section(51) {
  if (trigger(106)) {
    move(entity: Entity.Player, to: (-2315, 4000), sprint: 0);
    warp(to: Map.MAYO02_2, spawn: 3, trigger: 255);
  }
  move(entity: Entity.Player, to: (-2315, 4000), sprint: 0);
  warp(to: Map.MAYO01_2, spawn: 2, trigger: 255);
  return;
