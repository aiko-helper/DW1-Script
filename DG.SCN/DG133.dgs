// DG133.SCN
#include "functions.dgs"
#pragma script index=133 start=0x57000 end=0x58000 headerU16=0x1c sentinelOff=0x2964
#include "entities.dgs"

section onEnter(254) {
  callSubroutine(41);
  if (trigger(350)) {
    setPStat(PStat(245), 4);
    setBGM(22);
    setPStat(PStat(254), 0);
    callSubroutine(42);
    loadAndSetDigimon(Digimon.Hagurumon, Entity(1), 0);
    move(entity: Entity(6), to: (-100, 1758), animDuration: 1);
    waitForEntity(Entity(6));
    playAnimation(Entity(6), Animation(29));
    rotate(entity: Entity(6), to: 0);
  }
  return;
}

section(51) {
  if (!trigger(350) && trigger(270)) {
    move(entity: Entity.Player, to: (-52, 650), sprint: 0, withCamera: true);
    waitForEntity(Entity.Player);
    rotate(entity: Entity.Player, to: 2065);
    delay(5);
    goto section_5;
  }
  return;
}

section(5) {
  if (trigger(270) && !trigger(350) && item[Item.Gear] >= 1) {
    removeItem(Item.Gear, 1);
    loadAndSetDigimon(Digimon.Hagurumon, Entity(1), 0);
    playAnimation(Entity(6), Animation(29));
    anim(Entity.Player, Animation(15), wait: 20);
    playSound(8, 4);
    anim(Entity.Player, Animation(16), wait: 15);
    speak(Entity.Player, "「何だぁ?!」<NEWLINE>");
    playAnimation(Entity.Player, Animation(0));
    look(entity: Entity.Player, at: Entity(6));
    sfx(8, 9, wait: 10);
    speak(Entity(5), "「あっ、おかえりハグルモン!」<NEWLINE>");
    speak(Entity.Player, "「ハグルモン?!」<NEWLINE>");
    playSound(8, 8);
    moveCamera(to: (-80, 1048), slowdown: 18);
    move(entity: Entity(6), to: (-100, 1758), animDuration: 20);
    waitForEntity(Entity(6));
    rotate(entity: Entity(6), to: 0);
    delay(5);
    playAnimation(Entity(6), Animation(30));
    anim(Entity.Player, Animation(16), wait: 15);
    speak(Entity.Player, "「何だ何だ?!」<NEWLINE>");
    playAnimation(Entity.Player, Animation(0));
    setPStat(PStat(254), 1);
    callSubroutine(42);
    goto L1;
  }
  {
    break;

L1:
    moveCamera(to: (-80, 1048), slowdown: 18);
    setPStat(PStat(245), 4);
    setBGM(22);
    move(entity: Entity(7), to: (248, -447), sprint: 0);
    move(entity: Entity(8), to: (-747, 459), sprint: 0);
    waitForEntity(Entity(7));
    waitForEntity(Entity(8));
    for x in [Entity(5), Entity(7), Entity(8)] {
      playAnimation(x, Animation(29));
    }
    delay(10);
    playSound(8, 9);
    speak(Entity.System, " <YELLOW>おもちゃ達<WHITE><NEWLINE>「昔むかしのお話だよ」<NEWLINE>「悪いやつがどこか遠くから」<NEWLINE>「この島へやってきたよ」<NEWLINE>");
    for x in [Entity(5), Entity(7), Entity(8)] {
      playAnimation(x, Animation(29));
    }
    delay(10);
    playSound(8, 9);
    speak(Entity.System, " <YELLOW>おもちゃ達<WHITE><NEWLINE>「悪いやつはデジモン達に言ったよ」<NEWLINE>「この島は俺のものだ」<NEWLINE>");
    for x in [Entity(5), Entity(7), Entity(8)] {
      playAnimation(x, Animation(29));
    }
    delay(10);
    playSound(8, 9);
    speak(Entity.System, " <YELLOW>おもちゃ達<WHITE><NEWLINE>「島のデジモンたちはわるいやつに」<NEWLINE>「それはちがう」<NEWLINE>「この島はみんなのものだと」<NEWLINE>");
    for x in [Entity(5), Entity(7), Entity(8)] {
      playAnimation(x, Animation(29));
    }
    delay(10);
    playSound(8, 9);
    speak(Entity.System, " <YELLOW>おもちゃ達<WHITE><NEWLINE>「たたかいをいどんだよ」<NEWLINE>「すべてのデジモンの協力で」<NEWLINE>「悪いやつはこらしめられたよ」<NEWLINE>");
    for x in [Entity(5), Entity(7), Entity(8)] {
      playAnimation(x, Animation(29));
    }
    delay(10);
    playSound(8, 9);
    speak(Entity.System, " <YELLOW>おもちゃ達<WHITE><NEWLINE>「でも悪いやつは」<NEWLINE>「今に見ていろと」<NEWLINE>「どこかへいっちゃったよ」<NEWLINE>");
    for x in [Entity(5), Entity(7), Entity(8)] {
      playAnimation(x, Animation(29));
    }
    delay(10);
    playSound(8, 9);
    speak(Entity.System, " <YELLOW>おもちゃ達<WHITE><NEWLINE>「昔むかしのお話だよ」<NEWLINE>");
    for x in [Entity(5), Entity(7), Entity(8)] {
      playAnimation(x, Animation(0));
    }
    delay(10);
    if (trigger(350)) {
      return;
    }
    setTrigger(Trigger(350));
    speak(Entity.Player, "「ふえ~何か楽しい気分に…<NEWLINE> おっと違う!」<NEWLINE>");
    showTextbox("「今の歌の話って、この島の昔話だよな。<NEWLINE> 昔、悪いやつをデジモンがやっつけた<NEWLINE> っていう…」<NEWLINE>");
    showTextbox("「ふーむ…悪いやつ…<NEWLINE> いったい何者だろう?」<NEWLINE>");
    playSound(8, 8);
    speak(Entity(5), "「助けてくれてありがとうナノ。<NEWLINE> これはお礼ダヨ。」<NEWLINE>");
    setTrigger(Trigger(214));
    addPStat(PStat(1), 3);
    playSound(8, 10);
    speak(Entity.System, " <NEWLINE> もんざえモンのぬいぐるみが<NEWLINE> 街に参加した!!!<NEWLINE>");
    followEntity(Entity.Player, speed: 15);
    setPStat(PStat(254), 0);
    callSubroutine(42);
    return;
  }
  if (trigger(270) && trigger(350) && item[Item.Gear] < 1 && !trigger(350)) {
    speak(Entity(5), "「あれっ、ワルモンザエモンが<NEWLINE> 何かおとさなかったカイ?」<NEWLINE>");
    return;
  }
  if (trigger(349) && !trigger(270)) {
    speak(Entity(5), "「ガンバッテ!となりの家ヨ!」<NEWLINE>");
    return;
  }
  storeDigimonType(PStat(103));
  {
    if (pstat[103] == 14 && !trigger(349)) {
      break;
    } else {
      speak(Entity(5), "「……」<NEWLINE>");
      return;
    }
    if (!trigger(350)) break;
    speak(Entity(5), "「もう一度合唱を聞くノ?」<NEWLINE>");
    setDialogOwner(Entity.Player);
    setSelection(L1, L2);
    showTextbox("「うん。」<NEWLINE>「いいや。」<NEWLINE>");
    waitForSelectionChoice();
    return;
  }
  setTrigger(Trigger(349));
  speak(Entity(5), "「あっ、もんざえモン!<NEWLINE> 復活したんダネ!」<NEWLINE>");
  speak(Entity.Player, "「わ、何だろ?」<NEWLINE>");
  speak(Entity(5), "「早くワルモンザエモンをやっつけてヨ!<NEWLINE> みんな動かなくなっちゃってサ!<NEWLINE> 早く早く!」<NEWLINE>");
  speak(Entity.Player, "「ちょ、ちょっと待って!<NEWLINE> こいつはおまえの知ってる<NEWLINE> もんざえモンとはちがうんだよ。」<NEWLINE>");
  speak(Entity(5), "「え?困ったナ。でももんざえモンでショ?」<NEWLINE>");
  anim(Entity.Player, Animation(25), wait: 15);
  speak(Entity.Player, "「まあ…もんざえモンであることは<NEWLINE> まちがいないけどね。」<NEWLINE>");
  playAnimation(Entity.Player, Animation(0));
  speak(Entity(5), "「じゃあ、たのむヨ。ワルモンザエモンって<NEWLINE> いう、ワルーーーーーーーーーいやつが、<NEWLINE> ボクの仲間をさらっていったんだ。」<NEWLINE>");
  speak(Entity(5), "「あいつをやっつけられるのは、たぶん<NEWLINE> もんざえモンしかいないヨ!」<NEWLINE>");
  speak(Entity.Player, "「んむむ。それは見逃すわけにはいかないな。<NEWLINE> よーし、そいつはどこにいるんだ?」<NEWLINE>");
  speak(Entity(5), "「となりの家にいるヨ。トビラのふういんを<NEWLINE> とくから、行ってみてヨ。」<NEWLINE>");
  speak(Entity.Player, "「そっか、OK。助けてやるからな!」<NEWLINE>");
  return;

L2:
  return;
}

section(6) {
  playSound(8, 8);
  speak(Entity(6), "「アリガトウ!」<NEWLINE>");
  return;
}

section(7) {
  if (trigger(350)) {
    playSound(8, 9);
    speak(Entity(7), "「アリガトウ!」<NEWLINE>");
  }
  return;
}

section(8) {
  if (trigger(350)) {
    playSound(8, 9);
    speak(Entity(8), "「アリガトウ!」<NEWLINE>");
  }
  return;
  garbage { 1c 00 fe 00 1c 00 33 00 50 00 05 00 78 00 06 00 f4 09 07 00 12 0a 08 00 3c 0a ff ff 64 29 19 00 00 00 5e 01 18 00 4e 00 19 00 1e 00 f5 04 5d 16 1e 00 fe 00 64 2a 46 7a 47 7a 01 00 6c 06 9c ff de 06 01 00 4a 06 56 00 06 1d 4d 06 00 00 fe 00 19 00 01 00 5e 01 80 00 0e 01 18 00 76 00 19 00 52 fd cc ff 8a 02 00 00 4a fd 4d fd 11 08 67 00 05 00 16 00 78 00 fe 00 19 00 00 00 0e 01 81 00 5e 01 a4 00 78 02 01 00 18 00 64 01 19 00 29 00 78 01 46 7a 47 7a 01 00 56 00 06 1d 56 00 fd 0f 67 00 14 00 5a 00 08 04 56 00 fd 10 67 00 0f 00 1b fd 1a 00 81 75 89 bd 82 be 82 9f 81 48 81 49 81 76 0d 00 00 00 56 00 fd 00 4c 00 fd 06 5a 00 08 09 67 00 0a 00 1b 05 1a 00 81 75 82 a0 82 c1 81 41 82 a8 82 a9 82 a6 82 e8 83 6e 83 4f 83 8b 83 82 83 93 81 49 81 76 0d 00 00 00 1b fd 1a 00 81 75 83 6e 83 4f 83 8b 83 82 83 93 81 48 81 49 81 76 0d 00 00 00 5a 00 08 08 4f 12 b0 ff 18 04 6c 06 9c ff de 06 14 00 4a 06 4d 06 00 00 67 00 05 00 56 00 06 1e 56 00 fd 10 67 00 0f 00 1b fd 1a 00 81 75 89 bd 82 be 89 bd 82 be 81 48 81 49 81 76 0d 00 00 00 56 00 fd 00 1e 00 fe 01 64 2a 16 00 68 01 16 00 a8 05 4f 12 b0 ff 18 04 1e 00 f5 04 5d 16 4e 07 f8 00 41 fe 00 00 4e 08 15 fd cb 01 00 00 4a 07 4a 08 56 00 05 1d 56 00 07 1d 56 00 08 1d 67 00 0a 00 5a 00 08 09 1b ff 1a 00 81 40 01 07 82 a8 82 e0 82 bf 82 e1 92 42 01 01 0d 00 81 75 90 cc 82 de 82 a9 82 b5 82 cc 82 a8 98 62 82 be 82 e6 81 76 0d 00 81 75 88 ab 82 a2 82 e2 82 c2 82 aa 82 c7 82 b1 82 a9 89 93 82 ad 82 a9 82 e7 81 76 0d 00 81 75 82 b1 82 cc 93 87 82 d6 82 e2 82 c1 82 c4 82 ab 82 bd 82 e6 81 76 0d 00 00 00 56 00 05 1d 56 00 07 1d 56 00 08 1d 67 00 0a 00 5a 00 08 09 1b ff 1a 00 81 40 01 07 82 a8 82 e0 82 bf 82 e1 92 42 01 01 0d 00 81 75 88 ab 82 a2 82 e2 82 c2 82 cd 83 66 83 57 83 82 83 93 92 42 82 c9 8c be 82 c1 82 bd 82 e6 81 76 0d 00 81 75 82 b1 82 cc 93 87 82 cd 89 b4 82 cc 82 e0 82 cc 82 be 81 76 0d 00 00 00 56 00 05 1d 56 00 07 1d 56 00 08 1d 67 00 0a 00 5a 00 08 09 1b ff 1a 00 81 40 01 07 82 a8 82 e0 82 bf 82 e1 92 42 01 01 0d 00 81