; DG090.SCN
;!script index=90 start=0x3f800 end=0x40000 headerU16=0x20 sentinelOff=0x24
;!sections onEnter section_5 section_6 section_7 section_8 section_51 section_52

onEnter:     ; len=84
  0000:  storeRandom 110 99
  0004:  if pstat[110] > 5 then onEnter+0x16
  0010:  spawnItem Digimushroom 63 41
  0016:  storeRandom 110 99
  001a:  if pstat[110] > 15 then onEnter+0x2c
  0026:  spawnItem Digimushroom 47 38
  002c:  storeRandom 110 99
  0030:  if pstat[110] > 19 then onEnter+0x42
  003c:  spawnItem Digimushroom 34 55
  0042:  if !trigger(133) then onEnter+0x52
  004e:  setObjectVisibility 35 1
  0052:  endSection
