section onEnter(254) {  // len=84
    roll(pstat: 110, max: 99);
    if (pstat[110] > 5) goto L_0016;
    spawnItem(Item.Digimushroom, 63, 41);
L_0016:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 15) goto L_002c;
    spawnItem(Item.Digimushroom, 47, 38);
L_002c:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 19) goto L_0042;
    spawnItem(Item.Digimushroom, 34, 55);
L_0042:
