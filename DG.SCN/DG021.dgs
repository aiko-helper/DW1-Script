// DG021.SCN
#pragma script index=21 start=0x15000 end=0x15800 headerU16=0x1c sentinelOff=0x24

section onEnter(254) {
    roll(pstat: 110, max: 99);
    if (pstat[110] > 6) goto L1;
    spawnItem(Item.Digimushroom, x: 52, y: 26);

L1:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 14) goto L2;
    spawnItem(Item.Digimushroom, x: 40, y: 61);

L2:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 1) goto L3;
    spawnItem(Item.DeluxeMushroom, x: 64, y: 61);

L3:
    return;
}

section(5) {
    speak(5, "No way!\n");
    startBattle();
    setTrigger(268);
    return;
}

section(6) {
    speak(6, "Leave something before you go.\n");
    startBattle();
    setTrigger(280);
    return;
}

section(7) {
    speak(7, "I accept your challenge!\n");
    startBattle();
    setTrigger(268);
    return;
}

section(8) {
    speak(8, "Wait!\n");
    startBattle();
    setTrigger(280);
    return;
}

section(51) {
    move(entity: Entity.Player, to: (-440, -5000), sprint: 0);
    if (!trigger(353) || pstat[30] < 3) goto L1;
    setTrigger(126);

L1:
    if (!trigger(126)) goto L2;
    warp(to: Map.MIHA04B, spawn: 0, trigger: 255);

L2:
    warp(to: Map.MIHA04A, spawn: 0, trigger: 255);
