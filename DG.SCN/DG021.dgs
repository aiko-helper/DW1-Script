// DG021.SCN
#include "functions.dgs"
#pragma script index=21 start=0x14000 end=0x15000 headerU16=0x18 sentinelOff=0x24
#include "entities.dgs"

section onEnter(254) {
  spawnItemChance(max: 99, chance: 14, item: Item.Digimushroom, x: 15, y: 41);
  spawnItemChance(max: 99, chance: 14, item: Item.Digimushroom, x: 49, y: 28);
  spawnItemChance(max: 99, chance: 14, item: Item.Digimushroom, x: 63, y: 67);
  spawnItemChance(max: 99, chance: 14, item: Item.Digimushroom, x: 25, y: 64);
  spawnItemChance(max: 99, chance: 5, item: Item.Happymushroom, x: 84, y: 49);
  spawnChest(Item.MediumRecovery, 3545, 855, 1024, 696);
  spawnChest(Item.MediumMP, 3545, 455, 1024, 697);
  spawnChest(Item.Various, 3545, 155, 1024, 698);
  if (!trigger(233) && trigger(53)) {
    playAnimation(Entity(5), Animation(28));
  }
  return;
}

section(5) {
  speak(Entity(5), "「羽を…」<NEWLINE>");
  anim(Entity.Player, Animation(19), wait: 20);
  speak(Entity.Player, "「どうしたんだ?」<NEWLINE>");
  speak(Entity(5), "「羽を…ケガしてしまって…<NEWLINE> 何かキズを治すものを持ってないか?」<NEWLINE>");
  anim(Entity.Player, Animation(4), wait: 20);
  speak(Entity.Player, "「ひどいケガだ…!<NEWLINE> ちょっと待ってろ。えっと…」<NEWLINE>");
  playAnimation(Entity.Player, Animation(0));
  setTrigger(Trigger(3));
  callSubroutine(0);
  {
    if (trigger(3)) {
      speak(Entity.Player, "「今、何も無いんだった…」<NEWLINE>");
      break;
    }
    {
      if (pstat[254] == 0 || pstat[254] == 1 || pstat[254] == 2 || pstat[254] == 3) {
        callSubroutine(12);
        break;
      }
      if (pstat[254] == 7 || pstat[254] == 9 || pstat[254] == 13 || pstat[254] == 14) {
        callSubroutine(12);
        break;
        break;
      }
      speak(Entity.Player, "「だめだ、これじゃあ。」<NEWLINE>");
      goto L1;
    }
    {
      speak(Entity(5), "「ふぅ…だいぶ良くなった。<NEWLINE> ありがとう。」<NEWLINE>");
      playAnimation(Entity(5), Animation(29));
      waitForEntity(Entity(5));
      anim(Entity.Player, Animation(25), wait: 20);
      speak(Entity.Player, "「もう、飛べるの?」<NEWLINE>");
      speak(Entity(5), "「…まだ長距離はどうか…」<NEWLINE>");
      anim(Entity.Player, Animation(19), wait: 20);
      speak(Entity.Player, "「そうか…そうだ、街には医院がある。<NEWLINE> そこでみてもらうといいよ。<NEWLINE> ここからそんなに遠くないし。」<NEWLINE>");
      speak(Entity(5), "「それはすごい。街のうわさは耳にして<NEWLINE> いたが、もうそんなに発展していたのか。」<NEWLINE>");
      speak(Entity.Player, "「へへ。街でゆっくり休んでいってよ。」<NEWLINE>");
      speak(Entity(5), "「すまない…。必ず恩にむくいるよ。」<NEWLINE>");
      break;
    }
    loop {
      move(entity: Entity(5), to: (-192, -1849), sprint: 1);
      if (pstat[101] >= 10) break;
      addPStat(PStat.LoopIterator, 1);
      sfx(8, 0, wait: 15);
      lookPairAt(Entity(5));
    }
    waitForEntity(Entity(5));
    unloadEntity(Entity(5));
    setPStat(PStat.LoopIterator, 0);
    playSound(8, 9);
    speak(Entity.System, "ユニモンが街に参加した!!!<NEWLINE>");
    setTrigger(Trigger(233));
    addPStat(PStat(1), 2);
    goto L2;

L1:
  }
  speak(Entity.Player, "「キズをなおすもの…<NEWLINE> わかった。何か持ってくるよ。」<NEWLINE>");
  speak(Entity(5), "「すまない…早いとこたのむよ…」<NEWLINE>");
  goto L2;

L2:
  return;
}

section(6) {
  return;
}

section(51) {
  if (!trigger(118)) {
    goto L1;
  }
  if (!trigger(154) && trigger(152) && !trigger(153)) {
  } else {
    if (trigger(153) && !trigger(228)) {
      goto L2;
    } else {
      goto L3;

L1:
    }
    speak(Entity.System, "地面に不思議な模様がえがかれている…<NEWLINE>");
    speak(Entity.Player, "「ミステリー・サークルというやつかな?<NEWLINE> まだそんなに古いものじゃないな。」<NEWLINE>");
    setTrigger(Trigger(118));
    setTrigger(Trigger(152));
    return;
  }
  speak(Entity.Player, "「前に見た時より増えてる!<NEWLINE> これって謎の飛行物体ってやつと<NEWLINE> 関係あるのかな…」<NEWLINE>");
  setTrigger(Trigger(154));
  setTrigger(Trigger(153));
  return;

L2:
  {
    speak(Entity.Player, "「うおお!?<NEWLINE> 増えてる、めちゃ増えてるよ!」<NEWLINE>");
    showTextbox("「こりゃいよいよ…」<NEWLINE>");
    playSound(8, 5);
    speak(Entity.Player, "「ん?」<NEWLINE>");
    rotate(entity: Entity.Player, to: 2560);
    setDigimon(Digimon.NPCUnimon, Entity(1), 0);
    panTo(x: -335, y: 285, slowdown: 20);
    move(entity: Entity(6), to: (1139, 1029), sprint: 1);
    playSound(8, 5);
    waitForEntity(Entity(6));
    move(entity: Entity(6), to: (-327, 459), sprint: 1);
    playSound(8, 5);
    waitForEntity(Entity(6));
    move(entity: Entity(6), to: (269, -973), sprint: 1);
    playSound(8, 5);
    waitForEntity(Entity(6));
    moveCamera(to: Entity.Player, speed: 10);
    move(entity: Entity(6), to: (-747, -1106), sprint: 0);
    playSound(8, 5);
    waitForEntity(Entity(6));
    look(entity: Entity(6), at: Entity.Player);
    speak(Entity.System, "(ベーダモンUFO登場)<NEWLINE>");
    speak(Entity.Player, "「う…宇宙人!?」<NEWLINE>");
    speak(Entity(6), "「………」<NEWLINE>");
    speak(Entity.Player, "「デジモン…なのか…?」<NEWLINE>");
    speak(Entity(6), "「………」<NEWLINE>");
    speak(Entity.Player, "「あのー…」<NEWLINE>");
    speak(Entity(6), "「………」<NEWLINE>");
    sfx(8, 6, wait: 10);
    speak(Entity.System, "(ベーダモン、銃をかまえる)<NEWLINE>");
    speak(Entity.Player, "「わっ、ちがう、俺達は敵じゃないっ!」<NEWLINE>");
    speak(Entity.System, "(ベーダモン、銃をしまう)<NEWLINE>");
    speak(Entity.Player, "「(分かってもらえたのか?よーし…)」<NEWLINE>");
    speak(Entity.System, "<LIGHTBLUE><PLAYER><WHITE>は必死に説得した!!<NEWLINE>");
    speak(Entity(6), "「………」<NEWLINE>");
    speak(Entity.Player, "「(だめか…?)」<NEWLINE>");
    speak(Entity(6), "「イーヨ。」<NEWLINE>");
    fadeOutHUD();
    break;
  }
  loop {
    move(entity: Entity(6), to: (199, -3166), sprint: 1);
    if (pstat[101] >= 2) break;
    addPStat(PStat.LoopIterator, 1);
    sfx(8, 5, wait: 40);
    lookPairAt(Entity(6));
  }
  waitForEntity(Entity(6));
  unloadEntity(Entity(6));
  setPStat(PStat.LoopIterator, 0);
  playSound(8, 9);
  speak(Entity.System, "ベーダモンが街に参加した!<NEWLINE>");
  speak(Entity.Player, "「あ…あいつ……」<NEWLINE>");
  showTextbox("「しゃべれるんじゃん!!」<NEWLINE>");
  setTrigger(Trigger(228));
  addPStat(PStat(1), 3);
  return;

L3:
  return;
}

