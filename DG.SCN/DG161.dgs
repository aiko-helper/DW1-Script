section(81) {
  look(entity: Entity.Player, at: Entity(5));
  if (pstat[25] != 3) {
    look(entity: Entity(5), at: Entity.Player);
  }
  {
    if (trigger(65) || trigger(66) || trigger(67) || trigger(68)) {
      break;
    }
    if (trigger(231) && !trigger(65) && pstat[25] == 0) {
      speak(Entity(5), "「いらっしゃい。」<NEWLINE>");
      showTextbox("「やぁー、<LIGHTBLUE><PLAYER><WHITE>さん。<NEWLINE> 見てよ、ぼくのお店。<NEWLINE> アイテムがんがん売っちゃうよー。」<NEWLINE>");
      showTextbox("「品ぞろえは、まあそのうち何とか<NEWLINE> するよ。手伝ってくれるデジモンを<NEWLINE> 呼んできてほしいなー。」<NEWLINE>");
      setTrigger(Trigger(65));
      addPStat(PStat(26), 1);
      if (pstat[26] >= 3) {
        setObjectVisibility(18, 1);
        setObjectVisibility(20, 1);
      }
      return;
    }
    if (trigger(245) && !trigger(66) && pstat[25] == 1) {
      speak(Entity(5), "「ようこそピヨ。ぼく、アイテムの<NEWLINE> 売り買いをすることにしたピヨ。<NEWLINE> これからよろしくピヨ!」<NEWLINE>");
      showTextbox("「しなぞろえはまだ少ないけど…<NEWLINE> 誰か手伝ってくれるデジモンが<NEWLINE> いればどうにかなるかもピヨ。」<NEWLINE>");
      setTrigger(Trigger(66));
      addPStat(PStat(26), 1);
      if (pstat[26] >= 3) {
        setObjectVisibility(18, 1);
        setObjectVisibility(20, 1);
      }
      return;
    }
    if (trigger(233) && !trigger(67) && pstat[25] == 2) {
      speak(Entity(5), "「いらっしゃい。せんえつながら、<NEWLINE> アイテムをあつかう店を開くことにした。<NEWLINE> よろしくお願いするよ。」<NEWLINE>");
      showTextbox("「まだ品ぞろえがいまいちだが、<NEWLINE> 今後店を大きくしたいと思っている。<NEWLINE> しばらくがまんしてくれ。」<NEWLINE>");
      setTrigger(Trigger(67));
      addPStat(PStat(26), 1);
      if (pstat[26] >= 3) {
        setObjectVisibility(18, 1);
        setObjectVisibility(20, 1);
      }
      return;
    }
    if (!trigger(247) || trigger(68) || pstat[25] != 3) break;
    speak(Entity(5), "「<LIGHTBLUE><PLAYER><WHITE>さん、<ORANGE><DIGIMON><WHITE>さん、<NEWLINE> アイテムショップを開くことができました。<NEWLINE> 大はんじょうの予感がしますよ!」<NEWLINE>");
    showTextbox("「街にもっとデジモンがくれば、<NEWLINE> もっと品ぞろえを良くできるはず。<NEWLINE> 今はがまんしてくださいね。」<NEWLINE>");
    setTrigger(Trigger(68));
    addPStat(PStat(26), 1);
    if (pstat[26] >= 3) {
      setObjectVisibility(18, 1);
      setObjectVisibility(20, 1);
    }
    return;
  }
  if (trigger(231) && !trigger(65) && pstat[25] == 0) {
    speak(Entity(5), "「やあー、<LIGHTBLUE><PLAYER><WHITE>さん。ぼく、この店の<NEWLINE> お手伝いすることにしたんだー。<NEWLINE> いっぱい買ってよね!」<NEWLINE>");
    setTrigger(Trigger(65));
    addPStat(PStat(26), 1);
    if (pstat[26] >= 3) {
      setObjectVisibility(18, 1);
      setObjectVisibility(20, 1);
    }
    return;
  }
  if (trigger(245) && !trigger(66) && pstat[25] == 1) {
    speak(Entity(5), "「ようこそピヨー!今日から店の手伝いを<NEWLINE> するピヨ。よろしくピヨ。」<NEWLINE>");
    setTrigger(Trigger(66));
    addPStat(PStat(26), 1);
    if (pstat[26] >= 3) {
      setObjectVisibility(18, 1);
      setObjectVisibility(20, 1);
    }
    return;
  }
  if (trigger(233) && !trigger(67) && pstat[25] == 2) {
    speak(Entity(5), "「いらっしゃい、<LIGHTBLUE><PLAYER><WHITE>。<NEWLINE> せんえつながらこの店を手伝うことに<NEWLINE> した。よろしくお願いする。」<NEWLINE>");
    setTrigger(Trigger(67));
    addPStat(PStat(26), 1);
    if (pstat[26] >= 3) {
      setObjectVisibility(18, 1);
      setObjectVisibility(20, 1);
    }
    return;
  }
  if (trigger(247) && !trigger(68) && pstat[25] == 3) {
    speak(Entity(5), "「やあ、<LIGHTBLUE><PLAYER><WHITE>さん。私の力が<NEWLINE> いかせるのはやはりここですね。<NEWLINE> これからがんばりますよ。」<NEWLINE>");
    setTrigger(Trigger(68));
    addPStat(PStat(26), 1);
    if (pstat[26] >= 3) {
      setObjectVisibility(18, 1);
      setObjectVisibility(20, 1);
    }
    return;
  }
  if (pstat[26] == 1) {
    for x in [Trigger(384), Trigger(385), Trigger(388), Trigger(392)] {
      setTrigger(x);
    }
    for id in Trigger(399)..Trigger(401) {
      setTrigger(id);
    }
    for x in [Trigger(406), Trigger(416), Trigger(422)] {
      setTrigger(x);
    }
  }
  switch pstat[25] {
    0 => {
      setTrigger(Trigger(393));
    }
    1 => {
      setTrigger(Trigger(387));
    }
    2 => {
      setTrigger(Trigger(396));
    }
    3 => {
      setTrigger(Trigger(394));
    }
  }
  unsetTrigger(Trigger(3));
  if (pstat[26] == 2 || pstat[26] == 3) {
    for x in [Trigger(384), Trigger(385), Trigger(388), Trigger(392)] {
      setTrigger(x);
    }
    for id in Trigger(399)..Trigger(401) {
      setTrigger(id);
    }
    for x in [Trigger(406), Trigger(416), Trigger(422), Trigger(386), Trigger(389)] {
      setTrigger(x);
    }
  }
  switch pstat[25] {
    0 => {
      setTrigger(Trigger(393));
    }
    1 => {
      setTrigger(Trigger(387));
    }
    2 => {
      setTrigger(Trigger(396));
    }
    3 => {
      setTrigger(Trigger(394));
    }
  }
  if (pstat[26] == 4) {
    for x in [Trigger(384), Trigger(385), Trigger(388), Trigger(392)] {
      setTrigger(x);
    }
    for id in Trigger(399)..Trigger(401) {
      setTrigger(id);
    }
    for x in [
      Trigger(406), Trigger(416), Trigger(422), Trigger(386),
      Trigger(389), Trigger(391), Trigger(390), Trigger(395)
    ] {
      setTrigger(x);
    }
  }
  switch pstat[25] {
    0 => {
      setTrigger(Trigger(393));
    }
    1 => {
      setTrigger(Trigger(387));
    }
    2 => {
      setTrigger(Trigger(396));
    }
    3 => {
      setTrigger(Trigger(394));
    }
  }
  if (pstat[26] == 5) {
    for x in [Trigger(384), Trigger(385), Trigger(388), Trigger(392)] {
      setTrigger(x);
    }
    for id in Trigger(399)..Trigger(401) {
      setTrigger(id);
    }
    for x in [
      Trigger(406), Trigger(416), Trigger(422), Trigger(386),
      Trigger(389), Trigger(391), Trigger(390), Trigger(395),
      Trigger(393), Trigger(387), Trigger(394), Trigger(396)
    ] {
      setTrigger(x);
    }
  }
  unsetTrigger(Trigger(3));
  setPStat(PStat(254), 5);
  callSubroutine(8);
  for x in [Trigger(384), Trigger(385), Trigger(388), Trigger(392)] {
    unsetTrigger(x);
  }
  for id in Trigger(399)..Trigger(401) {
    unsetTrigger(id);
  }
  for x in [
    Trigger(406), Trigger(416), Trigger(422), Trigger(386),
    Trigger(389), Trigger(391), Trigger(390), Trigger(395),
    Trigger(393), Trigger(387), Trigger(394), Trigger(396)
  ] {
    unsetTrigger(x);
  }
  return;
}

section(82) {
  if (!trigger(69)) {
    return;
  }
  look(entity: Entity.Player, at: Entity(6));
  look(entity: Entity(6), at: Entity.Player);
  speak(Entity(6), "「お~セニョール、元気してたカナ?<NEWLINE> ボキはアイテム売りでいそがしい毎日ヨ。<NEWLINE> なーんてネ!」<NEWLINE>");
  showTextbox("「ボキ、なかなか面倒くさがりやさんだし、<NEWLINE> めったに店に出ないと思うネ。<NEWLINE> でも、すごいものを用意したヨ。」<NEWLINE>");
  showTextbox("「その名は『トレーマニュアル』!<NEWLINE> これを持ってるだけで、<NEWLINE> トレーニング効果は絶大ネ!」<NEWLINE>");
  showTextbox("「とっても貴重なので<NEWLINE> 50000<B><it>で売ってあげるヨ。<NEWLINE> 買わなきゃこうかいするネー!」<NEWLINE>");
  setDialogOwner(Entity.Player);
  setSelection(L1, L2);
  showTextbox("「買う。」<NEWLINE>「買わない。」<NEWLINE>");

L1:
  if (money >= 50000) {
    reduceMoney(50000);
  } else {
    speak(Entity(6), "「<B><it>がぜんぜん足りないヨ~。」<NEWLINE>");
    return;
  }
  giveItem(Item.TrainingManual, 1);
  if (trigger(0)) {
    speak(Entity(6), "「ん、もちものがいっぱいネ~。」<NEWLINE>");
    addMoney(50000);
    return;
  }
  playSound(0, 5);
  speak(Entity.System, "「<LIGHTBLUE>トレーマニュアル<WHITE>を手に入れた!。」<NEWLINE>");

L2:
  speak(Entity(6), "「ビタ一文まけないネ。」<NEWLINE>");
  return;
}

section(83) {
  if (pstat[26] < 3) {
    return;
  }
  rotate(entity: Entity.Player, to: 2048);
  jumpToScriptSection(222, 51);
  return;
}

section(7) {
  {
    roll(pstat: PStat.RollScratch, max: 2);
    if (pstat[1] < 20) break;
    if (pstat[110] != 0) break;
    speak(Entity(7), "「そうそう、持ち物がいっぱいで<NEWLINE> 困ってないかプニ?」<NEWLINE>");
    showTextbox("「世界のどこかに、かばんの中を異次元に<NEWLINE> つなげて、持てるアイテム数をふやして<NEWLINE> くれるキーホルダーがあるらしいプニ!」<NEWLINE>");
    showTextbox("「すでに行った場所ももう一度<NEWLINE> 回ってみるといいかもプニ。」<NEWLINE>");
    return;
  }
  speak(Entity(7), "「アイテム買いのとっておきのコツを<NEWLINE> おしえてあげるプニ!」<NEWLINE>");
  showTextbox("「アイテムらんでスタートボタンを<NEWLINE> 押すと説明が出るプニ!」<NEWLINE>");
  showTextbox("「個数を変える時は<PINK><SQUARE><WHITE><ボき><ヌン>で買えるだけ全部、<NEWLINE> <GREEN><TRIANGLE><WHITE><ボき><ヌン>を押しながら方向キー上下で<NEWLINE> 10コたんいの上げ下げができるプニ。」<NEWLINE>");
  showTextbox("「いちらんが多いときはR1ボタンを<NEWLINE> 押しながら方向キー上下で<NEWLINE> 一気に進められるプニ。」<NEWLINE>");
  showTextbox("「それととっておきの話プニ…<NEWLINE> 生まれ変わりたてのときに<NEWLINE> 何か買い物してみてほしいプニ。」<NEWLINE>");
  showTextbox("「きっといいことがあるプニ!」<NEWLINE>");
  return;
}

