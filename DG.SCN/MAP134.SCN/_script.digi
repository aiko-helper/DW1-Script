; MAP134.SCN
;!script index=134 start=0x5e800 end=0x5f000 headerU16=0x1c sentinelOff=0x24
;!sections onEnter section_5 section_6 section_7 section_8 section_9

onEnter:     ; len=116
  0000:  storeRandom 110 99
  0004:  if pstat[110] > 11 then onEnter+0x16
  0010:  spawnItem Digimushroom 59 50
  0016:  storeRandom 110 99
  001a:  if pstat[110] > 17 then onEnter+0x2c
  0026:  spawnItem Digimushroom 33 42
  002c:  storeRandom 110 99
  0030:  if pstat[110] > 2 then onEnter+0x42
  003c:  spawnItem Happymushroom 37 61
  0042:  if !trigger(319) then onEnter+0x62
  004e:  setObjectVisibility 24 1
  0052:  setObjectVisibility 25 1
  0056:  setObjectVisibility 26 1
  005a:  setObjectVisibility 27 1
  005e:  jump onEnter+0x72
  0062:  setRectImpassible 32 39 9 8
  006a:  setRectImpassible 35 34 8 8
  0072:  endSection
