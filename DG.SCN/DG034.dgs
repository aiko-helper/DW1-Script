// DG034.SCN
#include "functions.dgs"
#pragma script index=34 start=0x1c000 end=0x1c800 headerU16=0x24 sentinelOff=0x24
#include "entities.dgs"

section onEnter(254) {
  spawnItemChance(max: 99, chance: 9, item: Item.Digimushroom, x: 36, y: 68);
  spawnItemChance(max: 99, chance: 5, item: Item.Digimushroom, x: 83, y: 78);
  spawnItemChance(max: 99, chance: 14, item: Item.Digimushroom, x: 25, y: 17);
  spawnItemChance(max: 99, chance: 2, item: Item.Happymushroom, x: 78, y: 60);
  return;
}

section(5) {
  speak(Entity(5), "「おらおらおらー!」<NEWLINE>");
  finishEncounter(Trigger(280));
}

section(6) {
  speak(Entity(6), "「おれをおこらせるなよ!」<NEWLINE>");
  finishEncounter(Trigger(280));
}

section(7) {
  speak(Entity(7), "「あっはっは!おもろいわ。」<NEWLINE>");
  finishEncounter(Trigger(280));
}

section(8) {
  speak(Entity(8), "「やったろやないかいっ!」<NEWLINE>");
  finishEncounter(Trigger(280));
}

section(51) {
  if (!trigger(124)) {
    anim(Entity.Player, Animation(15), wait: 15);
    speak(Entity.Player, "「うわっと、あ、危ねー!」<NEWLINE>");
    move(entity: Entity.Player, to: (73, 971), sprint: 1, withCamera: true);
    waitForEntity(Entity.Player);
  }
  goto section_53.L1;
}

section(52) {
  if (!trigger(124)) {
    anim(Entity.Player, Animation(15), wait: 15);
    speak(Entity.Player, "「うわっと、あ、危ねー!」<NEWLINE>");
    move(entity: Entity.Player, to: (-782, 1580), sprint: 1, withCamera: true);
    waitForEntity(Entity.Player);
  }
  goto section_53.L1;
}

section(53) {
  if (!trigger(124)) {
    anim(Entity.Player, Animation(15), wait: 15);
    speak(Entity.Player, "「うわっと、あ、危ねー!」<NEWLINE>");
    move(entity: Entity.Player, to: (856, 1137), sprint: 1, withCamera: true);
    waitForEntity(Entity.Player);
    followEntity(Entity.Player, speed: 10);

L1:
  }
  if (!trigger(103) && trigger(124)) {
    rotate(entity: Entity.Player, to: 2000);
    delay(10);
    anim(Entity.Player, Animation(24), wait: 15);
    speak(Entity.Player, "「本当にこんなところに<NEWLINE> 見えない橋があるってのか…?」<NEWLINE>");
    playAnimation(Entity.Player, Animation(0));
    speak(Entity.Player, "「お?」<NEWLINE>");
    move(entity: Entity.Player, to: (66, 3240), sprint: 0, withCamera: true);
    delay(20);
    move(entity: Entity.Partner, to: (30, 2646), sprint: 0);
    waitForPair();
    speak(Entity.Player, "「おお、歩けるよ!」<NEWLINE>");
    setTrigger(Trigger(103));
  }
  return;
