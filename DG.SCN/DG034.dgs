// DG034.SCN
#include "functions.dgs"
#pragma script index=34 start=0x1d800 end=0x1e000 headerU16=0x28 sentinelOff=0x24
#include "entities.dgs"

section onEnter(254) {
  roll(pstat: 110, max: 99);
  if (pstat[110] <= 14) {
    spawnItem(Item.Digimushroom, x: 21, y: 31);
  }
  roll(pstat: 110, max: 99);
  if (pstat[110] <= 7) {
    spawnItem(Item.Digimushroom, x: 59, y: 78);
  }
  roll(pstat: 110, max: 99);
  if (pstat[110] <= 0) {
    spawnItem(Item.DeluxeMushroom, x: 60, y: 51);
  }
  return;
}

section(5) {
  speak(5, "Today is your last day.\n");
  finishEncounter(301);
}

section(6) {
  speak(6, "Don't stand behind me!\n");
  finishEncounter(301);
}

section(7) {
  speak(7, "Since you've seen my face...\n");
  finishEncounter(301);
}

section(8) {
  speak(8, "I can't make a mistake!\n");
  finishEncounter(301);
}

section(9) {
  speak(9, "I'm sorry, but you'll lose!\n");
  finishEncounter(301);
}

section(10) {
  speak(10, "I won't let you escape!\n");
  finishEncounter(301);
}

section(11) {
  speak(11, "No way, I'm not gonna lose!\n");
  finishEncounter(296);
}

section(12) {
  speak(12, "I'm done with you!\n");
  finishEncounter(296);
