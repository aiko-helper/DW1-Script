// DG008.SCN
#include "functions.dgs"
#pragma script index=8 start=0xb800 end=0xc000 headerU16=0x18 sentinelOff=0x24
#include "entities.dgs"

section onEnter(254) {
  spawnItemChance(max: 99, chance: 1, item: Item.Happymushroom, x: 22, y: 69);
  return;
}

section(51) {
  if (trigger(149)) goto L1;
  moveCamera(to: (-5000, 2000), slowdown: 30);
  rotate(entity: Entity.Player, to: 1117);
  waitForEntity(200);
  delay(50);
  speak(Entity.Player, "Drill Tunnel\n");
  moveCamera(to: Entity.Player, speed: 20);
  waitForEntity(200);
  setTrigger(149);
  if (trigger(54)) goto L1;
  setDialogOwner(Entity.Player);
  choice { "Normal" -> L2, "Ogre mode" -> L3 }
  goto L2;

L1:
  if (trigger(150) && !trigger(151)) {
    goto L3;
  }
  return;

L2:
  return;

L3:
  setTrigger(151);
  setObjectVisibility(5, 1);
  setObjectVisibility(6, 0);
  moveCamera(to: (-5000, 2000), slowdown: 30);
  rotate(entity: Entity.Player, to: 1117);
  waitForEntity(200);
  delay(50);
  speak(Entity.Player, "Oh that jerk! How rude!\n");
  moveCamera(to: (-2900, 0), slowdown: 30);
  waitForEntity(200);
  delay(20);
  speak(Entity.Player, "Huh?\n");
  setDigimon(Digimon.MarketManager, 0, 0);
  move(entity: 5, to: (-2028, -842), sprint: 0);
  rotate(entity: Entity.Player, to: 1117);
  waitForEntity(5);
  rotate(entity: 5, to: 1117);
  waitForEntity(5);
  delay(10);
  speak(Entity.System, "<YELLOW>Market manager <WHITE>\nI didn't know we'd have to\npay to get thru!\n");
  move(entity: 5, to: (-1323, -815), sprint: 0);
  waitForEntity(5);
  look(entity: 5, at: Entity.Player);
  waitForEntity(5);
  moveCamera(to: Entity.Player, speed: 20);
  waitForEntity(200);
  look(entity: Entity.Player, at: 5);
  speak(Entity.System, "<YELLOW>Market manager <WHITE>\nHey, aren't you... yes!\nDo something!\n");
  speak(Entity.Player, "How are the Drimogemon\ninside?\n");
  speak(Entity.System, "<YELLOW>Market manager <WHITE>\nI don't know.\n");
  speak(Entity.Player, "I hope they are alright.\nOkay, here I go!\n");
  move(entity: 5, to: (-2333, 59), sprint: 0);
  waitForEntity(5);
  rotate(entity: 5, to: 4000);
  waitForEntity(5);
  return;
}

section(5) {
  speak(Entity.System, "<YELLOW>Market manager <WHITE>\nDo something quick!\n");
  return;
}

section(52) {
  if (trigger(106)) {
    move(entity: Entity.Player, to: (2000, -152), sprint: 0);
    warp(to: Map.MAYO02_2, spawn: 2, trigger: 255);
  }
  move(entity: Entity.Player, to: (2000, -152), sprint: 0);
  warp(to: Map.MAYO01_2, spawn: 1, trigger: 255);
  return;
}

section(53) {
  if (!trigger(238)) goto L1;
  if (trigger(150) && !trigger(234)) goto L1;
  speak(Entity.Player, "There's nothing more in\nthe tunnel... Do we run\nthru it or what?\n");
  choice { "Let's go thru!" -> L2, "Let's not" -> L3 }
  goto L3;

L1:
  return;

L2:
  move(entity: Entity.Player, to: (-4017, -828), sprint: 1);
  warp(to: Map.MIHA04B, spawn: 2, trigger: 255);

L3:
  move(entity: Entity.Player, to: (-4017, -828), sprint: 0);
  warp(to: Map.TUNN01, spawn: 0, trigger: 255);
  return;
  garbage { 18 00 fe 00 18 00 33 00 30 00 05 00 60 03 34 00 b4 03 35 00 da 03 ff ff 24 00 6e 63 19 00 0b 00 6e 01 18 00 2e 00 19 00 74 45 16 00 45 00 fe 00 19 00 01 00 95 00 18 00 b6 00 19 00 4f 1e 78 ec d0 07 4d fd 5d 04 4a c8 67 00 32 00 1b fd 1a 00 82 63 82 92 82 89 82 8c 82 8c 81 40 82 73 82 95 82 8e 82 8e 82 85 82 8c 0d 00 00 00 50 00 fd 14 4a c8 1c 00 95 00 19 00 01 00 36 00 18 00 b6 00 19 00 1b fd 10 02 cc 00 ce 00 1a 00 82 6d 82 8f 82 92 82 8d 82 81 82 8c 0d 00 82 6e 82 87 82 92 82 85 81 40 82 8d 82 8f 82 84 82 85 0d 00 00 00 12 00 16 00 cc 00 19 00 00 00 96 00 81 00 97 00 18 00 ca 00 19 00 16 00 ce 00 fe 00 fe 00 1c 00 97 00 57 00 05 01 57 00 06 00 4f 1e 78 ec d0 07 4d fd 5d 04 4a c8 67 00 32 00 1b fd 1a 00 82 6e 82 88 81 40 82 94 82 88 82 81 82 94 81 40 82 8a 82 85 82 92 82 8b 81 49 81 40 82 67 82 8f 82 97 81 40 82 92 82 95 82 84 82 85 81 49 0d 00 00 00 4f 1e ac f4 00 00 4a c8 67 00 14 00 1b fd 1a 00 82 67 82 95 82 88 81 48 0d 00 00 00 47 76 00 00 4e 05 14 f8 b6 fc 00 00 4d fd 5d 04 4a 05 4d 05 5d 04 4a 05 67 00 0a 00 1b ff 1a 00 01 07 82 6c 82 81 82 92 82 8b 82 85 82 94 81 40 82 8d 82 81 82 8e 82 81 82 87 82 85 82 92 81 40 01 01 0d 00 82 68 81 40 82 84 82 89 82 84 82 8e 81 75 82 94 81 40 82 8b 82 8e 82 8f 82 97 81 40 82 97 82 85 81 75 82 84 81 40 82 88 82 81 82 96 82 85 81 40 82 94 82 8f 0d 00 82 90 82 81 82 99 81 40 82 94 82 8f 81 40 82 87 82 85 82 94 81 40 82 94 82 88 82 92 82 95 81 49 0d 00 00 00 4e 05 d5 fa d1 fc 00 00 4a 05 4c 00 05 fd 4a 05 50 00 fd 14 4a c8 4c 00 fd 05 1b ff 1a 00 01 07 82 6c 82 81 82 92 82 8b 82 85 82 94 81 40 82 8d 82 81 82 8e 82 81 82 87 82 85 82 92 81 40 01 01 0d 00 82 67 82 85 82 99 81 43 81 40 82 81 82 92 82 85 82 8e 81 75 82 94 81 40 82 99 82 8f 82 95 81 42 81 42 81 42 81 40 82 99 82 85 82 93 81 49 0d 00 82 63 82 8f 81 40 82 93 82 8f 82 8d 82 85 82 94 82 88 82 89 82 8e 82 87 81 49 0d 00 00 00 1b fd 1a 00 82 67 82 8f 82 97 81 40 82 81 82 92 82 85 81 40 82 94 82 88 82 85 81 40 82 63 82 92 82 89 82 8d 82 8f 82 87 82 85 82 8d 82