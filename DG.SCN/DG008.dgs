// DG008.SCN
#include "functions.dgs"
#pragma script index=8 start=0xb000 end=0xb800 headerU16=0x18 sentinelOff=0x24
#include "entities.dgs"

section onEnter(254) {
  spawnItemChance(max: 99, chance: 1, item: Item.Happymushroom, x: 22, y: 69);
  return;
}

section(51) {
  {
    {
      if (trigger(149)) break;
      moveCamera(to: (-5000, 2000), slowdown: 30);
      rotate(entity: Entity.Player, to: 1117);
      waitForEntity(Entity(200));
      delay(50);
      speak(Entity.Player, "「ドリルトンネル…」<NEWLINE>");
      followEntity(Entity.Player, speed: 20);
      setTrigger(Trigger(149));
      if (trigger(54)) break;
      setDialogOwner(Entity.Player);
      setSelection(L1, L2);
      showTextbox("「通常」<NEWLINE>「オーガモード」<NEWLINE>");
      waitForSelectionChoice();
      goto L1;
    }
    if (trigger(150) && !trigger(151)) {
      break;
    }
    return;

L1:
    return;

L2:
  }
  setTrigger(Trigger(151));
  setObjectVisibility(5, 1);
  setObjectVisibility(6, 0);
  moveCamera(to: (-5000, 2000), slowdown: 30);
  rotate(entity: Entity.Player, to: 1117);
  waitForEntity(Entity(200));
  delay(50);
  speak(Entity.Player, "「げっ、あいつ!しょうこりも無く…!」<NEWLINE>");
  panTo(x: -2900, y: 0, slowdown: 30);
  delay(20);
  speak(Entity.Player, "「ん?」<NEWLINE>");
  setDigimon(Digimon.MarketManager, Entity(0), 0);
  move(entity: Entity(5), to: (-2028, -842), sprint: 0);
  rotate(entity: Entity.Player, to: 1117);
  waitForEntity(Entity(5));
  rotate(entity: Entity(5), to: 1117);
  waitForEntity(Entity(5));
  delay(10);
  speak(Entity.System, "<YELLOW>マーケット店主<WHITE><NEWLINE>「トンネルに通行料がいるなんて<NEWLINE> 聞いてないアルよ~。」<NEWLINE>");
  move(entity: Entity(5), to: (-1323, -815), sprint: 0);
  waitForEntity(Entity(5));
  look(entity: Entity(5), at: Entity.Player);
  waitForEntity(Entity(5));
  followEntity(Entity.Player, speed: 20);
  look(entity: Entity.Player, at: Entity(5));
  speak(Entity.System, "<YELLOW>マーケット店主<WHITE><NEWLINE>「あ、君は…もしや!どうにかして<NEWLINE> ほしいアル~。」<NEWLINE>");
  speak(Entity.Player, "「中のドリモゲモンたちは?」<NEWLINE>");
  speak(Entity.System, "<YELLOW>マーケット店主<WHITE><NEWLINE>「わからないアル…」<NEWLINE>");
  speak(Entity.Player, "「無事だといいけど…<NEWLINE> よし、乗りこむぞ!」<NEWLINE>");
  move(entity: Entity(5), to: (-2333, 59), sprint: 0);
  waitForEntity(Entity(5));
  rotate(entity: Entity(5), to: 4000);
  waitForEntity(Entity(5));
  return;
}

section(5) {
  speak(Entity.System, "<YELLOW>マーケット店主<WHITE><NEWLINE>「早くなんとかしてほしいアル。」<NEWLINE>");
  return;
}

section(52) {
  if (trigger(106)) {
    move(entity: Entity.Player, to: (2000, -152), sprint: 0);
    warp(to: Map.MAYO02_2, spawn: 2, trigger: 255);
  }
  move(entity: Entity.Player, to: (2000, -152), sprint: 0);
  warp(to: Map.MAYO01_2, spawn: 1, trigger: 255);
  return;
}

section(53) {
  {
    if (!trigger(238)) break;
    if (trigger(150) && !trigger(234)) break;
    speak(Entity.Player, "「トンネルにはもう何も無いからな…<NEWLINE> 一気にかけぬけるか?どうする?」<NEWLINE>");
    setSelection(L1, L2);
    showTextbox("「いくぞ!」<NEWLINE>「やめとこう。」<NEWLINE>");
    waitForSelectionChoice();
    goto L2;
  }
  return;

L1:
  move(entity: Entity.Player, to: (-4017, -828), sprint: 1);
  warp(to: Map.MIHA04B, spawn: 2, trigger: 255);

L2:
  move(entity: Entity.Player, to: (-4017, -828), sprint: 0);
  warp(to: Map.TUNN01, spawn: 0, trigger: 255);
  return;
