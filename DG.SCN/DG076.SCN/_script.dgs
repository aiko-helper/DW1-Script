// DG076.SCN
#pragma script index=76 start=0x36000 end=0x37000 headerU16=0x1c sentinelOff=0x24
#pragma sections section_0254 section_0006 section_0007 section_0008 section_0009 section_0051

section onEnter(254) {  // len=52
    roll(pstat: 110, max: 99);
    if (pstat[110] > 9) goto L_0016;
    spawnItem(Item.Digimushroom, 34, 56);
L_0016:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 5) goto L_002c;
    spawnItem(Item.Digimushroom, 37, 43);
L_002c:
    setPStat(254, 2);
    callSubroutine(25);
    return;
}
