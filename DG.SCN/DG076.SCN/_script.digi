; DG076.SCN
;!script index=76 start=0x36000 end=0x37000 headerU16=0x1c sentinelOff=0x24
;!sections onEnter section_6 section_7 section_8 section_9 section_51

onEnter:     ; len=52
  0000:  storeRandom 110 99
  0004:  if pstat[110] > 9 then onEnter+0x16
  0010:  spawnItem Digimushroom 34 56
  0016:  storeRandom 110 99
  001a:  if pstat[110] > 5 then onEnter+0x2c
  0026:  spawnItem Digimushroom 37 43
  002c:  pstat[254] = 2
  0030:  callSubroutine 25
  0032:  endSection
