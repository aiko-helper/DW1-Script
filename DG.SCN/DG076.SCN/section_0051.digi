section_51:     ; len=3852
  0000:  if trigger(144) then section_51+0x90e
  000c:  entityWalkTo 5 -421 374 1
  0014:  waitForEntity 5
  0016:  lookAt 5 253
  001a:  lookAt 253 5
  001e:  lookAt 252 5
  0022:  waitForEntity 5
  0024:  playSound 8 10
  0028:  setDialogOwner 5
  002a:  showTextbox "Who are you? I won't let\nanyone mess up this place!\n"
  0096:  playAnimation 253 19
  009a:  delay 15
  009e:  setDialogOwner 253
  00a0:  showTextbox "Don't worry. We're just\ntravelling through\nto save the island.\n"
  0122:  playAnimation 253 0
  0126:  playSound 8 10
  012a:  setDialogOwner 5
  012c:  showTextbox "I don't trust you, get lost!\n"
  016a:  setDialogOwner 253
  016c:  showTextbox "Wait a sec.\n"
  0188:  setTrigger 1
  018c:  setPStat 250 1
  0190:  setPStat 251 5
  0194:  setPStat 252 255
  0198:  setPStat 253 255
  019c:  fadeOutHUD
  019e:  delay 1
  01a2:  startBattle
  01a4:  unsetTrigger 1
  01a8:  setPStat 250 0
  01ac:  entityWalkTo 253 -97 -448 0
  01b4:  entityWalkTo 252 -597 -443 0
  01bc:  entityWalkTo 5 -421 374 1
  01c4:  waitForEntity 253
  01c6:  waitForEntity 252
  01c8:  waitForEntity 5
  01ca:  lookAt 253 5
  01ce:  lookAt 5 253
  01d2:  lookAt 252 5
  01d6:  setDialogOwner 5
  01d8:  showTextbox "Are you by any chance...?\n"
  0210:  playAnimation 253 7
  0214:  delay 15
  0218:  setDialogOwner 253
  021a:  showTextbox "I told you so!\n"
  023c:  playAnimation 253 0
  0240:  setDialogOwner 5
  0242:  showTextbox "I'm sorry. We don't get\nvisitors often, so I get\nexcited about my new job.\n"
  02dc:  setDialogOwner 253
  02de:  showTextbox "Job?\n"
  02ec:  setDialogOwner 5
  02ee:  showTextbox "I'm guarding a place called\nAncient Dino Region.\n"
  0354:  showTextbox "It's an unexplored region.\n"
  038e:  setDialogOwner 253
  0390:  showTextbox "Will you show me around?\n"
  03c6:  setDialogOwner 5
  03c8:  showTextbox "Ancient Dino Region is\ndivided in two sections.\n"
  042c:  showTextbox "Where we live is called\nGlacial Time Zone.\n"
  0486:  showTextbox "It's a special place\nwhere time goes slow.\n"
  04e0:  playAnimation 253 16
  04e4:  delay 15
  04e8:  setDialogOwner 253
  04ea:  showTextbox "Time goes slow?\n"
  050e:  playAnimation 253 0
  0512:  setDialogOwner 5
  0514:  showTextbox "The other place is\nSpeedy Time Zone.\n"
  0562:  showTextbox "It's dangerous and further\nthan the Glacial Time Zone.\n"
  05d4:  showTextbox "It's dangerous cuz\ntime goes very fast.\n"
  0628:  showTextbox "The land is bare. Bones\nand fossils everywhere.\n"
  068c:  setDialogOwner 253
  068e:  showTextbox "That's cuz time passes faster\nthere than in other places?\n"
  0706:  setDialogOwner 5
  0708:  showTextbox "Right. Don't stay there long.\n"
  0748:  showTextbox "Since I'm blocking your\nway, you can't go there.\n"
  07ae:  setDialogOwner 253
  07b0:  showTextbox "You lost.\n"
  07c8:  playSound 8 10
  07cc:  setDialogOwner 5
  07ce:  showTextbox "I was unlucky! It doesn't\nhappen often.\n"
  0822:  setDialogOwner 253
  0824:  showTextbox "Is that right?\n"
  0846:  setDialogOwner 5
  0848:  showTextbox "I have to go back home.\nAsk other Digimon\nif you have questions.\n"
  08ce:  setTrigger 144
  08d2:  jump section_51+0x8d6
  08d6:  entityWalkTo 5 -293 1172 1
