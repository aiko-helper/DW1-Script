section(5) {  // len=224
    setTriggerThenSpeakThenSpeak(77, 5, "Bakke. Bah Kkea.\n", Entity.Player, "I still don't understand him.\n");
    storeDigimonType(103);
    if (pstat[103] != 37) goto L1;
    look(entity: Entity.Player, at: Entity.Partner);
    delay(5);
    playAnimation(Entity.Partner, 11);
    delay(10);
    look(entity: Entity.Player, at: Entity.Partner);
    delay(5);
    speak(Entity.Player, "I see. You're\npatrolling for us?!\n");

L1:
    return;
}

section(6) {  // len=432
    if (trigger(78)) goto L1;
    setTriggerThenSpeakThenSpeak(78, 6, "Look! It's my special\nbulletin board.\n", 6, "We need information for the\ncity, so I decided to make a\nnewspaper! What do you think?\n");
    speak(6, "You can count on me to\ncollect information.\n");
    return;

L1:
    speak(6, "You're reading my paper.\n");
    return;
}

section(7) {  // len=810
    if (!trigger(231) && !trigger(245) && !trigger(233) && !trigger(247)) goto L1;
    speak(7, "Ah, it's cool and feels good.\n");
    showTextbox("When you're comfortable\nit feels good.\n");
    return;

L1:
    if (!trigger(204) || trigger(52) || trigger(249)) goto L2;
    setTrigger(52);
    speakThenShowTextboxThenShowTextbox(7, "What do you think of my shop?\n", "I'm not good at sales, but\nthere isn't anybody else\nto do it now.\n", "Bring many Digimon here, OK?\n");
    return;

L2:
    if (!trigger(204) || !trigger(249) || trigger(95)) goto L3;
    setTriggerThenSpeakThenSpeak(95, 7, "Well, what do you think?\n", Entity.System, "<YELLOW>Coelamon <WHITE>\nWe have decided to help each\nother and sell all these items.\n");
    return;

