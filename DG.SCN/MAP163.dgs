  if (trigger(249) && !trigger(52) && !trigger(204)) {
    setTrigger(52);
    speak(203, "Welcome to my shop!\nI'll give you a great price\n<LIGHTBLUE><PLAYER><WHITE>.\n");
    showTextbox("I'm not good at sales,\nbut neither is anyone else.\n");
    showTextbox("I'm in charge of sales now.\nI hope we can do business.\n");
    showTextbox("<LIGHTBLUE><PLAYER><WHITE>, please bring\nas many Digimon back\nwith you as you can.\n");
    return;
    playSound(0, 1);
  }
  if (trigger(204) && !trigger(52) && !trigger(249)) {
    setTrigger(52);
    speak(202, "What do you think\nof my shop?\n");
    showTextbox("I'm not good at sales,\nbut no one else is,\nso I must do it.\n");
    showTextbox("Bring back lots\nof Digimon soon.\n");
    playSound(0, 1);
    return;
  }
  if (trigger(204) && trigger(249) && !trigger(95)) {
    setTrigger(95);
    speak(202, "Well, what do you think?\n");
    speak(Entity.System, "<YELLOW>Coelamon <WHITE>\nWe decided to help each\nother and sell these items.\n");
    playSound(0, 1);
    return;
  }
  if (trigger(204) && trigger(249)) {
    for x in [384, 385, 388, 392, 406, 422] {
      setTrigger(x);
    }
    unsetTrigger(3);
    setPStat(254, 255);
    callSubroutine(8);
    for x in [384, 385, 388, 392, 406, 422] {
      unsetTrigger(x);
    }
    return;
  }
  for x in [384, 388, 422] {
    setTrigger(x);
  }
  unsetTrigger(3);
  if (trigger(249)) {
    setPStat(254, 255);
  } else {
    setPStat(254, 7);
  }
  callSubroutine(8);
  for x in [384, 388, 422] {
    unsetTrigger(x);
  }
  return;
}

