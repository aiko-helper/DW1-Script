#pragma script index=163 start=0x75800 end=0x77800 headerU16=0x4c sentinelOff=0x6925

function setTriggerThenSetTriggerThenSetTriggerThenUnsetTrigger(a, b) {
    setTrigger(a);
    setTrigger(b);
    setTrigger(422);
    unsetTrigger(3);
}

function callSubroutineThenUnsetTriggerThenUnsetTriggerThenUnsetTrigger(a, b) {
    callSubroutine(8);
    unsetTrigger(384);
    unsetTrigger(a);
    unsetTrigger(b);
}

function setTriggerThenSpeakThenSpeak(a, b, c, d, e) {
    setTrigger(a);
    speak(b, c);
    speak(d, e);
}

function speakThenShowTextboxThenShowTextbox(a, b, c, d) {
    speak(a, b);
    showTextbox(c);
    showTextbox(d);
}


