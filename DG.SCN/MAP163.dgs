section(5) {
  setTrigger(77);
  speak(5, "Bakke. Bah Kkea.\n");
  speak(Entity.Player, "I still don't understand him.\n");
  storeDigimonType(103);
  if (pstat[103] == 37) {
    look(entity: Entity.Player, at: Entity.Partner);
    delay(5);
    anim(Entity.Partner, 11, wait: 10);
    look(entity: Entity.Player, at: Entity.Partner);
    delay(5);
    speak(Entity.Player, "I see. You're\npatrolling for us?!\n");
  }
  return;
}

section(6) {
  if (!trigger(78)) {
    setTrigger(78);
    speak(6, "Look! It's my special\nbulletin board.\n");
    speak(6, "We need information for the\ncity, so I decided to make a\nnewspaper! What do you think?\n");
    speak(6, "You can count on me to\ncollect information.\n");
    return;
  }
  speak(6, "You're reading my paper.\n");
  return;
}

section(7) {
  if (trigger(231) || trigger(245) || trigger(233) || trigger(247)) {
    speak(7, "Ah, it's cool and feels good.\n");
    showTextbox("When you're comfortable\nit feels good.\n");
    return;
  }
  if (trigger(204) && !trigger(52) && !trigger(249)) {
    setTrigger(52);
    speak(7, "What do you think of my shop?\n");
    showTextbox("I'm not good at sales, but\nthere isn't anybody else\nto do it now.\n");
    showTextbox("Bring many Digimon here, OK?\n");
    return;
  }
  if (trigger(204) && trigger(249) && !trigger(95)) {
    setTrigger(95);
    speak(7, "Well, what do you think?\n");
    speak(Entity.System, "<YELLOW>Coelamon <WHITE>\nWe have decided to help each\nother and sell all these items.\n");
    return;
  }
  if (trigger(204) && trigger(249)) {
    for x in [384, 385, 388, 392, 406, 422] {
      setTrigger(x);
    }
    unsetTrigger(3);
    setPStat(254, 7);
    callSubroutine(8);
    for x in [384, 385, 388, 392, 406, 422] {
      unsetTrigger(x);
    }
    return;
  }
  for x in [384, 388, 422] {
    setTrigger(x);
  }
  unsetTrigger(3);
  setPStat(254, 7);
  callSubroutine(8);
  for x in [384, 388, 422] {
    unsetTrigger(x);
  }
  return;
}

section(8) {
  if (!trigger(79)) {
    setTrigger(79);
    speak(8, "Mmmm. I saw some delicious\nplants, so I decided to eat.\n");
    showTextbox("I guess it became\ntoo breezy in the city.\n");
    return;
  }
  if (pstat[1] <= 30) {
    speak(8, "Oh, I happened to pick up a\n<LIGHTBLUE>Happy Mushroom <WHITE>\nthe other day.\n");
    showTextbox("I hear it's a rare kind.\n");
    speak(8, "I also heard about a\n<LIGHTBLUE>Deluxe Mushroom<WHITE>.\nIt'll be nice to find.\n");
    return;
  }
  switch (pstat[37]) { case 0: goto L1; case 1: goto L2; case 2: goto L3; case 3: goto L4; case 4: goto L5; case 5: goto L6; case 6: goto L7; case 7: goto L8; }

L1:
  speak(8, "<LIGHTBLUE>Blue Apple <WHITE>\nfrom Native Forest\ntastes real good.\n");
  addPStat(37, 1);
  return;

L2:
  speak(8, "<LIGHTBLUE>Orange Banana <WHITE>\nfrom Tropical Jungle\ntastes real good.\n");
  addPStat(37, 1);
  return;

L3:
  speak(8, "<LIGHTBLUE>Big  Berry <WHITE>\nfrom Mt. Panorama\ntastes real good.\n");
  return;

L4:
  speak(8, "<LIGHTBLUE>Sweet Nut <WHITE>\nfrom Gear Savanna\ntastes real good.\n");
  return;

L5:
  speak(8, "<LIGHTBLUE>Super Veggy <WHITE>\nfrom Overdell Cemetery\ntastes good.\n");
  return;

L6:
  speak(8, "<LIGHTBLUE>Red Berry <WHITE>\nfrom Ancient Dino Tomb\ntastes good.\n");
  return;

L7:
  speak(8, "<LIGHTBLUE>Prickly Pear Cactus <WHITE>\nfrom Great Canyon\ntastes good.\n");
  return;

L8:
  speak(8, "<LIGHTBLUE>Digital Pine Cone <WHITE>\nfrom Misty Trees\ntastes good.\n");
  return;
  speak(8, "<LIGHTBLUE>Spiny Green <WHITE>\nfrom Geko Swamp\ntastes good.\n");
  return;
  speak(8, "<LIGHTBLUE>Ice Mushroom <WHITE>\nfrom Freezeland\ntastes good.\n");
  return;
  speak(8, "<LIGHTBLUE>Golden Acorn <WHITE>\nfrom Beatle Land\ntastes good.\n");
  setPStat(37, 0);
  return;
}

section(9) {
  if (pstat[1] >= 20 && trigger(185)) {
    speak(9, "I got something to say.\n");
    setDialogOwner(Entity.Player);
    setSelection(L1, L2);
    showTextbox("What is it?\nLaters!\n");
  }
  if (trigger(185)) {
    speak(9, "Did you see the Eastern\nBridge fixed?\nWe worked so hard.\n");
    return;
  }
  if (pstat[1] >= 2 && !trigger(185)) {
    speak(9, "We're fixing Digital Bridge\nnow. Please wait a while.\n");
    showTextbox("I hear there's a rare Digimon\nat Coela Point in the south.\n");
    showTextbox("Rumor has it is that he shows\nup late afternoon everyday.\n");
    return;
  }
  speak(9, "Say, did you know there's\na broken bridge in\nthe east part of the city?\n");
  showTextbox("We didn't think anyone\nwould ever use it, so we\ndidn't do anything about it.\n");
  showTextbox("We're thinking about\nfixing it on our own.\n");
  showTextbox("Until then, go check the\nwest and south sections.\nThen come back and see me.\n");
  return;

L1:
  if (pstat[1] >= 25) {
    speak(9, "Did you go to Geko Swamp?\nA mischievous\nDigimon may trick you.\n");
    return;
  }
  speak(9, "Once a Digimon digivolves,\nremember, his Technique\nSets will change.\n");
  return;

L2:
  speak(9, "Well...\n");
  return;
}

section(10) {
  if (!trigger(80)) {
    setTrigger(80);
    speak(10, "What do you think? I turned\non the light. Bright enough?\n");
    speak(10, "Let's make our city\nclean and cheerful!\n");
    return;
  }
  speak(10, "Does the light make\na difference?\n");
  speak(10, "Well, it all depends on\nhow you think.\n");
  return;
}

section(11) {
  speak(11, "I'm the most powerful one.\n");
  showTextbox("I don't consider myself\na loser to you. If you come\nto the Arena, you'll see.\n");
  return;
}

section(12) {
  speak(12, "Hey, <LIGHTBLUE><PLAYER><WHITE>.\nI'm patrolling for shady\nlooking guys in the city.\n");
  showTextbox("What is it? I'm not\nbothering you, am I?!\n");
  return;
}

section(81) {
  rotate(entity: Entity.Player, to: 1024);
