section_5(5):     ; len=10228
  0000:  if !trigger(203) OR trigger(575) then section_5+0x10e
  0010:  speak 5 "<LIGHTBLUE><PLAYER><WHITE>, you did it!\n"
  0038:  showTextbox "Agumon came to the city.\nHe started a business\nover there.\n"
  00b2:  showTextbox "Hopefully more Digimon\nwill be like him!\n"
  0108:  setTrigger 575
  010c:  endSection
  010e:  if !trigger(246) OR trigger(614) then section_5+0x1d6
  011e:  speak 5 "Palmon came here, and plans\nto expand the Meat field.\n"
  0190:  showTextbox "Then we can get lots of Meat!\n"
  01d0:  setTrigger 614
  01d4:  endSection
  01d6:  if !trigger(232) OR trigger(602) then section_5+0x284
  01e6:  speak 5 "Kunemon came here, and\nwants to eat grass.\n"
