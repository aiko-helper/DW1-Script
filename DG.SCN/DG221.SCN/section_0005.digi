  027e:  setTrigger 602
  0282:  endSection
  0284:  if !trigger(236) OR trigger(606) then section_5+0x368
  0294:  speak 5 "Centarumon came here, and\nplans to open up a clinic.\n"
  0304:  showTextbox "No more worrying about\ngetting sick or hurt!\n"
  0362:  setTrigger 606
  0366:  endSection
  0368:  if !trigger(249) OR trigger(617) then section_5+0x41a
  0378:  speak 5 "Coelamon came here and\nhe wants to start a shop.\n"
  03e0:  showTextbox "The city will flourish!\n"
  0414:  setTrigger 617
  0418:  endSection
  041a:  if !trigger(204) OR trigger(576) then section_5+0x4d6
  042a:  speak 5 "Betamon came here and said\nhe'd like to start a shop.\n"
  049c:  showTextbox "The city will flourish!\n"
  04d0:  setTrigger 576
  04d4:  endSection
  04d6:  if !trigger(237) OR trigger(607) then section_5+0x598
  04e6:  speak 5 "Bakemon came here and said\nsomething I didn't understand.\n"
  0560:  showTextbox "Yes, well that's okay.\n"
  0592:  setTrigger 607
  0596:  endSection
  0598:  if !trigger(225) OR trigger(597) then section_5+0x668
