  rotate(entity: Entity.Player, to: 1024);
  playSound(8, 3);
  speak(Entity.System, "I used the\n<LIGHTBLUE>Mansion Key<WHITE>!\n");
  setTrigger(111);
  goto L2;

L1:
  if (item[Item.MansionKey] >= 1 || trigger(111)) goto L2;
  rotate(entity: Entity.Player, to: 1024);
  playSound(8, 2);
  delay(5);
