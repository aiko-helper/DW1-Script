// DG051.SCN
#include "functions.dgs"
#pragma script index=51 start=0x26800 end=0x27800 headerU16=0x24 sentinelOff=0xfe
#include "entities.dgs"

section onEnter(254) {
  return;
}

section(57) {
  if (trigger(358) && trigger(359) && !trigger(360)) {
    setTrigger(Trigger(360));
    loadAndSetDigimon(Digimon.Devimon, Entity(0), 0);
    setDialogOwner(Entity.Player);
    anim(Entity.Player, Animation(25), wait: 15);
    showTextbox("I got a bad feeling....\n");
    playAnimation(Entity.Player, Animation(0));
    look(entity: Entity.Player, at: Entity(5));
    delay(10);
    panTo(x: 0, y: 1614, slowdown: 20);
    speak(Entity(5), "I knew you'd come!\n");
    move(entity: Entity.Player, to: (-150, -239), sprint: 1);
    move(entity: Entity.Partner, to: (150, -239), sprint: 1);
    waitForPair();
    lookPairAt(Entity(5));
    delay(5);
    speak(Entity.Player, "Who are you?\n");
    speak(Entity(5), "I'm Devimon, a dark angel.\nI hold the power of darkness.\n");
    speak(Entity.Player, "Do you know something?\n");
    speak(Entity(5), "Myotismon, is in the mansion.\nMaybe he's alive.\n");
    anim(Entity.Player, Animation(20), wait: 15);
    speak(Entity.Player, "Did you do this?\n");
    playAnimation(Entity.Player, Animation(0));
    speak(Entity(5), "I don't know...all I know\nis that you're my enemy.\n");
    playAnimation(Entity(5), Animation(28));
    sfx(8, 8, wait: 20);
    speak(Entity.Player, "You won't get away!\n");
    move(entity: Entity.Player, to: (-150, 921), sprint: 1);
    move(entity: Entity.Partner, to: (150, 721), sprint: 1);
    delay(20);
    look(entity: Entity.Player, at: Entity(5));
    delay(5);
    speak(Entity(5), "Ha ha ha!\n");
    move(entity: Entity(5), to: (145, 795), animDuration: 5);
    waitForEntity(Entity(5));
    panTo(x: 0, y: 1614, slowdown: 20);
    move(entity: Entity(5), to: (0, -489), animDuration: 5);
    waitForEntity(Entity(5));
    look(entity: Entity.Player, at: Entity(5));
    delay(10);
    speak(Entity.Player, "Oh no!\n");
    look(entity: Entity.Player, at: Entity(5));
    delay(10);
    look(entity: Entity(5), at: Entity.Player);
    delay(10);
    speak(Entity(5), "Say hi to Myotismon for me.\n");
    move(entity: Entity.Player, to: (50, 250), sprint: 1);
    move(entity: Entity(5), to: (50, -1640), animDuration: 12);
    waitForEntity(Entity(5));
    waitForEntity(Entity.Player);
    unloadEntity(Entity(5));
    move(entity: Entity.Player, to: (50, -480), sprint: 1);
    waitForEntity(Entity.Player);
    speak(Entity.Player, "He got away!\nI don't like that guy.\n");
    followEntity(Entity.Player, speed: 10);
    return;
  }
  if (!trigger(121)) {
    setTrigger(Trigger(121));
    delay(20);
    rotate(entity: Entity.Player, to: 2048);
    waitForEntity(Entity.Player);
    delay(10);
    rotate(entity: Entity.Player, to: 2560);
    waitForEntity(Entity.Player);
    delay(10);
    rotate(entity: Entity.Player, to: 1536);
    waitForEntity(Entity.Player);
    delay(10);
    panTo(x: -997, y: -977, slowdown: 30);
    panTo(x: -1035, y: 4000, slowdown: 50);
    panTo(x: 1222, y: 4000, slowdown: 30);
    panTo(x: 1066, y: -977, slowdown: 50);
    rotate(entity: Entity.Player, to: 2560);
    followEntity(Entity.Player, speed: 30);
    rotate(entity: Entity.Player, to: 2048);
    rotate(entity: Entity.Partner, to: 2048);
    waitForPair();
    speak(Entity.Player, "What a big mansion!\n");
    move(entity: Entity.Player, to: (-6, -1255), sprint: 0, withCamera: true);
    waitForEntity(Entity.Player);
    anim(Entity.Player, Animation(24), wait: 15);
    speak(Entity.Player, "Anybody home?\n");
    anim(Entity.Player, Animation(0), wait: 40);
    look(entity: Entity.Player, at: Entity.Partner);
    waitForEntity(Entity.Player);
    look(entity: Entity.Partner, at: Entity.Player);
    waitForEntity(Entity.Partner);
    speak(Entity.Player, "No one's home or\nthey can't hear me.\n");
    rotate(entity: Entity.Player, to: 3584);
    waitForEntity(Entity.Player);
    rotate(entity: Entity.Player, to: 3072);
    waitForEntity(Entity.Player);
    rotate(entity: Entity.Player, to: 2560);
    waitForEntity(Entity.Player);
    rotate(entity: Entity.Player, to: 2048);
    waitForEntity(Entity.Player);
    showTextbox("Alright. Start exploring!\n");
    return;
  }
  return;
}

section(84) {
  if (item[Item.MansionKey] >= 1 && !trigger(111)) {
    rotate(entity: Entity.Player, to: 1024);
    playSound(8, 3);
    speak(Entity.System, "I used the\n<LIGHTBLUE>Mansion Key<WHITE>!\n");
    setTrigger(Trigger(111));
    goto L1;
  }
  if (item[Item.MansionKey] >= 1 || trigger(111)) goto L1;
  rotate(entity: Entity.Player, to: 1024);
  sfx(8, 2, wait: 5);
  playSound(8, 2);
  speak(Entity.System, "It doesn't open.\nIt's locked.\n");
  return;

L1:
  rotate3DObject(4, 1);
  sfx(8, 1, wait: 10);
  move(entity: Entity.Player, to: (-2000, 1433), sprint: 0);
  warp(to: Map.YAKA13, spawn: 1, trigger: 255);
  return;
}

