  if (item[Item.MansionKey] >= 1 && !trigger(113)) {
    rotate(entity: Entity.Player, to: 1024);
    playSound(8, 3);
    speak(Entity.System, "I used the\n<LIGHTBLUE>Mansion Key<WHITE>!\n");
    setTrigger(Trigger(113));
    goto L1;
  }
  if (item[Item.MansionKey] >= 1 || trigger(113)) goto L1;
  rotate(entity: Entity.Player, to: 1024);
  sfx(8, 2, wait: 5);
  playSound(8, 2);
  speak(Entity.System, "It doesn't open.\nIt's locked.\n");
  return;

L1:
  rotate3DObject(5, 1);
  sfx(8, 1, wait: 10);
  move(entity: Entity.Player, to: (-2000, -882), sprint: 0);
  warp(to: Map.YAKA13, spawn: 2, trigger: 255);
  return;
}

section(82) {
  if (item[Item.MansionKey] >= 1 && !trigger(123)) {
    rotate(entity: Entity.Player, to: 3072);
    playSound(8, 3);
    speak(Entity.System, "I used the\n<LIGHTBLUE>Mansion Key<WHITE>!\n");
    setTrigger(Trigger(123));
    goto L1;
  }
  if (item[Item.MansionKey] >= 1 || trigger(123)) goto L1;
  rotate(entity: Entity.Player, to: 3072);
  sfx(8, 2, wait: 5);
  playSound(8, 2);
  speak(Entity.System, "It doesn't open.\nIt's locked.\n");
  return;

L1:
  rotate3DObject(2, 1);
  sfx(8, 1, wait: 10);
  move(entity: Entity.Player, to: (2000, 1171), sprint: 0);
  warp(to: Map.YAKA17, spawn: 0, trigger: 255);
  return;
}

section(58) {
  move(entity: Entity.Player, to: (0, -2000), sprint: 0);
  playSound(8, 1);
  warp(to: Map.DGHA02, spawn: 0, trigger: 255);
  return;
}

section(81) {
  if (!trigger(360)) {
    rotate(entity: Entity.Player, to: 3072);
    sfx(8, 2, wait: 5);
    playSound(8, 2);
    speak(Entity.System, "It doesn't open. It's sealed\nwith a weird force.\n");
    return;
  }
  rotate3DObject(1, 1);
  sfx(8, 1, wait: 10);
  move(entity: Entity.Player, to: (2000, -722), sprint: 0);
  warp(to: Map.YAKA18, spawn: 0, trigger: 255);
  return;
}

