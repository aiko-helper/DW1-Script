      playSound(0, 7);
      setInventorySize(20);
      setTrigger(Trigger(47));
    }
    4 => {
      setObjectVisibility(53, 0);
      move(entity: Entity.Player, to: (-126, -518), sprint: 1);
      waitForEntity(Entity.Player);
      anim(Entity.Player, Animation(12), wait: 10);
      setObjectVisibility(53, 1);
      playSound(0, 7);
      speak(Entity.System, "『<PINK>次元キーホルダー<WHITE>』を<NEWLINE> 手に入れた!<NEWLINE> アイテムを30個まで持てるぞ!<NEWLINE>");
      setInventorySize(30);
      setTrigger(Trigger(48));
      setTrigger(Trigger(253));
      addPStat(PStat(1), 1);
    }
  }
  addPStat(PStat(21), 1);
  setTrigger(Trigger(337));
  return;
  garbage { 14 00 fe 00 14 00 33 00 34 00 05 00 42 00 06 00 ae 0c ff ff 75 1b a7 fc 00 00 e3 01 00 00 9c 02 64 2b 19 00 01 00 0e 01 18 00 32 00 19 00 16 00 42 00 fe 00 4e fd 18 00 3c f6 00 00 4b 96 02 ff fe 00 19 00 00 00 0e 01 18 00 a2 00 19 00 56 00 fd 14 1b fd 1a 00 81 75 82 a8 82 dc 82 a6 81 41 82 e0 82 a4 88 ab 82 b3 82 b7 82 e9 82 c8 82 e6 81 49 81 76 0d 00 00 00 1b 05 1a 00 81 75 82 d6 82 a2 82 d6 82 a2 81 42 82 b5 82 c8 82 a2 82 f1 82 b6 82 e1 82 c8 82 a2 81 48 81 76 0d 00 00 00 fe 00 67 00 3c 00 1b fd 1a 00 81 75 82 de 81 41 82 b1 82 b1 82 aa 8d c5 8c e3 82 cc 95 94 89 ae 82 dd 82 bd 82 a2 82 be 81 42 81 76 0d 00 00 00 4e fd 0e 00 0e fd 00 00 4f 14 49 00 b5 00 4a c8 4e fd 33 ff a0 fd 00 00 4e fc c3 00 a0 fd 00 00 67 00 28 00 4d fd 00 08 4d fc 00 08 67 00 05 00 1b ff 1a 00 01 07 81 48 81 48 81 48 01 01 0d 00 81 75 82 c7 81 60 81 60 81 60 82 c1 82 bf 82 be 81 48 81 76 0d 00 00 00 4d fd 00 0a 67 00 14 00 4d fd 00 06 67 00 14 00 4d fd 00 08 67 00 05 00 1b fd 1a 00 81 75 8d a1 82 cc 90 ba 81 63 83 8f 83 8b 83 82 83 93 83 55 83 47 83 82 83 93 82 a9 81 49 81 76 0d 00 00 00 1a 00 81 75 91 e5 82 ab 82 a2 94 a0 82 c6 8f ac 82 b3 82 a2 94 a0 82 a9 81 42 0d 00 81 40 82 d3 82 d3 81 41 82 a8 82 dc 82 a6 82 cc 8d 6c 82 a6 82 cd 82 a8 8c a9 82 c6 82 a8 }
