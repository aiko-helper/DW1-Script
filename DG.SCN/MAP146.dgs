// MAP146.SCN
#include "functions.dgs"
#pragma script index=146 start=0x60000 end=0x60800 headerU16=0x24 sentinelOff=0x675
#include "entities.dgs"

section onEnter(254) {
  spawnChest(Item.LargeMP, 439, -429, 3072, 681);
  return;
}

section(51) {
  move(entity: Entity.Player, to: (1178, 1101), sprint: 0);
  warp(to: Map.MGEN01, spawn: 1, trigger: 255);
  return;
}

section(52) {
  move(entity: Entity.Player, to: (-405, 276), sprint: 0);
  warp(to: Map.MGEN03, spawn: 0, trigger: 255);
  return;
}

section(5) {
  speak(Entity(5), "「君をみちびかねばなりません!」<NEWLINE>");
  finishEncounter(Trigger(285));
}

section(6) {
  speak(Entity(6), "「さあ、ザンゲするのです。」<NEWLINE>");
  finishEncounter(Trigger(285));
}

section(7) {
