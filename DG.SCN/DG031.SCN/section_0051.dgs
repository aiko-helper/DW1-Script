// source: extract/DIGIMON/SCN/DG.SCN
// DG031.SCN, section 51

section section_51(51) {  // len=2376
    if (!trigger(230)) goto L_0010;
    goto L_080a;
L_0010:
    setTrigger(230);
    setDialogOwner(Entity.Player);
    showTextbox("!\n");
    look(entity: Entity.Player, at: 5);
    look(entity: Entity.Partner, at: 5);
    moveCamera(to: 5, speed: 20);
    waitForEntity(200);
    setDialogOwner(5);
    showTextbox("What happen to the island?\n");
    showTextbox("Tribes fell apart losing\nmemories and becoming wild.\n");
    showTextbox("I don't know how long\nI can stay sane.\n");
    showTextbox("We can't leave it like this!\nThey must realize the danger!\n");
    playAnimation(5, 28);
    delay(20);
    callSubroutine(34);
    playSound(8, 4);
    delay(20);
    playSound(8, 4);
    delay(20);
    playSound(8, 4);
    delay(10);
    move(entity: Entity.Player, to: (-1210, -193), sprint: 1);
    move(entity: Entity.Partner, to: (-1468, -473), sprint: 1);
    waitForEntity(Entity.Player);
    waitForEntity(Entity.Partner);
    look(entity: Entity.Player, at: 5);
    look(entity: Entity.Partner, at: 5);
    setTrigger(106);
    delay(20);
    playAnimation(Entity.Player, 7);
    delay(20);
    setDialogOwner(Entity.Player);
    showTextbox("Stop! Do you want to\nruin the island?!\n");
    delay(20);
    look(entity: 5, at: Entity.Player);
    setDialogOwner(5);
    showTextbox("Who are you? Move out of my\nway! This is the only way!\n");
    setTrigger(1);
    setPStat(250, 1);
    setPStat(251, 5);
    setPStat(252, 255);
    setPStat(253, 255);
    fadeOutHUD();
    delay(1);
    startBattle();
    unsetTrigger(1);
    setPStat(250, 0);
    look(entity: Entity.Player, at: 5);
    look(entity: 5, at: Entity.Player);
    look(entity: Entity.Partner, at: 5);
    setDialogOwner(5);
    showTextbox("Are you telling me\nthere's another way?\n");
    playAnimation(Entity.Player, 7);
    delay(20);
    setDialogOwner(Entity.Player);
    showTextbox("If the island is ruined,\nit defeats the purpose!\nListen to me.\n");
    setDialogOwner(5);
    showTextbox("What?\n");
L_03e4:
    playAnimation(Entity.Player, 19);
    delay(20);
    setDialogOwner(Entity.Player);
    showTextbox("We're building a city for\nthe island by gathering all\nDigimon.\n");
    showTextbox("I heard that we can\nsave the island from this\ndanger by uniting Digimon.\n");
    setDialogOwner(5);
    showTextbox("I think you are right, but\ngathering all the Digimon,\nthat's a big...\n");
    playAnimation(Entity.Player, 7);
    delay(20);
    setDialogOwner(Entity.Player);
    showTextbox("We're working on it right\nnow. Nothing is impossible!\n");
    setDialogOwner(5);
    showTextbox("That's a big job!\nBut I'm moved...\nMaybe, you guys can do it.\n");
    playAnimation(Entity.Player, 19);
    delay(20);
    setDialogOwner(Entity.Player);
    showTextbox("If you believe in us, I want\nyou to come to the city.\n");
    delay(20);
    setDialogOwner(5);
    showTextbox("Alright. I'll go to the city.\nI guess that's my new path!\n");
    goto L_0790;
L_0790:
    move(entity: 5, to: (691, -1990), sprint: 1);
    if (pstat[101] >= 10) goto L_07b8;
    addPStat(101, 1);
    delay(10);
    look(entity: Entity.Player, at: 5);
    look(entity: Entity.Partner, at: 5);
    goto L_0790;
L_07b8:
    waitForEntity(5);
    unloadEntity(5);
    setPStat(101, 0);
    playSound(8, 8);
    setDialogOwner(Entity.System);
    showTextbox("Meramon joins the city!\n");
    setTrigger(209);
    addPStat(1, 2);
    moveCamera(to: Entity.Player, speed: 10);
    waitForEntity(200);
    return;
L_080a:
    if (!trigger(209)) goto L_0818;
    return;
L_0818:
    moveCamera(to: 5, speed: 20);
    waitForEntity(200);
    setDialogOwner(5);
    showTextbox("I knew you'd come back.\nI need to know the answer!\n");
    look(entity: 5, at: Entity.Player);
    move(entity: Entity.Partner, to: Entity.Player, sprint: 1);
    waitForEntity(Entity.Partner);
    setTrigger(1);
    setPStat(250, 1);
    setPStat(251, 5);
    setPStat(252, 255);
    setPStat(253, 255);
    fadeOutHUD();
    delay(1);
    startBattle();
    unsetTrigger(1);
    setPStat(250, 0);
    look(entity: Entity.Player, at: 5);
    look(entity: 5, at: Entity.Player);
    look(entity: Entity.Partner, at: 5);
    setDialogOwner(5);
    showTextbox("I guess, I lose...\n");
    setDialogOwner(Entity.Player);
    showTextbox("There's something\nI need to tell you.\n");
    goto L_03e4;
    return;
}
