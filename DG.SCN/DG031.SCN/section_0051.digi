  01e8:  playAnimation Player 7
  01ec:  delay 20
  01f0:  setDialogOwner Player
  01f2:  showTextbox "Stop! Do you want to\nruin the island?!\n"
  0244:  delay 20
  0248:  lookAt 5 Player
  024c:  setDialogOwner 5
  024e:  showTextbox "Who are you? Move out of my\nway! This is the only way!\n"
