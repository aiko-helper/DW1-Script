  002a:  waitForEntity 200
  002c:  setDialogOwner 5
  002e:  showTextbox "What happen to the island?\n"
  0068:  showTextbox "Tribes fell apart losing\nmemories and becoming wild.\n"
  00d6:  showTextbox "I don't know how long\nI can stay sane.\n"
  0128:  showTextbox "We can't leave it like this!\nThey must realize the danger!\n"
