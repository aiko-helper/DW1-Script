  02e8:  lookAt 5 Player
  02ec:  lookAt Partner 5
  02f0:  setDialogOwner 5
  02f2:  showTextbox "Are you telling me\nthere's another way?\n"
  0346:  playAnimation Player 7
  034a:  delay 20
  034e:  setDialogOwner Player
  0350:  showTextbox "If the island is ruined,\nit defeats the purpose!\nListen to me.\n"
  03d2:  setDialogOwner 5
  03d4:  showTextbox "What?\n"
  03e4:  playAnimation Player 19
  03e8:  delay 20
  03ec:  setDialogOwner Player
  03ee:  showTextbox "We're building a city for\nthe island by gathering all\nDigimon.\n"
  0470:  showTextbox "I heard that we can\nsave the island from this\ndanger by uniting Digimon.\n"
  0506:  setDialogOwner 5
  0508:  showTextbox "I think you are right, but\ngathering all the Digimon,\nthat's a big...\n"
  0598:  playAnimation Player 7
  059c:  delay 20
  05a0:  setDialogOwner Player
  05a2:  showTextbox "We're working on it right\nnow. Nothing is impossible!\n"
  0612:  setDialogOwner 5
  0614:  showTextbox "That's a big job!\nBut I'm moved...\nMaybe, you guys can do it.\n"
  0694:  playAnimation Player 19
  0698:  delay 20
  069c:  setDialogOwner Player
  069e:  showTextbox "If you believe in us, I want\nyou to come to the city.\n"
  070e:  delay 20
  0712:  setDialogOwner 5
  0714:  showTextbox "Alright. I'll go to the city.\nI guess that's my new path!\n"
  078c:  jump section_51+0x790
