// DG183.SCN
#include "functions.dgs"
#pragma script index=183 start=0x8c000 end=0x8d000 headerU16=0x10 sentinelOff=0xfe

section onEnter(254) {
  return;
}

section(51) {
    // (empty)
}

section(60) {
  setDigimon(Digimon.NPCMyotismon, 0, 0);
  move(entity: Entity.Player, to: (276, -1057), animDuration: 6);
  move(entity: Entity.Partner, to: (-688, 481), animDuration: 6);
  waitForEntity(Entity.Player);
  waitForEntity(Entity.Partner);
  rotate(entity: Entity.Player, to: 2128);
  rotate(entity: Entity.Partner, to: 3072);
  speak(Entity.Player, "Yum, Yum.\n");
  speak(5, "Uh...\n");
  look(entity: 5, at: Entity.Player);
  speak(5, "Please listen up.\n");
  speak(Entity.Player, "Yummy, Yummy.\n");
  speak(5, "My men don't listen any more.\n");
  showTextbox("I don't think they can\nremember my orders.\n");
  showTextbox("Sometimes they don't\neven understand.\n");
  showTextbox("My men should\nbring my meals, but...\n");
  speak(Entity.Player, "Yummy...\n");
  speak(5, "While I was working they\ndidn't bring my meals,\nso I forgot to eat.\n");
  look(entity: Entity.Player, at: 5);
  speak(Entity.Player, "You're too wrapped up in\nyour work.\n");
  speak(5, "I'm so embarrassed.\n");
  speak(Entity.Player, "I think there's trouble\nin the mansion.\n");
  speak(5, "Problem on the island? Is\neveryone acting like my men?\n");
  speak(Entity.Player, "Yes, they're all losing\ntheir memory.\n");
  speak(5, "Do you think someone's\ndoing this?\n");
  speak(Entity.Player, "Hmmm\n");
  speak(5, "What can I do?\n");
  speak(Entity.Player, "We're building a city to\nunite Digimons' hearts.\n");
  showTextbox("We're traveling\nto find friends.\n");
  speak(5, "What I can do?\nMy men have only\nfighting skills.\n");
  if (trigger(205)) goto L1;
  showTextbox("I can't leave them here.\n");
  speak(Entity.Player, "I see...\n");
  speak(5, "Let me think about it.\nI'm very sorry, but...\n");
  speak(Entity.Player, "I'll come back again.\nDon't forget to eat.\n");
  goto L2;

L1:
  speak(Entity.Player, "Want to enter a match?\n");
  speak(5, "A match? It's perfect,\nit will refresh my men.\n");
  speak(Entity.Player, "So, you want to join?\n");
  speak(5, "Yes, but I still have\nresearch to do here.\nI'll go there soon.\n");
  setTrigger(266);

L2:
  warp(to: Map.YAKA11A, spawn: 4, trigger: 255);
  return;
  garbage { 10 00 fe 00 10 00 33 00 12 00 3c 00 12 00 ff ff fe 00 47 b1 00 00 6c fd 14 01 df fb 06 00 6c fc 50 fd e1 01 06 00 4a fd 4a fc 4d fd 50 08 4d fc 00 0c 1b fd 1a 00 82 78 82 95 82 8d 81 43 81 40 82 78 82 95 82 8d 81 42 0d 00 00 00 1b 05 1a 00 82 74 82 88 81 42 81 42 81 42 0d 00 00 00 4c 00 05 fd 1b 05 1a 00 82 6f 82 8c 82 85 82 81 82 93 82 85 81 40 82 8c 82 89 82 93 82 94 82 85 82 8e 81 40 82 95 82 90 81 42 0d 00 00 00 1b fd 1a 00 82 78 82 95 82 8d 82 8d 82 99 81 43 81 40 82 78 82 95 82 8d 82 8d 82 99 81 42 0d 00 00 00 1b 05 1a 00 82 6c 82 99 81 40 82 8d 82 85 82 8e 81 40 82 84 82 8f 82 8e 81 75 82 94 81 40 82 8c 82 89 82 93 82 94 82 85 82 8e 81 40 82 81 82 8e 82 99 81 40 82 8d 82 8f 82 92 82 85 81 42 0d 00 00 00 1a 00 82 68 81 40 82 84 82 8f 82 8e 81 75 82 94 81 40 82 94 82 88 82 89 82 8e 82 8b 81 40 82 94 82 88 82 85 82 99 81 40 82 83 82 81 82 8e 0d 00 82 92 82 85 82 8d 82 85 82 8d 82 82 82 85 82 92 81 40 82 8d 82 99 81 40 82 8f 82 92 82 84 82 85 82 92 82 93 81 42 0d 00 00 00 1a 00 82 72 82 8f 82 8d 82 85 82 94 82 89 82 8d 82 85 82 93 81 40 82 94 82 88 82 85 82 99 81 40 82 84 82 8f 82 8e 81 75 82 94 0d 00 82 85 82 96 82 85 82 8e 81 40 82 95 82 8e 82 84 82 85 82 92 82 93 82 94 82 81 82 8e 82 84 81 42 0d 00 00 00 1a 00 82 6c 82 99 81 40 82 8d 82 85 82 8e 81 40 82 93 82 88 82 8f 82 95 82 8c 82 84 0d 00 82 82 82 92 82 89 82 8e 82 87 81 40 82 8d 82 99 81 40 82 8d 82 85 82 81 82 8c 82 93 81 43 81 40 82 82 82 95 82 94 81 42 81 42 81 42 0d 00 00 00 1b fd 1a 00 82 78 82 95 82 8d 82 8d 82 99 81 42 81 42 81 42 0d 00 00 00 1b 05 1a 00 82 76 82 88 82 89 82 8c 82 85 81 40 82 68 81 40 82 97 82 81 82 93 81 40 82 97 82 8f 82 92 82 8b 82 89 82 8e 82 87 81 40 82 94 82 88 82 85 82 99 0d 00 82 84 82 89 82 84 82 8e 81 75 82 94 81 40 82 82 82 92 82 89 82 8e 82 87 81 40 82 8d 82 99 81 40 82 8d 82 85 82 81 82 8c 82 93 81 43 0d 00 82 93 82 8f 81 40 82 68 81 40 82 86 82 8f 82 92 82 87 82 8f 82 94 81 40 82 94 82 8f 81 40 82 85 82 81 82 94 81 42 0d 00 00 00 4c 00 fd 05 1b fd 1a 00 82