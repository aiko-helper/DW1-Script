// DG183.SCN
#pragma script index=183 start=0x8c000 end=0x8d000 headerU16=0x10 sentinelOff=0xfe

section onEnter(254) {  // len=2
    return;
}

section(51) {  // len=0
    // (empty)
}

section(60) {  // len=4078
    setDigimon(Digimon.NPCMyotismon, 0, 0);
    move(entity: Entity.Player, to: (276, -1057), animDuration: 6);
    move(entity: Entity.Partner, to: (-688, 481), animDuration: 6);
    waitForEntity(Entity.Player);
    waitForEntity(Entity.Partner);
    rotate(entity: Entity.Player, to: 2128);
    rotate(entity: Entity.Partner, to: 3072);
    setDialogOwner(Entity.Player);
    showTextbox("Yum, Yum.\n");
    setDialogOwner(5);
    showTextbox("Uh...\n");
    look(entity: 5, at: Entity.Player);
    setDialogOwner(5);
    showTextbox("Please listen up.\n");
    setDialogOwner(Entity.Player);
    showTextbox("Yummy, Yummy.\n");
    setDialogOwner(5);
    showTextbox("My men don't listen any more.\n");
    showTextbox("I don't think they can\nremember my orders.\n");
    showTextbox("Sometimes they don't\neven understand.\n");
    showTextbox("My men should\nbring my meals, but...\n");
    setDialogOwner(Entity.Player);
    showTextbox("Yummy...\n");
    setDialogOwner(5);
    showTextbox("While I was working they\ndidn't bring my meals,\nso I forgot to eat.\n");
    look(entity: Entity.Player, at: 5);
    setDialogOwner(Entity.Player);
    showTextbox("You're too wrapped up in\nyour work.\n");
    setDialogOwner(5);
    showTextbox("I'm so embarrassed.\n");
    setDialogOwner(Entity.Player);
    showTextbox("I think there's trouble\nin the mansion.\n");
    setDialogOwner(5);
    showTextbox("Problem on the island? Is\neveryone acting like my men?\n");
    setDialogOwner(Entity.Player);
    showTextbox("Yes, they're all losing\ntheir memory.\n");
    setDialogOwner(5);
    showTextbox("Do you think someone's\ndoing this?\n");
    setDialogOwner(Entity.Player);
    showTextbox("Hmmm\n");
    setDialogOwner(5);
    showTextbox("What can I do?\n");
    setDialogOwner(Entity.Player);
    showTextbox("We're building a city to\nunite Digimons' hearts.\n");
    showTextbox("We're traveling\nto find friends.\n");
    setDialogOwner(5);
    showTextbox("What I can do?\nMy men have only\nfighting skills.\n");
    if (trigger(205)) goto L1;
    showTextbox("I can't leave them here.\n");
    setDialogOwner(Entity.Player);
    showTextbox("I see...\n");
    setDialogOwner(5);
    showTextbox("Let me think about it.\nI'm very sorry, but...\n");
    setDialogOwner(Entity.Player);
    showTextbox("I'll come back again.\nDon't forget to eat.\n");
    goto L2;

L1:
    setDialogOwner(Entity.Player);
    showTextbox("Want to enter a match?\n");
    setDialogOwner(5);
    showTextbox("A match? It's perfect,\nit will refresh my men.\n");
    setDialogOwner(Entity.Player);
    showTextbox("So, you want to join?\n");
    setDialogOwner(5);
    showTextbox("Yes, but I still have\nresearch to do here.\nI'll go there soon.\n");
    setTrigger(266);

L2:
    warp(to: Map.YAKA11A, spawn: 4, trigger: 255);
    return;
