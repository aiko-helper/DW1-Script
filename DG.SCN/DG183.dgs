// DG183.SCN
#include "functions.dgs"
#pragma script index=183 start=0x89000 end=0x8a000 headerU16=0x10 sentinelOff=0xfe
#include "entities.dgs"

section onEnter(254) {
  return;
}

section(51) {
  if (!trigger(53)) {
    setTrigger(Trigger(53));
    speak(Entity(5), "「やあ、<LIGHTBLUE><PLAYER><WHITE>。おどろいたかね?<NEWLINE> 私が医院を開くとは思わなかったろう。」<NEWLINE>");
    showTextbox("「病気やケガの治療は私に任せてくれ。<NEWLINE> タダとは言わないが格安にしておくよ!」<NEWLINE>");
  }
  {
    if ((cond & 0x20) == 0x01 || (cond & 0x40) == 0x01) break;
    goto L1;
  }
  speak(Entity(5), "「おや、具合が悪いようだね。健康に<NEWLINE> 気をつかってくれないと困るよ。」<NEWLINE>");
  showTextbox("「うむ、ではすぐ治療しよう。<NEWLINE> 代金は300<B><it>にまけておこう。」<NEWLINE>");
  if (money >= 300) {
    reduceMoney(300);
  } else {
    speak(Entity(5), "「何、<B><it>が足りないのか!仕方ない、<NEWLINE> 今はらえるだけでいいよ。いざと言う時の<NEWLINE> ために、ムダづかいはひかえるんだぞ。」<NEWLINE>");
    reduceMoney(300);
  }
  move(entity: Entity.Partner, to: (-200, -1039), sprint: 0);
  waitForEntity(Entity.Partner);
  look(entity: Entity(5), at: Entity.Partner);
  look(entity: Entity.Player, at: Entity.Partner);
  delay(10);
  followEntity(Entity.Partner, speed: 20);
  sfx(8, 2, wait: 40);
  sfx(8, 3, wait: 20);
  removeCondition(Condition.Injured);
  removeCondition(Condition.Sick);
  anim(Entity.Partner, Animation(11), wait: 20);
  speak(Entity(5), "「よーし、これで治った。これからは<NEWLINE> 気をつけなさい。」<NEWLINE>");
  if (stat[Stat.Tiredness] >= 50) {
    setStats(tiredness: 50);
  }
  followEntity(Entity.Player, speed: 10);
  return;

L1:
  speak(Entity(5), "「やあ、病気やケガはしてないようだね。<NEWLINE> それで私に何の用かな?」<NEWLINE>");
  setDialogOwner(Entity.Player);
  setSelection(L2, section_52.L1, section_52.L2);
  showTextbox("「疲れをとりたい。」<NEWLINE>「薬を売ってほしい。」<NEWLINE>「用は無いよ。」<NEWLINE>");
  waitForSelectionChoice();
  goto section_52.L2;

L2:
  {
    if (stat[Stat.Tiredness] >= 80) {
      speak(Entity(5), "「おや、いかんぞ。<ORANGE><DIGIMON><WHITE>の疲労は<NEWLINE> ほぼ極限状態だ。早く休まないと!」<NEWLINE>");
      break;
    }
    if (stat[Stat.Tiredness] >= 50) {
      speak(Entity(5), "「おや、うーむ…。<ORANGE><DIGIMON><WHITE>はかなり<NEWLINE> 疲れをためているな。手おくれになる前に<NEWLINE> 休みなさい。」<NEWLINE>");
      break;
    }
    if (stat[Stat.Tiredness] >= 20) {
      speak(Entity(5), "「うーん、<ORANGE><DIGIMON><WHITE>は少し疲れている<NEWLINE> みたいだ。無理はいかんよ。」<NEWLINE>");
      break;
    }
    speak(Entity(5), "「ふむふむ、<ORANGE><DIGIMON><WHITE>は元気だね。<NEWLINE> 疲れているといろいろ害があるから気を<NEWLINE> つけるんだよ。」<NEWLINE>");
  }
  pstat[:SavedTime] = time();
  addMinutesToDate(PStat.SavedTime, 60);
  advanceToDate(PStat.SavedTime);
  addStats(currentHP: 500, currentMP: 500);
  reduceStats(tiredness: 20);
  warp(to: Map.ROOM04, spawn: 1, trigger: 255);
  return;
}

section(52) {
  speak(Entity(5), "「うむ……<NEWLINE> 疲れはとれたかな。」<NEWLINE>");
  showTextbox("「まだ何か用があるかな?」<NEWLINE>");
  setDialogOwner(Entity.Player);
  setSelection(section_51.L2, L1, L2);
  showTextbox("「まだ休む。」<NEWLINE>「薬を売ってほしい。」<NEWLINE>「もう用は無いよ。」<NEWLINE>");
  waitForSelectionChoice();
  goto L2;

L1:
  speak(Entity(5), "「ふむ、いいだろう。」<NEWLINE>");
  setDialogOwner(Entity.Player);
  setSelection(L3, L4, L2);
  showTextbox(" ばんそうこう        400<B><it><NEWLINE> 薬            1200<B><it><NEWLINE> やっぱり買わない<NEWLINE>");
  waitForSelectionChoice();
  goto L2;

L2:
  loop {
    speak(Entity(5), "「うむ、調子が悪いと感じたらすぐに<NEWLINE> 来なさい。」<NEWLINE>");
    roll(pstat: PStat.RollScratch, max: 9);
    if (pstat[110] <= 0) {
      speak(Entity(5), "「ところで…疲労がなかなか回復しない時は<NEWLINE> トレーニングをひかえて、食事やねむりを<NEWLINE> ちゃんととったほうがいいよ。」<NEWLINE>");
      return;
    }
    if (pstat[110] <= 1) {
      speak(Entity(5), "「ところで…寒い場所や、あつい場所には<NEWLINE> 長時間いないほうがいいよ。<NEWLINE> デジモンによっては病気のもとだ。」<NEWLINE>");
      return;
    }
    if (pstat[110] <= 2) {
      speak(Entity(5), "「ところで…ばんそうこうはあんまりアテに<NEWLINE> しないほうがいいよ。ケガはいいけど、<NEWLINE> 病気にはほとんど効かないんだ。」<NEWLINE>");
      return;
    }
    if (pstat[110] <= 3) {
      speak(Entity(5), "「ところで…薬で病気をなおすのはいいが、<NEWLINE> 薬では病気のもとになるつかれが全く<NEWLINE> とれないんだ。しょせん薬だからね。」<NEWLINE>");
      return;
    }
    if (pstat[110] <= 4) {
      speak(Entity(5), "「ところで…バトルが終わる時に<NEWLINE> HPが少ないとケガしやすいから<NEWLINE> 注意するといいよ。」<NEWLINE>");
      return;
    }
    if (pstat[110] <= 5) {
      speak(Entity(5), "「ところで…ごきげんや疲労を<NEWLINE> 良い状態にたもつことは、長生きに<NEWLINE> つながるんだよ。」<NEWLINE>");
      return;
    } else {
      return;

L3:
    }
    {
      if (money < 400) {
        speak(Entity(5), "「<B><it>が足りないのか。<NEWLINE> それでは売ることができないな。」<NEWLINE>");
        break;
        return;
      }
      giveItem(Item.Bandage, 1);
      if (trigger(0)) {
        speak(Entity(5), "「持ち物がいっぱいだよ。」<NEWLINE>");
        return;
      }
      reduceMoney(400);
      break;

L4:
      if (money < 1200) {
        speak(Entity(5), "「<B><it>が足りないのか。<NEWLINE> それでは売ることができないな。」<NEWLINE>");
        break;
        return;
      }
      giveItem(Item.Medicine, 1);
      if (trigger(0)) {
        speak(Entity(5), "「持ち物がいっぱいだよ。」<NEWLINE>");
        return;
      }
      reduceMoney(1200);
      break;
    }
    speak(Entity(5), "「まだ何か用があるかな?」<NEWLINE>");
    setDialogOwner(Entity.Player);
    setSelection(section_51.L2, L1, L2);
    showTextbox("「疲れをとりたい。」<NEWLINE>「もっと薬を売ってほしい。」<NEWLINE>「もう用は無いよ。」<NEWLINE>");
    waitForSelectionChoice();
  }
  return;
  garbage { 10 00 fe 00 10 00 33 00 12 00 34 00 f0 04 ff ff fe 00 19 00 01 00 35 00 18 00 c8 00 19 00 1c 00 35 00 1b 05 1a 00 81 75 82 e2 82 a0 81 41 01 06 05 00 01 01 81 42 82 a8 82 c7 82 eb 82 a2 82 bd 82 a9 82 cb 81 48 0d 00 81 40 8e 84 82 aa 88 e3 89 40 82 f0 8a 4a 82 ad 82 c6 82 cd 8e 76 82 ed 82 c8 82 a9 82 c1 82 bd 82 eb 82 a4 81 42 81 76 0d 00 00 00 1a 00 81 75 95 61 8b 43 82 e2 83 50 83 4b 82 cc 8e a1 97 c3 82 cd 8e 84 82 c9 94 43 82 b9 82 c4 82 ad 82 ea 81 42 0d 00 81 40 83 5e 83 5f 82 c6 82 cd 8c be 82 ed 82 c8 82 a2 82 aa 8a 69 88 c0 82 c9 82 b5 82 c4 82 a8 82 ad 82 e6 81 49 81 76 0d 00 00 00 19 00 23 00 20 01 a3 00 40 01 18 00 dc 00 19 00 16 00 a4 02 1b 05 1a 00 81 75 82 a8 82 e2 81 41 8b ef 8d 87 82 aa 88 ab 82 a2 82 e6 82 a4 82 be 82 cb 81 42 8c 92 8d 4e 82 c9 0d 00 81 40 8b 43 82 f0 82 c2 82 a9 82 c1 82 c4 82 ad 82 ea 82 c8 82 a2 82 c6 8d a2 82 e9 82 e6 81 42 81 76 0d 00 00 00 1a 00 81 75 82 a4 82 de 81 41 82 c5 82 cd 82 b7 82 ae 8e a1 97 c3 82 b5 82 e6 82 a4 81 42 0d 00 81 40 91 e3 8b e0 82 cd 82 52 82 4f 82 4f 81 6f 81 70 82 c9 82 dc 82 af 82 c4 82 a8 82 b1 82 a4 81 42 81 76 0d 00 00 00 19 00 25 00 00 02 2c 01 00 00 18 00 8c 01 19 00 2b 00 2c 01 00 00 16 00 12 02 1b 05 1a 00 81 75 89 bd 81 41 81 6f 81 70 82 aa 91 ab 82 e8 82 c8 82 a2 82 cc 82 a9 81 49 8e 64 95 fb 82 c8 82 a2 81 41 0d 00 81 40 8d a1 82 cd 82 e7 82 a6 82 e9 82 be 82 af 82 c5 82 a2 82 a2 82 e6 81 42 82 a2 82 b4 82 c6 8c be 82 a4 8e 9e 82 cc 0d 00 81 40 82 bd 82 df 82 c9 81 41 83 80 83 5f 82 c3 82 a9 82 a2 82 cd 82 d0 82 a9 82 a6 82 e9 82 f1 82 be 82 bc 81 42 81 76 0d 00 00 00 2b 00 2c 01 00 00 4e fc 38 ff f1 fb 00 00 4a fc 4c 00 05 fc 4c 00 fd fc 67 00 0a 00 50 00 fc 14 4a c8 5a 00 08 02 67 00 28 00 5a 00 08 03 67 00 14 00 65 20 65 40 56 00 fc 0b 67 00 14 00 1b 05 1a 00 81 75 82 e6 81 5b 82 b5 81 41 82 b1 82 ea 82 c5 8e a1 82 c1 82 bd 81 42 82 b1 82 ea 82 a9 82 e7 82 cd 0d 00 81 40 8b 43 82 f0 82 c2 82 af 82 c8 82 b3 82 a2 81 42 81 76 0d 00 00 00 19 00 20 00 08 02 32 00 18 00 9c 02 19