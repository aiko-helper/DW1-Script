// DG111.SCN
#include "functions.dgs"
#pragma script index=111 start=0x50000 end=0x50800 headerU16=0x20 sentinelOff=0x24
#include "entities.dgs"

section onEnter(254) {
  spawnItemChance(max: 99, chance: 16, item: Item.Digimushroom, x: 50, y: 39);
  spawnItemChance(max: 99, chance: 4, item: Item.Digimushroom, x: 34, y: 78);
  spawnItemChance(max: 99, chance: 7, item: Item.Digimushroom, x: 32, y: 41);
  spawnItemChance(max: 99, chance: 3, item: Item.Happymushroom, x: 49, y: 74);
  setTrigger(Trigger(112));
  return;
}

section(5) {
  speak(Entity(5), "What a fool!\n");
  finishEncounter(Trigger(289));
}

section(6) {
  speak(Entity(6), "I'll destroy all this!\n");
  finishEncounter(Trigger(289));
}

section(7) {
  speak(Entity(7), "There's no place like\na forest.\n");
  finishEncounter(Trigger(291));
}

section(8) {
  speak(Entity(8), "Nobody has gotten past me.\n");
  finishEncounter(Trigger(301));
}

section(9) {
  speak(Entity(9), "I'll bring you down.\n");
  finishEncounter(Trigger(301));
}

section(10) {
  speak(Entity(10), "I'm not the fool, you are!\n");
  finishEncounter(Trigger(296));
