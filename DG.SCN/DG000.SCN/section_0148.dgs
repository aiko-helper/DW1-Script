section section_148(148) {  // len=50
    setScript(142, Map.OMOC05);
    if (!trigger(350)) goto L_001c;
    setPStat(245, 6);
    setBGM(21);
    goto L_0022;
L_001c:
    setPStat(245, 5);
    setBGM(21);
L_0022:
    loadDigimon(Digimon.ToyAgumon);
    setDigimon(Digimon.ToyAgumon, 0, 1);
    setDigimon(Digimon.ToyAgumon, 1, 1);
    setDigimon(Digimon.ToyAgumon, 2, 1);
    return;
}
