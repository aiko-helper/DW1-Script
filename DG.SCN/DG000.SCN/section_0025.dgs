// source: extract/DIGIMON/SCN/DG.SCN
// DG000.SCN, section 25

section section_25(25) {  // len=86
    setScript(26, Map.TUNN02);
    if (trigger(150) && !trigger(234)) goto L_002e;
    setPStat(245, 1);
    setBGM(4);
    loadDigimon(Digimon.Goburimon);
    setDigimon(Digimon.Goburimon, 0, 1);
    setDigimon(Digimon.Goburimon, 1, 1);
    setDigimon(Digimon.Goburimon, 2, 1);
    goto L_0044;
L_002e:
    setPStat(245, 2);
    setBGM(6);
    loadDigimon(Digimon.NPCOgremon);
    loadDigimon(Digimon.Agumon);
    setDigimon(Digimon.NPCOgremon, 3, 0);
    setDigimon(Digimon.Agumon, 4, 0);
    setDigimon(Digimon.Agumon, 5, 0);
L_0044:
    if (pstat[17] != 2) goto L_0054;
    setPStat(17, 1);
L_0054:
    return;
}
