// source: extract/DIGIMON/SCN/DG.SCN
// DG000.SCN, section 2

section section_2(2) {  // len=54
    setScript(3, Map.MAYO03);
    setPStat(245, 0);
    setBGM(1);
    if (trigger(246)) goto L_0022;
    loadDigimon(Digimon.NPCPalmon);
    setDigimon(Digimon.NPCPalmon, 2, 0);
    goto L_0034;
L_0022:
    loadDigimon(Digimon.Goburimon);
    setDigimon(Digimon.Goburimon, 0, 1);
    setDigimon(Digimon.Goburimon, 1, 1);
    setDigimon(Digimon.Goburimon, 3, 1);
    setDigimon(Digimon.Goburimon, 4, 1);
L_0034:
    return;
}
