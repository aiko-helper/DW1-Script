// source: extract/DIGIMON/SCN/DG.SCN
// DG000.SCN, section 153

section section_153(153) {  // len=84
    setScript(147, Map.FACT02);
    setPStat(245, 0);
    setBGM(22);
    roll(pstat: 110, max: 99);
    if (pstat[110] > 2 || trigger(227)) goto L_0028;
    loadDigimon(Digimon.NPCMetalMamemon);
    setDigimon(Digimon.NPCMetalMamemon, 4, 1);
    return;
L_0028:
    storeDate(105);
    if (pstat[107] < 7 || pstat[107] >= 19) goto L_0048;
    loadDigimon(Digimon.Guardromon);
    setDigimon(Digimon.Guardromon, 0, 1);
    setDigimon(Digimon.Guardromon, 1, 1);
    goto L_0052;
L_0048:
    loadDigimon(Digimon.Geremon);
    setDigimon(Digimon.Geremon, 2, 1);
    setDigimon(Digimon.Geremon, 3, 1);
L_0052:
    return;
}
