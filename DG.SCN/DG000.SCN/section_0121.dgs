// source: extract/DIGIMON/SCN/DG.SCN
// DG000.SCN, section 121

section section_121(121) {  // len=94
    setScript(117, Map.MIST07);
    setPStat(245, 0);
    setBGM(20);
    if (trigger(114) || trigger(147)) goto L_002c;
    loadDigimon(Digimon.Fugamon);
    setDigimon(Digimon.Fugamon, 0, 1);
    setDigimon(Digimon.Fugamon, 1, 1);
    setDigimon(Digimon.Fugamon, 2, 1);
    return;
L_002c:
    storeDate(105);
    if (pstat[107] < 7 || pstat[107] >= 19) goto L_0052;
    loadDigimon(Digimon.Goburimon);
    loadDigimon(Digimon.Fugamon);
    setDigimon(Digimon.Goburimon, 3, 1);
    setDigimon(Digimon.Goburimon, 4, 1);
    setDigimon(Digimon.Fugamon, 5, 1);
    goto L_005c;
L_0052:
    loadDigimon(Digimon.Tsukaimon);
    setDigimon(Digimon.Tsukaimon, 6, 1);
    setDigimon(Digimon.Tsukaimon, 7, 1);
L_005c:
    return;
}
