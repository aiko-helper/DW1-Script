section section_80(80) {  // len=64
    setScript(77, Map.KODA01);
    setPStat(245, 0);
    setBGM(14);
    loadDigimon(Digimon.Vermilimon);
    loadDigimon(Digimon.Yanmamon);
    storeDate(105);
    if (pstat[107] < 7 || pstat[107] >= 19) goto L_0032;
    setDigimon(Digimon.Vermilimon, 0, 1);
    setDigimon(Digimon.Yanmamon, 1, 1);
    setDigimon(Digimon.Vermilimon, 2, 1);
    goto L_003e;
L_0032:
    setDigimon(Digimon.Yanmamon, 3, 1);
    setDigimon(Digimon.Vermilimon, 4, 1);
    setDigimon(Digimon.Vermilimon, 5, 1);
L_003e:
    return;
}
