section_18(18):     ; len=78
  0000:  setScript MIHA01 MIHA00
  0006:  setPStat 245 0
  000a:  setBGM 3
  000c:  storeDate 105
  000e:  if pstat[107] < 7 OR pstat[107] >= 19 then section_18+0x36
  001e:  loadDigimon Goburimon
  0020:  setDigimon Goburimon 0 1
  0024:  setDigimon Goburimon 1 1
  0028:  loadDigimon Aruraumon
  002a:  setDigimon Aruraumon 2 1
  002e:  setDigimon Aruraumon 3 1
  0032:  jump section_18+0x4a
  0036:  loadDigimon Goburimon
  0038:  setDigimon Goburimon 4 1
  003c:  setDigimon Goburimon 5 1
  0040:  loadDigimon Gotsumon
  0042:  setDigimon Gotsumon 6 1
  0046:  setDigimon Gotsumon 7 1
  004a:  endSection
  004c:  endSection
