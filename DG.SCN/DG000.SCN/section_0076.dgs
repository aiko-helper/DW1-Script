// source: extract/DIGIMON/SCN/DG.SCN
// DG000.SCN, section 76

section section_76(76) {  // len=44
    setScript(73, Map.GIAS07);
    setPStat(245, 0);
    setBGM(11);
    if (trigger(196)) goto L_0020;
    loadDigimon(Digimon.NPCGobiromon);
    loadDigimon(Digimon.NPCPatamon);
    loadDigimon(Digimon.NPCLeomon);
    return;
L_0020:
    loadDigimon(Digimon.Sharmamon);
    setDigimon(Digimon.Sharmamon, 3, 1);
    setDigimon(Digimon.Sharmamon, 4, 1);
    return;
}
