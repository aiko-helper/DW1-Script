    loadDigimon(Digimon.ShimaUnimon);
    loadDigimon(Digimon.Sharmamon);
    setDigimon(Digimon.ShimaUnimon, 0, 1);
    setDigimon(Digimon.Sharmamon, 1, 1);
    setDigimon(Digimon.Sharmamon, 2, 1);
    goto L_0042;
L_0032:
