// source: extract/DIGIMON/SCN/DG.SCN
// DG000.SCN, section 3

section section_3(3) {  // len=116
    setScript(4, Map.MAYO04A);
    setPStat(245, 0);
    setBGM(1);
    if (trigger(242)) goto L_001e;
    loadDigimon(Digimon.NPCEtemon);
    setDigimon(Digimon.NPCEtemon, 0, 1);
L_001e:
    storeDate(105);
    if (pstat[107] < 7 || pstat[107] >= 19) goto L_003a;
    loadDigimon(Digimon.Aruraumon);
    setDigimon(Digimon.Aruraumon, 2, 1);
    goto L_0040;
L_003a:
    loadDigimon(Digimon.Goburimon);
    setDigimon(Digimon.Goburimon, 4, 1);
L_0040:
    if (pstat[107] < 7 || pstat[107] >= 19 || !trigger(242)) goto L_005a;
    loadDigimon(Digimon.Aruraumon);
    setDigimon(Digimon.Aruraumon, 1, 1);
L_005a:
    if ((pstat[107] >= 7 && pstat[107] < 19) || !trigger(242)) goto L_0072;
    setDigimon(Digimon.Goburimon, 3, 1);
L_0072:
    return;
}
