    loadDigimon(Digimon.Tentomon);
    loadDigimon(Digimon.Dokunemon);
    setDigimon(Digimon.Tentomon, 0, 1);
    setDigimon(Digimon.Tentomon, 1, 1);
    setDigimon(Digimon.Tentomon, 2, 1);
    setDigimon(Digimon.Dokunemon, 3, 1);
    goto L_004a;
L_0036:
    loadDigimon(Digimon.Tentomon);
    loadDigimon(Digimon.Dokunemon);
    setDigimon(Digimon.Dokunemon, 4, 1);
    setDigimon(Digimon.Dokunemon, 5, 1);
    setDigimon(Digimon.Tentomon, 6, 1);
    setDigimon(Digimon.Tentomon, 7, 1);
L_004a:
