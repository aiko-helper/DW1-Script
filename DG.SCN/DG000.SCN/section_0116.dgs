// source: extract/DIGIMON/SCN/DG.SCN
// DG000.SCN, section 116

section section_116(116) {  // len=88
    setScript(112, Map.MIST02);
    setPStat(245, 0);
    setBGM(20);
    if (trigger(114) || trigger(147)) goto L_002c;
    loadDigimon(Digimon.MoriShellmon);
    setDigimon(Digimon.MoriShellmon, 0, 1);
    setDigimon(Digimon.MoriShellmon, 1, 1);
    setDigimon(Digimon.MoriShellmon, 2, 1);
    return;
L_002c:
    storeDate(105);
    if (pstat[107] < 7 || pstat[107] >= 19) goto L_004c;
    loadDigimon(Digimon.Fugamon);
    setDigimon(Digimon.Fugamon, 3, 1);
    setDigimon(Digimon.Fugamon, 4, 1);
    goto L_0056;
L_004c:
    loadDigimon(Digimon.Darkrizamon);
    setDigimon(Digimon.Darkrizamon, 5, 1);
    setDigimon(Digimon.Darkrizamon, 6, 1);
L_0056:
    return;
}
