section section_161(161) {  // len=66
    setScript(155, Map.FACT09);
    setPStat(245, 0);
    setBGM(22);
    storeDate(105);
    if (pstat[107] < 7 || pstat[107] >= 19) goto L_0032;
    loadDigimon(Digimon.Guardromon);
    loadDigimon(Digimon.PlatinumSukamon);
    setDigimon(Digimon.Guardromon, 0, 1);
    setDigimon(Digimon.PlatinumSukamon, 1, 1);
    setDigimon(Digimon.Guardromon, 2, 1);
    goto L_0040;
L_0032:
    loadDigimon(Digimon.Geremon);
    setDigimon(Digimon.Geremon, 3, 1);
    setDigimon(Digimon.Geremon, 4, 1);
    setDigimon(Digimon.Geremon, 5, 1);
L_0040:
    return;
}
