// source: extract/DIGIMON/SCN/DG.SCN
// DG000.SCN, section 151

section section_151(151) {  // len=62
    setScript(145, Map.OMOC08);
    if (!trigger(350)) goto L_001c;
    setPStat(245, 6);
    setBGM(21);
    goto L_0022;
L_001c:
    setPStat(245, 5);
    setBGM(21);
L_0022:
    loadDigimon(Digimon.WaruMonzaemon);
    loadDigimon(Digimon.Hagurumon);
    if (!trigger(350) || trigger(337)) goto L_003c;
    loadDigimon(Digimon.NPCNanimon);
    setDigimon(Digimon.NPCNanimon, 1, 0);
L_003c:
    return;
}
