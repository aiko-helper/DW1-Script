section section_223(223) {  // len=44
    setScript(168, Map.ROOM19);
    setPStat(245, 0);
    setBGM(28);
    loadDigimon(Digimon.NPC2Greymon);
    setDigimon(Digimon.NPC2Greymon, 0, 0);
    if (!trigger(50)) goto L_002a;
    loadDigimon(Digimon.NPCAirdramon);
    loadDigimon(Digimon.NPC2MetalGreymon);
    setDigimon(Digimon.NPCAirdramon, 1, 0);
    setDigimon(Digimon.NPC2MetalGreymon, 2, 0);
L_002a:
    return;
}
