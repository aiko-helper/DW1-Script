section section_69(69) {  // len=58
    setScript(66, Map.GIAS00);
    setPStat(245, 0);
    setBGM(11);
    storeDate(105);
    if (pstat[107] < 7 || pstat[107] >= 19) goto L_002c;
    loadDigimon(Digimon.ShimaUnimon);
    setDigimon(Digimon.ShimaUnimon, 0, 1);
    setDigimon(Digimon.ShimaUnimon, 1, 1);
    goto L_0038;
L_002c:
    loadDigimon(Digimon.Tsukaimon);
    loadDigimon(Digimon.NiseDrimogemon);
    setDigimon(Digimon.Tsukaimon, 2, 1);
    setDigimon(Digimon.NiseDrimogemon, 3, 1);
L_0038:
    return;
}
