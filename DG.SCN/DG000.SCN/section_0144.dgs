// source: extract/DIGIMON/SCN/DG.SCN
// DG000.SCN, section 144

section section_144(144) {  // len=66
    setScript(138, Map.OMOC01);
    if (!trigger(350)) goto L_001c;
    setPStat(245, 6);
    setBGM(21);
    goto L_0022;
L_001c:
    setPStat(245, 5);
    setBGM(21);
L_0022:
    if (!trigger(350)) goto L_0040;
    loadDigimon(Digimon.ClearAgumon);
    loadDigimon(Digimon.ToyAgumon);
    loadDigimon(Digimon.Tankmon);
    setDigimon(Digimon.ClearAgumon, 0, 0);
    setDigimon(Digimon.ToyAgumon, 1, 0);
    setDigimon(Digimon.Tankmon, 2, 0);
L_0040:
    return;
}
