section section_108(108) {  // len=42
    setScript(104, Map.BETL04);
    setPStat(245, 0);
    setBGM(25);
    if (trigger(251)) goto L_001e;
    loadDigimon(Digimon.NPCKuwagamon);
    setDigimon(Digimon.NPCKuwagamon, 0, 0);
L_001e:
    loadDigimon(Digimon.NPCKuwagamon);
    setDigimon(Digimon.NPCKuwagamon, 1, 0);
    setDigimon(Digimon.NPCKuwagamon, 2, 0);
    return;
}
