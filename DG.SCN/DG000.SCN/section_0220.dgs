section section_220(220) {  // len=78
    setScript(180, Map.FACT11B);
    setPStat(245, 1);
    setBGM(23);
    if (!trigger(341) || trigger(211)) goto L_0024;
    loadDigimon(Digimon.NPCNumemon);
    setDigimon(Digimon.NPCNumemon, 1, 0);
    return;
L_0024:
    if (trigger(211)) goto L_0036;
    loadDigimon(Digimon.NPCNumemon);
    setDigimon(Digimon.NPCNumemon, 0, 0);
L_0036:
    if (!trigger(330) || trigger(336)) goto L_004c;
    loadDigimon(Digimon.NPCNanimon);
    setDigimon(Digimon.NPCNanimon, 2, 0);
L_004c:
    return;
}
