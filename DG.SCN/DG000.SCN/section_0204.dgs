    return;
L_0026:
    if (trigger(54)) goto L_0048;
    loadDigimon(Digimon.Jijimon);
    loadDigimon(Digimon.Tokomon);
    setDigimon(Digimon.Jijimon, 0, 0);
    setDigimon(Digimon.Tokomon, 1, 0);
    setDigimon(Digimon.Jijimon, 2, 0);
    setDigimon(Digimon.Jijimon, 3, 0);
    return;
L_0048:
