// source: extract/DIGIMON/SCN/DG.SCN
// DG000.SCN, section 150

section section_150(150) {  // len=50
    setScript(144, Map.OMOC07);
    if (!trigger(350)) goto L_001c;
    setPStat(245, 6);
    setBGM(21);
    goto L_0022;
L_001c:
    setPStat(245, 5);
    setBGM(21);
L_0022:
    loadDigimon(Digimon.ClearAgumon);
    setDigimon(Digimon.ClearAgumon, 0, 1);
    setDigimon(Digimon.ClearAgumon, 1, 1);
    setDigimon(Digimon.ClearAgumon, 2, 1);
    return;
}
