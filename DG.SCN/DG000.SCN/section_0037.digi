; source: ./extract/DIGIMON/SCN/DG.SCN
; DG000.SCN, section 37

section_37:     ; len=64
  0000:  setScript 37 37
  0006:  setPStat 245 0
  000a:  setBGM 6
  000c:  storeDate 105
  000e:  if pstat[107] < 7 OR pstat[107] >= 19 then section_37+0x30
  001e:  loadDigimon 80
  0020:  setDigimon 80 0 1
  0024:  setDigimon 80 1 1
  0028:  setDigimon 80 2 1
  002c:  jump section_37+0x3e
  0030:  loadDigimon 99
  0032:  setDigimon 99 3 1
  0036:  setDigimon 99 4 1
  003a:  setDigimon 99 5 1
  003e:  endSection
