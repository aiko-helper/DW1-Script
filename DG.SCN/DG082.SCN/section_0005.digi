; source: ./extract/DIGIMON/SCN/DG.SCN
; DG082.SCN, section 5

section_5(5):     ; len=2382
  0000:  setTrigger 44
  0004:  speak Player "This must be it!\nNo matter how I look at it,\nit looks a plain meteorite.\n"
  009c:  setSelection section_5+0xea section_5+0x82c
  00a2:  showTextbox "Crack it and check\nLeave it alone\n"
  00ea:  playAnimation Player 5
  00ee:  delay 20
  00f2:  speak Player "Hmmm\n"
  0102:  playAnimation Player 16
  0106:  delay 5
  010a:  showTextbox "Looks like a plain\nold meteorite to me.\n"
  015e:  speak System "<YELLOW>???mon <WHITE>\nSorry to look\nso plain and old.\n"
  01b8:  jump section_5+0x1bc
  01bc:  playAnimation 5 29
  01c0:  delay 10
  01c4:  speak Player "Wow!\n"
  01d4:  speak Player "You're a Digimon?!\nWho are you?\n"
  021a:  lookAt 5 Player
  021e:  lookAt Player 5
  0222:  delay 5
  0226:  speak System "<YELLOW>???mon <WHITE>\nMy name is Meteormon.\n"
  026c:  speak Player "Do you know about\nthe island's danger?\n"
  02c0:  speak 5 "I know nothing!\n"
  02e6:  speak Player "You know nothing?! You sure\nyou're not hiding something?\n"
  035e:  speak 5 "How rude! Alright!\nWhy don't we battle\nto prove who is right!\n"
  03e0:  speak Player "Alright! Let's go for it.\n"
  041a:  setTrigger 1
  041e:  pstat[250] = 1
  0422:  pstat[251] = 5
  0426:  pstat[252] = 255
  042a:  pstat[253] = 255
  042e:  fadeOutHUD
  0430:  delay 1
  0434:  startBattle
  0436:  unsetTrigger 1
  043a:  pstat[250] = 0
  043e:  lookAt Player 5
  0442:  lookAt 5 Player
  0446:  lookAt Partner 5
  044a:  speak 5 "I give up. You're so strong.\n"
  048a:  speak Player "Whatever you know, tell me\nabout the island's danger.\n"
  04fc:  playAnimation Player 19
  0500:  delay 5
  0504:  speak 5 "I was just born, so\nI don't know anything!\n"
  0560:  speak Player "What?!\n"
  0574:  playAnimation Player 0
  0578:  delay 5
  057c:  speak 5 "The Meteorite Tribe is\nborn in the sky and then\nfalls to the ground.\n"
  060c:  speak 5 "Then we sleep for a long time.\nActually, I was supposed to\nsleep much longer, but...\n"
  06bc:  speak Player "Time goes much faster here.\n"
  06fa:  speak 5 "Probably. Anyway, I'll go\ncheck out the island."
  075e:  .string "?o\nSee ya!\n"  ; dead string
  0776:  playAnimation 5 30
  077a:  delay 10
  077e:  jump section_5+0x782
  0782:  moveEntityTo 5 1 -1050 40
  078a:  if pstat[101] >= 3 then section_5+0x7ae
  0796:  pstat[101] += 1
  079a:  delay 20
  079e:  playSound 8 5
  07a2:  lookAt Player 5
  07a6:  lookAt Partner 5
  07aa:  jump section_5+0x782
  07ae:  waitForEntity 5
  07b0:  unloadEntity 5
  07b2:  pstat[101] = 0
  07b6:  speak Player "We couldn't find any clues.\nLet's get out fast.\n"
  081c:  unsetTrigger 1
  0820:  setTrigger 313
  0824:  moveCameraToEntity Player 15
  0828:  waitForEntity 200
  082a:  endSection
  082c:  speak Player "We looked at it, and\nwe can't tell anything.\nLet's crack it!\n"
  08ac:  entityWalkToEntity Partner 0 5
  08b0:  waitForEntity Partner
  08b2:  playAnimation Partner 46
  08b6:  delay 20
  08ba:  speak System "<YELLOW>???mon <WHITE>\nWhadda ya think you're doing?\nYou reckless clod!\n"
  0936:  playAnimation 5 29
  093a:  delay 20
  093e:  lookAt 5 Player
  0942:  lookAt Player 5
  0946:  delay 5
  094a:  jump section_5+0x1bc
