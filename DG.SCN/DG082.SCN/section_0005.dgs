// source: extract/DIGIMON/SCN/DG.SCN
// DG082.SCN, section 5

section section_5(5) {  // len=2382
    setTrigger(44);
    setDialogOwner(Entity.Player);
    showTextbox("This must be it!\nNo matter how I look at it,\nit looks a plain meteorite.\n");
    setSelection(L_00ea, L_082c);
    showTextbox("Crack it and check\nLeave it alone\n");
L_00ea:
    playAnimation(Entity.Player, 5);
    delay(20);
    setDialogOwner(Entity.Player);
    showTextbox("Hmmm\n");
    playAnimation(Entity.Player, 16);
    delay(5);
    showTextbox("Looks like a plain\nold meteorite to me.\n");
    setDialogOwner(Entity.System);
    showTextbox("<YELLOW>???mon <WHITE>\nSorry to look\nso plain and old.\n");
    goto L_01bc;
L_01bc:
    playAnimation(5, 29);
    delay(10);
    setDialogOwner(Entity.Player);
    showTextbox("Wow!\n");
    setDialogOwner(Entity.Player);
    showTextbox("You're a Digimon?!\nWho are you?\n");
    look(entity: 5, at: Entity.Player);
    look(entity: Entity.Player, at: 5);
    delay(5);
    setDialogOwner(Entity.System);
    showTextbox("<YELLOW>???mon <WHITE>\nMy name is Meteormon.\n");
    setDialogOwner(Entity.Player);
    showTextbox("Do you know about\nthe island's danger?\n");
    setDialogOwner(5);
    showTextbox("I know nothing!\n");
    setDialogOwner(Entity.Player);
    showTextbox("You know nothing?! You sure\nyou're not hiding something?\n");
    setDialogOwner(5);
    showTextbox("How rude! Alright!\nWhy don't we battle\nto prove who is right!\n");
    setDialogOwner(Entity.Player);
    showTextbox("Alright! Let's go for it.\n");
    setTrigger(1);
    setPStat(250, 1);
    setPStat(251, 5);
    setPStat(252, 255);
    setPStat(253, 255);
    fadeOutHUD();
    delay(1);
    startBattle();
    unsetTrigger(1);
    setPStat(250, 0);
    look(entity: Entity.Player, at: 5);
    look(entity: 5, at: Entity.Player);
    look(entity: Entity.Partner, at: 5);
    setDialogOwner(5);
    showTextbox("I give up. You're so strong.\n");
    setDialogOwner(Entity.Player);
    showTextbox("Whatever you know, tell me\nabout the island's danger.\n");
    playAnimation(Entity.Player, 19);
    delay(5);
    setDialogOwner(5);
    showTextbox("I was just born, so\nI don't know anything!\n");
    setDialogOwner(Entity.Player);
    showTextbox("What?!\n");
    playAnimation(Entity.Player, 0);
    delay(5);
    setDialogOwner(5);
    showTextbox("The Meteorite Tribe is\nborn in the sky and then\nfalls to the ground.\n");
    setDialogOwner(5);
    showTextbox("Then we sleep for a long time.\nActually, I was supposed to\nsleep much longer, but...\n");
    setDialogOwner(Entity.Player);
    showTextbox("Time goes much faster here.\n");
    setDialogOwner(5);
    showTextbox("Probably. Anyway, I'll go\ncheck out the island.");
    dead_string("?o\nSee ya!\n");
    playAnimation(5, 30);
    delay(10);
    goto L_0782;
L_0782:
    move(entity: 5, to: (1, -1050), animDuration: 40);
    if (pstat[101] >= 3) goto L_07ae;
    addPStat(101, 1);
    delay(20);
    playSound(8, 5);
    look(entity: Entity.Player, at: 5);
    look(entity: Entity.Partner, at: 5);
    goto L_0782;
L_07ae:
    waitForEntity(5);
    unloadEntity(5);
    setPStat(101, 0);
    setDialogOwner(Entity.Player);
    showTextbox("We couldn't find any clues.\nLet's get out fast.\n");
    unsetTrigger(1);
    setTrigger(313);
    moveCamera(to: Entity.Player, speed: 15);
    waitForEntity(200);
    return;
L_082c:
    setDialogOwner(Entity.Player);
    showTextbox("We looked at it, and\nwe can't tell anything.\nLet's crack it!\n");
    move(entity: Entity.Partner, to: 5, sprint: 0);
    waitForEntity(Entity.Partner);
    playAnimation(Entity.Partner, 46);
    delay(20);
    setDialogOwner(Entity.System);
    showTextbox("<YELLOW>???mon <WHITE>\nWhadda ya think you're doing?\nYou reckless clod!\n");
    playAnimation(5, 29);
    delay(20);
    look(entity: 5, at: Entity.Player);
    look(entity: Entity.Player, at: 5);
    delay(5);
    goto L_01bc;
}
