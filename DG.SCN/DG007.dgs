    playAnimation(Entity.Player, 0);
    setDialogOwner(5);
    showTextbox("Uh, yes. I'm Seadramon.\n");
    showTextbox("So you are the one who's\nbeen fishing so much!\nSo be it. Any requests?\n");
    setDialogOwner(Entity.Player);
    showTextbox("What!? I see why they\ncall you Guardian.\nYes, I have a request.\n");
    setTrigger(49);
