    showTextbox("You mean I can go to\nthe other side? Thanks!\n");
    setDialogOwner(5);
    showTextbox("Beyond the lake, there is\na strange forest. Do you\nwant go there right now?\n");
    setTrigger(49);
    setDialogOwner(Entity.Player);
    setSelection(L15, L16);
    showTextbox("Yeah, I'll go\nNo, maybe later\n");

