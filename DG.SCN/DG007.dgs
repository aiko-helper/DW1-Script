// DG007.SCN
#include "functions.dgs"
#pragma script index=7 start=0xa800 end=0xb800 headerU16=0x10 sentinelOff=0x24
#include "entities.dgs"

section onEnter(254) {
  spawnItemChance(max: 99, chance: 4, item: Item.Digimushroom, x: 57, y: 83);
  return;
}

section(81) {
  if (item[Item.BlueFlute] >= 1) {
    speak(Entity.Player, "Oh, yes!\n");
    speak(Entity.System, "Will you play the Lake\nGuardian's <LIGHTBLUE>Blue Flute<WHITE>?\n");
    setDialogOwner(Entity.Player);
    choice { "I'll play" -> L2, "I won't play" -> L1 }
    return;
  }
  return;

L1:
  return;

L2:
  sfx(8, 13, wait: 60);
  moveCamera(to: Entity.Player, speed: 10);
  waitForEntity(200);
  move(entity: Entity.Player, to: (445, -1448), sprint: 1, withCamera: true);
  move(entity: Entity.Partner, to: (743, -2280), sprint: 1);
  waitForPair();
  rotate(entity: Entity.Player, to: 1536);
  rotate(entity: Entity.Partner, to: 1536);
  moveCamera(to: (242, -1810), slowdown: 10);
  waitForEntity(200);
  loadAndSetDigimon(Digimon.NPCSeadramon, 0, 0);
  playAnimation(5, 28);
  setObjectsVisibleRange(38, 44, 0);
  setPStat(247, 40);
  setPStat(248, 5);
  callSubroutine(21);
  playAnimation(Entity.Player, 15);
  waitForEntity(5);
  sfx(8, 12, wait: 60);
  setObjectsVisibleRange(40, 44, 1);
  setObjectVisibility(45, 0);
  playAnimation(5, 32);
  playSound(8, 7);
  speak(5, "Do you need help my friend?\n");
  anim(Entity.Player, 19, wait: 15);
  speak(Entity.Player, "Take me to the other side.\n");
  playAnimation(Entity.Player, 0);
  speak(5, "Sure. Get on.\n");
  playAnimation(5, 29);
  setObjectVisibility(45, 1);
  setObjectVisibility(46, 0);
  setObjectVisibility(47, 0);
  setPStat(247, 46);
  setPStat(248, 2);
  callSubroutine(21);
  delay(20);
  setObjectVisibility(46, 1);
  setObjectVisibility(47, 1);
  anim(5, 30, wait: 10);
  moveCamera(to: (-310, -1980), slowdown: 15);
  waitForEntity(200);
  move(entity: Entity.Player, axis: 1, to: -200, speed: 2);
  delay(5);
  playAnimation(Entity.Player, 21);
  move(entity: Entity.Player, to: (-194, -1810), animDuration: 50);
  move(entity: Entity.Partner, to: (50, -2538), sprint: 1);
  waitForEntity(Entity.Partner);
  move(entity: 5, to: (-791, 74), animDuration: 30);
  move(entity: Entity.Player, to: (-791, 74), animDuration: 30);
  move(entity: Entity.Partner, to: (-791, 74), animDuration: 30);
  delay(20);
  warp(to: Map.BETL01, spawn: 0, trigger: 255);
  return;
  return;
}

section(82) {
  move(entity: Entity.Player, to: (445, -1448), sprint: 1, withCamera: true);
  move(entity: Entity.Partner, to: (743, -2280), sprint: 1);
  waitForPair();
  rotate(entity: Entity.Player, to: 1536);
  rotate(entity: Entity.Partner, to: 1536);
  moveCamera(to: (242, -1810), slowdown: 10);
  waitForEntity(200);
  if (trigger(339)) {
    setTrigger(339);
    setObjectVisibility(38, 0);
    setObjectVisibility(39, 0);
    loadAndSetDigimon(Digimon.NPCSeadramon, 0, 0);
    playAnimation(5, 28);
    setObjectsVisibleRange(40, 44, 0);
    setPStat(247, 40);
    setPStat(248, 5);
    callSubroutine(21);
    playAnimation(Entity.Player, 15);
    waitForEntity(5);
    sfx(8, 12, wait: 60);
    setObjectsVisibleRange(40, 44, 1);
    setObjectVisibility(45, 0);
    playAnimation(5, 32);
    playSound(8, 7);
    speak(Entity.Player, "Seadramon!\n");
    speak(5, "So we meet again.\nDo you have a request?\n");
  } else {
    goto L2;
  }
  loop {
    setTrigger(49);
    setDialogOwner(Entity.Player);
    setSelection(L1, L4, L8);
    showTextbox("Let's be friends\nTeach me a Technique\nI want an Item\n");

L1:
    unsetTrigger(49);
    if (trigger(210)) {
      speak(5, "We're already friends.\nAny other requests?\n");
      continue;
      return;
    }
    goto L3;

L2:
    setTrigger(339);
    loadAndSetDigimon(Digimon.NPCSeadramon, 0, 0);
    playAnimation(5, 28);
    setObjectsVisibleRange(38, 44, 0);
    setPStat(247, 40);
    setPStat(248, 5);
    callSubroutine(21);
    playAnimation(Entity.Player, 15);
    waitForEntity(5);
    sfx(8, 12, wait: 60);
    setObjectsVisibleRange(40, 44, 1);
    setObjectVisibility(45, 0);
    playAnimation(5, 32);
    playSound(8, 7);
    speak(Entity.Player, "What the... oh no!\nIt's the Lake Guardian!\n");
    playAnimation(Entity.Player, 0);
    speak(5, "Uh, yes. I'm Seadramon.\n");
    showTextbox("So you are the one who's\nbeen fishing so much!\nSo be it. Any requests?\n");
    speak(Entity.Player, "What!? I see why they\ncall you Guardian.\nYes, I have a request.\n");
    setTrigger(49);
    setSelection(L3, L4, L8);
    showTextbox("Let's be friends\nTeach me a Technique\nI want an Item\n");

L3:
    unsetTrigger(49);
    speak(5, "Okay, fine.\n");
    showTextbox("We're friends from now on. I\ngive you this flute as proof.\n");
    setTrigger(210);
    addPStat(1, 2);
    giveItem(Item.BlueFlute, 1);
    if (trigger(0)) {
      unsetTrigger(3);
      speak(Entity.Player, "Oh no! Too many Items.\nI need to throw some away.\n");
      callSubroutine(0);
      callSubroutine(13);
      giveItem(Item.BlueFlute, 1);
    }
    speak(Entity.System, "I got the Lake Guardian's\n<LIGHTBLUE>Blue Flute<WHITE>!\n");
    speak(5, "If you play the flute near\nthe lake, I'll come. I'll\ntake you to the other side.\n");
    speak(Entity.Player, "You mean I can go to\nthe other side? Thanks!\n");
    speak(5, "Beyond the lake, there is\na strange forest. Do you\nwant go there right now?\n");
    setTrigger(49);
    setDialogOwner(Entity.Player);
    setSelection(L9, L10);
    showTextbox("Yeah, I'll go\nNo, maybe later\n");

L4:
    unsetTrigger(49);
    speak(5, "I'll teach you a Technique.\n");
    if (hasTech(Move.AquaMagic) == 1) goto L5;
    learnMove(Move.AquaMagic);
    speak(Entity.System, "I mastered 'Aqua Magic'!\n");
    break;

L5:
    if (hasTech(Move.WinterBlast) == 1) goto L6;
    learnMove(Move.WinterBlast);
    speak(Entity.System, "I mastered 'Winter Blast'!\n");
    break;

L6:
    if (hasTech(Move.GigaFreeze) == 1) goto L7;
    learnMove(Move.GigaFreeze);
    speak(Entity.System, "I mastered 'Giga Freeze'!\n");
    break;

L7:
    speak(5, "Uh, I don't think there are\nany more Techniques\nI can teach you...\n");
  }
  speak(5, "See ya!\n");
  playAnimation(5, 29);
  setObjectVisibility(45, 1);
  setObjectVisibility(46, 0);
  setObjectVisibility(47, 0);
  delay(20);
  playAnimation(5, 30);
  setObjectVisibility(46, 1);
  setObjectVisibility(47, 1);
  delay(5);
  move(entity: 5, to: (-791, 74), animDuration: 30);
  waitForEntity(5);
  unloadEntity(5);
  return;

L8:
  unsetTrigger(49);
  speak(5, "Well, I'll give you the\n<LIGHTBLUE>Water Bottle<WHITE>.\n");
  giveItem(Item.Waterbottle, 1);
  if (trigger(0)) {
    unsetTrigger(3);
    speak(Entity.Player, "Oh no! Too many Items.\nI need to throw some away.\n");
    callSubroutine(0);
    callSubroutine(13);
    giveItem(Item.Waterbottle, 1);
  }
  speak(Entity.System, "Yeah, I got the\n<LIGHTBLUE>Water Bottle<WHITE>!\n");
  speak(5, "See ya!\n");
  playAnimation(5, 29);
  setObjectVisibility(45, 1);
  setObjectVisibility(46, 0);
  setObjectVisibility(47, 0);
  delay(20);
  playAnimation(5, 30);
  setObjectVisibility(46, 1);
  setObjectVisibility(47, 1);
  delay(5);
  move(entity: 5, to: (-791, 74), animDuration: 30);
  waitForEntity(5);
  unloadEntity(5);
  return;

L9:
  unsetTrigger(49);
  speak(5, "Well then, hop on my back.\n");
  playAnimation(5, 29);
  setObjectVisibility(45, 1);
  setObjectVisibility(46, 0);
  setObjectVisibility(47, 0);
  setPStat(247, 46);
  setPStat(248, 2);
  callSubroutine(21);
  delay(20);
  setObjectVisibility(46, 1);
  setObjectVisibility(47, 1);
  anim(5, 30, wait: 10);
  moveCamera(to: (-310, -1980), slowdown: 15);
  waitForEntity(200);
  move(entity: Entity.Player, axis: 1, to: -200, speed: 2);
  delay(5);
  playAnimation(Entity.Player, 21);
  move(entity: Entity.Player, to: (-194, -1810), animDuration: 50);
  move(entity: Entity.Partner, to: (50, -2538), sprint: 1);
  waitForEntity(Entity.Partner);
  move(entity: 5, to: (-791, 74), animDuration: 30);
  move(entity: Entity.Player, to: (-791, 74), animDuration: 30);
  move(entity: Entity.Partner, to: (-791, 74), animDuration: 30);
  delay(20);
  warp(to: Map.BETL01, spawn: 0, trigger: 255);
  return;

L10:
  unsetTrigger(49);
  speak(5, "Bye for now.\n");
  playAnimation(5, 29);
  setObjectVisibility(45, 1);
  setObjectVisibility(46, 0);
  setObjectVisibility(47, 0);
  delay(20);
  playAnimation(5, 30);
  setObjectVisibility(46, 1);
  setObjectVisibility(47, 1);
  delay(5);
  move(entity: 5, to: (-791, 74), animDuration: 30);
  waitForEntity(5);
  unloadEntity(5);
  return;
  garbage { 10 00 fe 00 10 00 51 00 28 00 52 00 a8 02 ff ff 24 00 6e 63 19 00 0b 00 6e 04 18 00 26 00 19 00 74 2c 39 00 53 00 fe 00 19 00 24 00 73 02 01 00 18 00 f2 00 19 00 1b fd 1a 00 82 6e 82 88 81 43 81 40 82 99 82 85 82 93 81 49 0d 00 00 00 1b ff 1a 00 82 76 82 89 82 8c 82 8c 81 40 82 99 82 8f 82 95 81 40 82 90 82 8c 82 81 82 99 81 40 82 94 82 88 82 85 81 40 82 6b 82 81 82 8b 82 85 0d 00 82 66 82 95 82 81 82 92 82 84 82 89 82 81 82 8e 81 75 82 93 81 40 01 06 82 61 82 8c 82 95 82 85 81 40 82 65 82 8c 82 95 82 94 82 85 01 01 81 48 0d 00 00 00 1b fd 10 02 f6 00 f4 00 1a 00 82 68 81 75 82 8c 82 8c 81 40 82 90 82 8c 82 81 82 99 0d 00 82 68 81 40 82 97 82 8f 82 8e 81 75 82 94 }
}
