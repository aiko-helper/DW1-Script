    setDialogOwner(5);
    showTextbox("Okay, fine.\n");
    showTextbox("We're friends from now on. I\ngive you this flute as proof.\n");
    setTrigger(210);
    addPStat(1, 2);
    giveItem(Item.BlueFlute, 1);
    if (!trigger(0)) goto L7;
    unsetTrigger(3);
    setDialogOwner(Entity.Player);
    showTextbox("Oh no! Too many Items.\nI need to throw some away.\n");
    callSubroutine(0);
    callSubroutine(13);
    giveItem(Item.BlueFlute, 1);

L7:
    setDialogOwner(Entity.System);
    showTextbox("I got the Lake Guardian's\n<LIGHTBLUE>Blue Flute<WHITE>!\n");
