; DG011.SCN
;!script index=11 start=0xe000 end=0xe800 headerU16=0x24 sentinelOff=0x19
;!sections onEnter section_5 section_7 section_8 section_9 section_10 section_6 section_52

onEnter:     ; len=110
  0000:  if !trigger(232) then onEnter+0x1c
  000c:  setObjectVisibility 68 1
  0010:  setObjectVisibility 69 1
  0014:  setObjectVisibility 70 1
  0018:  jump onEnter+0x24
  001c:  setRectImpassible 22 16 3 12
  0024:  if !trigger(232) OR pstat[1] < 35 then onEnter+0x40
  0034:  setObjectVisibility 71 0
  0038:  setObjectVisibility 72 0
  003c:  setObjectVisibility 73 0
  0040:  storeRandom 110 99
  0044:  if pstat[110] > 39 then onEnter+0x56
  0050:  spawnItem 44 37 48
  0056:  storeRandom 110 99
  005a:  if pstat[110] > 3 then onEnter+0x6c
  0066:  spawnItem 48 38 52
  006c:  endSection
