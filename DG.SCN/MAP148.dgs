section(9) {
  if (pstat[1] >= 20 && trigger(185)) {
    speak(Entity(9), "「ねえ、ちょっとボクの話聞いて。」<NEWLINE>");
    setDialogOwner(Entity.Player);
    setSelection(L1, L2);
    showTextbox("「何かな?」<NEWLINE>「また後ね。」<NEWLINE>");
  }
  if (trigger(185)) {
    speak(Entity(9), "「東の橋、見た?直ってたでしょ!<NEWLINE> ボクたち、がんばったんだ。」<NEWLINE>");
    return;
  }
  if (pstat[1] >= 2 && !trigger(185)) {
    speak(Entity(9), "「デジブリッジは、ボクらで直し中だよ。<NEWLINE> もうすこし待ってね。」<NEWLINE>");
    showTextbox("「あ、そういえば南のシーラ岬に、<NEWLINE> 珍しいデジモンがいるらしいよ。」<NEWLINE>");
    showTextbox("「そいつは毎日、ゆうがたごろに<NEWLINE> ちらっとかおを見せるってうわさだよ。」<NEWLINE>");
    return;
  }
  speak(Entity(9), "「あのね、街の東にさぁ、<NEWLINE> こわれた橋があるの知ってる?」<NEWLINE>");
  showTextbox("「誰も使わないだろうってことでさ、<NEWLINE> ほったらかしておいたんだ。でも<NEWLINE> もう、そういうわけにはいかないよね。」<NEWLINE>");
  showTextbox("「で、ボクたちでがんばって直してみようと<NEWLINE> 思うんだ。」<NEWLINE>");
  showTextbox("「それまでは西のほう、南のほうを見て<NEWLINE> 来るといいよ。ひとまわりしたら、<NEWLINE> また会いに来てよ。」<NEWLINE>");
  return;

L1:
  if (pstat[1] >= 25) {
    speak(Entity(9), "「ゲッコー湿地ってとこ行った?<NEWLINE> あそこでは、たまにいたずらなデジモンが<NEWLINE> ちょっかいかけてくるってさ。」<NEWLINE>");
    return;
  }
  speak(Entity(9), "「進化するとさぁ、<NEWLINE> 技セットやりなおしになっちゃうから<NEWLINE> 忘れちゃダメだよ。」<NEWLINE>");
  return;

L2:
  speak(Entity(9), "「ちぇっ。」<NEWLINE>");
  return;
}

section(10) {
  if (!trigger(80)) {
    setTrigger(Trigger(80));
    speak(Entity(10), "「どう?電気つけてみたんだけど、<NEWLINE> 明るいかな?」<NEWLINE>");
    speak(Entity(10), "「みんな明るい街づくりをしよう!」<NEWLINE>");
    return;
  }
  speak(Entity(10), "「電気つくと何かかわるのかって?」<NEWLINE>");
  speak(Entity(10), "「それは気持ちの問題だね。」<NEWLINE>");
  return;
}

section(11) {
  speak(Entity(11), "「我は最強…」<NEWLINE>");
  showTextbox("「貴様に負けたつもりはない。<NEWLINE> 闘技場に来ればそれがわかるだろう…」<NEWLINE>");
  return;
}

section(12) {
  speak(Entity(12), "「おう、<LIGHTBLUE><PLAYER><WHITE>。<NEWLINE> 俺ぁ街に怪しいやつがいねえか<NEWLINE> 見回りしてるところよ。」<NEWLINE>");
  showTextbox("「な、なんだよ。<NEWLINE> 別にジャマしてるわけじゃねえって!」<NEWLINE>");
  return;
}

