section(5) {
  setTrigger(Trigger(77));
  speak(Entity(5), "「バケ。バーケー。」<NEWLINE>");
  speak(Entity.Player, "「相変わらず…<NEWLINE> 何言ってるのかわかんないな。」<NEWLINE>");
  storeDigimonType(PStat(103));
  if (pstat[103] == 37) {
    look(entity: Entity.Player, at: Entity.Partner);
    delay(5);
    anim(Entity.Partner, Animation(11), wait: 10);
    look(entity: Entity.Player, at: Entity.Partner);
    delay(5);
    speak(Entity.Player, "「え?ふむふむ。<NEWLINE> そうか、見回りしてくれてるのか。」<NEWLINE>");
  }
  return;
}

section(6) {
  if (!trigger(78)) {
    setTrigger(Trigger(78));
    speak(Entity(6), "「ふふふ…見てくれ、ボク特製の掲示板。」<NEWLINE>");
    speak(Entity(6), "「街の発展に情報はつきものだろ?そこで<NEWLINE> ボクは新聞を書くことにしたのさ!<NEWLINE> どうだい、あったまいいだろう!」<NEWLINE>");
    speak(Entity(6), "「まあ、ボクの情報力に期待しててくれ。」<NEWLINE>");
    return;
  }
  speak(Entity(6), "「やあ、ボクの新聞読んでる?」<NEWLINE>");
  return;
}

section(7) {
  if (trigger(231) || trigger(245) || trigger(233) || trigger(247)) {
    speak(Entity(7), "「はー。冷たくて気持ちいいや。」<NEWLINE>");
    showTextbox("「気持ちいいところにいると、<NEWLINE> ごきげんもアップだよね。」<NEWLINE>");
    return;
  }
  if (trigger(204) && !trigger(52) && !trigger(249)) {
    setTrigger(Trigger(52));
    speak(Entity(7), "「てへへへ、どう?ボクのお店。」<NEWLINE>");
    showTextbox("「ほんとは商売って得意じゃないけど、<NEWLINE> 今はボクがやるしかないでしょ!」<NEWLINE>");
    showTextbox("「はやく、デジモンいっぱいつれて<NEWLINE> 来てよね!」<NEWLINE>");
    return;
  }
