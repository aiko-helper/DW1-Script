  if (pstat[1] <= 30) {
    speak(Entity(8), "「そういえばこの前、ぐうぜん<NEWLINE> <LIGHTBLUE>運試しキノコ<WHITE>というのをひろったな。<NEWLINE> めずらしいものらしい。」<NEWLINE>");
    speak(Entity(8), "「ほかにも<LIGHTBLUE>デラックスキノコ<WHITE>なんてのも<NEWLINE> あるらしいね。もしみつけたら<NEWLINE> じまんできそうだよ。」<NEWLINE>");
