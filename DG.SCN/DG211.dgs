    goto L122;
  }
  goto L123;

L122:
  jumpAndLink(L2);

L123:
  if (pstat[41] < 41) {
    addPStat(41, 1);
    goto L124;
  }
  goto L126;

L124:
  if (!trigger(50)) {
    speak(6, "There are still some unknown\nDigimon, but finish your\npriority work first!\n");
    addPStat(40, 1);
    goto L125;
  }
  goto L126;

L125:
  jumpAndLink(L2);

L126:
  if (pstat[41] < 42) {
    addPStat(41, 1);
    goto L127;
  }
  goto L128;

L127:
  if (!trigger(256) && trigger(50)) {
    speak(6, "The last Digimon will be\nborn at the last place you go\nto. Do you understand this?\n");
    addPStat(40, 1);
  }
  goto L128;

L128:
  setPStat(41, 0);
  setPStat(40, 0);
  return;
