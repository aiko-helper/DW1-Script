  }
  goto L108;

L107:
  jumpAndLink(L2);

L108:
  if (pstat[41] < 36) {
    addPStat(41, 1);
    goto L109;
  }
  goto L111;

L109:
  if (!trigger(227)) {
    speak(6, "In an Iron City to the west a\nrare Digimon may appear and\nchallenge others to fight.\n");
    addPStat(40, 1);
    goto L110;
  }
  goto L111;

L110:
  jumpAndLink(L2);

L111:
  if (pstat[41] < 37) {
    addPStat(41, 1);
    goto L112;
  }
  goto L114;

L112:
  if (!trigger(228)) {
    speak(6, "There is an Alien Digimon.\nYou may meet him someday.\n");
    addPStat(40, 1);
    goto L113;
  }
  goto L114;

L113:
  jumpAndLink(L2);

L114:
  if (pstat[41] < 38) {
    addPStat(41, 1);
    goto L115;
  }
  goto L117;

L115:
  if (pstat[21] == 0) {
    speak(6, "There is a Mythical Animal\nDigimon. He is in a house\nthat has lost its owners.\n");
    addPStat(40, 1);
    goto L116;
  }
  goto L117;

L116:
  jumpAndLink(L2);

L117:
  if (pstat[41] < 39) {
    addPStat(41, 1);
    goto L118;
  }
  goto L120;

L118:
  if (pstat[21] == 1) {
    speak(6, "You must keep looking for\nNanimon until you get the\nreal treasure.\n");
    addPStat(40, 1);
    goto L119;
  }
  goto L120;

L119:
  jumpAndLink(L2);

L120:
  if (pstat[41] < 40) {
    addPStat(41, 1);
    goto L121;
  }
  goto L123;

L121:
  if (!trigger(129)) {
    speak(6, "Myotismon is missing.\nFollow the clues that\nare in his mansion.\n");
