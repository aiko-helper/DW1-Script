// DG211.SCN
#include "functions.dgs"
#pragma script index=211 start=0xb0000 end=0xb2800 headerU16=0xc sentinelOff=0xfe
#include "entities.dgs"

section onEnter(254) {
  return;
}

section(8) {
  if (!trigger(81)) {
    setTrigger(81);
    speak(6, "Welcome back, <LIGHTBLUE><PLAYER><WHITE>.\n");
    speak(6, "I'm Jijimon's recordkeeper.\n");
    speak(6, "I record Jijimon's info\nand give it to you.\n");
    speak(6, "If you don't know what to do\nask me, and I'll tell you\nwhere to go.\n");
    return;
  }
  if (pstat[1] == 100) {
    speak(6, "All the Digimon have\ngathered in the city.\nThank you so much!\n");
    return;
  }
  speak(6, "Let me tell you what I know.\nLet's see...\n");
  goto L3;
  loop {
    speak(6, "And then...\n");
    goto L3;

L1:
    speak(6, "And also...\n");
    goto L3;

L2:
    if (pstat[40] != 1) break;
  }
  if (pstat[40] == 2) {
    goto L1;
  }
  if (pstat[40] == 3) {
    goto L128;
  }
  jumpReturn();

L3:
  if (pstat[41] < 1) {
    addPStat(41, 1);
    goto L4;
  }
  goto L6;

L4:
  if (!trigger(246)) {
    speak(6, "Vegetation Digimon are in the\nforest. The closer they are\nthe harder they are to see.\n");
    addPStat(40, 1);
    goto L5;
  }
  goto L6;

L5:
  jumpAndLink(L2);

L6:
  if (pstat[41] < 2) {
    addPStat(41, 1);
    goto L7;
  }
  goto L9;

L7:
  if (!trigger(232)) {
    speak(6, "Insectoid Digimons like\ngreenery. Like the kind\naround the city...\n");
    addPStat(40, 1);
    goto L8;
  }
  goto L9;

L8:
  jumpAndLink(L2);

L9:
  if (pstat[41] < 3) {
    addPStat(41, 1);
    goto L10;
  }
  goto L12;

L10:
  if (!trigger(236)) {
    speak(6, "In Tropical Jungle there is\na maze-like forest.\nA strong Digimon guards it.\n");
    addPStat(40, 1);
    goto L11;
  }
  goto L12;

L11:
  jumpAndLink(L2);

L12:
  if (pstat[41] < 4) {
    addPStat(41, 1);
    goto L13;
  }
  goto L15;

L13:
  if (!trigger(249)) {
    speak(6, "An old-timer in the river\nis waiting for someone.\n");
    addPStat(40, 1);
    goto L14;
  }
  goto L15;

L14:
  jumpAndLink(L2);

L15:
  if (pstat[41] < 5) {
    addPStat(41, 1);
    goto L16;
  }
  goto L18;

L16:
  if (!trigger(204)) {
    speak(6, "There is a Digimon who\nloves warm water shores.\n");
    addPStat(40, 1);
    goto L17;
  }
  goto L18;

L17:
  jumpAndLink(L2);

L18:
  if (pstat[41] < 6) {
    addPStat(41, 1);
    goto L19;
  }
  goto L21;

L19:
  if (!trigger(237)) {
    speak(6, "Graveyards have ghosts.\nGhosts love talking to you.\n");
    addPStat(40, 1);
    goto L20;
  }
  goto L21;

L20:
  jumpAndLink(L2);

L21:
  if (pstat[41] < 7) {
    addPStat(41, 1);
    goto L22;
  }
  goto L24;

L22:
  if (!trigger(225)) {
    speak(6, "A secret lies in the flower\nbed of the city. Ask a plant\nabout another plant.\n");
    addPStat(40, 1);
    goto L23;
  }
  goto L24;

L23:
  jumpAndLink(L2);

L24:
  if (pstat[41] < 8) {
    addPStat(41, 1);
    goto L25;
  }
  goto L27;

L25:
  if (!trigger(208)) {
    speak(6, "The Ancient Dino Region\nis dangerous, but it's\nbest to check it out.\n");
    addPStat(40, 1);
    goto L26;
  }
  goto L27;

L26:
  jumpAndLink(L2);

L27:
  if (pstat[41] < 9) {
    addPStat(41, 1);
    goto L28;
  }
  goto L30;

L28:
  if (!trigger(209)) {
    speak(6, "Lava flows inside of\nMt. Panorama. Some Digimon\nlove the heat.\n");
    addPStat(40, 1);
    goto L29;
  }
  goto L30;

L29:
  jumpAndLink(L2);

L30:
  if (pstat[41] < 10) {
    addPStat(41, 1);
    goto L31;
  }
  goto L33;

L31:
  if (!trigger(223)) {
    speak(6, "Taking a Digimon, who loves\nhot places, to a cold place\nis against the rules, but...\n");
    addPStat(40, 1);
    goto L32;
  }
  goto L33;

L32:
  jumpAndLink(L2);

L33:
  if (pstat[41] < 11) {
    addPStat(41, 1);
    goto L34;
  }
  goto L36;

L34:
  if (!trigger(222)) {
    speak(6, "In Freezeland there are many\nDigimon who'll come with you.\nGo to the west.\n");
    addPStat(40, 1);
    goto L35;
  }
  goto L36;

L35:
  jumpAndLink(L2);

L36:
  if (pstat[41] < 12) {
    addPStat(41, 1);
    goto L37;
  }
  goto L39;

L37:
  if (!trigger(221)) {
    speak(6, "On the peak of Great Canyon,\na Bird Digimon lives.\n");
    addPStat(40, 1);
    goto L38;
  }
  goto L39;

L38:
  jumpAndLink(L2);

L39:
  if (pstat[41] < 13) {
    addPStat(41, 1);
    goto L40;
  }
  goto L42;

L40:
  if (!trigger(235)) {
    speak(6, "Great Canyon is like a\nmaze. Once entered,\nit's hard to leave.\n");
    addPStat(40, 1);
    goto L41;
  }
  goto L42;

L41:
  jumpAndLink(L2);

L42:
  if (pstat[41] < 14) {
    addPStat(41, 1);
    goto L43;
  }
  goto L45;

L43:
  if (!trigger(218)) {
    speak(6, "In Gear Savanna,\nthere is a Digimon\nwho loves electricity.\n");
    addPStat(40, 1);
    goto L44;
  }
  goto L45;

L44:
  jumpAndLink(L2);

L45:
  if (pstat[41] < 15) {
    addPStat(41, 1);
    goto L46;
  }
  goto L48;

L46:
  if (!trigger(250)) {
    speak(6, "In Misty Trees, an early\nrising Digimon may appear.\n");
    addPStat(40, 1);
    goto L47;
  }
  goto L48;

L47:
  jumpAndLink(L2);

L48:
  if (pstat[41] < 16) {
    addPStat(41, 1);
    goto L49;
  }
  goto L51;

L49:
  if (!trigger(247)) {
    speak(6, "In Great Canyon,\nthere is a shop\nowned by a Digimon.\n");
    addPStat(40, 1);
    goto L50;
  }
  goto L51;

L50:
  jumpAndLink(L2);

L51:
  if (pstat[41] < 17) {
    addPStat(41, 1);
    goto L52;
  }
  goto L54;

L52:
  if (!trigger(233)) {
    speak(6, "You might meet a Digimon\nwith wings that can fly over\nMt. Panorama in one flap.\n");
    addPStat(40, 1);
    goto L53;
  }
  goto L54;

L53:
  jumpAndLink(L2);

L54:
  if (pstat[41] < 18) {
    addPStat(41, 1);
    goto L55;
  }
  goto L57;

L55:
  if (!trigger(231) || !trigger(245)) {
    speak(6, "Gear Savanna suits Digimon\nwho can't fly high.\nYou should search there.\n");
    addPStat(40, 1);
    goto L56;
  }
  goto L57;

L56:
  jumpAndLink(L2);

L57:
  if (pstat[41] < 19) {
    addPStat(41, 1);
    goto L58;
  }
  goto L60;

L58:
  if (!trigger(205)) {
    speak(6, "Some Digimon may know about\nyou and challenge you.\n");
    addPStat(40, 1);
    goto L59;
  }
  goto L60;

L59:
  jumpAndLink(L2);

L60:
  if (pstat[41] < 20) {
    addPStat(41, 1);
    goto L61;
  }
  goto L63;

L61:
  if (!trigger(257)) {
    speak(6, "In Freezeland, there are\nDigimons that live in caves\nand invite others in.\n");
    addPStat(40, 1);
    goto L62;
  }
  goto L63;

L62:
  jumpAndLink(L2);

L63:
  if (pstat[41] < 21) {
    addPStat(41, 1);
    goto L64;
  }
  goto L66;

L64:
  if (!trigger(238)) {
    speak(6, "You should ask hard working\nDigimon to come to the city,\nonce their duties are over.\n");
    addPStat(40, 1);
    goto L65;
  }
  goto L66;

L65:
  jumpAndLink(L2);

L66:
  if (pstat[41] < 22) {
    addPStat(41, 1);
    goto L67;
  }
  goto L69;

L67:
  if (!trigger(217)) {
    speak(6, "Misty Trees is perfect for\nhiding. Your job is also\nto guide Digimon in hiding.\n");
    addPStat(40, 1);
    goto L68;
  }
  goto L69;

L68:
  jumpAndLink(L2);

L69:
  if (pstat[41] < 23) {
    addPStat(41, 1);
    goto L70;
  }
  goto L72;

L70:
  if (!trigger(258)) {
    speak(6, "When rumors about you spread,\nyou should come back.\n");
    addPStat(40, 1);
    goto L71;
  }
  goto L72;

L71:
  jumpAndLink(L2);

L72:
  if (pstat[41] < 24) {
    addPStat(41, 1);
    goto L73;
  }
  goto L75;

L73:
  if (!trigger(224)) {
    speak(6, "A huge shadow appears along\nthe coasts of Freezeland.\nPerhaps it is a Digimon.\n");
    addPStat(40, 1);
    goto L74;
  }
  goto L75;

L74:
  jumpAndLink(L2);

L75:
  if (pstat[41] < 25) {
    addPStat(41, 1);
    goto L76;
  }
  goto L78;

L76:
  if (!trigger(252)) {
    speak(6, "Help Digimon that\nlove to collect things.\nTry going to Freezeland.\n");
    addPStat(40, 1);
    goto L77;
  }
  goto L78;

L77:
  jumpAndLink(L2);

L78:
  if (pstat[41] < 26) {
    addPStat(41, 1);
    goto L79;
  }
  goto L81;

L79:
  if (!trigger(213)) {
    speak(6, "On the top of Mt. Panorama,\na Digimon will challenge you\nto fight if you see him.\n");
    addPStat(40, 1);
    goto L80;
  }
  goto L81;

L80:
  jumpAndLink(L2);

L81:
  if (pstat[41] < 27) {
    addPStat(41, 1);
    goto L82;
  }
  goto L84;

L82:
  if (!trigger(211)) {
    speak(6, "Digimon are also in damp\nplaces such as sewers. Help\nthem with their problems.\n");
    addPStat(40, 1);
    goto L83;
  }
  goto L84;

L83:
  jumpAndLink(L2);

L84:
  if (pstat[41] < 28) {
    addPStat(41, 1);
    goto L85;
  }
  goto L87;

L85:
  if (!trigger(210)) {
    speak(6, "Some Insectoid Digimon live\nbeyond Dragon Eye Lake.\nGo fishing there.\n");
    addPStat(40, 1);
    goto L86;
  }
  goto L87;

L86:
  jumpAndLink(L2);

L87:
  if (pstat[41] < 29) {
    addPStat(41, 1);
    goto L88;
  }
  goto L90;

L88:
  if (!trigger(241)) {
    speak(6, "When Android Digimon\nbreaks, he can repair\nhimself completely quickly.\n");
    addPStat(40, 1);
    goto L89;
  }
  goto L90;

L89:
  jumpAndLink(L2);

L90:
  if (pstat[41] < 30) {
    addPStat(41, 1);
    goto L91;
  }
  goto L93;

L91:
  if (!trigger(142)) {
    speak(6, "If you fear danger, you'll\nlose sight of your goal.\n");
    showTextbox("You gotta be brave enough to\ntry climbing a dangerous\ncliff at least once.\n");
    addPStat(40, 1);
    goto L92;
  }
  goto L93;

L92:
  jumpAndLink(L2);

L93:
  if (pstat[41] < 31) {
    addPStat(41, 1);
    goto L94;
  }
  goto L96;

L94:
  if (!trigger(198)) {
    speak(6, "Listen to anything you hear\nfrom the city about\npeople who need help.\n");
    addPStat(40, 1);
    goto L95;
  }
  goto L96;

L95:
  jumpAndLink(L2);

L96:
  if (pstat[41] < 32) {
    addPStat(41, 1);
    goto L97;
  }
  goto L99;

L97:
  if (!trigger(150)) {
    speak(6, "There's a mean guy that has\nmoved into a very populated\narea recently. Maybe it's...\n");
    addPStat(40, 1);
    goto L98;
  }
  goto L99;

L98:
  jumpAndLink(L2);

L99:
  if (pstat[41] < 33) {
    addPStat(41, 1);
    goto L100;
  }
  goto L102;

L100:
  if (!trigger(135)) {
    speak(6, "There is supposedly a\nburied old tablet, but\nsomeone has to dig it up.\n");
    addPStat(40, 1);
    goto L101;
  }
  goto L102;

L101:
  jumpAndLink(L2);

L102:
  if (pstat[41] < 34) {
    addPStat(41, 1);
    goto L103;
  }
  goto L105;

L103:
  if (!trigger(255)) {
    speak(6, "A rare Digimon appears\nin a jungle and challenges\nothers to fight.\n");
    addPStat(40, 1);
    goto L104;
  }
  goto L105;

L104:
  jumpAndLink(L2);

L105:
  if (pstat[41] < 35) {
    addPStat(41, 1);
    goto L106;
  }
  goto L108;

L106:
  if (!trigger(242)) {
    speak(6, "There might be Digimon that\nlive in trees, but who knows?\n");
    addPStat(40, 1);
