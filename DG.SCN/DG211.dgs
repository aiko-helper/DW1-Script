// DG211.SCN
#include "functions.dgs"
#pragma script index=211 start=0xb0000 end=0xb2800 headerU16=0xc sentinelOff=0xfe
#include "entities.dgs"

section onEnter(254) {
  return;
}

section(8) {
  if (!trigger(81)) {
    setTrigger(Trigger(81));
    speak(Entity(6), "Welcome back, <LIGHTBLUE><PLAYER><WHITE>.\n");
    speak(Entity(6), "I'm Jijimon's recordkeeper.\n");
    speak(Entity(6), "I record Jijimon's info\nand give it to you.\n");
    speak(Entity(6), "If you don't know what to do\nask me, and I'll tell you\nwhere to go.\n");
    return;
  }
  if (pstat[1] == 100) {
    speak(Entity(6), "All the Digimon have\ngathered in the city.\nThank you so much!\n");
    return;
  }
  {
    speak(Entity(6), "Let me tell you what I know.\nLet's see...\n");
    break;
    loop {
      speak(Entity(6), "And then...\n");
      goto L3;

L1:
      speak(Entity(6), "And also...\n");
      goto L3;

L2:
      if (pstat[40] != 1) break;
    }
    switch pstat[40] {
      2 => {
        goto L1;
      }
      3 => {
        goto L4;
      }
    }
    jumpReturn();

L3:
  }
  {
    if (pstat[41] < 1) {
      addPStat(PStat(41), 1);
    } else {
      break;
    }
    if (!trigger(246)) {
      speak(Entity(6), "Vegetation Digimon are in the\nforest. The closer they are\nthe harder they are to see.\n");
      addPStat(PStat(40), 1);
    } else {
      break;
    }
    jumpAndLink(L2);
  }
  {
