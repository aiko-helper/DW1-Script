// DG211.SCN
#include "functions.dgs"
#pragma script index=211 start=0xb0000 end=0xb2800 headerU16=0xc sentinelOff=0xfe
#include "entities.dgs"

section onEnter(254) {
  return;
}

section(8) {
  if (!trigger(81)) {
    setTrigger(81);
    speak(6, "Welcome back, <LIGHTBLUE><PLAYER><WHITE>.\n");
    speak(6, "I'm Jijimon's recordkeeper.\n");
    speak(6, "I record Jijimon's info\nand give it to you.\n");
    speak(6, "If you don't know what to do\nask me, and I'll tell you\nwhere to go.\n");
    return;
  }
  if (pstat[1] == 100) {
    speak(6, "All the Digimon have\ngathered in the city.\nThank you so much!\n");
    return;
  }
  speak(6, "Let me tell you what I know.\nLet's see...\n");
  goto L3;
  loop {
    speak(6, "And then...\n");
    goto L3;

L1:
    speak(6, "And also...\n");
    goto L3;

L2:
    if (pstat[40] != 1) break;
  }
  if (pstat[40] == 2) {
    goto L1;
  }
  if (pstat[40] == 3) {
    goto L45;
  }
  jumpReturn();

L3:
  if (pstat[41] < 1) {
    addPStat(41, 1);
  } else {
    goto L4;
  }
  if (!trigger(246)) {
    speak(6, "Vegetation Digimon are in the\nforest. The closer they are\nthe harder they are to see.\n");
    addPStat(40, 1);
  } else {
    goto L4;
  }
  jumpAndLink(L2);

L4:
  if (pstat[41] < 2) {
    addPStat(41, 1);
  } else {
    goto L5;
  }
  if (!trigger(232)) {
    speak(6, "Insectoid Digimons like\ngreenery. Like the kind\naround the city...\n");
    addPStat(40, 1);
  } else {
    goto L5;
  }
  jumpAndLink(L2);

L5:
  if (pstat[41] < 3) {
    addPStat(41, 1);
  } else {
    goto L6;
  }
  if (!trigger(236)) {
    speak(6, "In Tropical Jungle there is\na maze-like forest.\nA strong Digimon guards it.\n");
    addPStat(40, 1);
  } else {
    goto L6;
  }
  jumpAndLink(L2);

L6:
  if (pstat[41] < 4) {
    addPStat(41, 1);
  } else {
    goto L7;
  }
  if (!trigger(249)) {
    speak(6, "An old-timer in the river\nis waiting for someone.\n");
    addPStat(40, 1);
  } else {
    goto L7;
  }
  jumpAndLink(L2);

L7:
  if (pstat[41] < 5) {
    addPStat(41, 1);
  } else {
    goto L8;
  }
  if (!trigger(204)) {
    speak(6, "There is a Digimon who\nloves warm water shores.\n");
    addPStat(40, 1);
  } else {
    goto L8;
  }
  jumpAndLink(L2);

L8:
  if (pstat[41] < 6) {
    addPStat(41, 1);
  } else {
    goto L9;
  }
  if (!trigger(237)) {
    speak(6, "Graveyards have ghosts.\nGhosts love talking to you.\n");
    addPStat(40, 1);
  } else {
    goto L9;
  }
  jumpAndLink(L2);

L9:
  if (pstat[41] < 7) {
    addPStat(41, 1);
  } else {
    goto L10;
  }
  if (!trigger(225)) {
    speak(6, "A secret lies in the flower\nbed of the city. Ask a plant\nabout another plant.\n");
    addPStat(40, 1);
  } else {
    goto L10;
  }
  jumpAndLink(L2);

L10:
  if (pstat[41] < 8) {
    addPStat(41, 1);
  } else {
    goto L11;
  }
  if (!trigger(208)) {
    speak(6, "The Ancient Dino Region\nis dangerous, but it's\nbest to check it out.\n");
    addPStat(40, 1);
  } else {
    goto L11;
  }
  jumpAndLink(L2);

L11:
  if (pstat[41] < 9) {
    addPStat(41, 1);
  } else {
    goto L12;
  }
  if (!trigger(209)) {
    speak(6, "Lava flows inside of\nMt. Panorama. Some Digimon\nlove the heat.\n");
    addPStat(40, 1);
  } else {
    goto L12;
  }
  jumpAndLink(L2);

L12:
  if (pstat[41] < 10) {
    addPStat(41, 1);
  } else {
    goto L13;
  }
  if (!trigger(223)) {
    speak(6, "Taking a Digimon, who loves\nhot places, to a cold place\nis against the rules, but...\n");
    addPStat(40, 1);
  } else {
    goto L13;
  }
  jumpAndLink(L2);

L13:
  if (pstat[41] < 11) {
    addPStat(41, 1);
  } else {
    goto L14;
  }
  if (!trigger(222)) {
    speak(6, "In Freezeland there are many\nDigimon who'll come with you.\nGo to the west.\n");
    addPStat(40, 1);
  } else {
    goto L14;
  }
  jumpAndLink(L2);

L14:
  if (pstat[41] < 12) {
    addPStat(41, 1);
  } else {
    goto L15;
  }
  if (!trigger(221)) {
    speak(6, "On the peak of Great Canyon,\na Bird Digimon lives.\n");
    addPStat(40, 1);
  } else {
    goto L15;
  }
  jumpAndLink(L2);

L15:
  if (pstat[41] < 13) {
    addPStat(41, 1);
  } else {
    goto L16;
  }
  if (!trigger(235)) {
    speak(6, "Great Canyon is like a\nmaze. Once entered,\nit's hard to leave.\n");
    addPStat(40, 1);
  } else {
    goto L16;
  }
  jumpAndLink(L2);

L16:
  if (pstat[41] < 14) {
    addPStat(41, 1);
  } else {
    goto L17;
  }
  if (!trigger(218)) {
    speak(6, "In Gear Savanna,\nthere is a Digimon\nwho loves electricity.\n");
    addPStat(40, 1);
  } else {
    goto L17;
  }
  jumpAndLink(L2);

L17:
  if (pstat[41] < 15) {
    addPStat(41, 1);
  } else {
    goto L18;
  }
  if (!trigger(250)) {
    speak(6, "In Misty Trees, an early\nrising Digimon may appear.\n");
    addPStat(40, 1);
  } else {
    goto L18;
  }
  jumpAndLink(L2);

L18:
  if (pstat[41] < 16) {
    addPStat(41, 1);
  } else {
    goto L19;
  }
  if (!trigger(247)) {
    speak(6, "In Great Canyon,\nthere is a shop\nowned by a Digimon.\n");
    addPStat(40, 1);
  } else {
    goto L19;
  }
  jumpAndLink(L2);

L19:
  if (pstat[41] < 17) {
    addPStat(41, 1);
  } else {
    goto L20;
  }
  if (!trigger(233)) {
    speak(6, "You might meet a Digimon\nwith wings that can fly over\nMt. Panorama in one flap.\n");
    addPStat(40, 1);
  } else {
    goto L20;
  }
  jumpAndLink(L2);

L20:
  if (pstat[41] < 18) {
    addPStat(41, 1);
  } else {
    goto L21;
  }
  if (!trigger(231) || !trigger(245)) {
    speak(6, "Gear Savanna suits Digimon\nwho can't fly high.\nYou should search there.\n");
    addPStat(40, 1);
  } else {
    goto L21;
  }
  jumpAndLink(L2);

L21:
  if (pstat[41] < 19) {
    addPStat(41, 1);
  } else {
    goto L22;
  }
  if (!trigger(205)) {
    speak(6, "Some Digimon may know about\nyou and challenge you.\n");
    addPStat(40, 1);
  } else {
    goto L22;
  }
  jumpAndLink(L2);

L22:
  if (pstat[41] < 20) {
    addPStat(41, 1);
  } else {
    goto L23;
  }
  if (!trigger(257)) {
    speak(6, "In Freezeland, there are\nDigimons that live in caves\nand invite others in.\n");
    addPStat(40, 1);
  } else {
    goto L23;
  }
  jumpAndLink(L2);

L23:
  if (pstat[41] < 21) {
    addPStat(41, 1);
  } else {
    goto L24;
  }
  if (!trigger(238)) {
    speak(6, "You should ask hard working\nDigimon to come to the city,\nonce their duties are over.\n");
    addPStat(40, 1);
  } else {
    goto L24;
  }
  jumpAndLink(L2);

L24:
  if (pstat[41] < 22) {
    addPStat(41, 1);
  } else {
    goto L25;
  }
  if (!trigger(217)) {
    speak(6, "Misty Trees is perfect for\nhiding. Your job is also\nto guide Digimon in hiding.\n");
    addPStat(40, 1);
  } else {
    goto L25;
  }
  jumpAndLink(L2);

L25:
  if (pstat[41] < 23) {
    addPStat(41, 1);
  } else {
    goto L26;
  }
  if (!trigger(258)) {
    speak(6, "When rumors about you spread,\nyou should come back.\n");
    addPStat(40, 1);
  } else {
    goto L26;
  }
  jumpAndLink(L2);

L26:
  if (pstat[41] < 24) {
    addPStat(41, 1);
  } else {
    goto L27;
  }
  if (!trigger(224)) {
    speak(6, "A huge shadow appears along\nthe coasts of Freezeland.\nPerhaps it is a Digimon.\n");
    addPStat(40, 1);
  } else {
    goto L27;
  }
  jumpAndLink(L2);

L27:
  if (pstat[41] < 25) {
    addPStat(41, 1);
  } else {
    goto L28;
  }
  if (!trigger(252)) {
    speak(6, "Help Digimon that\nlove to collect things.\nTry going to Freezeland.\n");
    addPStat(40, 1);
  } else {
    goto L28;
  }
  jumpAndLink(L2);

L28:
  if (pstat[41] < 26) {
    addPStat(41, 1);
  } else {
    goto L29;
  }
  if (!trigger(213)) {
    speak(6, "On the top of Mt. Panorama,\na Digimon will challenge you\nto fight if you see him.\n");
    addPStat(40, 1);
  } else {
    goto L29;
  }
  jumpAndLink(L2);

L29:
  if (pstat[41] < 27) {
    addPStat(41, 1);
  } else {
    goto L30;
  }
  if (!trigger(211)) {
    speak(6, "Digimon are also in damp\nplaces such as sewers. Help\nthem with their problems.\n");
    addPStat(40, 1);
  } else {
    goto L30;
  }
  jumpAndLink(L2);

L30:
  if (pstat[41] < 28) {
    addPStat(41, 1);
  } else {
    goto L31;
  }
  if (!trigger(210)) {
    speak(6, "Some Insectoid Digimon live\nbeyond Dragon Eye Lake.\nGo fishing there.\n");
    addPStat(40, 1);
  } else {
    goto L31;
  }
  jumpAndLink(L2);

L31:
  if (pstat[41] < 29) {
    addPStat(41, 1);
  } else {
    goto L32;
  }
  if (!trigger(241)) {
    speak(6, "When Android Digimon\nbreaks, he can repair\nhimself completely quickly.\n");
    addPStat(40, 1);
  } else {
    goto L32;
  }
  jumpAndLink(L2);

L32:
  if (pstat[41] < 30) {
    addPStat(41, 1);
  } else {
    goto L33;
  }
  if (!trigger(142)) {
    speak(6, "If you fear danger, you'll\nlose sight of your goal.\n");
    showTextbox("You gotta be brave enough to\ntry climbing a dangerous\ncliff at least once.\n");
    addPStat(40, 1);
  } else {
    goto L33;
  }
  jumpAndLink(L2);

L33:
  if (pstat[41] < 31) {
    addPStat(41, 1);
  } else {
    goto L34;
  }
  if (!trigger(198)) {
    speak(6, "Listen to anything you hear\nfrom the city about\npeople who need help.\n");
    addPStat(40, 1);
  } else {
    goto L34;
  }
  jumpAndLink(L2);

L34:
  if (pstat[41] < 32) {
    addPStat(41, 1);
  } else {
    goto L35;
  }
  if (!trigger(150)) {
    speak(6, "There's a mean guy that has\nmoved into a very populated\narea recently. Maybe it's...\n");
    addPStat(40, 1);
  } else {
    goto L35;
  }
  jumpAndLink(L2);

L35:
  if (pstat[41] < 33) {
    addPStat(41, 1);
  } else {
    goto L36;
  }
  if (!trigger(135)) {
    speak(6, "There is supposedly a\nburied old tablet, but\nsomeone has to dig it up.\n");
    addPStat(40, 1);
  } else {
    goto L36;
  }
  jumpAndLink(L2);

L36:
  if (pstat[41] < 34) {
    addPStat(41, 1);
  } else {
    goto L37;
  }
  if (!trigger(255)) {
    speak(6, "A rare Digimon appears\nin a jungle and challenges\nothers to fight.\n");
    addPStat(40, 1);
  } else {
    goto L37;
  }
  jumpAndLink(L2);

L37:
  if (pstat[41] < 35) {
    addPStat(41, 1);
  } else {
    goto L38;
  }
  if (!trigger(242)) {
    speak(6, "There might be Digimon that\nlive in trees, but who knows?\n");
    addPStat(40, 1);
  } else {
    goto L38;
  }
  jumpAndLink(L2);

L38:
  if (pstat[41] < 36) {
    addPStat(41, 1);
  } else {
    goto L39;
  }
  if (!trigger(227)) {
    speak(6, "In an Iron City to the west a\nrare Digimon may appear and\nchallenge others to fight.\n");
    addPStat(40, 1);
  } else {
    goto L39;
  }
  jumpAndLink(L2);

L39:
  if (pstat[41] < 37) {
    addPStat(41, 1);
  } else {
    goto L40;
  }
  if (!trigger(228)) {
    speak(6, "There is an Alien Digimon.\nYou may meet him someday.\n");
    addPStat(40, 1);
  } else {
    goto L40;
  }
  jumpAndLink(L2);

L40:
  if (pstat[41] < 38) {
    addPStat(41, 1);
  } else {
    goto L41;
  }
  if (pstat[21] == 0) {
    speak(6, "There is a Mythical Animal\nDigimon. He is in a house\nthat has lost its owners.\n");
    addPStat(40, 1);
  } else {
    goto L41;
  }
  jumpAndLink(L2);

L41:
  if (pstat[41] < 39) {
    addPStat(41, 1);
  } else {
    goto L42;
  }
  if (pstat[21] == 1) {
    speak(6, "You must keep looking for\nNanimon until you get the\nreal treasure.\n");
    addPStat(40, 1);
  } else {
    goto L42;
  }
  jumpAndLink(L2);

L42:
  if (pstat[41] < 40) {
    addPStat(41, 1);
  } else {
    goto L43;
  }
  if (!trigger(129)) {
    speak(6, "Myotismon is missing.\nFollow the clues that\nare in his mansion.\n");
    addPStat(40, 1);
  } else {
    goto L43;
  }
  jumpAndLink(L2);

L43:
  if (pstat[41] < 41) {
    addPStat(41, 1);
  } else {
    goto L44;
  }
  if (!trigger(50)) {
    speak(6, "There are still some unknown\nDigimon, but finish your\npriority work first!\n");
    addPStat(40, 1);
  } else {
    goto L44;
  }
  jumpAndLink(L2);

L44:
  if (pstat[41] < 42) {
    addPStat(41, 1);
  } else {
    goto L45;
  }
  if (!trigger(256) && trigger(50)) {
    speak(6, "The last Digimon will be\nborn at the last place you go\nto. Do you understand this?\n");
    addPStat(40, 1);
  }
  goto L45;

L45:
  setPStat(41, 0);
  setPStat(40, 0);
  return;
  garbage { 0c 00 fe 00 0c 00 08 00 0e 00 ff ff fe 00 19 00 01 00 51 00 18 00 76 01 19 00 1c 00 51 00 1b 06 1a 00 82 76 82 85 82 8c 82 83 82 8f 82 8d 82 85 81 40 82 82 82 81 82 83 82 8b 81 43 81 40 01 06 05 00 01 01 81 42 0d 00 00 00 1b 06 1a 00 82 68 81 75 82 8d 81 40 82 69 82 89 82 8a 82 89 82 8d 82 8f 82 8e 81 75 82 93 81 40 82 92 82 85 82 83 82 8f 82 92 82 84 82 8b 82 85 82 85 82 90 82 85 82 92 81 42 0d 00 00 00 1b 06 1a 00 82 68 81 40 82 92 82 85 82 83 82 8f 82 92 82 84 81 40 82 69 82 89 82 8a 82 89 82 8d 82 8f 82 8e 81 75 82 93 81 40 82 89 82 8e 82 86 82 8f 0d 00 82 81 82 8e 82 84 81 40 82 87 82 89 82 96 82 85 81 40 82 89 82 94 81 40 82 94 82 8f 81 40 82 99 82 8f 82 95 81 42 0d 00 00 00 1b 06 1a 00 82 68 82 86 81 40 82 99 82 8f 82 95 81 40 82 84 82 8f 82 8e 81 75 82 94 81 40 82 8b 82 8e 82 8f 82 97 81 40 82 97 82 88 82 81 82 94 81 40 82 94 82 8f 81 40 82 84 82 8f 0d 00 82 81 82 93 82 8b 81 40 82 8d 82 85 81 43 81 40 82 81 82 8e 82 84 81 40 82 68 81 75 82 8c 82 8c 81 40 82 94 82 85 82 8c 82 8c 81 40 82 99 82 8f 82 95 0d 00 82 97 82 88 82 85 82 92 82 85 81 40 82 94 82 8f 81 40 82 87 82 8f 81 42 0d 00 00 00 fe 00 19 00 08 00 01 64 18 00 06 02 19 00 1b 06 1a 00 82 60 82 8c 82 8c 81 40 82 94 82 88 82 85 81 40 82 63 82 89 82 87 82 89 82 8d 82 8f 82 8e 81 40 82 88 82 81 82 96 82 85 0d 00 82 87 82 81 82 94 82 88 82 85 82 92 82 85 82 84 81 40 82 89 82 8e 81 40 82 94 82 88 82 85 81 40 82 83 82 89 82 94 82 99 81 42 0d 00 82 73 82 88 82 81 82 8e 82 8b 81 40 82 99 82 8f 82 95 81 40 82 93 82 8f 81 40 82 8d 82 95 82 83 82 88 81 49 0d 00 00 00 fe 00 1b 06 1a 00 82 6b 82 85 82 94 81 40 82 8d 82 85 81 40 82 94 82 85 82 8c 82 8c 81 40 82 99 82 8f 82 95 81 40 82 97 82 88 82 81 82 94 81 40 82 68 81 40 82 8b 82 8e 82 8f 82 97 81 42 0d 00 82 6b 82 85 82 94 81 75 82 93 81 40 82 93 82 85 82 85 81 42 81 42 81 42 0d 00 00 00 16 00 da 02 1b 06 1a 00 82 60 82 8e 82 84 81 40 82 94 82 88 82 85 82 8e 81 42 81 42 81 42 0d 00 00 00 16 00 da 02 1b 06 1a 00 82 60 82 8e 82 84 81 40 82 81 82 8c 82