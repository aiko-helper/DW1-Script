// DG110.SCN
#include "functions.dgs"
#pragma script index=110 start=0x49800 end=0x4a000 headerU16=0x24 sentinelOff=0x24
#include "entities.dgs"

section onEnter(254) {
  spawnItemChance(max: 99, chance: 7, item: Item.Digimushroom, x: 55, y: 71);
  spawnItemChance(max: 99, chance: 15, item: Item.Digimushroom, x: 45, y: 58);
  spawnItemChance(max: 99, chance: 4, item: Item.Digimushroom, x: 14, y: 6);
  return;
}

section(5) {
  speak(Entity(5), "「迷いこんだね、<LIGHTBLUE><PLAYER><WHITE>君?ケケケケケッ!」<NEWLINE>");
  finishEncounter(Trigger(280));
}

section(6) {
  speak(Entity(6), "「ん?」<NEWLINE>");
  finishEncounter(Trigger(289));
}

section(7) {
  speak(Entity(7), "「別にジャマしてるわけじゃないんです…」<NEWLINE>");
  finishEncounter(Trigger(291));
}

section(8) {
  speak(Entity(8), "「みすてぃつりーず…はい、言ってごらん。」<NEWLINE>");
  finishEncounter(Trigger(306));
}

section(9) {
  speak(Entity(9), "「OK!ショータイム!!」<NEWLINE>");
  finishEncounter(Trigger(306));
}

section(51) {
  move(entity: Entity.Player, to: (60, -3200), sprint: 0);
  if (trigger(114) || trigger(147)) {
    warp(to: Map.MIST02, spawn: 2, trigger: 255);
  }
  roll(pstat: PStat.RollScratch, max: 99);
  if (pstat[110] < 69) {
    warp(to: Map.MIST02, spawn: 2, trigger: 255);
    goto section_52;
  }
  warp(to: Map.MIST07, spawn: 1, trigger: 255);
}

section(52) {
  move(entity: Entity.Player, to: (70, 5200), sprint: 0);
  if (trigger(114) || trigger(147)) {
    warp(to: Map.MIST05, spawn: 0, trigger: 255);
  }
  addPStat(PStat(120), 1);
  if (pstat[120] == 10) {
    setPStat(PStat(120), 0);
    warp(to: Map.MIST05, spawn: 0, trigger: 255);
  }
  roll(pstat: PStat.RollScratch, max: 99);
  if (pstat[110] < 69) {
    warp(to: Map.MIST04, spawn: 0, trigger: 255);
  } else {
    warp(to: Map.MIST02, spawn: 0, trigger: 255);
  }
  garbage { 24 00 fe 00 24 00 05 00 68 00 06 00 a8 00 07 00 c6 00 08 00 04 01 09 00 44 01 33 00 74 01 34 00 ac 01 ff ff 24 00 6e 63 19 00 0b 00 6e 07 18 00 3a 00 19 00 74 2c 37 00 47 00 24 00 6e 63 19 00 0b 00 6e 0f 18 00 50 00 19 00 74 2c 2d 00 3a 00 24 00 6e 63 19 00 0b 00 6e 04 18 00 66 00 19 00 74 2c 0e 00 06 00 fe 00 1b 05 1a 00 81 75 96 c0 82 a2 82 b1 82 f1 82 be 82 cb 81 41 01 06 05 00 01 01 8c 4e 81 48 83 50 83 50 83 50 83 50 83 50 83 62 81 49 81 76 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 18 01 fe 00 1b 06 1a 00 81 75 82 f1 81 48 81 76 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 21 01 fe 00 1b 07 1a 00 81 75 95 ca 82 c9 83 57 83 83 83 7d 82 b5 82 c4 82 e9 82 ed 82 af 82 b6 82 e1 82 c8 82 a2 82 f1 82 c5 82 b7 81 63 81 76 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 23 01 fe 00 1b 08 1a 00 81 75 82 dd 82 b7 82 c4 82 a1 82 c2 82 e8 81 5b 82 b8 81 63 82 cd 82 a2 81 41 8c be 82 c1 82 c4 82 b2 82 e7 82 f1 81 42 81 76 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 32 01 fe 00 1b 09 1a 00 81 75 82 6e 82 6a 81 49 83 56 83 87 81 5b 83 5e 83 43 83 80 81 49 81 49 81 76 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 32 01 fe 00 4e fd 3c 00 80 f3 00 00 19 00 00 00 72 00 40 00 93 00 18 00 90 01 19 00 4b 74 02 ff 24 00 6e 63 19 00 0d 00 6e 45 18 00 a8 01 19 00 4b 74 02 ff 16 00 ac 01 4b 79 01 ff 4e fd 46 00 50 14 00 00 19 00 00 00 72 00 40 00 93 00 18 00 c8 01 19 00 4b 77 00 ff 1f 00 78 01 19 00 08 00 78 0a 18 00 e0 01 19 00 1e 00 78 00 4b 77 00 ff 24 00 6e 63 19 00 0d 00 6e 45 18 00 f8 01 19 00 4b 76 00 ff 16 00 fc 01 4b 74 00 ff ff 00 18 01 fe 00 5a 00 08 0b 1b 05 1a 00 81 75 82 b1 82 e8 82 e1 82 a0 82 a0 81 49 81 76 0d 00 00 00 1c 00 01 00 1e 00 fa 01 1e 00 fb 05 1e 00 fc ff 1e 00 fd ff 27 00 67 00 01 00 66 00 1d 00 01 00 1e 00 fa 00 4c 00 05 fd 4c 00 fd 05 4c 00 fc 05 67 00 0a 00 1b 05 1a 00 81 75 82 f1 81 5b 81 5b 81 5b 82 de 81 42 82 a8 82 ca 82 b5 81 41 82 e2 82 e9 82 cc 81 5b 81 5b 81 5b 81 42 0d 00 81 40 92 a9 91 81 82 ad 82 a9 82 e7 8a b4 90 53 82 c8 8e 71 82 be 81 42 81 76 0d