; DG001.SCN
;!script index=1 start=0x7000 end=0x7800 headerU16=0x2c sentinelOff=0x24
;!sections onEnter section_5 section_6 section_7 section_8 section_9 section_10 section_11 section_12 section_51

onEnter:     ; len=124
  0000:  storeRandom 110 99
  0004:  if pstat[110] > 39 then onEnter+0x16
  0010:  spawnItem 44 78 31
  0016:  storeRandom 110 99
  001a:  if pstat[110] > 1 then onEnter+0x2c
  0026:  spawnItem 46 39 43
  002c:  storeRandom 110 99
  0030:  if pstat[110] > 9 then onEnter+0x4e
  003c:  spawnItem 44 35 88
  0042:  spawnItem 44 31 85
  0048:  spawnItem 44 30 79
  004e:  storeRandom 110 99
  0052:  if pstat[110] > 14 then onEnter+0x64
  005e:  spawnItem 44 68 84
  0064:  storeRandom 110 99
  0068:  if pstat[110] > 24 then onEnter+0x7a
  0074:  spawnItem 44 49 46
  007a:  endSection
