// DG001.SCN
#pragma script index=1 start=0x7000 end=0x7800 headerU16=0x2c sentinelOff=0x24
#pragma sections section_0254 section_0005 section_0006 section_0007 section_0008 section_0009 section_0010 section_0011 section_0012 section_0051

section onEnter(254) {  // len=124
    roll(pstat: 110, max: 99);
    if (pstat[110] > 39) goto L_0016;
    spawnItem(Item.Digimushroom, 78, 31);
L_0016:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 1) goto L_002c;
    spawnItem(Item.DeluxeMushroom, 39, 43);
L_002c:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 9) goto L_004e;
    spawnItem(Item.Digimushroom, 35, 88);
    spawnItem(Item.Digimushroom, 31, 85);
    spawnItem(Item.Digimushroom, 30, 79);
L_004e:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 14) goto L_0064;
    spawnItem(Item.Digimushroom, 68, 84);
L_0064:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 24) goto L_007a;
    spawnItem(Item.Digimushroom, 49, 46);
L_007a:
    return;
}
