// DG018.SCN
#pragma script index=18 start=0x12000 end=0x14000 headerU16=0x70 sentinelOff=0x1e

section onEnter(254) {  // len=350
    setPStat(254, 0);
    callSubroutine(25);
    if (!trigger(236)) goto L1;
    return;

L1:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 29) goto L2;
    spawnItem(Item.GiantMeat, 33, 49);
    goto L3;

L2:
    if (pstat[110] > 49) goto L3;
    spawnItem(Item.OffenseDisk, 33, 49);

L3:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 29) goto L4;
    spawnItem(Item.MPFloppy, 49, 53);
    goto L5;

L4:
    if (pstat[110] > 49) goto L5;
    spawnItem(Item.SmallRecovery, 49, 53);

L5:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 29) goto L6;
    spawnItem(Item.DefenseDisk, 67, 42);
    goto L7;

L6:
    if (pstat[110] > 49) goto L7;
    spawnItem(Item.Meat, 67, 42);

L7:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 9) goto L8;
    spawnItem(Item.PortaPotty, 34, 29);
    goto L9;

L8:
    if (pstat[110] > 29) goto L9;
    spawnItem(Item.SpeedDisk, 34, 29);

L9:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 9) goto L10;
    spawnItem(Item.MediumRecovery, 50, 34);
    goto L11;

L10:
    if (pstat[110] > 29) goto L11;
    spawnItem(Item.MoldyMeat, 50, 34);

L11:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 1) goto L12;
    spawnItem(Item.OrangeBanana, 49, 18);
    goto L14;

L12:
    if (pstat[110] > 9) goto L13;
    spawnItem(Item.Happymushroom, 49, 18);
    goto L14;

L13:
    if (pstat[110] > 29) goto L14;
    spawnItem(Item.Autopilot, 49, 18);

L14:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 4) goto L15;
    spawnItem(Item.OmniDisk, 65, 22);
    return;

L15:
    if (pstat[110] > 29) goto L16;
    spawnItem(Item.MediumMP, 65, 22);

L16:
    return;
}

section(51) {  // len=290
    for id in 38..43 { setObjectVisibility(id, 1); }
    if (!trigger(236)) goto L1;
    return;

L1:
    roll(pstat: 110, max: 2);
    if (pstat[110] != 0) goto L2;
    setPStat(116, 0);
    setObjectVisibility(38, 0);
    setObjectVisibility(42, 0);
    setObjectVisibility(43, 0);

L2:
    if (pstat[110] != 1) goto L3;
    setPStat(116, 1);
    setObjectVisibility(39, 0);
    setObjectVisibility(41, 0);
    setObjectVisibility(43, 0);

L3:
    if (pstat[110] != 2) goto L4;
    setPStat(116, 2);
    for id in 40..42 { setObjectVisibility(id, 0); }

L4:
    if (trigger(137)) goto L5;
    setTrigger(137);
    rotate(entity: Entity.Player, to: 2048);
    playSound(8, 0);
    delay(20);
    playSound(8, 0);
    delay(20);
    playSound(8, 0);
    delay(20);
    setDialogOwner(Entity.System);
    showTextbox("Trespasser Alert!\n");
    showTextbox("Trespasser Alert!\n");
    showTextbox("I will shoot!\n");

L5:
    jumpAndLink(section_10);
    return;
}

section(10) {  // len=408
    for id in 158..173 { unsetTrigger(id); }
    jumpReturn();

L1:
    if (stat[Stat.CurrentHP] != 1) goto L2;
    look(entity: Entity.Player, at: Entity.Partner);
    setDialogOwner(Entity.Player);
    showTextbox("Are you alright <ORANGE><DIGIMON><WHITE>?!\n");
    showTextbox("Let's go back.\n");
    warp(to: Map.TROP06, spawn: 0, trigger: 51);

L2:
    jumpReturn();

L3:
    if (stat[Stat.CurrentHP] != 1) goto L4;
    look(entity: Entity.Player, at: Entity.Partner);
    setDialogOwner(Entity.Player);
    showTextbox("Oh no! I gotta revive\n<ORANGE><DIGIMON><WHITE>.\n");
    warp(to: Map.TROP06, spawn: 0, trigger: 51);

L4:
    jumpReturn();

L5:
    playSound(8, 1);
    setObjectVisibility(44, 0);
    setObjectVisibility(45, 0);
    spawnSpriteAtEntity(253, 11274);
    spawnSpriteAtEntity(253, 11530);
    delay(4);
    setObjectVisibility(44, 1);
    setObjectVisibility(45, 1);
    delay(4);
    setObjectVisibility(44, 0);
    setObjectVisibility(45, 0);
    spawnSpriteAtEntity(253, 11274);
    spawnSpriteAtEntity(253, 11530);
    delay(4);
    setObjectVisibility(44, 1);
    setObjectVisibility(45, 1);
    delay(4);
    setObjectVisibility(44, 0);
    setObjectVisibility(45, 0);
    spawnSpriteAtEntity(253, 11274);
    spawnSpriteAtEntity(253, 11530);
    delay(4);
    setObjectVisibility(44, 1);
    setObjectVisibility(45, 1);
    delay(10);
    jumpReturn();

L6:
    for id in 46..48 { setObjectVisibility(id, 1); }
    moveObjectTo(0, 46, 1, 0, 0, 600, 900);
    moveObjectTo(1, 47, 1, 0, 0, 600, 900);
    moveObjectTo(2, 48, 1, 0, 0, 600, 900);
    delay(1);
    jumpReturn();
}

section(52) {  // len=198
    if (!trigger(236)) goto L1;
    return;

L1:
    jumpAndLink(section_10.L3);
    setTrigger(158);
    unsetTrigger(159);
    unsetTrigger(160);
    if (!trigger(161)) goto L2;
    goto L3;

L2:
    return;

L3:
    rotate(entity: Entity.Player, to: 2048);
    rotate(entity: Entity.Partner, to: 2048);
    jumpAndLink(section_10.L5);
    playSound(8, 2);
    for id in 46..48 { setObjectVisibility(id, 0); }
    setPStat(247, 46);
    setPStat(248, 3);
    callSubroutine(21);
    moveObjectTo(0, 46, 1, 0, 0, 109, 428);
    moveObjectTo(1, 47, 1, 0, 0, 109, 432);
    moveObjectTo(2, 48, 1, 0, 0, 109, 436);
    delay(1);
    moveObjectTo(0, 46, 1, 10, 0, 52, 765);
    moveObjectTo(1, 47, 1, 10, 0, 52, 769);
    moveObjectTo(2, 48, 1, 10, 0, 52, 773);
    delay(3);
    playAnimation(Entity.Partner, 40);
    setPStat(200, 50);
    dealMapDamage(200);
    playAnimation(Entity.Player, 17);
    move(entity: Entity.Player, axis: 2, to: -3800, speed: 10, withCamera: true);
    delay(40);
    jumpAndLink(section_10.L6);
    moveCamera(to: Entity.Player, speed: 10);
    waitForEntity(200);
    jumpAndLink(section_10);
    jumpAndLink(section_10.L1);
    return;
}

