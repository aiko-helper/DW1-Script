// DG018.SCN
#include "functions.dgs"
#pragma script index=18 start=0x12000 end=0x14000 headerU16=0x70 sentinelOff=0x1e
#include "entities.dgs"

section onEnter(254) {
  setPStat(PStat(254), 0);
  callSubroutine(25);
  if (trigger(236)) {
    return;
  }
  roll(pstat: PStat.RollScratch, max: 99);
  {
    if (pstat[110] <= 29) {
      spawnItem(Item.GiantMeat, x: 33, y: 49);
      break;
    }
    if (pstat[110] > 49) break;
    spawnItem(Item.OffenseDisk, x: 33, y: 49);
  }
  roll(pstat: PStat.RollScratch, max: 99);
  {
    if (pstat[110] <= 29) {
      spawnItem(Item.MPFloppy, x: 49, y: 53);
      break;
    }
    if (pstat[110] > 49) break;
    spawnItem(Item.SmallRecovery, x: 49, y: 53);
  }
  roll(pstat: PStat.RollScratch, max: 99);
  {
    if (pstat[110] <= 29) {
      spawnItem(Item.DefenseDisk, x: 67, y: 42);
      break;
    }
    if (pstat[110] > 49) break;
    spawnItem(Item.Meat, x: 67, y: 42);
  }
  roll(pstat: PStat.RollScratch, max: 99);
  {
    if (pstat[110] <= 9) {
      spawnItem(Item.PortaPotty, x: 34, y: 29);
      break;
    }
    if (pstat[110] > 29) break;
    spawnItem(Item.SpeedDisk, x: 34, y: 29);
  }
  roll(pstat: PStat.RollScratch, max: 99);
  {
    if (pstat[110] <= 9) {
      spawnItem(Item.MediumRecovery, x: 50, y: 34);
      break;
    }
    if (pstat[110] > 29) break;
    spawnItem(Item.MoldyMeat, x: 50, y: 34);
  }
  roll(pstat: PStat.RollScratch, max: 99);
  {
    if (pstat[110] <= 1) {
      spawnItem(Item.OrangeBanana, x: 49, y: 18);
      break;
    }
    if (pstat[110] <= 9) {
      spawnItem(Item.Happymushroom, x: 49, y: 18);
      break;
    }
    if (pstat[110] > 29) break;
    spawnItem(Item.Autopilot, x: 49, y: 18);
  }
  roll(pstat: PStat.RollScratch, max: 99);
  if (pstat[110] <= 4) {
    spawnItem(Item.OmniDisk, x: 65, y: 22);
    return;
  }
  if (pstat[110] <= 29) {
    spawnItem(Item.MediumMP, x: 65, y: 22);
  }
  return;
}

section(51) {
  setObjectsVisibleRange(38, 43, 1);
  if (trigger(236)) {
    return;
  }
  roll(pstat: PStat.RollScratch, max: 2);
  if (pstat[110] == 0) {
    setPStat(PStat(116), 0);
    for x in [38, 42, 43] {
      setObjectVisibility(x, 0);
    }
  }
  if (pstat[110] == 1) {
    setPStat(PStat(116), 1);
    for x in [39, 41, 43] {
      setObjectVisibility(x, 0);
    }
  }
  if (pstat[110] == 2) {
    setPStat(PStat(116), 2);
    setObjectsVisibleRange(40, 42, 0);
  }
  if (!trigger(137)) {
    setTrigger(Trigger(137));
    rotate(entity: Entity.Player, to: 2048);
    sfx(8, 0, wait: 20);
    sfx(8, 0, wait: 20);
    sfx(8, 0, wait: 20);
    speak(Entity.System, "Trespasser Alert!\n");
    showTextbox("Trespasser Alert!\n");
    showTextbox("I will shoot!\n");
  }
  jumpAndLink(section_10);
  return;
}

section(10) {
  for id in Trigger(158)..Trigger(173) {
    unsetTrigger(id);
  }
  jumpReturn();

L1:
  if (stat[Stat.CurrentHP] == 1) {
    look(entity: Entity.Player, at: Entity.Partner);
    speak(Entity.Player, "Are you alright <ORANGE><DIGIMON><WHITE>?!\n");
    showTextbox("Let's go back.\n");
    warp(to: Map.TROP06, spawn: 0, trigger: 51);
  }
  jumpReturn();

L2:
  if (stat[Stat.CurrentHP] == 1) {
    look(entity: Entity.Player, at: Entity.Partner);
    speak(Entity.Player, "Oh no! I gotta revive\n<ORANGE><DIGIMON><WHITE>.\n");
    warp(to: Map.TROP06, spawn: 0, trigger: 51);
  }
  jumpReturn();

L3:
  playSound(8, 1);
  setObjectVisibility(44, 0);
  setObjectVisibility(45, 0);
  spawnSpriteAtEntity(253, 11274);
  spawnSpriteAtEntity(253, 11530);
  delay(4);
  setObjectVisibility(44, 1);
  setObjectVisibility(45, 1);
  delay(4);
  setObjectVisibility(44, 0);
  setObjectVisibility(45, 0);
  spawnSpriteAtEntity(253, 11274);
  spawnSpriteAtEntity(253, 11530);
  delay(4);
  setObjectVisibility(44, 1);
  setObjectVisibility(45, 1);
  delay(4);
  setObjectVisibility(44, 0);
  setObjectVisibility(45, 0);
  spawnSpriteAtEntity(253, 11274);
  spawnSpriteAtEntity(253, 11530);
  delay(4);
  setObjectVisibility(44, 1);
  setObjectVisibility(45, 1);
  delay(10);
  jumpReturn();

L4:
  setObjectsVisibleRange(46, 48, 1);
  moveObjectTo(0, 46, 1, 0, 0, 600, 900);
  moveObjectTo(1, 47, 1, 0, 0, 600, 900);
  moveObjectTo(2, 48, 1, 0, 0, 600, 900);
  delay(1);
  jumpReturn();
}

