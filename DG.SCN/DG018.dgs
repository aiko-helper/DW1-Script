// DG018.SCN
#include "functions.dgs"
#pragma script index=18 start=0x12800 end=0x13000 headerU16=0x2c sentinelOff=0x24
#include "entities.dgs"

section onEnter(254) {
  spawnItemChance(max: 99, chance: 14, item: Item.Digimushroom, x: 37, y: 19);
  spawnItemChance(max: 99, chance: 9, item: Item.Digimushroom, x: 60, y: 72);
  spawnItemChance(max: 99, chance: 3, item: Item.BigBerry, x: 57, y: 54);
  setTrigger(Trigger(106));
  setTrigger(Trigger(105));
  return;
}

section(5) {
  speak(Entity(5), "「通すわけにはいかねえな!」<NEWLINE>");
  finishEncounter(Trigger(280));
}

section(6) {
  speak(Entity(6), "「みぐるみはいでやるぜ!」<NEWLINE>");
  finishEncounter(Trigger(280));
}

section(7) {
  speak(Entity(7), "「通すわけにはいきませんね。」<NEWLINE>");
  finishEncounter(Trigger(286));
}

section(8) {
  speak(Entity(8), "「勝とうなんて思っているとはオドロキ!」<NEWLINE>");
  finishEncounter(Trigger(286));
}

section(9) {
  speak(Entity(9), "「まるハダカにしてやろーか!」<NEWLINE>");
  finishEncounter(Trigger(280));
}

section(10) {
  speak(Entity(10), "「たたんでやる!」<NEWLINE>");
  finishEncounter(Trigger(280));
}

section(11) {
  speak(Entity(11), "「ほんま、かなわんわ!」<NEWLINE>");
  finishEncounter(Trigger(268));
}

section(12) {
  speak(Entity(12), "「いてもうたろか?」<NEWLINE>");
  finishEncounter(Trigger(268));
}

section(51) {
  warp(to: Map.MIHA02, spawn: 0, trigger: 255);
