; source: extract/DIGIMON/SCN/DG.SCN
; DG212.SCN, section 72

section_72(72):     ; len=794
  0000:  unsetTrigger 1
  0004:  setPStat 250 0
  0008:  waitForEntity 213
  000a:  callSubroutine 35
  000c:  if stat[CurrentHP] == 0 then section_72+0x102
  001a:  removeCondition Injured
  001c:  removeCondition Sick
  001e:  addStats CurrentHP 9999
  0022:  addStats CurrentMP 9999
  0026:  setDialogOwner 5
  0028:  showTextbox "Hey, don't get sick!\n"
  0056:  showTextbox "With the small bit of life\nleft, <ORANGE><DIGIMON><WHITE> was able\nto survive.\n"
  00ce:  showTextbox "You must be careful.\n"
  00fc:  waitForEntity 214
  00fe:  jump section_73+0x252
  0102:  addStats CurrentHP 9999
  0106:  addStats CurrentMP 9999
  010a:  setDialogOwner 5
  010c:  showTextbox "Oh my gosh!\nYou're back after losing.\n"
  015c:  showTextbox "With the small bit of life\nleft, <ORANGE><DIGIMON><WHITE> was able\nto survive.\n"
  01d4:  showTextbox "Maybe your things were stolen.\n"
  0216:  showTextbox "Those who lose a battle might\nhave their things stolen.\n"
  028a:  showTextbox "Stolen objects may be sold\nsomewhere. Don't give up\nfinding them!\n"
  0312:  waitForEntity 214
  0314:  jump section_73+0x252
  0318:  endSection
