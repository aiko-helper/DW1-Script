// source: extract/DIGIMON/SCN/DG.SCN
// DG212.SCN, section 72

section section_72(72) {  // len=794
    unsetTrigger(1);
    setPStat(250, 0);
    waitForEntity(213);
    callSubroutine(35);
    if (stat[Stat.CurrentHP] == 0) goto L_0102;
    removeCondition(Condition.Injured);
    removeCondition(Condition.Sick);
    addStats(Stat.CurrentHP, 9999);
    addStats(Stat.CurrentMP, 9999);
    setDialogOwner(5);
    showTextbox("Hey, don't get sick!\n");
    showTextbox("With the small bit of life\nleft, <ORANGE><DIGIMON><WHITE> was able\nto survive.\n");
    showTextbox("You must be careful.\n");
    waitForEntity(214);
    goto section_73.L_0252;
L_0102:
    addStats(Stat.CurrentHP, 9999);
    addStats(Stat.CurrentMP, 9999);
    setDialogOwner(5);
    showTextbox("Oh my gosh!\nYou're back after losing.\n");
    showTextbox("With the small bit of life\nleft, <ORANGE><DIGIMON><WHITE> was able\nto survive.\n");
    showTextbox("Maybe your things were stolen.\n");
    showTextbox("Those who lose a battle might\nhave their things stolen.\n");
    showTextbox("Stolen objects may be sold\nsomewhere. Don't give up\nfinding them!\n");
    waitForEntity(214);
    goto section_73.L_0252;
    return;
}
