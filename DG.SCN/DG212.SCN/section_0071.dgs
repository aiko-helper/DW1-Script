// source: extract/DIGIMON/SCN/DG.SCN
// DG212.SCN, section 71

section section_71(71) {  // len=610
    unsetTrigger(1);
    setPStat(250, 0);
    waitForEntity(213);
    setDialogOwner(5);
    showTextbox("It seems <ORANGE><DIGIMON><WHITE> has\nfaded away...\n");
    showTextbox("Before fading away, he gave\nbirth to a Digitama. He will\nbe reborn with his abilities.\n");
    showTextbox("Which egg do you want?\n");
    callSubroutine(29);
    fadeOutHUD();
    callDigimonSubroutine(4);
    waitForEntity(Entity.System);
    setPStat(245, 0);
    setBGM(28);
    setDialogOwner(5);
    showTextbox("You can change the name\n<ORANGE><DIGIMON><WHITE> if you want.\n");
    setDialogOwner(Entity.Player);
    setSelection(L_01f2, L_0260);
    showTextbox("I want a new name\nI'll keep his name\n");
    waitForSelectionChoice();
    return;
L_01f2:
    callSubroutine(35);
    waitForEntity(214);
    setPStat(254, 3);
    callSubroutine(32);
    setDialogOwner(5);
    showTextbox("Is <ORANGE><DIGIMON><WHITE> okay?\n");
    setDialogOwner(Entity.Player);
    setSelection(L_01f2, L_0260);
    showTextbox("I want another name\nOkay\n");
    waitForSelectionChoice();
    goto L_01f2;
L_0260:
    return;
}
