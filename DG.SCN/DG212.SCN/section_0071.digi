section_71(71):     ; len=610
  0000:  unsetTrigger 1
  0004:  pstat[250] = 0
  0008:  waitForEntity 213
  000a:  speak 5 "It seems <ORANGE><DIGIMON><WHITE> has\nfaded away...\n"
