  0100:  showTextbox "Which egg do you want?\n"
  0132:  callSubroutine 29
  0134:  fadeOutHUD
  0136:  callDigimonSubroutine 4
  0138:  waitForEntity System
  013a:  pstat[245] = 0
  013e:  setBGM 28
  0140:  speak 5 "You can change the name\n<ORANGE><DIGIMON><WHITE> if you want.\n"
  0198:  setDialogOwner Player
  019a:  setSelection section_71+0x1f2 section_71+0x260
  01a0:  showTextbox "I want a new name\nI'll keep his name\n"
  01ee:  waitForSelectionChoice
  01f0:  endSection
  01f2:  callSubroutine 35
  01f4:  waitForEntity 214
  01f6:  pstat[254] = 3
  01fa:  callSubroutine 32
  01fc:  speak 5 "Is <ORANGE><DIGIMON><WHITE> okay?\n"
