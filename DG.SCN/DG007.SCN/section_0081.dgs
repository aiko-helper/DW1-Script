    showTextbox("Will you play the Lake\nGuardian's <LIGHTBLUE>Blue Flute<WHITE>?\n");
    setDialogOwner(Entity.Player);
    setSelection(L_00ce, L_00cc);
    showTextbox("I'll play\nI won't play\n");
    waitForSelectionChoice();
    return;
L_00ca:
    return;
L_00cc:
    return;
