    delay(5);
    setDialogOwner(Entity.Player);
    showTextbox("Give us back my friend\nyou kidnapped!\n");
    setDialogOwner(5);
    showTextbox("Friend? What are you talking\nabout. Do I look like I\nwould do such a thing?\n");
    playAnimation(Entity.Player, 0);
    setDialogOwner(Entity.Player);
    showTextbox("Yeah!\n");
    setDialogOwner(5);
    showTextbox("Wow, you're correct again!\nYes, I'm the one! I did it!\n");
