    goto L_00fe;
L_002e:
    if (!trigger(12) || !trigger(13)) goto L_005c;
    setDialogOwner(6);
    showTextbox("Hey, <LIGHTBLUE><PLAYER><WHITE>!\n");
    goto L_00fe;
L_005c:
    if (!trigger(12) || !trigger(13)) goto L_008a;
    setDialogOwner(6);
    showTextbox("Hey, <LIGHTBLUE><PLAYER><WHITE>!\n");
    goto L_00fe;
L_008a:
    if (!trigger(11) && !trigger(12) && !trigger(13)) goto L_00ce;
    setDialogOwner(6);
    showTextbox("Thanks for coming!\n");
    goto L_00fe;
L_00ce:
    setDialogOwner(6);
    showTextbox("Hello, I'm Mojyamon!\n");
L_00fe:
    setPStat(254, 6);
    setPStat(249, 2);
    callSubroutine(2);
    if (!trigger(11) && !trigger(12) && !trigger(13)) goto L_0120;
    playAnimation(6, 29);
L_0120:
    if (!trigger(11) || !trigger(12)) goto L_0134;
    playAnimation(6, 30);
L_0134:
    if (!trigger(11) || !trigger(13)) goto L_0148;
    playAnimation(6, 30);
L_0148:
    if (!trigger(12) || !trigger(13)) goto L_015c;
    playAnimation(6, 30);
L_015c:
    if ((!trigger(11) ?? !trigger(12)) || !trigger(13)) goto L_0174;
    playAnimation(6, 31);
L_0174:
    if (trigger(5) && trigger(6) && trigger(7)) goto L_018a;
