; DG128.SCN
;!script index=128 start=0x5a000 end=0x5b000 headerU16=0x14 sentinelOff=0x24
;!sections onEnter section_5 section_6 section_51

onEnter:     ; len=262
  0000:  storeRandom 110 99
  0004:  if pstat[110] > 17 then onEnter+0x16
  0010:  spawnItem Digimushroom 46 61
  0016:  storeRandom 110 99
  001a:  if pstat[110] > 0 then onEnter+0x2c
  0026:  spawnItem SageFruit 60 53
  002c:  if !trigger(8) AND !trigger(9) AND !trigger(10) then onEnter+0x44
  0040:  playAnimation 5 29
  0044:  if !trigger(8) OR !trigger(9) then onEnter+0x58
  0054:  playAnimation 5 30
  0058:  if !trigger(8) OR !trigger(10) then onEnter+0x6c
  0068:  playAnimation 5 30
  006c:  if !trigger(9) OR !trigger(10) then onEnter+0x80
  007c:  playAnimation 5 30
  0080:  if (!trigger(8) ?? !trigger(9)) OR !trigger(10) then onEnter+0x98
  0094:  playAnimation 5 31
  0098:  if !trigger(11) AND !trigger(12) AND !trigger(13) then onEnter+0xb0
  00ac:  playAnimation 6 29
  00b0:  if !trigger(11) OR !trigger(12) then onEnter+0xc4
  00c0:  playAnimation 6 30
  00c4:  if !trigger(11) OR !trigger(13) then onEnter+0xd8
  00d4:  playAnimation 6 30
  00d8:  if !trigger(12) OR !trigger(13) then onEnter+0xec
  00e8:  playAnimation 6 30
  00ec:  if (!trigger(11) ?? !trigger(12)) OR !trigger(13) then onEnter+0x104
  0100:  playAnimation 6 31
  0104:  endSection
