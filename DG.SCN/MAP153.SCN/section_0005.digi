section_5(5):     ; len=2034
  0000:  speak 5 "I was waiting for you!\n"
  0034:  speak Player "Are you returning\nto your senses?\n"
  007e:  playSound 8 11
  0082:  speak 5 "I'm feeling\na little bit funky.\n"
  00c8:  speak Player "Hey,\nthis is serious, you know?\n"
  010e:  speak 5 "The factory's closed now, so\nI have lots of free time.\nI'll help you!\n"
  01a0:  speak 5 "He regained his senses, but\nhe still looks insane!\n? still looks insane!\n"
  0238:  playSound 8 11
  023c:  speak 5 "Well, excuuuuuse meeee.\nSee ya later!\n"
  028e:  jump section_5+0x292
  0292:  entityWalkTo 5 3050 -150 1
  029a:  if pstat[101] >= 3 then section_5+0x2ba
