  02aa:  delay 20
  02ae:  lookAt Player 5
  02b2:  lookAt Partner 5
  02b6:  jump section_5+0x292
  02ba:  waitForEntity 5
  02bc:  unloadEntity 5
  02be:  pstat[101] = 0
  02c2:  playSound 8 10
  02c6:  speak System "Giromon joins the city!\n"
