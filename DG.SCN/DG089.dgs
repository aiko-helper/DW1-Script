// DG089.SCN
#pragma script index=89 start=0x3f000 end=0x3f800 headerU16=0x28 sentinelOff=0x24

function speakThenStartBattleThenSetTrigger(a, b, c) {
    speak(a, b);
    startBattle();
    setTrigger(c);
}


section onEnter(254) {
    roll(pstat: 110, max: 99);
    if (pstat[110] > 11) goto L1;
    spawnItem(Item.Digimushroom, x: 72, y: 53);

L1:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 17) goto L2;
    spawnItem(Item.Digimushroom, x: 48, y: 45);

L2:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 3) goto L3;
    spawnItem(Item.IceMushroom, x: 35, y: 91);

L3:
    setTrigger(351);
    return;
}

section(5) {
    speakThenStartBattleThenSetTrigger(5, "Leave your valuables.\n", 272);
    return;
}

section(6) {
    speakThenStartBattleThenSetTrigger(6, "I'll cover you in ice!\n", 272);
    return;
}

section(7) {
    speakThenStartBattleThenSetTrigger(7, "You can't go right or left.\n", 272);
    return;
}

section(8) {
    speakThenStartBattleThenSetTrigger(8, "I'll turn you\ninto an ice sculpture!\n", 300);
    return;
}

section(9) {
    speakThenStartBattleThenSetTrigger(9, "I'll show you!\n", 300);
    return;
}

section(10) {
    speakThenStartBattleThenSetTrigger(10, "Wanna freeze to death?\n", 272);
    return;
}

section(81) {
    rotate(entity: Entity.Player, to: 2468);
    speak(Entity.System, "West: Misty Trees\nEast: Iceberg Beach\n");
    return;
}

section(53) {
    if ((cond & 0x40) == 0x01 && !trigger(133)) goto L1;
    return;

L1:
    storeDigimonType(103);
    if (pstat[103] != 3 && pstat[103] != 5 && pstat[103] != 8 && pstat[103] != 9 && pstat[103] != 47) goto L2;
    jumpToScriptSection(203, 51);

L2:
    if (pstat[103] != 19 && pstat[103] != 32 && pstat[103] != 51 && pstat[103] != 1 && pstat[103] != 2) goto L3;
    jumpToScriptSection(203, 51);

