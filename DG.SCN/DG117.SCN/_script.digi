;!sections onEnter section_5 section_6 section_7 section_8 section_9 section_10 section_11 section_12 section_51 section_52

onEnter:     ; len=94
  0000:  storeRandom 110 99
  0004:  if pstat[110] > 4 then onEnter+0x16
  0010:  spawnItem 44 35 19
  0016:  storeRandom 110 99
  001a:  if pstat[110] > 16 then onEnter+0x2c
  0026:  spawnItem 44 55 50
  002c:  storeRandom 110 99
  0030:  if pstat[110] > 6 then onEnter+0x42
  003c:  spawnItem 44 47 4
  0042:  storeRandom 110 99
  0046:  if pstat[110] > 3 then onEnter+0x58
  0052:  spawnItem 47 40 45
  0058:  setTrigger 112
  005c:  endSection
