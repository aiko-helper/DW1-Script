// source: extract/DIGIMON/SCN/DG.SCN
// DG205.SCN, section 6

section section_6(6) {  // len=8178
    setDialogOwner(6);
    showTextbox("Which shop would you want?\n");
    setDialogOwner(Entity.Player);
    setSelection(L_009a, L_108c, L_1b1e);
    showTextbox("Clinic\nTreasure Hunter\nFortune Teller\n");
    waitForSelectionChoice();
    return;
L_009a:
    setDialogOwner(6);
    showTextbox("I changed it into a hospital.\n");
    if ((cond & 0x20) == 0x01 || (cond & 0x40) == 0x01) goto L_00f0;
    goto L_0354;
L_00f0:
    setDialogOwner(6);
    showTextbox("He doesn't feel well,\ndoes he? You have to take\ncare of his health!\n");
    showTextbox("Let me treat him right away.\nFee will be discounted\nto three hundred bits.\n");
    if (money < 300) goto L_0232;
    reduceMoney(300);
    goto L_02e4;
L_0232:
    setDialogOwner(6);
    showTextbox("You don't have enough bits?!\nPay me what you can. Save\nyour money for a rainy day.\n");
    reduceMoney(300);
L_02e4:
    removeCondition(Condition.Injured);
    removeCondition(Condition.Sick);
    showTextbox("Everything is OK now.\nJust be careful from now on.\n");
    return;
L_0354:
    setDialogOwner(6);
    showTextbox("He doesn't look sick or\ninjured. What do you need?\n");
    setDialogOwner(Entity.Player);
    setSelection(L_041c, L_0cde, L_0dba);
    showTextbox("Check him out\nSell me Medicine\nNothing\n");
L_041c:
    setDialogOwner(6);
    showTextbox("OK, let me look at\nhow <ORANGE><DIGIMON><WHITE> is doing.\n");
    if (stat[Stat.Tiredness] < 80) goto L_0522;
    setDialogOwner(6);
    showTextbox("Oh no. <ORANGE><DIGIMON><WHITE>'s Tiredness\nis at a very dangerous level.\nHe has to rest right now!\n");
    goto L_06ee;
L_0522:
    if (stat[Stat.Tiredness] < 50) goto L_05bc;
    setDialogOwner(6);
    showTextbox("<ORANGE><DIGIMON><WHITE> has too much\nTiredness. He should rest\nbefore it's too late.\n");
    goto L_06ee;
L_05bc:
    if (stat[Stat.Tiredness] < 20) goto L_0654;
    setDialogOwner(6);
    showTextbox("<ORANGE><DIGIMON><WHITE> seems to be a bit\ntired. He shouldn't push\nhimself so much.\n");
    goto L_06ee;
L_0654:
    setDialogOwner(6);
    showTextbox("<ORANGE><DIGIMON><WHITE> is fine, but\nTiredness can cause all kinds\nof bad things. Be careful.\n");
L_06ee:
    setDialogOwner(6);
    showTextbox("Well, how does he feel?\n");
    if (stat[Stat.Happiness] < 100) goto L_07bc;
    setDialogOwner(6);
    showTextbox("Mentally, <ORANGE><DIGIMON><WHITE> is at\nmax relaxation. He'll\nlive for a long time.\n");
    goto L_0bd4;
L_07bc:
    if (stat[Stat.Happiness] < 70) goto L_0862;
    setDialogOwner(6);
    showTextbox("<ORANGE><DIGIMON><WHITE>'s mental state is\nexcellent. It's the sign\nof a healthy lifestyle.\n");
    goto L_0bd4;
L_0862:
    if (stat[Stat.Happiness] < 30) goto L_08fa;
    setDialogOwner(6);
    showTextbox("<ORANGE><DIGIMON><WHITE> seems to be very\nrelaxed. Did something\nnice happen to him?\n");
    goto L_0bd4;
L_08fa:
    if (stat[Stat.Happiness] < 0) goto L_09a0;
    setDialogOwner(6);
    showTextbox("I don't think <ORANGE><DIGIMON><WHITE> is\nfeeling really stressed.\nI would say he's normal.\n");
    goto L_0bd4;
L_09a0:
    if (stat[Stat.Happiness] < -20) goto L_0a22;
    setDialogOwner(6);
    showTextbox("<ORANGE><DIGIMON><WHITE> seems to be stressed\na bit. Go easy on training.\n");
    goto L_0bd4;
L_0a22:
    if (stat[Stat.Happiness] < -50) goto L_0a8e;
    setDialogOwner(6);
    showTextbox("<ORANGE><DIGIMON><WHITE> has excess stress.\nHe needs some fun.\n");
    goto L_0bd4;
L_0a8e:
    if (stat[Stat.Happiness] < -80) goto L_0b3e;
    setDialogOwner(6);
    showTextbox("<ORANGE><DIGIMON><WHITE> has too much stress\nand isn't happy. He shouldn't\npush himself so much.\n");
    goto L_0bd4;
L_0b3e:
    setDialogOwner(6);
    showTextbox("<ORANGE><DIGIMON><WHITE> has too much stress!\nIf he goes on like this,\nhe won't live long!\n");
    goto L_0bd4;
L_0bd4:
    setDialogOwner(6);
    showTextbox("Hmmm.... This is the best\nI can do for <ORANGE><DIGIMON><WHITE>.\n");
    showTextbox("Do you still need me\nfor something?\n");
    setDialogOwner(Entity.Player);
    setSelection(L_041c, L_0cde, L_0dba);
    showTextbox("Check him out\nSell me Medicine\nNothing\n");
    waitForSelectionChoice();
    return;
L_0cde:
    setDialogOwner(6);
    showTextbox("Hmmm, he should be fine.\n");
    setDialogOwner(Entity.Player);
    setSelection(L_0e2e, L_0f06, L_0dba);
    showTextbox("Bandage:    four hund bits\nMedicine: twelve hund bits\nDon't buy anything\n");
    waitForSelectionChoice();
    return;
L_0dba:
    setDialogOwner(6);
    showTextbox("When he doesn't feel well,\ncome to see me right away.\n");
    return;
L_0e2e:
    if (item[Item.Bandage] >= 1 || !trigger(0)) goto L_0e7a;
    setDialogOwner(6);
    showTextbox("You have a lot of stuff.\n");
    return;
L_0e7a:
    if (money < 400) goto L_0e98;
    reduceMoney(400);
    giveItem(Item.Bandage, 1);
    goto L_0fde;
L_0e98:
    setDialogOwner(6);
    showTextbox("You don't have enough bits.\nI can't sell you that.\n");
    return;
L_0f06:
    if (item[Item.Medicine] >= 1 || !trigger(0)) goto L_0f52;
    setDialogOwner(6);
    showTextbox("You have a lot of stuff.\n");
    return;
L_0f52:
    if (money < 1200) goto L_0f70;
    reduceMoney(1200);
    giveItem(Item.Medicine, 1);
    goto L_0fde;
L_0f70:
    setDialogOwner(6);
    showTextbox("You don't have enough bits.\nI can't sell you that.\n");
    return;
L_0fde:
    setDialogOwner(6);
    showTextbox("Do you still need me\nfor something?\n");
    setDialogOwner(Entity.Player);
    setSelection(L_041c, L_0cde, L_0dba);
    showTextbox("Check him out\nSell me Medicine\nNothing\n");
    waitForSelectionChoice();
    return;
L_108c:
    setDialogOwner(6);
    showTextbox("I changed jobs to become\nthe Treasure Hunter.\n");
    if (!trigger(178) && !trigger(178)) goto L_1102;
    goto L_16f8;
L_1102:
    setDialogOwner(6);
    showTextbox("Do you have a request for\nTreasure Hunting? Do you\nwant some information?\n");
    setDialogOwner(Entity.Player);
    setSelection(L_120c, L_144a, L_1508);
    showTextbox("Want some info\nDon't need any info\nNever mind\n");
    waitForSelectionChoice();
    goto L_1508;
L_120c:
    setDialogOwner(6);
    showTextbox("There are two courses with\ndifferent times and prices.\n");
    showTextbox("Reg:three day, one thous bits\nSpec:ten day, five thous bits\n");
    showTextbox("The chances of finding\nbetter treasure is higher\nwith the Special Plan.\n");
    showTextbox("That's about it.\nSo, what do you want to do?\n");
    setDialogOwner(6);
    setSelection(L_120c, L_144a, L_1508);
    showTextbox("Explain again\nFind treasure\nNothing\n");
    waitForSelectionChoice();
    goto L_1508;
L_144a:
    setDialogOwner(6);
    showTextbox("Choose a plan!\n");
    setDialogOwner(Entity.Player);
    setSelection(L_1534, L_15d2, L_1508);
    showTextbox("Reg:three day, one thous bits\nSpec:ten day, five thous bits\nCancel\n");
    waitForSelectionChoice();
    goto L_1508;
L_1508:
    setDialogOwner(6);
    showTextbox("OK then, goodbye.\n");
    return;
L_1534:
    if (money >= 1000) goto L_1548;
    goto L_1670;
L_1548:
    reduceMoney(1000);
    setTrigger(178);
    storeDate(30);
    setDialogOwner(6);
    showTextbox("Alright, you'll get results\nin three days. Wish me luck.\n");
    roll(pstat: 22, max: 49);
    return;
L_15d2:
    if (money >= 5000) goto L_15e6;
    goto L_1670;
L_15e6:
    reduceMoney(5000);
    setTrigger(179);
    storeDate(30);
    setDialogOwner(6);
    showTextbox("Alright, you'll get results\nin three days. Wish me luck.\n");
    roll(pstat: 23, max: 49);
    return;
L_1670:
    setDialogOwner(6);
    showTextbox("You don't have enough bits.\nI need some money to\nfind treasure.\n");
    return;
L_16f8:
    if (pstat[30] >= 3 || !trigger(178)) goto L_170c;
    goto L_1724;
L_170c:
    if (pstat[30] >= 10 || !trigger(179)) goto L_1720;
    goto L_1724;
L_1720:
    goto L_17c6;
L_1724:
    setDialogOwner(Entity.System);
    showTextbox("<YELLOW>Sign <WHITE>\nI'm looking for treasure\nright now. Please wait\na while: Drimogemon.\n");
    return;
L_17c6:
    setDialogOwner(6);
    showTextbox("You know what?\nWe got some treasure.\n");
    if (!trigger(178)) goto L_1826;
    goto L_183a;
L_1826:
