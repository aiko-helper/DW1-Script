// DG108.SCN
#include "functions.dgs"
#pragma script index=108 start=0x48800 end=0x49000 headerU16=0x2c sentinelOff=0x24
#include "entities.dgs"

section onEnter(254) {
  spawnItemChance(max: 99, chance: 11, item: Item.Digimushroom, x: 31, y: 56);
  spawnItemChance(max: 99, chance: 17, item: Item.Digimushroom, x: 55, y: 52);
  spawnItemChance(max: 99, chance: 1, item: Item.Happymushroom, x: 40, y: 80);
  return;
}

section(5) {
  speak(Entity(5), "「おじさんに、なんかよう?」<NEWLINE>");
  finishEncounter(Trigger(291));
}

section(6) {
  speak(Entity(6), "「ハハハハ…あまりあせらないことだよ。」<NEWLINE>");
  finishEncounter(Trigger(291));
}

section(7) {
  speak(Entity(7), "「のんびりしていきたまえ。」<NEWLINE>");
  finishEncounter(Trigger(291));
}

section(8) {
  speak(Entity(8), "「ひりょうにしたろーか?」<NEWLINE>");
  finishEncounter(Trigger(289));
}

section(9) {
  speak(Entity(9), "「なんじゃ、おまえ?」<NEWLINE>");
  finishEncounter(Trigger(289));
}

section(10) {
  speak(Entity(10), "「あきらめた方がみのためだ。」<NEWLINE>");
  finishEncounter(Trigger(301));
}

section(11) {
  speak(Entity(11), "「ムダなあがきはよしたまえっ!」<NEWLINE>");
  finishEncounter(Trigger(301));
}

section(51) {
  move(entity: Entity.Player, to: (2200, -2600), sprint: 0);
  if (trigger(114) || trigger(147)) {
    warp(to: Map.MIST03, spawn: 0, trigger: 255);
  }
  roll(pstat: PStat.RollScratch, max: 99);
  if (pstat[110] < 69) {
    warp(to: Map.MIST03, spawn: 0, trigger: 255);
    goto section_52;
  }
  warp(to: Map.MIST07, spawn: 0, trigger: 255);
}

section(52) {
  move(entity: Entity.Player, to: (1600, 1800), sprint: 0);
  if (trigger(114) || trigger(147)) {
    warp(to: Map.MIST04, spawn: 0, trigger: 255);
  }
  roll(pstat: PStat.RollScratch, max: 99);
  if (pstat[110] < 49) {
    warp(to: Map.MIST04, spawn: 0, trigger: 255);
  } else {
    warp(to: Map.MIST07, spawn: 0, trigger: 255);
  }
