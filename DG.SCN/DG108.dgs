L9:
    if (!trigger(246)) goto L10;
    warp(to: Map.TWNA06, spawn: 1, trigger: 255);

L10:
    warp(to: Map.TWNA05, spawn: 1, trigger: 255);

L11:
    if (!trigger(221)) goto L12;
    goto L16;
    goto L13;

L12:
    goto L13;

L13:
    if (!trigger(225)) goto L14;
    warp(to: Map.TWNA10, spawn: 1, trigger: 255);

L14:
    if (!trigger(246)) goto L15;
    warp(to: Map.TWNA09, spawn: 1, trigger: 255);

L15:
    warp(to: Map.TWNA08, spawn: 1, trigger: 255);

L16:
    if (!trigger(225)) goto L17;
    warp(to: Map.TWNA13, spawn: 1, trigger: 255);

L17:
    if (!trigger(246)) goto L18;
    warp(to: Map.TWNA12, spawn: 1, trigger: 255);

L18:
    warp(to: Map.TWNA11, spawn: 1, trigger: 255);
    return;
}

section(6) {
    speak(6, "I've been to the city. But\nit was too city-like for\nme, so I came here.\n");
    showTextbox("I modified the equipment.\nIt's better now. Train hard!\n");
    return;
}

