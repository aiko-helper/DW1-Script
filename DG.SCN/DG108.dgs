// DG108.SCN
#include "functions.dgs"
#pragma script index=108 start=0x4d000 end=0x4f000 headerU16=0x30 sentinelOff=0xfe
#include "entities.dgs"

section onEnter(254) {
  return;
}

section(81) {
  rotate(entity: Entity.Player, to: 2048);
  setTextboxOrigin(1010, 0, -975);
  callSubroutine(39);
  if (trigger(219)) {
    speak(Entity(200), "<GREEN>Training:\nBoulder Moving, revision <WHITE>\n");
  } else {
    speak(Entity(200), "<GREEN>Training:\nBoulder Moving <WHITE>\n");
  }
  {
    choice { "Begin" -> L1, "Explain" -> L2, "Quit" -> L_01fc }
    return;

L1:
    choice { "Normal" -> L3, "Bonus Try" -> L4, "Quit" -> L_01fc }
    return;

L2:
    showTextbox("Boost power by pushing\nagainst boulder. Boosts Max\nHP and Offensive Power.\n");
    choice { "Explain again" -> L2, "Begin" -> L1, "Quit" -> L_01fc }
    return;
  }
  return;

L3:
  fadeOutHUD();
  setPStat(PStat(254), 0);
  setPStat(PStat(246), 0);
  callDigimonSubroutine(214);
  callSubroutine(7);
  return;

L4:
  setTexboxMode(1, 0);
  speak(Entity.System, "<YELLOW>Slot Game <WHITE>\nUse <LIGHTBLUE><X> <WHITE>\nto match three pictures.\n");
  setPStat(PStat(254), 0);
  setPStat(PStat(246), 1);
  callDigimonSubroutine(214);
  callSubroutine(7);
  setTexboxMode(0, 0);
  return;
}

