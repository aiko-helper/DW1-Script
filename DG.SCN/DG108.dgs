section(5) {
    if (pstat[1] < 40) goto L1;
    speakThenShowTextboxThenShowTextbox("Hey, here's new info.\n", "For Fresh or In-Training\nDigimon, try to repeat\nthe same training.\n", "Something good will happen.\n");
    return;

L1:
    if (pstat[1] < 20) goto L2;
    speak(5, "Here's new info.\n");
    showTextbox("For Bonus try, if you line\nup the same pictures, his\nability is boosted greatly.\n");
    return;

L2:
    if (pstat[1] < 5) goto L3;
    speakThenShowTextboxThenShowTextbox("Oh, I was supposed to\ntalk about Techniques.\n", "Techniques that an enemy\nuses can be mastered\nif you win a battle.\n", "But Techniques are limited\nto those which can be\nadded at that time.\n");
    showTextbox("You can't master everything.\nBut battling is the fastest\nway to master Techniques.\n");
    showTextbox("You can also master them thru\ntraining, but chances are low.\n");
    showTextbox("When you get smarter, take\n<LIGHTBLUE><PLAYER><WHITE>'s classroom and you\nmay learn a Technique.\n");
    showTextbox("Chances of you learning are\nlow, so don't expect too much.\nTrain with balance!\n");
    return;

L3:
    speak(5, "Hey, I'm Koromon.\nJiji told me to tell you\nabout training.\n");
    showTextbox("Wanna ask me something?\n");
    setDialogOwner(Entity.Player);
    choice { "What training?" -> L4, "Teach me how to train" -> L5, "No, nothing" -> L6 }
    goto L6;

L4:
    speakThenShowTextboxThenShowTextbox("If you train here,\nyou can boost your\nDigimon's abilities.\n", "Training makes you tired,\nbut you'll get more out of\nit than actual battle.\n", "Also, though very rare, you\ncan master new Techniques.\n");
    showTextbox("I'll tell you more about\nTechniques next time.\n");
    return;

L5:
    speak(5, "There are six training\nstations here and they\nhave signs near by.\n");
    speakThenShowTextboxThenShowTextbox("Try pushing <LIGHTBLUE><X> <WHITE>\nin front of the sign.\n", "Read the signs, and you'll\nknow which abilities\nyou can boost.\n", "Depending on your Digimon's\nSpecialty, some abilities are\nboosted more than others.\n");
    showTextbox("You won't know for sure\nuntil you try though.\n");
    showTextbox("After 'Begin'\nchoose 'Normal' and\ntrain for one hour.\n");
    showTextbox("While training, with\n<GREEN><TRIANGLE> <WHITE>you can\nfast forward time.\n");
    showTextbox("Oh yeah, I have to tell you\nabout 'Bonus Try'.\n");
    showTextbox("If successful, Bonus Try\ngreatly boosts your power,\nbut little if you fail.\n");
    showTextbox("Try it once and you'll see.\n");
    return;

L6:
    speak(5, "Well, I'll get more new\ninfo for you soon.\n");
    return;
}

section(51) {
    move(entity: Entity.Player, to: (2200, -3000), sprint: 0);
    if (trigger(203)) goto L1;
    warp(to: Map.TWNA01, spawn: 1, trigger: 255);

L1:
    if (!trigger(220) && !trigger(214) && pstat[1] < 50) goto L2;
    goto L11;
    goto L3;

L2:
    goto L3;

L3:
    if (!trigger(221)) goto L4;
    goto L8;
    goto L5;

L4:
    goto L5;

L5:
    if (!trigger(225)) goto L6;
    warp(to: Map.TWNA04, spawn: 1, trigger: 255);

L6:
