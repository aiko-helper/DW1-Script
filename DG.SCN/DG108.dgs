// DG108.SCN
#pragma script index=108 start=0x4d000 end=0x4f000 headerU16=0x30 sentinelOff=0xfe

function setPStatThenSetPStatThenCallDigimonSubroutineThenCallSubroutineThenSetTexboxMode(a) {
    setPStat(254, a);
    setPStat(246, 1);
    callDigimonSubroutine(214);
    callSubroutine(7);
    setTexboxMode(0, 0);
}

function fadeOutHUDThenSetPStatThenSetPStatThenCallDigimonSubroutineThenCallSubroutine(a) {
    fadeOutHUD();
    setPStat(254, a);
    setPStat(246, 0);
    callDigimonSubroutine(214);
    callSubroutine(7);
}

function speakThenShowTextboxThenShowTextbox(a, b, c) {
    speak(5, a);
    showTextbox(b);
    showTextbox(c);
}


section onEnter(254) {
    return;
}

section(81) {
    rotate(entity: Entity.Player, to: 2048);
    setTextboxOrigin(1010, 0, -975);
    callSubroutine(39);
    if (!trigger(219)) goto L1;
    speak(200, "<GREEN>Training:\nBoulder Moving, revision <WHITE>\n");
    goto L2;

L1:
    speak(200, "<GREEN>Training:\nBoulder Moving <WHITE>\n");

L2:
    choice { "Begin" -> L3, "Explain" -> L4, "Quit" -> L5 }
    return;

L3:
    choice { "Normal" -> L6, "Bonus Try" -> L7, "Quit" -> L5 }
    return;

L4:
    showTextbox("Boost power by pushing\nagainst boulder. Boosts Max\nHP and Offensive Power.\n");
    choice { "Explain again" -> L4, "Begin" -> L3, "Quit" -> L5 }
    return;

L5:
    return;

L6:
    fadeOutHUDThenSetPStatThenSetPStatThenCallDigimonSubroutineThenCallSubroutine(0);
    return;

L7:
    setTexboxMode(1, 0);
    speak(Entity.System, "<YELLOW>Slot Game <WHITE>\nUse <LIGHTBLUE><X> <WHITE>\nto match three pictures.\n");
    setPStatThenSetPStatThenCallDigimonSubroutineThenCallSubroutineThenSetTexboxMode(0);
    return;
}

