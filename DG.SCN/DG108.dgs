section(5) {
  if (pstat[1] >= 40) {
    speak(Entity(5), "Hey, here's new info.\n");
    showTextbox("For Fresh or In-Training\nDigimon, try to repeat\nthe same training.\n");
    showTextbox("Something good will happen.\n");
    return;
  }
  if (pstat[1] >= 20) {
    speak(Entity(5), "Here's new info.\n");
    showTextbox("For Bonus try, if you line\nup the same pictures, his\nability is boosted greatly.\n");
    return;
  }
  if (pstat[1] >= 5) {
    speak(Entity(5), "Oh, I was supposed to\ntalk about Techniques.\n");
    showTextbox("Techniques that an enemy\nuses can be mastered\nif you win a battle.\n");
    showTextbox("But Techniques are limited\nto those which can be\nadded at that time.\n");
    showTextbox("You can't master everything.\nBut battling is the fastest\nway to master Techniques.\n");
    showTextbox("You can also master them thru\ntraining, but chances are low.\n");
    showTextbox("When you get smarter, take\n<LIGHTBLUE><PLAYER><WHITE>'s classroom and you\nmay learn a Technique.\n");
    showTextbox("Chances of you learning are\nlow, so don't expect too much.\nTrain with balance!\n");
    return;
  }
  {
    speak(Entity(5), "Hey, I'm Koromon.\nJiji told me to tell you\nabout training.\n");
    showTextbox("Wanna ask me something?\n");
    setDialogOwner(Entity.Player);
    choice { "What training?" -> L1, "Teach me how to train" -> L2, "No, nothing" -> L_0d62 }
    break;

L1:
    speak(Entity(5), "If you train here,\nyou can boost your\nDigimon's abilities.\n");
    showTextbox("Training makes you tired,\nbut you'll get more out of\nit than actual battle.\n");
    showTextbox("Also, though very rare, you\ncan master new Techniques.\n");
    showTextbox("I'll tell you more about\nTechniques next time.\n");
    return;

L2:
    speak(Entity(5), "There are six training\nstations here and they\nhave signs near by.\n");
    speak(Entity(5), "Try pushing <LIGHTBLUE><X> <WHITE>\nin front of the sign.\n");
    showTextbox("Read the signs, and you'll\nknow which abilities\nyou can boost.\n");
    showTextbox("Depending on your Digimon's\nSpecialty, some abilities are\nboosted more than others.\n");
    showTextbox("You won't know for sure\nuntil you try though.\n");
    showTextbox("After 'Begin'\nchoose 'Normal' and\ntrain for one hour.\n");
    showTextbox("While training, with\n<GREEN><TRIANGLE> <WHITE>you can\nfast forward time.\n");
    showTextbox("Oh yeah, I have to tell you\nabout 'Bonus Try'.\n");
    showTextbox("If successful, Bonus Try\ngreatly boosts your power,\nbut little if you fail.\n");
    showTextbox("Try it once and you'll see.\n");
    return;
  }
  speak(Entity(5), "Well, I'll get more new\ninfo for you soon.\n");
  return;
}

section(51) {
  move(entity: Entity.Player, to: (2200, -3000), sprint: 0);
  if (!trigger(203)) {
    warp(to: Map.TWNA01, spawn: 1, trigger: 255);
  }
  if (trigger(220) || trigger(214) || pstat[1] >= 50) goto L4; else goto L1;

L1:
  if (trigger(221)) goto L3; else goto L2;

L2:
  if (trigger(225)) {
    warp(to: Map.TWNA04, spawn: 1, trigger: 255);
  }
  if (trigger(246)) {
    warp(to: Map.TWNA03, spawn: 1, trigger: 255);
  }
  warp(to: Map.TWNA02, spawn: 1, trigger: 255);

L3:
  if (trigger(225)) {
    warp(to: Map.TWNA07, spawn: 1, trigger: 255);
  }
  if (trigger(246)) {
    warp(to: Map.TWNA06, spawn: 1, trigger: 255);
  }
  warp(to: Map.TWNA05, spawn: 1, trigger: 255);

L4:
  if (trigger(221)) goto L6; else goto L5;

L5:
  if (trigger(225)) {
    warp(to: Map.TWNA10, spawn: 1, trigger: 255);
  }
  if (trigger(246)) {
    warp(to: Map.TWNA09, spawn: 1, trigger: 255);
  }
  warp(to: Map.TWNA08, spawn: 1, trigger: 255);

L6:
  if (trigger(225)) {
    warp(to: Map.TWNA13, spawn: 1, trigger: 255);
  }
  if (trigger(246)) {
    warp(to: Map.TWNA12, spawn: 1, trigger: 255);
  }
  warp(to: Map.TWNA11, spawn: 1, trigger: 255);
  return;
}

section(6) {
  speak(Entity(6), "I've been to the city. But\nit was too city-like for\nme, so I came here.\n");
  showTextbox("I modified the equipment.\nIt's better now. Train hard!\n");
  return;
}

