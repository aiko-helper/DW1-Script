// DG126.SCN
#include "functions.dgs"
#pragma script index=126 start=0x59000 end=0x59800 headerU16=0x14 sentinelOff=0x24
#include "entities.dgs"

section onEnter(254) {
  spawnItemChance(max: 99, chance: 16, item: Item.Digimushroom, x: 49, y: 70);
  spawnItemChance(max: 99, chance: 2, item: Item.Happymushroom, x: 25, y: 68);
  return;
}

section(81) {
  look(entity: Entity(5), at: Entity.Player);
  look(entity: Entity.Player, at: Entity(5));
  if (!trigger(139)) {
    setTrigger(Trigger(139));
    playSound(8, 4);
    speak(Entity(5), "This is a Digimon Card Shop.\n");
    speak(Entity.Player, "What's a Digimon Card?\n");
    speak(Entity(5), "Everyone's collecting them.\nYou can't lose with them.\n");
    speak(Entity.Player, "Oh?\n");
    playSound(8, 4);
    speak(Entity(5), "I'll give you one free for\nstarters. It's a good one.\n");
    speak(Entity.Player, "Hey! This card's about ME!\n");
    speak(Entity.System, "Got a card of <LIGHTBLUE><PLAYER><WHITE>!\n");
    giveCard(0);
    return;
  }
  speak(Entity(5), "This is a Digimon Card Shop.\n");
  setPStat(PStat(254), 5);
  playSound(8, 4);
  speak(Entity(5), "We have really cool cards\nin stock today.\n");
  callSubroutine(15);
  loop {
    setDialogOwner(Entity.Player);
    choice { "I'll buy a card" -> L1, "I'll sell a card" -> L5, "Quit" -> L_04e0 }
    break;

L1:
    if (money >= 500) {
      choice { "Buy a pack of three" -> L2, "Buy one" -> L4, "Quit" -> L6 }
      goto L6;
      goto L2;
    }
    choice { "Buy one" -> L4, "Quit" -> L6 }
    goto L6;

L2:
    speak(Entity(5), "Five hundred bits for a pack.\nNo telling what's inside.\n");
    setDialogOwner(Entity.Player);
    choice { "I'll buy it" -> L3, "No thanks" -> L6 }
    goto L6;

L3:
    reduceMoney(500);
    callSubroutine(15);
    speak(Entity(5), "Open the pack right away.\n");
    unsetTrigger(Trigger(3));
    unsetTrigger(Trigger(4));
    callSubroutine(14);
    callSubroutine(22);
    goto L6;

L4:
    unsetTrigger(Trigger(3));
    setTrigger(Trigger(4));
    callSubroutine(14);
    callSubroutine(22);
    goto L6;

L5:
    setTrigger(Trigger(3));
    callSubroutine(14);

L6:
    speak(Entity(5), "You want something else?\n");
  }
  callSubroutine(16);
  speak(Entity(5), "Come again.\n");
  return;
}

section(82) {
  {
    look(entity: Entity(6), at: Entity.Player);
    look(entity: Entity.Player, at: Entity(6));
    playSound(8, 4);
    speak(Entity(6), "This's a Recycled Goods shop.\n");
    setDialogOwner(Entity.Player);
    choice { "I want a regular item" -> L1, "I want a recycled item" -> L2, "Next time" -> L_0120 }
    break;

L1:
    for x in [Trigger(385), Trigger(389), Trigger(406), Trigger(423)] {
      setTrigger(x);
    }
    for id in Trigger(399)..Trigger(401) {
      setTrigger(id);
    }
    unsetTrigger(Trigger(3));
    setPStat(PStat(254), 6);
    callSubroutine(8);
    for x in [Trigger(385), Trigger(389), Trigger(406), Trigger(423)] {
      unsetTrigger(x);
    }
    for id in Trigger(399)..Trigger(401) {
      unsetTrigger(id);
    }
    return;

L2:
    setTrigger(Trigger(3));
    setPStat(PStat(254), 6);
    callSubroutine(8);
    return;
  }
  return;
}

section(51) {
  if (trigger(190)) {
    return;
  }
  speak(Entity.Player, "Hey!?\n");
  panTo(x: 800, y: 4000, slowdown: 30);
  speak(Entity.Player, "It's a shop!\n");
  followEntity(Entity.Player, speed: 10);
  setTrigger(Trigger(190));
  return;
  garbage { 14 00 fe 00 14 00 51 00 42 00 52 00 44 05 33 00 66 06 ff ff 24 00 6e 63 19 00 0b 00 6e 10 18 00 2a 00 19 00 74 2c 31 00 46 00 24 00 6e 63 19 00 0b 00 6e 02 18 00 40 00 19 00 74 45 19 00 44 00 fe 00 4c 00 05 fd 4c 00 fd 05 19 00 01 00 8b 00 18 00 34 02 19 00 1c 00 8b 00 5a 00 08 04 1b 05 1a 00 82 73 82 88 82 89 82 93 81 40 82 89 82 93 81 40 82 81 81 40 82 63 82 89 82 87 82 89 82 8d 82 8f 82 8e 81 40 82 62 82 81 82 92 82 84 81 40 82 72 82 88 82 8f 82 90 81 42 0d 00 00 00 1b fd 1a 00 82 76 82 88 82 81 82 94 81 75 82 93 81 40 82 81 81 40 82 63 82 89 82 87 82 89 82 8d 82 8f 82 8e 81 40 82 62 82 81 82 92 82 84 81 48 0d 00 00 00 1b 05 1a 00 82 64 82 96 82 85 82 92 82 99 82 8f 82 8e 82 85 81 75 82 93 81 40 82 83 82 8f 82 8c 82 8c 82 85 82 83 82 94 82 89 82 8e 82 87 81 40 82 94 82 88 82 85 82 8d 81 42 0d 00 82 78 82 8f 82 95 81 40 82 83 82 81 82 8e 81 75 82 94 81 40 82 8c 82 8f 82 93 82 85 81 40 82 97 82 89 82 94 82 88 81 40 82 94 82 88 82 85 82 8d 81 42 0d 00 00 00 }
}
