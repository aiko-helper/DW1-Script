// DG126.SCN
#pragma script index=126 start=0x59000 end=0x59800 headerU16=0x14 sentinelOff=0x24

section onEnter(254) {  // len=46
    roll(pstat: 110, max: 99);
    if (pstat[110] > 16) goto L1;
    spawnItem(Item.Digimushroom, 49, 70);

L1:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 2) goto L2;
    spawnItem(Item.Happymushroom, 25, 68);

L2:
    return;
}

section(81) {  // len=1282
    look(entity: 5, at: Entity.Player);
    look(entity: Entity.Player, at: 5);
    if (trigger(139)) goto L1;
    setTrigger(139);
    playSound(8, 4);
    setDialogOwner(5);
    showTextbox("This is a Digimon Card Shop.\n");
    setDialogOwner(Entity.Player);
    showTextbox("What's a Digimon Card?\n");
    setDialogOwner(5);
    showTextbox("Everyone's collecting them.\nYou can't lose with them.\n");
    setDialogOwner(Entity.Player);
    showTextbox("Oh?\n");
    playSound(8, 4);
    setDialogOwner(5);
    showTextbox("I'll give you one free for\nstarters. It's a good one.\n");
    setDialogOwner(Entity.Player);
    showTextbox("Hey! This card's about ME!\n");
    setDialogOwner(Entity.System);
    showTextbox("Got a card of <LIGHTBLUE><PLAYER><WHITE>!\n");
    giveCard(0);
    return;

L1:
    setDialogOwner(5);
    showTextbox("This is a Digimon Card Shop.\n");
    setPStat(254, 5);
    playSound(8, 4);
    setDialogOwner(5);
    showTextbox("We have really cool cards\nin stock today.\n");
    callSubroutine(15);

L2:
    setDialogOwner(Entity.Player);
    setSelection(L3, L8, L10);
    showTextbox("I'll buy a card\nI'll sell a card\nQuit\n");
    waitForSelectionChoice();
    goto L10;

L3:
    if (money < 500) goto L4;
    setSelection(L5, L7, L9);
    showTextbox("Buy a pack of three\nBuy one\nQuit\n");
    waitForSelectionChoice();
    goto L9;
    goto L5;

L4:
    setSelection(L7, L9);
    showTextbox("Buy one\nQuit\n");
    waitForSelectionChoice();
    goto L9;

L5:
    setDialogOwner(5);
    showTextbox("Five hundred bits for a pack.\nNo telling what's inside.\n");
    setDialogOwner(Entity.Player);
    setSelection(L6, L9);
    showTextbox("I'll buy it\nNo thanks\n");
    waitForSelectionChoice();
    goto L9;

L6:
    reduceMoney(500);
    callSubroutine(15);
    setDialogOwner(5);
    showTextbox("Open the pack right away.\n");
    unsetTrigger(3);
    unsetTrigger(4);
    callSubroutine(14);
    callSubroutine(22);
    goto L9;

L7:
    unsetTrigger(3);
    setTrigger(4);
    callSubroutine(14);
    callSubroutine(22);
    goto L9;

L8:
    setTrigger(3);
    callSubroutine(14);

L9:
    setDialogOwner(5);
    showTextbox("You want something else?\n");
    goto L2;

L10:
    callSubroutine(16);
    setDialogOwner(5);
    showTextbox("Come again.\n");
    return;
}

section(82) {  // len=290
    look(entity: 6, at: Entity.Player);
    look(entity: Entity.Player, at: 6);
    playSound(8, 4);
    setDialogOwner(6);
    showTextbox("This's a Recycled Goods shop.\n");
    setDialogOwner(Entity.Player);
    setSelection(L1, L2, L3);
    showTextbox("I want a regular item\nI want a recycled item\nNext time\n");
    waitForSelectionChoice();
    goto L3;

L1:
    setTrigger(385);
    setTrigger(389);
    setTrigger(406);
    setTrigger(423);
    for id in 399..401 { setTrigger(id); }
    unsetTrigger(3);
    setPStat(254, 6);
    callSubroutine(8);
    unsetTrigger(385);
    unsetTrigger(389);
    unsetTrigger(406);
    unsetTrigger(423);
    for id in 399..401 { unsetTrigger(id); }
    return;

L2:
    setTrigger(3);
    setPStat(254, 6);
    callSubroutine(8);
    return;

L3:
    return;
}

section(51) {  // len=410
    if (!trigger(190)) goto L1;
    return;

L1:
    setDialogOwner(Entity.Player);
    showTextbox("Hey!?\n");
    moveCamera(to: (800, 4000), slowdown: 30);
    waitForEntity(200);
    setDialogOwner(Entity.Player);
    showTextbox("It's a shop!\n");
    moveCamera(to: Entity.Player, speed: 10);
    waitForEntity(200);
    setTrigger(190);
    return;
