; DG085.SCN
;!script index=85 start=0x3d000 end=0x3d800 headerU16=0x1c sentinelOff=0x24
;!sections onEnter section_5 section_6 section_7 section_8 section_51

onEnter:     ; len=46
  0000:  storeRandom 110 99
  0004:  if pstat[110] > 5 then onEnter+0x16
  0010:  spawnItem Digimushroom 41 49
  0016:  storeRandom 110 99
  001a:  if pstat[110] > 11 then onEnter+0x2c
  0026:  spawnItem Digimushroom 42 67
  002c:  endSection
