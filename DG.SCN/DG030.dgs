// DG030.SCN
#include "functions.dgs"
#pragma script index=30 start=0x1a000 end=0x1a800 headerU16=0x10 sentinelOff=0x1775
#include "entities.dgs"

section onEnter(254) {
  spawnChest(Item.OffenseChip, -582, 1062, 0, 694);
  spawnChest(Item.Medicine, -1129, 1032, 0, 695);
  return;
}

section(51) {
  if (trigger(230)) {
    goto L2;
  }
  setTrigger(Trigger(230));
  speak(Entity.Player, "'!\"\n");
  lookPairAt(Entity(5));
  followEntity(Entity(5), speed: 20);
  speak(Entity(5), "「いったいいつからこの島は変わってしまった<NEWLINE> というのか…」<NEWLINE>");
  showTextbox("「種族は日に日に離れ…記憶を失って野性化<NEWLINE> していくばかりだ……私自身もいつまで<NEWLINE> 理性をたもっていられるか…」<NEWLINE>");
  showTextbox("「このままではいけない!島の異変に気づいて<NEWLINE> もらわなくては!多少荒っぽくなるが…」<NEWLINE>");
  anim(Entity(5), Animation(28), wait: 20);
  callSubroutine(34);
  sfx(8, 4, wait: 20);
  sfx(8, 4, wait: 20);
  sfx(8, 4, wait: 10);
  move(entity: Entity.Player, to: (-1210, -193), sprint: 1);
  move(entity: Entity.Partner, to: (-1468, -473), sprint: 1);
  waitForPair();
  lookPairAt(Entity(5));
  setTrigger(Trigger(106));
  delay(20);
  anim(Entity.Player, Animation(7), wait: 20);
  speak(Entity.Player, "「やめろっ!島をメチャメチャにする気か!」<NEWLINE>");
  delay(20);
  look(entity: Entity(5), at: Entity.Player);
  speak(Entity(5), "「何だおまえは!?ジャマをするなっ!<NEWLINE> もはやこれしか手だては無いのだっ!」<NEWLINE>");
  setTrigger(Trigger(1));
  setPStat(PStat(250), 1);
  setPStat(PStat(251), 5);
  setPStat(PStat(252), 255);
  setPStat(PStat(253), 255);
  startBattle();
  unsetTrigger(Trigger(1));
  setPStat(PStat(250), 0);
  look(entity: Entity.Player, at: Entity(5));
  look(entity: Entity(5), at: Entity.Player);
  look(entity: Entity.Partner, at: Entity(5));
  speak(Entity(5), "「はぁ、はぁ、バカなことを…他に方法が<NEWLINE> あるとでも言うのか!」<NEWLINE>");
  anim(Entity.Player, Animation(7), wait: 20);
  speak(Entity.Player, "「島がメチャメチャになっちゃったら元も子も<NEWLINE> ないじゃんか!いいからちょっと聞け。」<NEWLINE>");
  speak(Entity(5), "「何だと…」<NEWLINE>");
  loop {
    anim(Entity.Player, Animation(19), wait: 20);
    speak(Entity.Player, "「俺達は、島のため、街を作っている。<NEWLINE> 島じゅうのデジモンを集めてね。」<NEWLINE>");
    showTextbox("「デジモンが団結すれば、島の危機も<NEWLINE> 何とかできるって話だからさ。」<NEWLINE>");
    speak(Entity(5), "「うむ…その考えは正しいと思う。しかし<NEWLINE> 島じゅうのデジモンを集めるなど…」<NEWLINE>");
    anim(Entity.Player, Animation(7), wait: 20);
    speak(Entity.Player, "「俺達は今それをやっている。できないことは<NEWLINE> 無いさ!」<NEWLINE>");
    speak(Entity(5), "「何なのだ…そんな壮大な話を…信じられる<NEWLINE> わけが…だが私の心は今ゆれている…<NEWLINE> おまえ達なら…やれるかもしれん…」<NEWLINE>");
    anim(Entity.Player, Animation(19), wait: 20);
    speak(Entity.Player, "「俺達を信じてくれるなら、<NEWLINE> 街へ来て欲しい。」<NEWLINE>");
    delay(20);
    speak(Entity(5), "「…分かった。私は街へ行くぞ。<NEWLINE> それが私の新たな道なのだろう!」<NEWLINE>");
    goto L1;

L1:
    loop {
      move(entity: Entity(5), to: (691, -1990), sprint: 1);
      if (pstat[101] >= 10) break;
      addPStat(PStat.LoopIterator, 1);
      delay(10);
      lookPairAt(Entity(5));
    }
    waitForEntity(Entity(5));
    unloadEntity(Entity(5));
    setPStat(PStat.LoopIterator, 0);
    playSound(8, 8);
    speak(Entity.System, "メラモンが街に参加した!!!<NEWLINE>");
    setTrigger(Trigger(209));
    addPStat(PStat(1), 2);
    followEntity(Entity.Player, speed: 10);
    return;

L2:
    if (trigger(209)) {
      return;
    }
    followEntity(Entity(5), speed: 20);
    speak(Entity(5), "「不思議だ…おまえ達がまたここへ来る…<NEWLINE> ずっとそんな気がして…<NEWLINE> 私は答えが欲しい!」<NEWLINE>");
    look(entity: Entity(5), at: Entity.Player);
    move(entity: Entity.Partner, to: Entity.Player, sprint: 1);
    waitForEntity(Entity.Partner);
    setTrigger(Trigger(1));
    setPStat(PStat(250), 1);
    setPStat(PStat(251), 5);
    setPStat(PStat(252), 255);
    setPStat(PStat(253), 255);
    startBattle();
    unsetTrigger(Trigger(1));
    setPStat(PStat(250), 0);
    look(entity: Entity.Player, at: Entity(5));
    look(entity: Entity(5), at: Entity.Player);
    look(entity: Entity.Partner, at: Entity(5));
    speak(Entity(5), "「やはり…私の負けか…」<NEWLINE>");
    speak(Entity.Player, "「聞いてほしいことがある。」<NEWLINE>");
  }
  return;
}

section(52) {
  move(entity: Entity.Player, to: (1000, -4200), sprint: 0);
  if (trigger(209)) {
    warp(to: Map.TUNN07_2, spawn: 1, trigger: 255);
  }
  warp(to: Map.TUNN07, spawn: 1, trigger: 255);
  return;
  garbage { 10 00 fe 00 10 00 33 00 2a 00 34 00 e6 06 ff ff 75 17 ba fd 00 00 26 04 00 00 b6 02 75 0e 97 fb 00 00 08 04 00 00 b7 02 fe 00 19 00 00 00 e6 00 18 00 3a 00 19 00 16 00 ee 05 1c 00 e6 00 1b fd 1a 00 81 75 81 49 81 76 0d 00 00 00 4c 00 fd 05 4c 00 fc 05 50 00 05 14 4a c8 1b 05 1a 00 81 75 82 a2 82 c1 82 bd 82 a2 82 a2 82 c2 82 a9 82 e7 82 b1 82 cc 93 87 82 cd 95 cf 82 ed 82 c1 82 c4 82 b5 82 dc 82 c1 82 bd 0d 00 81 40 82 c6 82 a2 82 a4 82 cc 82 a9 81 63 81 76 0d 00 00 00 1a 00 81 75 8e ed 91 b0 82 cd 93 fa 82 c9 93 fa 82 c9 97 a3 82 ea 81 63 8b 4c 89 af 82 f0 8e b8 82 c1 82 c4 96 ec 90 ab 89 bb 0d 00 81 40 82 b5 82 c4 82 a2 82 ad 82 ce 82 a9 82 e8 82 be 81 63 81 63 8e 84 8e a9 90 67 82 e0 82 a2 82 c2 82 dc 82 c5 0d 00 81 40 97 9d 90 ab 82 f0 }
}
