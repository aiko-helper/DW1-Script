// DG025.SCN, section 5

section section_5(5) {  // len=126
    if (pstat[17] < 3) goto L_0038;
    setDialogOwner(5);
    showTextbox("Come on, keep up!\n");
    return;
L_0038:
    setDialogOwner(5);
    showTextbox("You must be an outsider!\n");
    fadeOutHUD();
    delay(1);
    startBattle();
    setTrigger(280);
    return;
}
