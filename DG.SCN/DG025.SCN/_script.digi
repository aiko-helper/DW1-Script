; DG025.SCN
;!script index=25 start=0x17800 end=0x18000 headerU16=0x14 sentinelOff=0x1a64
;!sections onEnter section_5 section_51 section_52

onEnter:     ; len=48
  0000:  callSubroutine 26
  0002:  if pstat[17] != 3 then onEnter+0x18
  000e:  pstat[254] = 0
  0012:  callSubroutine 19
  0014:  setAutotalk 5 0
  0018:  if pstat[17] != 4 then onEnter+0x2e
  0024:  pstat[254] = 1
  0028:  callSubroutine 19
  002a:  setAutotalk 5 0
  002e:  endSection
