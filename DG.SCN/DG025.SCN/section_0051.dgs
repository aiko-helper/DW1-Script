// source: extract/DIGIMON/SCN/DG.SCN
// DG025.SCN, section 51

section section_51(51) {  // len=84
    if (pstat[17] != 3) goto L_0052;
    move(entity: Entity.Partner, to: Entity.Player, sprint: 1);
    waitForEntity(Entity.Partner);
    move(entity: Entity.Partner, to: (1200, 1583), sprint: 0);
    waitForEntity(Entity.Partner);
    setDialogOwner(Entity.System);
    showTextbox("Dumped the dirt.\n");
    setPStat(254, 1);
    callSubroutine(19);
    move(entity: Entity.Partner, to: Entity.Player, sprint: 1);
    setPStat(17, 4);
L_0052:
    return;
}
