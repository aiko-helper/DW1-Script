section onEnter(254) {
  spawnChest(Item.OmniDisk, -2663, 277, 3072, 680);
  return;
}

section(51) {
  move(entity: Entity.Player, to: (2099, -558), sprint: 0);
  warp(to: Map.MGEN02, spawn: 1, trigger: 255);
  return;
}

section(52) {
  move(entity: Entity.Player, to: (-1958, 2679), sprint: 0);
  if (!trigger(203)) {
    warp(to: Map.TWNA01, spawn: 0, trigger: 255);
  }
  {
    if (trigger(220) || trigger(214) || pstat[1] >= 50) goto L2; else break;
  }
  {
    if (trigger(221)) goto L1; else break;
  }
  if (trigger(225)) {
    warp(to: Map.TWNA04, spawn: 9, trigger: 255);
  }
  if (trigger(246)) {
    warp(to: Map.TWNA03, spawn: 9, trigger: 255);
  }
  warp(to: Map.TWNA02, spawn: 9, trigger: 255);

L1:
  if (trigger(225)) {
    warp(to: Map.TWNA07, spawn: 9, trigger: 255);
  }
  if (trigger(246)) {
    warp(to: Map.TWNA06, spawn: 9, trigger: 255);
  }
  {
    warp(to: Map.TWNA05, spawn: 9, trigger: 255);

L2:
    if (trigger(221)) goto L3; else break;
  }
  if (trigger(225)) {
    warp(to: Map.TWNA10, spawn: 9, trigger: 255);
  }
  if (trigger(246)) {
    warp(to: Map.TWNA09, spawn: 9, trigger: 255);
  }
  warp(to: Map.TWNA08, spawn: 9, trigger: 255);

L3:
  if (trigger(225)) {
    warp(to: Map.TWNA13, spawn: 9, trigger: 255);
  }
  if (trigger(246)) {
    warp(to: Map.TWNA12, spawn: 9, trigger: 255);
  }
  warp(to: Map.TWNA11, spawn: 9, trigger: 255);
  return;
}

section(5) {
  speak(Entity(5), "「おれにまかせとけ~っ!」<NEWLINE>");
  finishEncounter(Trigger(288));
}

section(6) {
  speak(Entity(6), "「この俺をたおしてからにしろ!」<NEWLINE>");
  finishEncounter(Trigger(288));
}

section(7) {
