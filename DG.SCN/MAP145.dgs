// MAP145.SCN
#include "functions.dgs"
#pragma script index=145 start=0x66000 end=0x67800 headerU16=0x14 sentinelOff=0x1b75
#include "entities.dgs"

section onEnter(254) {
  spawnChest(Item.HPChip, -857, 483, 0, 668);
  callSubroutine(43);
  if (!trigger(270)) {
    goto section_5;
  }
  return;
}

section(51) {
  move(entity: Entity.Player, to: (24, -2500), sprint: 0);
  warp(to: Map.OMOC07, spawn: 2, trigger: 255);
  return;
}

section(5) {
  if (trigger(270)) {
    playAnimation(Entity.Player, Animation(20));
    speak(Entity.Player, "Quit messing around!\n");
    speak(Entity(5), "Alright. I don't think\nI'll do it again.\n");
    return;
  }
  delay(60);
  speak(Entity.Player, "I think this is\nthe last room.\n");
  move(entity: Entity.Player, to: (14, -754), sprint: 0);
  panTo(x: 73, y: 181, slowdown: 20);
  move(entity: Entity.Player, to: (-205, -608), sprint: 0);
  move(entity: Entity.Partner, to: (195, -608), sprint: 0);
  delay(40);
  rotate(entity: Entity.Player, to: 2048);
  rotate(entity: Entity.Partner, to: 2048);
  delay(5);
  speak(Entity.System, "<YELLOW>??? <WHITE>\nWhich one?\n");
  rotate(entity: Entity.Player, to: 2560);
  delay(20);
  rotate(entity: Entity.Player, to: 1536);
  delay(20);
  rotate(entity: Entity.Player, to: 2048);
  delay(5);
  speak(Entity.Player, "That voice...sounds like\nWaruMonzaemon!\n");
  showTextbox("A big box or a small box.\nI can read your mind!\n");
  setSelection(L1, L2);
  showTextbox("Big box\nSmall box\n");

L1:
  {
    setPStat(PStat(254), 1);
    callSubroutine(44);
    delay(10);
    setObjectVisibility(0, 0);
    setObjectVisibility(1, 0);
    setPStat(PStat(247), 0);
    setPStat(PStat(248), 2);
    callSubroutine(21);
    moveObjectTo(0, 0, 1, 1, 0, 260, 117);
    moveObjectTo(1, 1, 1, 1, 0, 255, 130);
    delay(10);
    playSound(8, 14);
    moveObjectTo(0, 0, 1, 8, 0, 260, 27);
    moveObjectTo(1, 1, 1, 8, 0, 255, 40);
    delay(9);
    moveObjectTo(0, 0, 1, 13, 0, 165, 27);
    moveObjectTo(1, 1, 1, 13, 0, 160, 40);
    delay(14);
    playSound(8, 14);
    moveObjectTo(0, 0, 1, 12, 0, 165, 177);
    moveObjectTo(1, 1, 1, 12, 0, 160, 190);
    delay(13);
    speak(Entity.Player, "Huh? Aaahhhh!\n");
    setObjectVisibility(0, 1);
    setObjectVisibility(1, 1);
    setObjectsVisibleRange(13, 50, 0);
    setPStat(PStat(247), 13);
    setPStat(PStat(248), 38);
    callSubroutine(21);
    playSound(8, 15);
    anim(Entity.Player, Animation(15), wait: 20);
    setObjectsVisibleRange(13, 50, 1);
    delay(20);
    setPStat(PStat(254), 2);
    callSubroutine(44);
    setDigimon(Digimon.WaruMonzaemon, Entity(0), 0);
    move(entity: Entity(5), axis: 1, to: -2000, speed: 10);
    delay(20);
    move(entity: Entity(5), to: (-5, 41), animDuration: 2);
    delay(10);
    move(entity: Entity(5), axis: 1, to: 0, speed: 10);
    delay(20);
    speak(Entity(5), "Ha ha ha, you jerk!\nYou missed!\n");
    move(entity: Entity(5), to: (-5, 41), sprint: 0);
    waitForEntity(Entity(5));
    rotate(entity: Entity(5), to: 0);
    delay(5);
    break;

L2:
    setPStat(PStat(254), 2);
    callSubroutine(44);
    delay(40);
    setDigimon(Digimon.WaruMonzaemon, Entity(0), 0);
    move(entity: Entity(5), axis: 1, to: -2000, speed: 10);
    delay(20);
    move(entity: Entity(5), to: (-5, 41), animDuration: 2);
    delay(10);
    move(entity: Entity(5), axis: 1, to: 0, speed: 10);
    delay(20);
    speak(Entity(5), "Ohhhh, you found out!\nHe he he. Nervous?\n");
    move(entity: Entity(5), to: (-5, 41), sprint: 0);
    waitForEntity(Entity(5));
    rotate(entity: Entity(5), to: 0);
    delay(5);
    break;
  }
  speak(Entity.Player, "Darn, what's so funny?\n");
  speak(Entity(5), "Wow, don't get excited.\nWhy are you here today?\nDo you want to work for me?\n");
  anim(Entity.Player, Animation(20), wait: 5);
  speak(Entity.Player, "Give us back my friend\nyou kidnapped!\n");
  speak(Entity(5), "Friend? What are you talking\nabout. Do I look like I\nwould do such a thing?\n");
  playAnimation(Entity.Player, Animation(0));
  speak(Entity.Player, "Yeah!\n");
  speak(Entity(5), "Wow, you're correct again!\nYes, I'm the one! I did it!\n");
  showTextbox("But you know you can't\nhave him back.\nBecause I'm WaruMonzaemon.\n");
  playAnimation(Entity.Player, Animation(1));
  speak(Entity.Player, "If that's what you think,\nI'll force you!\n");
  speak(Entity(5), "Are you kidding?\nYou are going to defeat me?\n");
  showTextbox("You know what?\nYou'd better wake up and\nface reality!\n");
  setTrigger(Trigger(1));
  setPStat(PStat(250), 1);
  setPStat(PStat(251), 5);
  setPStat(PStat(252), 255);
  setPStat(PStat(253), 255);
  startBattle();
  unsetTrigger(Trigger(1));
  setPStat(PStat(250), 0);
  look(entity: Entity.Player, at: Entity(5));
  look(entity: Entity(5), at: Entity.Player);
  look(entity: Entity.Partner, at: Entity(5));
  for x in [Entity.Player, Entity.Partner, Entity(5)] {
    waitForEntity(x);
  }
  anim(Entity.Player, Animation(19), wait: 5);
  speak(Entity.Player, "Hey, give me back my\nfriend you kidnapped.\n");
  move(entity: Entity(5), to: (-5, 41), sprint: 0);
  waitForEntity(Entity(5));
  rotate(entity: Entity(5), to: 0);
  speak(Entity(5), "Ugghhh....no way!\nI can't believe it,\nI'm losing....\n");
  move(entity: Entity.Player, to: (-205, -608), sprint: 0);
  move(entity: Entity.Partner, to: (195, -608), sprint: 0);
  waitForPair();
  lookPairAt(Entity(5));
  waitForPair();
  anim(Entity.Player, Animation(20), wait: 5);
  speak(Entity.Player, "Come on!\n");
  speak(Entity(5), "Well... I guess\nI don't have choice. Here.\n");
  playAnimation(Entity.Player, Animation(0));
  playSound(8, 6);
  setObjectVisibility(0, 0);
  setObjectVisibility(1, 0);
  setPStat(PStat(247), 0);
  setPStat(PStat(248), 2);
  callSubroutine(21);
  moveObjectTo(0, 0, 1, 0, 0, 205, 147);
  moveObjectTo(1, 1, 1, 0, 0, 200, 160);
  delay(40);
  playSound(8, 14);
  moveObjectTo(0, 0, 1, 10, 0, 205, 27);
  moveObjectTo(1, 1, 1, 10, 0, 200, 40);
  delay(11);
  moveObjectTo(0, 0, 1, 13, 0, 165, 27);
  moveObjectTo(1, 1, 1, 13, 0, 160, 40);
  delay(14);
  playSound(8, 14);
  moveObjectTo(0, 0, 1, 12, 0, 165, 177);
  moveObjectTo(1, 1, 1, 12, 0, 160, 190);
  delay(13);
  speak(Entity.Player, "Huh? Wowww.... hey!\n");
  setObjectVisibility(0, 1);
  setObjectVisibility(1, 1);
  setObjectsVisibleRange(13, 50, 0);
  setPStat(PStat(247), 13);
  setPStat(PStat(248), 38);
  callSubroutine(21);
  playSound(8, 15);
  anim(Entity.Player, Animation(15), wait: 20);
  setObjectsVisibleRange(13, 50, 1);
  speak(Entity.Player, "Hey, stop goofing off,\nthat's enough!\n");
  anim(Entity.Player, Animation(7), wait: 20);
  speak(Entity(5), "Hey, don't you get the joke?\nHere. This is the one.\n");
  sfx(8, 6, wait: 20);
  setDigimon(Digimon.Hagurumon, Entity(2), 0);
  delay(10);
  speak(Entity.Player, "What is this?\nThis is a Gear.\n");
  speak(Entity(5), "Yeah, that's right.\n");
  anim(Entity.Player, Animation(16), wait: 20);
  speak(Entity.Player, "This is the friend???\n");
  speak(Entity(5), "Well, I didn't take\nanything else. Really.\n");
  speak(Entity.Player, "I guess I'll take\nthis back for now.\n");
  anim(Entity.Player, Animation(12), wait: 20);
  unloadEntity(Entity(7));
  anim(Entity.Player, Animation(20), wait: 5);
  speak(Entity.Player, "You! Don't do anything bad\nany more, alright?!\n");
  speak(Entity(5), "Alright. I don't think\nit will happen again.\n");
  playAnimation(Entity.Player, Animation(1));
  speak(Entity.Player, "Somehow I don't believe you,\nbut I have so much stuff\nto take care of.\n");
  giveItem(Item.Gear, 1);
  if (trigger(0)) {
    unsetTrigger(Trigger(3));
    speak(Entity.Player, "Oh no, I have too many\nItems. I have to\nthrow one away.\n");
    callSubroutine(0);
    callSubroutine(13);
    giveItem(Item.Gear, 1);
  }
  speak(Entity.System, "I got a <LIGHTBLUE>Gear<WHITE>!\n");
  setTrigger(Trigger(270));
  return;
}

section(6) {
  delay(10);
  anim(Entity(6), Animation(28), wait: 10);
  speak(Entity.Player, "What? Who are you?\n");
  speak(Entity(6), "Who am I? Who are you?!\n");
  rotate(entity: Entity(6), to: 1276);
  delay(5);
  rotate(entity: Entity(6), to: 2300);
  delay(5);
  rotate(entity: Entity(6), to: 3324);
  delay(5);
  rotate(entity: Entity(6), to: 252);
  delay(5);
  rotate(entity: Entity(6), to: 1276);
  delay(5);
  rotate(entity: Entity(6), to: 2300);
  delay(5);
  rotate(entity: Entity(6), to: 3324);
  delay(5);
  rotate(entity: Entity(6), to: 252);
  delay(5);
  move(entity: Entity(6), to: (20, -1041), sprint: 1);
  waitForEntity(Entity(6));
  unloadEntity(Entity(6));
  if (pstat[21] == 0) {
    setObjectVisibility(54, 0);
    move(entity: Entity.Player, to: (-126, -518), sprint: 1);
    waitForEntity(Entity.Player);
    anim(Entity.Player, Animation(12), wait: 10);
    setObjectVisibility(54, 1);
    playSound(0, 7);
    speak(Entity.System, "I got a <PINK>Dimensional\nKey Chain<WHITE>! I can hold\nup to twenty Items now.\n");
    playSound(0, 7);
    setInventorySize(20);
    setTrigger(Trigger(47));
  }
  if (pstat[21] == 4) {
    setObjectVisibility(53, 0);
    move(entity: Entity.Player, to: (-126, -518), sprint: 1);
    waitForEntity(Entity.Player);
    anim(Entity.Player, Animation(12), wait: 10);
    setObjectVisibility(53, 1);
    playSound(0, 7);
    speak(Entity.System, "I got a <PINK>Dimensional\nKey Chain<WHITE>! I can hold\nup to twenty Items now.\n");
    setInventorySize(30);
    setTrigger(Trigger(48));
    setTrigger(Trigger(253));
    addPStat(PStat(1), 1);
  }
  addPStat(PStat(21), 1);
  setTrigger(Trigger(337));
  return;
  garbage { 14 00 fe 00 14 00 33 00 34 00 05 00 42 00 06 00 ac 11 ff ff 75 1b a7 fc 00 00 e3 01 00 00 9c 02 64 2b 19 00 01 00 0e 01 18 00 32 00 19 00 16 00 42 00 fe 00 4e fd 18 00 3c f6 00 00 4b 96 02 ff fe 00 19 00 00 00 0e 01 18 00 dc 00 19 00 56 00 fd 14 1b fd 1a 00 82 70 82 95 82 89 82 94 81 40 82 8d 82 85 82 93 82 93 82 89 82 8e 82 87 81 40 82 81 82 92 82 8f 82 95 82 8e 82 84 81 49 0d 00 00 00 1b 05 1a 00 82 60 82 8c 82 92 82 89 82 87 82 88 82 94 81 42 81 40 82 68 81 40 82 84 82 8f 82 8e 81 75 82 94 81 40 82 94 82 88 82 89 82 8e 82 8b 0d 00 82 68 81 75 82 8c 82 8c 81 40 82 84 82 8f 81 40 82 89 82 94 81 40 82 81 82 87 82 81 82 89 82 8e 81 42 0d 00 00 00 fe 00 67 00 3c 00 1b fd 1a 00 82 68 81 40 82 94 82 88 82 89 82 8e 82 8b 81 40 82 94 82 88 82 89 82 93 81 40 82 89 82 93 0d 00 82 94 82 88 82 85 81 40 82 8c 82 81 82 93 82 94 81 40 82 92 82 8f 82 8f 82 8d 81 42 0d 00 00 00 4e fd 0e 00 0e fd 00 00 4f 14 49 00 b5 00 4a c8 4e fd 33 ff a0 fd 00 00 4e fc c3 00 a0 fd 00 00 67 00 28 00 4d fd 00 08 4d fc 00 08 67 00 05 00 1b ff 1a 00 01 07 81 48 81 48 81 48 81 40 01 01 0d 00 82 76 82 88 82 89 82 83 82 88 81 40 82 8f 82 8e 82 85 81 48 0d 00 00 00 4d fd 00 0a 67 00 14 00 4d fd 00 06 67 00 14 00 4d fd 00 08 67 00 05 00 1b fd 1a 00 82 73 82 88 82 81 82 94 81 40 82 96 82 8f 82 89 82 83 82 85 81 42 81 42 81 42 82 93 82 8f 82 95 82 8e 82 84 82 93 81 40 82 8c 82 89 82 8b 82 85 0d 00 82 76 82 81 82 92 82 95 82 6c 82 8f 82 8e 82 9a 82 81 82 85 82 8d 82 8f 82 8e 81 49 0d 00 00 00 1a 00 82 60 81 40 82 82 82 89 82 87 81 40 82 82 82 8f 82 98 81 40 82 8f 82 92 81 40 82 81 81 40 82 93 82 8d 82 81 82 8c 82 8c 81 40 82 82 82 8f 82 98 81 42 0d 00 82 68 81 40 82 83 82 81 82 8e 81 40 82 92 82 85 82 81 82 84 81 40 82 99 82 8f 82 95 82 92 81 40 82 8d 82 89 82 8e 82 84 81 49 0d 00 00 00 10 02 7e 02 fc 04 1a 00 82 61 82 89 82 87 81 40 82 82 82 8f 82 98 0d 00 82 72 82 8d 82 81 82 8c 82 8c 81 40 82 82 82 8f 82 98 0d 00 00 00 1e 00 fe 01 64 2c 67 00 0a 00 57 00 00 00 57 00 01 00 1e 00 f7 00 1e 00 f8