// source: extract/DIGIMON/SCN/DG.SCN
// DG093.SCN, section 52

section section_52(52) {  // len=206
    if (!trigger(322) || !trigger(220)) goto L_0014;
    goto section_5;
L_0014:
    if (trigger(323) || !trigger(324)) goto L_00cc;
    move(entity: Entity.Partner, to: (50, 1050), sprint: 0);
    waitForEntity(Entity.Partner);
    delay(10);
    look(entity: Entity.Player, at: Entity.Partner);
    setDialogOwner(Entity.Player);
    showTextbox("What is it, <ORANGE><DIGIMON><WHITE>?\nDid you find anything?\n");
    callSubroutine(50);
    delay(20);
    setDialogOwner(Entity.Player);
    showTextbox("Wow, that's great\n<ORANGE><DIGIMON><WHITE>!\n");
    setTrigger(323);
    return;
L_00cc:
    return;
}
