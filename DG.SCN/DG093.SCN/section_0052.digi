; DG093.SCN, section 52

section_52(52):     ; len=206
  0000:  if !trigger(322) OR !trigger(220) then section_52+0x14
  0010:  jump section_5
  0014:  if trigger(323) OR !trigger(324) then section_52+0xcc
  0024:  entityWalkTo Partner 50 1050 0
  002c:  waitForEntity Partner
  002e:  delay 10
  0032:  lookAt Player Partner
  0036:  speak Player "What is it, <ORANGE><DIGIMON><WHITE>?\nDid you find anything?\n"
  008c:  callSubroutine 50
  008e:  delay 20
  0092:  speak Player "Wow, that's great\n<ORANGE><DIGIMON><WHITE>!\n"
  00c6:  setTrigger 323
  00ca:  endSection
  00cc:  endSection
