// source: extract/DIGIMON/SCN/DG.SCN
// DG093.SCN, section 51

section section_51(51) {  // len=214
    if (!trigger(323)) goto L_0012;
    warp(to: Map.ICSA02, spawn: 0, trigger: 255);
    return;
L_0012:
    if (trigger(324)) goto L_00d4;
    rotate(entity: Entity.Player, to: 2048);
    delay(5);
    playAnimation(Entity.Player, 23);
    delay(5);
    setDialogOwner(Entity.Player);
    showTextbox("Wow, it looks alive!\n");
    setDialogOwner(Entity.Player);
    showTextbox("Actually, it starts to move\nwhen we move. Hold on!\n");
    playAnimation(Entity.Player, 0);
    setTrigger(324);
    return;
L_00d4:
    return;
}
