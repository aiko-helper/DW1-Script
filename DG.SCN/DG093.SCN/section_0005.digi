  00b2:  setDialogOwner 253
  00b4:  showTextbox "You came back to life.\nAlright!\n"
  00f8:  setDialogOwner 5
  00fa:  showTextbox "I'm Angemon, an angel to\nprotect you. I've awakened\nto fulfill my duty.\n"
  018e:  setDialogOwner 253
  0190:  showTextbox "What's he talking about...?\n"
  01cc:  setDialogOwner 5
  01ce:  showTextbox "I know the truth of heaven.\n"
  020a:  showTextbox "I offer my soul to follow\nearthly instructions.\n"
  026e:  setDialogOwner 253
  0270:  showTextbox "What's he talking about...?\nAre you coming to the city?\n"
  02e4:  setDialogOwner 5
  02e6:  showTextbox "Thine mission is mine duty.\nI go.\n"
  032e:  setDialogOwner 253
  0330:  showTextbox "I'm sorry, but can you\nspeak in words I understand?\n"
  039c:  setDialogOwner 5
  039e:  showTextbox "I'll go to the city, so\nyou must keep trying.\n"
  03fe:  setDialogOwner 253
  0400:  showTextbox "I see. Thanks!\n"
