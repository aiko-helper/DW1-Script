; source: ./extract/DIGIMON/SCN/DG.SCN
; DG054.SCN, section 60

section_60(60):     ; len=2038
  0000:  setDigimon Devimon 0 0
  0004:  setRotation Player 906
  0008:  entityWalkTo Partner 775 -69 1
  0010:  waitForEntity Partner
  0012:  setRotation Partner 906
  0016:  speak Player "Yum, yum....\n"
  0036:  speak 5 "Well.\n"
  0048:  lookAt 5 Player
  004c:  speak 5 "Listen to me.\n"
  006e:  speak Player "Yummy, yummy....\n"
  0096:  speak 5 "My guys don't behave anymore.\n"
  00d8:  showTextbox "I don't think they can\nremember my orders.\n"
  0132:  showTextbox "They don't understand now.\nThey should be bringing\nme my meals, but....\n"
  01c6:  speak Player "Yum, yum....\n"
  01e6:  speak 5 "While I was working,\nthey didn't bring my meals,\nso I forgot to eat.\n"
  0276:  lookAt Player 5
  027a:  speak Player "You're too wrapped up in\nyour work.\n"
  02c8:  speak 5 "I'm so embarrassed.\n"
  02f6:  speak Player "I think there's trouble\nin the mansion.\n"
  034c:  speak 5 "Any problem on the island?\nIs everyone like my men?\n"
  03ba:  speak Player "Yes, they're all\nlosing their memory.\n"
  040c:  speak 5 "Do you think someone is\nplanning this?\n"
  0460:  speak Player "Hmm?\n"
  0470:  speak 5 "What can I do?\n"
  0494:  speak Player "We're building a city to\nunite the hearts of Digimon.\n"
  0506:  showTextbox "We're looking for friends.\n"
  0540:  speak 5 "What can I do? My men\nonly have fighting skills.\n"
  05a8:  showTextbox "I can't leave them here.\n"
  05de:  speak Player "I see.\n"
  05f2:  speak 5 "Let me think about it.\nI'm very sorry.\n"
  0646:  speak Player "I'll come back again.\nDon't forget to eat.\n"
  06a2:  endSection
  06a4:  speak Player "Want to enter a match?\n"
  06d8:  speak 5 "A match? That's perfect.\nIt will refresh my men.\n"
  0740:  speak Player "So, you want to join?\n"
  0772:  speak 5 "Yes, but I still have\nsome research to do.\nI'll go there soon.\n"
