section_60:     ; len=2038
  0000:  setDigimon 6 0 0
  0004:  setRotation 253 906
  0008:  entityWalkTo 252 775 -69 1
  0010:  waitForEntity 252
  0012:  setRotation 252 906
  0016:  setDialogOwner 253
  0018:  showTextbox "Yum, yum....\n"
  0036:  setDialogOwner 5
  0038:  showTextbox "Well.\n"
  0048:  lookAt 5 253
  004c:  setDialogOwner 5
  004e:  showTextbox "Listen to me.\n"
  006e:  setDialogOwner 253
  0070:  showTextbox "Yummy, yummy....\n"
  0096:  setDialogOwner 5
  0098:  showTextbox "My guys don't behave anymore.\n"
  00d8:  showTextbox "I don't think they can\nremember my orders.\n"
  0132:  showTextbox "They don't understand now.\nThey should be bringing\nme my meals, but....\n"
  01c6:  setDialogOwner 253
  01c8:  showTextbox "Yum, yum....\n"
  01e6:  setDialogOwner 5
  01e8:  showTextbox "While I was working,\nthey didn't bring my meals,\nso I forgot to eat.\n"
  0276:  lookAt 253 5
  027a:  setDialogOwner 253
  027c:  showTextbox "You're too wrapped up in\nyour work.\n"
  02c8:  setDialogOwner 5
  02ca:  showTextbox "I'm so embarrassed.\n"
  02f6:  setDialogOwner 253
  02f8:  showTextbox "I think there's trouble\nin the mansion.\n"
  034c:  setDialogOwner 5
  034e:  showTextbox "Any problem on the island?\nIs everyone like my men?\n"
  03ba:  setDialogOwner 253
  03bc:  showTextbox "Yes, they're all\nlosing their memory.\n"
  040c:  setDialogOwner 5
  040e:  showTextbox "Do you think someone is\nplanning this?\n"
  0460:  setDialogOwner 253
  0462:  showTextbox "Hmm?\n"
  0470:  setDialogOwner 5
  0472:  showTextbox "What can I do?\n"
  0494:  setDialogOwner 253
  0496:  showTextbox "We're building a city to\nunite the hearts of Digimon.\n"
  0506:  showTextbox "We're looking for friends.\n"
  0540:  setDialogOwner 5
  0542:  showTextbox "What can I do? My men\nonly have fighting skills.\n"
  05a8:  showTextbox "I can't leave them here.\n"
  05de:  setDialogOwner 253
  05e0:  showTextbox "I see.\n"
  05f2:  setDialogOwner 5
  05f4:  showTextbox "Let me think about it.\nI'm very sorry.\n"
  0646:  setDialogOwner 253
  0648:  showTextbox "I'll come back again.\nDon't forget to eat.\n"
  06a2:  endSection
  06a4:  setDialogOwner 253
  06a6:  showTextbox "Want to enter a match?\n"
  06d8:  setDialogOwner 5
  06da:  showTextbox "A match? That's perfect.\nIt will refresh my men.\n"
  0740:  setDialogOwner 253
  0742:  showTextbox "So, you want to join?\n"
  0772:  setDialogOwner 5
  0774:  showTextbox "Yes, but I still have\nsome research to do.\nI'll go there soon.\n"
