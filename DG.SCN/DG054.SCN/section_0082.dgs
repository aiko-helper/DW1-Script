// source: extract/DIGIMON/SCN/DG.SCN
// DG054.SCN, section 82

section section_82(82) {  // len=220
    if (item[Item.MansionKey] < 1 || trigger(111)) goto L_005c;
    rotate(entity: Entity.Player, to: 2954);
    playSound(8, 3);
    setDialogOwner(Entity.System);
    showTextbox("I used the\n<LIGHTBLUE>Mansion Key<WHITE>!\n");
    setTrigger(111);
    goto L_00c2;
L_005c:
    if (item[Item.MansionKey] >= 1 || trigger(111)) goto L_00c2;
    rotate(entity: Entity.Player, to: 2954);
    playSound(8, 2);
    delay(5);
    playSound(8, 2);
    setDialogOwner(Entity.System);
    showTextbox("It doesn't open.\nIt's locked.\n");
    return;
L_00c2:
    rotate3DObject(1, 1);
    playSound(8, 1);
    delay(10);
    move(entity: Entity.Player, to: (1600, 1674), sprint: 0);
    warp(to: Map.YAKA11A, spawn: 4, trigger: 255);
    return;
}
