// DG054.SCN
#pragma script index=54 start=0x28800 end=0x2a000 headerU16=0x20 sentinelOff=0x19
#pragma sections section_0254 section_0081 section_0082 section_0084 section_0083 section_0060 section_0005

section onEnter(254) {  // len=108
    if (!trigger(110)) goto L_0010;
    setObjectVisibility(14, 1);
L_0010:
    if (!trigger(356) || trigger(358)) goto L_006a;
    delay(20);
    rotate(entity: Entity.Player, to: 1024);
    delay(5);
    moveCamera(to: (234, 211), slowdown: 30);
    waitForEntity(200);
    setDialogOwner(Entity.Player);
    showTextbox("Myotismon is gone.\n");
    setTrigger(358);
    moveCamera(to: Entity.Player, speed: 10);
    waitForEntity(200);
L_006a:
    return;
}
