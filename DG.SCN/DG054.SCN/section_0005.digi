; source: extract/DIGIMON/SCN/DG.SCN
; DG054.SCN, section 5

section_5(5):     ; len=3186
  0000:  if !trigger(226) then section_5+0x22a
  000c:  setDialogOwner 5
  000e:  showTextbox "Thanks for your help.\nI'll show you my research.\n"
  0074:  showTextbox "Sometimes, if MetalGreymon\nfades away, he'll "
  00d2:  .string "?reymon\ndigivolve into SkullGreymon.\n"  ; dead string
  011e:  showTextbox "Bakemon, Devimon and\nPhoenixmon also digivolve\nthat way.\n"
  0194:  showTextbox "I don't know who they were\nat birth. The Digivolution\nCharts don't say.\n"
  0228:  endSection
  022a:  if !trigger(266) then section_5+0x312
  0236:  setDialogOwner 5
  0238:  showTextbox "The matches have\nhelped my men.\n"
  027c:  showTextbox "A match is a good\nbreak from my research.\n"
  02d4:  setDialogOwner Player
  02d6:  showTextbox "What's the research about?\n"
  0310:  endSection
  0312:  if !trigger(205) then section_5+0x414
  031e:  setDialogOwner 5
  0320:  showTextbox "An Arena has been\nmade in the city!\n"
  036c:  setDialogOwner 5
  036e:  showTextbox "I wonder if my men\ncould help?\n"
  03b0:  setDialogOwner Player
  03b2:  showTextbox "Yes, they can be as\nforceful as they want.\n"
  040c:  setTrigger 266
  0410:  jump section_5+0x496
  0414:  setDialogOwner 5
  0416:  showTextbox "My men's condition is worse.\nIt's time to leave\nthe mansion.\n"
  0494:  endSection
  0496:  endSection
