; DG054.SCN
;!script index=54 start=0x28800 end=0x2a000 headerU16=0x20 sentinelOff=0x19
;!sections onEnter section_81 section_82 section_84 section_83 section_60 section_5

onEnter:     ; len=108
  0000:  if !trigger(110) then onEnter+0x10
  000c:  setObjectVisibility 14 1
  0010:  if !trigger(356) OR trigger(358) then onEnter+0x6a
  0020:  delay 20
  0024:  setRotation 253 1024
  0028:  delay 5
  002c:  moveCameraTo 30 234 211
  0032:  waitForEntity 200
  0034:  setDialogOwner 253
  0036:  showTextbox "Myotismon is gone.\n"
  0060:  setTrigger 358
  0064:  moveCameraToEntity 253 10
  0068:  waitForEntity 200
  006a:  endSection
