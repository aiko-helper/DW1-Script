// source: extract/DIGIMON/SCN/DG.SCN
// DG054.SCN, section 60

section section_60(60) {  // len=2038
    setDigimon(Digimon.Devimon, 0, 0);
    rotate(entity: Entity.Player, to: 906);
    move(entity: Entity.Partner, to: (775, -69), sprint: 1);
    waitForEntity(Entity.Partner);
    rotate(entity: Entity.Partner, to: 906);
    setDialogOwner(Entity.Player);
    showTextbox("Yum, yum....\n");
    setDialogOwner(5);
    showTextbox("Well.\n");
    look(entity: 5, at: Entity.Player);
    setDialogOwner(5);
    showTextbox("Listen to me.\n");
    setDialogOwner(Entity.Player);
    showTextbox("Yummy, yummy....\n");
    setDialogOwner(5);
    showTextbox("My guys don't behave anymore.\n");
    showTextbox("I don't think they can\nremember my orders.\n");
    showTextbox("They don't understand now.\nThey should be bringing\nme my meals, but....\n");
    setDialogOwner(Entity.Player);
    showTextbox("Yum, yum....\n");
    setDialogOwner(5);
    showTextbox("While I was working,\nthey didn't bring my meals,\nso I forgot to eat.\n");
    look(entity: Entity.Player, at: 5);
    setDialogOwner(Entity.Player);
    showTextbox("You're too wrapped up in\nyour work.\n");
    setDialogOwner(5);
    showTextbox("I'm so embarrassed.\n");
    setDialogOwner(Entity.Player);
    showTextbox("I think there's trouble\nin the mansion.\n");
    setDialogOwner(5);
    showTextbox("Any problem on the island?\nIs everyone like my men?\n");
    setDialogOwner(Entity.Player);
    showTextbox("Yes, they're all\nlosing their memory.\n");
    setDialogOwner(5);
    showTextbox("Do you think someone is\nplanning this?\n");
    setDialogOwner(Entity.Player);
    showTextbox("Hmm?\n");
    setDialogOwner(5);
    showTextbox("What can I do?\n");
    setDialogOwner(Entity.Player);
    showTextbox("We're building a city to\nunite the hearts of Digimon.\n");
    showTextbox("We're looking for friends.\n");
    setDialogOwner(5);
    showTextbox("What can I do? My men\nonly have fighting skills.\n");
    showTextbox("I can't leave them here.\n");
    setDialogOwner(Entity.Player);
    showTextbox("I see.\n");
    setDialogOwner(5);
    showTextbox("Let me think about it.\nI'm very sorry.\n");
    setDialogOwner(Entity.Player);
    showTextbox("I'll come back again.\nDon't forget to eat.\n");
    return;
    setDialogOwner(Entity.Player);
    showTextbox("Want to enter a match?\n");
    setDialogOwner(5);
    showTextbox("A match? That's perfect.\nIt will refresh my men.\n");
    setDialogOwner(Entity.Player);
    showTextbox("So, you want to join?\n");
    setDialogOwner(5);
    showTextbox("Yes, but I still have\nsome research to do.\nI'll go there soon.\n");
}
