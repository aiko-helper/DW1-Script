// source: extract/DIGIMON/SCN/DG.SCN
// DG054.SCN, section 81

section section_81(81) {  // len=314
    if (trigger(110)) goto L_0136;
    setDialogOwner(Entity.Player);
    showTextbox("Oh!\n");
    playAnimation(Entity.Player, 12);
    delay(20);
    setObjectVisibility(14, 1);
    giveItem(Item.MansionKey, 1);
    setDialogOwner(Entity.Player);
    showTextbox("I found a key. Maybe it'll\nopen some of those doors.\n");
    setDialogOwner(Entity.System);
    showTextbox("I used the\n<LIGHTBLUE>Mansion Key<WHITE>!\n");
    if (!trigger(0)) goto L_012e;
    setDialogOwner(Entity.Player);
    showTextbox("I gotta get rid of something.\n");
    unsetTrigger(3);
    callSubroutine(0);
    callSubroutine(13);
    giveItem(Item.MansionKey, 1);
L_012e:
    setTrigger(110);
    goto L_0138;
L_0136:
    return;
L_0138:
    return;
}
