// DG064.SCN
#include "functions.dgs"
#pragma script index=64 start=0x2f000 end=0x2f800 headerU16=0x14 sentinelOff=0x19
#include "entities.dgs"

section onEnter(254) {
  if (trigger(345)) {
    setObjectsVisibleRange(0, 2, 1);
  } else {
    setRectImpassible(62, 39, 2, 13);
  }
  if (!trigger(129)) {
    playAnimation(Entity(5), Animation(28));
    playAnimation(Entity(6), Animation(28));
  }
  return;
}

section(81) {
  look(entity: Entity.Player, at: Entity(5));
  anim(Entity.Player, Animation(19), wait: 15);
  speak(Entity.Player, "Myotismon! What happened?\n");
  playAnimation(Entity.Player, Animation(0));
  return;
}

section(6) {
  setTrigger(Trigger(44));
  if (trigger(129)) {
    look(entity: Entity(6), at: Entity.Player);
    speak(Entity(6), "Bakke!\n");
    return;
  }
  speak(Entity(6), "...\n");
  return;
}

section(5) {
  setTrigger(Trigger(44));
  if (trigger(129)) {
    look(entity: Entity(5), at: Entity.Player);
    speak(Entity(5), "I'll join you at the Arena.\nSome of my men may miss me.\n");
    return;
  }
  if (trigger(325)) {
    look(entity: Entity(5), at: Entity.Player);
    speak(Entity(5), "My men don't behave.\nSo I'll take SkullGreymon.\n");
    speak(Entity(5), "SkullGreymon isn't the same.\nHe listens to others now.\n");
    return;
  }
  speak(Entity.Player, "Myotismon, you alright?\n");
  playAnimation(Entity(5), Animation(21));
  anim(Entity(6), Animation(21), wait: 20);
  playAnimation(Entity(5), Animation(0));
  anim(Entity(6), Animation(0), wait: 10);
  look(entity: Entity(5), at: Entity.Player);
  look(entity: Entity(6), at: Entity.Player);
  delay(5);
  speak(Entity(5), "Ugghh... It's you!\nYou've rescued me again.\n");
  speak(Entity.Player, "What happened?\n");
  speak(Entity(5), "Have you seen Devimon?\n");
  speak(Entity.Player, "I have. He's mean.\n");
  speak(Entity(5), "He runied my research\nwith evil.\n");
  anim(Entity.Player, Animation(19), wait: 15);
  speak(Entity.Player, "Your research\non SkullGreymon?\n");
  playAnimation(Entity.Player, Animation(0));
  speak(Entity(5), "I was collecting bones and\nputting them together.\nI'll be more careful.\n");
  speak(Entity.Player, "That Devimon is awful.\n");
  speak(Entity(5), "I know him well.\n");
  speak(Entity.Player, "What?!\n");
  speak(Entity(5), "He was always tricky,\nbut never this bad.\n");
  showTextbox("Maybe he's being\nbrainwashed by someone.\n");
  speak(Entity.Player, "Maybe.\n");
  speak(Entity(5), "He could be part of your\ngroup if he was himself.\n");
  followEntity(Entity.Player, speed: 10);
  for x in [Trigger(129), Trigger(266), Trigger(226)] {
    setTrigger(x);
  }
  addPStat(PStat(1), 3);
  return;
  garbage { 14 00 fe 00 14 00 51 00 4e 00 06 00 9a 00 05 00 d4 00 ff ff 19 00 00 00 59 01 18 00 30 00 19 00 57 00 00 01 57 00 01 01 57 00 02 01 16 00 38 00 7c 00 3e 00 27 00 02 0d 19 00 01 00 81 00 18 00 4c 00 19 00 56 00 05 1c 56 00 06 1c fe 00 4c 00 fd 05 56 00 fd 13 67 00 0f 00 1b fd 1a 00 82 6c 82 99 82 8f 82 94 82 89 82 93 82 8d 82 8f 82 8e 81 49 81 40 82 76 82 88 82 81 82 94 81 40 82 88 82 81 82 90 82 90 82 85 82 8e 82 85 82 84 81 48 0d 00 00 00 56 00 fd 00 fe 00 1c 00 2c 00 19 00 00 00 81 00 18 00 c4 00 19 00 4c 00 06 fd 1b 06 1a 00 82 61 82 81 82 8b 82 8b 82 85 81 49 0d 00 00 00 fe 00 1b 06 1a 00 81 42 81 42 81 42 0d 00 00 00 fe 00 1c 00 2c 00 19 00 00 00 81 00 18 00 60 01 19 00 4c 00 05 fd 1b 05 1a 00 82 68 81 75 82 8c 82 8c 81 40 82 8a 82 8f 82 89 82 8e 81 40 82 99 82 8f 82 95 81 40 82 81 82 94 81 40 82 94 82 88 82 85 81 40 82 60 82 92 82 85 82 8e 82 81 81 42 0d 00 82 72 82 8f 82 8d 82 85 81 40 82 8f 82 86 81 40 82 8d 82 99 81 40 82 8d 82 85 82 8e 81 40 82 8d 82 81 82 99 81 40 82 8d 82 89 82 93 82 93 81 40 82 8d 82 85 81 42 0d 00 00 00 fe 00 19 00 00 00 45 01 18 00 4c 02 19 00 4c 00 05 fd 1b 05 1a 00 82 6c 82 99 81 40 82 8d 82 85 82 8e 81 40 82 84 82 8f 82 8e 81 75 82 94 81 40 82 82 82 85 }
}
