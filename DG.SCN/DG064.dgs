// DG064.SCN
#include "functions.dgs"
#pragma script index=64 start=0x2c800 end=0x2d000 headerU16=0x24 sentinelOff=0x24
#include "entities.dgs"

section onEnter(254) {
  spawnItemChance(max: 99, chance: 9, item: Item.Digimushroom, x: 40, y: 84);
  spawnItemChance(max: 99, chance: 5, item: Item.Digimushroom, x: 68, y: 72);
  spawnItemChance(max: 99, chance: 17, item: Item.Digimushroom, x: 39, y: 59);
  spawnItemChance(max: 99, chance: 3, item: Item.SweetNut, x: 67, y: 24);
  return;
}

section(5) {
  speak(Entity(5), "「センスはいいようだなぁ。」<NEWLINE>");
  finishEncounter(Trigger(282));
}

section(6) {
  speak(Entity(6), "「フムフム、見どころはあるかな。」<NEWLINE>");
  finishEncounter(Trigger(282));
}

section(7) {
  speak(Entity(7), "「貴様があの…。面白い!」<NEWLINE>");
  finishEncounter(Trigger(275));
}

section(8) {
  speak(Entity(8), "「これ、あげようか?クスクス…」<NEWLINE>");
  finishEncounter(Trigger(279));
}

section(9) {
  speak(Entity(9), "「キミとボクはもうトモダチだね…」<NEWLINE>");
  finishEncounter(Trigger(279));
}

section(10) {
  speak(Entity(10), "「おまえテキ?やるか?」<NEWLINE>");
  finishEncounter(Trigger(297));
}

section(51) {
  pstat[:SavedTime] = time();
  if (pstat[106] in 15..30) {
    move(entity: Entity.Player, to: (-2800, 1723), sprint: 0);
    warp(to: Map.GIAS06A, spawn: 0, trigger: 255);
  }
  move(entity: Entity.Player, to: (-2800, 1723), sprint: 0);
  warp(to: Map.GIAS06B, spawn: 0, trigger: 255);
