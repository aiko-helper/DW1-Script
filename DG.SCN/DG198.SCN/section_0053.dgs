// source: extract/DIGIMON/SCN/DG.SCN
// DG198.SCN, section 53

section section_53(53) {  // len=1576
    if (!trigger(254)) goto L_000e;
    return;
L_000e:
    look(entity: Entity.Player, at: 11);
    delay(5);
    setDialogOwner(Entity.Player);
    showTextbox("How scary! I feel it\nin my bones.\n");
    setDialogOwner(11);
    showTextbox("...\n");
    setDialogOwner(Entity.Player);
    showTextbox("Why doesn't he attack me?\n");
    setDialogOwner(11);
    showTextbox("...\n");
    setDialogOwner(Entity.Player);
    showTextbox("Don't you need to fight?\n");
    setDialogOwner(Entity.Player);
    setSelection(L_0232, L_016e);
    showTextbox("We should hurry up and go.\nWe have to test our skills.\n");
    waitForSelectionChoice();
    goto L_016e;
L_016e:
    setDialogOwner(Entity.Player);
    showTextbox("Let's go, <ORANGE><DIGIMON><WHITE>!\n");
    setTrigger(1);
    setPStat(250, 1);
    setPStat(251, 11);
    setPStat(252, 255);
    setPStat(253, 255);
    fadeOutHUD();
    delay(1);
    startBattle();
    unsetTrigger(1);
    setPStat(250, 0);
    look(entity: Entity.Player, at: 11);
    look(entity: 11, at: Entity.Player);
    look(entity: Entity.Partner, at: 11);
    setDialogOwner(11);
    showTextbox("...\n");
    goto L_01d4;
L_01d4:
    move(entity: 11, to: (0, 0), sprint: 1);
    if (pstat[101] >= 3) goto L_01fc;
    addPStat(101, 1);
    delay(20);
    look(entity: Entity.Player, at: 11);
    look(entity: Entity.Partner, at: 11);
    goto L_01d4;
L_01fc:
    waitForEntity(11);
    unloadEntity(11);
    setPStat(101, 0);
    setDialogOwner(Entity.Player);
    showTextbox("Did we win?\n");
    setTrigger(254);
    addPStat(1, 3);
    moveCamera(to: Entity.Player, speed: 15);
    waitForEntity(200);
    return;
L_0232:
    move(entity: Entity.Player, to: (43, 1754), sprint: 1, withCamera: true);
    waitForEntity(Entity.Player);
    return;
