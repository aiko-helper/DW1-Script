; DG026.SCN
;!script index=26 start=0x18000 end=0x19000 headerU16=0x28 sentinelOff=0x1a64
;!sections onEnter section_5 section_6 section_7 section_9 section_10 section_51 section_52 section_53

onEnter:     ; len=64
  0000:  callSubroutine 26
  0002:  if pstat[17] != 3 then onEnter+0x20
  000e:  pstat[254] = 0
  0012:  callSubroutine 19
  0014:  setAutotalk 5 0
  0018:  setAutotalk 6 0
  001c:  setAutotalk 7 0
  0020:  if pstat[17] != 4 then onEnter+0x3e
  002c:  pstat[254] = 1
  0030:  callSubroutine 19
  0032:  setAutotalk 5 0
  0036:  setAutotalk 6 0
  003a:  setAutotalk 7 0
  003e:  endSection
