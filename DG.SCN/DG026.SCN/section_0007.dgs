section section_7(7) {  // len=120
    if (pstat[17] < 3) goto L_003e;
    setDialogOwner(7);
    showTextbox("Don't push yourself!\n");
    return;
L_003e:
    setDialogOwner(7);
    showTextbox("Let's fight, punk!\n");
    fadeOutHUD();
    delay(1);
    startBattle();
    setTrigger(280);
    return;
}
