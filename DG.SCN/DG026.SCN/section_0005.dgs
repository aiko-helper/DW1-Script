    showTextbox("Oh, thanks so much!\n");
    return;
L_003c:
    setDialogOwner(5);
    showTextbox("What? You wanna fight?\n");
    fadeOutHUD();
    delay(1);
    startBattle();
    setTrigger(280);
    return;
}
