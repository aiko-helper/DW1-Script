section section_6(6) {  // len=96
    if (pstat[17] < 3) goto L_0038;
    setDialogOwner(6);
    showTextbox("Oh, thanks a lot!\n");
    return;
L_0038:
    setDialogOwner(6);
    showTextbox("Leave it!\n");
    fadeOutHUD();
    delay(1);
    startBattle();
    setTrigger(280);
    return;
}
