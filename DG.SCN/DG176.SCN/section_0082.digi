section_82(82):     ; len=964
  0000:  if trigger(69) then section_82+0xe
  000c:  endSection
  000e:  lookAt Player 6
  0012:  lookAt 6 Player
  0016:  speak 6 "Hi, I'm busy all the time\nrunning this shop... Not!\n"
  0084:  showTextbox "I'm kinda lazy and I won't\nbe in the shop much. \nBut I got some cool stuff.\n"
  0120:  showTextbox "Yes! 'Training Manual'!\nWith this, your training\nwill get better!\n"
  01a8:  showTextbox "It's very valuable. I'll\nsell it for fifty thous bits.\nYou'll regret not buying it.\n"
  0254:  setDialogOwner Player
  0256:  setSelection section_82+0x27c section_82+0x382
  025c:  showTextbox "Buy\nDon't buy\n"
  027c:  if money < 50000 then section_82+0x296
  028c:  reduceMoney 50000
  0292:  jump section_82+0x2d6
  0296:  speak 6 "You don't have enough bits.\n"
  02d4:  endSection
  02d6:  giveItem TrainingManual 1
  02da:  if !trigger(0) then section_82+0x342
  02e6:  speak 6 "Hmmm, you have lots of\nstuff with you.\n"
  033a:  addMoney 50000
  0340:  endSection
