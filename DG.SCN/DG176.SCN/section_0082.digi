section_82:     ; len=964
  0000:  if trigger(69) then section_82+0xe
  000c:  endSection
  000e:  lookAt 253 6
  0012:  lookAt 6 253
  0016:  setDialogOwner 6
  0018:  showTextbox "Hi, I'm busy all the time\nrunning this shop... Not!\n"
  0084:  showTextbox "I'm kinda lazy and I won't\nbe in the shop much. \nBut I got some cool stuff.\n"
  0120:  showTextbox "Yes! 'Training Manual'!\nWith this, your training\nwill get better!\n"
  01a8:  showTextbox "It's very valuable. I'll\nsell it for fifty thous bits.\nYou'll regret not buying it.\n"
  0254:  setDialogOwner 253
  0256:  setSelection section_82+0x27c section_82+0x382
  025c:  showTextbox "Buy\nDon't buy\n"
  027c:  if money < 50000 then section_82+0x296
  028c:  reduceMoney 50000
  0292:  jump section_82+0x2d6
  0296:  setDialogOwner 6
  0298:  showTextbox "You don't have enough bits.\n"
  02d4:  endSection
  02d6:  giveItem 33 1
  02da:  if !trigger(0) then section_82+0x342
  02e6:  setDialogOwner 6
  02e8:  showTextbox "Hmmm, you have lots of\nstuff with you.\n"
  033a:  addMoney 50000
  0340:  endSection
  0342:  playSound 0 5
  0346:  setDialogOwner 255
  0348:  showTextbox "I got a\n<LIGHTBLUE>Training Manual<WHITE>!\n"
  0382:  setDialogOwner 6
  0384:  showTextbox "I won't give you a discount.\n"
  03c2:  endSection
