section_7:     ; len=1220
  0000:  storeRandom 110 2
  0004:  if pstat[1] < 20 then section_7+0x214
  0010:  if pstat[110] != 0 then section_7+0x214
  001c:  setDialogOwner 7
  001e:  showTextbox "Are you having trouble\nbecause you've got\ntoo much stuff?\n"
  0096:  showTextbox "There is a place to find a\nkey chain that connects your\nbag to another dimension.\n"
  013e:  showTextbox "It increases the number of\nItems you can carry.\n"
  01a2:  showTextbox "Even if you've been to some\nplace before, look again.\n"
  0212:  endSection
  0214:  setDialogOwner 7
  0216:  showTextbox "I'll tell you the secret to\nItem buying.\n"
  026c:  showTextbox "Press the Start button\non the Item you want to\nget information for!\n"
  02f8:  showTextbox "Choose the Item with <LIGHTBLUE><X><WHITE>,\nand press <PINK><SQUARE><WHITE>, if you\nwant to buy a lot.\n"
  0382:  showTextbox "To raise or lower by ten, use\nUp or Down on Dir. Pad,\nwhile pressing <ORANGE><O><WHITE>.\n"
  041a:  showTextbox "Oh, right after digivolution,\ntry buying something.\nSomething good should happen!\n"
  04c2:  endSection
