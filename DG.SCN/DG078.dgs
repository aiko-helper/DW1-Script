// DG078.SCN
#include "functions.dgs"
#pragma script index=78 start=0x35800 end=0x36000 headerU16=0xc sentinelOff=0x1d
#include "entities.dgs"

section onEnter(254) {
  unsetTrigger(Trigger(97));
  return;
}

section(5) {
  if (!trigger(97)) {
    speak(Entity(5), "「おまえアレだろ…へっへへ…」<NEWLINE>");
    setTrigger(Trigger(1));
    startBattle();
    setTrigger(Trigger(306));
    unsetTrigger(Trigger(1));
    setTrigger(Trigger(97));
    move(entity: Entity(5), to: (-554, -1006), sprint: 0);
    waitForEntity(Entity(5));
  }
  speak(Entity(5), "「ふへへ…骨のトンネルのワキばらで…<NEWLINE> まがるんだ…」<NEWLINE>");
