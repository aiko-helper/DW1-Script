// MAP135.SCN
#include "functions.dgs"
#pragma script index=135 start=0x5f000 end=0x60800 headerU16=0x1c sentinelOff=0xfe

section onEnter(254) {
  return;
}

section(5) {
  move(entity: Entity.Player, to: (-77, 119), sprint: 0, withCamera: true);
  move(entity: Entity.Partner, to: (397, 151), sprint: 0);
  waitForEntity(Entity.Player);
  waitForEntity(Entity.Partner);
  look(entity: Entity.Player, at: 5);
  look(entity: Entity.Partner, at: 5);
  delay(10);
  moveCamera(to: (-400, 2100), slowdown: 20);
  waitForEntity(200);
  playSound(8, 1);
  speak(5, " <LIGHTBLUE><PLAYER><WHITE> and <ORANGE><DIGIMON><WHITE>,\nright? Thanks for coming\nto Volume Villa!\n");
  playAnimation(Entity.Player, 22);
  delay(20);
  speak(Entity.Player, "I'm sorry for what\nwe did to Otamamon.\n");
  playAnimation(Entity.Player, 0);
  speak(5, "Never mind.\n");
  playAnimation(Entity.Player, 23);
  delay(20);
  speak(Entity.Player, "Huh?\n");
  playAnimation(Entity.Player, 0);
  playAnimationThenDelayThenPlayAnimation_v2(5, 38);
  speak(5, "I'm grateful. I heard that\nyou've been working hard\nto save this island.\n");
  speak(Entity.Player, "You did?\n");
  speak(5, "I've been wanting to help you.\nHave you been to Misty Trees\njust north of here?\n");
  if (trigger(112)) goto L1;
  speak(Entity.Player, "Not yet.\n");

L1:
  if (!trigger(112)) goto L2;
  speak(Entity.Player, "Yes.\n");

L2:
  speak(5, "It's always foggy there.\nIt'll probably be hard\nfor you to get around.\n");
  showTextbox("But you should meet\nCherrymon, who is the\nforest chief.\n");
  if (!trigger(147)) goto L3;
  goto L4;

L3:
  playAnimation(Entity.Player, 16);
  delay(20);
  speak(Entity.Player, "Cherrymon? I've never heard\nof such a Digimon.\n");
  speak(5, "Cherrymon makes the fog\nin Misty Trees.\n");
  showTextbox("He created fog to protect\nthe forest from danger.\n");
  playAnimation(Entity.Player, 25);
  delay(20);
  speak(Entity.Player, "But that's a problem for us.\n");
  playAnimationThenDelayThenPlayAnimation_v2(5, 38);
  speak(5, "I think Cherrymon knows\nsomething about the cause\nof the island's trouble.\n");
  showTextbox("It's worth going thru\nthe fog to see him.\n");
  speak(Entity.Player, "If we can do something\nabout the fog.\n");
  speak(5, "The only one who can get rid\nof the fog is Cherrymon.\n");
  showTextbox("But here's a way to get thru.\nI'll put a spell on you.\n");
  speak(Entity.Player, "What's gonna happen?\n");
  speak(5, "You'll be able to see\nthe road even in the fog.\n");
  playAnimation(5, 0);
  playAnimation(Entity.Player, 19);
  delay(20);
  speak(Entity.Player, "Oh, that's good!\n");
  speak(5, "OK, then I'll start.\n");
  speak(5, "Ribbit, ribbit!\n");
  playAnimation(5, 31);
  playSound(8, 0);
  delay(70);
  playAnimation(5, 0);
  playAnimation(Entity.Player, 15);
  delay(30);
  speak(5, "Good. That's perfect.\nNow, go to Misty Trees.\n");
  playAnimationThenDelayThenPlayAnimation_v2(30, 55);
  setTrigger(319);
  setTrigger(114);
  moveCamera(to: Entity.Player, speed: 10);
  waitForEntity(200);
  return;

L4:
  speak(Entity.Player, "I met him.\nThe fog is gone now.\n");
  speak(5, "Wow, that's amazing! Well,\nwhat can I do to help you?\n");
  showTextbox("Okay, let me give you this.\n");
  playAnimation(5, 0);
  speak(Entity.System, "I got a\n<LIGHTBLUE>Digital Sea Bass<WHITE>!\n");
  if (!trigger(0) || item[Item.Digiseabass] >= 1) goto L5;
  speak(Entity.System, "Throw away something else.\n");
  unsetTrigger(3);
  callSubroutine(0);
  callSubroutine(13);

L5:
  giveItem(Item.Digiseabass, 1);
  speak(5, "It's a very rare thing.\nIt'll be useful to you.\n");
  playAnimation(Entity.Player, 19);
  delay(20);
  speak(Entity.Player, "Thanks. So why don't you\ncome to the city, Shogun?\n");
  speak(5, "I'm chief of a hund Gekomon\nin Geko Swamp. I'm sorry,\nbut I can't come with you.\n");
  showTextbox("But instead, I'll do\nanything I can from here.\nCome anytime you want.\n");
  playAnimationThenDelayThenPlayAnimation_v2(30, 55);
  setTrigger(319);
  moveCamera(to: Entity.Player, speed: 10);
  waitForEntity(200);
  return;
}

section(81) {
  look(entity: Entity.Player, at: 5);
  look(entity: Entity.Partner, at: 5);
  delay(10);
  moveCamera(to: (-400, 2100), slowdown: 20);
  waitForEntity(200);
  playSound(8, 1);
  storeDigimonType(103);
  if (!trigger(116) || pstat[103] == 14) goto L1;
  speak(5, "Looks like you got a problem.\nAbout the costume, right?\n");
  speak(Entity.Player, "You know about it?\n");
  speak(5, "Don't underrate me. Numemon\nwill be able to wear it.\n");
  showTextbox("Shocked? Not only that, once\nhe wears it... You won't\nbelieve... Well, try it out.\n");
  unsetTrigger(116);
  moveCamera(to: Entity.Player, speed: 10);
  waitForEntity(200);
  return;

L1:
  if (!trigger(122)) goto L3;
  setPStat(254, 5);
  callSubroutine(1);
  moveCamera(to: Entity.Player, speed: 10);
  waitForEntity(200);
  if (item[Item.AmazingRod] < 1) goto L2;
  removeItem(Item.AmazingRod, 1);
  setTrigger(46);
  speak(5, "By the way, I'll remove the\n<LIGHTBLUE>Amazing Rod <WHITE>for\nFishing from your Items.\n");
  showTextbox("It's a Special Item.\n");

L2:
  return;

L3:
  if (!trigger(319)) goto section_6;
  playSound(8, 1);
  speak(5, "Good luck!\n");
  moveCamera(to: Entity.Player, speed: 10);
  waitForEntity(200);
  return;
}

section(6) {
  if (!trigger(122)) goto L1;
  speak(6, "You can fish only at\nDragon Eye Lake.\n");
  return;

L1:
  speak(6, "Stay back, stay back!\n");
  return;
}

section(7) {
  speak(7, "Shogun is collecting\nrare Items. He used to\ncollect Items.\n");
  showTextbox("But now he's really\ninto Digimon cards.\n");
  speak(7, "If you bring a rare card,\nhe will give you\nMerit points.\n");
  speak(7, "You can collect");
  dead_string("?");
  dead_string("? card,\nMerit points and\ntrade them for Items.\n");
  setTrigger(122);
  return;
}

section(8) {
  if (trigger(205)) goto L1;
  speak(8, "Well... no, nothing. Ribbit.\n");
  return;

L1:
  speak(8, "Excuse me... I want to go to\nthe city. Ribbit!\n");
  speak(Entity.Player, "OK, but what happened?\n");
  speak(8, "I wanna fight at the Arena.\nIt seems like we,\nthe Gekomon Tribe,");
  dead_string("? Arena.\n");
  showTextbox("are looked down upon\nas country Digimon. Ribbit.\n");
  showTextbox("Yeah, we're from the country,\nbut we have our pride too!");
  dead_string("?,\nRibbit.\n");
  speak(Entity.Player, "I see how you feel.\nThen, try it. Good luck!\n");
  speak(Entity.System, "Gekomon joined the Arena!\n");
  return;
  garbage { 1c 00 fe 00 1c 00 05 00 1e 00 51 00 2c 0d 06 00 44 10 07 00 d8 10 08 00 ae 12 ff ff fe 00 52 fd b3 ff 77 00 00 00 4e fc 8d 01 97 00 00 00 4a fd 4a fc 4c 00 fd 05 4c 00 fc 05 67 00 0a 00 4f 14 70 fe 34 08 4a c8 5a 00 08 01 1b 05 1a 00 81 40 01 06 05 00 01 01 81 40 82 81 82 8e 82 84 81 40 01 0a 06 00 01 01 81 43 0d 00 82 92 82 89 82 87 82 88 82 94 81 48 81 40 82 73 82 88 82 81 82 8e 82 8b 82 93 81 40 82 86 82 8f 82 92 81 40 82 83 82 8f 82 8d 82 89 82 8e 82 87 0d 00 82 94 82 8f 81 40 82 75 82 8f 82 8c 82 95 82 8d 82 85 81 40 82 75 82 89 82 8c 82 8c 82 81 81 49 0d 00 00 00 56 00 fd 16 67 00 14 00 1b fd 1a 00 82 68 81 75 82 8d 81 40 82 93 82 8f 82 92 82 92 82 99 81 40 82 86 82 8f 82 92 81 40 82 97 82 88 82 81 82 94 0d 00 82 97 82 85 81 40 82 84 82 89 82 84 81 40 82 94 82 8f 81 40 82 6e 82 94 82 81 82 8d 82 81 82 8d 82 8f 82 8e 81 42 0d 00 00 00 56 00 fd 00 1b 05 1a 00 82 6d 82 85 82 96 82 85 82 92 81 40 82 8d 82 89 82 8e 82 84 81 42 0d 00 00 00 56 00 fd 17 67 00 14 00 1b fd 1a 00 82 67 82 95 82 88 81 48 0d 00 00 00 56 00 fd 00 56 00 05 05 67 00 26 00 56 00 05 00 1b 05 1a 00 82 68 81 75 82 8d 81 40 82 87 82 92 82 81 82 94 82 85 82 86 82 95 82 8c 81 42 81 40 82 68 81 40 82 88 82 85 82 81 82 92 82 84 81 40 82 94 82 88 82 81 82 94 0d 00 82 99 82 8f 82 95 81 75 82 96 82 85 81 40 82 82 82 85 82 85 82 8e 81 40 82 97 82 8f 82 92 82 8b 82 89 82 8e 82 87 81 40 82 88 82 81 82 92 82 84 0d 00 82 94 82 8f 81 40 82 93 82 81 82 96 82 85 81 40 82 94 82 88 82 89 82 93 81 40 82 89 82 93 82 8c 82 81 82 8e 82 84 81 42 0d 00 00 00 1b fd 1a 00 82 78 82 8f 82 95 81 40 82 84 82 89 82 84 81 48 0d 00 00 00 1b 05 1a 00 82 68 81 75 82 96 82 85 81 40 82 82 82 85 82 85 82 8e 81 40 82 97 82 81 82 8e 82 94 82 89 82 8e 82 87 81 40 82 94 82 8f }
}
