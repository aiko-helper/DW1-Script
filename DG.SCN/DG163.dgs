section(51) {
  move(entity: Entity.Player, to: (-470, -1970), sprint: 0);
  if (!trigger(203)) {
    warp(to: Map.TWNA01, spawn: 2, trigger: 255);
  }
  {
    if (trigger(220) || trigger(214) || pstat[1] >= 50) goto L2; else break;
  }
  {
    if (trigger(221)) goto L1; else break;
  }
  if (trigger(225)) {
    warp(to: Map.TWNA04, spawn: 2, trigger: 255);
  }
  if (trigger(246)) {
    warp(to: Map.TWNA03, spawn: 2, trigger: 255);
  }
  warp(to: Map.TWNA02, spawn: 2, trigger: 255);

L1:
  if (trigger(225)) {
    warp(to: Map.TWNA07, spawn: 2, trigger: 255);
  }
  if (trigger(246)) {
    warp(to: Map.TWNA06, spawn: 2, trigger: 255);
  }
  {
    warp(to: Map.TWNA05, spawn: 2, trigger: 255);

L2:
    if (trigger(221)) goto L3; else break;
  }
  if (trigger(225)) {
    warp(to: Map.TWNA10, spawn: 2, trigger: 255);
  }
  if (trigger(246)) {
    warp(to: Map.TWNA09, spawn: 2, trigger: 255);
  }
  warp(to: Map.TWNA08, spawn: 2, trigger: 255);

L3:
  if (trigger(225)) {
    warp(to: Map.TWNA13, spawn: 2, trigger: 255);
  }
  if (trigger(246)) {
    warp(to: Map.TWNA12, spawn: 2, trigger: 255);
