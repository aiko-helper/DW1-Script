  warp(to: Map.TWNA11, spawn: 2, trigger: 255);
  return;
  garbage { 40 00 fe 00 40 00 36 00 7a 00 05 00 82 00 06 00 42 07 07 00 a0 0c 14 00 be 11 47 00 12 12 48 00 1a 12 49 00 22 12 55 00 2a 12 52 00 de 13 53 00 46 15 54 00 64 15 56 00 82 15 33 00 a0 15 ff ff 19 00 00 00 e7 00 40 00 f5 00 40 00 e9 00 40 00 f7 00 18 00 5c 00 19 00 57 00 07 01 19 00 00 00 cb 00 18 00 70 00 19 00 57 00 08 01 16 00 78 00 7c 00 28 00 26 00 02 02 fe 00 17 00 b2 00 37 00 fe 00 19 00 01 00 ca 00 81 00 d7 00 89 00 10 00 18 00 d2 01 19 00 19 00 00 00 c9 00 80 00 f3 00 18 00 d2 01 19 00 1b 05 1a 00 81 75 82 a8 82 a8 81 41 82 a2 82 a2 82 c6 82 b1 82 eb 82 c9 97 88 82 c4 82 ad 82 ea 82 bd 81 49 0d 00 81 40 82 a8 82 ca 82 b5 82 c9 82 b5 82 a9 82 bd 82 cc 82 df 82 c8 82 a2 91 e5 8e 96 82 c8 0d 00 81 40 97 70 82 aa 82 a0 82 e9 82 f1 82 b6 82 e1 81 42 81 76 0d 00 00 00 1b fd 1a 00 81 75 89 bd 81 48 81 76 0d 00 00 00 1b 05 1a 00 81 75 8d a1 81 41 82 dc 82 bd 83 41 83 69 83 8d 83 4f 83 7d 83 93 82 c6 83 80 83 51 83 93 83 68 83 89 83 82 83 93 0d 00 81 40 82 c6 93 af 82 b6 8e d7 94 4f 82 f0 8a b4 82 b6 82 bd 82 f1 82 b6 82 e1 81 42 0d 00 81 40 82 e2 82 cd }
