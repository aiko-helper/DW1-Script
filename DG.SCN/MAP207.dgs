// MAP207.SCN
#include "functions.dgs"
#pragma script index=207 start=0x9b000 end=0x9b800 headerU16=0xc sentinelOff=0x24
#include "entities.dgs"

section onEnter(254) {
  spawnItemChance(max: 99, chance: 14, item: Item.Digimushroom, x: 53, y: 64);
  spawnItemChance(max: 99, chance: 14, item: Item.Digimushroom, x: 56, y: 61);
  spawnItemChance(max: 99, chance: 14, item: Item.Digimushroom, x: 60, y: 59);
  spawnItemChance(max: 99, chance: 14, item: Item.Digimushroom, x: 63, y: 55);
  spawnItemChance(max: 99, chance: 5, item: Item.Happymushroom, x: 56, y: 65);
  if (!trigger(233) && trigger(53)) {
    playAnimation(Entity(5), Animation(28));
  }
  return;
}

section(5) {
  setTrigger(Trigger(44));
  if (trigger(229)) {
    playSound(8, 9);
    speak(Entity(5), "「何かキズを治すものを<NEWLINE> 持ってきてくれたかい…?」<NEWLINE>");
    speak(Entity.Player, "「ちょっと待ってろ。えっと…」<NEWLINE>");
  } else {
    playSound(8, 9);
    speak(Entity(5), "「羽を…」<NEWLINE>");
    speak(Entity.Player, "「どうしたんだ?」<NEWLINE>");
    speak(Entity(5), "「羽を…ケガしてしまって…<NEWLINE> 何かキズを治すものを持ってないか?」<NEWLINE>");
    speak(Entity.Player, "「ひどいケガだ…!<NEWLINE> ちょっと待ってろ。えっと…」<NEWLINE>");
  }
  anim(Entity.Player, Animation(4), wait: 10);
  setTrigger(Trigger(3));
  callSubroutine(0);
  {
    if (trigger(3)) {
      speak(Entity.Player, "「今、何も無いんだった…」<NEWLINE>");
      break;
    }
    {
      if (pstat[254] == 0 || pstat[254] == 1 || pstat[254] == 2 || pstat[254] == 3) {
        callSubroutine(12);
        break;
      }
      if (pstat[254] == 7 || pstat[254] == 9 || pstat[254] == 13 || pstat[254] == 14) {
        callSubroutine(12);
        break;
        break;
      }
      speak(Entity.Player, "「だめだ、これじゃあ。」<NEWLINE>");
      goto L1;
    }
    {
      anim(Entity.Player, Animation(5), wait: 20);
      anim(Entity.Player, Animation(0), wait: 5);
      playSound(8, 9);
      speak(Entity(5), "「ふぅ…だいぶ良くなった。<NEWLINE> ありがとう。」<NEWLINE>");
      playAnimation(Entity(5), Animation(29));
      waitForEntity(Entity(5));
      speak(Entity.Player, "「もう、飛べるの?」<NEWLINE>");
      speak(Entity(5), "「…まだ長距離はどうか…」<NEWLINE>");
      speak(Entity.Player, "「そうか…そうだ、街には医院がある。<NEWLINE> そこでみてもらうといいよ。<NEWLINE> ここからそんなに遠くないし。」<NEWLINE>");
      speak(Entity(5), "「それはすごい。街のうわさは耳にして<NEWLINE> いたが、もうそんなに発展していたのか。」<NEWLINE>");
      speak(Entity.Player, "「へへ。街でゆっくり休んでいってよ。」<NEWLINE>");
      playSound(8, 9);
      speak(Entity(5), "「すまない…。必ず恩にむくいるよ。」<NEWLINE>");
      break;
    }
    loop {
      move(entity: Entity(5), to: (-93, -1821), sprint: 1);
      if (pstat[101] >= 3) break;
      addPStat(PStat.LoopIterator, 1);
      sfx(8, 0, wait: 20);
      lookPairAt(Entity(5));
    }
    waitForEntity(Entity(5));
    unloadEntity(Entity(5));
    setPStat(PStat.LoopIterator, 0);
    playSound(8, 8);
    speak(Entity.System, "ユニモンが街に参加した!!!<NEWLINE>");
    setTrigger(Trigger(233));
    addPStat(PStat(1), 2);
    goto L2;

L1:
  }
  speak(Entity.Player, "「キズをなおすもの…<NEWLINE> 何か持ってくるから待ってて。」<NEWLINE>");
  playSound(8, 9);
  speak(Entity(5), "「すまない…早いとこたのむよ…」<NEWLINE>");
  setTrigger(Trigger(229));
  goto L2;

L2:
  return;
  garbage { 0c 00 fe 00 0c 00 05 00 90 00 ff ff 24 00 6e 63 19 00 0b 00 6e 0e 18 00 22 00 19 00 74 2c 35 00 40 00 24 00 6e 63 19 00 0b 00 6e 0e 18 00 38 00 19 00 74 2c 38 00 3d 00 24 00 6e 63 19 00 0b 00 6e 0e 18 00 4e 00 19 00 74 2c 3c 00 3b 00 24 00 6e 63 19 00 0b 00 6e 0e 18 00 64 00 19 00 74 2c 3f 00 37 00 24 00 6e 63 19 00 0b 00 6e 05 18 00 7a 00 19 00 74 45 38 00 41 00 19 00 01 00 e9 00 80 00 35 00 18 00 8e 00 19 00 56 00 05 1c fe 00 1c 00 2c 00 19 00 00 00 e5 00 18 00 0a 01 19 00 5a 00 08 09 1b 05 1a 00 81 75 89 bd 82 a9 83 4c 83 59 82 f0 8e a1 82 b7 82 e0 82 cc 82 f0 0d 00 81 40 8e 9d 82 c1 82 c4 82 ab 82 c4 82 ad 82 ea 82 bd 82 a9 82 a2 81 63 81 48 81 76 0d 00 00 00 1b fd 1a 00 81 75 82 bf 82 e5 82 c1 82 c6 91 d2 82 c1 82 c4 82 eb 81 42 82 a6 82 c1 82 c6 81 63 81 76 0d 00 00 00 16 00 be 01 5a 00 08 09 1b 05 1a 00 81 75 89 48 82 f0 81 63 81 76 0d 00 00 00 1b fd 1a 00 81 75 82 c7 82 a4 82 b5 82 bd 82 f1 82 be 81 48 81 76 0d 00 00 00 1b 05 1a 00 81 75 89 48 82 f0 81 63 83 50 83 4b 82 b5 82 c4 82 b5 82 dc 82 c1 82 c4 81 63 0d 00 81 40 89 bd 82 a9 83 4c 83 59 82 f0 8e a1 82 b7 82 e0 82 cc 82 f0 8e 9d 82 c1 82 c4 82 c8 82 a2 82 a9 81 48 81 76 0d 00 00 00 1b fd 1a 00 81 75 82 d0 82 c7 82 a2 83 50 83 4b 82 be 81 63 81 49 0d 00 81 40 82 bf 82 e5 82 c1 82 c6 91 d2 82 c1 82 c4 82 eb 81 42 82 a6 82 c1 82 c6 81 63 81 76 0d 00 00 00 56 00 fd 04 67 00 0a 00 1c 00 03 00 64 00 19 00 00 00 03 00 18 00 fe 01 19 00 1b fd 1a 00 81 75 8d a1 81 41 89 bd 82 e0 96 b3 82 a2 82 f1 82 be 82 c1 82 bd 81 63 81 76 0d 00 00 00 16 00 7c 04 19 00 08 00 fe 00 48 00 fe 01 48 00 fe 02 48 00 fe 03 18 00 1c 02 19 00 64 0c 16 00 62 02 19 00 08 00 fe 07 48 00 fe 09 48 00 fe 0d 48 00 fe 0e 18 00 3e 02 19 00 64 0c 16 00 62 02 16 00 62 02 1b fd 1a 00 81 75 82 be 82 df 82 be 81 41 82 b1 82 ea 82 b6 82 e1 82 a0 81 42 81 76 0d 00 00 00 16 00 7c 04 56 00 fd 05 67 00 14 00 56 00 fd 00 67 00 05 00 5a 00 08 09 1b 05 1a 00 81 75 82 d3 82 a3 81 63 82 be 82 a2 82 d4 97 c7 82 ad 82 c8 82 c1 82 bd 81 42 0d 00 81