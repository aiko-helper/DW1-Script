// DG063.SCN
#include "functions.dgs"
#pragma script index=63 start=0x2c000 end=0x2c800 headerU16=0x1c sentinelOff=0x24
#include "entities.dgs"

section onEnter(254) {
  spawnItemChance(max: 99, chance: 9, item: Item.Digimushroom, x: 65, y: 67);
  spawnItemChance(max: 99, chance: 2, item: Item.Happymushroom, x: 57, y: 49);
  spawnItemChance(max: 99, chance: 0, item: Item.PowerIce, x: 32, y: 88);
  return;
}

section(5) {
  speak(Entity(5), "「海はいいね…」<NEWLINE>");
  finishEncounter(Trigger(275));
}

section(6) {
  speak(Entity(6), "「ジャマだぁ!」<NEWLINE>");
  finishEncounter(Trigger(275));
}

section(7) {
  speak(Entity(7), "「そうだ!いいこと教えてあげるよ…」<NEWLINE>");
  finishEncounter(Trigger(296));
}

section(8) {
  speak(Entity(8), "「なかなかどうして、やるようだ。」<NEWLINE>");
  finishEncounter(Trigger(279));
}

section(51) {
