  if (trigger(353) && pstat[30] >= 3) {
    setTrigger(Trigger(126));
  }
  if (trigger(126)) {
    warp(to: Map.MIHA04B, spawn: 1, trigger: 255);
  }
  warp(to: Map.MIHA04A, spawn: 1, trigger: 255);
