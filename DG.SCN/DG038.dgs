// DG038.SCN
#include "functions.dgs"
#pragma script index=38 start=0x1e000 end=0x1e800 headerU16=0x10 sentinelOff=0x24
#include "entities.dgs"

section onEnter(254) {
  spawnItemChance(max: 99, chance: 9, item: Item.Digimushroom, x: 76, y: 78);
  spawnItemChance(max: 99, chance: 4, item: Item.Digimushroom, x: 31, y: 68);
  spawnItemChance(max: 99, chance: 6, item: Item.Pricklypear, x: 66, y: 68);
  spawnItemChance(max: 99, chance: 2, item: Item.Happymushroom, x: 22, y: 75);
  rotate3DObject(0, 1);
  delay(20);
  return;
}

section(5) {
  if (!trigger(199) && !trigger(198)) {
  } else {
    if (!trigger(199) && trigger(198)) {
      goto L3;
    }
    if (trigger(199) && trigger(198)) {
      goto L5;
    }
    goto L6;
  }
  setTrigger(Trigger(199));
  speak(Entity(5), "「ん?てめえらだれだ?どっかいけ!」<NEWLINE>");
  anim(Entity.Player, Animation(24), wait: 15);
  speak(Entity.Player, "「なんだ、ここお前んち?」<NEWLINE>");
  playAnimation(Entity.Player, Animation(0));
  speak(Entity(5), "「おしえてはいけないんだ!」<NEWLINE>");
  speak(Entity.Player, "「……お前って見張りか何か?」<NEWLINE>");
  speak(Entity(5), "「なんだよ、やるきかよ!ぶちのめすぞ!」<NEWLINE>");
  setDialogOwner(Entity.Player);
  setSelection(L1, L2);
  showTextbox("「しょうがない、戦っとくか。」<NEWLINE>「挑発には乗らないよ。」<NEWLINE>");
  waitForSelectionChoice();
  goto L2;

L1:
  setTrigger(Trigger(1));
  setPStat(PStat(250), 1);
  setPStat(PStat(251), 5);
  setPStat(PStat(252), 255);
  setPStat(PStat(253), 255);
  startBattle();
  unsetTrigger(Trigger(1));
  setPStat(PStat(250), 0);
  speak(Entity(5), "「う、うわー!」<NEWLINE>");
  move(entity: Entity(5), to: (-356, -1058), sprint: 1);
  delay(40);
  move(entity: Entity.Player, to: (-349, -1355), sprint: 1);
  move(entity: Entity.Partner, to: (-345, -1751), sprint: 1);
  waitForPair();
  lookPairAt(Entity(5));
  move(entity: Entity(5), to: (-250, -950), sprint: 1);
  waitForEntity(Entity(5));
  unloadEntity(Entity(5));
  playSound(8, 2);
  rotate3DObject(0, 255);
  delay(40);
  sfx(8, 3, wait: 10);
  move(entity: Entity.Player, to: (-350, -1145), sprint: 1);
  move(entity: Entity.Partner, to: (-359, -1355), sprint: 1);
  speak(Entity.Player, "「しまった…!…おーい!」<NEWLINE>");
  speak(Entity.System, "<YELLOW>???モン<WHITE><NEWLINE>「ウッヒッヒッヒ…」<NEWLINE>");
  speak(Entity.Player, "「ん、誰だ?」<NEWLINE>");
  speak(Entity.System, "<YELLOW>???モン<WHITE><NEWLINE>「俺たちゃなーんにも悪いことはしてねーぜ。<NEWLINE> ひとんちに勝手に押し入るなよな!へへ。」<NEWLINE>");
  speak(Entity.Player, "「う…これは出直すしかないか。」<NEWLINE>");
  followEntity(Entity.Player, speed: 10);
  return;

L2:
  loop {
    speak(Entity.Player, "「ま、見張りがんばれよ。」<NEWLINE>");
    return;

L3:
    speak(Entity.Player, "「ん…?おまえどこかで…。<NEWLINE> そうだ、オーガモン山賊団にいたやつだ!<NEWLINE> するとここがアジトってことか。」<NEWLINE>");
    speak(Entity(5), "「…な、なんのことかな?」<NEWLINE>");
    anim(Entity.Player, Animation(7), wait: 15);
    speak(Entity.Player, "「この前はよくも逃げてくれたな!<NEWLINE> さあ、かくごしろっ!」<NEWLINE>");
    playAnimation(Entity.Player, Animation(0));
    goto L4;

L4:
    speak(Entity(5), "「う、うわー!」<NEWLINE>");
    move(entity: Entity(5), to: (-356, -1058), sprint: 1);
    delay(40);
    move(entity: Entity.Player, to: (-349, -1375), sprint: 1);
    move(entity: Entity.Partner, to: (-355, -1761), sprint: 1);
    waitForPair();
    lookPairAt(Entity(5));
    move(entity: Entity(5), to: (-250, -930), sprint: 1);
    waitForEntity(Entity(5));
    unloadEntity(Entity(5));
    move(entity: Entity.Player, to: (-250, -930), sprint: 1);
    waitForEntity(Entity.Player);
    move(entity: Entity.Partner, to: (-250, -930), sprint: 1);
    waitForEntity(Entity.Partner);
    setTrigger(Trigger(200));
    warp(to: Map.OGRE00, spawn: 0, trigger: 255);

L5:
    speak(Entity.Player, "「この前はよくもダマシてくれたなー。<NEWLINE> アジトを移してるかと思いきや…のん気な<NEWLINE> もんだぜ!」<NEWLINE>");
    speak(Entity(5), "「…な、なんのことかな?」<NEWLINE>");
    anim(Entity.Player, Animation(7), wait: 15);
    speak(Entity.Player, "「こんどは逃がさないぞ!」<NEWLINE>");
    playAnimation(Entity.Player, Animation(0));
    goto L4;
    return;

L6:
    speak(Entity.Player, "「なぁ、中に入れてくれよー。」<NEWLINE>");
    speak(Entity(5), "「なんだよ、やるきかよ!ぶちのめすぞ!」<NEWLINE>");
    setDialogOwner(Entity.Player);
    setSelection(L1, L2);
    showTextbox("「しょうがない、戦っとくか。」<NEWLINE>「挑発には乗らないよ。」<NEWLINE>");
    waitForSelectionChoice();
  }
}

section(51) {
  if (pstat[16] == 3) {
    move(entity: Entity.Player, to: (-250, -250), sprint: 0);
    warp(to: Map.MGEN11, spawn: 0, trigger: 60);
  }
  if (trigger(200)) {
    move(entity: Entity.Player, to: (-250, -250), sprint: 0);
    warp(to: Map.OGRE00, spawn: 0, trigger: 255);
  }
  return;
  garbage { 10 00 fe 00 10 00 05 00 72 00 33 00 3a 06 ff ff 24 00 6e 63 19 00 0b 00 6e 09 18 00 26 00 19 00 74 2c 4c 00 4e 00 24 00 6e 63 19 00 0b 00 6e 04 18 00 3c 00 19 00 74 2c 1f 00 44 00 24 00 6e 63 19 00 0b 00 6e 06 18 00 52 00 19 00 74 36 42 00 44 00 24 00 6e 63 19 00 0b 00 6e 02 18 00 68 00 19 00 74 45 16 00 4b 00 70 00 00 01 67 00 14 00 fe 00 19 00 01 00 c7 00 81 00 c6 00 18 00 86 00 19 00 16 00 b2 00 19 00 01 00 c7 00 80 00 c6 00 18 00 9a 00 19 00 16 00 90 03 19 00 00 00 c7 00 80 00 c6 00 18 00 ae 00 19 00 16 00 dc 04 16 00 98 05 1c 00 c7 00 1b 05 1a 00 81 75 82 f1 81 48 82 c4 82 df 82 a6 82 e7 82 be 82 ea 82 be 81 48 82 c7 82 c1 82 a9 82 a2 82 af 81 49 81 76 0d 00 00 00 56 00 fd 18 67 00 0f 00 1b fd 1a 00 81 75 82 c8 82 f1 82 be 81 41 82 b1 82 b1 82 a8 91 4f 82 f1 82 bf 81 48 81 76 0d 00 00 00 56 00 fd 00 1b 05 1a 00 81 75 82 a8 82 b5 82 a6 82 c4 82 cd 82 a2 82 af 82 c8 82 a2 82 f1 82 be 81 49 81 76 0d 00 00 00 1b fd 1a 00 81 75 81 63 81 63 82 a8 91 4f 82 c1 82 c4 8c a9 92 a3 82 e8 82 a9 89 bd 82 a9 81 48 81 76 0d 00 00 00 1b 05 1a 00 81 75 82 c8 82 f1 82 be 82 e6 81 41 82 e2 82 e9 82 ab 82 a9 82 e6 81 49 82 d4 82 bf 82 cc 82 df 82 b7 82 bc 81 49 81 76 0d 00 00 00 1b fd 10 02 d6 01 6c 03 }
