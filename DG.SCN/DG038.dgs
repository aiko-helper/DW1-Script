// DG038.SCN
#pragma script index=38 start=0x1f800 end=0x20000 headerU16=0x2c sentinelOff=0x24

function delayThenRotate3DObjectThenDelayThenRotate3DObjectThenDelay(a, b) {
    delay(1);
    rotate3DObject(a, 1);
    delay(1);
    rotate3DObject(b, 1);
    delay(1);
}

function speakThenStartBattleThenSetTrigger(a, b, c) {
    speak(a, b);
    startBattle();
    setTrigger(c);
}


section onEnter(254) {
    roll(pstat: 110, max: 99);
    if (pstat[110] > 9) goto L1;
    spawnItem(Item.Digimushroom, x: 49, y: 64);

L1:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 14) goto L2;
    spawnItem(Item.Digimushroom, x: 19, y: 31);

L2:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 4) goto L3;
    spawnItem(Item.Pricklypear, x: 20, y: 9);

L3:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 0) goto L4;
    spawnItem(Item.DeluxeMushroom, x: 69, y: 16);

L4:
    return;
}

section(5) {
    speakThenStartBattleThenSetTrigger(5, "Would you stop that?\n", 299);
    return;
}

section(6) {
    speakThenStartBattleThenSetTrigger(6, "Shuha, shuha!\n", 302);
    return;
}

section(7) {
    speakThenStartBattleThenSetTrigger(7, "Swish!\n", 302);
    return;
}

section(8) {
    speakThenStartBattleThenSetTrigger(8, "Let's battle full on!\n", 268);
    return;
}

section(9) {
    speakThenStartBattleThenSetTrigger(9, "Whatcha talking about?\n", 268);
    return;
}

section(81) {
    speak(Entity.System, "North West: Freezeland\n");
    return;
}

section(82) {
    rotate(entity: Entity.Player, to: 2048);
    delay(5);
    speak(Entity.System, "Elevator\n");
    setDialogOwner(Entity.Player);
    choice { "Press UP" -> L1, "Press DOWN" -> L2, "Don't get on" -> L5 }
    goto L5;
    return;

L1:
    playSound(8, 4);
    rotate3DObject(0, 1);
    delayThenRotate3DObjectThenDelayThenRotate3DObjectThenDelay(1, 0);
    rotate3DObject(1, 1);
    delayThenRotate3DObjectThenDelayThenRotate3DObjectThenDelay(0, 1);
    rotate3DObject(0, 1);
    delayThenRotate3DObjectThenDelayThenRotate3DObjectThenDelay(1, 0);
    rotate3DObject(1, 1);
    delay(1);
    playSound(8, 5);
    warp(to: Map.GCAN10, spawn: 0, trigger: 52);
    return;

L2:
    fadeOutHUD();
    if (trigger(155)) goto L3;
    speak(Entity.Player, "What?\n");
    showTextbox("Nothing happens.\n");
    return;
    goto L4;

L3:
    playSound(8, 4);
    rotate3DObject(0, 1);
    delayThenRotate3DObjectThenDelayThenRotate3DObjectThenDelay(1, 0);
    rotate3DObject(1, 1);
    delayThenRotate3DObjectThenDelayThenRotate3DObjectThenDelay(0, 1);
    rotate3DObject(0, 1);
    delayThenRotate3DObjectThenDelayThenRotate3DObjectThenDelay(1, 0);
    rotate3DObject(1, 1);
    delay(1);
    playSound(8, 5);
    warp(to: Map.GCAN06, spawn: 2, trigger: 53);
    return;

L4:
    return;

L5:
    return;
}

section(55) {
    playSound(8, 5);
    return;
}

section(51) {
    move(entity: Entity.Player, to: (2100, -4000), sprint: 0);
    if (!trigger(142)) goto L1;
    warp(to: Map.GCAN08_2, spawn: 1, trigger: 255);

L1:
    warp(to: Map.GCAN08_1, spawn: 1, trigger: 255);
    return;
    garbage { 2c 00 fe 00 2c 00 05 00 86 00 06 00 c4 00 07 00 f4 00 08 00 16 01 09 00 56 01 51 00 98 01 52 00 ce 01 37 00 52 03 33 00 58 03 ff ff 24 00 6e 63 19 00 0b 00 6e 09 18 00 42 00 19 00 74 2c 31 00 40 00 24 00 6e 63 19 00 0b 00 6e 0e 18 00 58 00 19 00 74 2c 13 00 1f 00 24 00 6e 63 19 00 0b 00 6e 04 18 00 6e 00 19 00 74 36 14 00 09 00 24 00 6e 63 19 00 0b 00 6e 00 18 00 84 00 19 00 74 2e 45 00 10 00 fe 00 1b 05 1a 00 82 76 82 8f 82 95 82 8c 82 84 81 40 82 99 82 8f 82 95 81 40 82 93 82 94 82 8f 82 90 81 40 82 94 82 88 82 81 82 94 81 48 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 2b 01 fe 00 1b 06 1a 00 82 72 82 88 82 95 82 88 82 81 81 43 81 40 82 93 82 88 82 95 82 88 82 81 81 49 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 2e 01 fe 00 1b 07 1a 00 82 72 82 97 82 89 82 93 82 88 81 49 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 2e 01 fe 00 1b 08 1a 00 82 6b 82 85 82 94 81 75 82 93 81 40 82 82 82 81 82 94 82 94 82 8c 82 85 81 40 82 86 82 95 82 8c 82 8c 81 40 82 8f 82 8e 81 49 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 0c 01 fe 00 1b 09 1a 00 82 76 82 88 82 81 82 94 82 83 82 88 82 81 81 40 82 94 82 81 82 8c 82 8b 82 89 82 8e 82 87 81 40 82 81 82 82 82 8f 82 95 82 94 81 48 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 0c 01 fe 00 1b ff 1a 00 82 6d 82 8f 82 92 82 94 82 88 81 40 82 76 82 85 82 93 82 94 81 46 81 40 82 65 82 92 82 85 82 85 82 9a 82 85 82 8c 82 81 82 8e 82 84 0d 00 00 00 fe 00 4d fd 00 08 67 00 05 00 1b ff 1a 00 82 64 82 8c 82 85 82 96 82 81 82 94 82 8f 82 92 0d 00 00 00 1b fd 10 03 46 02 a4 02 50 03 1a 00 82 6f 82 92 82 85 82 93 82 93 81 40 82 74 82 6f 0d 00 82 6f 82 92 82 85 82 93 82 93 81 40 82 63 82 6e 82 76 82 6d 0d 00 82 63 82 8f 82 8e 81 75 82 94 81 40 82 87 82 85 82 94 81 40 82 8f 82 8e 0d 00 00 00 12 00 16 00 50 03 fe 00 5a 00 08 04 70 00 00 01 67 00 01 00 70 01 00 01 67 00 01 00 70 00 00 01 67 00 01 00 70 01 00 01 67 00 01 00 70 00 00 01 67 00 01 00 70 01 00 01 67 00 01 00 70 00 00 01 67 00 01 00 70 01 00 01 67 00 01 00 70 00 00 01 67 00 01 00 70 01 00 01 