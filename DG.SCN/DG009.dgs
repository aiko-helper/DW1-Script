// DG009.SCN
#pragma script index=9 start=0xc000 end=0xd000 headerU16=0x10 sentinelOff=0x575

section onEnter(254) {  // len=58
    spawnChest(Item.MediumMP, -1511, 1093, 0, 706);
    roll(pstat: 110, max: 99);
    if (pstat[110] > 14) goto L1;
    spawnItem(Item.Digimushroom, x: 74, y: 62);

L1:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 24) goto L2;
    spawnItem(Item.Digimushroom, x: 31, y: 45);

L2:
    return;
}

section(81) {  // len=738
    speak(Entity.System, "Vending Machine\n");
    rotate(entity: Entity.Player, to: 2048);
    delay(5);
    speak(Entity.Player, "My gosh, it's so expensive!\n");
    choice { "Meat : three hund bits" -> L1, "DigiMushrooms:six hund bits" -> L3, "Don't buy" -> L5 }
    goto L5;
    return;

L1:
    if (money < 300) goto L2;
    goto L6;
    goto L3;

L2:
    speak(Entity.Player, "I don't got enough money.\n");
    return;

L3:
    if (money < 600) goto L4;
    goto L9;
    goto L5;

L4:
    speak(Entity.Player, "I don't got enough money.\n");
    return;

L5:
    return;

L6:
    reduceMoney(300);
    speak(Entity.System, "<LIGHTBLUE>Meat <WHITE>came out!\n");
    giveItem(Item.Meat, 1);
    if (!trigger(0)) goto L8;
    if (item[Item.Meat] < 99) goto L7;
    return;

L7:
    speak(Entity.Player, "Oops, too many things.\n");
    setTrigger(3);
    callSubroutine(0);
    callSubroutine(13);
    giveItem(Item.Meat, 1);

L8:
    return;

L9:
    reduceMoney(600);
    speak(Entity.System, "A <LIGHTBLUE>Digital Mushroom <WHITE>\ncame out!\n");
    giveItem(Item.Digimushroom, 1);
    if (!trigger(0)) goto L11;
    if (item[Item.Digimushroom] < 99) goto L10;
    return;

L10:
    speak(Entity.Player, "Oops, too many things.\n");
    setTrigger(3);
    callSubroutine(0);
    callSubroutine(13);
    giveItem(Item.Digimushroom, 1);

L11:
    return;
}

section(82) {  // len=3284
    rotate(entity: Entity.Player, to: 2048);
    delay(5);
    setTextboxSize(19, 7);
    showTextbox("Explanation of fishing:\nFirst, get a 'rod'. You'll\nget a submenu <GREEN><TRIANGLE> <WHITE>\nwith 'Fishing' icon. Click\non it. Bait with <LIGHTBLUE><X> <WHITE>.\nSelect something from\nthe foods you have.\n");
    showTextbox("Next, change directions with\nleft or right buttons. Hold\nrod over head with <LIGHTBLUE><X> <WHITE>,\nthrow again using <LIGHTBLUE><X> <WHITE>.\nWait for the float to move.\nWhen float moves, fish has\nbait. Pull in with <LIGHTBLUE><X> <WHITE>.\n");
    showTextbox("Look at gauge at upper left.\nLet go of <LIGHTBLUE><X> <WHITE>before\ngauge is full. Otherwise line\nwill break, so be careful.\nIf you pull the float close\nenough towards yourself, then\nyou have caught the fish.\n");
    showTextbox("If you get an 'X' on the fish\nshadow, it means that you can't\nfish using the current bait.\n");
    fadeOutHUD();
    return;
    garbage { 10 00 fe 00 10 00 51 00 4a 00 52 00 2c 03 ff ff 75 05 19 fa 00 00 45 04 00 00 c2 02 24 00 6e 63 19 00 0b 00 6e 0e 18 00 32 00 19 00 74 2c 4a 00 3e 00 24 00 6e 63 19 00 0b 00 6e 18 18 00 48 00 19 00 74 2c 1f 00 2d 00 fe 00 1b ff 1a 00 82 75 82 85 82 8e 82 84 82 89 82 8e 82 87 81 40 82 6c 82 81 82 83 82 88 82 89 82 8e 82 85 0d 00 00 00 4d fd 00 08 67 00 05 00 1b fd 1a 00 82 6c 82 99 81 40 82 87 82 8f 82 93 82 88 81 43 81 40 82 89 82 94 81 75 82 93 81 40 82 93 82 8f 81 40 82 85 82 98 82 90 82 85 82 8e 82 93 82 89 82 96 82 85 81 49 0d 00 00 00 10 03 44 01 98 01 ec 01 1a 00 82 6c 82 85 82 81 82 94 81 40 81 46 81 40 82 94 82 88 82 92 82 85 82 85 81 40 82 88 82 95 82 8e 82 84 81 40 82 82 82 89 82 94 82 93 0d 00 82 63 82 89 82 87 82 89 82 6c 82 95 82 93 82 88 82 92 82 8f 82 8f 82 8d 82 93 81 46 82 93 82 89 82 98 81 40 82 88 82 95 82 8e 82 84 81 40 82 82 82 89 82 94 82 93 0d 00 82 63 82 8f 82 8e 81 75 82 94 81 40 82 82 82 95 82 99 0d 00 00 00 12 00 16 00 ec 01 fe 00 19 00 25 00 00 02 2c 01 00 00 18 00 5c 01 19 00 16 00 ee 01 16 00 98 01 1b fd 1a 00 82 68 81 40 82 84 82 8f 82 8e 81 75 82 94 81 40 82 87 82 8f 82 94 81 40 82 85 82 8e 82 8f 82 95 82 87 82 88 81 40 82 8d 82 8f 82 8e 82 85 82 99 81 42 0d 00 00 00 fe 00 19 00 25 00 00 02 58 02 00 00 18 00 b0 01 19 00 16 00 7e 02 16 00 ec 01 1b fd 1a 00 82 68 81 40 82 84 82 8f 82 8e 81 75 82 94 81 40 82 87 82 8f 82 94 81 40 82 85 82 8e 82 8f 82 95 82 87 82 88 81 40 82 8d 82 8f 82 8e 82 85 82 99 81 42 0d 00 00 00 fe 00 fe 00 2b 00 2c 01 00 00 1b ff 1a 00 01 06 82 6c 82 85 82 81 82 94 81 40 01 01 82 83 82 81 82 8d 82 85 81 40 82 8f 82 95 82 94 81 49 0d 00 00 00 28 00 26 01 19 00 00 00 00 00 18 00 7c 02 19 00 19 00 24 00 26 02 63 00 18 00 3c 02 19 00 fe 00 1b fd 1a 00 82 6e 82 8f 82 90 82 93 81 43 81 40 82 94 82 8f 82 8f 81 40 82 8d 82 81 82 8e 82 99 81 40 82 94 82 88 82 89 82 8e 82 87 82 93 81 42 0d 00 00 00 1c 00 03 00 64 00 64 0d 28 00 26 01 fe 00 2b 00 58 02 00 00 1b ff 1a 00 82 60 81 40 01 06 82 63 82 89 82 87 82 89 