  look(entity: Entity.Player, at: Entity(6));
  look(entity: Entity(6), at: Entity.Player);
  look(entity: Entity.Partner, at: Entity(6));
  waitForEntity(Entity.Player);
  speak(Entity(6), "「評判どおりの腕前でち!ぜひともセッチャ<NEWLINE> をデチにしてほしいでち!」<NEWLINE>");
  anim(Entity.Player, Animation(19), wait: 20);
  speak(Entity.Player, "「デチ…?ああ、弟子ね。それは困るな。<NEWLINE> でも街作りを手伝ってくれるならいーよ。」<NEWLINE>");
  speak(Entity(6), "「わかったでち。それも立派な修行でちね。<NEWLINE> がんばってみるでちよ。」<NEWLINE>");
