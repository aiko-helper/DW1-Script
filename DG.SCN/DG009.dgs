  unsetTrigger(Trigger(1));
  followEntity(Entity.Player, speed: 10);
  setTrigger(Trigger(258));
  addPStat(PStat(1), 2);
  return;
}

section(8) {
  speak(Entity(8), "「ムキーー!」<NEWLINE>");
  showTextbox("「なんでここにいるのか、だと!?」<NEWLINE>");
  showTextbox("「おい、<LIGHTBLUE><PLAYER><WHITE>!<NEWLINE> 街に俺様のハーレムをつくろうとしたら<NEWLINE> 追い出されたんだよ!」<NEWLINE>");
  if (money < 50000) {
    return;
  }
  {
    speak(Entity(8), "「チッ…そうだ、おまえ最近<NEWLINE> はぶりがいいらしいなぁ?<NEWLINE> いいもん売ってやるぜウキッ!」<NEWLINE>");
    showTextbox("「世にも貴重な<LIGHTBLUE>金のバナナ<WHITE>だぜ。<NEWLINE> とりあえず50000<B><it>だ。<NEWLINE> ローンはきかんぞムキキ。」<NEWLINE>");
    setDialogOwner(Entity.Player);
    setSelection(L1, L2);
    showTextbox("「出す。」<NEWLINE>「出さない。」<NEWLINE>");
    waitForSelectionChoice();
    break;

L1:
    reduceMoney(50000);
    giveItem(Item.GoldBanana, 1);
    if (trigger(0)) {
      if (item[Item.GoldBanana] >= 99) {
        speak(Entity(8), "「おまえアホか。集めすぎ!」<NEWLINE>");
        addMoney(50000);
        return;
      }
      speak(Entity.Player, "「いけね、持ち物がいっぱいだ。」<NEWLINE>");
      inventoryFullBailout();
      giveItem(Item.GoldBanana, 1);
    }
    speak(Entity(8), "「ムキ、まいどあり~。」<NEWLINE>");
    return;

L2:
  }
  speak(Entity(8), "「人間、生きた金つかわねぇと。」<NEWLINE>");
  return;
}

