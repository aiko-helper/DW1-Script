section onEnter(254) {
  if (trigger(232)) {
    setObjectsVisibleRange(68, 70, 1);
  } else {
    setRectImpassible(22, 16, 3, 12);
  }
  if (trigger(232) && pstat[1] >= 35) {
    setObjectsVisibleRange(71, 73, 0);
  }
  spawnItemChance(max: 99, chance: 39, item: Item.Digimushroom, x: 37, y: 48);
  spawnItemChance(max: 99, chance: 3, item: Item.BlueApple, x: 38, y: 52);
  return;
}

section(5) {
  speak(Entity(5), "「みのほどしらずだね!」<NEWLINE>");
  finishEncounter(Trigger(286));
}

section(7) {
  speak(Entity(7), "「ボクが何したって言うんだよっ!」<NEWLINE>");
  finishEncounter(Trigger(296));
}

