// DG112.SCN
#pragma script index=112 start=0x50800 end=0x51000 headerU16=0x2c sentinelOff=0x24

section onEnter(254) {  // len=68
    roll(pstat: 110, max: 99);
    if (pstat[110] > 11) goto L_0016;
    spawnItem(Item.Digimushroom, 31, 56);
L_0016:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 17) goto L_002c;
    spawnItem(Item.Digimushroom, 55, 52);
L_002c:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 1) goto L_0042;
    spawnItem(Item.Happymushroom, 40, 80);
L_0042:
    return;
}

section section_5(5) {  // len=66
    setDialogOwner(5);
    showTextbox("Do you want something?\n");
    fadeOutHUD();
    delay(1);
    startBattle();
    setTrigger(291);
    return;
}

section section_6(6) {  // len=74
    setDialogOwner(6);
    showTextbox("Ha ha, don't be too hasty.\n");
    fadeOutHUD();
    delay(1);
    startBattle();
    setTrigger(291);
    return;
}

