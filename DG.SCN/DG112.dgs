section section_51(51) {  // len=56
    move(entity: Entity.Player, to: (2200, -2600), sprint: 0);
    if (!trigger(114) && !trigger(147)) goto L_001c;
    warp(to: Map.MIST03, spawn: 0, trigger: 255);
L_001c:
    roll(pstat: 110, max: 99);
    if (pstat[110] >= 69) goto L_0034;
    warp(to: Map.MIST03, spawn: 0, trigger: 255);
    goto section_52;
L_0034:
    warp(to: Map.MIST07, spawn: 0, trigger: 255);
}

