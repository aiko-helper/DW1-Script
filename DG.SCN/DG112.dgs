// DG112.SCN
#include "functions.dgs"
#pragma script index=112 start=0x4b000 end=0x4b800 headerU16=0x1c sentinelOff=0x24
#include "entities.dgs"

section onEnter(254) {
  spawnItemChance(max: 99, chance: 13, item: Item.Digimushroom, x: 53, y: 64);
  spawnItemChance(max: 99, chance: 8, item: Item.Digimushroom, x: 50, y: 36);
  spawnItemChance(max: 99, chance: 2, item: Item.Happymushroom, x: 42, y: 75);
  return;
}

section(6) {
  speak(Entity(6), "「うらうら。」<NEWLINE>");
  finishEncounter(Trigger(280));
}

section(7) {
  speak(Entity(7), "「ていてい。」<NEWLINE>");
  finishEncounter(Trigger(280));
}

section(8) {
  speak(Entity(8), "「う~ん、やめとかない?」<NEWLINE>");
  finishEncounter(Trigger(296));
}

section(9) {
  speak(Entity(9), "「安心するにはまだ早い…」<NEWLINE>");
  finishEncounter(Trigger(301));
}

section(5) {
  {
    speak(Entity(5), "「……………!」<NEWLINE>");
    setTrigger(Trigger(1));
    setPStat(PStat(250), 1);
    setPStat(PStat(251), 5);
    setPStat(PStat(252), 255);
    setPStat(PStat(253), 255);
    startBattle();
    unsetTrigger(Trigger(1));
    setPStat(PStat(250), 0);
    look(entity: Entity(5), at: Entity.Player);
    lookPairAt(Entity(5));
    waitForPair();
    speak(Entity(5), "「うわぁ~~ん!やだよ~!<NEWLINE> 戦うのやだよ~!」<NEWLINE>");
    speak(Entity.Player, "「…。戦うのいやなら逃げろよう。」<NEWLINE>");
    speak(Entity(5), "「それはそれでクヤシイじゃん。」<NEWLINE>");
    anim(Entity.Player, Animation(16), wait: 20);
    speak(Entity.Player, "「よくわからんやつだな~。<NEWLINE> まあともかく、俺達の街に来ないか?<NEWLINE> こんな所にかくれてないでさ。」<NEWLINE>");
    speak(Entity(5), "「ひ、ひぃ~、ま、ま、街?」<NEWLINE>");
    anim(Entity.Player, Animation(19), wait: 20);
    speak(Entity.Player, "「いやなら別にいいけど。」<NEWLINE>");
    speak(Entity(5), "「そう言われると行きたくなっちゃうな。<NEWLINE> 行きますよ!行きますとも!」<NEWLINE>");
    fadeOutHUD();
    break;
  }
  approach(who: Entity(5), x: -330, y: -2751, tries: 5, wait: 20);
  playSound(8, 10);
  speak(Entity.System, "ガブモンが街に参加した!!!<NEWLINE>");
  anim(Entity.Player, Animation(16), wait: 20);
  speak(Entity.Player, "「はー…変なやつ…!」<NEWLINE>");
  followEntity(Entity.Player, speed: 10);
  setTrigger(Trigger(217));
  addPStat(PStat(1), 1);
  return;
  garbage { 1c 00 fe 00 1c 00 06 00 60 00 07 00 84 00 08 00 a8 00 09 00 d8 00 05 00 08 01 ff ff 24 00 6e 63 19 00 0b 00 6e 0d 18 00 32 00 19 00 74 2c 35 00 40 00 24 00 6e 63 19 00 0b 00 6e 08 18 00 48 00 19 00 74 2c 32 00 24 00 24 00 6e 63 19 00 0b 00 6e 02 18 00 5e 00 19 00 74 45 2a 00 4b 00 fe 00 1b 06 1a 00 81 75 82 a4 82 e7 82 a4 82 e7 81 42 81 76 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 18 01 fe 00 1b 07 1a 00 81 75 82 c4 82 a2 82 c4 82 a2 81 42 81 76 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 18 01 fe 00 1b 08 1a 00 81 75 82 a4 81 60 82 f1 81 41 82 e2 82 df 82 c6 82 a9 82 c8 82 a2 81 48 81 76 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 28 01 fe 00 1b 09 1a 00 81 75 88 c0 90 53 82 b7 82 e9 82 c9 82 cd 82 dc 82 be 91 81 82 a2 81 63 81 76 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 2d 01 fe 00 1b 05 1a 00 81 75 81 63 81 63 81 63 81 63 81 63 81 49 81 76 0d 00 00 00 1c 00 01 00 1e 00 fa 01 1e 00 fb 05 1e 00 fc ff 1e 00 fd ff 27 00 67 00 01 00 66 00 1d 00 01 00 1e 00 fa 00 4c 00 05 fd 4c 00 fd 05 4c 00 fc 05 4a fd 4a fc 1b 05 1a 00 81 75 82 a4 82 ed 82 9f 81 60 81 60 82 f1 81 49 82 e2 82 be 82 e6 81 60 81 49 0d 00 81 40 90 ed 82 a4 82 cc 82 e2 82 be 82 e6 81 60 81 49 81 76 0d 00 00 00 1b fd 1a 00 81 75 81 63 81 42 90 ed 82 a4 82 cc 82 a2 82 e2 82 c8 82 e7 93 a6 82 b0 82 eb 82 e6 82 a4 81 42 81 76 0d 00 00 00 1b 05 1a 00 81 75 82 bb 82 ea 82 cd 82 bb 82 ea 82 c5 83 4e 83 84 83 56 83 43 82 b6 82 e1 82 f1 81 42 81 76 0d 00 00 00 56 00 fd 10 67 00 14 00 1b fd 1a 00 81 75 82 e6 82 ad 82 ed 82 a9 82 e7 82 f1 82 e2 82 c2 82 be 82 c8 81 60 81 42 0d 00 81 40 82 dc 82 a0 82 c6 82 e0 82 a9 82 ad 81 41 89 b4 92 42 82 cc 8a 58 82 c9 97 88 82 c8 82 a2 82 a9 81 48 0d 00 81 40 82 b1 82 f1 82 c8 8f 8a 82 c9 82 a9 82 ad 82 ea 82 c4 82 c8 82 a2 82 c5 82 b3 81 42 81 76 0d 00 00 00 1b 05 1a 00 81 75 82 d0 81 41 82 d0 82 a1 81 60 81 41 82 dc 81 41 82 dc 81 41 8a 58 81 48 81 76 0d 00 00 00 56 00 fd 13 67 00 14 00 1b fd 1a 00 81 75 82 a2 82 e2 82 c8 82 e7 95 ca 82 c9 82 a2 82 a2 82 af 82 c7 81