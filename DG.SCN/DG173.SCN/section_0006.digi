; source: ./extract/DIGIMON/SCN/DG.SCN
; DG173.SCN, section 6

section_6(6):     ; len=2416
  0000:  storeRandom 110 3
  0004:  if pstat[110] != 0 then section_6+0x9e
  0010:  speak 6 "Rest as much as possible.\nThat's the key to\nyour Digimon's health.\n"
  009c:  endSection
  009e:  if pstat[110] != 1 then section_6+0x3b2
  00aa:  speak 6 "Alright. Let me tell you\nhow the city will\ngrow and prosper...\n"
  012e:  showTextbox "When a Rookie Digimon\ncomes to the city,\nit's plus one point.\n"
  01ae:  showTextbox "And when a Champion\nDigimon comes to the city,\nit's plus two points.\n"
  023c:  showTextbox "If an Ultimate Digimon\ncomes to city,\nit's plus three points.\n"
  02bc:  showTextbox "However, there are three\nChampion Digimon that\nare not very useful.\n"
  0348:  showTextbox "When one of them comes,\nit's only plus one point.\n"
  03b0:  endSection
  03b2:  if pstat[110] != 2 then section_6+0x5c6
  03be:  speak 6 "Let me tell you a little\nbit about Types.\n"
  0418:  showTextbox "If an opponent is the\nsame Type as your Digimon\npartner, he may not battle.\n"
  04b4:  showTextbox "And if your Digimon's Type\nis not compatible, he can be\nrefused at a door.\n"
  054e:  showTextbox "Other than that, maybe\nyou don't have to\nworry about it.\n"
  05c4:  endSection
  05c6:  if pstat[110] != 3 then section_6+0x96e
  05d2:  speak 6 "Let me tell you about\nTamer Level.\n"
  061e:  showTextbox "Tamer Level will increase\nif you can raise Digimon\nto Ultimate Digimon.\n"
  06b2:  showTextbox "And winning a championship\nin a high level tournament\nis very good.\n"
  073e:  showTextbox "It will go up naturally.\nYou don't have to worry\nabout it too much.\n"
  07ca:  showTextbox "On the other hand,\nyou have to pay attention\nnot to let it go down.\n"
  0856:  showTextbox "If your Digimon fades away,\nyour Tamer Level\nwill go down for sure.\n"
  08e2:  showTextbox "If you regularly have\ncare mistakes, it might\ngo down. Be careful.\n"
  096c:  endSection
  096e:  endSection
