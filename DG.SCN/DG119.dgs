// DG119.SCN
#include "functions.dgs"
#pragma script index=119 start=0x4e800 end=0x4f000 headerU16=0x14 sentinelOff=0x24
#include "entities.dgs"

section onEnter(254) {
  spawnItemChance(max: 99, chance: 16, item: Item.Digimushroom, x: 49, y: 70);
  spawnItemChance(max: 99, chance: 2, item: Item.Happymushroom, x: 25, y: 68);
  return;
}

section(81) {
  look(entity: Entity(5), at: Entity.Player);
  look(entity: Entity.Player, at: Entity(5));
  if (!trigger(139)) {
    setTrigger(Trigger(139));
    playSound(8, 4);
    speak(Entity(5), "「ここは『デジモンカード』の店アルよ。」<NEWLINE>");
    speak(Entity.Player, "「『デジモンカード』?何なの?」<NEWLINE>");
    speak(Entity(5), "「今、これを集めるのが大ブームアルよ。<NEWLINE> 集めてそんはないアルね。」<NEWLINE>");
    speak(Entity.Player, "「ふーん。」<NEWLINE>");
    playSound(8, 4);
    speak(Entity(5), "「とりあえずこれをタダであげるアル。<NEWLINE> よろしくアルよ~。」<NEWLINE>");
    speak(Entity.Player, "「おっ!これ、俺のカードじゃん!」<NEWLINE>");
    speak(Entity.System, "<LIGHTBLUE><PLAYER><WHITE>カードを手に入れた!<NEWLINE>");
    giveCard(0);
    return;
  }
  speak(Entity(5), "「ここは『デジモンカード』の店アルよ。」<NEWLINE>");
  setPStat(PStat(254), 5);
  playSound(8, 4);
  speak(Entity(5), "「今日もイキのいいカードを<NEWLINE> そろえたアルよ」<NEWLINE>");
  callSubroutine(15);
  loop {
    setDialogOwner(Entity.Player);
    setSelection(L1, L5, L_0396);
    showTextbox("「カードを買う」<NEWLINE>「カードを売る」<NEWLINE>「やめる」<NEWLINE>");
    waitForSelectionChoice();
    break;

L1:
    {
      if (money >= 500) {
        setSelection(L2, L4, L6);
        showTextbox("「3枚パック買い」<NEWLINE>「1枚買い」<NEWLINE>「やっぱりやめる」<NEWLINE>");
        waitForSelectionChoice();
        goto L6;
        break;
      }
      setSelection(L4, L6);
      showTextbox("「1枚買い」<NEWLINE>「やっぱりやめる」<NEWLINE>");
      waitForSelectionChoice();
      goto L6;

L2:
    }
    speak(Entity(5), "「パックは500<B><it>よ。<NEWLINE> 何が入っているかは運しだいアル。」<NEWLINE>");
    setDialogOwner(Entity.Player);
    setSelection(L3, L6);
    showTextbox("「買う」<NEWLINE>「やっぱりやめる」<NEWLINE>");
    waitForSelectionChoice();
    goto L6;

L3:
    reduceMoney(500);
    callSubroutine(15);
    speak(Entity(5), "「パックはすぐ開けるよろし。」<NEWLINE>");
    unsetTrigger(Trigger(3));
    unsetTrigger(Trigger(4));
    callSubroutine(14);
    callSubroutine(22);
    goto L6;

L4:
    unsetTrigger(Trigger(3));
    setTrigger(Trigger(4));
    callSubroutine(14);
    callSubroutine(22);
    goto L6;

L5:
    setTrigger(Trigger(3));
    callSubroutine(14);

L6:
    speak(Entity(5), "「まだ用アルか?」<NEWLINE>");
  }
  callSubroutine(16);
  speak(Entity(5), "「またくるアルよ。」<NEWLINE>");
  return;
}

section(82) {
  {
    look(entity: Entity(6), at: Entity.Player);
    look(entity: Entity.Player, at: Entity(6));
    playSound(8, 4);
    speak(Entity(6), "「ここは『回しゅう品』の店アルよ。」<NEWLINE>");
    setDialogOwner(Entity.Player);
    setSelection(L1, L2, L3);
    showTextbox("「普通の品が欲しい。」<NEWLINE>「回しゅう品が欲しい。」<NEWLINE>「またな。」<NEWLINE>");
    waitForSelectionChoice();
    break;

L1:
    for x in [Trigger(385), Trigger(389), Trigger(406), Trigger(423)] {
      setTrigger(x);
    }
    for id in Trigger(399)..Trigger(401) {
      setTrigger(id);
    }
    unsetTrigger(Trigger(3));
    setPStat(PStat(254), 6);
    callSubroutine(8);
    for x in [Trigger(385), Trigger(389), Trigger(406), Trigger(423)] {
      unsetTrigger(x);
    }
    for id in Trigger(399)..Trigger(401) {
      unsetTrigger(id);
    }
    return;

L2:
    setTrigger(Trigger(3));
    setPStat(PStat(254), 6);
    callSubroutine(8);
    return;

L3:
  }
  return;
}

section(51) {
  if (trigger(190)) {
    return;
  }
  speak(Entity.Player, "「おっ!?」<NEWLINE>");
  panTo(x: 800, y: 4000, slowdown: 30);
  speak(Entity.Player, "「店だっ!」<NEWLINE>");
  followEntity(Entity.Player, speed: 10);
  setTrigger(Trigger(190));
  return;
