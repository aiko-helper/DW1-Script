// DG035.SCN
#include "functions.dgs"
#pragma script index=35 start=0x1c800 end=0x1d000 headerU16=0x30 sentinelOff=0x24
#include "entities.dgs"

section onEnter(254) {
  spawnItemChance(max: 99, chance: 9, item: Item.Digimushroom, x: 35, y: 9);
  spawnItemChance(max: 99, chance: 4, item: Item.Digimushroom, x: 19, y: 31);
  spawnItemChance(max: 99, chance: 0, item: Item.Happymushroom, x: 11, y: 10);
  spawnItemChance(max: 99, chance: 0, item: Item.DeluxeMushroom, x: 46, y: 46);
  if (!trigger(180)) {
    setObjectVisibility(2, 0);
    return;
  }
  setObjectVisibility(2, 1);
  return;
}

section(5) {
  speak(Entity(5), "「たたき落とすぜ!」<NEWLINE>");
  finishEncounter(Trigger(280));
}

section(6) {
  speak(Entity(6), "「お、押すなぁ!」<NEWLINE>");
  finishEncounter(Trigger(280));
}

section(7) {
  speak(Entity(7), "「高い所っておちつくぜ!」<NEWLINE>");
  finishEncounter(Trigger(280));
}

section(8) {
  speak(Entity(8), "「落ちる!危ないって!」<NEWLINE>");
  finishEncounter(Trigger(299));
}

section(9) {
  speak(Entity(9), "「こんな所で、やめてよっ!」<NEWLINE>");
  finishEncounter(Trigger(299));
}

section(10) {
  speak(Entity(10), "「戦ってもしかたないのに…」<NEWLINE>");
  finishEncounter(Trigger(299));
}

section(81) {
  {
    rotate(entity: Entity.Player, to: 1844);
    speak(Entity.System, " <NEWLINE>       エレベーター<NEWLINE>");
    setDialogOwner(Entity.Player);
    setSelection(L1, L2);
    showTextbox("下ボタンを押す<NEWLINE>乗らない<NEWLINE>");
    waitForSelectionChoice();
    break;
    return;

L1:
    if (trigger(176)) {
      playSound(8, 4);
      rotate3DObject(0, 1);
      delay(1);
      rotate3DObject(1, 1);
      delay(1);
      rotate3DObject(0, 1);
      delay(1);
      rotate3DObject(1, 1);
      delay(1);
      rotate3DObject(0, 1);
      delay(1);
      rotate3DObject(1, 1);
      delay(1);
      rotate3DObject(0, 1);
      delay(1);
      rotate3DObject(1, 1);
      delay(1);
      playSound(8, 5);
      if (pstat[16] == 3) {
        warp(to: Map.MGEN11, spawn: 0, trigger: 60);
      }
      warp(to: Map.OGRE03, spawn: 1, trigger: 54);
      return;
    }
    delay(20);
    speak(Entity.Player, "「…反応がないな。こりゃダメだ。」<NEWLINE>");
    return;

L2:
  }
  return;
}

section(53) {
  rotate(entity: Entity.Player, to: 3892);
  playSound(8, 5);
  setTrigger(Trigger(180));
  unsetTrigger(Trigger(181));
  return;
}

section(51) {
  move(entity: Entity.Player, to: (4173, 2349), sprint: 0);
  if (!trigger(180)) {
    warp(to: Map.GCAN04_2, spawn: 0, trigger: 255);
    return;
  }
  warp(to: Map.GCAN04, spawn: 0, trigger: 255);
  return;
}

section(52) {
  move(entity: Entity.Player, to: (-517, -4524), sprint: 0);
  if (trigger(142)) {
    warp(to: Map.GCAN08_2, spawn: 2, trigger: 255);
  }
  warp(to: Map.GCAN08_1, spawn: 2, trigger: 255);
