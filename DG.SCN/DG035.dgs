// DG035.SCN
#include "functions.dgs"
#pragma script index=35 start=0x1e000 end=0x1e800 headerU16=0x28 sentinelOff=0x24
#include "entities.dgs"

section onEnter(254) {
  spawnItemChance(max: 99, chance: 9, item: Item.Digimushroom, x: 56, y: 78);
  spawnItemChance(max: 99, chance: 19, item: Item.Digimushroom, x: 24, y: 44);
  spawnItemChance(max: 99, chance: 4, item: Item.SuperVeggy, x: 36, y: 24);
  spawnItemChance(max: 99, chance: 2, item: Item.Happymushroom, x: 79, y: 6);
  if (trigger(348) && !trigger(128)) {
    spawnItem(Item.Steak, x: 48, y: 32);
  }
  return;
}

section(6) {
  speak(6, "Ha! You're scared.\n");
  finishEncounter(296);
}

section(7) {
  speak(7, "You'd better go home!\n");
  finishEncounter(296);
}

section(8) {
  speak(8, "Once you go in,\nyou can't come out.\n");
  finishEncounter(296);
}

section(9) {
  speak(9, "Heh, heh!\n");
  finishEncounter(307);
}

section(10) {
  speak(10, "Wait.\n");
  finishEncounter(307);
}

section(11) {
  speak(11, "You'll be possessed.\n");
  finishEncounter(307);
}

section(5) {
  anim(5, 11, wait: 50);
  playAnimation(5, 0);
  speak(5, "Bakke-bakke?\n");
  playAnimation(Entity.Player, 16);
  speak(Entity.Player, "Looks like he's\nasking something.\n");
  setTrigger(49);
  setSelection(L1, L5);
  showTextbox("?...Yes\n?...No\n");

L1:
  anim(5, 11, wait: 45);
  playAnimation(5, 0);
  speak(5, "Bakke! Bakke bakke?\n");
  setDialogOwner(Entity.Player);
  setSelection(L2, L5);
  showTextbox("Yes\nNo\n");

L2:
  anim(5, 12, wait: 58);
  playAnimation(5, 0);
  playAnimation(Entity.Player, 15);
  speak(5, "Bakkeee...bakke bakke?\n");
  playAnimation(Entity.Player, 16);
  setDialogOwner(Entity.Player);
  setSelection(L5, L3);
  showTextbox("Yes\nNo\n");

L3:
  anim(5, 13, wait: 34);
  playAnimation(5, 13);
  speak(5, "Bakke bakke!\nBakkeee bakke bakkeee!\n");
  goto L4;

L4:
  loop {
    unsetTrigger(49);
    move(entity: 5, to: (1299, -1074), sprint: 1);
    if (pstat[101] >= 10) break;
    addPStat(PStat.LoopIterator, 1);
    delay(5);
    lookPairAt(5);
  }
  waitForEntity(5);
  unloadEntity(5);
  setPStat(PStat.LoopIterator, 0);
  playSound(8, 11);
  speak(Entity.System, "Bakemon joins the city!\n");
  playAnimation(Entity.Player, 16);
  speak(Entity.Player, "I think it went OK.\n");
  setTrigger(237);
  addPStat(1, 2);
  return;

L5:
  unsetTrigger(49);
  playAnimation(5, 29);
  sfx(8, 0, wait: 40);
  waitForEntity(5);
  unloadEntity(5);
  speak(Entity.Player, "Maybe I made him mad?\n");
  return;
}

section(51) {
  if (pstat[16] == 2) {
    move(entity: Entity.Player, to: (-140, 4669), sprint: 0);
    warp(to: Map.MGEN11, spawn: 0, trigger: 60);
  }
  storeDigimonType(103);
  storeDigimonTypus(103, 109);
  if (pstat[109] == 3) {
    move(entity: Entity.Player, to: (0, 5000), sprint: 0);
    move(entity: Entity.Partner, to: (0, 5000), sprint: 0);
    playSound(8, 1);
    warp(to: Map.YAKA11A, spawn: 0, trigger: 255);
    return;
  } else {
    speak(Entity.System, "Stopped by a weird\nblack force!\n");
    fadeOutHUD();
    move(entity: Entity.Player, to: (-200, 3658), sprint: 1, withCamera: true);
    move(entity: Entity.Partner, to: (100, 3658), sprint: 1);
    waitForPair();
    delay(10);
    rotate(entity: Entity.Player, to: 3100);
    delay(10);
    rotate(entity: Entity.Player, to: 2076);
    speak(Entity.Player, "What?! My legs are...\n");
  }
  return;
  garbage { 28 00 fe 00 28 00 06 00 98 00 07 00 d2 00 08 00 12 01 09 00 6e 01 0a 00 96 01 0b 00 b6 01 05 00 f4 01 33 00 a0 04 ff ff 24 00 6e 63 19 00 0b 00 6e 09 18 00 3e 00 19 00 74 2c 38 00 4e 00 24 00 6e 63 19 00 0b 00 6e 13 18 00 54 00 19 00 74 2c 18 00 2c 00 24 00 6e 63 19 00 0b 00 6e 04 18 00 6a 00 19 00 74 35 24 00 18 00 24 00 6e 63 19 00 0b 00 6e 02 18 00 80 00 19 00 74 45 4f 00 06 00 19 00 00 00 5c 01 81 00 80 00 18 00 96 00 19 00 74 7a 30 00 20 00 fe 00 1b 06 1a 00 82 67 82 81 81 49 81 40 82 78 82 8f 82 95 81 75 82 92 82 85 81 40 82 93 82 83 82 81 82 92 82 85 82 84 81 42 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 28 01 fe 00 1b 07 1a 00 82 78 82 8f 82 95 81 75 82 84 81 40 82 82 82 85 82 94 82 94 82 85 82 92 81 40 82 87 82 8f 81 40 82 88 82 8f 82 8d 82 85 81 49 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 28 01 fe 00 1b 08 1a 00 82 6e 82 8e 82 83 82 85 81 40 82 99 82 8f 82 95 81 40 82 87 82 8f 81 40 82 89 82 8e 81 43 0d 00 82 99 82 8f 82 95 81 40 82 83 82 81 82 8e 81 75 82 94 81 40 82 83 82 8f 82 8d 82 85 81 40 82 8f 82 95 82 94 81 42 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 28 01 fe 00 1b 09 1a 00 82 67 82 85 82 88 81 43 81 40 82 88 82 85 82 88 81 49 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 33 01 fe 00 1b 0a 1a 00 82 76 82 81 82 89 82 94 81 42 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 33 01 fe 00 1b 0b 1a 00 82 78 82 8f 82 95 81 75 82 8c 82 8c 81 40 82 82 82 85 81 40 82 90 82 8f 82 93 82 93 82 85 82 93 82 93 82 85 82 84 81 42 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 33 01 fe 00 56 00 05 0b 67 00 32 00 56 00 05 00 1b 05 1a 00 82 61 82 81 82 8b 82 8b 82 85 81 7c 82 82 82 81 82 8b 82 8b 82 85 81 48 0d 00 00 00 56 00 fd 10 1b fd 1a 00 82 6b 82 8f 82 8f 82 8b 82 93 81 40 82 8c 82 89 82 8b 82 85 81 40 82 88 82 85 81 75 82 93 0d 00 82 81 82 93 82 8b 82 89 82 8e 82 87 81 40 82 93 82 8f 82 8d 82 85 82 94 82 88 82 89 82 8e 82 87 81 42 0d 00 00 00 1c 00 31 00 10 02 9a 02 }
}
