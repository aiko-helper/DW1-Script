    delay(10);
    rotate(entity: Entity.Player, to: 3100);
    delay(10);
    rotate(entity: Entity.Player, to: 2076);
    setDialogOwner(Entity.Player);
    showTextbox("What?! My legs are...\n");
L_00e6:
    return;
