// DG035.SCN
#pragma script index=35 start=0x1e000 end=0x1e800 headerU16=0x28 sentinelOff=0x24

section onEnter(254) {  // len=112
    roll(pstat: 110, max: 99);
    if (pstat[110] > 9) goto L_0016;
    spawnItem(Item.Digimushroom, 56, 78);
L_0016:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 19) goto L_002c;
    spawnItem(Item.Digimushroom, 24, 44);
L_002c:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 4) goto L_0042;
    spawnItem(Item.SuperVeggy, 36, 24);
L_0042:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 2) goto L_0058;
    spawnItem(Item.Happymushroom, 79, 6);
L_0058:
    if (!trigger(348) || trigger(128)) goto L_006e;
    spawnItem(Item.Steak, 48, 32);
L_006e:
    return;
}

section section_6(6) {  // len=58
    setDialogOwner(6);
    showTextbox("Ha! You're scared.\n");
    fadeOutHUD();
    delay(1);
    startBattle();
    setTrigger(296);
    return;
}

