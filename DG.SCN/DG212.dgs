// DG212.SCN
#include "functions.dgs"
#pragma script index=212 start=0xb2800 end=0xb3800 headerU16=0x14 sentinelOff=0xfe
#include "entities.dgs"

section onEnter(254) {
  return;
}

section(71) {
  unsetTrigger(Trigger(1));
  setPStat(PStat(250), 0);
  waitForEntity(Entity(213));
  speak(Entity(5), "It seems <ORANGE><DIGIMON><WHITE> has\nfaded away...\n");
  showTextbox("Before fading away, he gave\nbirth to a Digitama. He will\nbe reborn with his abilities.\n");
  showTextbox("Which egg do you want?\n");
  callSubroutine(29);
  fadeOutHUD();
  callDigimonSubroutine(4);
  waitForEntity(Entity.System);
  setPStat(PStat(245), 0);
  setBGM(28);
  speak(Entity(5), "You can change the name\n<ORANGE><DIGIMON><WHITE> if you want.\n");
  setDialogOwner(Entity.Player);
  choice { "I want a new name" -> L1, "I'll keep his name" -> L2 }
  return;

L1:
  loop {
    callSubroutine(35);
    waitForEntity(Entity(214));
    setPStat(PStat(254), 3);
    callSubroutine(32);
    speak(Entity(5), "Is <ORANGE><DIGIMON><WHITE> okay?\n");
    setDialogOwner(Entity.Player);
    choice { "I want another name" -> L1, "Okay" -> L2 }
  }

L2:
  return;
}

section(72) {
  unsetTrigger(Trigger(1));
  setPStat(PStat(250), 0);
  waitForEntity(Entity(213));
  callSubroutine(35);
  if (stat[Stat.CurrentHP] != 0) {
    removeCondition(Condition.Injured);
    removeCondition(Condition.Sick);
    addStats(currentHP: 9999, currentMP: 9999);
    speak(Entity(5), "Hey, don't get sick!\n");
    showTextbox("With the small bit of life\nleft, <ORANGE><DIGIMON><WHITE> was able\nto survive.\n");
    showTextbox("You must be careful.\n");
    waitForEntity(Entity(214));
    goto section_73.L1;
  }
  addStats(currentHP: 9999, currentMP: 9999);
  speak(Entity(5), "Oh my gosh!\nYou're back after losing.\n");
  showTextbox("With the small bit of life\nleft, <ORANGE><DIGIMON><WHITE> was able\nto survive.\n");
  showTextbox("Maybe your things were stolen.\n");
  showTextbox("Those who lose a battle might\nhave their things stolen.\n");
  showTextbox("Stolen objects may be sold\nsomewhere. Don't give up\nfinding them!\n");
  waitForEntity(Entity(214));
  goto section_73.L1;
  return;
}

section(73) {
  unsetTrigger(Trigger(1));
  setPStat(PStat(250), 0);
  waitForEntity(Entity(213));
  speak(Entity(5), "Oh no! <ORANGE><DIGIMON><WHITE>\nhas lost all life.\n");
  showTextbox("Before fading away,\n<ORANGE><DIGIMON><WHITE> gave\nbirth to a Digitama.\n");
  showTextbox("Due to the danger,\nDigitama did not inherit\nall abilities...\n");
  if (stat[Stat.TamerLevel] != 0) {
    reduceStats(tamerLevel: 1);
    speak(Entity.System, "<PINK>Tamer Level\nhas gone down! <WHITE>\n");
  }
  callSubroutine(47);
  callDigimonSubroutine(4);
  waitForEntity(Entity.System);
  setPStat(PStat(245), 0);
  setBGM(28);
  speak(Entity(5), "If you want,\nyou can change the name\n<ORANGE><DIGIMON><WHITE>.\n");
  setDialogOwner(Entity.Player);
  choice { "I want a new name" -> section_71.L1, "I'll keep his name" -> section_71.L2 }
  return;
  setPStat(PStat(254), 3);
  callSubroutine(32);
  callSubroutine(35);
  waitForEntity(Entity(214));
  return;

L1:
  fadeOutHUD();
  storeDigimonType(PStat(103));
  if (pstat[103] == 3 || pstat[103] == 4 || pstat[103] == 17 || pstat[103] == 18) {
    goto L2;
  }
  if (pstat[103] == 31 || pstat[103] == 32 || pstat[103] == 45 || pstat[103] == 46) {
    goto L2;
  }
  if (pstat[103] == 12 || pstat[103] == 54) {
  } else {
    switch pstat[103] {
      50 => {
        goto L3;
      }
      20 => {
        goto L4;
      }
    }
    return;

L2:
    roll(pstat: PStat.RollScratch, max: 99);
    if (pstat[110] <= 9) {
      setPStat(PStat(254), 37);
      callDigimonSubroutine(10);
      delay(550);
      speak(Entity.System, "<ORANGE><DIGIMON><WHITE> has digivolved!\n");
      return;
    }
    return;
  }
  roll(pstat: PStat.RollScratch, max: 99);
  if (pstat[110] <= 9) {
    setPStat(PStat(254), 26);
    callDigimonSubroutine(10);
    delay(550);
    speak(Entity.System, "<ORANGE><DIGIMON><WHITE> has digivolved!\n");
    return;
  }
  return;

L3:
  roll(pstat: PStat.RollScratch, max: 99);
  if (pstat[110] <= 9) {
    setPStat(PStat(254), 59);
    callDigimonSubroutine(10);
    delay(550);
    speak(Entity.System, "<ORANGE><DIGIMON><WHITE> has digivolved!\n");
    return;
  }
  return;

L4:
  roll(pstat: PStat.RollScratch, max: 99);
  if (pstat[110] <= 49 && stat[Stat.Discipline] <= 49) {
    setPStat(PStat(254), 6);
    callDigimonSubroutine(10);
    delay(550);
    speak(Entity.System, "<ORANGE><DIGIMON><WHITE> has digivolved!\n");
    return;
  }
  return;
  garbage { 14 00 fe 00 14 00 47 00 16 00 48 00 78 02 49 00 92 05 ff ff fe 00 1d 00 01 00 1e 00 fa 00 4a d5 1b 05 1a 00 82 68 82 94 81 40 82 93 82 85 82 85 82 8d 82 93 81 40 01 0a 06 00 01 01 81 40 82 88 82 81 82 93 0d 00 82 86 82 81 82 84 82 85 82 84 81 40 82 81 82 97 82 81 82 99 81 42 81 42 81 42 0d 00 00 00 1a 00 82 61 82 85 82 86 82 8f 82 92 82 85 81 40 82 86 82 81 82 84 82 89 82 8e 82 87 81 40 82 81 82 97 82 81 82 99 81 43 81 40 82 88 82 85 81 40 82 87 82 81 82 96 82 85 0d 00 82 82 82 89 82 92 82 94 82 88 81 40 82 94 82 8f 81 40 82 81 81 40 82 63 82 89 82 87 82 89 82 94 82 81 82 8d 82 81 81 42 81 40 82 67 82 85 81 40 82 97 82 89 82 8c 82 8c 0d 00 82 82 82 85 81 40 82 92 82 85 82 82 82 8f 82 92 82 8e 81 40 82 97 82 89 82 94 82 88 81 40 82 88 82 89 82 93 81 40 82 81 82 82 82 89 82 8c 82 89 82 94 82 89 82 85 82 93 81 42 0d 00 00 00 1a 00 82 76 82 88 82 89 82 83 82 88 81 40 82 85 82 87 82 87 81 40 82 84 82 8f 81 40 82 99 82 8f 82 95 81 40 82 97 82 81 82 8e 82 94 81 48 0d 00 00 00 64 1d 27 00 49 04 4a ff 1e 00 f5 00 5d 1c 1b 05 1a 00 82 78 82 8f 82 95 81 40 82 83 82 81 82 8e 81 40 82 83 82 88 82 81 82 8e 82 87 82 85 81 40 82 94 82 88 82 85 81 40 82 8e 82 81 82 8d 82 85 0d 00 01 0a 06 00 01 01 81 40 82 89 82 86 81 40 82 99 82 8f 82 95 81 40 82 97 82 81 82 8e 82 94 81 42 0d 00 00 00 1b fd 10 02 08 02 76 02 1a 00 82 68 81 40 82 97 82 81 82 8e 82 94 81 40 82 81 81 40 82 8e 82 85 82 97 81 40 82 8e 82 81 82 8d 82 85 0d 00 82 68 81 75 82 8c 82 8c 81 40 82 8b 82 85 82 85 82 90 81 40 82 88 82 89 82 93 81 40 82 8e 82 81 82 8d 82 85 0d 00 00 00 12 00 fe 00 64 23 4a d6 1e 00 fe 03 64 20 1b 05 1a 00 82 68 82 93 81 40 01 0a 06 00 01 01 81 40 82 8f 82 8b 82 81 82 99 81 48 0d 00 00 00 1b fd 10 02 08 02 76 02 1a 00 82 68 81 40 82 97 82 81 82 8e 82 94 81 40 82 81 82 8e 82 8f 82 94 82 88 82 85 82 92 81 40 82 8e 82 81 82 8d 82 85 0d 00 82 6e 82 8b 82 81 82 99 0d 00 00 00 12 00 16 00 08 02 fe 00 1d 00 01 00 1e 00 fa 00 4a d5 64 23 19 00 20 00 06 01 00 00 18 00 7a 03 19 00 65 20 65 40 35