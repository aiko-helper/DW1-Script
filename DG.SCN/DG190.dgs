// DG190.SCN
#pragma script index=190 start=0x91000 end=0x91800 headerU16=0x10 sentinelOff=0x24

function playAnimationThenDelayThenSpeak(a, b, c, d) {
    playAnimation(Entity.Player, a);
    delay(b);
    speak(c, d);
}


section onEnter(254) {
    roll(pstat: 110, max: 99);
    if (pstat[110] > 4) goto L1;
    spawnItem(Item.Digimushroom, x: 39, y: 47);
    spawnItem(Item.Digimushroom, x: 39, y: 45);
    spawnItem(Item.Digimushroom, x: 39, y: 49);

L1:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 14) goto L2;
    spawnItem(Item.Digimushroom, x: 44, y: 66);

L2:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 3) goto L3;
    spawnItem(Item.Happymushroom, x: 59, y: 42);

L3:
    spawnChest(Item.MediumRecovery, 938, 1239, 1024, 696);
    spawnChest(Item.MediumMP, 985, 856, 1024, 697);
    spawnChest(Item.Various, 1024, -1604, 1024, 698);
    if (!trigger(152)) goto L4;
    for id in 6..9 { setObjectVisibility(id, 0); }

L4:
    if (!trigger(153)) goto L5;
    for id in 10..18 { setObjectVisibility(id, 0); }

L5:
    return;
}

section(52) {
    if (trigger(154) || !trigger(152) || trigger(153)) goto L1;
    goto section_51.L5;

L1:
    if (!trigger(153) || trigger(228)) goto L2;
    goto section_51.L6;
    goto L3;

L2:
    goto section_51.L9;

L3:
    return;
}

section(51) {
    if (trigger(118)) goto L1;
    goto L4;

L1:
    if (trigger(154) || !trigger(152) || trigger(153)) goto L2;
    goto L5;

L2:
    if (!trigger(153) || trigger(228)) goto L3;
    goto L6;
    goto L4;

L3:
    goto L9;

L4:
    speak(Entity.System, "There are weird drawings\non the ground.\n");
    speak(Entity.Player, "Are they one of those strange\ncircles? They still look new.\n");
    setTrigger(118);
    return;

L5:
    move(entity: Entity.Player, to: (350, -50), sprint: 0, withCamera: true);
    waitForEntity(Entity.Player);
    playAnimationThenDelayThenSpeak(24, 20, Entity.Player, "There are more of them now.\nDo you think they're\nfrom the UFO?\n");
    setTrigger(154);
    return;

L6:
    move(entity: Entity.Player, to: (350, 50), sprint: 1, withCamera: true);
    waitForEntity(Entity.Player);
    playAnimationThenDelayThenSpeak(24, 20, Entity.Player, "Ugghh!?\n");
    move(entity: Entity.Player, to: (-550, 50), sprint: 1, withCamera: true);
    waitForEntity(Entity.Player);
    speak(Entity.Player, "I see a lot more now.\n");
    playAnimation(Entity.Player, 16);
    delay(20);
    showTextbox("Well, I guess it means...\n");
    playSound(8, 5);
    speak(Entity.Player, "What?\n");
    setDigimon(Digimon.NPCVademon, 0, 0);
    look(entity: Entity.Player, at: 5);
    move(entity: Entity.Partner, to: (-750, -50), sprint: 1);
    moveCamera(to: (-183, 723), slowdown: 20);
    waitForEntity(200);
    waitForEntity(Entity.Partner);
    move(entity: 5, to: (225, 1066), sprint: 1);
    playSound(8, 5);
    waitForEntity(5);
    move(entity: 5, to: (-275, 1066), sprint: 0);
    playSound(8, 5);
    waitForEntity(5);
    move(entity: 5, to: (-63, 453), sprint: 0);
    playSound(8, 5);
    waitForEntity(5);
    move(entity: 5, to: (-126, 409), sprint: 0);
    look(entity: Entity.Player, at: 5);
    delay(20);
    speak(Entity.Player, "An Alien?!\n");
    speak(5, "...\n");
    speak(Entity.Player, "Are you a Digimon?\n");
    speak(5, "...\n");
    speak(Entity.Player, "Are you?\n");
    speak(5, "...\n");
    playSound(8, 6);
    delay(10);
    playAnimation(5, 28);
    delay(10);
    playAnimationThenDelayThenSpeak(15, 10, Entity.Player, "I'm not your enemy!\n");
    delay(40);
    playAnimation(5, 0);
    speak(Entity.Player, "Good, now you understand.\n");
    playAnimationThenDelayThenSpeak(19, 20, Entity.System, "<LIGHTBLUE><PLAYER><WHITE> tried\nto convince him.\n");
    speak(5, "...\n");
    speak(Entity.Player, "Maybe he doesn't understand.\n");
    playAnimation(5, 22);
    delay(15);
    playAnimation(5, 22);
    delay(15);
    playAnimation(5, 0);
    speak(5, "Ok.\n");
    fadeOutHUD();
    goto L7;

L7:
    move(entity: 5, to: (155, -1177), sprint: 1);
    if (pstat[101] >= 3) goto L8;
    addPStat(101, 1);
    playSound(8, 5);
    delay(20);
    look(entity: Entity.Player, at: 5);
    look(entity: Entity.Partner, at: 5);
    goto L7;

L8:
    waitForEntity(5);
    unloadEntity(5);
    setPStat(101, 0);
    playSound(8, 8);
    speak(Entity.System, "Vademon joins the city!\n");
    speak(Entity.Player, "Huh?\n");
    showTextbox("He can talk!\n");
    setTrigger(228);
    addPStat(1, 3);
    moveCamera(to: Entity.Player, speed: 10);
    waitForEntity(200);
    return;

L9:
    return;
    garbage { 10 00 fe 00 10 00 34 00 d0 00 33 00 06 01 ff ff 24 00 6e 63 19 00 0b 00 6e 04 18 00 32 00 19 00 74 2c 27 00 2f 00 74 2c 27 00 2d 00 74 2c 27 00 31 00 24 00 6e 63 19 00 0b 00 6e 0e 18 00 48 00 19 00 74 2c 2c 00 42 00 24 00 6e 63 19 00 0b 00 6e 03 18 00 5e 00 19 00 74 45 3b 00 2a 00 75 01 aa 03 00 00 d7 04 00 04 b8 02 75 05 d9 03 00 00 58 03 00 04 b9 02 75 08 00 04 00 00 bc f9 00 04 ba 02 19 00 00 00 98 00 18 00 9e 00 19 00 57 00 06 00 57 00 07 00 57 00 08 00 57 00 09 00 19 00 00 00 99 00 18 00 ce 00 19 00 57 00 0a 00 57 00 0b 00 57 00 0c 00 57 00 0d 00 57 00 0e 00 57 00 0f 00 57 00 10 00 57 00 11 00 57 00 12 00 fe 00 19 00 01 00 9a 00 80 00 98 00 81 00 99 00 18 00 e8 00 19 00 16 00 24 02 19 00 00 00 99 00 81 00 e4 00 18 00 00 01 19 00 16 00 c0 02 16 00 04 01 16 00 46 06 fe 00 19 00 01 00 76 00 18 00 16 01 19 00 16 00 4a 01 19 00 01 00 9a 00 80 00 98 00 81 00 99 00 18 00 2e 01 19 00 16 00 24 02 19 00 00 00 99 00 81 00 e4 00 18 00 46 01 19 00 16 00 c0 02 16 00 4a 01 16 00 46 06 1b ff 1a 00 82 73 82 88 82 85 82 92 82 85 81 40 82 81 82 92 82 85 81 40 82 97 82 85 82 89 82 92 82 84 81 40 82 84 82 92 82 81 82 97 82 89 82 8e 82 87 82 93 0d 00 82 8f 82 8e 81 40 82 94 82 88 82 85 81 40 82 87 82 92 82 8f 82 95 82 8e 82 84 81 42 0d 00 00 00 1b fd 1a 00 82 60 82 92 82 85 81 40 82 94 82 88 82 85 82 99 81 40 }
}
