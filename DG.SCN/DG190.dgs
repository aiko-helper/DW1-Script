// DG190.SCN
#include "functions.dgs"
#pragma script index=190 start=0x8f800 end=0x90000 headerU16=0x14 sentinelOff=0x1875
#include "entities.dgs"

section onEnter(254) {
  spawnChest(Item.DefenseChip, 82, -1000, 3072, 714);
  spawnChest(Item.Autopilot, 32, -1535, 3072, 715);
  spawnChest(Item.BrainChip, 1889, -2267, 1024, 716);
  return;
}

section(5) {
  move(entity: Entity.Partner, to: Entity.Player, sprint: 1);
  waitForEntity(Entity.Player);
  speak(Entity(5), "「カイゾウ ヲ オコナイマス。<NEWLINE> ヒヨウ ト シテ 2000<B><it><NEWLINE> ヒツヨウデス。」<NEWLINE>");
  storeDigimonType(PStat(103));
  if (pstat[103] != 13) {
    speak(Entity(5), "「ケイシキ ガ チガイマス<NEWLINE> カイゾウ デキマセン。」<NEWLINE>");
    return;
  }
  setDialogOwner(Entity.Player);
  setSelection(L1, L2);
  showTextbox("「たのむぜ。」<NEWLINE>「やめてくれー。」<NEWLINE>");
  waitForSelectionChoice();
  return;

L1:
  if (money < 2000) {
    speak(Entity(5), "「ヒヨウ ガ タリマセン。」<NEWLINE>");
    return;
  }
  reduceMoney(2000);
  speak(Entity(5), "「スコシ オマチクダサイ。」<NEWLINE>");
  roll(pstat: PStat.RollScratch, max: 10);
  if (pstat[110] <= 0) {
    speak(Entity(5), "「シッパイシマシタ。シカシ…」<NEWLINE>");
    fadeOutHUD();
    setPStat(PStat(254), 41);
    callDigimonSubroutine(10);
    delay(570);
    speak(Entity.Player, "「おお、ギロモンになった!」<NEWLINE>");
    return;
  }
  if (pstat[110] <= 5) {
    speak(Entity(5), "「セイコウシマシタ!」<NEWLINE>");
    fadeOutHUD();
    setPStat(PStat(254), 27);
    callDigimonSubroutine(10);
    delay(570);
    speak(Entity.Player, "「おお、メタルマメモンになった!」<NEWLINE>");
    return;
  }
  speak(Entity(5), "「シッパイシマシタ…」<NEWLINE>");
  speak(Entity.Player, "「ひ、ひどい!」<NEWLINE>");
  speak(Entity(5), "「スミマセン…」<NEWLINE>");

L2:
  return;
}

section(6) {
  speak(Entity(6), "「ホソク、ハイジョ!」<NEWLINE>");
  finishEncounter(Trigger(292));
}

section(7) {
  speak(Entity(7), "「ダイイチモクヒョウ、テッキノハカイ。」<NEWLINE>");
  finishEncounter(Trigger(292));
  garbage { 14 00 fe 00 14 00 05 00 3a 00 06 00 98 02 07 00 c4 02 ff ff 75 18 52 00 00 00 18 fc 00 0c ca 02 75 16 20 00 00 00 01 fa 00 0c cb 02 75 19 61 07 00 00 25 f7 00 04 cc 02 fe 00 51 fc 01 fd 4a fd 1b 05 1a 00 81 75 83 4a 83 43 83 5d 83 45 81 40 83 92 81 40 83 49 83 52 83 69 83 43 83 7d 83 58 81 42 0d 00 81 40 83 71 83 88 83 45 81 40 83 67 81 40 83 56 83 65 81 40 82 51 82 4f 82 4f 82 4f 81 6f 81 70 0d 00 81 40 83 71 83 63 83 88 83 45 83 66 83 58 81 42 81 76 0d 00 00 00 22 67 19 00 09 00 67 0d 18 00 ea 00 19 00 1b 05 1a 00 81 75 83 50 83 43 83 56 83 4c 81 40 83 4b 81 40 83 60 83 4b 83 43 83 7d 83 58 0d 00 81 40 83 4a 83 43 83 5d 83 45 81 40 83 66 83 4c 83 7d 83 5a 83 93 81 42 81 76 0d 00 00 00 fe 00 1b fd 10 02 1e 01 96 02 1a 00 81 75 82 bd 82 cc 82 de 82 ba 81 42 81 76 0d 00 81 75 82 e2 82 df 82 c4 82 ad 82 ea 81 5b 81 42 81 76 0d 00 00 00 12 00 fe 00 19 00 25 00 00 05 d0 07 00 00 18 00 54 01 19 00 1b 05 1a 00 81 75 83 71 83 88 83 45 81 40 83 4b 81 40 83 5e 83 8a 83 7d 83 5a 83 93 81 42 81 76 0d 00 00 00 fe 00 2b 00 d0 07 00 00 1b 05 1a 00 81 75 83 58 83 52 83 56 81 40 83 49 83 7d 83 60 83 4e 83 5f 83 54 83 43 81 42 81 76 0d 00 00 00 24 00 6e 0a 19 00 0b 00 6e 00 18 00 e6 01 19 00 1b 05 1a 00 81 75 83 56 83 62 83 70 83 43 83 56 83 7d 83 56 83 5e 81 42 83 56 83 4a 83 56 81 63 81 76 0d 00 00 00 27 00 1e 00 fe 29 49 0a 67 00 3a 02 1b fd 1a 00 81 75 82 a8 82 a8 81 41 83 4d 83 8d 83 82 83 93 82 c9 82 c8 82 c1 82 bd 81 49 81 76 0d 00 00 00 fe 00 19 00 0b 00 6e 05 18 00 48 02 19 00 1b 05 1a 00 81 75 83 5a 83 43 83 52 83 45 83 56 83 7d 83 56 83 5e 81 49 81 76 0d 00 00 00 27 00 1e 00 fe 1b 49 0a 67 00 3a 02 1b fd 1a 00 81 75 82 a8 82 a8 81 41 83 81 83 5e 83 8b 83 7d 83 81 83 82 83 93 82 c9 82 c8 82 c1 82 bd 81 49 81 76 0d 00 00 00 fe 00 1b 05 1a 00 81 75 83 56 83 62 83 70 83 43 83 56 83 7d 83 56 83 5e 81 63 81 76 0d 00 00 00 1b fd 1a 00 81 75 82 d0 81 41 82 d0 82 c7 82 a2 81 49 81 76 0d 00 00 00 1b 05 1a 00 81 75 83 58 83 7e 83 7d 83 5a 83 93 81 63 81 76 0d 00 00 00 fe