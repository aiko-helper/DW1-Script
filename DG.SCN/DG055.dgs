// DG055.SCN
#pragma script index=55 start=0x2a000 end=0x2a800 headerU16=0x20 sentinelOff=0x2875

section onEnter(254) {
    spawnChest(Item.Sirloin, 500, 567, 0, 653);
    unsetTrigger(100);
    return;
}

section(5) {
    speak(5, "I'll handle you!\n");
    startBattle();
    setTrigger(307);
    return;
}

section(6) {
    speak(6, "I'll handle you!\n");
    startBattle();
    setTrigger(307);
    return;
}

section(7) {
    speak(7, "I'll handle you!\n");
    startBattle();
    setTrigger(307);
    return;
}

section(83) {
    rotate(entity: Entity.Player, to: 1024);
    delay(5);
    if (!trigger(348)) goto L2;
    if (trigger(100)) goto L1;
    rotate3DObject(2, 1);
    rotate3DObject(3, 1);

L1:
    delay(20);
    speak(Entity.Player, "What does it say?\n");
    speak(Entity.System, "Return to the position\nwhere you got the points\nfrom the dumb one.\n");
    setTrigger(100);
    return;

L2:
    if (item[Item.FridgeKey] < 1 || trigger(348)) goto L3;
    setTrigger(100);
    playSound(8, 3);
    speak(Entity.System, "I used a <LIGHTBLUE>\nrefrigerator key. <WHITE>\n");
    rotate3DObject(2, 1);
    rotate3DObject(3, 1);
    delay(60);
    removeItem(Item.FridgeKey, 1);
    playAnimation(Entity.Player, 24);
    delay(15);
    speak(Entity.Player, "I don't see it.\n");
    playAnimation(Entity.Player, 0);
    speak(Entity.Player, "There's a memo.\n");
    speak(Entity.System, "Return to the position\nwhere you got the points\nfrom the dumb one.\n");
    speak(Entity.Player, "I should listen to this memo.\n");
    setTrigger(348);
    return;

L3:
    if (item[Item.FridgeKey] >= 1 || trigger(348)) goto L4;
    speak(Entity.Player, "It's a refrigerator.\n");
    speak(Entity.Player, "It's locked. I've never seen\na locked fridge.\n");
    return;

L4:
    return;
}

section(81) {
    rotate3DObject(1, 1);
    playSound(8, 1);
    delay(10);
    move(entity: Entity.Player, to: (81, -1600), sprint: 0);
    warp(to: Map.YAKA12, spawn: 0, trigger: 255);
    return;
}

section(82) {
    rotate3DObject(0, 1);
    playSound(8, 1);
    delay(10);
    move(entity: Entity.Player, to: (-117, 1200), sprint: 0);
    warp(to: Map.YAKA15, spawn: 1, trigger: 255);
    return;
