// DG132.SCN
#include "functions.dgs"
#pragma script index=132 start=0x5d000 end=0x5e000 headerU16=0x10 sentinelOff=0xfe
#include "entities.dgs"

section onEnter(254) {
  return;
}

section(51) {
  removeCondition(Condition.Injured);
  removeCondition(Condition.Sick);
  look(entity: 5, at: Entity.Player);
  look(entity: Entity.Partner, at: Entity.Player);
  playAnimation(Entity.Player, 24);
  delay(15);
  speak(Entity.Player, "Where are we?\nIs this a dream?\n");
  playAnimation(Entity.Player, 0);
  rotate(entity: Entity.Player, to: 1050);
  delay(20);
  rotate(entity: Entity.Player, to: 1561);
  delay(20);
  look(entity: Entity.Player, at: 5);
  playAnimation(Entity.Player, 15);
  delay(15);
  speak(Entity.Player, "Wow! Who are you?\nWhere is <ORANGE><DIGIMON><WHITE>?\n");
  playAnimation(Entity.Player, 0);
  rotate(entity: Entity.Player, to: 1050);
  delay(5);
  look(entity: Entity.Player, at: 5);
  speak(5, "Calm down. My name is\nFrigimon. This is my house.\nI'm an Ice Snow Digimon.\n");
  showTextbox("You were out cold in the\nsnow. I picked you up\nand took care of you.\n");
  rotate(entity: Entity.Player, to: 25);
  delay(5);
  look(entity: Entity.Player, at: Entity.Partner);
  speak(Entity.Player, "Oh, <ORANGE><DIGIMON><WHITE>.\nI'm glad you're safe!\n");
  speak(5, "Hey, are you listening?\nIf I didn't find you,\nyou'd be dead by now!\n");
  look(entity: Entity.Player, at: 5);
  playAnimation(Entity.Player, 25);
  delay(15);
  speak(Entity.Player, "Oh, sorry. Gee thanks.\n");
  playAnimation(Entity.Player, 0);
  delay(30);
  look(entity: Entity.Player, at: Entity.Partner);
  playAnimation(Entity.Player, 7);
  delay(15);
  speak(Entity.Player, "Hey, <ORANGE><DIGIMON><WHITE>,\nI even hit my head when\nyou suddenly fell down.\n");
  playAnimation(Entity.Player, 0);
  storeDigimonType(103);
  speak(5, "<DIGIMONTYPE2>can't stand cold.\nYou are so reckless.\nIt's all your fault.\n");
  look(entity: Entity.Player, at: 5);
  delay(20);
  look(entity: Entity.Player, at: Entity.Partner);
  playAnimation(Entity.Player, 19);
  delay(15);
  speak(Entity.Player, "I didn't know.\nI'm sorry, <ORANGE><DIGIMON><WHITE>.\n");
  playAnimation(Entity.Player, 0);
  look(entity: Entity.Player, at: 5);
  speak(Entity.Player, "Thanks, Frigimon. Can I ask\nyou one more favor?\n");
  speak(5, "What will you do if\n<DIGIMONTYPE2>falls down again?\nYou'd better go home soon!\n");
  speak(Entity.Player, "Alright, I got it.\nI'll digivolve <ORANGE><DIGIMON><WHITE>\ninto another Digimon.\n");
  move(entity: Entity.Player, to: (93, -1700), sprint: 1);
  delay(20);
  move(entity: Entity.Partner, to: (93, -1700), sprint: 1);
  delay(20);
  look(entity: 5, at: Entity.Player);
  waitForEntity(Entity.Player);
  waitForEntity(Entity.Partner);
  speak(5, "Digivolve?\n");
  setTrigger(133);
  warp(to: Map.FRZL07, spawn: 2, trigger: 255);
  return;
}

section(5) {
  storeDigimonType(103);
  if (pstat[103] != 3 && pstat[103] != 5 && pstat[103] != 8 && pstat[103] != 9 && pstat[103] != 47) goto L1;
  goto L7;

L1:
  if (pstat[103] != 19 && pstat[103] != 32 && pstat[103] != 51 && pstat[103] != 1 && pstat[103] != 2) goto L2;
  goto L7;

L2:
  if (pstat[103] != 15 && pstat[103] != 16 && pstat[103] != 29 && pstat[103] != 30 && pstat[103] != 43) goto L3;
  goto L7;

L3:
  if (pstat[103] != 44 && pstat[103] != 21) goto L4;
  goto L7;

L4:
  speak(Entity.Player, "Hello again.\n");
  speak(5, "What happen to\nthe other Digimon?\n");
  speak(Entity.Player, "Oh, it's the same one.\n");
  look(entity: 5, at: Entity.Partner);
  speak(5, "Huh? Is that right?\nI don't get it.\n");
  look(entity: 5, at: Entity.Player);
  speak(Entity.Player, "I came here cuz I have\na favor to ask. I want you\nto come to the city.\n");
  speak(5, "What's there for me?\nSomething interesting?\n");
  playAnimation(Entity.Player, 19);
  delay(15);
  speak(Entity.Player, "Well, you can open\nany shop you want.\n");
  playAnimation(Entity.Player, 0);
  playAnimation(5, 11);
  delay(5);
  speak(5, "Wow, I always wanted to do\nthat. Alright, I'll go!\n");
  speak(Entity.Player, "OK, that sounds good.\nThen let's go now.\n");
  speak(5, "A shop! Snow cones and\nice cream. This is\ngonna be great!\n");
  move(entity: 5, to: (-540, -336), sprint: 1);
  waitForEntity(5);
  goto L5;

L5:
  move(entity: 5, to: (93, -1700), sprint: 1);
  if (pstat[101] >= 3) goto L6;
  addPStat(101, 1);
  delay(20);
  look(entity: Entity.Player, at: 5);
  look(entity: Entity.Partner, at: 5);
  goto L5;

L6:
  waitForEntity(5);
  unloadEntity(5);
  setPStat(101, 0);
  playSound(8, 11);
  speak(Entity.System, "Frigimon joins the city!\n");
  setTrigger(223);
  addPStat(1, 2);
  return;

L7:
  speak(5, "That Digimon can't stand\ncold very well!\n");
  playAnimation(Entity.Player, 15);
  delay(15);
  speak(Entity.Player, "I'll be back!\n");
  playAnimation(Entity.Player, 0);
  return;
  garbage { 10 00 fe 00 10 00 33 00 12 00 05 00 50 06 ff ff fe 00 65 20 65 40 4c 00 05 fd 4c 00 fc fd 56 00 fd 18 67 00 0f 00 1b fd 1a 00 82 76 82 88 82 85 82 92 82 85 81 40 82 81 82 92 82 85 81 40 82 97 82 85 81 48 0d 00 82 68 82 93 81 40 82 94 82 88 82 89 82 93 81 40 82 81 81 40 82 84 82 92 82 85 82 81 82 8d 81 48 0d 00 00 00 56 00 fd 00 4d fd 1a 04 67 00 14 00 4d fd 19 06 67 00 14 00 4c 00 fd 05 56 00 fd 0f 67 00 0f 00 1b fd 1a 00 82 76 82 8f 82 97 81 49 81 40 82 76 82 88 82 8f 81 40 82 81 82 92 82 85 81 40 82 99 82 8f 82 95 81 48 0d 00 82 76 82 88 82 85 82 92 82 85 81 40 82 89 82 93 81 40 01 0a 06 00 01 01 81 48 0d 00 00 00 56 00 fd 00 4d fd 1a 04 67 00 05 00 4c 00 fd 05 1b 05 1a 00 82 62 82 81 82 8c 82 8d 81 40 82 84 82 8f 82 97 82 8e 81 42 81 40 82 6c 82 99 81 40 82 8e 82 81 82 8d 82 85 81 40 82 89 82 93 0d 00 82 65 82 92 82 89 82 87 82 89 82 8d 82 8f 82 8e 81 42 81 40 82 73 82 88 82 89 82 93 81 40 82 89 82 93 81 40 82 8d 82 99 81 40 82 88 82 8f 82 95 82 93 82 85 81 42 0d 00 82 68 81 75 82 8d 81 40 82 81 82 8e 81 40 82 68 82 83 82 85 81 40 82 72 82 8e 82 8f 82 97 81 40 82 63 82 89 82 87 82 89 82 8d 82 8f 82 8e 81 42 0d 00 00 00 1a 00 82 78 82 8f 82 95 81 40 82 97 82 85 82 92 82 85 81 40 82 8f 82 95 82 94 81 40 82 83 82 8f 82 8c 82 84 81 40 82 89 82 8e 81 40 82 94 82 88 82 85 0d 00 82 93 82 8e 82 8f 82 97 81 42 81 40 82 68 81 40 82 90 82 89 82 83 82 8b 82 85 82 84 81 40 82 99 82 8f 82 95 81 40 82 95 82 90 0d 00 82 81 82 8e 82 84 81 40 82 94 82 8f 82 8f 82 8b 81 40 82 83 82 81 82 92 82 85 81 40 82 8f 82 86 81 40 82 99 82 8f 82 95 81 42 0d 00 00 00 4d fd 19 00 67 00 05 00 4c 00 fd fc 1b fd 1a 00 82 6e 82 88 81 43 81 40 01 0a 06 00 01 01 81 42 0d 00 82 68 81 75 82 8d 81 40 82 87 82 8c 82 81 82 84 81 40 82 99 82 8f 82 95 81 75 82 92 82 85 81 40 82 93 82 81 82 86 82 85 81 49 0d 00 00 00 1b 05 1a 00 82 67 82 85 82 99 81 43 81 40 82 81 82 92 82 85 81 40 82 99 82 8f 82 95 81 40 82 8c 82 89 82 93 82 94 82 85 82 8e 82 89 82 8e 82 87 81 48 0d 00 82 68 82 86 81 40 82 68 81