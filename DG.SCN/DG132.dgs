// DG132.SCN
#include "functions.dgs"
#pragma script index=132 start=0x56800 end=0x57000 headerU16=0x10 sentinelOff=0x1d
#include "entities.dgs"

section onEnter(254) {
  unsetTrigger(Trigger(116));
  storeDigimonType(PStat(103));
  if (pstat[103] == 14 || trigger(214)) {
  } else {
    anim(Entity(5), Animation(31), wait: 5);
  }
  return;
}

section(5) {
  goto section_81;
}

section(81) {
  setTrigger(Trigger(44));
  storeDigimonType(PStat(103));
  if (trigger(270) || pstat[103] == 14) {
    return;
  }
  anim(Entity.Player, Animation(16), wait: 15);
  speak(Entity.Player, "「何だろう?このぬいぐるみだけ他のと<NEWLINE> ちがう感じがする。何ていうか、いあつ感<NEWLINE> みたいなものがあるな。」<NEWLINE>");
  fadeOutHUD();
  playAnimation(Entity.Player, Animation(0));
  if (trigger(116)) {
    return;
  }
  setTrigger(Trigger(116));
  playAnimation(Entity(5), Animation(28));
  anim(Entity.Player, Animation(15), wait: 40);
  move(entity: Entity.Player, to: (1079, -180), sprint: 0);
  waitForEntity(Entity.Player);
  look(entity: Entity.Player, at: Entity(5));
  delay(10);
  speak(Entity.Player, "「あ、せなかにチャックがある。」<NEWLINE>");
  fadeOutHUD();
  if (pstat[103] == 11) {
    move(entity: Entity.Partner, to: Entity(5), sprint: 0);
    waitForEntity(Entity.Partner);
    look(entity: Entity.Player, at: Entity.Partner);
    delay(5);
    speak(Entity.Player, "「どうした<ORANGE><DIGIMON><WHITE>?!」<NEWLINE>");
    fadeOutHUD();
    delay(10);
    waitForEntity(Entity(5));
    unloadEntity(Entity(5));
    setPStat(PStat(254), 14);
    callDigimonSubroutine(10);
    waitForEntity(Entity.System);
    delay(10);
    speak(Entity.Player, "「え?え!別のデジモンになっちゃったの?<NEWLINE> なんか…得したかな?」<NEWLINE>");
    return;
  }
  speak(Entity.Player, "「<ORANGE><DIGIMON><WHITE>、入ってみるか?」<NEWLINE>");
  look(entity: Entity.Player, at: Entity.Partner);
  move(entity: Entity.Partner, to: (900, 90), sprint: 0);
  waitForEntity(Entity.Partner);
  anim(Entity.Partner, Animation(25), wait: 20);
  anim(Entity.Partner, Animation(13), wait: 30);
  speak(Entity.Player, "「あらら…だめか。思ったより体カタいなあ<NEWLINE> <ORANGE><DIGIMON><WHITE>。もっとやわらかくてヌメッ<NEWLINE> とした体なら入りそうだけど…」<NEWLINE>");
  return;
  garbage { 10 00 fe 00 10 00 05 00 34 00 51 00 38 00 ff ff 1d 00 74 00 22 67 19 00 08 00 67 0e 40 00 d6 00 18 00 2a 00 19 00 16 00 32 00 56 00 05 1f 67 00 05 00 fe 00 16 00 38 00 1c 00 2c 00 22 67 19 00 00 00 0e 01 48 00 67 0e 18 00 50 00 19 00 fe 00 56 00 fd 10 67 00 0f 00 1b fd 1a 00 81 75 89 bd 82 be 82 eb 82 a4 81 48 82 b1 82 cc 82 ca 82 a2 82 ae 82 e9 82 dd 82 be 82 af 91 bc 82 cc 82 c6 0d 00 81 40 82 bf 82 aa 82 a4 8a b4 82 b6 82 aa 82 b7 82 e9 81 42 89 bd 82 c4 82 a2 82 a4 82 a9 81 41 82 a2 82 a0 82 c2 8a b4 0d 00 81 40 82 dd 82 bd 82 a2 82 c8 82 e0 82 cc 82 aa 82 a0 82 e9 82 c8 81 42 81 76 0d 00 00 00 27 00 56 00 fd 00 19 00 00 00 74 00 18 00 de 00 19 00 fe 00 1c 00 74 00 56 00 05 1c 56 00 fd 0f 67 00 28 00 4e fd 37 04 4c ff 00 00 4a fd 4c 00 fd 05 67 00 0a 00 1b fd 1a 00 81 75 82 a0 81 41 82 b9 82 c8 82 a9 82 c9 83 60 83 83 83 62 83 4e 82 aa 82 a0 82 e9 81 42 81 76 0d 00 00 00 27 00 19 00 08 00 67 0b 18 00 c4 01 19 00 51 fc 00 05 4a fc 4c 00 fd fc 67 00 05 00 1b fd 1a 00 81 75 82 c7 82 a4 82 b5 82 bd 01 0a 06 00 01 01 81 48 81 49 81 76 0d 00 00 00 27 00 67 00 0a 00 4a 05 48 05 1e 00 fe 0e 49 0a 4a ff 67 00 0a 00 1b fd 1a 00 81 75 82 a6 81 48 82 a6 81 49 95 ca 82 cc 83 66 83 57 83 82 83 93 82 c9 82 c8 82 c1 82 bf 82 e1 82 c1 82 bd 82 cc 81 48 0d 00 81 40 82 c8 82 f1 82 a9 81 63 93 be 82 b5 82 bd 82 a9 82 c8 81 48 81 76 0d 00 00 00 fe 00 1b fd 1a 00 81 75 01 0a 06 00 01 01 81 41 93 fc 82 c1 82 c4 82 dd 82 e9 82 a9 81 48 81 76 0d 00 00 00 4c 00 fd fc 4e fc 84 03 5a 00 00 00 4a fc 56 00 fc 19 67 00 14 00 56 00 fc 0d 67 00 1e 00 1b fd 1a 00 81 75 82 a0 82 e7 82 e7 81 63 82 be 82 df 82 a9 81 42 8e 76 82 c1 82 bd 82 e6 82 e8 91 cc 83 4a 83 5e 82 a2 82 c8 82 a0 0d 00 81 40 01 0a 06 00 01 01 81 42 82 e0 82 c1 82 c6 82 e2 82 ed 82 e7 82 a9 82 ad 82 c4 83 6b 83 81 83 62 0d 00 81 40 82 c6 82 b5 82 bd 91 cc 82 c8 82 e7 93 fc 82 e8 82 bb 82 a4 82 be 82 af 82 c7 81 63 81 76 0d 00 00 00 fe 00 ff 00 82 e8 82 aa 82 a0 82 e9 82 cc 82 be 81 42 81 76 0d 00 00 00 1a 00 81 75 8e