// DG178.SCN
#include "functions.dgs"
#pragma script index=178 start=0x82000 end=0x83800 headerU16=0x10 sentinelOff=0x1e
#include "entities.dgs"

section onEnter(254) {
  setPStat(PStat(254), 0);
  callSubroutine(25);
  return;
  return;
}

section(54) {
  move(entity: Entity.Partner, to: (229, -2733), animDuration: 2);
  rotate(entity: Entity.Player, to: 2048);
  look(entity: Entity(10), at: Entity.Player);
  delay(5);
  anim(Entity.Player, Animation(18), wait: 5);
  panTo(x: 200, y: -2000, slowdown: 30);
  delay(20);
  delay(60);
  anim(Entity(8), Animation(29), wait: 5);
  speak(Entity(8), "「む…気がついたか?<NEWLINE> どうやら成功のようじゃぞ!」<NEWLINE>");
  playAnimation(Entity(8), Animation(0));
  playAnimation(Entity(10), Animation(11));
  anim(Entity(12), Animation(11), wait: 5);
  speak(Entity(12), "「にんげん…<NEWLINE> じっちゃんの言ってたとおりだー。」<NEWLINE>");
  playAnimation(Entity(10), Animation(0));
  playAnimation(Entity(12), Animation(0));
  speak(Entity.Player, "「うーーん…」<NEWLINE>");
  anim(Entity(8), Animation(29), wait: 5);
  speak(Entity(8), "「しっ、起きるぞ!」<NEWLINE>");
  setPStat(PStat(254), 253);
  callSubroutine(55);
  playAnimation(Entity(8), Animation(0));
  speak(Entity.Player, "「うん…?ここ…どこ?」<NEWLINE>");
  anim(Entity(8), Animation(29), wait: 5);
  speak(Entity(8), "「ようこそ、デジモンワールドへ!」<NEWLINE>");
  playAnimation(Entity(8), Animation(0));
  speak(Entity.Player, "「へ?」<NEWLINE>");
  look(entity: Entity.Player, at: Entity(8));
  delay(5);
  anim(Entity.Player, Animation(15), wait: 10);
  speak(Entity.Player, "「わぁーー!!!」<NEWLINE>");
  anim(Entity(10), Animation(5), wait: 5);
  speak(Entity(10), "「えっ?何?何?」<NEWLINE>");
  playAnimation(Entity(10), Animation(0));
  playAnimation(Entity.Player, Animation(20));
  speak(Entity.Player, "「な、な、なんだよお前らは!?」<NEWLINE>");
  playAnimation(Entity.Player, Animation(0));
  look(entity: Entity.Player, at: Entity(10));
  delay(10);
  look(entity: Entity.Player, at: Entity(8));
  delay(10);
  anim(Entity(8), Animation(29), wait: 5);
  speak(Entity(8), "「デジモンじゃ。」<NEWLINE>");
  playAnimation(Entity(8), Animation(0));
  speak(Entity.Player, "「デジモン!?って…」<NEWLINE>");
  anim(Entity(8), Animation(29), wait: 5);
  speak(Entity(8), "「ん?おぬしはデジモンを知っておる<NEWLINE> はずじゃが…?」<NEWLINE>");
  playAnimation(Entity(8), Animation(0));
  anim(Entity.Player, Animation(16), wait: 10);
  speak(Entity.Player, "「ん?ははーん、そっか、これって<NEWLINE> 夢だろ?そーかそーか。」<NEWLINE>");
  anim(Entity(10), Animation(12), wait: 5);
  speak(Entity(10), "「夢じゃないやい!ホンモノだい!」<NEWLINE>");
  playAnimation(Entity(10), Animation(0));
  look(entity: Entity.Player, at: Entity(10));
  delay(10);
  speak(Entity.Player, "「おっ。お前はトコモンじゃん。<NEWLINE> なるほど確かにデジモンだ。<NEWLINE> リアルな夢だな~。」<NEWLINE>");
  anim(Entity(8), Animation(29), wait: 5);
  speak(Entity(8), "「あ~オホン。いいか<LIGHTBLUE><PLAYER><WHITE>。これは<NEWLINE> 夢ではない。まぁ現実ともちがうが…」<NEWLINE>");
  playAnimation(Entity(8), Animation(0));
  look(entity: Entity.Player, at: Entity(8));
  delay(10);
  speak(Entity.Player, "「何言ってんだよ。じゃなきゃ何で<NEWLINE> お前は俺の名前を知ってるんだよ。<NEWLINE> だいたいお前は誰だよ?」<NEWLINE>");
  anim(Entity(8), Animation(29), wait: 5);
  speak(Entity(8), "「わしはジジモン。」<NEWLINE>");
  playAnimation(Entity(8), Animation(0));
  playAnimation(Entity.Player, Animation(16));
  speak(Entity.Player, "「えー、そんなデジモンいたっけか?」<NEWLINE>");
  anim(Entity(8), Animation(29), wait: 5);
  speak(Entity(8), "「ふふん、おぬしの知っているデジモン<NEWLINE> だけが全てではないんじゃよ。<NEWLINE> 何せここはデジモンワールドじゃから。」<NEWLINE>");
  playAnimation(Entity(8), Animation(0));
  speak(Entity.Player, "「デジモン…ワールド…」<NEWLINE>");
  rotate(entity: Entity(8), to: 1600);
  delay(5);
  anim(Entity(8), Animation(29), wait: 5);
  speak(Entity(8), "「ここは夢でも現実でもない世界。<NEWLINE> デジモンの世界なのじゃ!」<NEWLINE>");
  playAnimation(Entity(8), Animation(0));
  playAnimation(Entity.Player, Animation(16));
  speak(Entity.Player, "「うー、何か、そう言われると…<NEWLINE> 夢にしてはリアルすぎるもんな…」<NEWLINE>");
  look(entity: Entity(8), at: Entity.Player);
  delay(5);
  anim(Entity(8), Animation(29), wait: 5);
  speak(Entity(8), "「うしろを見ろ。これで、はっきり<NEWLINE> するじゃろ。」<NEWLINE>");
  playAnimation(Entity(8), Animation(0));
  speak(Entity.Player, "「えっ?」<NEWLINE>");
  rotate(entity: Entity.Player, to: 0);
  delay(10);
  playAnimation(Entity.Player, Animation(15));
  look(entity: Entity.Partner, at: Entity.Player);
  delay(20);
  move(entity: Entity.Partner, to: (229, -2533), sprint: 0);
  waitForEntity(Entity.Partner);
  anim(Entity.Partner, Animation(11), wait: 20);
  playAnimation(Entity.Player, Animation(20));
  speak(Entity.Player, "「もしかして…<NEWLINE> 俺が育ててた<ORANGE><DIGIMON><WHITE>か?」<NEWLINE>");
  playAnimation(Entity.Player, Animation(0));
  anim(Entity.Partner, Animation(0), wait: 5);
  speak(Entity.Player, "「そうだ…!俺、キーホルダーの<NEWLINE> 中にすいこまれて…」<NEWLINE>");
  anim(Entity(8), Animation(29), wait: 5);
  speak(Entity(8), "「そうじゃ。わかったか。」<NEWLINE>");
  playAnimation(Entity(8), Animation(0));
  look(entity: Entity.Player, at: Entity(8));
  delay(20);
  speak(Entity.Player, "「わかったけど…なんで俺…ここに?」<NEWLINE>");
  anim(Entity(8), Animation(29), wait: 5);
  speak(Entity(8), "「ふむ…わかってくれたところで、<NEWLINE> わし達の家に来てくれ。<NEWLINE> つづきはそこで話そう。」<NEWLINE>");
  warp(to: Map.ROOM08, spawn: 1, trigger: 54);
}

section(55) {
  panTo(x: 183, y: 221, slowdown: 20);
  delay(20);
  unsetTrigger(Trigger(55));
  storeDigimonType(PStat(103));
  if (pstat[103] == 3) {
    setStats(offense: 80, defense: 60, speed: 70, brains: 70, maxHP: 800, maxMP: 600, currentHP: 800, currentMP: 600);
  } else {
    setStats(offense: 70, defense: 80, speed: 60, brains: 70, maxHP: 700, maxMP: 700, currentHP: 700, currentMP: 700);
  }
  removeItems([
    :LargeRecovery, :SuperRecovery, :MediumMP, :LargeMP,
    :Omnipotent, :Restore, :SuperRestore, :SuperOffenseDisk,
    :SuperDefenseDisk, :SuperSpeedDisk, :BlueApple, :SpinyGreen,
    :MoldyMeat, :Medicine, :MansionKey, :IceCrystal,
    :CyberPart, :Unihorn, :Sunglasses, :XBandage,
    :Fertilizer, :Steak, :Leomonstone, :RainPlant,
    :PortaPotty, :Autopilot, :IronHoof, :SteelDrill,
    :TornTatter, :NorthStar, :MetalPart, :FatalBone,
    :SmallSpear, :SpikeClub, :HairGrower, :MonoStone,
    :FlamingMane, :Waterbottle, :Rooster, :MystyEgg,
    :RedRuby, :RedShell, :HornHelmet, :ScissorJaw,
    :Beetlepearl, :Digiseabass, :ChainMelon, :RayGun,
    :CoralCharm, :GigaHand, :NobleMane, :MetalBanana,
    :Rainbowhorn, :KogaLaws, :HardScale, :BlueCrystal,
    :SilverBall, :MetalArmor
  ], 99);
  reduceMoney(50000);
  setInventorySize(10);
  look(entity: Entity.Partner, at: Entity.Player);
  delay(5);
  speak(Entity(5), "「さて続けよう。<NEWLINE> おぬしを呼んだのはこのわしじゃ。<NEWLINE> わし達を救ってもらうためにの。」<NEWLINE>");
  playAnimation(Entity(5), Animation(0));
  speak(Entity.Player, "「救う???<NEWLINE> どうしてさ。なんかまずいの?」<NEWLINE>");
  anim(Entity(5), Animation(29), wait: 5);
  speak(Entity(5), "「今わしたちのいるところは、ファイル島<NEWLINE> とよばれている島の真ん中にある<NEWLINE> 『はじまりの街』という場所じゃ。」<NEWLINE>");
  anim(Entity.Player, Animation(16), wait: 10);
  speak(Entity.Player, "「街?ここが?ずいぶん小さくて<NEWLINE> ボロいけど。」<NEWLINE>");
  playAnimation(Entity.Player, Animation(0));
  anim(Entity(5), Animation(29), wait: 5);
  speak(Entity(5), "「ふふ…まあ元は街だったというべきか。<NEWLINE> だが昔は全ての種類のデジモンが<NEWLINE> ここでくらしていたんじゃよ。」<NEWLINE>");
  playAnimation(Entity(5), Animation(0));
  anim(Entity(5), Animation(29), wait: 5);
  speak(Entity(5), "「しかしな…いつからかデジモンたちは<NEWLINE> 『心』を失い始めてな…。みんな、街の<NEWLINE> 外へちりぢりになっていったのじゃ。」<NEWLINE>");
  speak(Entity.Player, "「どういうことさ?」<NEWLINE>");
  playAnimation(Entity(5), Animation(0));
  anim(Entity(5), Animation(29), wait: 5);
  speak(Entity(5), "「原因はわからん…<NEWLINE> デジモンたちが…言葉を話せなく<NEWLINE> なってきておるのでな…」<NEWLINE>");
  playAnimation(Entity(5), Animation(0));
  anim(Entity(5), Animation(29), wait: 5);
  speak(Entity(5), "「まだ少しは話せるものもおるが…<NEWLINE> 街でくらしていた記憶を失っておる。」<NEWLINE>");
  playAnimation(Entity(5), Animation(0));
  speak(Entity.Player, "「そうか、それが『心』を失っているって<NEWLINE> ことか。」<NEWLINE>");
  anim(Entity(5), Animation(30), wait: 5);
  speak(Entity(5), "「うむ。このままでは危険なのじゃ。<NEWLINE> 言い伝えでは『はじまりの街』の危機は<NEWLINE> デジモンの危機じゃといわれておるし…」<NEWLINE>");
  playAnimation(Entity(5), Animation(0));
  speak(Entity.Player, "「でもさ、何で俺なのよ。べつに<NEWLINE> 誰でもいいんじゃないの?」<NEWLINE>");
  anim(Entity(5), Animation(29), wait: 5);
  speak(Entity(5), "「おぬしはデジモンを育てるのが<NEWLINE> 得意じゃろう?」<NEWLINE>");
  playAnimation(Entity(5), Animation(0));
  speak(Entity.Player, "「へっ?…ああ。大得意さ!てへへ。」<NEWLINE>");
  anim(Entity(5), Animation(29), wait: 5);
  speak(Entity(5), "「気づかぬか?おぬしはデジモンの言葉を<NEWLINE> しゃべっておるのじゃぞ。」<NEWLINE>");
  playAnimation(Entity(5), Animation(0));
  speak(Entity.Player, "「ええっ、俺ふつうに日本語しゃべってる<NEWLINE> と思うけど?」<NEWLINE>");
  anim(Entity(5), Animation(29), wait: 5);
  speak(Entity(5), "「わしらにはちゃんとデジモンの言葉に<NEWLINE> 聞こえておるぞ。」<NEWLINE>");
  playAnimation(Entity(5), Animation(0));
  playAnimation(Entity(6), Animation(11));
  anim(Entity(7), Animation(11), wait: 5);
  speak(Entity(6), "「うんうん。」<NEWLINE>");
  playAnimation(Entity(6), Animation(0));
  playAnimation(Entity(7), Animation(0));
  anim(Entity(5), Animation(29), wait: 5);
  speak(Entity(5), "「つまりな、現実でのデジモンへの<NEWLINE> 愛情が、そのままこの世界での能力に<NEWLINE> なって現われているのじゃよ。」<NEWLINE>");
  playAnimation(Entity(5), Animation(0));
  speak(Entity.Player, "「へ、へぇーー。てれるぜ。」<NEWLINE>");
  anim(Entity(5), Animation(29), wait: 5);
  speak(Entity(5), "「これがわしがおぬしを選んだ理由じゃ。<NEWLINE> おぬしなら、ファイル島中のデジモンを<NEWLINE> ここに集めることができるはず!」<NEWLINE>");
  playAnimation(Entity(5), Animation(0));
  speak(Entity.Player, "「お」<NEWLINE>");
  speak(Entity.Player, "「おお」<NEWLINE>");
  speak(Entity.Player, "「おおー!そ、そうか、なるほどー!<NEWLINE> やーっと全部わかったよ!あはは!<NEWLINE> この俺にまかしておきなって!」<NEWLINE>");
  for x in [Entity.Player, Entity(6), Entity(7)] {
    playAnimation(x, Animation(11));
  }
  delay(5);
  speak(Entity(6), "「わーい、やったやったー!」<NEWLINE>");
  playAnimation(Entity(6), Animation(0));
  playAnimation(Entity(7), Animation(0));
  anim(Entity(5), Animation(31), wait: 5);
  speak(Entity(5), "「うむうむ、ありがとう。<NEWLINE> 勝手なたのみなのはわかっておるが、<NEWLINE> わしらにはもう、おぬししかおらん。」<NEWLINE>");
  playAnimation(Entity(5), Animation(0));
  speak(Entity.Player, "「へへへ。まずはどうすればいい?」<NEWLINE>");
  anim(Entity(5), Animation(29), wait: 5);
  speak(Entity(5), "「おぬしはこれから、<ORANGE><DIGIMON><WHITE>を<NEWLINE> 『パートナー』として、2人で<NEWLINE> ファイル島をめぐってくれ。」<NEWLINE>");
  playAnimation(Entity(5), Animation(0));
  anim(Entity(5), Animation(29), wait: 5);
  speak(Entity(5), "「そして、異変の原因をさぐりつつ、<NEWLINE> デジモンを説得して、この街に<NEWLINE> 呼びよせてほしいのじゃ。」<NEWLINE>");
  anim(Entity.Player, Animation(22), wait: 10);
  anim(Entity.Player, Animation(22), wait: 10);
  anim(Entity.Player, Animation(0), wait: 2);
  speak(Entity.Player, "「うん、わかったぜ。<NEWLINE> よーーーし、いくぞぉ、<ORANGE><DIGIMON><WHITE>!」<NEWLINE>");
  rotate(entity: Entity.Player, to: 0);
  delay(10);
  move(entity: Entity.Player, to: (-108, -1728), sprint: 1);
  delay(20);
  move(entity: Entity.Partner, to: (-108, -1728), sprint: 1);
  delay(20);
  playAnimation(Entity(5), Animation(0));
  anim(Entity(5), Animation(29), wait: 5);
  speak(Entity(5), "「お、おーい、まだ続きが…」<NEWLINE>");
  playAnimation(Entity(5), Animation(0));
  warp(to: Map.TWNA01, spawn: 2, trigger: 255);
  return;
  garbage { 10 00 fe 00 10 00 36 00 1a 00 37 00 cc 07 ff ff 1e 00 fe 00 64 19 fe 00 fe 00 6c fc e5 00 53 f5 02 00 4d fd 00 08 4c 00 0a fd 67 00 05 00 56 00 fd 12 67 00 05 00 4f 1e c8 00 30 f8 4a c8 67 00 14 00 67 00 3c 00 56 00 08 1d 67 00 05 00 1b 08 1a 00 81 75 82 de 81 63 8b 43 82 aa 82 c2 82 a2 82 bd 82 a9 81 48 0d 00 81 40 82 c7 82 a4 82 e2 82 e7 90 ac 8c f7 82 cc 82 e6 82 a4 82 b6 82 e1 82 bc 81 49 81 76 0d 00 00 00 56 00 08 00 56 00 0a 0b 56 00 0c 0b 67 00 05 00 1b 0c 1a 00 81 75 82 c9 82 f1 82 b0 82 f1 81 63 0d 00 81 40 82 b6 82 c1 82 bf 82 e1 82 f1 82 cc 8c be 82 c1 82 c4 82 bd 82 c6 82 a8 82 e8 82 be 81 5b 81 42 81 76 0d 00 00 00 56 00 0a 00 56 00 0c 00 1b fd 1a 00 81 75 82 a4 81 5b 81 5b 82 f1 81 63 81 76 0d 00 00 00 56 00 08 1d 67 00 05 00 1b 08 1a 00 81 75 82 b5 82 c1 81 41 8b 4e 82 ab 82 e9 82 bc 81 49 81 76 0d 00 00 00 1e 00 fe fd 64 37 56 00 08 00 1b fd 1a 00 81 75 82 a4 82 f1 81 63 81 48 82 b1 82 b1 81 63 82 c7 82 b1 81 48 81 76 0d 00 00 00 56 00 08 1d 67 00 05 00 1b 08 1a 00 81 75 82 e6 82 a4 82 b1 82 bb 81 41 83 66 83 57 83 82 83 93 83 8f 81 5b 83 8b 83 68 82 d6 81 49 81 76 0d 00 00 00 56 00 08 00 1b fd 1a 00 81 75 82 d6 81 48 81 76 0d 00 00 00 4c 00 fd 08 67 00 05 00 56 00 fd 0f 67 00 0a 00 1b fd 1a 00 81 75 82 ed 82 9f 81 5b 81 5b 81 49 81 49 81 49 81 76 0d 00 00 00 56 00 0a 05 67 00 05 00 1b 0a 1a 00 81 75 82 a6 82 c1 81 48 89 bd 81 48 89 bd 81 48 81 76 0d 00 00 00 56 00 0a 00 56 00 fd 14 1b fd 1a 00 81 75 82 c8 81 41 82 c8 81 41 82 c8 82 f1 82 be 82 e6 82 a8 91 4f 82 e7 82 cd 81 49 81 48 81 76 0d 00 00 00 56 00 fd 00 4c 00 fd 0a 67 00 0a 00 4c 00 fd 08 67 00 0a 00 56 00 08 1d 67 00 05 00 1b 08 1a 00 81 75 83 66 83 57 83 82 83 93 82 b6 82 e1 81 42 81 76 0d 00 00 00 56 00 08 00 1b fd 1a 00 81 75 83 66 83 57 83 82 83 93 81 49 81 48 82 c1 82 c4 81 63 81 76 0d 00 00 00 56 00 08 1d 67 00 05 00 1b 08 1a 00 81 75 82 f1 81 48 82 a8 82 ca 82 b5 82 cd 83 66 83 57 83 82 83 93 82 f0 92 6d 82 c1 82 c4 82 a8 82 e9 0d 00 81 40 82 cd 82 b8 82 b6 82 e1 82 aa 81