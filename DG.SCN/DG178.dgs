section section_85(85) {  // len=658
    if (trigger(94)) goto L_01ea;
    setTrigger(94);
    setDialogOwner(Entity.Player);
    showTextbox("What's this machine?\n");
    look(entity: 5, at: Entity.Player);
    look(entity: Entity.Player, at: 5);
    delay(5);
    setDialogOwner(5);
    showTextbox("Oh that? That is a\n<PINK>Save Machine for\nMemory Card Battle Data<WHITE>.\n");
    showTextbox("Using that machine, you can\nsave your current partner's\ndata for battle.\n");
    showTextbox("Just press <LIGHTBLUE><X> <WHITE>,\nand the machine will tell\nyou what to do.\n");
    rotate(entity: Entity.Player, to: 0);
    delay(5);
    return;
L_01ea:
    setDialogOwner(Entity.System);
    showTextbox("Do you want to use\n<PINK>Save Machine for\nMemory Card Battle Data<WHITE>?\n");
    setSelection(L_028a, L_0290);
    showTextbox("Yes\nNo\n");
    waitForSelectionChoice();
    return;
L_028a:
    fadeOutHUD();
    callSubroutine(48);
    return;
L_0290:
    return;
}

section section_82(82) {  // len=480
    rotate(entity: Entity.Player, to: 3072);
    delay(5);
    playSound(0, 0);
    if (!trigger(231) && !trigger(245) && !trigger(233) && !trigger(247)) goto L_0090;
    setDialogOwner(Entity.Player);
    showTextbox("I don't see Punimon, but\nI think I'll rest here.\n");
    goto L_018a;
L_0090:
    setDialogOwner(Entity.System);
    showTextbox("<YELLOW>Punimon <WHITE>\nI'm Punimon! Why don't you\nrest here a while?\n");
    showTextbox("<YELLOW>Punimon <WHITE>\nOne hour rest recovers HP,\nMP and lowers Tiredness.\n");
L_018a:
    setDialogOwner(Entity.Player);
    setSelection(L_01be, L_01da);
    showTextbox("Rest\nDon't rest\n");
    waitForSelectionChoice();
    playSound(0, 1);
    return;
L_01be:
    storeDate(105);
    addMinutesToDate(105, 60);
    advanceToDate(105);
    addStats(Stat.CurrentHP, 300);
    addStats(Stat.CurrentMP, 300);
    reduceStats(Stat.Tiredness, 10);
    warp(to: Map.ROOM08, spawn: 2, trigger: 255);
    return;
L_01da:
    playSound(0, 1);
    return;
}

