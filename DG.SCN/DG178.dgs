// DG178.SCN
#pragma script index=178 start=0x87000 end=0x89800 headerU16=0x40 sentinelOff=0x19

section onEnter(254) {  // len=58
    if (!trigger(231) && !trigger(245) && !trigger(233) && !trigger(247)) goto L_001c;
    setObjectVisibility(7, 1);
L_001c:
    if (!trigger(203)) goto L_0030;
    setObjectVisibility(8, 1);
    goto L_0038;
L_0030:
    setRectImpassible(40, 38, 2, 2);
L_0038:
    return;
}

section section_54(54) {  // len=8
    jumpToScriptSection(193, 55);
    return;
}

section section_5(5) {  // len=2296
    if (trigger(202) || trigger(215) || pstat[16] == 0) goto L_0224;
    if (!trigger(201) || !trigger(243)) goto L_0224;
    setDialogOwner(5);
    showTextbox("You had perfect timing in\ncoming here! I have a favor\nthat only you can do.\n");
    setDialogOwner(Entity.Player);
    showTextbox("What is it?\n");
    setDialogOwner(5);
    showTextbox("I just got the same evil\nfeeling that Analogman\nand Machinedramon give.\n");
    showTextbox("I know where it comes from.\n");
    setDialogOwner(Entity.Player);
    showTextbox("Again? Ok, leave it to me!\n");
    setDialogOwner(5);
    showTextbox("Thanks. By the way...\n");
    goto L_073c;
L_0224:
    if (!trigger(202) || trigger(215)) goto L_052a;
    setDialogOwner(5);
    showTextbox("I heard you beat\nMachinedramon!\n");
    setDialogOwner(Entity.Player);
    showTextbox("Yeah, but I don't get it.\nIt seemed like the curse\nof Analogman.\n");
    setDialogOwner(5);
    showTextbox("His grudge was so strong.\nMaybe we can have peace now.\n");
    setDialogOwner(Entity.Player);
    showTextbox("If Machinedramon returns,\nwe'll beat him again.\n");
    setDialogOwner(5);
    showTextbox("You're trustworthy. This was\ngrowing in our Meat farm,\nit's for you.\n");
    setDialogOwner(Entity.Player);
    showTextbox("Woah! A <LIGHTBLUE>Chained\nMelon<WHITE>?\n");
    giveItem(Item.ChainMelon, 1);
    if (!trigger(0)) goto L_0504;
    if (item[Item.SpikeClub] < 99) goto L_04c4;
    return;
L_04c4:
    setDialogOwner(Entity.Player);
    showTextbox("I have too many Items.\n");
    setTrigger(3);
    callSubroutine(0);
    callSubroutine(13);
    giveItem(Item.ChainMelon, 1);
L_0504:
    setDialogOwner(Entity.Player);
    showTextbox("Thank you!\n");
    setPStat(28, 0);
    setTrigger(215);
    return;
L_052a:
    if (!trigger(50) || trigger(201)) goto L_073c;
    setDialogOwner(5);
    showTextbox("You're here!\nThis is something I can't\nask anybody else.\n");
    setDialogOwner(Entity.Player);
    showTextbox("Never fear, I'm here.\nDo you mean\nAnalogman is back?\n");
    setDialogOwner(5);
    showTextbox("I can feel his evil, but\nI can't tell where it is.\n");
    setDialogOwner(Entity.Player);
    showTextbox("Leave it up to me! I'll find\nhim and take care of it.\n");
    setDialogOwner(5);
    showTextbox("Thank you.\nBy the way...\n");
    setTrigger(201);
L_073c:
    if (!trigger(203)) goto L_074e;
    jumpToScriptSection(210, 51);
L_074e:
    if (trigger(55)) goto section_6;
    playAnimation(5, 0);
    playAnimation(5, 29);
    delay(5);
    setDialogOwner(5);
    showTextbox("I'm back and I'm planning\nto rebuild File City with\nhelp from <ORANGE><DIGIMON><WHITE>.\n");
    playAnimation(5, 0);
    playAnimation(5, 29);
    delay(5);
    setDialogOwner(5);
    showTextbox("I want to build\nshops that are useful\nto you and <ORANGE><DIGIMON><WHITE>.\n");
    playAnimation(5, 0);
    playAnimation(5, 29);
    delay(5);
    setDialogOwner(5);
    showTextbox("You should explore Native\nForest just outside the city.\n");
    playAnimation(5, 0);
    return;
}

section section_6(6) {  // len=2460
    if (trigger(56)) goto L_0156;
    if (!trigger(96) && pstat[18] < 10) goto L_0020;
    goto L_0156;
L_0020:
    setDialogOwner(6);
    showTextbox("You can have this. Good luck.\n");
    setDialogOwner(Entity.System);
    showTextbox("I got lots of Items!\n");
    giveItem(Item.SmallRecovery, 3);
    giveItem(Item.Meat, 3);
    giveItem(Item.MPFloppy, 3);
    giveItem(Item.Restore, 1);
    giveItem(Item.Bandage, 2);
    giveItem(Item.Medicine, 1);
    setDialogOwner(6);
    showTextbox("To look up Items, press\n<GREEN><TRIANGLE> <WHITE>...\n");
    showTextbox("...then select 'Item'\nand look by using\n<LIGHTBLUE><X> <WHITE>.\n");
    setTrigger(56);
    return;
L_0156:
    if (trigger(224) || !trigger(175)) goto L_01ca;
    setDialogOwner(6);
    showTextbox("Sounds like Yuramon has\ngathered more rumors.\n");
    return;
L_01ca:
    if (!trigger(124) || !trigger(103)) goto L_022a;
    setDialogOwner(6);
    showTextbox("I hear Yuramon\nhas some new rumors.\n");
    return;
L_022a:
    if (pstat[1] < 6) goto L_02b4;
    setDialogOwner(6);
    showTextbox("The city is starting to\ngrow and I hear it's\nchanging now.\n");
    return;
L_02b4:
    setDialogOwner(6);
    showTextbox("I will teach you about the\ncommon sense in our world.\n");
    showTextbox("There are twenty four hours\na day and there is morning,\nday and night.\n");
    showTextbox("You may feel\nthe pace is quick.\n");
    showTextbox("There are thirty days a year.\nMonth? What's that? Seasons?\nCan you eat that?\n");
    showTextbox("Of course we have money.\nThe unit is a bit. You can\nnever have too much money.\n");
    showTextbox("When you say 'city' on\nthis island, that means here.\n");
    showTextbox("But there are other\nsmall villages and towns.\n");
    showTextbox("On the clock, the yellow dot\nis hours and the needle is\nminutes.\n");
    showTextbox("Up is Midnight\nand Down is Noon.\n");
    showTextbox("The red part on the left\nmeans late afternoon. It\nshows four - eight o'clock.\n");
    showTextbox("The purple part on the\nright is morning and it\nshows four - eight o'clock.\n");
    showTextbox("Digimon are active at\ncertain times of day.\n");
    showTextbox("Most of them get up in the\nmorning and sleep at night,\nbut some are opposite.\n");
    showTextbox("If you can't meet the\nDigimon you wish, try\na different time of day.\n");
    return;
}

section section_7(7) {  // len=1922
    if (trigger(54)) goto L_0014;
    jumpToScriptSection(209, 5);
    return;
L_0014:
    roll(pstat: 110, max: 2);
    if (pstat[1] < 3 || pstat[110] != 0) goto L_0094;
    setDialogOwner(7);
    showTextbox("Talk to Tsunomon and\nYuramon as often as you can.\n");
    return;
L_0094:
    if (pstat[1] < 3 || pstat[110] != 1) goto L_028a;
    setDialogOwner(7);
    showTextbox("I'll tell you about\nthe Tamer level.\n");
    showTextbox("With a high Tamer level,\nwhen your Digimon fades away,\n");
    showTextbox("your next Digimon will have\nbetter parameters.\n");
    showTextbox("In the beginning\nit won't go up much,\n");
    showTextbox("but keep steadily raising him\nand it will get better.\n");
    return;
L_028a:
    if (pstat[1] < 3 || pstat[110] != 2) goto L_03ec;
    setDialogOwner(7);
    showTextbox("When you use your Finishing\nTechnique, make sure to\nrapidly hit L and R buttons.\n");
    showTextbox("When Finish Gauge is full,\ncompared to when empty, the\ndamage to enemy is double!\n");
    return;
L_03ec:
    setDialogOwner(7);
    showTextbox("I'll tell you about a\nDigimon's life.\n");
    showTextbox("When Digimon gets hungry,\nhe'll tell you.\n");
    showTextbox("He also needs to go potty.\nMake sure he does it\nin the toilet.\n");
    showTextbox("Digimon get sleepy and\nneed sleep, but you have to\nmake him sleep.\n");
    showTextbox("Don't try to keep him up\nfor too long.\n");
    showTextbox("He may get tired, sick\nor just get upset.\nHe's kinda delicate.\n");
    showTextbox("Since Digimon are wild\ncreatures, you should\npraise or scold them.\n");
    showTextbox("Whatever you do,\npay attention to what\nyour Digimon is doing.\n");
    return;
}

section section_20(20) {  // len=102
    moveCamera(to: (183, 221), slowdown: 20);
    waitForEntity(200);
    delay(20);
    addStats(Stat.CurrentHP, 9999);
    addStats(Stat.CurrentMP, 9999);
    unsetTrigger(1);
    playAnimation(5, 29);
    delay(5);
    setDialogOwner(5);
    showTextbox("You woke up...\nI'm so sorry.\n");
    playAnimation(5, 0);
    return;
}

