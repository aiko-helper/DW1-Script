// DG178.SCN
#include "functions.dgs"
#pragma script index=178 start=0x87000 end=0x89800 headerU16=0x40 sentinelOff=0x19

section onEnter(254) {
  if (!trigger(231) && !trigger(245) && !trigger(233) && !trigger(247)) goto L1;
  setObjectVisibility(7, 1);

L1:
  if (!trigger(203)) goto L2;
  setObjectVisibility(8, 1);
  goto L3;

L2:
  setRectImpassible(40, 38, 2, 2);

L3:
  return;
}

section(54) {
  jumpToScriptSection(193, 55);
  return;
}

section(5) {
  if (trigger(202) || trigger(215) || pstat[16] == 0) goto L1;
  if (!trigger(201) || !trigger(243)) goto L1;
  speak(5, "You had perfect timing in\ncoming here! I have a favor\nthat only you can do.\n");
  speak(Entity.Player, "What is it?\n");
  speak(5, "I just got the same evil\nfeeling that Analogman\nand Machinedramon give.\n");
  showTextbox("I know where it comes from.\n");
  speak(Entity.Player, "Again? Ok, leave it to me!\n");
  speak(5, "Thanks. By the way...\n");
  goto L5;

L1:
  if (!trigger(202) || trigger(215)) goto L4;
  speak(5, "I heard you beat\nMachinedramon!\n");
  speak(Entity.Player, "Yeah, but I don't get it.\nIt seemed like the curse\nof Analogman.\n");
  speak(5, "His grudge was so strong.\nMaybe we can have peace now.\n");
  speak(Entity.Player, "If Machinedramon returns,\nwe'll beat him again.\n");
  speak(5, "You're trustworthy. This was\ngrowing in our Meat farm,\nit's for you.\n");
  speak(Entity.Player, "Woah! A <LIGHTBLUE>Chained\nMelon<WHITE>?\n");
  giveItem(Item.ChainMelon, 1);
  if (!trigger(0)) goto L3;
  if (item[Item.SpikeClub] < 99) goto L2;
  return;

L2:
  speak(Entity.Player, "I have too many Items.\n");
  setTrigger(3);
  callSubroutine(0);
  callSubroutine(13);
  giveItem(Item.ChainMelon, 1);

L3:
  speak(Entity.Player, "Thank you!\n");
  setPStat(28, 0);
  setTrigger(215);
  return;

L4:
  if (!trigger(50) || trigger(201)) goto L5;
  speak(5, "You're here!\nThis is something I can't\nask anybody else.\n");
  speak(Entity.Player, "Never fear, I'm here.\nDo you mean\nAnalogman is back?\n");
  speak(5, "I can feel his evil, but\nI can't tell where it is.\n");
  speak(Entity.Player, "Leave it up to me! I'll find\nhim and take care of it.\n");
  speak(5, "Thank you.\nBy the way...\n");
  setTrigger(201);

L5:
  if (!trigger(203)) goto L6;
  jumpToScriptSection(210, 51);

L6:
  if (trigger(55)) goto section_6;
  playAnimation(5, 0);
  playAnimation(5, 29);
  delay(5);
  speak(5, "I'm back and I'm planning\nto rebuild File City with\nhelp from <ORANGE><DIGIMON><WHITE>.\n");
  playAnimation(5, 0);
  playAnimation(5, 29);
  delay(5);
  speak(5, "I want to build\nshops that are useful\nto you and <ORANGE><DIGIMON><WHITE>.\n");
  playAnimation(5, 0);
  playAnimation(5, 29);
  delay(5);
  speak(5, "You should explore Native\nForest just outside the city.\n");
  playAnimation(5, 0);
  return;
}

section(6) {
  if (trigger(56)) goto L2;
  if (!trigger(96) && pstat[18] < 10) goto L1;
  goto L2;

L1:
  speak(6, "You can have this. Good luck.\n");
  speak(Entity.System, "I got lots of Items!\n");
  for x in [:SmallRecovery, :Meat, :MPFloppy] {
    giveItem(x, 3);
  }
  giveItem(Item.Restore, 1);
  giveItem(Item.Bandage, 2);
  giveItem(Item.Medicine, 1);
  speak(6, "To look up Items, press\n<GREEN><TRIANGLE> <WHITE>...\n");
  showTextbox("...then select 'Item'\nand look by using\n<LIGHTBLUE><X> <WHITE>.\n");
  setTrigger(56);
  return;

L2:
  if (trigger(224) || !trigger(175)) goto L3;
  speak(6, "Sounds like Yuramon has\ngathered more rumors.\n");
  return;

L3:
  if (!trigger(124) || !trigger(103)) goto L4;
  speak(6, "I hear Yuramon\nhas some new rumors.\n");
  return;

L4:
  if (pstat[1] < 6) goto L5;
  speak(6, "The city is starting to\ngrow and I hear it's\nchanging now.\n");
  return;

L5:
  speak(6, "I will teach you about the\ncommon sense in our world.\n");
  showTextbox("There are twenty four hours\na day and there is morning,\nday and night.\n");
  showTextbox("You may feel\nthe pace is quick.\n");
  showTextbox("There are thirty days a year.\nMonth? What's that? Seasons?\nCan you eat that?\n");
  showTextbox("Of course we have money.\nThe unit is a bit. You can\nnever have too much money.\n");
  showTextbox("When you say 'city' on\nthis island, that means here.\n");
  showTextbox("But there are other\nsmall villages and towns.\n");
  showTextbox("On the clock, the yellow dot\nis hours and the needle is\nminutes.\n");
  showTextbox("Up is Midnight\nand Down is Noon.\n");
  showTextbox("The red part on the left\nmeans late afternoon. It\nshows four - eight o'clock.\n");
  showTextbox("The purple part on the\nright is morning and it\nshows four - eight o'clock.\n");
  showTextbox("Digimon are active at\ncertain times of day.\n");
  showTextbox("Most of them get up in the\nmorning and sleep at night,\nbut some are opposite.\n");
  showTextbox("If you can't meet the\nDigimon you wish, try\na different time of day.\n");
  return;
}

section(7) {
  if (trigger(54)) goto L1;
  jumpToScriptSection(209, 5);
  return;

L1:
  roll(pstat: 110, max: 2);
  if (pstat[1] < 3 || pstat[110] != 0) goto L2;
  speak(7, "Talk to Tsunomon and\nYuramon as often as you can.\n");
  return;

L2:
  if (pstat[1] < 3 || pstat[110] != 1) goto L3;
  speak(7, "I'll tell you about\nthe Tamer level.\n");
  showTextbox("With a high Tamer level,\nwhen your Digimon fades away,\n");
  showTextbox("your next Digimon will have\nbetter parameters.\n");
  showTextbox("In the beginning\nit won't go up much,\n");
  showTextbox("but keep steadily raising him\nand it will get better.\n");
  return;

L3:
  if (pstat[1] < 3 || pstat[110] != 2) goto L4;
  speak(7, "When you use your Finishing\nTechnique, make sure to\nrapidly hit L and R buttons.\n");
  showTextbox("When Finish Gauge is full,\ncompared to when empty, the\ndamage to enemy is double!\n");
  return;

L4:
  speak(7, "I'll tell you about a\nDigimon's life.\n");
  showTextbox("When Digimon gets hungry,\nhe'll tell you.\n");
  showTextbox("He also needs to go potty.\nMake sure he does it\nin the toilet.\n");
  showTextbox("Digimon get sleepy and\nneed sleep, but you have to\nmake him sleep.\n");
  showTextbox("Don't try to keep him up\nfor too long.\n");
  showTextbox("He may get tired, sick\nor just get upset.\nHe's kinda delicate.\n");
  showTextbox("Since Digimon are wild\ncreatures, you should\npraise or scold them.\n");
  showTextbox("Whatever you do,\npay attention to what\nyour Digimon is doing.\n");
  return;
}

section(20) {
  moveCamera(to: (183, 221), slowdown: 20);
  waitForEntity(200);
  delay(20);
  addStats(currentHP: 9999, currentMP: 9999);
  unsetTrigger(1);
  playAnimation(5, 29);
  delay(5);
  speak(5, "You woke up...\nI'm so sorry.\n");
  playAnimation(5, 0);
  return;
}

section(71) {
  jumpToScriptSection(212, 71);
  return;
}

section(72) {
  jumpToScriptSection(212, 72);
  return;
}

section(73) {
  jumpToScriptSection(212, 73);
  return;
}

section(85) {
  if (trigger(94)) goto L1;
  setTrigger(94);
  speak(Entity.Player, "What's this machine?\n");
  look(entity: 5, at: Entity.Player);
  look(entity: Entity.Player, at: 5);
  delay(5);
  speak(5, "Oh that? That is a\n<PINK>Save Machine for\nMemory Card Battle Data<WHITE>.\n");
  showTextbox("Using that machine, you can\nsave your current partner's\ndata for battle.\n");
  showTextbox("Just press <LIGHTBLUE><X> <WHITE>,\nand the machine will tell\nyou what to do.\n");
  rotate(entity: Entity.Player, to: 0);
  delay(5);
  return;

L1:
  speak(Entity.System, "Do you want to use\n<PINK>Save Machine for\nMemory Card Battle Data<WHITE>?\n");
  choice { "Yes" -> L2, "No" -> L3 }
  return;

L2:
  fadeOutHUD();
  callSubroutine(48);
  return;

L3:
  return;
}

section(82) {
  rotate(entity: Entity.Player, to: 3072);
  delay(5);
  playSound(0, 0);
  if (!trigger(231) && !trigger(245) && !trigger(233) && !trigger(247)) goto L1;
  speak(Entity.Player, "I don't see Punimon, but\nI think I'll rest here.\n");
  goto L2;

L1:
  speak(Entity.System, "<YELLOW>Punimon <WHITE>\nI'm Punimon! Why don't you\nrest here a while?\n");
  showTextbox("<YELLOW>Punimon <WHITE>\nOne hour rest recovers HP,\nMP and lowers Tiredness.\n");

L2:
  setDialogOwner(Entity.Player);
  choice { "Rest" -> L3, "Don't rest" -> L4 }
  playSound(0, 1);
  return;

L3:
  pstat[:SavedTime] = time();
  addMinutesToDate(PStat.SavedTime, 60);
  advanceToDate(PStat.SavedTime);
  addStats(currentHP: 300, currentMP: 300);
  reduceStats(tiredness: 10);
  warp(to: Map.ROOM08, spawn: 2, trigger: 255);
  return;

L4:
  playSound(0, 1);
  return;
}

