// DG043.SCN
#pragma script index=43 start=0x22000 end=0x22800 headerU16=0x2c sentinelOff=0x24

section onEnter(254) {  // len=50
    roll(pstat: 110, max: 99);
    if (pstat[110] > 9) goto L1;
    spawnItem(Item.Digimushroom, 48, 68);

L1:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 3) goto L2;
    spawnItem(Item.Pricklypear, 76, 49);

L2:
    unsetTrigger(98);
    return;
}

section(5) {  // len=30
    setDialogOwner(5);
    showTextbox("Daa!\n");
    fadeOutHUD();
    delay(1);
    startBattle();
    setTrigger(280);
    return;
}

section(6) {  // len=30
    setDialogOwner(6);
    showTextbox("Haa!\n");
    fadeOutHUD();
