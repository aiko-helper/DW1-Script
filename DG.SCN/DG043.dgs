// DG043.SCN
#include "functions.dgs"
#pragma script index=43 start=0x22000 end=0x22800 headerU16=0x2c sentinelOff=0x24

section onEnter(254) {
    roll(pstat: 110, max: 99);
    if (pstat[110] > 9) goto L1;
    spawnItem(Item.Digimushroom, x: 48, y: 68);

L1:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 3) goto L2;
    spawnItem(Item.Pricklypear, x: 76, y: 49);

L2:
    unsetTrigger(98);
    return;
}

section(5) {
    speak(5, "Daa!\n");
    startBattle();
    setTrigger(280);
    return;
}

section(6) {
    speak(6, "Haa!\n");
    startBattle();
    setTrigger(280);
    return;
}

section(7) {
    speak(7, "Gghhee!\n");
    startBattle();
    setTrigger(280);
    return;
}

section(81) {
    rotate(entity: Entity.Player, to: 1944);
    waitForEntity(Entity.Player);
    speak(Entity.System, "East: Elevator\nWest: Danger, Cliff\n");
    if (!trigger(54)) goto L1;
    return;

L1:
    setDialogOwner(Entity.System);
    setSelection(L2, L3);
    showTextbox("Ogre mode : ON\nOgre mode : OFF\n");

L2:
    setTrigger(197);
    warp(to: Map.GCAN08_1, spawn: 0, trigger: 255);
    return;

L3:
    unsetTrigger(197);
    warp(to: Map.GCAN08_1, spawn: 0, trigger: 255);
    return;
}

section(53) {
    if (trigger(143) || trigger(141)) goto L1;
    setTrigger(143);
    setTrigger(141);
    speak(Entity.Player, "What?\n");
    move(entity: Entity.Player, to: (-1048, -498), sprint: 0, withCamera: true);
    delay(20);
    move(entity: Entity.Partner, to: (-1048, -498), sprint: 0);
    waitForEntity(Entity.Player);
    move(entity: Entity.Player, to: (-1473, 823), sprint: 0, withCamera: true);
    delay(20);
    move(entity: Entity.Partner, to: (-1473, 823), sprint: 0);
    waitForEntity(Entity.Player);
    move(entity: Entity.Player, to: (-2333, 261), sprint: 0, withCamera: true);
    delay(20);
    move(entity: Entity.Partner, to: (-1952, 165), sprint: 0);
    waitForEntity(Entity.Player);
    delay(20);
    look(entity: Entity.Player, at: Entity.Partner);
    delay(20);
    rotate(entity: Entity.Player, to: 1000);
    speak(Entity.Player, "I felt the ground move.\nWas it my imagination?\n");

L1:
    if (trigger(143) || !trigger(141)) goto L2;
    setTrigger(142);
    move(entity: Entity.Player, to: (-1048, -498), sprint: 0, withCamera: true);
    delay(20);
    move(entity: Entity.Partner, to: (-1048, -498), sprint: 0);
    waitForEntity(Entity.Player);
    move(entity: Entity.Player, to: (-1473, 823), sprint: 0, withCamera: true);
    delay(20);
    move(entity: Entity.Partner, to: (-1473, 823), sprint: 0);
    waitForEntity(Entity.Player);
    move(entity: Entity.Player, to: (-2333, 261), sprint: 0, withCamera: true);
    delay(20);
    move(entity: Entity.Partner, to: (-1952, 165), sprint: 0);
    waitForEntity(Entity.Player);
    delay(20);
    look(entity: Entity.Player, at: Entity.Partner);
    delay(20);
    rotate(entity: Entity.Player, to: 1000);
    playSound(8, 8);
    speak(Entity.Player, "What? No way!\n");
    look(entity: Entity.Player, at: Entity.Partner);
    look(entity: Entity.Partner, at: Entity.Player);
    setPStat(247, 2);
    setPStat(248, 2);
    callSubroutine(21);
    setObjectVisibility(0, 1);
    setObjectVisibility(1, 1);
    setObjectVisibility(2, 0);
    setObjectVisibility(3, 0);
    playSound(8, 8);
    playAnimation(Entity.Player, 15);
    delay(40);
    setObjectVisibility(2, 1);
    setObjectVisibility(3, 1);
    setObjectVisibility(7, 0);
    playAnimation(Entity.Player, 26);
    delay(2);
    move(entity: Entity.Partner, axis: 1, to: 5000, speed: 5);
    delay(1);
    move(entity: Entity.Player, axis: 1, to: 5000, speed: 5);
    playSound(8, 0);
    setTexboxMode(2, 20);
    speak(Entity.System, "<LIGHTBLUE><PLAYER><WHITE>Wow!!\n");
    warp(to: Map.GCAN07, spawn: 1, trigger: 51);
    return;

L2:
    return;
}

section(54) {
    unsetTrigger(143);
    return;
}

section(82) {
    rotate(entity: Entity.Player, to: 1944);
    waitForEntity(Entity.Player);
    speak(Entity.System, "Beware of cave-ins!\n");
    return;
}

section(51) {
    if (trigger(197)) goto L1;
    return;

L1:
    if (!trigger(198)) goto L2;
    return;

L2:
    if (!trigger(98)) goto L3;
    return;

L3:
    rotate(entity: Entity.Player, to: 1944);
    moveCamera(to: (2000, 173), slowdown: 30);
    waitForEntity(200);
    speak(Entity.Player, "I heard this road is where\nthe bandits attack.\n");
    showTextbox("Let's go, <ORANGE><DIGIMON><WHITE>.\n");
    move(entity: Entity.Player, to: (1925, 468), sprint: 0);
    move(entity: Entity.Partner, to: (1925, 78), sprint: 0);
    waitForEntity(Entity.Player);
    waitForEntity(Entity.Partner);
    loadDigimon(Digimon.NPCOgremon);
    loadDigimon(Digimon.Agumon);
    setDigimon(Digimon.NPCOgremon, 3, 0);
    setDigimon(Digimon.Agumon, 4, 0);
    setDigimon(Digimon.Agumon, 5, 0);
    speak(9, "You-hoo!\n");
    playSound(8, 11);
    speak(8, "Ha ha!\n");
    speak(10, "Yaa-hoo!\n");
    delay(10);
    playSound(8, 1);
    playAnimation(8, 31);
    move(entity: 8, to: (1000, 1288), animDuration: 30);
    move(entity: 9, to: (2067, 1561), sprint: 1);
    move(entity: 10, to: (2059, -383), sprint: 1);
    for id in 8..10 { waitForEntity(id); }
    look(entity: 8, at: Entity.Player);
    look(entity: 9, at: Entity.Player);
    look(entity: 10, at: Entity.Player);
    look(entity: Entity.Player, at: 8);
    look(entity: Entity.Partner, at: 9);
    delay(10);
    playSound(8, 11);
    speak(8, "Give up and leave your stuff!\nOr else!\n");
    speak(Entity.Player, "No, you give up!\n");
    speak(8, "What?! You...?\n");
    speak(8, "It can't be.\n");
    speak(9, "Boss, what'll we do?\n");
    look(entity: 9, at: 8);
    speak(8, "Don't worry, we're stronger\nand there's more of us.\nGo get'um!\n");
    look(entity: 8, at: 9);
    setTrigger(1);
    setPStat(250, 1);
    setPStat(251, 8);
    setPStat(252, 9);
    setPStat(253, 10);
    startBattle();
    unsetTrigger(1);
    setPStat(250, 0);
    look(entity: Entity.Player, at: 8);
    look(entity: 8, at: Entity.Player);
    look(entity: Entity.Partner, at: 8);
    move(entity: 9, to: (1350, 2350), sprint: 1);
    move(entity: 10, to: (1850, 2350), sprint: 1);
    waitForEntity(9);
    waitForEntity(10);
    unloadEntity(9);
    unloadEntity(10);
    speak(8, "I'll get even with\nyou someday!\n");
    move(entity: 8, to: (1650, 2350), sprint: 1);
    waitForEntity(8);
    unloadEntity(8);
    speak(Entity.Player, "Look at them go! They won't\nbe back for a while.\n");
    moveCamera(to: Entity.Player, speed: 10);
    waitForEntity(200);
    setTrigger(198);
    setTrigger(155);
    return;
}

section(52) {
    setTrigger(98);
    return;
    garbage { 2c 00 fe 00 2c 00 05 00 5e 00 06 00 7c 00 07 00 9a 00 51 00 be 00 35 00 7c 01 36 00 62 03 52 00 68 03 33 00 9e 03 34 00 9a 07 ff ff 24 00 6e 63 19 00 0b 00 6e 09 18 00 42 00 19 00 74 2c 30 00 44 00 24 00 6e 63 19 00 0b 00 6e 03 18 00 58 00 19 00 74 36 4c 00 31 00 1d 00 62 00 fe 00 }
}
