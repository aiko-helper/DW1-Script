// DG081.SCN
#include "functions.dgs"
#pragma script index=81 start=0x37000 end=0x37800 headerU16=0x24 sentinelOff=0x24
#include "entities.dgs"

section onEnter(254) {
  spawnItemChance(max: 99, chance: 17, item: Item.Digimushroom, x: 43, y: 35);
  spawnItemChance(max: 99, chance: 10, item: Item.Digimushroom, x: 38, y: 67);
  spawnItemChance(max: 99, chance: 7, item: Item.Digimushroom, x: 50, y: 81);
  return;
}

section(5) {
  speak(Entity(5), "「あ~、あったかいよ!」<NEWLINE>");
  finishEncounter(Trigger(271));
}

section(6) {
  speak(Entity(6), "「ここ通るって?ざけんじゃねぇよ!」<NEWLINE>");
  finishEncounter(Trigger(303));
}

section(7) {
  speak(Entity(7), "「かわいそうにね…フハハハハ!」<NEWLINE>");
  finishEncounter(Trigger(300));
}

section(8) {
  speak(Entity(8), "「血の雨がふるぞっ!」<NEWLINE>");
  finishEncounter(Trigger(300));
}

section(81) {
  rotate(entity: Entity.Player, to: 943);
  speak(Entity.System, "これより先 極寒の地<NEWLINE><RED>寒冷仕様<WHITE>でない者は<NEWLINE>入るべからず<NEWLINE>");
  return;
}

section(53) {
  {
    if ((cond & 0x40) == 0x01 && !trigger(133)) break;
    return;
  }
  storeDigimonType(PStat(103));
  if (pstat[103] == 3 || pstat[103] == 5 || pstat[103] == 8 || pstat[103] == 9 || pstat[103] == 47) {
    jumpToScriptSection(174, 51);
  }
  if (pstat[103] == 19 || pstat[103] == 32 || pstat[103] == 51 || pstat[103] == 1 || pstat[103] == 2) {
    jumpToScriptSection(174, 51);
  }
  if (pstat[103] == 15 || pstat[103] == 16 || pstat[103] == 29 || pstat[103] == 30 || pstat[103] == 43) {
    jumpToScriptSection(174, 51);
  }
  if (pstat[103] == 44 || pstat[103] == 21) {
    jumpToScriptSection(174, 51);
  }
  return;
}

