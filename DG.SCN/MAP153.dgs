// MAP153.SCN
#include "functions.dgs"
#pragma script index=153 start=0x67800 end=0x69800 headerU16=0x38 sentinelOff=0x1e
#include "entities.dgs"

section onEnter(254) {
  setPStat(PStat(122), 255);
  if (!trigger(257)) {
    setObjectsVisibleRange(0, 3, 0);
  } else {
    setObjectsVisibleRange(0, 3, 1);
    setObjectVisibility(5, 0);
    setObjectVisibility(6, 0);
  }
  if (trigger(257) && !trigger(50)) {
    setObjectVisibility(4, 0);
  }
  if (trigger(257) && trigger(50)) {
    setObjectVisibility(4, 1);
  }
  if (trigger(50)) {
    setObjectVisibility(7, 0);
    setObjectVisibility(8, 0);
  }
  return;
}

section(81) {
  jumpToScriptSection(220, 81);
  return;
}

section(54) {
  jumpToScriptSection(220, 54);
}

section(61) {
  jumpToScriptSection(212, 51);
  return;
}

section(51) {
  if (trigger(257)) {
    warp(to: Map.ROOM20, spawn: 0, trigger: 255);
    setPStat(PStat(122), 255);
  }
  return;
}

section(82) {
  speak(Entity.System, " <NEWLINE>    闘技場インフォメーション<NEWLINE>");
  setSelection(L1, L2, L3);
  showTextbox(" 成績<NEWLINE> グレード大会について<NEWLINE> 特別な大会について<NEWLINE>");
  waitForSelectionChoice();
  return;

L1:
  speak(Entity.System, " 優勝回数    <TOURNAMENTS WON><NEWLINE> <NEWLINE> <ARENA WINS>勝 <ARENA LOSSES>敗<NEWLINE>");
  fadeOutHUD();
  return;

L2:
  speak(Entity.System, " グレード大会は誰でも参加でき、<NEWLINE> ひんぱんにおこなわれています。<NEWLINE>");
  showTextbox(" ただし、あまりに世代がちがう<NEWLINE> デジモンがレベルのひくい大会に<NEWLINE> 出場するのはなるべくさけてください。<NEWLINE>");
  showTextbox(" また、エントリー時と入場時の<NEWLINE> デジモンの種類が変わってしまっている<NEWLINE> 場合はエントリー取り消しになります。<NEWLINE>");
  return;

L3:
  speak(Entity.System, " 特別大会は参加資格が決まっており、<NEWLINE> めったに行われません。<NEWLINE>");
  showTextbox(" また、じゅうぶんな参加メンバーが<NEWLINE> 街にいないと、開かれることすら<NEWLINE> ありません。<NEWLINE>");
  showTextbox(" 同じ大会は1年に1、2度しか行われない<NEWLINE> ので、前々からスケジュールを確認して<NEWLINE> おくとよいでしょう。<NEWLINE>");
  return;
}

section(83) {
  jumpToScriptSection(182, 6);
  return;
}

section(84) {
  look(entity: Entity(7), at: Entity.Player);
  look(entity: Entity.Player, at: Entity(7));
  delay(10);
  speak(Entity(7), "「ふふ……<ORANGE><DIGIMON><WHITE>、<NEWLINE> 世界を救った勇者としての<NEWLINE> 呼び名を俺が考えてやろう。」<NEWLINE>");
  showTextbox("「そうだな…」<NEWLINE>");
  roll(pstat: PStat.RollScratch, max: 9);
  switch pstat[110] {
    0 => {
      speak(Entity(7), "「『無敵王者<ORANGE><DIGIMON><WHITE>』<NEWLINE> というのはどうだ?」<NEWLINE>");
      return;
    }
    1 => {
      speak(Entity(7), "「『伝説勇者<ORANGE><DIGIMON><WHITE>』<NEWLINE> というのはどうだ?」<NEWLINE>");
      return;
    }
    2 => {
      speak(Entity(7), "「『新世界覇王<ORANGE><DIGIMON><WHITE>』<NEWLINE> というのはどうだ?」<NEWLINE>");
      return;
    }
    3 => {
      speak(Entity(7), "「『平和を呼ぶ<ORANGE><DIGIMON><WHITE>』<NEWLINE> というのはどうだ?」<NEWLINE>");
      return;
    }
    4 => {
      speak(Entity(7), "「『無敗神話の<ORANGE><DIGIMON><WHITE>』<NEWLINE> というのはどうだ?」<NEWLINE>");
      return;
    }
    5 => {
      speak(Entity(7), "「『<ORANGE><DIGIMON><WHITE>・ザ・ブレイブ』<NEWLINE> というのはどうだ?」<NEWLINE>");
      return;
    }
    6 => {
      speak(Entity(7), "「『いかしたアイツは<ORANGE><DIGIMON><WHITE>』<NEWLINE> というのはどうだ?」<NEWLINE>");
      return;
    }
    7 => {
      speak(Entity(7), "「『超絶武神王<ORANGE><DIGIMON><WHITE>』<NEWLINE> というのはどうだ?」<NEWLINE>");
      return;
    }
    8 => {
      speak(Entity(7), "「『天の烈風<ORANGE><DIGIMON><WHITE>』<NEWLINE> というのはどうだ?」<NEWLINE>");
      return;
    }
  }
  if (pstat[110] != 9) goto section_6;
  speak(Entity(7), "「『おしゃれドロボウ<ORANGE><DIGIMON><WHITE>』<NEWLINE> というのはどうだ?」<NEWLINE>");
  return;
}

section(6) {
  jumpToScriptSection(182, 6);
  return;
}

section(53) {
  look(entity: Entity(5), at: Entity.Player);
  look(entity: Entity.Player, at: Entity(5));
  delay(5);
  speak(Entity(5), "「おいおい、そっちは客せきだ。」<NEWLINE>");
  move(entity: Entity.Player, to: (450, 124), sprint: 1);
  waitForEntity(Entity.Player);
  followEntity(Entity.Player, speed: 10);
  return;
}

