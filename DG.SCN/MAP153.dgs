// MAP153.SCN
#include "functions.dgs"
#pragma script index=153 start=0x6d000 end=0x6d800 headerU16=0xc sentinelOff=0xfe
#include "entities.dgs"

section onEnter(254) {
  return;
}

section(5) {
  speak(5, "I was waiting for you!\n");
  speak(Entity.Player, "Are you returning\nto your senses?\n");
  playSound(8, 11);
  speak(5, "I'm feeling\na little bit funky.\n");
  speak(Entity.Player, "Hey,\nthis is serious, you know?\n");
  speak(5, "The factory's closed now, so\nI have lots of free time.\nI'll help you!\n");
  speak(5, "He regained his senses, but\nhe still looks insane!\n? still looks insane!\n");
  playSound(8, 11);
  speak(5, "Well, excuuuuuse meeee.\nSee ya later!\n");
  goto L1;

L1:
  loop {
    move(entity: 5, to: (3050, -150), sprint: 1);
    if (pstat[101] >= 3) break;
    addPStat(PStat.LoopIterator, 1);
    delay(20);
    look(entity: Entity.Player, at: 5);
    look(entity: Entity.Partner, at: 5);
  }
  waitForEntity(5);
  unloadEntity(5);
  setPStat(PStat.LoopIterator, 0);
  playSound(8, 10);
  speak(Entity.System, "Giromon joins the city!\n");
  moveCamera(to: Entity.Player, speed: 10);
  waitForEntity(200);
  setTrigger(241);
  addPStat(1, 3);
  return;
  garbage { 0c 00 fe 00 0c 00 05 00 0e 00 ff ff fe 00 1b 05 1a 00 82 68 81 40 82 97 82 81 82 93 81 40 82 97 82 81 82 89 82 94 82 89 82 8e 82 87 81 40 82 86 82 8f 82 92 81 40 82 99 82 8f 82 95 81 49 0d 00 00 00 1b fd 1a 00 82 60 82 92 82 85 81 40 82 99 82 8f 82 95 81 40 82 92 82 85 82 94 82 95 82 92 82 8e 82 89 82 8e 82 87 0d 00 82 94 82 8f 81 40 82 99 82 8f 82 95 82 92 81 40 82 93 82 85 82 8e 82 93 82 85 82 93 81 48 0d 00 00 00 5a 00 08 0b 1b 05 1a 00 82 68 81 75 82 8d 81 40 82 86 82 85 82 85 82 8c 82 89 82 8e 82 87 0d 00 82 81 81 40 82 8c 82 89 82 94 82 94 82 8c 82 85 81 40 82 82 82 89 82 94 81 40 82 86 82 95 82 8e 82 8b 82 99 81 42 0d 00 00 00 1b fd 1a 00 82 67 82 85 82 99 81 43 0d 00 82 94 82 88 82 89 82 93 81 40 82 89 82 93 81 40 82 93 82 85 82 92 82 89 82 8f 82 95 82 93 81 43 81 40 82 99 82 8f 82 95 81 40 82 8b 82 8e 82 8f 82 97 81 48 0d 00 00 00 1b 05 1a 00 82 73 82 88 82 85 81 40 82 86 82 81 82 83 82 94 82 8f 82 92 82 99 81 75 82 93 81 40 82 83 82 8c 82 8f 82 93 82 85 82 84 81 40 82 8e 82 8f 82 97 81 43 81 40 82 93 82 8f 0d 00 82 68 81 40 82 88 82 81 82 96 82 85 81 40 82 8c 82 8f 82 94 82 93 81 40 82 8f 82 86 81 40 82 86 82 92 82 85 82 85 81 40 82 94 82 89 82 8d 82 85 81 42 0d 00 82 68 81 75 82 8c 82 8c 81 40 82 88 82 85 82 8c 82 90 81 40 82 99 82 8f 82 95 81 49 0d 00 00 00 1b 05 1a 00 82 67 82 85 81 40 82 92 82 85 82 87 82 81 82 89 82 8e 82 85 82 84 81 40 82 88 82 89 82 93 81 40 82 93 82 85 82 8e 82 93 82 85 82 93 81 43 81 40 82 82 82 95 82 94 0d 00 82 88 82 85 81 40 82 93 82 94 82 89 82 8c 82 8c 81 40 82 8c 82 8f 82 8f 82 8b 82 93 81 40 82 89 82 8e 82 93 82 81 82 8e 82 85 81 49 0d 00 81 48 81 40 82 93 82 94 82 89 82 8c 82 8c 81 40 82 8c 82 8f 82 8f 82 8b 82 93 81 40 82 89 82 8e 82 93 82 81 82 8e 82 85 81 49 0d 00 00 00 5a 00 08 0b 1b 05 1a 00 82 76 82 85 82 8c 82 8c 81 43 81 40 82 85 82 98 82 83 82 95 82 95 82 95 82 95 82 95 82 93 82 85 81 40 82 8d 82 85 82 85 82 85 82 85 81 42 0d 00 82 72 82 85 82 85 81 40 82 99 82 81 81 40 82 8c 82 81 82 94 82 85 82 92 81