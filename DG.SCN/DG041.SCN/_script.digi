; DG041.SCN
;!script index=41 start=0x21000 end=0x21800 headerU16=0x28 sentinelOff=0x24
;!sections onEnter section_5 section_6 section_7 section_8 section_9 section_10 section_81 section_53

onEnter:     ; len=46
  0000:  storeRandom 110 99
  0004:  if pstat[110] > 9 then onEnter+0x16
  0010:  spawnItem Digimushroom 69 49
  0016:  storeRandom 110 99
  001a:  if pstat[110] > 2 then onEnter+0x2c
  0026:  spawnItem Happymushroom 37 33
  002c:  endSection
