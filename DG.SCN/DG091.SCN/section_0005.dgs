// source: extract/DIGIMON/SCN/DG.SCN
// DG091.SCN, section 5

section section_5(5) {  // len=1826
    if (!trigger(195)) goto L_0010;
    goto L_0362;
L_0010:
    setDialogOwner(5);
    showTextbox("If you want to go thru,\nyou must accept my challenge.\n");
    setTrigger(1);
    setPStat(250, 1);
    setPStat(251, 5);
    setPStat(252, 255);
    setPStat(253, 255);
    fadeOutHUD();
    delay(1);
    startBattle();
    unsetTrigger(1);
    setPStat(250, 0);
    look(entity: Entity.Player, at: 5);
    look(entity: 5, at: Entity.Player);
    look(entity: Entity.Partner, at: 5);
    setDialogOwner(5);
    showTextbox("I let my guard down,\nbut two on one isn't fair.\n");
    playAnimation(Entity.Player, 16);
    setTrigger(49);
    setDialogOwner(Entity.Player);
    setSelection(L_0180, L_0180);
    showTextbox("Well, that maybe so\nDon't be a sore loser\n");
L_0180:
    setDialogOwner(5);
    showTextbox("I never lose to anybody\nwhen it's a fair fight.\n");
    showTextbox("Let's fight one on one. Come\nback tomorrow at four O'clock.\nOnly Digimon will fight.\n");
    setDialogOwner(Entity.Player);
    setSelection(L_02c4, L_02c4);
    showTextbox("Alright\nNo thanks\n");
L_02c4:
    playAnimation(Entity.Player, 16);
    unsetTrigger(49);
    setDialogOwner(5);
    showTextbox("It's a promise then.\nSee you tomorrow!\n");
    setTrigger(195);
    storeDate(29);
    goto L_032a;
L_032a:
    move(entity: 5, to: (-2050, -150), sprint: 1);
    if (pstat[101] >= 6) goto L_0352;
    addPStat(101, 1);
    delay(10);
    look(entity: Entity.Player, at: 5);
    look(entity: Entity.Partner, at: 5);
    goto L_032a;
L_0352:
    waitForEntity(5);
    unloadEntity(5);
    setPStat(101, 0);
    moveCamera(to: Entity.Player, speed: 10);
    waitForEntity(200);
    return;
L_0362:
    storeDate(105);
    if (!trigger(195) || pstat[107] < 15 || pstat[107] > 17 || pstat[29] != 1) goto L_03e6;
    setDialogOwner(5);
    showTextbox("You came back, good.\nToday, we'll fight fair!\n");
    goto L_0488;
    goto L_0488;
L_03e6:
    setDialogOwner(5);
    showTextbox("You're late, but that gave\nme time to nurse my injury.\nNow let's go for it.\n");
    goto L_0488;
L_0488:
    setDialogOwner(Entity.Player);
    showTextbox("I'll just watch. Start!\n");
    look(entity: Entity.Player, at: Entity.Partner);
    waitForEntity(Entity.Player);
    playAnimation(Entity.Player, 20);
    showTextbox("Go <ORANGE><DIGIMON><WHITE>!\n");
    setTrigger(2);
    setTrigger(1);
    setPStat(250, 1);
    setPStat(251, 5);
    setPStat(252, 255);
    setPStat(253, 255);
    fadeOutHUD();
    delay(1);
    startBattle();
    unsetTrigger(1);
    setPStat(250, 0);
    unsetTrigger(2);
    look(entity: Entity.Player, at: 5);
    look(entity: 5, at: Entity.Player);
    look(entity: Entity.Partner, at: 5);
    setDialogOwner(5);
    showTextbox("You're good! Who are you?\n");
    setDialogOwner(Entity.Player);
    showTextbox("We're exploring and trying to\nsave the island from danger.\n");
    setDialogOwner(5);
    showTextbox("What?\n");
    setDialogOwner(Entity.System);
    showTextbox("<LIGHTBLUE><PLAYER><WHITE> tries so hard\nto convince him!\n");
    playAnimation(Entity.Player, 19);
    delay(40);
    setDialogOwner(5);
    showTextbox("I'll help you. But, I'll\nhave to see that city first.\n");
    goto L_06a6;
L_06a6:
    move(entity: 5, to: (-2000, -100), sprint: 1);
    if (pstat[101] >= 6) goto L_06ce;
    addPStat(101, 1);
    delay(10);
    look(entity: Entity.Player, at: 5);
    look(entity: Entity.Partner, at: 5);
    goto L_06a6;
L_06ce:
    waitForEntity(5);
    unloadEntity(5);
    setPStat(101, 0);
    playSound(8, 11);
    setDialogOwner(Entity.System);
    showTextbox("Garurumon joins the city!\n");
    setTrigger(222);
    addPStat(1, 2);
    moveCamera(to: Entity.Player, speed: 10);
    waitForEntity(200);
}
