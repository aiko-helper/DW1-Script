// DG091.SCN
#pragma script index=91 start=0x40000 end=0x41000 headerU16=0x20 sentinelOff=0x24
#pragma sections section_0254 section_0006 section_0007 section_0008 section_0009 section_0005 section_0051

section onEnter(254) {  // len=90
    roll(pstat: 110, max: 99);
    if (pstat[110] > 5) goto L_0016;
    spawnItem(Item.Digimushroom, 49, 36);
L_0016:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 17) goto L_002c;
    spawnItem(Item.Digimushroom, 59, 55);
L_002c:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 7) goto L_0042;
    spawnItem(Item.Digimushroom, 48, 61);
L_0042:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 2) goto L_0058;
    spawnItem(Item.IceMushroom, 38, 60);
L_0058:
    return;
}
