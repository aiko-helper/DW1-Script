; DG091.SCN
;!script index=91 start=0x40000 end=0x41000 headerU16=0x20 sentinelOff=0x24
;!sections onEnter section_6 section_7 section_8 section_9 section_5 section_51

onEnter:     ; len=90
  0000:  storeRandom 110 99
  0004:  if pstat[110] > 5 then onEnter+0x16
  0010:  spawnItem 44 49 36
  0016:  storeRandom 110 99
  001a:  if pstat[110] > 17 then onEnter+0x2c
  0026:  spawnItem 44 59 55
  002c:  storeRandom 110 99
  0030:  if pstat[110] > 7 then onEnter+0x42
  003c:  spawnItem 44 48 61
  0042:  storeRandom 110 99
  0046:  if pstat[110] > 2 then onEnter+0x58
  0052:  spawnItem 45 38 60
  0058:  endSection
