// DG041.SCN
#pragma script index=41 start=0x21000 end=0x21800 headerU16=0x28 sentinelOff=0x24

section onEnter(254) {  // len=46
    roll(pstat: 110, max: 99);
    if (pstat[110] > 9) goto L1;
    spawnItem(Item.Digimushroom, x: 69, y: 49);

L1:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 2) goto L2;
    spawnItem(Item.Happymushroom, x: 37, y: 33);

L2:
    return;
}

section(5) {  // len=62
    speak(5, "It's not going well!\n");
    fadeOutHUD();
    delay(1);
    startBattle();
    setTrigger(293);
    return;
}

section(6) {  // len=66
    speak(6, "Did you say something?\n");
    fadeOutHUD();
    delay(1);
    startBattle();
    setTrigger(293);
    return;
}

section(7) {  // len=76
    speak(7, "I told you it's impossible.\n");
    fadeOutHUD();
    delay(1);
    startBattle();
    setTrigger(299);
    return;
}

section(8) {  // len=80
    speak(8, "I don't have much confidence.\n");
    fadeOutHUD();
    delay(1);
    startBattle();
    setTrigger(299);
    return;
}

section(9) {  // len=50
    speak(9, "Go easy on me.\n");
    fadeOutHUD();
    delay(1);
    startBattle();
    setTrigger(299);
    return;
}

section(10) {  // len=64
    speak(10, "Don't make fun of me!\n");
    fadeOutHUD();
    delay(1);
    startBattle();
    setTrigger(280);
    return;
}

section(81) {  // len=928
    rotate(entity: Entity.Player, to: 2128);
    delay(5);
    speak(Entity.System, "Elevator\n");
    setDialogOwner(Entity.Player);
    choice { "Hit Rooftop" -> L1, "Hit Up" -> L4, "Don't get on" -> L7 }
    goto L7;

L1:
    if (trigger(155)) goto L2;
    playAnimation(Entity.Player, 16);
    delay(15);
    speak(Entity.Player, "It doesn't do anything.\n");
    playAnimation(Entity.Player, 0);
    rotate(entity: Entity.Player, to: 2297);
    delay(10);
    rotate(entity: Entity.Player, to: 1785);
    delay(10);
    rotate(entity: Entity.Player, to: 2297);
    showTextbox("There's a rock stuck in\nthe machine. Maybe this is...\n");
    playAnimation(Entity.Player, 25);
    delay(20);
    speak(Entity.System, "I removed the rock!\n");
    speak(Entity.Player, "That should do it!\n");
    setTrigger(155);
    return;
    goto L3;

L2:
    playSound(8, 4);
    rotate3DObject(0, 1);
    delay(1);
    rotate3DObject(1, 1);
    delay(1);
    rotate3DObject(0, 1);
    delay(1);
    rotate3DObject(1, 1);
    delay(1);
    rotate3DObject(0, 1);
    delay(1);
    rotate3DObject(1, 1);
    delay(1);
    rotate3DObject(0, 1);
    delay(1);
    rotate3DObject(1, 1);
    delay(1);
    playSound(8, 5);
    warp(to: Map.GCAN10, spawn: 0, trigger: 52);
    return;

L3:
    return;

L4:
    fadeOutHUD();
    if (trigger(155)) goto L5;
    playAnimation(Entity.Player, 16);
    delay(15);
    speak(Entity.Player, "It doesn't do anything.\n");
    playAnimation(Entity.Player, 0);
    rotate(entity: Entity.Player, to: 2297);
    delay(10);
    rotate(entity: Entity.Player, to: 1785);
    delay(10);
    rotate(entity: Entity.Player, to: 2297);
    showTextbox("There's a rock stuck in\nthe machine. Maybe this is...\n");
    speak(Entity.System, "I removed the rock!");
    dead_string("?is is...\n");
    speak(Entity.Player, "That should do it.\n");
    setTrigger(155);
    return;
    goto L6;

L5:
    playSound(8, 4);
    rotate3DObject(0, 1);
    delay(1);
    rotate3DObject(1, 1);
    delay(1);
    rotate3DObject(0, 1);
    delay(1);
    rotate3DObject(1, 1);
    delay(1);
    rotate3DObject(0, 1);
    delay(1);
    rotate3DObject(1, 1);
    delay(1);
    rotate3DObject(0, 1);
    delay(1);
    rotate3DObject(1, 1);
    delay(1);
    playSound(8, 5);
    warp(to: Map.GCAN03, spawn: 2, trigger: 55);
    return;

L6:
    return;

L7:
    return;
}

