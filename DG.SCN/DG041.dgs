// DG041.SCN
#include "functions.dgs"
#pragma script index=41 start=0x21000 end=0x21800 headerU16=0x28 sentinelOff=0x24
#include "entities.dgs"

section onEnter(254) {
  spawnItemChance(max: 99, chance: 9, item: Item.Digimushroom, x: 69, y: 49);
  spawnItemChance(max: 99, chance: 2, item: Item.Happymushroom, x: 37, y: 33);
  return;
}

section(5) {
  speak(Entity(5), "It's not going well!\n");
  finishEncounter(Trigger(293));
}

section(6) {
  speak(Entity(6), "Did you say something?\n");
  finishEncounter(Trigger(293));
}

section(7) {
  speak(Entity(7), "I told you it's impossible.\n");
  finishEncounter(Trigger(299));
}

section(8) {
  speak(Entity(8), "I don't have much confidence.\n");
  finishEncounter(Trigger(299));
}

section(9) {
  speak(Entity(9), "Go easy on me.\n");
  finishEncounter(Trigger(299));
}

section(10) {
  speak(Entity(10), "Don't make fun of me!\n");
  finishEncounter(Trigger(280));
}

section(81) {
  {
    rotate(entity: Entity.Player, to: 2128);
    delay(5);
    speak(Entity.System, "Elevator\n");
    setDialogOwner(Entity.Player);
    choice { "Hit Rooftop" -> L1, "Hit Up" -> L2, "Don't get on" -> L3 }
    break;

L1:
    if (!trigger(155)) {
      anim(Entity.Player, Animation(16), wait: 15);
      speak(Entity.Player, "It doesn't do anything.\n");
      playAnimation(Entity.Player, Animation(0));
      rotate(entity: Entity.Player, to: 2297);
      delay(10);
      rotate(entity: Entity.Player, to: 1785);
      delay(10);
      rotate(entity: Entity.Player, to: 2297);
      showTextbox("There's a rock stuck in\nthe machine. Maybe this is...\n");
      anim(Entity.Player, Animation(25), wait: 20);
      speak(Entity.System, "I removed the rock!\n");
      speak(Entity.Player, "That should do it!\n");
      setTrigger(Trigger(155));
      return;
    } else {
      playSound(8, 4);
      rotate3DObject(0, 1);
      delay(1);
      rotate3DObject(1, 1);
      delay(1);
      rotate3DObject(0, 1);
      delay(1);
      rotate3DObject(1, 1);
      delay(1);
      rotate3DObject(0, 1);
      delay(1);
      rotate3DObject(1, 1);
      delay(1);
      rotate3DObject(0, 1);
      delay(1);
      rotate3DObject(1, 1);
      delay(1);
      playSound(8, 5);
      warp(to: Map.GCAN10, spawn: 0, trigger: 52);
      return;
    }
    return;

L2:
    fadeOutHUD();
    if (!trigger(155)) {
      anim(Entity.Player, Animation(16), wait: 15);
      speak(Entity.Player, "It doesn't do anything.\n");
      playAnimation(Entity.Player, Animation(0));
      rotate(entity: Entity.Player, to: 2297);
      delay(10);
      rotate(entity: Entity.Player, to: 1785);
      delay(10);
      rotate(entity: Entity.Player, to: 2297);
      showTextbox("There's a rock stuck in\nthe machine. Maybe this is...\n");
      speak(Entity.System, "I removed the rock!");
      dead_string("?is is...\n");
      speak(Entity.Player, "That should do it.\n");
      setTrigger(Trigger(155));
      return;
    } else {
      playSound(8, 4);
      rotate3DObject(0, 1);
      delay(1);
      rotate3DObject(1, 1);
      delay(1);
      rotate3DObject(0, 1);
      delay(1);
      rotate3DObject(1, 1);
      delay(1);
      rotate3DObject(0, 1);
      delay(1);
      rotate3DObject(1, 1);
      delay(1);
      rotate3DObject(0, 1);
      delay(1);
      rotate3DObject(1, 1);
      delay(1);
      playSound(8, 5);
      warp(to: Map.GCAN03, spawn: 2, trigger: 55);
      return;
    }
    return;

L3:
  }
  return;
}

section(53) {
  playSound(8, 5);
  setTrigger(Trigger(180));
  unsetTrigger(Trigger(181));
  return;
