// DG117.SCN
#include "functions.dgs"
#pragma script index=117 start=0x4d800 end=0x4e000 headerU16=0x24 sentinelOff=0x24
#include "entities.dgs"

section onEnter(254) {
  spawnItemChance(max: 99, chance: 9, item: Item.Digimushroom, x: 48, y: 68);
  spawnItemChance(max: 99, chance: 3, item: Item.Pricklypear, x: 76, y: 49);
  unsetTrigger(Trigger(98));
  return;
}

section(5) {
  speak(Entity(5), "「どりゃあああ!」<NEWLINE>");
  finishEncounter(Trigger(280));
}

section(6) {
  speak(Entity(6), "「はぁぁぁぁぁーっ!」<NEWLINE>");
  finishEncounter(Trigger(280));
}

section(7) {
  speak(Entity(7), "「きぇぇぇぇーっ!」<NEWLINE>");
  finishEncounter(Trigger(280));
}

section(81) {
  rotate(entity: Entity.Player, to: 1944);
  waitForEntity(Entity.Player);
  speak(Entity.System, "東・エレベータ<NEWLINE> <NEWLINE>西・危険!ガケに注意<NEWLINE>");
  if (trigger(54)) {
    return;
  }
  setDialogOwner(Entity.System);
  setSelection(L1, L2);
  showTextbox("「オーガモード・ON」<NEWLINE>「オーガモード・OFF」<NEWLINE>");

L1:
  setTrigger(Trigger(197));
  warp(to: Map.GCAN08_2, spawn: 0, trigger: 255);
  return;

L2:
  unsetTrigger(Trigger(197));
  warp(to: Map.GCAN08_2, spawn: 0, trigger: 255);
  return;
}

section(82) {
  rotate(entity: Entity.Player, to: 1944);
  waitForEntity(Entity.Player);
  speak(Entity.System, "落ばんに注意!!<NEWLINE>");
  return;
}

section(51) {
  if (!trigger(197)) {
    return;
  }
  if (trigger(198)) {
    return;
  }
  if (trigger(98)) {
    return;
  }
  rotate(entity: Entity.Player, to: 1944);
  panTo(x: 2000, y: 173, slowdown: 30);
  speak(Entity.Player, "「今までの情報をもとにすると、<NEWLINE> どうやらウワサの山賊が出る道は<NEWLINE> ここらしいな…」<NEWLINE>");
  showTextbox("「よーし、いくぜ、<ORANGE><DIGIMON><WHITE>。」<NEWLINE>");
  move(entity: Entity.Player, to: (1925, 468), sprint: 0);
  move(entity: Entity.Partner, to: (1925, 78), sprint: 0);
  waitForPair();
  loadDigimon(Digimon.NPCOgremon);
  loadDigimon(Digimon.Agumon);
  setDigimonBatch([
    Digimon.NPCOgremon => Entity(3),
    Digimon.Agumon => Entity(4),
    Digimon.Agumon => Entity(5),
  ], autotalk: 0);
  speak(Entity(9), "「いやっほーーーい!」<NEWLINE>");
  playSound(8, 11);
  speak(Entity(8), "「ぐわはははは!」<NEWLINE>");
  speak(Entity(10), "「ひゃっほーう!」<NEWLINE>");
  delay(10);
  playSound(8, 1);
  playAnimation(Entity(8), Animation(31));
  move(entity: Entity(8), to: (1000, 1288), animDuration: 30);
  move(entity: Entity(9), to: (2067, 1561), sprint: 1);
  move(entity: Entity(10), to: (2059, -383), sprint: 1);
  for id in Entity(8)..Entity(10) {
    waitForEntity(id);
  }
  look(entity: Entity(8), at: Entity.Player);
  look(entity: Entity(9), at: Entity.Player);
  look(entity: Entity(10), at: Entity.Player);
  look(entity: Entity.Player, at: Entity(8));
  look(entity: Entity.Partner, at: Entity(9));
  delay(10);
  playSound(8, 11);
  speak(Entity(8), "「ぬははは、カンネンして荷物を置いてけ!<NEWLINE> いてえ目にあうぜぇ!」<NEWLINE>");
  anim(Entity.Player, Animation(20), wait: 15);
  speak(Entity.Player, "「カンネンするのはそっちだ!」<NEWLINE>");
  playAnimation(Entity.Player, Animation(0));
  speak(Entity(8), "「ん?!てめえらは…」<NEWLINE>");
  speak(Entity(8), "「もしかして…」<NEWLINE>");
  speak(Entity(9), "「お、おかしら、どうしましょう?!」<NEWLINE>");
  look(entity: Entity(9), at: Entity(8));
  speak(Entity(8), "「さわぐな!数でも力でもこっちが上だ。<NEWLINE> たたきのめしてやれ!」<NEWLINE>");
  look(entity: Entity(8), at: Entity(9));
  setTrigger(Trigger(1));
  setPStat(PStat(250), 1);
  setPStat(PStat(251), 8);
  setPStat(PStat(252), 9);
  setPStat(PStat(253), 10);
  startBattle();
  unsetTrigger(Trigger(1));
  setPStat(PStat(250), 0);
  look(entity: Entity.Player, at: Entity(8));
  look(entity: Entity(8), at: Entity.Player);
  look(entity: Entity.Partner, at: Entity(8));
  move(entity: Entity(9), to: (1350, 2350), sprint: 1);
  move(entity: Entity(10), to: (1850, 2350), sprint: 1);
  waitForEntity(Entity(9));
  waitForEntity(Entity(10));
  unloadEntity(Entity(9));
  unloadEntity(Entity(10));
  speak(Entity(8), "「むぐぐ…お、覚えてろよー!」<NEWLINE>");
  move(entity: Entity(8), to: (1650, 2350), sprint: 1);
  waitForEntity(Entity(8));
  unloadEntity(Entity(8));
  speak(Entity.Player, "「何て逃げ足だ!でもこれでしばらくは<NEWLINE> ここには現われないだろう。」<NEWLINE>");
  followEntity(Entity.Player, speed: 10);
  for x in [Trigger(198), Trigger(142), Trigger(155)] {
    setTrigger(x);
  }
  return;
}

section(52) {
  setTrigger(Trigger(98));
  return;
