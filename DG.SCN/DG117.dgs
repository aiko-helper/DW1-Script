// DG117.SCN
#pragma script index=117 start=0x54800 end=0x55000 headerU16=0x30 sentinelOff=0x24

section onEnter(254) {
    roll(pstat: 110, max: 99);
    if (pstat[110] > 4) goto L1;
    spawnItem(Item.Digimushroom, x: 35, y: 19);

L1:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 16) goto L2;
    spawnItem(Item.Digimushroom, x: 55, y: 50);

L2:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 6) goto L3;
    spawnItem(Item.Digimushroom, x: 47, y: 4);

L3:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 3) goto L4;
    spawnItem(Item.Digipine, x: 40, y: 45);

L4:
    setTrigger(112);
    return;
}

section(5) {
    speak(5, "Who is it?\n");
    startBattle();
    setTrigger(289);
    return;
}

section(6) {
    speak(6, "I'm going! Just kidding.\n");
    startBattle();
    setTrigger(289);
    return;
}

section(7) {
    speak(7, "Ha ha ha. This's great.\n");
    startBattle();
    setTrigger(289);
    return;
}

section(8) {
    speak(8, "Oh, I'm gonna\nenjoy this!\n");
    startBattle();
    setTrigger(280);
    return;
}

section(9) {
    speak(9, "Are you serious?!\n");
    startBattle();
    setTrigger(280);
    return;
}

section(10) {
    speak(10, "Hey, are you serious?!\n");
    startBattle();
    setTrigger(289);
    return;
}

section(11) {
    speak(11, "Be Quiet!\n");
    startBattle();
    setTrigger(296);
    return;
}

section(12) {
    speak(12, "I can do it\nwhen I put my mind to it!\n");
    startBattle();
    setTrigger(296);
    return;
}

section(51) {
    move(entity: Entity.Player, to: (-1700, -1800), sprint: 0);
    if (!trigger(114) && !trigger(147)) goto L1;
    warp(to: Map.MIST03, spawn: 1, trigger: 255);

L1:
    roll(pstat: 110, max: 99);
    if (pstat[110] >= 69) goto L2;
    warp(to: Map.MIST03, spawn: 1, trigger: 255);
    goto section_52;

L2:
    warp(to: Map.MIST04, spawn: 1, trigger: 255);
}

section(52) {
    move(entity: Entity.Player, to: (-2600, 4000), sprint: 0);
    if (!trigger(114) && !trigger(147)) goto L1;
    warp(to: Map.MIST05, spawn: 1, trigger: 255);

L1:
    addPStat(120, 1);
    if (pstat[120] != 10) goto L2;
    setPStat(120, 0);
    warp(to: Map.MIST05, spawn: 1, trigger: 255);

L2:
    roll(pstat: 110, max: 99);
    if (pstat[110] >= 69) goto L3;
    warp(to: Map.MIST03, spawn: 1, trigger: 255);
    goto L4;

L3:
    warp(to: Map.MIST07, spawn: 2, trigger: 255);

L4:
    garbage { 30 00 fe 00 30 00 05 00 8e 00 06 00 b8 00 07 00 fe 00 08 00 42 01 09 00 8a 01 0a 00 c2 01 0b 00 04 02 0c 00 2c 02 33 00 8c 02 34 00 c4 02 ff ff 24 00 6e 63 19 00 0b 00 6e 04 18 00 46 00 19 00 74 2c 23 00 13 00 24 00 6e 63 19 00 0b 00 6e 10 18 00 5c 00 19 00 74 2c 37 00 32 00 24 00 6e 63 19 00 0b 00 6e 06 18 00 72 00 19 00 74 2c 2f 00 04 00 24 00 6e 63 19 00 0b 00 6e 03 18 00 88 00 19 00 74 2f 28 00 2d 00 1c 00 70 00 fe 00 1b 05 1a 00 82 76 82 88 82 8f 81 40 82 89 82 93 81 40 82 89 82 94 81 48 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 21 01 fe 00 1b 06 1a 00 82 68 81 75 82 8d 81 40 82 87 82 8f 82 89 82 8e 82 87 81 49 81 40 82 69 82 95 82 93 82 94 81 40 82 8b 82 89 82 84 82 84 82 89 82 8e 82 87 81 42 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 21 01 fe 00 1b 07 1a 00 82 67 82 81 81 40 82 88 82 81 81 40 82 88 82 81 81 42 81 40 82 73 82 88 82 89 82 93 81 75 82 93 81 40 82 87 82 92 82 85 82 81 82 94 81 42 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 21 01 fe 00 1b 08 1a 00 82 6e 82 88 81 43 81 40 82 68 81 75 82 8d 81 40 82 87 82 8f 82 8e 82 8e 82 81 0d 00 82 85 82 8e 82 8a 82 8f 82 99 81 40 82 94 82 88 82 89 82 93 81 49 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 18 01 fe 00 1b 09 1a 00 82 60 82 92 82 85 81 40 82 99 82 8f 82 95 81 40 82 93 82 85 82 92 82 89 82 8f 82 95 82 93 81 48 81 49 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 18 01 fe 00 1b 0a 1a 00 82 67 82 85 82 99 81 43 81 40 82 81 82 92 82 85 81 40 82 99 82 8f 82 95 81 40 82 93 82 85 82 92 82 89 82 8f 82 95 82 93 81 48 81 49 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 21 01 fe 00 1b 0b 1a 00 82 61 82 85 81 40 82 70 82 95 82 89 82 85 82 94 81 49 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 28 01 fe 00 1b 0c 1a 00 82 68 81 40 82 83 82 81 82 8e 81 40 82 84 82 8f 81 40 82 89 82 94 0d 00 82 97 82 88 82 85 82 8e 81 40 82 68 81 40 82 90 82 95 82 94 81 40 82 8d 82 99 81 40 82 8d 82 89 82 8e 82 84 81 40 82 94 82 8f 81 40 82 89 82 94 81 49 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 28 01 fe 00 4e fd 5c f9 f8 f8 00 00 19 00 