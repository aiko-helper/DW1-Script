// DG117.SCN
#pragma script index=117 start=0x54800 end=0x55000 headerU16=0x30 sentinelOff=0x24

section onEnter(254) {  // len=94
    roll(pstat: 110, max: 99);
    if (pstat[110] > 4) goto L_0016;
    spawnItem(Item.Digimushroom, 35, 19);
L_0016:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 16) goto L_002c;
    spawnItem(Item.Digimushroom, 55, 50);
L_002c:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 6) goto L_0042;
    spawnItem(Item.Digimushroom, 47, 4);
L_0042:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 3) goto L_0058;
    spawnItem(Item.Digipine, 40, 45);
L_0058:
    setTrigger(112);
    return;
}

section section_5(5) {  // len=42
    setDialogOwner(5);
