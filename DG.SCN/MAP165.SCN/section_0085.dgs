// source: extract/DIGIMON/SCN/DG.SCN
// MAP165.SCN, section 85

section section_85(85) {  // len=666
    if (trigger(94)) goto L_01f4;
    setTrigger(94);
    setDialogOwner(Entity.Player);
    showTextbox("What's this machine?\n");
    look(entity: 5, at: Entity.Player);
    look(entity: Entity.Player, at: 5);
    delay(5);
    setDialogOwner(5);
    showTextbox("That's a <PINK>Save Machine\nfor Memory Card Battle\nData<WHITE>.\n");
    showTextbox("Using that machine, you can\nsave your current partner's\ndata for battle.\n");
    showTextbox("All you have to do is press\n<LIGHTBLUE><X> <WHITE>and the machine\nwill tell you what to do.\n");
    rotate(entity: Entity.Player, to: 0);
    delay(5);
    return;
L_01f4:
    setDialogOwner(Entity.System);
    showTextbox("Do you want to use the\n<PINK>Save Machine for\nMemory Card Battle<WHITE>?\n");
    setSelection(L_0292, L_0298);
    showTextbox("Yes\nNo\n");
    waitForSelectionChoice();
    return;
L_0292:
    fadeOutHUD();
    callSubroutine(48);
    return;
L_0298:
    return;
}
