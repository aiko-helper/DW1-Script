section section_7(7) {  // len=472
    if (trigger(224) || !trigger(175)) goto L_0074;
    setDialogOwner(7);
    showTextbox("Sounds like Yuramon has\ngathered more rumors.\n");
    return;
L_0074:
    if (!trigger(124) || !trigger(103)) goto L_00da;
    setDialogOwner(7);
    showTextbox("I heard Yuramon\nknows some new rumors.\n");
    return;
L_00da:
    if (pstat[1] < 6) goto L_0166;
    setDialogOwner(7);
    showTextbox("The city's starting to\ngrow and change\nnow that we're here.\n");
    return;
L_0166:
    setDialogOwner(7);
    showTextbox("<LIGHTBLUE><PLAYER><WHITE>, you have a\nway different\napproach to adventure.\n");
    return;
}
