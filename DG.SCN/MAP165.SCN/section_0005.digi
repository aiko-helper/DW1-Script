section_5(5):     ; len=1948
  0000:  if trigger(202) OR trigger(215) OR pstat[16] == 0 then section_5+0x236
  0014:  if !trigger(201) OR !trigger(243) then section_5+0x236
  0024:  speak 5 "You came here at the perfect\ntime! I have a big favor to\nask that only you can do.\n"
  00d0:  speak Player "What is it?\n"
  00ee:  speak 5 "It's the same evil\nI felt from Analogman\nand Machinedramon.\n"
  016c:  showTextbox "But I can't tell\nwhere it's coming from.\n"
  01c2:  speak Player "Alright, leave it to me!\n"
  01fa:  speak 5 "Thank you. By the way...\n"
  0232:  jump section_5+0x788
  0236:  if !trigger(202) OR trigger(215) then section_5+0x57c
  0246:  speak 5 "I heard that you\nbeat Machinedramon!\n"
  0296:  speak Player "Yeah, but I don't get it.\nIt seemed like the\ncurse of Analogman.\n"
  031e:  speak 5 "His grudge was so strong.\nMaybe we can have peace now.\n"
  0392:  speak Player "If Machinedramon returns,\nwe can beat him again.\n"
  03fa:  speak 5 "You are trustworthy. Here's\na sign of my gratitude.\nIt grew in our Meat farm.\n"
  049c:  speak Player "Woah! A <LIGHTBLUE>Chained\nMelon<WHITE>?\n"
  04d4:  giveItem ChainMelon 1
  04d8:  if !trigger(0) then section_5+0x534
  04e4:  if item[SpikeClub] < 99 then section_5+0x4f4
  04f2:  endSection
  04f4:  speak Player "I have too many Items.\n"
  0528:  setTrigger 3
  052c:  callSubroutine 0
  052e:  callSubroutine 13
  0530:  giveItem ChainMelon 1
  0534:  speak Player "I gladly accept, thank you!\n"
  0572:  pstat[28] = 0
  0576:  setTrigger 215
  057a:  endSection
  057c:  if !trigger(50) OR trigger(201) then section_5+0x788
  058c:  speak 5 "Oh, you're back!\nThis is something I can't\nask anybody else.\n"
  060c:  speak Player "Okay. Do you mean\nAnalogman is back?\n"
  065c:  speak 5 "I felt his evil, but\nI can't tell where it is.\n"
  06c0:  speak Player "Alright, leave it to me!\nI'll go find him and\ntake care of it.\n"
  0744:  speak 5 "Oh, thank you. By the way...\n"
  0784:  setTrigger 201
  0788:  if !trigger(203) then section_5+0x79a
  0794:  jumpToScriptSection MGEN03 51
