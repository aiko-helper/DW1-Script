// source: extract/DIGIMON/SCN/DG.SCN
// MAP165.SCN, section 5

section section_5(5) {  // len=1948
    if (trigger(202) || trigger(215) || pstat[16] == 0) goto L_0236;
    if (!trigger(201) || !trigger(243)) goto L_0236;
    setDialogOwner(5);
    showTextbox("You came here at the perfect\ntime! I have a big favor to\nask that only you can do.\n");
    setDialogOwner(Entity.Player);
    showTextbox("What is it?\n");
    setDialogOwner(5);
    showTextbox("It's the same evil\nI felt from Analogman\nand Machinedramon.\n");
    showTextbox("But I can't tell\nwhere it's coming from.\n");
    setDialogOwner(Entity.Player);
    showTextbox("Alright, leave it to me!\n");
    setDialogOwner(5);
    showTextbox("Thank you. By the way...\n");
    goto L_0788;
L_0236:
    if (!trigger(202) || trigger(215)) goto L_057c;
    setDialogOwner(5);
    showTextbox("I heard that you\nbeat Machinedramon!\n");
    setDialogOwner(Entity.Player);
    showTextbox("Yeah, but I don't get it.\nIt seemed like the\ncurse of Analogman.\n");
    setDialogOwner(5);
    showTextbox("His grudge was so strong.\nMaybe we can have peace now.\n");
    setDialogOwner(Entity.Player);
    showTextbox("If Machinedramon returns,\nwe can beat him again.\n");
    setDialogOwner(5);
    showTextbox("You are trustworthy. Here's\na sign of my gratitude.\nIt grew in our Meat farm.\n");
    setDialogOwner(Entity.Player);
    showTextbox("Woah! A <LIGHTBLUE>Chained\nMelon<WHITE>?\n");
    giveItem(Item.ChainMelon, 1);
    if (!trigger(0)) goto L_0534;
    if (item[Item.SpikeClub] < 99) goto L_04f4;
    return;
L_04f4:
    setDialogOwner(Entity.Player);
    showTextbox("I have too many Items.\n");
    setTrigger(3);
    callSubroutine(0);
    callSubroutine(13);
    giveItem(Item.ChainMelon, 1);
L_0534:
    setDialogOwner(Entity.Player);
    showTextbox("I gladly accept, thank you!\n");
    setPStat(28, 0);
    setTrigger(215);
    return;
L_057c:
    if (!trigger(50) || trigger(201)) goto L_0788;
    setDialogOwner(5);
    showTextbox("Oh, you're back!\nThis is something I can't\nask anybody else.\n");
    setDialogOwner(Entity.Player);
    showTextbox("Okay. Do you mean\nAnalogman is back?\n");
    setDialogOwner(5);
    showTextbox("I felt his evil, but\nI can't tell where it is.\n");
    setDialogOwner(Entity.Player);
    showTextbox("Alright, leave it to me!\nI'll go find him and\ntake care of it.\n");
    setDialogOwner(5);
    showTextbox("Oh, thank you. By the way...\n");
    setTrigger(201);
L_0788:
    if (!trigger(203)) goto L_079a;
    jumpToScriptSection(210, 51);
L_079a:
    return;
}
