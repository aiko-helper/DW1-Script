// DG062.SCN
#include "functions.dgs"
#pragma script index=62 start=0x2d800 end=0x2e000 headerU16=0x10 sentinelOff=0x19
#include "entities.dgs"

section onEnter(254) {
  if (trigger(131)) {
    setObjectVisibility(4, 1);
  }
  return;
}

section(81) {
  if (!trigger(131)) {
    {
      rotate(entity: Entity.Player, to: 91);
      delay(10);
      speak(Entity.Player, "What are those?\nAny books I can read?\n");
      rotate(entity: Entity.Player, to: 3675);
      delay(10);
      rotate(entity: Entity.Player, to: 91);
      delay(10);
      rotate(entity: Entity.Player, to: 603);
      delay(10);
      rotate(entity: Entity.Player, to: 1115);
      delay(10);
      rotate(entity: Entity.Player, to: 1627);
      delay(10);
      rotate(entity: Entity.Player, to: 1115);
      delay(10);
      speak(Entity.Player, "No. None I can read.\n");
      showTextbox("Wow! A book with\na cool cover!\n");
      choice { "I'll take it" -> L1, "I'd better not" -> L_01ea }
      break;

L1:
      move(entity: Entity.Player, to: (-314, -603), sprint: 0);
      move(entity: Entity.Partner, to: (-298, -335), sprint: 0);
      waitForPair();
      rotate(entity: Entity.Player, to: 1115);
      rotate(entity: Entity.Partner, to: 91);
      speak(Entity.System, "Touched a cool book.\n");
      speak(Entity.Player, "Huh?\n");
      playSound(8, 4);
      setObjectVisibility(3, 1);
      setObjectVisibility(4, 0);
      setTrigger(Trigger(131));
      playAnimation(Entity.Player, Animation(26));
      move(entity: Entity.Player, to: (655, -663), animDuration: 4);
      move(entity: Entity.Partner, to: (694, -377), animDuration: 4);
      playSound(8, 5);
      speak(Entity.Player, "Wow!\n");
      warp(to: Map.YAKA15, spawn: 4, trigger: 53);
      return;
    }
    speak(Entity.Player, "It might be a trap....\nLeave it!\n");
  }
  return;
}

section(82) {
  rotate3DObject(0, 1);
  sfx(8, 1, wait: 10);
  move(entity: Entity.Player, to: (-1500, 615), sprint: 0);
  warp(to: Map.YAKA11B, spawn: 1, trigger: 255);
  return;
  garbage { 10 00 fe 00 10 00 51 00 22 00 52 00 56 02 ff ff 19 00 00 00 83 00 18 00 20 00 19 00 57 00 04 01 fe 00 19 00 01 00 83 00 18 00 54 02 19 00 4d fd 5b 00 67 00 0a 00 1b fd 1a 00 82 76 82 88 82 81 82 94 81 40 82 81 82 92 82 85 81 40 82 94 82 88 82 8f 82 93 82 85 81 48 0d 00 82 60 82 8e 82 99 81 40 82 82 82 8f 82 8f 82 8b 82 93 81 40 82 68 81 40 82 83 82 81 82 8e 81 40 82 92 82 85 82 81 82 84 81 48 0d 00 00 00 4d fd 5b 0e 67 00 0a 00 4d fd 5b 00 67 00 0a 00 4d fd 5b 02 67 00 0a 00 4d fd 5b 04 67 00 0a 00 4d fd 5b 06 67 00 0a 00 4d fd 5b 04 67 00 0a 00 1b fd 1a 00 82 6d 82 8f 81 42 81 40 82 6d 82 8f 82 8e 82 85 81 40 82 68 81 40 82 83 82 81 82 8e 81 40 82 92 82 85 82 81 82 84 81 42 0d 00 00 00 1a 00 82 76 82 8f 82 97 81 49 81 40 82 60 81 40 82 82 82 8f 82 8f 82 8b 81 40 82 97 82 89 82 94 82 88 0d 00 82 81 81 40 82 83 82 8f 82 8f 82 8c 81 40 82 83 82 8f 82 96 82 85 82 92 81 49 0d 00 00 00 10 02 72 01 0c 02 1a 00 82 68 81 75 82 8c 82 8c 81 40 82 94 82 81 82 8b 82 85 81 40 82 89 82 94 0d 00 82 68 81 75 82 84 81 40 82 82 82 85 82 94 82 94 82 85 82 92 81 40 82 8e 82 8f 82 94 0d 00 00 00 12 00 16 00 0c 02 4e fd c6 fe a5 fd 00 00 4e fc d6 fe b1 fe 00 00 4a fd 4a fc 4d fd 5b 04 4d fc 5b 00 1b ff 1a 00 82 73 82 8f 82 95 82 83 82 88 82 85 82 84 81 40 82 81 81 40 82 83 82 8f 82 8f 82 8c 81 40 82 82 82 8f 82 8f 82 8b 81 42 0d 00 00 00 1b fd 1a 00 82 67 82 95 82 88 81 48 0d 00 00 00 5a 00 08 04 57 00 03 01 57 00 04 00 1c 00 83 00 56 00 fd 1a 6c fd 8f 02 69 fd 04 00 6c fc b6 02 87 fe 04 00 5a 00 08 05 1b fd 1a 00 82 76 82 8f 82 97 81 49 0d 00 00 00 4b 39 04 35 fe 00 1b fd 1a 00 82 68 82 94 81 40 82 8d 82 89 82 87 82 88 82 94 81 40 82 82 82 85 81 40 82 81 81 40 82 94 82 92 82 81 82 90 81 42 81 42 81 42 81 42 0d 00 82 6b 82 85 82 81 82 96 82 85 81 40 82 89 82 94 81 49 0d 00 00 00 fe 00 70 00 00 01 5a 00 08 01 67 00 0a 00 4e fd 24 fa 67 02 00 00 4b 35 01 ff fe 00 ff 00 81 40 82 8d 82 85 82 8d 82 8f 81 42 0d 00 00 00 1b ff 1a 00 82 71 82 85 82 94 82 95 82 92 82 8e 81 40 82 94 82