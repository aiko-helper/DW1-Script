// DG062.SCN
#include "functions.dgs"
#pragma script index=62 start=0x2b800 end=0x2c000 headerU16=0x28 sentinelOff=0xfe
#include "entities.dgs"

section onEnter(254) {
  return;
}

section(51) {
  if (!trigger(130)) {
    speak(Entity(5), "「コロシ…テヤル…!」<NEWLINE>");
    setTrigger(Trigger(1));
    setPStat(PStat(250), 1);
    setPStat(PStat(251), 5);
    setPStat(PStat(252), 255);
    setPStat(PStat(253), 255);
    startBattle();
    unsetTrigger(Trigger(1));
    setPStat(PStat(250), 0);
    unloadEntity(Entity(5));
    setTrigger(Trigger(130));
    setTrigger(Trigger(290));
    followEntity(Entity.Player, speed: 10);
    return;
  }
  return;
}

section(81) {
  rotate(entity: Entity.Player, to: 2048);
  delay(5);
  speak(Entity.Player, "「げ、黒いカベだ!だまされた!」<NEWLINE>");
  return;
}

section(5) {
  goto section_51;

L1:
  return;
}

section(6) {
  speak(Entity(6), "「………」<NEWLINE>");
  finishEncounter(Trigger(301));
}

section(7) {
  speak(Entity(7), "「………」<NEWLINE>");
  finishEncounter(Trigger(301));
}

section(8) {
  speak(Entity(8), "「………」<NEWLINE>");
  finishEncounter(Trigger(301));
}

section(9) {
  speak(Entity(9), "「………」<NEWLINE>");
  finishEncounter(Trigger(301));
}

