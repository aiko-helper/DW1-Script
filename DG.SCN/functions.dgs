// In-language opcode definitions.  Each shadows a built-in mnemonic
// by macro-expanding to a `raw(...)` byte sequence.  Auto-emitted by
// digi-disasm; do not edit by hand.

function waitForSelectionChoice() {
  raw(0x12, 0);
}

function jumpReturn() {
  raw(0x15, 0);
}

function setDialogOwner(v: Entity) {
  raw(0x1b, v);
}

function setPStat(p: PStat, v) {
  raw(0x1e, 0, p, v);
}

function addPStat(p: PStat, v) {
  raw(0x1f, 0, p, v);
}

function reducePStat(p: PStat, v) {
  raw(0x20, 0, p, v);
}

function storeMapID(p: PStat) {
  raw(0x21, p);
}

function storeDigimonType(p: PStat) {
  raw(0x22, p);
}

function setInventorySize(s) {
  raw(0x23, s);
}

function setTextboxSize(w, h) {
  raw(0x26, 0, w, h);
}

function fadeOutHUD() {
  raw(0x27, 0);
}

function giveItem(i: Item, a) {
  raw(0x28, 0, i, a);
}

function removeItem(i: Item, a) {
  raw(0x29, 0, i, a);
}

function learnMove(m: Move) {
  raw(0x2d, m);
}

function giveCard(c) {
  raw(0x2f, c);
}

function takeCard(c) {
  raw(0x30, c);
}

function advanceToDate(p: PStat) {
  raw(0x37, p);
}

function storeDigimonTypus(v, p: PStat) {
  raw(0x3f, 0, v, p);
}

function loadDigimon(d: Digimon) {
  raw(0x46, d);
}

function setDigimon(t: Digimon, e: Entity, a) {
  raw(0x47, t, e, a);
}

function unloadEntity(e: Entity) {
  raw(0x48, e);
}

function callDigimonSubroutine(r) {
  raw(0x49, r);
}

function waitForEntity(e: Entity) {
  raw(0x4a, e);
}

function playAnimation(e: Entity, a) {
  raw(0x56, 0, e, a);
}

function setObjectVisibility(o, i) {
  raw(0x57, 0, o, i);
}

function playSound(r, s) {
  raw(0x5a, 0, r, s);
}

function setBGM(m) {
  raw(0x5d, m);
}

function callSubroutine(r) {
  raw(0x64, r);
}

function removeCondition(m: Condition) {
  raw(0x65, m);
}

function setTexboxMode(m, d) {
  raw(0x68, 0, m, d);
}

// S16 / S32 payload opcodes (use width-typed raw wrappers).

function setTrigger(bit: Trigger) {
  raw(0x1c, 0, s16(bit));
}

function unsetTrigger(bit: Trigger) {
  raw(0x1d, 0, s16(bit));
}

function setMerit(v) {
  raw(0x31, 0, s16(v));
}

function addMerit(v) {
  raw(0x32, 0, s16(v));
}

function delay(d) {
  raw(0x67, 0, s16(d));
}

function addMoney(v) {
  raw(0x2a, 0, s32(v));
}

function reduceMoney(v) {
  raw(0x2b, 0, s32(v));
}

function addMinutesToDate(pstat: PStat, v) {
  raw(0x38, pstat, s32(v));
}

function setScript(scriptId, mapId: Map) {
  raw(0xfb, 0, s16(scriptId), s16(mapId));
}

function setStats(stat: Stat, value) {
  raw(0x34, stat, s16(value));
}

function addStats(stat: Stat, value) {
  raw(0x35, stat, s16(value));
}

function reduceStats(stat: Stat, value) {
  raw(0x36, stat, s16(value));
}

function rotate(entity: Entity, to) {
  raw(0x4d, entity, s16(to));
}

function setTextboxOrigin(x, z, y) {
  raw(0x55, 0, s16(x), s16(z), s16(y));
}

function dealMapDamage(pstat: PStat) {
  raw(0x69, pstat);
}

function setAutotalk(entity: Entity, value) {
  raw(0x6a, 0, entity, value);
}

function rotate3DObject(modelId, rotation) {
  raw(0x70, modelId, 0, rotation);
}

function moveObjectTo(v1, v2, v3, v4, v5, x, y) {
  raw(0x71, v1, v2, v3, v4, v5, s16(x), s16(y));
}

function spawnBoulder() {
  raw(0x76, 0);
}

function moveBoulder(translateZ, translateY) {
  raw(0x77, 0, s16(translateZ), s16(translateY));
}

function despawnBoulder() {
  raw(0x78, 0);
}

function unloadModel(digimon: Digimon) {
  raw(0x79, digimon);
}

function copyPStat(source: PStat, target: PStat) {
  raw(0x7a, 0, source, target);
}

function sectionOnExit(trigger) {
  raw(0x7b, trigger);
}

function setRectImpassible(x, y, width, height) {
  raw(0x7c, 0, s16(x), s16(y), width, height);
}

function spawnSpriteAtLocation(sprite, x, y, z, unk) {
  raw(0x7d, sprite, s16(x), s16(y), s16(z), s16(unk));
}

function spawnSpriteAtEntity(entity: Entity, sprite) {
  raw(0x7e, entity, s16(sprite));
}

// Named-arg synonyms (disasm emits with `field: value` form).

function teleport(pstat: PStat) {
  raw(0x58, pstat);
}

function roll(pstat: PStat, max) {
  raw(0x24, 0, pstat, max);
}

function warp(to: Map, spawn, trigger) {
  raw(0x4b, to, spawn, trigger);
}

// Multi-opcode composites (previously built-in C++ sugars).

function loadAndSetDigimon(digimon: Digimon, entity: Entity, autotalk) {
  loadDigimon(digimon);
  setDigimon(digimon, entity, autotalk);
}

function switchToMap(scriptId, map: Map, pStatValue, musicId) {
  setScript(scriptId, map);
  setPStat(245, pStatValue);
  setBGM(musicId);
}

function runDigimonRoutine(trigger, routine) {
  sectionOnExit(trigger);
  callDigimonSubroutine(routine);
  waitForEntity(Entity.System);
}

function startBattle() {
  fadeOutHUD();
  delay(1);
  raw(0x66, 0);
}

function speak(o, t) {
  setDialogOwner(o);
  showTextbox(t);
}

function learnMoves(moves: Move[]) {
  for m in moves {
    learnMove(m);
  }
}
