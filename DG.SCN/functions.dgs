function setTextboxSize(w, h)        { raw(0x26, 0, w, h); }
function fadeOutHUD()                { raw(0x27, 0); }
function giveItem(i, a)              { raw(0x28, 0, Item!i, a); }
function removeItem(i, a)            { raw(0x29, 0, Item!i, a); }
function learnMove(m)                { raw(0x2d, Move!m); }
function giveCard(c)                 { raw(0x2f, c); }
