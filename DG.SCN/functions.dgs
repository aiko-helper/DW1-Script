  setDigimon(digimon2, entity2, autotalk);
}

function loadDigimonThenLoadAndSetDigimonThenSetDigimonThenSetDigimon(digimon: Digimon, digimon2: Digimon, entity: Entity, digimon3: Digimon, entity2: Entity, digimon4: Digimon, entity3: Entity) {
  loadDigimon(digimon);
  loadAndSetDigimon(digimon2, entity, 1);
  setDigimon(digimon3, entity2, 1);
  setDigimon(digimon4, entity3, 1);
}

function loadAndSetDigimonThenSetDigimonThenLoadAndSetDigimonThenSetDigimon(digimon: Digimon, entity: Entity, entity2: Entity, digimon2: Digimon, entity3: Entity, entity4: Entity) {
  loadAndSetDigimon(digimon, entity, 1);
  setDigimon(digimon, entity2, 1);
  loadAndSetDigimon(digimon2, entity3, 1);
  setDigimon(digimon2, entity4, 1);
}

function loadAndSetDigimonThenSetDigimonThenSetDigimon(digimon: Digimon, entity: Entity, autotalk, entity2: Entity, autotalk2, entity3: Entity) {
  loadAndSetDigimon(digimon, entity, autotalk);
  setDigimon(digimon, entity2, autotalk2);
  setDigimon(digimon, entity3, autotalk2);
}

function switchToMapThenLoadDigimonThenLoadDigimon(scriptId, map: Map, musicId, digimon: Digimon, digimon2: Digimon) {
  switchToMap(scriptId, map, 0, musicId);
  loadDigimon(digimon);
  loadDigimon(digimon2);
}

