function loadDigimonThenLoadDigimonThenSetDigimonThenSetDigimonThenSetDigimon(digimon: Digimon, digimon2: Digimon, entity: Entity, autotalk, digimon3: Digimon, entity2: Entity, digimon4: Digimon, entity3: Entity) {
