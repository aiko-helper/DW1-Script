section onEnter(254) {
  roll(pstat: 110, max: 99);
  if (pstat[110] > 15) goto L1;
  spawnItem(Item.Digimushroom, x: 38, y: 72);

L1:
  roll(pstat: 110, max: 99);
  if (pstat[110] > 7) goto L2;
  spawnItem(Item.Digimushroom, x: 46, y: 81);

L2:
  roll(pstat: 110, max: 99);
  if (pstat[110] > 18) goto L3;
  spawnItem(Item.Digimushroom, x: 60, y: 83);

L3:
  roll(pstat: 110, max: 99);
  if (pstat[110] > 14) goto L4;
  spawnItem(Item.Digimushroom, x: 69, y: 71);

L4:
  return;
}

section(5) {
  if (pstat[111] < 1) goto L1;
  speak(5, "I'm here again.\n");
  jumpAndLink(L3);
  playSound(8, 6);
  speak(5, "Bye!\n");
  lookPairAt(5);
  waitForPair();
  playAnimation(Entity.Player, 16);
  speak(Entity.Player, "If we go on like this, we'll\njust repeat ourselves.\n");
  speak(Entity.Player, "Maybe I should wait here.\n");
  setPStat(111, 2);
  for id in 191..194 {
    setTrigger(id);
  }
  return;

L1:
  if (pstat[111] != 0) goto L2;
  speak(5, "Who is it?\n");
  speak(5, "No way.\n");
  move(entity: 5, to: (-240, -1076), sprint: 1);
  delay(20);
  playSound(8, 6);
  speak(5, "Ahhh!\n");
  lookPairAt(5);
  waitForPair();
  playAnimation(Entity.Player, 14);
  speak(Entity.Player, "Wait up!\n");
  move(entity: 5, to: (-240, -1076), sprint: 1);
  waitForEntity(5);
  addPStat(111, 1);
  setPStat(PStat.LastBiyomonChaseLocation, 1);
  return;

L2:
  return;

L3:
  loop {
    roll(pstat: 110, max: 3);
    if (pstat[110] != 0 || pstat[112] == 0) goto L4;
    move(entity: 5, to: (-1055, 2740), sprint: 1);
    delay(20);
    setPStat(PStat.LastBiyomonChaseLocation, 0);
    speak(Entity.Player, "Not again! Wait!\n");
    lookPairAt(5);
    move(entity: 5, to: (-1025, 2740), sprint: 1);
    waitForEntity(5);
    jumpReturn();

L4:
    if (pstat[110] != 1 || pstat[112] == 1) goto L5;
    move(entity: 5, to: (-566, -350), sprint: 1);
    delay(20);
    setPStat(PStat.LastBiyomonChaseLocation, 1);
    speak(Entity.Player, "Not again! Wait!\n");
    lookPairAt(5);
    move(entity: 5, to: (-566, -320), sprint: 1);
    waitForEntity(5);
    jumpReturn();

L5:
    if (pstat[110] != 2 || pstat[112] == 2) goto L6;
    move(entity: 5, to: (1869, -939), sprint: 1);
    delay(20);
    setPStat(PStat.LastBiyomonChaseLocation, 2);
    speak(Entity.Player, "Not again! Wait!\n");
    lookPairAt(5);
    move(entity: 5, to: (1869, -939), sprint: 1);
    waitForEntity(5);
    jumpReturn();

L6:
    if (pstat[110] != 3 || pstat[112] == 3) goto L7;
    move(entity: 5, to: (1664, 3155), sprint: 1);
    delay(20);
    setPStat(PStat.LastBiyomonChaseLocation, 3);
    speak(Entity.Player, "Not again! Wait!\n");
    lookPairAt(5);
    move(entity: 5, to: (1664, 3125), sprint: 1);
    waitForEntity(5);
    jumpReturn();

L7:
  }

L8:
  loop {
    roll(pstat: 110, max: 3);
    if (pstat[110] != 0 || pstat[112] == 0) goto L9;
    move(entity: 5, to: (-1025, 2740), sprint: 1);
    delay(20);
    setPStat(PStat.LastBiyomonChaseLocation, 0);
    lookPairAt(5);
    move(entity: 5, to: (-1025, 2740), sprint: 1);
    waitForEntity(5);
    jumpReturn();

L9:
    if (pstat[110] != 1 || pstat[112] == 1) goto L10;
    move(entity: 5, to: (-566, -320), sprint: 1);
    delay(20);
    setPStat(PStat.LastBiyomonChaseLocation, 1);
    lookPairAt(5);
    move(entity: 5, to: (-566, -320), sprint: 1);
    waitForEntity(5);
    jumpReturn();

L10:
    if (pstat[110] != 2 || pstat[112] == 2) goto L11;
    move(entity: 5, to: (1869, -939), sprint: 1);
    delay(20);
    setPStat(PStat.LastBiyomonChaseLocation, 2);
    lookPairAt(5);
    move(entity: 5, to: (1869, -939), sprint: 1);
    waitForEntity(5);
    jumpReturn();

L11:
    if (pstat[110] != 3 || pstat[112] == 3) goto L12;
    move(entity: 5, to: (1664, 3125), sprint: 1);
    delay(20);
    setPStat(PStat.LastBiyomonChaseLocation, 3);
    lookPairAt(5);
    move(entity: 5, to: (1664, 3125), sprint: 1);
    waitForEntity(5);
    jumpReturn();

L12:
  }
}

section(51) {
  if (pstat[111] < 2 || pstat[112] == 0 || trigger(191) || trigger(245)) goto L1;
  setTrigger(191);
  playAnimation(Entity.Player, 16);
  speak(Entity.Player, "Maybe I'll wait.\n");
  choice { "Wait" -> L2, "Go" -> L5 }
  return;

L1:
  return;

L2:
  move(entity: Entity.Partner, to: Entity.Player, sprint: 1);
  waitForEntity(Entity.Partner);
  look(entity: Entity.Partner, at: Entity.Player);
  look(entity: Entity.Player, at: Entity.Partner);
  waitForEntity(Entity.Partner);
  waitForEntity(Entity.Player);
  playAnimation(Entity.Player, 8);
  speak(Entity.Player, "Alright, <ORANGE><DIGIMON><WHITE>,\nget rid of Biyomon!\n");
  anim(Entity.Partner, 22, wait: 20);
  move(entity: Entity.Player, to: (-1282, 3173), sprint: 1);
  move(entity: Entity.Partner, to: 5, sprint: 1);
  waitForEntity(Entity.Partner);
  look(entity: Entity.Player, at: 5);
  jumpAndLink(section_5.L8);
  if (pstat[112] != 0) goto L3;
  move(entity: Entity.Partner, to: 5, sprint: 1);
  waitForEntity(Entity.Partner);
  goto section_54.L5;
  goto L4;

L3:
  playAnimation(Entity.Player, 16);
  speak(Entity.Player, "He went to the wrong place!\n");

L4:
  moveCamera(to: Entity.Player, speed: 10);
  waitForEntity(200);
  return;

L5:
  return;
}

