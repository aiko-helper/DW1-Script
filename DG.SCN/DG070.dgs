section(54) {
  if (pstat[111] >= 2 && pstat[112] != 3 && !trigger(194) && !trigger(245)) {
    setTrigger(Trigger(194));
    playAnimation(Entity.Player, Animation(16));
    speak(Entity.Player, "Maybe I'll wait.\n");
    choice { "Wait" -> L1, "Go" -> section_51.L2 }
    return;
  }
  return;

L1:
  move(entity: Entity.Partner, to: Entity.Player, sprint: 1);
  waitForEntity(Entity.Partner);
  look(entity: Entity.Partner, at: Entity.Player);
  look(entity: Entity.Player, at: Entity.Partner);
  waitForEntity(Entity.Partner);
  waitForEntity(Entity.Player);
  setDialogOwner(Entity.Player);
  playAnimation(Entity.Player, Animation(8));
  showTextbox("Alright, <ORANGE><DIGIMON><WHITE>,\nget rid of Biyomon!\n");
  anim(Entity.Partner, Animation(22), wait: 20);
  move(entity: Entity.Player, to: (1753, 3341), sprint: 1);
  move(entity: Entity.Partner, to: Entity(5), sprint: 1);
  waitForEntity(Entity.Partner);
  look(entity: Entity.Player, at: Entity(5));
  jumpAndLink(section_5.L2);
  if (pstat[112] == 3) {
    move(entity: Entity.Partner, to: Entity(5), sprint: 1);
    waitForEntity(Entity.Partner);
    goto L2;
  } else {
    playAnimation(Entity.Player, Animation(16));
    speak(Entity.Player, "He went to the wrong place!\n");
  }
  followEntity(Entity.Player, speed: 10);
  return;

L2:
  anim(Entity.Player, Animation(11), wait: 10);
  lookPairAt(Entity(5));
  look(entity: Entity(5), at: Entity.Player);
  for x in [Entity.Player, Entity.Partner, Entity(5)] {
    waitForEntity(x);
  }
  speak(Entity.Player, "The ambush is a success!\n");
  playSound(8, 6);
  speak(Entity(5), "Help me out!\n");
  playAnimation(Entity.Player, Animation(19));
  speak(Entity.Player, "Don't panic. We're not\nthe bad guys here.\n");
  anim(Entity(5), Animation(28), wait: 20);
  speak(Entity(5), "Are you the famous\nDigimon kidnapper?\n");
  playAnimation(Entity.Player, Animation(16));
  speak(Entity.Player, "I think everyone has\nthe wrong idea.\n");
  anim(Entity(5), Animation(19), wait: 40);
  playAnimation(Entity.Player, Animation(19));
  speak(Entity.System, "<LIGHTBLUE><PLAYER><WHITE> tried\nto convince them.\n");
  playAnimation(Entity(5), Animation(0));
  speak(Entity(5), "I see. It's my mistake.\n");
  speak(Entity(5), "I'll go to the city.\n");
  goto L3;

L3:
  loop {
    move(entity: Entity(5), to: (-1232, 4250), sprint: 1);
    if (pstat[101] < 6 && pstat[112] != 0) {
      addPStat(PStat.LoopIterator, 1);
      delay(10);
      lookPairAt(Entity(5));
      continue;
    }
    if (pstat[101] >= 4 || pstat[112] != 0) break;
    addPStat(PStat.LoopIterator, 1);
    delay(5);
    lookPairAt(Entity(5));
  }
  waitForEntity(Entity(5));
  unloadEntity(Entity(5));
  setPStat(PStat.LoopIterator, 0);
  playSound(8, 5);
  speak(Entity.System, "Biyomon joins the city!\n");
  setTrigger(Trigger(245));
  addPStat(PStat(1), 1);
  followEntity(Entity.Player, speed: 10);
  return;
}

