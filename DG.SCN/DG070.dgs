// DG070.SCN
#include "functions.dgs"
#pragma script index=70 start=0x32000 end=0x33000 headerU16=0x44 sentinelOff=0x24
#include "entities.dgs"

section onEnter(254) {
  spawnItemChance(max: 99, chance: 15, item: Item.Digimushroom, x: 38, y: 72);
  spawnItemChance(max: 99, chance: 7, item: Item.Digimushroom, x: 46, y: 81);
  spawnItemChance(max: 99, chance: 18, item: Item.Digimushroom, x: 60, y: 83);
  spawnItemChance(max: 99, chance: 14, item: Item.Digimushroom, x: 69, y: 71);
  return;
}

section(5) {
  if (pstat[111] >= 1) {
    speak(Entity(5), "I'm here again.\n");
    jumpAndLink(L1);
    playSound(8, 6);
    speak(Entity(5), "Bye!\n");
    lookPairAt(Entity(5));
    waitForPair();
    playAnimation(Entity.Player, Animation(16));
    speak(Entity.Player, "If we go on like this, we'll\njust repeat ourselves.\n");
    speak(Entity.Player, "Maybe I should wait here.\n");
    setPStat(PStat(111), 2);
    for id in Trigger(191)..Trigger(194) {
      setTrigger(id);
    }
    return;
  }
  if (pstat[111] == 0) {
    speak(Entity(5), "Who is it?\n");
    speak(Entity(5), "No way.\n");
    move(entity: Entity(5), to: (-240, -1076), sprint: 1);
    delay(20);
    playSound(8, 6);
    speak(Entity(5), "Ahhh!\n");
    lookPairAt(Entity(5));
    waitForPair();
    playAnimation(Entity.Player, Animation(14));
    speak(Entity.Player, "Wait up!\n");
    move(entity: Entity(5), to: (-240, -1076), sprint: 1);
    waitForEntity(Entity(5));
    addPStat(PStat(111), 1);
    setPStat(PStat.LastBiyomonChaseLocation, 1);
    return;
  }
  return;

L1:
  loop {
    roll(pstat: PStat.RollScratch, max: 3);
    if (pstat[110] == 0 && pstat[112] != 0) {
      move(entity: Entity(5), to: (-1055, 2740), sprint: 1);
      delay(20);
      setPStat(PStat.LastBiyomonChaseLocation, 0);
      speak(Entity.Player, "Not again! Wait!\n");
      lookPairAt(Entity(5));
      move(entity: Entity(5), to: (-1025, 2740), sprint: 1);
      waitForEntity(Entity(5));
      jumpReturn();
    }
    if (pstat[110] == 1 && pstat[112] != 1) {
      move(entity: Entity(5), to: (-566, -350), sprint: 1);
      delay(20);
      setPStat(PStat.LastBiyomonChaseLocation, 1);
      speak(Entity.Player, "Not again! Wait!\n");
      lookPairAt(Entity(5));
      move(entity: Entity(5), to: (-566, -320), sprint: 1);
      waitForEntity(Entity(5));
      jumpReturn();
    }
    if (pstat[110] == 2 && pstat[112] != 2) {
      move(entity: Entity(5), to: (1869, -939), sprint: 1);
      delay(20);
      setPStat(PStat.LastBiyomonChaseLocation, 2);
      speak(Entity.Player, "Not again! Wait!\n");
      lookPairAt(Entity(5));
      move(entity: Entity(5), to: (1869, -939), sprint: 1);
      waitForEntity(Entity(5));
      jumpReturn();
    }
    if (pstat[110] == 3 && pstat[112] != 3) {
      move(entity: Entity(5), to: (1664, 3155), sprint: 1);
      delay(20);
      setPStat(PStat.LastBiyomonChaseLocation, 3);
      speak(Entity.Player, "Not again! Wait!\n");
      lookPairAt(Entity(5));
      move(entity: Entity(5), to: (1664, 3125), sprint: 1);
      waitForEntity(Entity(5));
      jumpReturn();
    }
  }

L2:
  loop {
    roll(pstat: PStat.RollScratch, max: 3);
    if (pstat[110] == 0 && pstat[112] != 0) {
      move(entity: Entity(5), to: (-1025, 2740), sprint: 1);
      delay(20);
      setPStat(PStat.LastBiyomonChaseLocation, 0);
      lookPairAt(Entity(5));
      move(entity: Entity(5), to: (-1025, 2740), sprint: 1);
      waitForEntity(Entity(5));
      jumpReturn();
    }
    if (pstat[110] == 1 && pstat[112] != 1) {
      move(entity: Entity(5), to: (-566, -320), sprint: 1);
      delay(20);
      setPStat(PStat.LastBiyomonChaseLocation, 1);
      lookPairAt(Entity(5));
      move(entity: Entity(5), to: (-566, -320), sprint: 1);
      waitForEntity(Entity(5));
      jumpReturn();
    }
    if (pstat[110] == 2 && pstat[112] != 2) {
      move(entity: Entity(5), to: (1869, -939), sprint: 1);
      delay(20);
      setPStat(PStat.LastBiyomonChaseLocation, 2);
      lookPairAt(Entity(5));
      move(entity: Entity(5), to: (1869, -939), sprint: 1);
      waitForEntity(Entity(5));
      jumpReturn();
    }
    if (pstat[110] == 3 && pstat[112] != 3) {
      move(entity: Entity(5), to: (1664, 3125), sprint: 1);
      delay(20);
      setPStat(PStat.LastBiyomonChaseLocation, 3);
      lookPairAt(Entity(5));
      move(entity: Entity(5), to: (1664, 3125), sprint: 1);
      waitForEntity(Entity(5));
      jumpReturn();
    }
  }
}

section(51) {
  if (pstat[111] >= 2 && pstat[112] != 0 && !trigger(191) && !trigger(245)) {
    setTrigger(Trigger(191));
    playAnimation(Entity.Player, Animation(16));
    speak(Entity.Player, "Maybe I'll wait.\n");
    choice { "Wait" -> L1, "Go" -> L2 }
    return;
  }
  return;

L1:
  move(entity: Entity.Partner, to: Entity.Player, sprint: 1);
  waitForEntity(Entity.Partner);
  look(entity: Entity.Partner, at: Entity.Player);
  look(entity: Entity.Player, at: Entity.Partner);
  waitForEntity(Entity.Partner);
  waitForEntity(Entity.Player);
  playAnimation(Entity.Player, Animation(8));
  speak(Entity.Player, "Alright, <ORANGE><DIGIMON><WHITE>,\nget rid of Biyomon!\n");
  anim(Entity.Partner, Animation(22), wait: 20);
  move(entity: Entity.Player, to: (-1282, 3173), sprint: 1);
  move(entity: Entity.Partner, to: Entity(5), sprint: 1);
  waitForEntity(Entity.Partner);
  look(entity: Entity.Player, at: Entity(5));
  jumpAndLink(section_5.L2);
  if (pstat[112] == 0) {
    move(entity: Entity.Partner, to: Entity(5), sprint: 1);
    waitForEntity(Entity.Partner);
    goto section_54.L2;
  } else {
    playAnimation(Entity.Player, Animation(16));
    speak(Entity.Player, "He went to the wrong place!\n");
  }
  followEntity(Entity.Player, speed: 10);
  return;

L2:
  return;
}

