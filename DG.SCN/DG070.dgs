section(54) {
  if (pstat[111] < 2 || pstat[112] == 3 || trigger(194) || trigger(245)) goto L1;
  setTrigger(194);
  playAnimation(Entity.Player, 16);
  speak(Entity.Player, "Maybe I'll wait.\n");
  choice { "Wait" -> L2, "Go" -> section_51.L5 }
  return;

L1:
  return;

L2:
  move(entity: Entity.Partner, to: Entity.Player, sprint: 1);
  waitForEntity(Entity.Partner);
  look(entity: Entity.Partner, at: Entity.Player);
  look(entity: Entity.Player, at: Entity.Partner);
  waitForEntity(Entity.Partner);
  waitForEntity(Entity.Player);
  setDialogOwner(Entity.Player);
  playAnimation(Entity.Player, 8);
  showTextbox("Alright, <ORANGE><DIGIMON><WHITE>,\nget rid of Biyomon!\n");
  anim(Entity.Partner, 22, wait: 20);
  move(entity: Entity.Player, to: (1753, 3341), sprint: 1);
  move(entity: Entity.Partner, to: 5, sprint: 1);
  waitForEntity(Entity.Partner);
  look(entity: Entity.Player, at: 5);
  jumpAndLink(section_5.L8);
  if (pstat[112] != 3) goto L3;
  move(entity: Entity.Partner, to: 5, sprint: 1);
  waitForEntity(Entity.Partner);
  goto L5;
  goto L4;

L3:
  playAnimation(Entity.Player, 16);
  speak(Entity.Player, "He went to the wrong place!\n");

L4:
  moveCamera(to: Entity.Player, speed: 10);
  waitForEntity(200);
  return;

L5:
  anim(Entity.Player, 11, wait: 10);
  lookPairAt(5);
  look(entity: 5, at: Entity.Player);
  for x in [Entity.Player, Entity.Partner, 5] {
    waitForEntity(x);
  }
  speak(Entity.Player, "The ambush is a success!\n");
  playSound(8, 6);
  speak(5, "Help me out!\n");
  playAnimation(Entity.Player, 19);
  speak(Entity.Player, "Don't panic. We're not\nthe bad guys here.\n");
  anim(5, 28, wait: 20);
  speak(5, "Are you the famous\nDigimon kidnapper?\n");
  playAnimation(Entity.Player, 16);
  speak(Entity.Player, "I think everyone has\nthe wrong idea.\n");
  anim(5, 19, wait: 40);
  playAnimation(Entity.Player, 19);
  speak(Entity.System, "<LIGHTBLUE><PLAYER><WHITE> tried\nto convince them.\n");
  playAnimation(5, 0);
  speak(5, "I see. It's my mistake.\n");
  speak(5, "I'll go to the city.\n");
  goto L6;

L6:
  loop {
    move(entity: 5, to: (-1232, 4250), sprint: 1);
    if (pstat[101] >= 6 || pstat[112] == 0) goto L7;
    addPStat(PStat.LoopIterator, 1);
    delay(10);
    lookPairAt(5);
    continue;

L7:
    if (pstat[101] >= 4 || pstat[112] != 0) break;
    addPStat(PStat.LoopIterator, 1);
    delay(5);
    lookPairAt(5);
  }
  waitForEntity(5);
  unloadEntity(5);
  setPStat(PStat.LoopIterator, 0);
  playSound(8, 5);
  speak(Entity.System, "Biyomon joins the city!\n");
  setTrigger(245);
  addPStat(1, 1);
  moveCamera(to: Entity.Player, speed: 10);
  waitForEntity(200);
  return;
}

