// DG070.SCN
#include "functions.dgs"
#pragma script index=70 start=0x30000 end=0x30800 headerU16=0x18 sentinelOff=0x24
#include "entities.dgs"

section onEnter(254) {
  spawnItemChance(max: 99, chance: 5, item: Item.Digimushroom, x: 39, y: 59);
  spawnItemChance(max: 99, chance: 14, item: Item.Digimushroom, x: 62, y: 89);
  spawnItemChance(max: 99, chance: 11, item: Item.Digimushroom, x: 40, y: 24);
  spawnItemChance(max: 99, chance: 6, item: Item.Digimushroom, x: 61, y: 35);
  unsetTrigger(Trigger(338));
  return;
}

section(51) {
  if (trigger(196) || trigger(338)) {
    return;
  }
  rotate(entity: Entity.Player, to: 2048);
  rotate(entity: Entity.Partner, to: 2048);
  delay(5);
  setTrigger(Trigger(196));
  setDigimon(Digimon.NPCPatamon, Entity(0), 0);
  setDigimon(Digimon.NPCGobiromon, Entity(1), 0);
  panTo(x: -205, y: 1478, slowdown: 15);
  move(entity: Entity(5), to: (-254, 439), sprint: 1);
  move(entity: Entity(6), to: (-254, 1039), sprint: 1);
  delay(45);
  rotate(entity: Entity(5), to: 0);
  rotate(entity: Entity(6), to: 0);
  followEntity(Entity(5), speed: 25);
  speak(Entity.Player, "「あれ?なんだ?」<NEWLINE>");
  waitForEntity(Entity(5));
  look(entity: Entity(5), at: Entity.Player);
  delay(5);
  speak(Entity(5), "「た・た・たすけて~~」<NEWLINE>");
  anim(Entity.Player, Animation(7), wait: 15);
  speak(Entity.Player, "「やべ、助けなきゃ!」<NEWLINE>");
  playAnimation(Entity.Player, Animation(0));
  move(entity: Entity.Player, to: (-150, -550), sprint: 1);
  move(entity: Entity.Partner, to: (-80, -300), sprint: 1);
  speak(Entity.System, "<YELLOW>???<WHITE><NEWLINE>「弱いものいじめはそこまでだ!」<NEWLINE>");
  setPStat(PStat(245), 3);
  setBGM(11);
  setDigimon(Digimon.NPCLeomon, Entity(2), 0);
  panTo(x: -677, y: 509, slowdown: 20);
  look(entity: Entity(7), at: Entity(6));
  look(entity: Entity.Player, at: Entity(7));
  delay(10);
  speak(Entity.Player, "「(えっ、誰だ?)」<NEWLINE>");
  look(entity: Entity(5), at: Entity(7));
  look(entity: Entity(6), at: Entity(7));
  delay(10);
  look(entity: Entity(7), at: Entity(6));
  move(entity: Entity(6), to: (-254, 1039), sprint: 1);
  delay(5);
  move(entity: Entity(7), axis: 1, to: 0, speed: 1);
  delay(2);
  anim(Entity(7), Animation(28), wait: 20);
  playAnimation(Entity(7), Animation(0));
  playSound(8, 1);
  look(entity: Entity.Player, at: Entity(7));
  look(entity: Entity(5), at: Entity(7));
  look(entity: Entity(6), at: Entity(7));
  for x in [Entity.Player, Entity(5), Entity(6)] {
    waitForEntity(x);
  }
  anim(Entity(6), Animation(40), wait: 20);
  move(entity: Entity(6), to: (0, 4000), sprint: 1);
  waitForEntity(Entity(6));
  unloadEntity(Entity(6));
  look(entity: Entity(5), at: Entity(7));
  delay(5);
  look(entity: Entity(7), at: Entity(5));
  delay(5);
  speak(Entity(7), "「きみ、大丈夫かっ!」<NEWLINE>");
  speak(Entity(5), "「ひょえ~~。あ、ありがと。」<NEWLINE>");
  speak(Entity(7), "「礼にはおよばない。困った時はいつでも<NEWLINE> 呼んでくれたまえ。この私、レオモンが<NEWLINE> すぐにかけつける!」<NEWLINE>");
  showTextbox("「ではまた会おう!」<NEWLINE>");
  move(entity: Entity(7), to: (-2323, 1264), sprint: 1);
  delay(20);
  speak(Entity(5), "「あ、待ってよ~~。」<NEWLINE>");
  move(entity: Entity(5), to: (-2323, 1264), sprint: 1);
  delay(40);
  waitForEntity(Entity(5));
  waitForEntity(Entity(7));
  unloadEntity(Entity(7));
  unloadEntity(Entity(5));
  followEntity(Entity.Player, speed: 10);
  speak(Entity.Player, "「……すごい……ヒーローみたいだ。<NEWLINE> なんかおいしい所持っていかれたな。」<NEWLINE>");
  playAnimation(Entity.Player, Animation(0));
  setTrigger(Trigger(196));
  return;
}

section(52) {
  setTrigger(Trigger(338));
  return;
}

section(8) {
  speak(Entity(8), "「ココぜんぶオレのウチ、オマエでてけ!」<NEWLINE>");
  finishEncounter(Trigger(297));
}

section(9) {
  speak(Entity(9), "「オレ、シャーマモン…オマエなに…?」<NEWLINE>");
  finishEncounter(Trigger(297));
  garbage { 18 00 fe 00 18 00 33 00 76 00 34 00 8e 03 08 00 94 03 09 00 d2 03 ff ff 24 00 6e 63 19 00 0b 00 6e 05 18 00 2e 00 19 00 74 2c 27 00 3b 00 24 00 6e 63 19 00 0b 00 6e 0e 18 00 44 00 19 00 74 2c 3e 00 59 00 24 00 6e 63 19 00 0b 00 6e 0b 18 00 5a 00 19 00 74 2c 28 00 18 00 24 00 6e 63 19 00 0b 00 6e 06 18 00 70 00 19 00 74 2c 3d 00 23 00 1d 00 52 01 fe 00 19 00 00 00 c4 00 40 00 52 01 18 00 88 00 19 00 fe 00 4d fd 00 08 4d fc 00 08 67 00 05 00 1c 00 c4 00 47 97 00 00 47 7d 01 00 4f 0f 33 ff c6 05 4a c8 4e 05 02 ff b7 01 01 00 4e 06 02 ff 0f 04 01 00 67 00 2d 00 4d 05 00 00 4d 06 00 00 50 00 05 19 4a c8 1b fd 1a 00 81 75 82 a0 82 ea 81 48 82 c8 82 f1 82 be 81 48 81 76 0d 00 00 00 4a 05 4c 00 05 fd 67 00 05 00 1b 05 1a 00 81 75 82 bd 81 45 82 bd 81 45 82 bd 82 b7 82 af 82 c4 81 60 81 60 81 76 0d 00 00 00 56 00 fd 07 67 00 0f 00 1b fd 1a 00 81 75 82 e2 82 d7 81 41 8f 95 82 af 82 c8 82 ab 82 e1 81 49 81 76 0d 00 00 00 56 00 fd 00 4e fd 6a ff da fd 01 00 4e fc b0 ff d4 fe 01 00 1b ff 1a 00 01 07 81 48 81 48 81 48 01 01 0d 00 81 75 8e e3 82 a2 82 e0 82 cc 82 a2 82 b6 82 df 82 cd 82 bb 82 b1 82 dc 82 c5 82 be 81 49 81 76 0d 00 00 00 1e 00 f5 03 5d 0b 47 a6 02 00 4f 14 5b fd fd 01 4a c8 4c 00 07 06 4c 00 fd 07 67 00 0a 00 1b fd 1a 00 81 75 81 69 82 a6 82 c1 81 41 92 4e 82 be 81 48 81 6a 81 76 0d 00 00 00 4c 00 05 07 4c 00 06 07 67 00 0a 00 4c 00 07 06 4e 06 02 ff 0f 04 01 00 67 00 05 00 72 07 00 00 01 01 67 00 02 00 56 00 07 1c 67 00 14 00 56 00 07 00 5a 00 08 01 4c 00 fd 07 4c 00 05 07 4c 00 06 07 4a fd 4a 05 4a 06 56 00 06 28 67 00 14 00 4e 06 00 00 a0 0f 01 00 4a 06 48 06 4c 00 05 07 67 00 05 00 4c 00 07 05 67 00 05 00 1b 07 1a 00 81 75 82 ab 82 dd 81 41 91 e5 8f e4 95 76 82 a9 82 c1 81 49 81 76 0d 00 00 00 1b 05 1a 00 81 75 82 d0 82 e5 82 a6 81 60 81 60 81 42 82 a0 81 41 82 a0 82 e8 82 aa 82 c6 81 42 81 76 0d 00 00 00 1b 07 1a 00 81 75 97 e7 82 c9 82 cd 82 a8 82 e6 82 ce 82 c8 82 a2 81 42 8d a2 82 c1 82 bd 8e 9e 82 cd 82 a2 82 c2 82 c5 82 e0 0d 00 81 40 8c c4 82