// DG056.SCN
#include "functions.dgs"
#pragma script index=56 start=0x2a800 end=0x2b000 headerU16=0x18 sentinelOff=0xfe

section onEnter(254) {
    return;
}

section(81) {
    if (item[Item.MansionKey] < 1 || trigger(115)) goto L1;
    rotate(entity: Entity.Player, to: 3138);
    playSound(8, 3);
    speak(Entity.System, "I used the\n<LIGHTBLUE>Mansion Key<WHITE>!\n");
    setTrigger(115);
    goto L2;

L1:
    if (item[Item.MansionKey] >= 1 || trigger(115)) goto L2;
    rotate(entity: Entity.Player, to: 3138);
    playSound(8, 2);
    delay(5);
    playSound(8, 2);
    speak(Entity.System, "It doesn't open.\nIt's locked.\n");
    return;

L2:
    rotate3DObject(3, 1);
    playSound(8, 1);
    delay(10);
    move(entity: Entity.Player, to: (700, 50), sprint: 0);
    warp(to: Map.YAKA16, spawn: 0, trigger: 255);
    return;
}

section(82) {
    rotate3DObject(1, 1);
    playSound(8, 1);
    delay(10);
    move(entity: Entity.Player, to: (-1400, -600), sprint: 0);
    warp(to: Map.YAKA14, spawn: 0, trigger: 255);
    return;
}

section(83) {
    rotate3DObject(2, 1);
    playSound(8, 1);
    delay(10);
    move(entity: Entity.Player, to: (-276, -2000), sprint: 0);
    warp(to: Map.YAKA11A, spawn: 3, trigger: 255);
    return;
}

section(53) {
    playAnimation(Entity.Player, 18);
    playAnimation(Entity.Partner, 43);
    setPStat(200, 30);
    dealMapDamage(200);
    delay(20);
    playAnimation(Entity.Partner, 44);
    delay(20);
    speak(Entity.Player, "I'm wounded!\n");
    setPStat(254, 253);
    callSubroutine(55);
    return;
