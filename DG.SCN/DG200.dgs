// DG200.SCN
#include "functions.dgs"
#pragma script index=200 start=0x95000 end=0x95800 headerU16=0x10 sentinelOff=0x1775
#include "entities.dgs"

section onEnter(254) {
  spawnChest(Item.OffenseChip, 2483, 247, 1024, 658);
  spawnChest(Item.SpeedChip, 2544, -110, 1024, 659);
  return;
}

section(5) {
  speak(Entity(5), "「まだ熱いって?<NEWLINE> そうだね、熱いのが苦手な<NEWLINE> デジモンなら病気しちゃうかもね。」<NEWLINE>");
  return;
}

section(6) {
