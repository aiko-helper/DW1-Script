section(52) {
    move(entity: Entity.Player, to: (-3000, -2588), sprint: 0);
    warp(to: Map.TRAI00, spawn: 1, trigger: 255);
    return;
}

section(5) {
    setStats(tournamentsWon: 99, tournamentWins: 99, tournamentsLost: 99);
    speak(5, "<WHITE>White White White\n<BLUE>Blue Blue Blue\n<RED>Red Red Red\n<PINK>Pink <GREEN>Green\n<LIGHTBLUE>LightBlue LightBlue\n<YELLOW>Yellow <ORANGE>Orange\n<ORANGE>a <LIGHTBLUE>b <PINK>c <GREEN>d\n");
    pstat[:SavedTime] = time();
    speak(5, "Right now, <HOUR>: <MINUTE>on\nthe <DAY>th day of\nthe <YEAR>th month.\n");
    speak(5, "I'm Mr. Warp.\nWhere do you want to go?\n");
    setDialogOwner(Entity.Player);
    choice { "Near" -> L1, "Far away" -> L2, "Very far away" -> L3 }
    return;

L1:
    setDialogOwner(Entity.Player);
    choice { "The peak of Mt. Panorama" -> L4, "Tropical Jungle" -> L5, "Drill Tunnel" -> L6 }
    return;

L2:
    setDialogOwner(Entity.Player);
    choice { "Gear Savanna" -> L7, "Gray Lord's mansion" -> L8, "Great Canyon" -> L9 }
    return;

L3:
    setDialogOwner(Entity.Player);
    choice { "Anc. Dino Region: gate" -> L10, "Anc. Dino Region: back" -> L11, "Unknown World" -> L12 }
    return;

L4:
    warp(to: Map.MIHA00, spawn: 0, trigger: 255);

L5:
    warp(to: Map.TROP01, spawn: 0, trigger: 255);

L6:
    warp(to: Map.TUNN01, spawn: 0, trigger: 255);

L7:
    warp(to: Map.GIAS00, spawn: 0, trigger: 255);

L8:
