section(6) {
    setStats(lives: 3);
    speak(5, "Life three\n");
    speak(6, "I'm Mr. Digivolution.\nWhat do you want to be?\n");
    setDialogOwner(Entity.Player);
    choice { "Numemon" -> L1, "Sukamon" -> L2, "Botamon" -> L3 }
    return;

L1:
    setPStat(254, 11);
    callDigimonSubroutine(10);
    waitForEntity(Entity.System);
    return;

L2:
    setPStat(254, 39);
    callDigimonSubroutine(10);
    waitForEntity(Entity.System);
    return;

L3:
    setPStat(254, 1);
    callDigimonSubroutine(10);
    waitForEntity(Entity.System);
    return;
}

