section(66) {
    if (!trigger(75) && !trigger(54)) goto L1;
    return;

L1:
    setTrigger(75);
    goto section_8.L2;
    setDialogOwner(Entity.Player);
    choice { "Debug high" -> L2, "Debug initial" -> L3, "To Opening" -> section_8.L2 }
    return;

L2:
    setStats(offense: 999, defense: 999, speed: 999, brains: 999, maxHP: 9999, maxMP: 9999, currentHP: 9999, currentMP: 9999);
    learnMoves([
        :FireTower, :ProminenceBeam, :SpitFire, :RedInferno,
        :MagmaBomb, :HeatLaser, :InifinityBurn, :Meltdown,
        :ThunderJustice, :SpinningShot, :ElectricCloud, :MegaloSpark,
        :StaticElect, :WindCutter, :ConfusedStorm, :Hurricane,
        :GigaFreeze, :IceStatue, :WinterBlast, :IceNeedle,
        :WaterBlit, :AquaMagic, :AuroraFreeze, :TearDrop,
        :PowerCrane, :AllRangeBeam, :MetalSprinter, :PulseLaser,
        :DeleteProgram, :DGDimension, :FullPotential, :ReverseProg,
        :PoisonPowder, :MassMorph, :InsectPlague, :CharmPerfume,
        :PoisonClaw, :DangerSting, :GreenTrap, :MuscleCharge,
        :SonicJab, :DynamiteKick, :MegatonPunch, :BusterDive,
        :OdorSpray, :PoopSpdToss, :BigPoopToss, :BigRndToss,
        :PoopRndToss, :RndSpdToss, :HorizontalKick, :UltPoopHell,
        :BlazeBlast, :PepperBreath, :LovelyAttack, :Fireball,
        :DeathClaw, :MegaFlame
    ]);
    return;

L3:
    setStats(offense: 80, defense: 60, speed: 70, brains: 70, maxHP: 800, maxMP: 600, currentHP: 800, currentMP: 600);
    return;
}

section(8) {
    setDialogOwner(8);
    choice { "Half dead" -> L1, "Opening mode" -> L2, "Fast forward time" -> L3 }
    return;

L1:
    setStats(currentHP: 1, lifetime: 1);
    return;

L2:
    setTrigger(54);
    setTrigger(55);
    warp(to: Map.TOPN01, spawn: 9, trigger: 255);
    return;

L3:
    setDialogOwner(Entity.Player);
    choice { "Forward one hour" -> L4, "Forward six hours" -> L5, "Forward ten days" -> L6 }
    return;

L4:
    pstat[:SavedTime] = time();
    addMinutesToDate(PStat.SavedTime, 60);
    advanceToDate(PStat.SavedTime);
    return;

L5:
    pstat[:SavedTime] = time();
    addMinutesToDate(PStat.SavedTime, 360);
    advanceToDate(PStat.SavedTime);
    return;

L6:
    pstat[:SavedTime] = time();
    addMinutesToDate(PStat.SavedTime, 14400);
    advanceToDate(PStat.SavedTime);
    return;
}

section(11) {
    if (trigger(74)) goto L1;
    speak(11, "Would you like some Meat?\n");
    showTextbox("Oh, I'm sorry.\nI forgot to explain.\n");
    showTextbox("This is a Meat Farm.\nWe grow Meat for everyone.\n");
    speak(Entity.Player, "You grow Meat on a farm?\n");
    speak(11, "Yes, what's wrong?\n");
    speak(Entity.Player, "Nothing...it's alright.\nPlease continue...\n");
    speak(11, "Jiji and I decided to give\nyou three pieces of Meat\na day, <LIGHTBLUE><PLAYER><WHITE>.\n");
    showTextbox("So, here's today's Meat.\n");
    goto L2;

L1:
    goto L6;

L2:
    giveItem(Item.Meat, 3);
    if (item[Item.Meat] < 99) goto L3;
    speak(11, "You got too much Meat.\nI guess you don't\nneed any today.\n");
    setPStat(31, 1);
    return;

L3:
    if (item[Item.Meat] < 97) goto L4;
    speak(11, "You got too much Meat.\nI will take what\nyou can't carry.\n");
    speak(Entity.System, "I got three pieces of\n<LIGHTBLUE>Meat<WHITE>!\n");
    setTrigger(74);
    setPStat(31, 0);
    return;

L4:
    if (!trigger(0)) goto L5;
    speak(11, "You got too many Items.\n");
    return;

L5:
    speak(Entity.System, "I got three pieces of\n<LIGHTBLUE>Meat<WHITE>!\n");
    setTrigger(74);
    setPStat(31, 0);
    return;

L6:
    roll(pstat: 110, max: 9);
    if (pstat[31] < 1 || pstat[110] > 0) goto L7;
    speak(11, "We harvested lots of Meat!\nSo I'll give you\nfive pieces of Meat.\n");
    goto L8;

L7:
    goto L12;

L8:
    if (item[Item.Meat] < 99) goto L9;
    speak(11, "You got too much Meat.\nI guess you don't\nneed any today.\n");
    return;

L9:
    if (item[Item.Meat] < 95) goto L10;
    speak(11, "You got too much Meat.\nI'm happy to take\nwhat you can't carry\n");
    speak(Entity.System, "I got five pieces of\n<LIGHTBLUE>Meat<WHITE>!\n");
    giveItem(Item.Meat, 5);
    setTrigger(74);
    setPStat(31, 0);
    return;

L10:
    giveItem(Item.Meat, 5);
    if (!trigger(0)) goto L11;
    speak(11, "I'm sorry, but\nyou got too many Items.\n");
    return;

L11:
    speak(Entity.System, "I got five pieces of\n<LIGHTBLUE>Meat<WHITE>!\n");
    speak(11, "I'll give you more tomorrow.\n");
    setPStat(31, 0);
    return;

L12:
    if (pstat[31] < 1) goto L13;
    speak(11, "Here's today's Meat.\n");
    goto L14;

L13:
    goto L18;

L14:
    if (item[Item.Meat] < 99) goto L15;
    speak(11, "You got too much Meat.\nI guess you don't\nneed any today.\n");
    return;

L15:
    if (item[Item.Meat] < 97) goto L16;
    speak(11, "You got too much Meat.\nI'm happy to take\nwhat you can't carry.\n");
    speak(Entity.System, "I got three pieces of\n<LIGHTBLUE>Meat<WHITE>!\n");
    giveItem(Item.Meat, 3);
    setTrigger(74);
    setPStat(31, 0);
    return;

L16:
    giveItem(Item.Meat, 3);
    if (!trigger(0)) goto L17;
    speak(11, "You have too many Items.\n");
    return;

L17:
    speak(Entity.System, "I got three pieces of\n<LIGHTBLUE>Meat<WHITE>!\n");
    speak(11, "I'll give you more tomorrow.\n");
    setPStat(31, 0);
    return;

L18:
    speak(11, "What? I gave you Meat today,\nremember?\n");
    showTextbox("If you run out of food,\nlook for mushrooms\nin Native Forest.\n");
    return;
}

section(9) {
    speak(9, "OK, I'll explain to you the\nsurroundings of this city.\n");
    showTextbox("Native Forest\nsurrounds the city.\n");
    showTextbox("The Digimon around there\nare not very strong.\n");
    showTextbox("There's a Training Camp on\nthe west side. I think you\nwill go there often.\n");
    showTextbox("Tropical Jungle is on the\neast side, across the river.\n");
    showTextbox("I don't know what's past that.\n");
    showTextbox("There's a mountain and lake\non the west side\nand it's a dead end.\n");
    showTextbox("If you keep going south,\nthere's an ocean.\n");
    showTextbox("And there's a high mountain\nin the north. It's also\na dead end.\n");
    showTextbox("Since this city is the center\nof the island, there must be \nvast areas in the north.\n");
    showTextbox("I'll check out the rumors\nabout the outside area.\nCome back and find out more.\n");
    return;
}

