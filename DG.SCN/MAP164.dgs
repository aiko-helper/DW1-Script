    setDialogOwner(11);
    showTextbox("We harvested lots of Meat!\nSo I'll give you\nfive pieces of Meat.\n");
    goto L_0510;
L_050c:
    goto L_0762;
L_0510:
    if (item[Item.Meat] < 99) goto L_0598;
