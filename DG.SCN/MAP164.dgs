section section_11(11) {  // len=2742
    if (trigger(74)) goto L_0276;
    setDialogOwner(11);
    showTextbox("Would you like some Meat?\n");
    showTextbox("Oh, I'm sorry.\nI forgot to explain.\n");
    showTextbox("This is a Meat Farm.\nWe grow Meat for everyone.\n");
    setDialogOwner(Entity.Player);
    showTextbox("You grow Meat on a farm?\n");
    setDialogOwner(11);
    showTextbox("Yes, what's wrong?\n");
    setDialogOwner(Entity.Player);
    showTextbox("Nothing...it's alright.\nPlease continue...\n");
    setDialogOwner(11);
    showTextbox("Jiji and I decided to give\nyou three pieces of Meat\na day, <LIGHTBLUE><PLAYER><WHITE>.\n");
    showTextbox("So, here's today's Meat.\n");
    goto L_027a;
L_0276:
    goto L_046c;
L_027a:
    giveItem(Item.Meat, 3);
    if (item[Item.Meat] < 99) goto L_030a;
    setDialogOwner(11);
    showTextbox("You got too much Meat.\nI guess you don't\nneed any today.\n");
    setPStat(31, 1);
    return;
L_030a:
    if (item[Item.Meat] < 97) goto L_03dc;
    setDialogOwner(11);
    showTextbox("You got too much Meat.\nI will take what\nyou can't carry.\n");
    setDialogOwner(Entity.System);
    showTextbox("I got three pieces of\n<LIGHTBLUE>Meat<WHITE>!\n");
    setTrigger(74);
    setPStat(31, 0);
    return;
