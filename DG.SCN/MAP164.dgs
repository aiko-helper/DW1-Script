    setDialogOwner(11);
    showTextbox("You got too much Meat.\nI'm happy to take\nwhat you can't carry\n");
    setDialogOwner(Entity.System);
    showTextbox("I got five pieces of\n<LIGHTBLUE>Meat<WHITE>!\n");
    giveItem(Item.Meat, 5);
    setTrigger(74);
    setPStat(31, 0);
    return;
L_0676:
    giveItem(Item.Meat, 5);
    if (!trigger(0)) goto L_06dc;
