; DG070.SCN
;!script index=70 start=0x32000 end=0x33000 headerU16=0x44 sentinelOff=0x24
;!sections onEnter section_5 section_51 section_52 section_53 section_54 section_61 section_62 section_63 section_64 section_6 section_7 section_8 section_9 section_10 section_11

onEnter:     ; len=90
  0000:  storeRandom 110 99
  0004:  if pstat[110] > 15 then onEnter+0x16
  0010:  spawnItem 44 38 72
  0016:  storeRandom 110 99
  001a:  if pstat[110] > 7 then onEnter+0x2c
  0026:  spawnItem 44 46 81
  002c:  storeRandom 110 99
  0030:  if pstat[110] > 18 then onEnter+0x42
  003c:  spawnItem 44 60 83
  0042:  storeRandom 110 99
  0046:  if pstat[110] > 14 then onEnter+0x58
  0052:  spawnItem 44 69 71
  0058:  endSection
