section section_5(5) {  // len=1030
    if (pstat[111] < 1) goto L_0118;
    setDialogOwner(5);
    showTextbox("I'm here again.\n");
    jumpAndLink(L_01b6);
    playSound(8, 6);
    setDialogOwner(5);
    showTextbox("Bye!\n");
    look(entity: Entity.Player, at: 5);
    look(entity: Entity.Partner, at: 5);
    waitForEntity(Entity.Player);
    waitForEntity(Entity.Partner);
    playAnimation(Entity.Player, 16);
    setDialogOwner(Entity.Player);
    showTextbox("If we go on like this, we'll\njust repeat ourselves.\n");
    setDialogOwner(Entity.Player);
    showTextbox("Maybe I should wait here.\n");
    setPStat(111, 2);
    setTrigger(191);
    setTrigger(192);
    setTrigger(193);
    setTrigger(194);
    return;
L_0118:
    if (pstat[111] != 0) goto L_01b4;
    setDialogOwner(5);
