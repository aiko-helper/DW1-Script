// source: extract/DIGIMON/SCN/DG.SCN
// DG070.SCN, section 54

section section_54(54) {  // len=1062
    if (pstat[111] < 2 || pstat[112] == 3 || trigger(194) || trigger(245)) goto L_0066;
    setTrigger(194);
    playAnimation(Entity.Player, 16);
    setDialogOwner(Entity.Player);
    showTextbox("Maybe I'll wait.\n");
    setSelection(L_0068, section_51.L_014a);
    showTextbox("Wait\nGo\n");
    waitForSelectionChoice();
    return;
L_0066:
    return;
L_0068:
    move(entity: Entity.Partner, to: Entity.Player, sprint: 1);
    waitForEntity(Entity.Partner);
    look(entity: Entity.Partner, at: Entity.Player);
    look(entity: Entity.Player, at: Entity.Partner);
    waitForEntity(Entity.Partner);
    waitForEntity(Entity.Player);
    setDialogOwner(Entity.Player);
    playAnimation(Entity.Player, 8);
    showTextbox("Alright, <ORANGE><DIGIMON><WHITE>,\nget rid of Biyomon!\n");
    playAnimation(Entity.Partner, 22);
    delay(20);
    move(entity: Entity.Player, to: (1753, 3341), sprint: 1);
    move(entity: Entity.Partner, to: 5, sprint: 1);
    waitForEntity(Entity.Partner);
    look(entity: Entity.Player, at: 5);
    jumpAndLink(section_5.L_032e);
    if (pstat[112] != 3) goto L_0100;
    move(entity: Entity.Partner, to: 5, sprint: 1);
    waitForEntity(Entity.Partner);
    goto L_014a;
    goto L_0142;
L_0100:
    playAnimation(Entity.Player, 16);
    setDialogOwner(Entity.Player);
    showTextbox("He went to the wrong place!\n");
L_0142:
    moveCamera(to: Entity.Player, speed: 10);
    waitForEntity(200);
    return;
L_014a:
    playAnimation(Entity.Player, 11);
    delay(10);
    look(entity: Entity.Player, at: 5);
    look(entity: Entity.Partner, at: 5);
    look(entity: 5, at: Entity.Player);
    waitForEntity(Entity.Player);
    waitForEntity(Entity.Partner);
    waitForEntity(5);
    setDialogOwner(Entity.Player);
    showTextbox("The ambush is a success!\n");
    playSound(8, 6);
    setDialogOwner(5);
    showTextbox("Help me out!\n");
    playAnimation(Entity.Player, 19);
    setDialogOwner(Entity.Player);
    showTextbox("Don't panic. We're not\nthe bad guys here.\n");
    playAnimation(5, 28);
    delay(20);
    setDialogOwner(5);
    showTextbox("Are you the famous\nDigimon kidnapper?\n");
    playAnimation(Entity.Player, 16);
    setDialogOwner(Entity.Player);
    showTextbox("I think everyone has\nthe wrong idea.\n");
    playAnimation(5, 19);
    delay(40);
    playAnimation(Entity.Player, 19);
    setDialogOwner(Entity.System);
    showTextbox("<LIGHTBLUE><PLAYER><WHITE> tried\nto convince them.\n");
    playAnimation(5, 0);
    setDialogOwner(5);
    showTextbox("I see. It's my mistake.\n");
    setDialogOwner(5);
    showTextbox("I'll go to the city.\n");
    goto L_0384;
L_0384:
    move(entity: 5, to: (-1232, 4250), sprint: 1);
    if (pstat[101] >= 6 || pstat[112] == 0) goto L_03b0;
    addPStat(101, 1);
    delay(10);
    look(entity: Entity.Player, at: 5);
    look(entity: Entity.Partner, at: 5);
    goto L_0384;
L_03b0:
    if (pstat[101] >= 4 || pstat[112] != 0) goto L_03d4;
    addPStat(101, 1);
    delay(5);
    look(entity: Entity.Player, at: 5);
    look(entity: Entity.Partner, at: 5);
    goto L_0384;
L_03d4:
    waitForEntity(5);
    unloadEntity(5);
    setPStat(101, 0);
    playSound(8, 5);
    setDialogOwner(Entity.System);
    showTextbox("Biyomon joins the city!\n");
    setTrigger(245);
    addPStat(1, 1);
    moveCamera(to: Entity.Player, speed: 10);
    waitForEntity(200);
    return;
}
