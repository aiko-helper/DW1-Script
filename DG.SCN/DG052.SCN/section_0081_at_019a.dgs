// source: extract/DIGIMON/SCN/DG.SCN
// DG052.SCN, section 81

section section_81_at_019a(81, 0x019a) {  // len=220
    if (item[Item.MansionKey] < 1 || trigger(127)) goto L_005c;
    rotate(entity: Entity.Player, to: 3072);
    playSound(8, 3);
    setDialogOwner(Entity.System);
    showTextbox("I used the\n<LIGHTBLUE>Mansion Key<WHITE>!\n");
    setTrigger(127);
    goto L_00c2;
L_005c:
    if (item[Item.MansionKey] >= 1 || trigger(127)) goto L_00c2;
    rotate(entity: Entity.Player, to: 3072);
    playSound(8, 2);
    delay(5);
    playSound(8, 2);
    setDialogOwner(Entity.System);
    showTextbox("It doesn't open.\nIt's locked.\n");
    return;
L_00c2:
    rotate3DObject(0, 1);
    playSound(8, 1);
    delay(10);
    move(entity: Entity.Player, to: (2000, 550), sprint: 0);
    warp(to: Map.YAKA25_2, spawn: 0, trigger: 255);
    return;
}
