// DG140.SCN
#include "functions.dgs"
#pragma script index=140 start=0x5b800 end=0x5c000 headerU16=0x20 sentinelOff=0xfe
#include "entities.dgs"

section onEnter(254) {
  return;
}

section(51) {
  move(entity: Entity.Player, to: (1591, 607), sprint: 0);
  waitForEntity(Entity.Player);
  move(entity: Entity.Player, to: (1593, -343), sprint: 0);
  warp(to: Map.FACT03, spawn: 0, trigger: 255);
  return;
}

section(5) {
  speak(Entity(5), "「オマエ、ドコヘイクカ?」<NEWLINE>");
  finishEncounter(Trigger(292));
}

section(6) {
  speak(Entity(6), "「マテッ!」<NEWLINE>");
  finishEncounter(Trigger(292));
}

section(7) {
  speak(Entity(7), "「ぐぴぃ~っ!」<NEWLINE>");
  finishEncounter(Trigger(287));
}

section(8) {
  speak(Entity(8), "「どぃひぇふぃ。」<NEWLINE>");
  finishEncounter(Trigger(287));
}

section(9) {
  {
    speak(Entity(9), "「む、おまえは!」<NEWLINE>");
    showTextbox("「俺は99戦無敗のメタルマメモン!<NEWLINE> お前を倒して100勝目をかざらせて<NEWLINE> もらうとする!」<NEWLINE>");
    showTextbox("「まさか<LIGHTBLUE><PLAYER><WHITE>ともあろうものが<NEWLINE> 逃げ出しはするまい?」<NEWLINE>");
    setDialogOwner(Entity.Player);
    setSelection(L1, L2);
    showTextbox("「やってやる!」<NEWLINE>「ごめん。またな。」<NEWLINE>");
    waitForSelectionChoice();
    break;

L1:
    {
      setTrigger(Trigger(1));
      setPStat(PStat(250), 1);
      setPStat(PStat(251), 9);
      setPStat(PStat(252), 255);
      setPStat(PStat(253), 255);
      startBattle();
      unsetTrigger(Trigger(1));
      setPStat(PStat(250), 0);
      look(entity: Entity.Player, at: Entity(9));
      look(entity: Entity(9), at: Entity.Player);
      look(entity: Entity.Partner, at: Entity(9));
      waitForEntity(Entity.Player);
      speak(Entity(9), "「うむ…。<NEWLINE> 思っていたよりやるな!」<NEWLINE>");
      showTextbox("「決めた、お前をライバルとして<NEWLINE> 認める!」<NEWLINE>");
      showTextbox("「いつかお前を負かしてみせるぞ!」<NEWLINE>");
      break;
    }
    approach(who: Entity(9), x: -3120, y: 1836, tries: 3, wait: 20);
    playSound(8, 10);
    speak(Entity.System, "メタルマメモンが街に参加した!!!<NEWLINE>");
    unsetTrigger(Trigger(1));
    setTrigger(Trigger(227));
    addPStat(PStat(1), 3);
    followEntity(Entity.Player, speed: 10);
    return;

L2:
  }
  {
    speak(Entity(9), "「ふはは、そんなことだと思ったぜ。<NEWLINE> 俺の気が向いたらまたあおう。」<NEWLINE>");
    break;
  }
  approach(who: Entity(9), x: -3120, y: 1836, tries: 3, wait: 20);
  return;
  garbage { 20 00 fe 00 20 00 33 00 22 00 05 00 3a 00 06 00 6a 00 07 00 8c 00 08 00 b2 00 09 00 da 00 ff ff fe 00 4e fd 37 06 5f 02 00 00 4a fd 4e fd 39 06 a9 fe 00 00 4b 9a 00 ff fe 00 1b 05 1a 00 81 75 83 49 83 7d 83 47 81 41 83 68 83 52 83 77 83 43 83 4e 83 4a 81 48 81 76 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 24 01 fe 00 1b 06 1a 00 81 75 83 7d 83 65 83 62 81 49 81 76 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 24 01 fe 00 1b 07 1a 00 81 75 82 ae 82 d2 82 a1 81 60 82 c1 81 49 81 76 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 1f 01 fe 00 1b 08 1a 00 81 75 82 c7 82 a1 82 d0 82 a5 82 d3 82 a1 81 42 81 76 0d 00 00 00 27 00 67 00 01 00 66 00 1c 00 1f 01 fe 00 1b 09 1a 00 81 75 82 de 81 41 82 a8 82 dc 82 a6 82 cd 81 49 81 76 0d 00 00 00 1a 00 81 75 89 b4 82 cd 82 58 82 58 90 ed 96 b3 94 73 82 cc 83 81 83 5e 83 8b 83 7d 83 81 83 82 83 93 81 49 0d 00 81 40 82 a8 91 4f 82 f0 93 7c 82 b5 82 c4 82 50 82 4f 82 4f 8f 9f 96 da 82 f0 82 a9 82 b4 82 e7 82 b9 82 c4 0d 00 81 40 82 e0 82 e7 82 a4 82 c6 82 b7 82 e9 81 49 81 76 0d 00 00 00 1a 00 81 75 82 dc 82 b3 82 a9 01 06 05 00 01 01 82 c6 82 e0 82 a0 82 eb 82 a4 82 e0 82 cc 82 aa 0d 00 81 40 93 a6 82 b0 8f 6f 82 b5 82 cd 82 b7 82 e9 82 dc 82 a2 81 48 81 76 0d 00 00 00 1b fd 10 02 ce 01 fe 02 1a 00 81 75 82 e2 82 c1 82 c4 82 e2 82 e9 81 49 81 76 0d 00 81 75 82 b2 82 df 82 f1 81 42 82 dc 82 bd 82 c8 81 42 81 76 0d 00 00 00 12 00 16 00 fe 02 1c 00 01 00 1e 00 fa 01 1e 00 fb 09 1e 00 fc ff 1e 00 fd ff 27 00 67 00 01 00 66 00 1d 00 01 00 1e 00 fa 00 4c 00 fd 09 4c 00 09 fd 4c 00 fc 09 4a fd 1b 09 1a 00 81 75 82 a4 82 de 81 63 81 42 0d 00 81 40 8e 76 82 c1 82 c4 82 a2 82 bd 82 e6 82 e8 82 e2 82 e9 82 c8 81 49 81 76 0d 00 00 00 1a 00 81 75 8c 88 82 df 82 bd 81 41 82 a8 91 4f 82 f0 83 89 83 43 83 6f 83 8b 82 c6 82 b5 82 c4 0d 00 81 40 94 46 82 df 82 e9 81 49 81 76 0d 00 00 00 1a 00 81 75 82 a2 82 c2 82 a9 82 a8 91 4f 82 f0 95 89 82 a9 82 b5 82 c4 82 dd 82 b9 82 e9 82 bc 81 49 81 76 0d 00 00 00 16 00 8c 02 4e 09 d0 f3 2c 07 01 00 19 00 0d