;!script index=19 start=0x14000 end=0x14800 headerU16=0x2c sentinelOff=0x24
;!sections onEnter section_5 section_6 section_7 section_8 section_9 section_10 section_11 section_12 section_51

onEnter:     ; len=76
  0000:  storeRandom 110 99
  0004:  if pstat[110] > 14 then onEnter+0x16
  0010:  spawnItem 44 37 19
  0016:  storeRandom 110 99
  001a:  if pstat[110] > 9 then onEnter+0x2c
  0026:  spawnItem 44 60 72
  002c:  storeRandom 110 99
  0030:  if pstat[110] > 3 then onEnter+0x42
  003c:  spawnItem 51 57 54
  0042:  setTrigger 106
  0046:  setTrigger 105
  004a:  endSection
