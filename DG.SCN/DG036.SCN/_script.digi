; DG036.SCN
;!script index=36 start=0x1e800 end=0x1f000 headerU16=0x24 sentinelOff=0x24
;!sections onEnter section_5 section_6 section_7 section_8 section_51 section_52 section_53

onEnter:     ; len=90
  0000:  storeRandom 110 99
  0004:  if pstat[110] > 9 then onEnter+0x16
  0010:  spawnItem 44 36 68
  0016:  storeRandom 110 99
  001a:  if pstat[110] > 5 then onEnter+0x2c
  0026:  spawnItem 44 83 78
  002c:  storeRandom 110 99
  0030:  if pstat[110] > 14 then onEnter+0x42
  003c:  spawnItem 44 25 17
  0042:  storeRandom 110 99
  0046:  if pstat[110] > 2 then onEnter+0x58
  0052:  spawnItem 69 78 60
  0058:  endSection
