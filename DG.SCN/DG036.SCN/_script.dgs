// DG036.SCN
#pragma script index=36 start=0x1e800 end=0x1f000 headerU16=0x24 sentinelOff=0x24
#pragma sections section_0254 section_0005 section_0006 section_0007 section_0008 section_0051 section_0052 section_0053

section onEnter(254) {  // len=90
    roll(pstat: 110, max: 99);
    if (pstat[110] > 9) goto L_0016;
    spawnItem(Item.Digimushroom, 36, 68);
L_0016:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 5) goto L_002c;
    spawnItem(Item.Digimushroom, 83, 78);
L_002c:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 14) goto L_0042;
    spawnItem(Item.Digimushroom, 25, 17);
L_0042:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 2) goto L_0058;
    spawnItem(Item.Happymushroom, 78, 60);
L_0058:
    return;
}
