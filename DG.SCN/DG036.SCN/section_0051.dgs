section section_51(51) {  // len=86
    if (trigger(124)) goto L_0052;
    playAnimation(Entity.Player, 15);
    delay(15);
    setDialogOwner(Entity.Player);
    showTextbox("Oh no, it's dangerous!\n");
    move(entity: Entity.Player, to: (73, 971), sprint: 1, withCamera: true);
    waitForEntity(Entity.Player);
L_0052:
    goto section_53.L_0058;
}
