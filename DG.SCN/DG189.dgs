// DG189.SCN
#include "functions.dgs"
#pragma script index=189 start=0x90800 end=0x91000 headerU16=0xc sentinelOff=0x24
#include "entities.dgs"

section onEnter(254) {
  roll(pstat: 110, max: 99);
  if (pstat[110] > 14) goto L1;
  spawnItem(Item.Digimushroom, x: 53, y: 64);

L1:
  roll(pstat: 110, max: 99);
  if (pstat[110] > 14) goto L2;
  spawnItem(Item.Digimushroom, x: 56, y: 61);

L2:
  roll(pstat: 110, max: 99);
  if (pstat[110] > 14) goto L3;
  spawnItem(Item.Digimushroom, x: 60, y: 59);

L3:
  roll(pstat: 110, max: 99);
  if (pstat[110] > 14) goto L4;
  spawnItem(Item.Digimushroom, x: 63, y: 55);

L4:
  roll(pstat: 110, max: 99);
  if (pstat[110] > 5) goto L5;
  spawnItem(Item.Happymushroom, x: 56, y: 65);

L5:
  if (trigger(233) || !trigger(53)) goto L6;
  playAnimation(5, 28);

L6:
  return;
}

section(5) {
  setTrigger(44);
  if (!trigger(229)) goto L1;
  playSound(8, 9);
  speak(5, "Did you bring something\nto treat the wound?\n");
  speak(Entity.Player, "Wait a second. Let me see...\n");
  goto L2;

L1:
  playSound(8, 9);
  speak(5, "My wing hurts!\n");
  speak(Entity.Player, "What happened?\n");
  speak(5, "I hurt my wing. Do you got\nsomething to treat my wound?\n");
  speak(Entity.Player, "It looks bad. Hold on.\nWhat should I do?\n");

L2:
  playAnimation(Entity.Player, 4);
  delay(10);
  setTrigger(3);
  callSubroutine(0);
  if (!trigger(3)) goto L3;
  speak(Entity.Player, "I got nothing right now.\n");
  goto L8;

L3:
  if (pstat[254] != 0 && pstat[254] != 1 && pstat[254] != 2 && pstat[254] != 3) goto L4;
  callSubroutine(12);
  goto L6;

L4:
  if (pstat[254] != 7 && pstat[254] != 9 && pstat[254] != 13 && pstat[254] != 14) goto L5;
  callSubroutine(12);
  goto L6;
  goto L6;

L5:
  speak(Entity.Player, "No good. This won't do!\n");
  goto L8;

L6:
  playAnimation(Entity.Player, 5);
  delay(20);
  playAnimation(Entity.Player, 0);
  delay(5);
  playSound(8, 9);
  speak(5, "It's much better. Thanks.\n");
  playAnimation(5, 29);
  waitForEntity(5);
  speak(Entity.Player, "Can you fly already?\n");
  speak(5, "I don't think I can fly far.\n");
  speak(Entity.Player, "There's a clinic in city.\nYou should go there.\nIt isn't far from here.\n");
  speak(5, "I heard about the city.\nIt's bigger than I thought.\n");
  speak(Entity.Player, "Go to the city and rest.\n");
  playSound(8, 9);
  speak(5, "Thanks. Maybe\nI can help you someday.\n");
  goto L7;

L7:
  loop {
    move(entity: 5, to: (-93, -1821), sprint: 1);
    if (pstat[101] >= 3) break;
    addPStat(PStat.LoopIterator, 1);
    playSound(8, 0);
    delay(20);
    look(entity: Entity.Player, at: 5);
    look(entity: Entity.Partner, at: 5);
  }
  waitForEntity(5);
  unloadEntity(5);
  setPStat(PStat.LoopIterator, 0);
  playSound(8, 8);
  speak(Entity.System, "Unimon joins the city!\n");
  setTrigger(233);
  addPStat(1, 2);
  goto L9;

L8:
  speak(Entity.Player, "I'll bring something to cure\nyour wound. Wait for me.\n");
  playSound(8, 9);
  speak(5, "Thanks. Please hurry!\n");
  setTrigger(229);
  goto L9;

L9:
  return;
  garbage { 0c 00 fe 00 0c 00 05 00 90 00 ff ff 24 00 6e 63 19 00 0b 00 6e 0e 18 00 22 00 19 00 74 2c 35 00 40 00 24 00 6e 63 19 00 0b 00 6e 0e 18 00 38 00 19 00 74 2c 38 00 3d 00 24 00 6e 63 19 00 0b 00 6e 0e 18 00 4e 00 19 00 74 2c 3c 00 3b 00 24 00 6e 63 19 00 0b 00 6e 0e 18 00 64 00 19 00 74 2c 3f 00 37 00 24 00 6e 63 19 00 0b 00 6e 05 18 00 7a 00 19 00 74 45 38 00 41 00 19 00 01 00 e9 00 80 00 35 00 18 00 8e 00 19 00 56 00 05 1c fe 00 1c 00 2c 00 19 00 00 00 e5 00 18 00 46 01 19 00 5a 00 08 09 1b 05 1a 00 82 63 82 89 82 84 81 40 82 99 82 8f 82 95 81 40 82 82 82 92 82 89 82 8e 82 87 81 40 82 93 82 8f 82 8d 82 85 82 94 82 88 82 89 82 8e 82 87 0d 00 82 94 82 8f 81 40 82 94 82 92 82 85 82 81 82 94 81 40 82 94 82 88 82 85 81 40 82 97 82 8f 82 95 82 8e 82 84 81 48 0d 00 00 00 1b fd 1a 00 82 76 82 81 82 89 82 94 81 40 82 81 81 40 82 93 82 85 82 83 82 8f 82 8e 82 84 81 42 81 40 82 6b 82 85 82 94 81 40 82 8d 82 85 81 40 82 93 82 85 82 85 81 42 81 42 81 42 0d 00 00 00 16 00 60 02 5a 00 08 09 1b 05 }
}
