// DG115.SCN
#pragma script index=115 start=0x52800 end=0x54000 headerU16=0x10 sentinelOff=0x24

section onEnter(254) {  // len=120
    roll(pstat: 110, max: 99);
    if (pstat[110] > 18) goto L_0016;
    spawnItem(Item.Digimushroom, 56, 34);
L_0016:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 12) goto L_002c;
    spawnItem(Item.Digimushroom, 56, 80);
L_002c:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 3) goto L_0042;
    spawnItem(Item.Digipine, 35, 64);
L_0042:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 0) goto L_0058;
    spawnItem(Item.CalmBerry, 67, 32);
L_0058:
    if (!trigger(147)) goto L_0076;
    move(entity: 5, to: (-2017, 1378), animDuration: 3);
    waitForEntity(20);
    rotate(entity: 5, to: 0);
    delay(5);
L_0076:
    return;
}

section section_51(51) {  // len=3374
    if (trigger(147)) goto L_0018;
    setTrigger(147);
    goto L_001a;
    goto L_001a;
L_0018:
    return;
L_001a:
    move(entity: Entity.Player, to: (-1606, 166), sprint: 1, withCamera: true);
    move(entity: Entity.Partner, to: (-1407, 465), sprint: 1);
    waitForEntity(Entity.Partner);
    waitForEntity(Entity.Player);
    look(entity: Entity.Player, at: 5);
    look(entity: 5, at: Entity.Player);
    look(entity: Entity.Partner, at: 5);
    playSound(8, 18);
    setDialogOwner(5);
    showTextbox("Welcome young man.\n");
    playAnimation(Entity.Player, 20);
    delay(15);
    if (!trigger(309)) goto L_00ba;
    setDialogOwner(Entity.Player);
    showTextbox("You're Cherrymon, right?\n");
    goto L_00d6;
L_00ba:
    setDialogOwner(Entity.Player);
    showTextbox("Who is it?\n");
L_00d6:
    playAnimation(Entity.Player, 0);
    setDialogOwner(5);
    showTextbox("What do you want with\nan old man like me?\n");
    if (!trigger(309)) goto L_0176;
    setDialogOwner(Entity.Player);
    showTextbox("First, clear the fog.\n");
    goto L_01de;
L_0176:
    setDialogOwner(Entity.Player);
    showTextbox("I can't see with the fog.\nCan you get rid of it?\n");
L_01de:
    playSound(8, 18);
    setDialogOwner(5);
    showTextbox("So, that's it. I see.\n");
    playAnimation(Entity.Player, 19);
    delay(15);
    setDialogOwner(Entity.Player);
    showTextbox("... can't you do it?\n");
    playAnimation(Entity.Player, 0);
    setDialogOwner(5);
    showTextbox("First, listen to what I\ngot to say. Now... \nwhere should I begin?\n");
    setDialogOwner(Entity.Player);
    showTextbox("If you know about the\nemergency on the island,\nplease tell me about it.\n");
    setDialogOwner(5);
    showTextbox("I see, I see.\nThe emergency.\n");
L_03b0:
    playSound(8, 18);
    setDialogOwner(5);
    showTextbox("This island began to change\neighty years ago after the\nland changes happened.\n");
    showTextbox("The northeastern parts of\nthe island suddenly\nappeared eighty years ago.\n");
    showTextbox("Since then, Digimon\nstarted to move away.\nThe species separated.\n");
    showTextbox("And each species started\nto speak their own tongue.\n");
    playSound(8, 18);
    showTextbox("They forgot the language\nthey used in the city...\n");
    showTextbox("In the end, File City\nlost most of its\npopulation of Digimon.\n");
    showTextbox("Then Digimon began to\nlose their memory!\n");
    showTextbox("The island's history, their\npast, their senses...\ngetting worse day by day.\n");
    showTextbox("But I have something\nimportant to tell you, but\nI can't remember it, either.\n");
    playSound(8, 18);
    showTextbox("However, all will come\ntogether in the end. Someone\ncompels it to be so!\n");
    showTextbox("In time, the Digimon will\ncome to think of the\nemergency as normal.\n");
    showTextbox("The only thing that can stop\nthis is you and the power of\nFile City to unify Digimon!\n");
    showTextbox("Gather Digimon in the city\nand create a miracle.\nIt will definitely happen.\n");
    showTextbox("Well, I got all worked up.\nPhew, I've said it all.\n");
    if (trigger(148)) goto L_0b94;
    setTrigger(148);
    playSound(8, 18);
    setDialogOwner(5);
    showTextbox("Now, let's get rid of the fog.\n");
    callSubroutine(37);
    goto L_0b96;
L_0b94:
    return;
L_0b96:
    setDialogOwner(5);
    showTextbox("The reason for the forest fog\nwas to be able to speak\nto you. Oh, one more thing...\n");
    playSound(8, 18);
    showTextbox("There are others\nin the forest who know\nabout the past.\n");
    showTextbox("Go deep into the forest\nto find them, if you can.\n");
    playAnimation(5, 29);
    delay(60);
    return;
}

section section_5(5) {  // len=2634
    setTrigger(44);
    setDialogOwner(5);
    showTextbox("Did you come here again\nto hear an old man talk?\n");
    setDialogOwner(Entity.Player);
    setSelection(L_00e0, L_0122, L_0380);
    showTextbox("About the island...\nPlease train <ORANGE><DIGIMON><WHITE>\nNever mind\n");
    waitForSelectionChoice();
    goto L_0380;
L_00e0:
    setDialogOwner(5);
    showTextbox("Here's what I have to say.\n");
    goto section_51.L_03b0;
    return;
L_0122:
    setDialogOwner(5);
    showTextbox("Oh, Okay.\n");
    callSubroutine(39);
    setTextboxOrigin(-2017, 0, 1378);
    setDialogOwner(Entity.System);
    showTextbox("<GREEN>Training: The Teachings \nof the Forest <WHITE>\n");
    setSelection(L_01d6, L_0214, L_02f4);
    showTextbox("Begin\nExplain\nQuit\n");
    waitForSelectionChoice();
    return;
L_01d6:
    setDialogOwner(Entity.System);
    setSelection(L_02f6, L_0306, L_02f4);
    showTextbox("Normal\nBonus Try\nQuit\n");
    waitForSelectionChoice();
    return;
L_0214:
    setDialogOwner(Entity.System);
    showTextbox("Cherrymon will give you much\nknowledge. It'll greatly\nincrease your wisdom.\n");
    setSelection(L_0214, L_01d6, L_02f4);
    showTextbox("Explain again\nBegin\nQuit\n");
    waitForSelectionChoice();
    return;
L_02f4:
    return;
L_02f6:
    fadeOutHUD();
    setPStat(254, 5);
    setPStat(246, 0);
    callDigimonSubroutine(214);
    callSubroutine(7);
    return;
L_0306:
    setTexboxMode(1, 0);
    setDialogOwner(Entity.System);
    showTextbox("<YELLOW>Slot game <WHITE>\nUse <LIGHTBLUE><X> <WHITE>\nto match three pictures.\n");
    setPStat(254, 5);
    setPStat(246, 1);
    callDigimonSubroutine(214);
    callSubroutine(7);
    setTexboxMode(0, 0);
    return;
L_0380:
    setDialogOwner(5);
    showTextbox("Ha ha ha.\n");
    return;
    garbage { 10 00 fe 00 10 00 33 00 88 00 05 00 b6 0d ff ff 24 00 6e 63 19 00 0b 00 6e 12 18 00 26 00 19 00 74 2c 38 00 22 00 24 00 6e 63 19 00 0b 00 6e 0c 18 00 3c 00 19 00 74 2c 38 00 50 00 24 00 6e 63 19 00 0b 00 6e 03 18 00 52 00 19 00 74 2f 23 00 40 00 24 00 6e 63 19 00 0b 00 6e 00 18 00 68 00 19 00 74 3d 43 00 20 00 19 00 00 00 93 00 18 00 86 00 19 00 6c 05 1f f8 62 05 03 00 4a 14 4d 05 00 00 67 00 05 00 fe 00 19 00 01 00 93 00 18 00 a0 00 19 00 1c 00 93 00 16 00 a2 00 16 00 a2 00 fe 00 52 fd ba f9 a6 00 01 00 4e fc 81 fa d1 01 01 00 4a fc 4a fd 4c 00 fd 05 4c 00 05 fd 4c 00 fc 05 5a 00 08 12 1b 05 1a 00 82 76 82 85 82 8c 82 83 82 8f 82 8d 82 85 81 40 82 99 82 8f 82 95 82 8e 82 87 81 40 82 8d 82 81 82 8e 81 42 0d 00 00 00 56 00 fd 14 67 00 0f 00 19 00 00 00 35 01 18 00 42 01 19 00 1b fd 1a 00 82 78 82 8f 82 95 81 75 82 92 82 85 81 40 82 62 82 88 82 85 82 92 82 92 82 99 82 8d 82 8f 82 8e 81 43 81 40 82 92 82 89 82 87 82 88 82 94 81 48 0d 00 00 00 16 00 5e 01 1b fd 1a 00 82 76 82 88 82 8f 81 40 82 89 82 93 81 40 82 89 82 94 81 48 0d 00 00 00 56 00 fd 00 1b 05 1a 00 82 76 82 88 82 81 82 94 81 40 82 84 82 8f 81 40 82 99 82 8f 82 95 81 40 82 97 82 81 82 8e 82 94 81 40 82 97 82 89 82 94 82 88 0d 00 82 81 82 8e 81 40 82 8f 82 8c 82 84 81 40 82 8d 82 81 82 8e 81 40 82 8c 82 89 82 8b 82 85 81 40 82 8d 82 85 81 48 0d 00 00 00 19 00 00 00 35 01 18 00 fe 01 19 00 1b fd 1a 00 82 65 82 89 82 92 82 93 82 94 81 43 81 40 82 83 82 8c 82 85 82 81 82 92 81 40 82 94 82 88 82 85 81 40 82 86 82 8f 82 87 81 42 0d 00 00 00 16 00 66 02 1b fd 1a 00 82 68 81 40 82 83 82 81 82 8e 81 75 82 94 81 40 82 93 82 85 82 85 81 40 82 97 82 89 82 94 82 88 81 40 82 94 82 88 82 85 81 40 82 86 82 8f 82 87 81 42 0d 00 82 62 82 81 82 8e 81 40 82 99 82 8f 82 95 81 40 82 87 82 85 82 94 81 40 82 92 82 89 82 84 81 40 82 8f 82 86 81 40 82 89 82 94 81 48 0d 00 00 00 5a 00 08 12 1b 05 1a 00 82 72 82 8f 81 43 81 40 82 94 82 88 82 81 82 94 81 75 82 93 81 40 82 89 82 94 81 42 81 40 82 68 81 40 82 93 82 85 82 85 