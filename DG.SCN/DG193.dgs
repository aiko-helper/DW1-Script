// DG193.SCN
#pragma script index=193 start=0x92800 end=0x94000 headerU16=0x10 sentinelOff=0x1e

function speakThenPlayAnimationThenDelayThenSpeakThenPlayAnimation(a, b, c, d, e, f, g, h) {
    speak(a, b);
    playAnimation(c, d);
    delay(e);
    speak(c, f);
    playAnimation(g, h);
}

function playAnimationThenDelayThenSpeakThenPlayAnimationThenPlayAnimation(a, b, c, d, e, f, g) {
    playAnimation(a, b);
    delay(5);
    speak(c, d);
    playAnimation(e, 0);
    playAnimation(f, g);
}

function playAnimationThenDelayThenSpeakThenPlayAnimation(a, b, c, d, e) {
    playAnimation(a, b);
    delay(5);
    speak(a, c);
    playAnimation(d, e);
}

function delayThenSpeakThenPlayAnimation(a, b, c, d, e) {
    delay(a);
    speak(b, c);
    playAnimation(d, e);
}

function delayThenPlayAnimationThenDelay(a, b, c) {
    delay(a);
    playAnimation(Entity.Player, b);
    delay(c);
}


section onEnter(254) {
    setPStat(254, 0);
    callSubroutine(25);
    return;
    return;
}

section(54) {
    move(entity: Entity.Partner, to: (229, -2733), animDuration: 2);
    rotate(entity: Entity.Player, to: 2048);
    look(entity: 10, at: Entity.Player);
    delayThenPlayAnimationThenDelay(5, 18, 5);
    moveCamera(to: (200, -2000), slowdown: 30);
    waitForEntity(200);
    delay(20);
    delay(60);
    playAnimationThenDelayThenSpeakThenPlayAnimationThenPlayAnimation(8, 29, 8, "He arrived! It worked!\n", 8, 10, 11);
    playAnimationThenDelayThenSpeakThenPlayAnimationThenPlayAnimation(12, 11, 12, "A human.\nJust like you said, Jiji.\n", 10, 12, 0);
    speak(Entity.Player, "Mmmm.\n");
    playAnimation(8, 29);
    delay(5);
    speak(8, "Shhh, he's getting up.\n");
    setPStat(254, 253);
    callSubroutine(55);
    playAnimation(8, 0);
    speakThenPlayAnimationThenDelayThenSpeakThenPlayAnimation(Entity.Player, "Huh? Where am I?\n", 8, 29, 5, "Welcome to Digimon World!\n", 8, 0);
    speak(Entity.Player, "What?\n");
    look(entity: Entity.Player, at: 8);
    delayThenPlayAnimationThenDelay(5, 15, 10);
    speakThenPlayAnimationThenDelayThenSpeakThenPlayAnimation(Entity.Player, "Yikes!\n", 10, 5, 5, "What's the matter?\n", 10, 0);
    playAnimation(Entity.Player, 20);
    speak(Entity.Player, "Who are you guys?\n");
    playAnimation(Entity.Player, 0);
    look(entity: Entity.Player, at: 10);
    delay(10);
    look(entity: Entity.Player, at: 8);
    delay(10);
    playAnimationThenDelayThenSpeakThenPlayAnimation(8, 29, "These are Digimon.\n", 8, 0);
    speakThenPlayAnimationThenDelayThenSpeakThenPlayAnimation(Entity.Player, "Digi... What?\n", 8, 29, 5, "Huh? I thought you knew\nabout Digimon.\n", 8, 0);
    playAnimation(Entity.Player, 16);
    delay(10);
    speakThenPlayAnimationThenDelayThenSpeakThenPlayAnimation(Entity.Player, "I got it, this is a dream.\n", 10, 12, 5, "It's not a dream.\n", 10, 0);
    look(entity: Entity.Player, at: 10);
    delay(10);
    speakThenPlayAnimationThenDelayThenSpeakThenPlayAnimation(Entity.Player, "Hey wait, you're Tokomon.\nThis is a realistic dream.\n", 8, 29, 5, "<LIGHTBLUE><PLAYER><WHITE>, this isn't\na dream, but it's not\nreal either.\n", 8, 0);
    look(entity: Entity.Player, at: 8);
    delay(10);
    speakThenPlayAnimationThenDelayThenSpeakThenPlayAnimation(Entity.Player, "What are you talking about?\nWho are you?\n", 8, 29, 5, "I am Jijimon.\n", 8, 0);
    playAnimation(Entity.Player, 16);
    speakThenPlayAnimationThenDelayThenSpeakThenPlayAnimation(Entity.Player, "I don't know of any\nDigimon by that name.\n", 8, 29, 5, "There are more Digimon\nthan you know of.\nThis is Digimon World.\n", 8, 0);
    speak(Entity.Player, "Digimon World?!\n");
    rotate(entity: 8, to: 1600);
    delay(5);
    playAnimationThenDelayThenSpeakThenPlayAnimationThenPlayAnimation(8, 29, 8, "This world is not a\ndream nor is it real.\nIt's our world.\n", 8, Entity.Player, 16);
    speak(Entity.Player, "Gee... It looks too real\nto be a dream.\n");
    look(entity: 8, at: Entity.Player);
    delay(5);
    playAnimationThenDelayThenSpeakThenPlayAnimation(8, 29, "Look behind you,\nyou'll see what I mean.\n", 8, 0);
    speak(Entity.Player, "What?\n");
    rotate(entity: Entity.Player, to: 0);
    delay(10);
    playAnimation(Entity.Player, 15);
    look(entity: Entity.Partner, at: Entity.Player);
    delay(20);
    move(entity: Entity.Partner, to: (229, -2533), sprint: 0);
    waitForEntity(Entity.Partner);
    playAnimation(Entity.Partner, 11);
    delay(20);
    playAnimation(Entity.Player, 20);
    speak(Entity.Player, "Is this <ORANGE><DIGIMON><WHITE>?\n");
    playAnimation(Entity.Player, 0);
    playAnimation(Entity.Partner, 0);
    delay(5);
    speakThenPlayAnimationThenDelayThenSpeakThenPlayAnimation(Entity.Player, "I remember now! I got sucked\ninto that Digimon key chain.\n", 8, 29, 5, "That's right.\n", 8, 0);
    look(entity: Entity.Player, at: 8);
    delayThenSpeakThenPlayAnimation(20, Entity.Player, "Why am I here?\n", 8, 29);
    delay(5);
    speak(8, "Come to my house,\nI'll explain.\n");
    warp(to: Map.ROOM08, spawn: 1, trigger: 54);
}

section(55) {
    moveCamera(to: (183, 221), slowdown: 20);
    waitForEntity(200);
    delay(20);
    unsetTrigger(55);
    storeDigimonType(103);
    if (pstat[103] != 3) goto L1;
    setStats(offense: 80, defense: 60, speed: 70, brains: 70, maxHP: 800, maxMP: 600, currentHP: 800, currentMP: 600);
    goto L2;

L1:
    setStats(offense: 70, defense: 80, speed: 60, brains: 70, maxHP: 700, maxMP: 700, currentHP: 700, currentMP: 700);

L2:
    removeItems([
        :LargeRecovery, :SuperRecovery, :MediumMP, :LargeMP,
        :Omnipotent, :Restore, :SuperRestore, :SuperOffenseDisk,
        :SuperDefenseDisk, :SuperSpeedDisk, :BlueApple, :SpinyGreen,
        :MoldyMeat, :Medicine, :MansionKey, :IceCrystal,
        :CyberPart, :Unihorn, :Sunglasses, :XBandage,
        :Fertilizer, :Steak, :Leomonstone, :RainPlant,
        :PortaPotty, :Autopilot, :IronHoof, :SteelDrill,
        :TornTatter, :NorthStar, :MetalPart, :FatalBone,
        :SmallSpear, :SpikeClub, :HairGrower, :MonoStone,
        :FlamingMane, :Waterbottle, :Rooster, :MystyEgg,
        :RedRuby, :RedShell, :HornHelmet, :ScissorJaw,
        :Beetlepearl, :Digiseabass, :ChainMelon, :RayGun,
        :CoralCharm, :GigaHand, :NobleMane, :MetalBanana,
        :Rainbowhorn, :KogaLaws, :HardScale, :BlueCrystal,
        :SilverBall, :MetalArmor
    ], 99);
    reduceMoney(50000);
    setInventorySize(10);
    look(entity: Entity.Partner, at: Entity.Player);
    delayThenSpeakThenPlayAnimation(5, 5, "I invited you here\nto save us.\n", 5, 0);
    speakThenPlayAnimationThenDelayThenSpeakThenPlayAnimation(Entity.Player, "Save you from what?\n", 5, 29, 5, "We are in File City, it's\nthe center of File Island.\n", Entity.Player, 16);
    delay(10);
    speak(Entity.Player, "A city? Here?\n");
    playAnimation(Entity.Player, 0);
    playAnimationThenDelayThenSpeakThenPlayAnimationThenPlayAnimation(5, 29, 5, "Well, it was a city.\nThere used to be all kinds of\nDigimon who lived here.\n", 5, 5, 29);
    delay(5);
    speak(5, "Digimon started to lose heart\nand moved out of the city.\n");
    speak(Entity.Player, "What do you mean?\n");
    playAnimation(5, 0);
    playAnimationThenDelayThenSpeakThenPlayAnimationThenPlayAnimation(5, 29, 5, "I'm not sure what caused it.\nDigimon started losing their\nspeaking skills.\n", 5, 5, 29);
    delayThenSpeakThenPlayAnimation(5, 5, "Some of them still talk, but\nthey all forgot that they\nlived here.\n", 5, 0);
    speakThenPlayAnimationThenDelayThenSpeakThenPlayAnimation(Entity.Player, "That's what you meant\nby losing heart.\n", 5, 30, 5, "It's dangerous if\nwe do nothing.\n", 5, 0);
    speakThenPlayAnimationThenDelayThenSpeakThenPlayAnimation(Entity.Player, "But why me?\n", 5, 29, 5, "You are good at raising\nDigimon, right?\n", 5, 0);
    speakThenPlayAnimationThenDelayThenSpeakThenPlayAnimation(Entity.Player, "I'm good at it, alright!\n", 5, 29, 5, "Don't you realize that\nyou're speaking Digimon?\n", 5, 0);
    speakThenPlayAnimationThenDelayThenSpeakThenPlayAnimation(Entity.Player, "Huh? No way. I'm speaking\nplain old English.\n", 5, 29, 5, "To us, it sounds like Digimon.\n", 5, 0);
    playAnimation(6, 11);
    playAnimationThenDelayThenSpeakThenPlayAnimationThenPlayAnimation(7, 11, 6, "That's right!\n", 6, 7, 0);
    playAnimationThenDelayThenSpeakThenPlayAnimation(5, 29, "In this world, your love\nfor Digimon will give\nyou strength.\n", 5, 0);
    speakThenPlayAnimationThenDelayThenSpeakThenPlayAnimation(Entity.Player, "Thanks.\n", 5, 29, 5, "That's why I chose you.\nYou can rally all the\nDigimon on the island!\n", 5, 0);
    speak(Entity.Player, "What?\n");
    speak(Entity.Player, "Hmm?\n");
    speak(Entity.Player, "You can count on me!\n");
    for x in [Entity.Player, 6, 7] { playAnimation(x, 11); }
    delayThenSpeakThenPlayAnimation(5, 6, "Alright!\n", 6, 0);
    playAnimation(7, 0);
    playAnimationThenDelayThenSpeakThenPlayAnimation(5, 31, "Thanks, you're our only hope.\n", 5, 0);
    speakThenPlayAnimationThenDelayThenSpeakThenPlayAnimation(Entity.Player, "Where do I start?\n", 5, 29, 5, "Take <ORANGE><DIGIMON><WHITE> and\nexplore the island.\n", 5, 0);
    playAnimationThenDelayThenSpeakThenPlayAnimation(5, 29, "Find the cause of this\ndanger and get Digimon\nto come back.\n", Entity.Player, 22);
    delayThenPlayAnimationThenDelay(10, 22, 10);
    playAnimation(Entity.Player, 0);
    delay(2);
    speak(Entity.Player, "Let's go <ORANGE><DIGIMON><WHITE>!\n");
    rotate(entity: Entity.Player, to: 0);
    delay(10);
    move(entity: Entity.Player, to: (-108, -1728), sprint: 1);
    delay(20);
    move(entity: Entity.Partner, to: (-108, -1728), sprint: 1);
    delay(20);
    playAnimation(5, 0);
    playAnimationThenDelayThenSpeakThenPlayAnimation(5, 29, "Wait, I haven't finished yet.\n", 5, 0);
    warp(to: Map.TWNA01, spawn: 2, trigger: 255);
    return;
    garbage { 10 00 fe 00 10 00 36 00 1a 00 37 00 06 09 ff ff 1e 00 fe 00 64 19 fe 00 fe 00 6c fc e5 00 53 f5 02 00 4d fd 00 08 4c 00 0a fd 67 00 05 00 56 00 fd 12 67 00 05 00 4f 1e c8 00 30 f8 4a c8 67 00 14 00 67 00 3c 00 56 00 08 1d 67 00 05 00 1b 08 1a 00 82 67 82 85 81 40 82 81 82 92 82 92 82 89 82 96 82 85 82 84 81 49 81 40 82 68 82 94 81 40 82 97 82 8f 82 92 82 8b 82 85 82 84 81 49 0d 00 00 00 56 00 08 00 56 00 0a 0b 56 00 0c 0b 67 00 05 00 1b 0c 1a 00 82 60 81 40 82 88 82 95 82 8d 82 81 82 8e 81 42 0d 00 82 69 82 95 82 93 82 94 81 40 82 8c 82 89 82 8b 82 85 81 40 82 99 82 8f 82 95 81 40 82 93 82 81 82 89 82 84 81 43 81 40 82 69 82 89 82 8a 82 89 81 42 0d 00 00 00 56 00 0a 00 56 00 0c 00 1b fd 1a 00 82 6c 82 8d 82 8d 82 8d 81 42 0d 00 00 00 56 00 08 1d 67 00 05 00 1b 08 1a 00 82 72 82 88 82 88 82 88 81 43 81 40 82 88 82 85 81 75 82 93 81 40 82 87 82 85 82 94 82 94 82 89 82 8e 82 87 81 40 82 95 82 90 81 42 0d 00 00 00 1e 00 fe fd 64 37 56 00 08 00 1b fd 1a 00 82 67 82 95 82 88 81 48 81 40 82 76 82 88 82 85 82 92 82 85 81 40 82 81 82 8d 81 40 82 68 81 48 0d 00 00 00 56 00 08 1d 67 00 05 00 1b 08 1a 00 82 76 82 85 82 8c 82 83 82 8f 82 8d 82 85 81 40 82 94 82 8f 81 40 82 63 82 89 82 87 82 89 82 8d 82 8f 82 8e 81 40 82 76 82 8f 82 92 82 8c 82 84 81 49 0d 00 00 00 56 00 08 00 1b fd 1a 00 82 76 82 88 82 81 82 94 81 48 0d 00 00 00 4c 00 fd 08 67 00 05 00 56 00 fd 0f 67 00 0a 00 1b fd 1a 00 82 78 82 89 82 8b 82 85 82 93 81 49 0d 00 00 00 56 00 0a 05 67 00 05 00 1b 0a 1a 00 82 76 82 88 82 81 82 94 81 75 82 93 81 40 82 94 82 88 82 85 81 40 82 8d 82 81 82 94 82 94 82 85 82 92 81 48 0d 00 00 00 56 00 0a 00 56 00 fd 14 1b fd 1a 00 82 76 82 88 82 8f 81 40 82 81 82 92 82 85 81 40 82 99 82 8f 82 95 81 40 82 87 82 95 82 99 82 93 81 48 0d 00 00 00 56 00 fd 00 4c 00 fd 0a 67 00 0a 00 4c 00 fd 08 67 00 0a 00 56 00 08 1d 67 00 05 00 1b 08 1a 00 82 73 82 88 82 85 82 93 82 85 81 40 82 81 82 92 82 85 81 40 82 63 82 89 82 87 82 89 82 8d 82 8f 82 8e 81 42 0d 00 00 00 56 00 08 00 1b fd 1a 00 82 63 82 89 82 87 82 89 81 42 81 42 81 42 81 40 82 76 82 88 82 81 82 94 81 48 0d 00 00 00 56 00 08 1d 67 00 05 00 1b 08 1a 00 82 67 82 95 82 88 81 48 81 40 82 68 81 40 82 94 82 88 82 8f 82 95 82 87 82 88 82 94 81 40 82 99 82 8f 82 95 81 40 82 8b 82 8e 82 85 82 97 0d 00 82 81 82 82 82 8f 82 95 82 94 81 40 82 63 82 89 82 87 82 89 82 8d 82 8f 82 8e 81 42 0d 00 00 00 56 00 08 00 56 00 fd 10 67 00 0a 00 1b fd 1a 00 82 68 81 40 82 87 82 8f 82 94 81 40 82 89 82 94 81 43 81 40 82 94 82 88 82 89 82 93 81 40 82 89 82 93 81 40 82 81 81 40 82 84 82 92 82 85 82 81 82 8d 81 42 0d 00 00 00 56 00 0a 0c 67 00 05 00 1b 0a 1a 00 82 68 82 94 81 75 82 93 81 40 }
}
