// DG013.SCN
#include "functions.dgs"
#pragma script index=13 start=0xf000 end=0xf800 headerU16=0x1c sentinelOff=0x175
#include "entities.dgs"

section onEnter(254) {
  spawnChest(Item.MediumRecovery, 1941, 142, 0, 693);
  spawnItemChance(max: 99, chance: 14, item: Item.Digimushroom, x: 79, y: 34);
  spawnItemChance(max: 99, chance: 17, item: Item.Digimushroom, x: 56, y: 61);
  spawnItemChance(max: 99, chance: 5, item: Item.Digimushroom, x: 87, y: 67);
  spawnItemChance(max: 99, chance: 2, item: Item.OrangeBanana, x: 21, y: 57);
  return;
}

section(5) {
  speak(Entity(5), "Hey, are you the one\nbuilding a city?\n");
  speak(Entity.Player, "Yes.\n");
  playSound(8, 6);
  speak(Entity(5), "Uh, you're real lucky\nto meet me.\n");
  showTextbox("I don't look it, but I'm an\nUltimate Digimon. If you\nbeat me, I'll help you.\n");
  playAnimation(Entity.Player, Animation(16));
  setDialogOwner(Entity.Player);
  choice { "Okay, I accept" -> L1, "No thanks" -> L3 }
  goto L3;

L1:
  setTrigger(Trigger(1));
  setPStat(PStat(250), 1);
  setPStat(PStat(251), 5);
  setPStat(PStat(252), 255);
  setPStat(PStat(253), 255);
  startBattle();
  unsetTrigger(Trigger(1));
  setPStat(PStat(250), 0);
  look(entity: Entity.Player, at: Entity(5));
  look(entity: Entity(5), at: Entity.Player);
  look(entity: Entity.Partner, at: Entity(5));
  lookPairAt(Entity(5));
  look(entity: Entity(5), at: Entity.Player);
  waitForEntity(Entity.Player);
  speak(Entity(5), "Wow, I lost! Well, I'll\nsee you in the city.\n");
  goto L2;

L2:
  approach(who: Entity(5), x: -2444, y: -3233, tries: 10, wait: 10);
  playSound(8, 3);
  speak(Entity.System, "Piximon joins the city!\n");
  unsetTrigger(Trigger(1));
  setTrigger(Trigger(255));
  addPStat(PStat(1), 3);
  followEntity(Entity.Player, speed: 10);
  return;

L3:
  speak(Entity(5), "Oh, what a coward!\nLet's meet again!\n");
  goto L4;

L4:
  approach(who: Entity(5), x: -2444, y: -3233, tries: 10, wait: 10);
  return;
}

section(6) {
  speak(Entity(6), "Oh, Senorita!\n");
  finishEncounter(Trigger(293));
}

section(7) {
  speak(Entity(7), "Hey amigo, what's up?\n");
  finishEncounter(Trigger(293));
}

section(8) {
  speak(Entity(8), "Wooki, wooki!\n");
  finishEncounter(Trigger(278));
}

section(9) {
  speak(Entity(9), "Huh?\n");
  finishEncounter(Trigger(278));
  garbage { 1c 00 fe 00 1c 00 05 00 82 00 06 00 be 03 07 00 ee 03 08 00 2e 04 09 00 5e 04 ff ff 75 01 95 07 00 00 8e 00 00 00 b5 02 24 00 6e 63 19 00 0b 00 6e 0e 18 00 3e 00 19 00 74 2c 4f 00 22 00 24 00 6e 63 19 00 0b 00 6e 11 18 00 54 00 19 00 74 2c 38 00 3d 00 24 00 6e 63 19 00 0b 00 6e 05 18 00 6a 00 19 00 74 2c 57 00 43 00 24 00 6e 63 19 00 0b 00 6e 02 18 00 80 00 19 00 74 37 15 00 39 00 fe 00 1b 05 1a 00 82 67 82 85 82 99 81 43 81 40 82 81 82 92 82 85 81 40 82 99 82 8f 82 95 81 40 82 94 82 88 82 85 81 40 82 8f 82 8e 82 85 0d 00 82 82 82 95 82 89 82 8c 82 84 82 89 82 8e 82 87 81 40 82 81 81 40 82 83 82 89 82 94 82 99 81 48 0d 00 00 00 1b fd 1a 00 82 78 82 85 82 93 81 42 0d 00 00 00 5a 00 08 06 1b 05 1a 00 82 74 82 88 81 43 81 40 82 99 82 8f 82 95 81 75 82 92 82 85 81 40 82 92 82 85 82 81 82 8c 81 40 82 8c 82 95 82 83 82 8b 82 99 0d 00 82 94 82 8f 81 40 82 8d 82 85 82 85 82 94 81 40 82 8d 82 85 81 42 0d 00 00 00 1a 00 82 68 81 40 82 84 82 8f 82 8e 81 75 82 94 81 40 82 8c 82 8f 82 8f 82 8b 81 40 82 89 82 94 81 43 81 40 82 82 82 95 82 94 81 40 82 68 81 75 82 8d 81 40 82 81 82 8e 0d 00 82 74 82 8c 82 94 82 89 82 8d 82 81 82 94 82 85 81 40 82 63 82 89 82 87 82 89 82 8d 82 8f 82 8e 81 42 81 40 82 68 82 86 81 40 82 99 82 8f 82 95 0d 00 82 82 82 85 82 81 82 94 81 40 82 8d 82 85 81 43 81 40 82 68 81 75 82 8c 82 8c 81 40 82 88 82 85 82 8c 82 90 81 40 82 99 82 8f 82 95 81 42 0d 00 00 00 56 00 fd 10 1b fd 10 02 18 02 38 03 1a 00 82 6e 82 8b 82 81 82 99 81 43 81 40 82 68 81 40 82 81 82 83 82 83 82 85 82 90 82 94 0d 00 82 6d 82 8f 81 40 82 94 82 88 82 81 82 8e 82 8b 82 93 0d 00 00 00 12 00 16 00 38 03 1c 00 01 00 1e 00 fa 01 1e 00 fb 05 1e 00 fc ff 1e 00 fd ff 27 00 67 00 01 00 66 00 1d 00 01 00 1e 00 fa 00 4c 00 fd 05 4c 00 05 fd 4c 00 fc 05 4c 00 fd 05 4c 00 fc 05 4c 00 05 fd 4a fd 1b 05 1a 00 82 76 82 8f 82 97 81 43 81 40 82 68 81 40 82 8c 82 8f 82 93 82 94 81 49 81 40 82 76 82 85 82 8c 82 8c 81 43 81 40 82 68 81 75 82 8c 82 8c 0d 00 82 93 82 85 82 85 81 40 82 99 82 8f 82