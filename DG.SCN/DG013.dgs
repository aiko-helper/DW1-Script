// DG013.SCN
#include "functions.dgs"
#pragma script index=13 start=0xe000 end=0xe800 headerU16=0x20 sentinelOff=0x24
#include "entities.dgs"

section onEnter(254) {
  spawnItemChance(max: 99, chance: 15, item: Item.Digimushroom, x: 25, y: 33);
  spawnItemChance(max: 99, chance: 4, item: Item.Digimushroom, x: 63, y: 31);
  spawnItemChance(max: 99, chance: 1, item: Item.DeluxeMushroom, x: 53, y: 81);
  return;
}

section(5) {
  speak(Entity(5), "「シャーッ!」<NEWLINE>");
  finishEncounter(Trigger(267));
}

section(6) {
  speak(Entity(6), "「スゥィィィィィ!」<NEWLINE>");
  finishEncounter(Trigger(267));
}

section(7) {
