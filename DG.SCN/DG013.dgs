// DG013.SCN
#pragma script index=13 start=0xf000 end=0xf800 headerU16=0x1c sentinelOff=0x175

section onEnter(254) {  // len=102
    spawnChest(Item.MediumRecovery, 1941, 142, 0, 693);
    roll(pstat: 110, max: 99);
    if (pstat[110] > 14) goto L1;
    spawnItem(Item.Digimushroom, x: 79, y: 34);

L1:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 17) goto L2;
    spawnItem(Item.Digimushroom, x: 56, y: 61);

L2:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 5) goto L3;
    spawnItem(Item.Digimushroom, x: 87, y: 67);

L3:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 2) goto L4;
    spawnItem(Item.OrangeBanana, x: 21, y: 57);

L4:
    return;
}

section(5) {  // len=828
    speak(5, "Hey, are you the one\nbuilding a city?\n");
    speak(Entity.Player, "Yes.\n");
    playSound(8, 6);
    speak(5, "Uh, you're real lucky\nto meet me.\n");
    showTextbox("I don't look it, but I'm an\nUltimate Digimon. If you\nbeat me, I'll help you.\n");
    playAnimation(Entity.Player, 16);
    setDialogOwner(Entity.Player);
    choice { "Okay, I accept" -> L1, "No thanks" -> L4 }
    goto L4;

L1:
    setTrigger(1);
    setPStat(250, 1);
    setPStat(251, 5);
    setPStat(252, 255);
    setPStat(253, 255);
    fadeOutHUD();
    delay(1);
    startBattle();
    unsetTrigger(1);
    setPStat(250, 0);
    look(entity: Entity.Player, at: 5);
    look(entity: 5, at: Entity.Player);
    look(entity: Entity.Partner, at: 5);
    look(entity: Entity.Player, at: 5);
    look(entity: Entity.Partner, at: 5);
    look(entity: 5, at: Entity.Player);
    waitForEntity(Entity.Player);
    speak(5, "Wow, I lost! Well, I'll\nsee you in the city.\n");
    goto L2;

L2:
    move(entity: 5, to: (-2444, -3233), sprint: 1);
    if (pstat[101] >= 10) goto L3;
    addPStat(101, 1);
    delay(10);
    look(entity: Entity.Player, at: 5);
    look(entity: Entity.Partner, at: 5);
    goto L2;

L3:
    waitForEntity(5);
    unloadEntity(5);
    setPStat(101, 0);
    playSound(8, 3);
    speak(Entity.System, "Piximon joins the city!\n");
    unsetTrigger(1);
    setTrigger(255);
    addPStat(1, 3);
    moveCamera(to: Entity.Player, speed: 10);
    waitForEntity(200);
    return;

L4:
    speak(5, "Oh, what a coward!\nLet's meet again!\n");
    goto L5;

L5:
    move(entity: 5, to: (-2444, -3233), sprint: 1);
    if (pstat[101] >= 10) goto L6;
    addPStat(101, 1);
    delay(10);
    look(entity: Entity.Player, at: 5);
    look(entity: Entity.Partner, at: 5);
    goto L5;

L6:
    waitForEntity(5);
    unloadEntity(5);
    setPStat(101, 0);
    return;
}

section(6) {  // len=48
    speak(6, "Oh, Senorita!\n");
    fadeOutHUD();
    delay(1);
    startBattle();
    setTrigger(293);
    return;
}

section(7) {  // len=64
    speak(7, "Hey amigo, what's up?\n");
    fadeOutHUD();
    delay(1);
    startBattle();
    setTrigger(293);
    return;
}

section(8) {  // len=48
    speak(8, "Wooki, wooki!\n");
    fadeOutHUD();
    delay(1);
    startBattle();
    setTrigger(278);
    return;
}

section(9) {  // len=930
    speak(9, "Huh?\n");
    fadeOutHUD();
    delay(1);
    startBattle();
    setTrigger(278);
    return;
