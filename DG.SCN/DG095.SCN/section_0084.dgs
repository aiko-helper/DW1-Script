section section_84(84) {  // len=1436
    rotate(entity: Entity.Player, to: 2048);
    setTextboxOrigin(1574, 0, 116);
    callSubroutine(39);
    setDialogOwner(200);
    showTextbox("<GREEN>Training: Icicle Fall <WHITE>\n");
    setSelection(L_007c, L_00ba, L_01c2);
    showTextbox("Begin\nExplain\nQuit\n");
    waitForSelectionChoice();
    return;
L_007c:
    setDialogOwner(200);
    setSelection(L_01c4, L_01d4, L_01c2);
    showTextbox("Normal\nBonus Try\nQuit\n");
    waitForSelectionChoice();
    return;
L_00ba:
    setDialogOwner(200);
    showTextbox("Train in catching\na big icicle.\n");
    showTextbox("Defensive Power is\ngreatly boosted.\nSpeed will also increase.\n");
    setSelection(L_00ba, L_007c, L_01c2);
    showTextbox("Explain again\nBegin\nQuit\n");
    waitForSelectionChoice();
    return;
L_01c2:
    return;
L_01c4:
    fadeOutHUD();
    setPStat(254, 3);
    setPStat(246, 0);
    callDigimonSubroutine(214);
    callSubroutine(7);
    return;
L_01d4:
    setTexboxMode(1, 0);
    setDialogOwner(Entity.System);
    showTextbox("<YELLOW>Slot game <WHITE>\nUse <LIGHTBLUE><X> <WHITE>to\nmatch three pictures\n");
    setPStat(254, 3);
    setPStat(246, 1);
    callDigimonSubroutine(214);
    callSubroutine(7);
    setTexboxMode(0, 0);
    return;
