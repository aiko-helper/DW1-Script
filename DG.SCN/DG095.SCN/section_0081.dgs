// source: extract/DIGIMON/SCN/DG.SCN
// DG095.SCN, section 81

section section_81(81) {  // len=576
    rotate(entity: Entity.Player, to: 2048);
    setTextboxOrigin(-11, 0, 1049);
    callSubroutine(39);
    setDialogOwner(200);
    showTextbox("<GREEN>Training: Moving Ice <WHITE>\n");
    setSelection(L_007a, L_00b6, L_01b6);
    showTextbox("Begin\nExplain\nQuit\n");
    waitForSelectionChoice();
    return;
L_007a:
    setSelection(L_01b8, L_01c8, L_01b6);
    showTextbox("Normal\nBonus Try\nQuit\n");
    waitForSelectionChoice();
    return;
L_00b6:
    showTextbox("Pushing ice develops strength.\n");
    showTextbox("Max HP is greatly boosted.\nDefensive power is\nboosted, too.\n");
    setSelection(L_00b6, L_007a, L_01b6);
    showTextbox("Explain again\nBegin\nQuit\n");
    waitForSelectionChoice();
    return;
L_01b6:
    return;
L_01b8:
    fadeOutHUD();
    setPStat(254, 0);
    setPStat(246, 0);
    callDigimonSubroutine(214);
    callSubroutine(7);
    return;
L_01c8:
    setTexboxMode(1, 0);
    setDialogOwner(Entity.System);
    showTextbox("<YELLOW>Slot game <WHITE>\nUse <LIGHTBLUE><X> <WHITE>to match\nthree pictures.\n");
    setPStat(254, 0);
    setPStat(246, 1);
    callDigimonSubroutine(214);
    callSubroutine(7);
    setTexboxMode(0, 0);
    return;
}
