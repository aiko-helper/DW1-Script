// DG073.SCN
#include "functions.dgs"
#pragma script index=73 start=0x34000 end=0x34800 headerU16=0x18 sentinelOff=0x24

section onEnter(254) {
  roll(pstat: 110, max: 99);
  if (pstat[110] > 5) goto L1;
  spawnItem(Item.Digimushroom, x: 39, y: 59);

L1:
  roll(pstat: 110, max: 99);
  if (pstat[110] > 14) goto L2;
  spawnItem(Item.Digimushroom, x: 62, y: 89);

L2:
  roll(pstat: 110, max: 99);
  if (pstat[110] > 11) goto L3;
  spawnItem(Item.Digimushroom, x: 40, y: 24);

L3:
  roll(pstat: 110, max: 99);
  if (pstat[110] > 6) goto L4;
  spawnItem(Item.Digimushroom, x: 61, y: 35);

L4:
  unsetTrigger(338);
  return;
}

section(51) {
  if (!trigger(196) && !trigger(338)) goto L1;
  return;

L1:
  rotate(entity: Entity.Player, to: 2048);
  rotate(entity: Entity.Partner, to: 2048);
  delay(5);
  setTrigger(196);
  setDigimon(Digimon.NPCPatamon, 0, 0);
  setDigimon(Digimon.NPCGobiromon, 1, 0);
  moveCamera(to: (-205, 1478), slowdown: 15);
  waitForEntity(200);
  move(entity: 5, to: (-254, 439), sprint: 1);
  move(entity: 6, to: (-254, 1039), sprint: 1);
  delay(45);
  rotate(entity: 5, to: 0);
  rotate(entity: 6, to: 0);
  moveCamera(to: 5, speed: 25);
  waitForEntity(200);
  speak(Entity.Player, "What is it?\n");
  waitForEntity(5);
  look(entity: 5, at: Entity.Player);
  delay(5);
  speak(5, "HELP ME!\n");
  playAnimation(Entity.Player, 7);
  delay(15);
  speak(Entity.Player, "He's in trouble,\nI gotta help him!\n");
  playAnimation(Entity.Player, 0);
  move(entity: Entity.Player, to: (-150, -550), sprint: 1);
  move(entity: Entity.Partner, to: (-80, -300), sprint: 1);
  speak(Entity.System, "<YELLOW>??? <WHITE>\nPick on someone\nyour own size!\n");
  setPStat(245, 3);
  setBGM(11);
  setDigimon(Digimon.NPCLeomon, 2, 0);
  moveCamera(to: (-677, 509), slowdown: 20);
  waitForEntity(200);
  look(entity: 7, at: 6);
  look(entity: Entity.Player, at: 7);
  delay(10);
  speak(Entity.Player, "Who is that?\n");
  look(entity: 5, at: 7);
  look(entity: 6, at: 7);
  delay(10);
  look(entity: 7, at: 6);
  move(entity: 6, to: (-254, 1039), sprint: 1);
  delay(5);
  move(entity: 7, axis: 1, to: 0, speed: 1);
  delay(2);
  playAnimation(7, 28);
  delay(20);
  playAnimation(7, 0);
  playSound(8, 1);
  look(entity: Entity.Player, at: 7);
  look(entity: 5, at: 7);
  look(entity: 6, at: 7);
  for x in [Entity.Player, 5, 6] { waitForEntity(x); }
  playAnimation(6, 40);
  delay(20);
  move(entity: 6, to: (0, 4000), sprint: 1);
  waitForEntity(6);
  unloadEntity(6);
  look(entity: 5, at: 7);
  delay(5);
  look(entity: 7, at: 5);
  delay(5);
  speak(7, "Are you alright?\n");
  speak(5, "Thank you.\n");
  speak(7, "Call me anytime you're\nin trouble. I will\ncome right away!\n");
  showTextbox("See you again!\n");
  move(entity: 7, to: (-2323, 1264), sprint: 1);
  delay(20);
  speak(5, "Hey, wait up!\n");
  move(entity: 5, to: (-2323, 1264), sprint: 1);
  delay(40);
  waitForEntity(5);
  waitForEntity(7);
  unloadEntity(7);
  unloadEntity(5);
  moveCamera(to: Entity.Player, speed: 10);
  waitForEntity(200);
  speak(Entity.Player, "He's like a hero.\nHe gets all the credit.\n");
  playAnimation(Entity.Player, 0);
  setTrigger(196);
  return;
}

section(52) {
  setTrigger(338);
  return;
}

section(8) {
  speak(8, "This is my house. Leave!\n");
  startBattle();
  setTrigger(297);
  return;
}

section(9) {
  speak(9, "I'm Sharmamon. Who are you?\n");
  startBattle();
  setTrigger(297);
  return;
