section(6) {
  roll(pstat: PStat.RollScratch, max: 3);
  switch pstat[110] {
    0 => {
      speak(Entity(6), "「なんじゃのう、こまめに<NEWLINE> つかれをとっておくのが健康の<NEWLINE> ヒケツじゃな。」<NEWLINE>");
      return;
    }
    1 => {
      speak(Entity(6), "「なんじゃのう、はんえい度の<NEWLINE> 増えかたについて教えてやるかのう。」<NEWLINE>");
      showTextbox("「成長期のデジモンが街に来れば+1、<NEWLINE> 成熟期のデジモンが街に来れば+2。」<NEWLINE>");
      showTextbox("「完全体のデジモンが街に来れば+3、<NEWLINE> となっておるらしい。」<NEWLINE>");
      showTextbox("「ただ、成熟期の中であまり役に立たない<NEWLINE> 3びきだけは+1なんじゃよ。」<NEWLINE>");
      return;
    }
    2 => {
      speak(Entity(6), "「なんじゃのう、属性について<NEWLINE> 少し教えてやるかのう。」<NEWLINE>");
      showTextbox("「まず、パートナーと同じ属性の敵は、<NEWLINE> 戦闘に参加しにくいのじゃ。」<NEWLINE>");
      showTextbox("「あと、属性が合わないと入り口で<NEWLINE> はじかれてしまう場所が2つある。」<NEWLINE>");
      showTextbox("「それ以外はまあ、あまり気にしなくて<NEWLINE> いいかもしれんのう。」<NEWLINE>");
      return;
    }
    3 => {
      speak(Entity(6), "「なんじゃのう、テイマーレベルについて<NEWLINE> 教えてやるかのう。」<NEWLINE>");
      showTextbox("「まずは進化の時じゃな。<NEWLINE> 完全体まで育てることができれば確実に<NEWLINE> 1レベル上がるのじゃ。」<NEWLINE>");
      showTextbox("「それと、高レベルの大会で優勝するのも<NEWLINE> いいのう。」<NEWLINE>");
      showTextbox("「まあ、あまり意識しなくても自然に<NEWLINE> 上がっていくもんじゃよ。」<NEWLINE>");
      showTextbox("「ぎゃくに、下がるほうは気をつけられよ。<NEWLINE> たとえばライフが無くなると<NEWLINE> 確実に下がってしまう。」<NEWLINE>");
      showTextbox("「めったにないが、<NEWLINE> 日々の育成のミスでも下がることがある。<NEWLINE> つねに気をくばるべきじゃな。」<NEWLINE>");
      return;
    }
  }
  return;
}

