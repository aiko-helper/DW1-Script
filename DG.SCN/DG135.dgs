// DG135.SCN
#include "functions.dgs"
#pragma script index=135 start=0x58800 end=0x59000 headerU16=0x24 sentinelOff=0x19
#include "entities.dgs"

section onEnter(254) {
  if (!trigger(270)) {
    roll(pstat: PStat.RollScratch, max: 2);
  } else {
    setPStat(PStat.RollScratch, 3);
  }
  return;
}

section(81) {
  move(entity: Entity.Player, to: (-948, 630), sprint: 0);
  waitForEntity(Entity.Player);
  if (pstat[110] == 0 || pstat[110] == 3) {
    rotate(entity: Entity.Player, to: 2048);
    delay(5);
    rotate3DObject(0, 1);
    delay(20);
    move(entity: Entity.Player, to: (-949, 2483), sprint: 0);
    warp(to: Map.OMOC06, spawn: 0, trigger: 255);
  }
  move(entity: Entity.Partner, to: Entity.Player, sprint: 1);
  waitForEntity(Entity.Partner);
  rotate(entity: Entity.Player, to: 2048);
  rotate(entity: Entity.Partner, to: 2048);
  delay(5);
  sfx(0, 11, wait: 10);
  setObjectVisibility(0, 0);
  setPStat(PStat(247), 0);
  setPStat(PStat(248), 1);
  callSubroutine(21);
  moveObjectTo(0, 0, 1, 8, 0, 78, 40);
  delay(5);
  playAnimation(Entity.Player, Animation(17));
  playAnimation(Entity.Partner, Animation(40));
  playSound(8, 13);
  setObjectVisibility(0, 1);
  moveObjectTo(0, 0, 1, 2, 0, 78, -32);
  setObjectsVisibleRange(3, 7, 0);
  setPStat(PStat(247), 3);
  setPStat(PStat(248), 5);
  callSubroutine(21);
  delay(15);
  setObjectsVisibleRange(3, 7, 1);
  setObjectsVisibleRange(18, 33, 0);
  setPStat(PStat(247), 18);
  setPStat(PStat(248), 16);
  callSubroutine(21);
  setPStat(PStat(200), 10);
  dealMapDamage(PStat(200));
  delay(10);
  setObjectsVisibleRange(18, 33, 1);
  delay(20);
  return;
}

