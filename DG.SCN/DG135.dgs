section(51) {
  move(entity: Entity.Player, to: (-22, -2500), sprint: 0);
  warp(to: Map.OMOC04, spawn: 1, trigger: 255);
  return;
}

section(5) {
  speak(Entity(5), "「さあ、どれがアタリかな?」<NEWLINE>");
  finishEncounter(Trigger(284));
}

section(6) {
  speak(Entity(6), "「ここは通さないぞ~!」<NEWLINE>");
  finishEncounter(Trigger(284));
}

