  move(entity: Entity(10), to: (432, -2236), sprint: 1);
  waitForEntity(Entity(10));
  lookPairAt(Entity(10));
  look(entity: Entity(10), at: Entity.Player);
  delay(5);
  speak(Entity(10), "Alright, I found you, <LIGHTBLUE><PLAYER><WHITE>!\n");
  speak(Entity.Player, "Ambush!\n");
  speak(Entity(10), "My goal is to beat you.\n");
  speak(Entity.Player, "Those eyes! He must be\nbrain washed!\n");
  move(entity: Entity.Partner, to: (50, -1950), sprint: 1);
  waitForEntity(Entity.Partner);
  look(entity: Entity.Partner, at: Entity(10));
  delay(5);
  setTrigger(Trigger(1));
