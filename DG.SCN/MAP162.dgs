section(57) {
  if (!trigger(87) || trigger(205)) goto L1;
  goto L3;

L1:
  if (!trigger(354) || trigger(88)) goto L2;
  goto L6;

L2:
  return;

L3:
  unsetTrigger(87);
  loadAndSetDigimon(Digimon.NPCGreymon, 4, 0);
  look(entity: Entity.Player, at: 9);
  look(entity: Entity.Partner, at: 9);
  rotate(entity: 9, to: 2048);
  delay(20);
  moveCamera(to: 9, speed: 20);
  waitForEntity(200);
  move(entity: 9, to: (256, -3385), sprint: 0);
  speak(9, "I found you!\n");
  moveCamera(to: Entity.Player, speed: 20);
  waitForEntity(200);
  playAnimation(Entity.Player, 15);
  delay(5);
  speak(Entity.Player, "Oh no, he's coming\nright for us!\n");
  move(entity: 9, to: (432, -2236), sprint: 0);
  waitForEntity(9);
  look(entity: 9, at: Entity.Player);
  delay(5);
  speak(9, "I finally met you!\nI'm Greymon.\nNow let's settle things!\n");
  playAnimation(Entity.Player, 1);
  delay(5);
  speak(Entity.Player, "What?!\n");
  speak(9, "I got here by following\nthe rumors about you.\nI want to fight you!\n");
  showTextbox("If I win,\nI want this street sign!\n");
  playAnimation(Entity.Player, 16);
  delay(30);
  speak(Entity.Player, "There's no sign.\n");
  speak(9, "I don't care,\nlet's fight anyway!\n");
  move(entity: Entity.Partner, to: (50, -1950), sprint: 1);
  waitForEntity(Entity.Partner);
  look(entity: Entity.Partner, at: 9);
  delay(5);
  setTrigger(1);
  setPStat(250, 1);
  setPStat(251, 9);
  setPStat(252, 255);
  setPStat(253, 255);
  startBattle();
  unsetTrigger(1);
  setPStat(250, 0);
  look(entity: Entity.Player, at: 9);
  look(entity: 9, at: Entity.Player);
  look(entity: Entity.Partner, at: 9);
  speak(9, "Hey, you guys are good!\nBut to finish your goal,\nyou're still amateurs.\n");
  playAnimation(Entity.Player, 1);
  delay(5);
  speak(Entity.Player, "Hmmm\n");
  speak(9, "I'll stay and train you.\nYou'll get much better!\n");
  goto L4;

L4:
  move(entity: 9, to: (412, -4500), sprint: 1);
  if (pstat[101] >= 3) goto L5;
  addPStat(101, 1);
  delay(20);
  look(entity: Entity.Player, at: 9);
  look(entity: Entity.Partner, at: 9);
  goto L4;

L5:
  waitForEntity(9);
  unloadEntity(9);
  setPStat(101, 0);
  playSound(8, 12);
  speak(Entity.System, "Greymon joins the city!\n");
  setTrigger(87);
  setTrigger(205);
  addPStat(1, 2);
  moveCamera(to: Entity.Player, speed: 20);
  waitForEntity(200);
  return;

L6:
  unsetTrigger(354);
  loadAndSetDigimon(Digimon.NPCAirdramon, 5, 0);
  look(entity: Entity.Player, at: 10);
  look(entity: Entity.Partner, at: 10);
  look(entity: 10, at: Entity.Player);
  delay(20);
  moveCamera(to: 10, speed: 20);
  waitForEntity(200);
  move(entity: 10, to: (2084, -211), animDuration: 30);
  moveCamera(to: Entity.Player, speed: 20);
  delay(20);
  playAnimation(Entity.Player, 17);
  playAnimation(Entity.Partner, 40);
  setPStat(200, 10);
  dealMapDamage(200);
  delay(15);
  move(entity: 10, to: (432, -2236), sprint: 1);
  moveCamera(to: (410, -1474), slowdown: 2);
  waitForEntity(200);
  move(entity: 10, to: (432, -2236), sprint: 1);
  waitForEntity(10);
  look(entity: Entity.Player, at: 10);
  look(entity: Entity.Partner, at: 10);
  look(entity: 10, at: Entity.Player);
  delay(5);
  speak(10, "Alright, I found you, <LIGHTBLUE><PLAYER><WHITE>!\n");
  speak(Entity.Player, "Ambush!\n");
  speak(10, "My goal is to beat you.\n");
  speak(Entity.Player, "Those eyes! He must be\nbrain washed!\n");
  move(entity: Entity.Partner, to: (50, -1950), sprint: 1);
  waitForEntity(Entity.Partner);
  look(entity: Entity.Partner, at: 10);
  delay(5);
  setTrigger(1);
  setPStat(250, 1);
  setPStat(251, 10);
  setPStat(252, 255);
  setPStat(253, 255);
  startBattle();
  unsetTrigger(1);
  setPStat(250, 0);
  look(entity: Entity.Player, at: 10);
  look(entity: 10, at: Entity.Player);
  look(entity: Entity.Partner, at: 10);
  speak(10, "No matter what I do,\nI must defeat him.\n");
  playAnimation(10, 29);
  delay(30);
  playAnimation(Entity.Player, 7);
  delay(5);
  speak(Entity.Player, "What are you talking about?\nYou gotta get treatment.\n");
  move(entity: Entity.Player, to: 10, sprint: 1);
  move(entity: Entity.Partner, to: 10, sprint: 1);
  delay(40);
  for x in [88, 355, 354] {
    setTrigger(x);
  }
  warp(to: Map.ROOM11, spawn: 1, trigger: 60);
  return;
}

