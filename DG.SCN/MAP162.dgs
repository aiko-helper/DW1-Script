section(5) {
  if (trigger(210) || pstat[1] < 40 || trigger(224) || !trigger(175)) goto L1;
  if (trigger(250)) goto L1;
  speak(5, "Have you seen\nthe Lake Guardian?\n");
  showTextbox("If not, you should\nwait on the south side.\n");
  return;

L1:
  if (trigger(250) || pstat[1] < 25 || trigger(224) || !trigger(175)) goto L2;
  speak(5, "Get up very early and\nwalk in the mist.\nSomething good will happen!\n");
  return;

L2:
  if (trigger(224) || !trigger(175)) goto L3;
  speak(5, "Did you know there's\na place in the north\ncalled Iceberg Beach?\n");
  showTextbox("Rumor has it that a huge\nDigimon often appears\nat the beach.\n");
  return;

L3:
  if (trigger(175) || !trigger(198)) goto L4;
  speak(5, "Are the bandits defeated?\nI heard there is a gang\nof bandits.\n");
  return;

L4:
  if (trigger(198) || !trigger(103)) goto L5;
  setTrigger(197);
  speak(5, "Ever been to Great Canyon?\n");
  showTextbox("Rumor has it that\nthe bandits are there.\n");
  speak(Entity.Player, "Are they bad guys?\n");
  speak(5, "They jump you and rob you.\n");
  speak(Entity.Player, "Let's do something about it.\n");
  return;

L5:
  if (pstat[1] < 6) goto L6;
  setTrigger(124);
  speak(5, "Ever been to Great Canyon?\n");
  showTextbox("Rumor has it that there is an\nInvisible Bridge there.\n");
  return;

L6:
  if (!trigger(50) || trigger(202)) goto L7;
  speak(5, "I hear\nMachinedramon is back.\n");
  return;

L7:
  if (!trigger(50) || !trigger(202)) goto L8;
  speak(5, "You beat\nMachinedramon again.\n");
  return;

L8:
  speak(5, "I'll explain the city\nsurroundings to you.\n");
  showTextbox("Native Forest\nsurrounds the city.\n");
  showTextbox("The Digimon around there\naren't too strong.\n");
  showTextbox("To the west there's a\nTraining Camp.\n");
  showTextbox("Tropical Jungle is\neast across the river.\n");
  showTextbox("I don't know\nwhat's beyond that.\n");
  showTextbox("To the west there is a\nmountain and lake.\n");
  showTextbox("Go south and there is an ocean.\n");
  showTextbox("There is a high mountain\nto the north.\n");
  showTextbox("This city is the\ncenter of the island.\n");
  showTextbox("I'll check the rumors.\nCome back and find out more.\n");
  return;
}

