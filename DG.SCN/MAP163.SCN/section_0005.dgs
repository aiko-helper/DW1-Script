// source: extract/DIGIMON/SCN/DG.SCN
// MAP163.SCN, section 5

section section_5(5) {  // len=224
    setTrigger(77);
    setDialogOwner(5);
    showTextbox("Bakke. Bah Kkea.\n");
    setDialogOwner(Entity.Player);
    showTextbox("I still don't understand him.\n");
    storeDigimonType(103);
    if (pstat[103] != 37) goto L_00de;
    look(entity: Entity.Player, at: Entity.Partner);
    delay(5);
    playAnimation(Entity.Partner, 11);
    delay(10);
    look(entity: Entity.Player, at: Entity.Partner);
    delay(5);
    setDialogOwner(Entity.Player);
    showTextbox("I see. You're\npatrolling for us?!\n");
L_00de:
    return;
}
