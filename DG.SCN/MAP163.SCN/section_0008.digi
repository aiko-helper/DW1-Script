  00e0:  if pstat[1] > 30 then section_8+0x228
  00ec:  setDialogOwner 8
  00ee:  showTextbox "Oh, I happened to pick up a\n<LIGHTBLUE>Happy Mushroom <WHITE>\nthe other day.\n"
  016c:  showTextbox "I hear it's a rare kind.\n"
  01a2:  setDialogOwner 8
  01a4:  showTextbox "I also heard about a\n<LIGHTBLUE>Deluxe Mushroom<WHITE>.\nIt'll be nice to find.\n"
  0226:  endSection
