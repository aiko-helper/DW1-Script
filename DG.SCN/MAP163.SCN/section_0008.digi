  0000:  if trigger(79) then section_8+0xe0
  000c:  setTrigger 79
  0010:  speak 8 "Mmmm. I saw some delicious\nplants, so I decided to eat.\n"
  0086:  showTextbox "I guess it became\ntoo breezy in the city.\n"
  00de:  endSection
  00e0:  if pstat[1] > 30 then section_8+0x228
  00ec:  speak 8 "Oh, I happened to pick up a\n<LIGHTBLUE>Happy Mushroom <WHITE>\nthe other day.\n"
  016c:  showTextbox "I hear it's a rare kind.\n"
  01a2:  speak 8 "I also heard about a\n<LIGHTBLUE>Deluxe Mushroom<WHITE>.\nIt'll be nice to find.\n"
  0226:  endSection
