section section_8(8) {  // len=1764
    if (trigger(79)) goto L_00e0;
    setTrigger(79);
    setDialogOwner(8);
    showTextbox("Mmmm. I saw some delicious\nplants, so I decided to eat.\n");
    showTextbox("I guess it became\ntoo breezy in the city.\n");
    return;
L_00e0:
    if (pstat[1] > 30) goto L_0228;
    setDialogOwner(8);
    showTextbox("Oh, I happened to pick up a\n<LIGHTBLUE>Happy Mushroom <WHITE>\nthe other day.\n");
    showTextbox("I hear it's a rare kind.\n");
    setDialogOwner(8);
    showTextbox("I also heard about a\n<LIGHTBLUE>Deluxe Mushroom<WHITE>.\nIt'll be nice to find.\n");
    return;
L_0228:
    switch (pstat[37]) { case 0: goto L_023c; case 1: goto L_02ae; case 2: goto L_032a; case 3: goto L_0396; case 4: goto L_0400; case 5: goto L_046e; case 6: goto L_04d8; case 7: goto L_054c; };
