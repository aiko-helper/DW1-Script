section section_6(6) {  // len=432
    if (trigger(78)) goto L_0176;
    setTrigger(78);
    setDialogOwner(6);
    showTextbox("Look! It's my special\nbulletin board.\n");
    setDialogOwner(6);
    showTextbox("We need information for the\ncity, so I decided to make a\nnewspaper! What do you think?\n");
    setDialogOwner(6);
    showTextbox("You can count on me to\ncollect information.\n");
    return;
L_0176:
    setDialogOwner(6);
    showTextbox("You're reading my paper.\n");
    return;
}
