// source: extract/DIGIMON/SCN/DG.SCN
// MAP163.SCN, section 10

section section_10(10) {  // len=384
    if (trigger(80)) goto L_00e0;
    setTrigger(80);
    setDialogOwner(10);
    showTextbox("What do you think? I turned\non the light. Bright enough?\n");
    setDialogOwner(10);
    showTextbox("Let's make our city\nclean and cheerful!\n");
    return;
L_00e0:
    setDialogOwner(10);
    showTextbox("Does the light make\na difference?\n");
    setDialogOwner(10);
    showTextbox("Well, it all depends on\nhow you think.\n");
    return;
}
