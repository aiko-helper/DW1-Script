section section_7(7) {  // len=810
    if (!trigger(231) && !trigger(245) && !trigger(233) && !trigger(247)) goto L_00ae;
    setDialogOwner(7);
    showTextbox("Ah, it's cool and feels good.\n");
    showTextbox("When you're comfortable\nit feels good.\n");
    return;
L_00ae:
    if (!trigger(204) || trigger(52) || trigger(249)) goto L_01d0;
    setTrigger(52);
    setDialogOwner(7);
    showTextbox("What do you think of my shop?\n");
    showTextbox("I'm not good at sales, but\nthere isn't anybody else\nto do it now.\n");
    showTextbox("Bring many Digimon here, OK?\n");
    return;
L_01d0:
    if (!trigger(204) || !trigger(249) || trigger(95)) goto L_02ba;
    setTrigger(95);
    setDialogOwner(7);
    showTextbox("Well, what do you think?\n");
    setDialogOwner(Entity.System);
    showTextbox("<YELLOW>Coelamon <WHITE>\nWe have decided to help each\nother and sell all these items.\n");
    return;
L_02ba:
    if (!trigger(204) || !trigger(249)) goto L_0306;
    setTrigger(384);
    setTrigger(385);
    setTrigger(388);
    setTrigger(392);
    setTrigger(406);
    setTrigger(422);
    unsetTrigger(3);
    setPStat(254, 7);
    callSubroutine(8);
    unsetTrigger(384);
    unsetTrigger(385);
    unsetTrigger(388);
    unsetTrigger(392);
    unsetTrigger(406);
    unsetTrigger(422);
    return;
L_0306:
    setTrigger(384);
    setTrigger(388);
    setTrigger(422);
    unsetTrigger(3);
    setPStat(254, 7);
    callSubroutine(8);
    unsetTrigger(384);
    unsetTrigger(388);
    unsetTrigger(422);
    return;
}
