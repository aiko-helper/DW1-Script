section_9(9):     ; len=1504
  0000:  if pstat[1] < 20 OR !trigger(185) then section_9+0x7a
  0010:  speak 9 "I got something to say.\n"
  0046:  setDialogOwner Player
  0048:  setSelection section_9+0x4a4 section_9+0x5c8
  004e:  showTextbox "What is it?\nLaters!\n"
  007a:  if !trigger(185) then section_9+0x100
  0086:  speak 9 "Did you see the Eastern\nBridge fixed?\nWe worked so hard.\n"
  00fe:  endSection
  0100:  if pstat[1] < 2 OR trigger(185) then section_9+0x276
  0110:  speak 9 "We're fixing Digital Bridge\nnow. Please wait a while.\n"
  0182:  showTextbox "I hear there's a rare Digimon\nat Coela Point in the south.\n"
  01fc:  showTextbox "Rumor has it is that he shows\nup late afternoon everyday.\n"
  0274:  endSection
  0276:  speak 9 "Say, did you know there's\na broken bridge in\nthe east part of the city?\n"
  030c:  showTextbox "We didn't think anyone\nwould ever use it, so we\ndidn't do anything about it.\n"
  03aa:  showTextbox "We're thinking about\nfixing it on our own.\n"
  0404:  showTextbox "Until then, go check the\nwest and south sections.\nThen come back and see me.\n"
  04a2:  endSection
  04a4:  if pstat[1] < 25 then section_9+0x536
  04b0:  speak 9 "Did you go to Geko Swamp?\nA mischievous\nDigimon may trick you.\n"
  0534:  endSection
  0536:  speak 9 "Once a Digimon digivolves,\nremember, his Technique\nSets will change.\n"
  05c6:  endSection
  05c8:  speak 9 "Well...\n"
  05de:  endSection
