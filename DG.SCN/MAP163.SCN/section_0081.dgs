// source: extract/DIGIMON/SCN/DG.SCN
// MAP163.SCN, section 81

section section_81(81) {  // len=1148
    rotate(entity: Entity.Player, to: 1024);
    playSound(0, 0);
    delay(5);
    setTextboxOrigin(-628, 0, 2226);
    if (!trigger(249) || trigger(52) || trigger(204)) goto L_01fa;
    setTrigger(52);
    setDialogOwner(203);
    showTextbox("Welcome to my shop!\nI'll give you a great price\n<LIGHTBLUE><PLAYER><WHITE>.\n");
    showTextbox("I'm not good at sales,\nbut neither is anyone else.\n");
    showTextbox("I'm in charge of sales now.\nI hope we can do business.\n");
    showTextbox("<LIGHTBLUE><PLAYER><WHITE>, please bring\nas many Digimon back\nwith you as you can.\n");
    return;
    playSound(0, 1);
L_01fa:
    if (!trigger(204) || trigger(52) || trigger(249)) goto L_031c;
    setTrigger(52);
    setDialogOwner(202);
    showTextbox("What do you think\nof my shop?\n");
    showTextbox("I'm not good at sales,\nbut no one else is,\nso I must do it.\n");
    showTextbox("Bring back lots\nof Digimon soon.\n");
    playSound(0, 1);
    return;
L_031c:
    if (!trigger(204) || !trigger(249) || trigger(95)) goto L_03f8;
    setTrigger(95);
    setDialogOwner(202);
    showTextbox("Well, what do you think?\n");
    setDialogOwner(Entity.System);
    showTextbox("<YELLOW>Coelamon <WHITE>\nWe decided to help each\nother and sell these items.\n");
    playSound(0, 1);
    return;
L_03f8:
    if (!trigger(204) || !trigger(249)) goto L_0444;
    setTrigger(384);
    setTrigger(385);
    setTrigger(388);
    setTrigger(392);
    setTrigger(406);
    setTrigger(422);
    unsetTrigger(3);
    setPStat(254, 255);
    callSubroutine(8);
    unsetTrigger(384);
    unsetTrigger(385);
    unsetTrigger(388);
    unsetTrigger(392);
    unsetTrigger(406);
    unsetTrigger(422);
    return;
L_0444:
    setTrigger(384);
    setTrigger(388);
    setTrigger(422);
    unsetTrigger(3);
    if (!trigger(249)) goto L_0468;
    setPStat(254, 255);
    goto L_046c;
L_0468:
    setPStat(254, 7);
L_046c:
    callSubroutine(8);
    unsetTrigger(384);
    unsetTrigger(388);
    unsetTrigger(422);
    return;
}
