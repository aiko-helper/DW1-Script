section_81(81):     ; len=1148
  0000:  setRotation Player 1024
  0004:  playSound 0 0
  0008:  delay 5
  000c:  setTextboxOrigin -628 0 2226
  0014:  if !trigger(249) OR trigger(52) OR trigger(204) then section_81+0x1fa
  0028:  setTrigger 52
  002c:  speak 203 "Welcome to my shop!\nI'll give you a great price\n<LIGHTBLUE><PLAYER><WHITE>.\n"
  009c:  showTextbox "I'm not good at sales,\nbut neither is anyone else.\n"
  0106:  showTextbox "I'm in charge of sales now.\nI hope we can do business.\n"
  0178:  showTextbox "<LIGHTBLUE><PLAYER><WHITE>, please bring\nas many Digimon back\nwith you as you can.\n"
  01f4:  endSection
  01f6:  playSound 0 1
  01fa:  if !trigger(204) OR trigger(52) OR trigger(249) then section_81+0x31c
  020e:  setTrigger 52
  0212:  speak 202 "What do you think\nof my shop?\n"
  0254:  showTextbox "I'm not good at sales,\nbut no one else is,\nso I must do it.\n"
  02d0:  showTextbox "Bring back lots\nof Digimon soon.\n"
  0316:  playSound 0 1
  031a:  endSection
  031c:  if !trigger(204) OR !trigger(249) OR trigger(95) then section_81+0x3f8
  0330:  setTrigger 95
  0334:  speak 202 "Well, what do you think?\n"
  036c:  speak System "<YELLOW>Coelamon <WHITE>\nWe decided to help each\nother and sell these items.\n"
  03f2:  playSound 0 1
  03f6:  endSection
  03f8:  if !trigger(204) OR !trigger(249) then section_81+0x444
  0408:  setTrigger 384
  040c:  setTrigger 385
  0410:  setTrigger 388
  0414:  setTrigger 392
  0418:  setTrigger 406
  041c:  setTrigger 422
