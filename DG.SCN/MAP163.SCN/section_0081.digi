  042e:  unsetTrigger 385
  0432:  unsetTrigger 388
  0436:  unsetTrigger 392
  043a:  unsetTrigger 406
  043e:  unsetTrigger 422
  0442:  endSection
  0444:  setTrigger 384
  0448:  setTrigger 388
  044c:  setTrigger 422
