    if (!trigger(209) || trigger(58) || pstat[27] != 0) goto L_0150;
    setDialogOwner(5);
    showTextbox("Welcome to my restaurant.\n");
    showTextbox("I've decided to be a manager\nand chef of this restaurant.\n");
    showTextbox("Enjoy my flaming cuisine\nas much as you like.\n");
    setTrigger(58);
    return;
L_0150:
    if (!trigger(208) || trigger(61) || pstat[27] != 1) goto L_024c;
    setDialogOwner(5);
    showTextbox("<LIGHTBLUE><PLAYER><WHITE>, <ORANGE><DIGIMON><WHITE>, won't\nyou try my home cooking?\n");
    showTextbox("Unlike Items you get, this\nis true cooking. It's my\nsecret talent.\n");
    setTrigger(61);
    return;
