    if (!trigger(222) || trigger(60) || pstat[27] != 2) goto L_0352;
    setDialogOwner(5);
    showTextbox("<LIGHTBLUE><PLAYER><WHITE>, <ORANGE><DIGIMON><WHITE>!\nI decided to make a living\nwith cooking. I'm good!\n");
    showTextbox("You should relax and eat at\nmy restaurant sometime.\n");
    setTrigger(60);
    return;
