; DG086.SCN
;!script index=86 start=0x3d800 end=0x3e000 headerU16=0x1c sentinelOff=0x24
;!sections onEnter section_5 section_6 section_7 section_8 section_51

onEnter:     ; len=68
  0000:  storeRandom 110 99
  0004:  if pstat[110] > 16 then onEnter+0x16
  0010:  spawnItem Digimushroom 63 56
  0016:  storeRandom 110 99
  001a:  if pstat[110] > 7 then onEnter+0x2c
  0026:  spawnItem Digimushroom 61 88
  002c:  storeRandom 110 99
  0030:  if pstat[110] > 3 then onEnter+0x42
  003c:  spawnItem IceMushroom 73 88
  0042:  endSection
