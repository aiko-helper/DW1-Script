// DG059.SCN
#include "functions.dgs"
#pragma script index=59 start=0x29800 end=0x2a000 headerU16=0x10 sentinelOff=0x19
#include "entities.dgs"

section onEnter(254) {
  if (trigger(131)) {
    setObjectVisibility(4, 1);
  }
  return;
}

section(81) {
  if (!trigger(131)) {
    rotate(entity: Entity.Player, to: 91);
    delay(10);
    speak(Entity.Player, "「何だろう?読めそうな本は…と…」<NEWLINE>");
    rotate(entity: Entity.Player, to: 3675);
    delay(10);
    rotate(entity: Entity.Player, to: 91);
    delay(10);
    rotate(entity: Entity.Player, to: 603);
    delay(10);
    rotate(entity: Entity.Player, to: 1115);
    delay(10);
    rotate(entity: Entity.Player, to: 1627);
    delay(10);
    rotate(entity: Entity.Player, to: 1115);
    delay(10);
    speak(Entity.Player, "「だめだ。全然無いや。」<NEWLINE>");
    showTextbox("「ん、でも一冊だけゴーカな表紙の本が<NEWLINE> あるぞ!」<NEWLINE>");
    setSelection(L1, L2);
    showTextbox("「取ってみよう。」<NEWLINE>「怪しいよ…やめておこう。」<NEWLINE>");
    waitForSelectionChoice();
    goto L2;

L1:
    move(entity: Entity.Player, to: (-314, -603), sprint: 0);
    move(entity: Entity.Partner, to: (-298, -335), sprint: 0);
    waitForPair();
    rotate(entity: Entity.Player, to: 1115);
    rotate(entity: Entity.Partner, to: 91);
    speak(Entity.System, "ゴーカな本にふれた。<NEWLINE>");
    speak(Entity.Player, "「ん?」<NEWLINE>");
    playSound(8, 4);
    setObjectVisibility(3, 1);
    setObjectVisibility(4, 0);
    setTrigger(Trigger(131));
    playAnimation(Entity.Player, Animation(26));
    move(entity: Entity.Player, to: (655, -663), animDuration: 4);
    move(entity: Entity.Partner, to: (694, -377), animDuration: 4);
    playSound(8, 5);
    speak(Entity.Player, "「んわぁぁぁーーーっ!?」<NEWLINE>");
    warp(to: Map.YAKA15, spawn: 4, trigger: 53);
    return;

L2:
    speak(Entity.Player, "「何かのワナかもしれないし…やめよ。」<NEWLINE>");
  }
  return;
}

section(82) {
  rotate3DObject(0, 1);
  sfx(8, 1, wait: 10);
  move(entity: Entity.Player, to: (-1500, 615), sprint: 0);
  warp(to: Map.YAKA11B, spawn: 1, trigger: 255);
  return;
