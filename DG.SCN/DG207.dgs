// DG207.SCN
#include "functions.dgs"
#pragma script index=207 start=0xa9800 end=0xab800 headerU16=0xc sentinelOff=0xfe
#include "entities.dgs"

section onEnter(254) {
  return;
}

section(11) {
  if (trigger(225)) {
    goto L13;
  }
  if (trigger(246)) {
    goto L6;
  }
  if (trigger(74)) {
    goto L1;
  }
  setTrigger(74);
  speak(11, "Hi, do you need any Meat?\n");
  showTextbox("Oh, I haven't told you\nanything about this.\n");
  showTextbox("This is a Meat farm.\nWe grow Meat for everyone.\n");
  speak(Entity.Player, "You grow Meat on a farm?\n");
  speak(11, "Yeah, why?\n");
  speak(Entity.Player, "Well... nothing\n");
  speak(11, "Jiji and I've decided to\ngive you three pieces of\nMeat daily, <LIGHTBLUE><PLAYER><WHITE>.\n");
  showTextbox("Here's your Meat for today.\n");
  if (item[Item.Meat] >= 99) {
    speak(11, "You got too much Meat.\nYou don't need any today.\n");
    setPStat(31, 1);
    return;
  }
  if (item[Item.Meat] >= 97) {
    speak(11, "You got too much Meat. I'll\ntake what you can't hold.\n");
    giveItem(Item.Meat, 3);
    speak(Entity.System, "I got three pieces\nof <LIGHTBLUE>Meat<WHITE>!\n");
    setTrigger(74);
    setPStat(31, 0);
    return;
  }
  giveItem(Item.Meat, 3);
  if (trigger(0)) {
    speak(11, "You got too many Items.\n");
    return;
  }
  speak(Entity.System, "I got three pieces of\n<LIGHTBLUE>Meat<WHITE>!\n");
  setPStat(31, 0);
  return;

L1:
  roll(pstat: 110, max: 9);
  if (pstat[31] >= 1 && pstat[110] <= 0) {
    speak(11, "We harvested a lot of Meat\ntoday! We'll give you\nfive pieces.\n");
    goto L2;
  }
  goto L3;

L2:
  if (item[Item.Meat] >= 99) {
    speak(11, "You got too much Meat.\n");
    return;
  }
  if (item[Item.Meat] >= 95) {
    speak(11, "You got too much Meat. I'll\ntake what you can't hold.\n");
    giveItem(Item.Meat, 5);
    speak(Entity.System, "I got a five pieces of\n<LIGHTBLUE>Meat<WHITE>!\n");
    setTrigger(74);
    setPStat(31, 0);
    return;
  }
  giveItem(Item.Meat, 5);
  if (trigger(0)) {
    speak(11, "You got too many Items.\n");
    return;
  }
  speak(Entity.System, "I got five pieces of\n<LIGHTBLUE>Meat<WHITE>!\n");
  speak(11, "You'll get more tomorrow.\n");
  setPStat(31, 0);
  return;

L3:
  if (pstat[31] >= 1) {
    speak(11, "Here's today's Meat.\n");
    goto L4;
  }
  goto L5;

L4:
  if (item[Item.Meat] >= 99) {
    speak(11, "You got too much Meat.\n");
    return;
  }
  if (item[Item.Meat] >= 97) {
    speak(11, "You got too much Meat. I'll\ntake what you can't hold.\n");
    giveItem(Item.Meat, 3);
    speak(Entity.System, "I got <LIGHTBLUE>Meat<WHITE>!\n");
    setTrigger(74);
    setPStat(31, 0);
    return;
  }
  giveItem(Item.Meat, 3);
  if (trigger(0)) {
    speak(11, "You got too many Items.\n");
    return;
  }
  speak(Entity.System, "I got <LIGHTBLUE>Meat<WHITE>!\n");
  speak(11, "I'll give you more tomorrow.\n");
  setPStat(31, 0);
  return;

L5:
  speak(11, "I thought I gave you\ntoday's Meat.\n");
  showTextbox("If you run out of food,\ngo to Native Forest and\nfind mushrooms.\n");
  return;

L6:
  if (!trigger(82)) {
    setTrigger(82);
    speak(11, "Hi, <LIGHTBLUE><PLAYER><WHITE>, I expanded\nmy Meat farm.\n");
    showTextbox("I'll give you three pieces\nof Giant Meat a day.\n");
    showTextbox("If you want extra,\nI'll sell it to you for\nfive hund bits each.\n");
    showTextbox("I'll be in charge of\nthis farm for Tanemon.\nHe's resting somewhere.\n");
  }
  roll(pstat: 110, max: 9);
  if (pstat[31] >= 1 && pstat[110] <= 0) {
    speak(11, "I harvested a lot of\nMeat today!\n");
    goto L7;
  }
  goto L8;

L7:
  if (item[Item.GiantMeat] >= 99) {
    speak(11, "You got too much Giant Meat.\nYou don't need any today.\n");
    return;
  }
  if (item[Item.GiantMeat] >= 95) {
    speak(11, "You got too much Giant Meat.\nYou don't need any today.\n");
    giveItem(Item.GiantMeat, 5);
    speak(Entity.System, "I got <LIGHTBLUE>Giant Meat<WHITE>!\n");
    setTrigger(74);
    setPStat(31, 0);
    return;
  }
  giveItem(Item.GiantMeat, 5);
  if (trigger(0)) {
    showTextbox("You got too many Items.\n");
    return;
  }
  speak(Entity.System, "I got five pieces of\n<LIGHTBLUE>Giant Meat<WHITE>!\n");
  speak(11, "I'll give you more tomorrow.\n");
  setPStat(31, 0);
  return;

L8:
  if (pstat[31] >= 1) {
    speak(11, "Here's three pieces of\nGiant Meat for today.\n");
    goto L9;
  }
  goto L10;

L9:
  if (item[Item.GiantMeat] >= 99) {
    speak(11, "You got too much Giant Meat.\nYou don't need any today\n");
    return;
  }
  if (item[Item.GiantMeat] >= 97) {
    speak(11, "You got too much\nGiant Meat. I'll take\nwhat you can't hold.\n");
    giveItem(Item.GiantMeat, 3);
    speak(Entity.System, "I got <LIGHTBLUE>Giant Meat<WHITE>!\n");
    setTrigger(74);
    setPStat(31, 0);
    return;
  }
  giveItem(Item.GiantMeat, 3);
  if (trigger(0)) {
    showTextbox("You got too many Items.\n");
    return;
  }
  speak(Entity.System, "I got three pieces of\n<LIGHTBLUE>Giant Meat<WHITE>!\n");
  setPStat(31, 0);
  return;

L10:
  speak(11, "I'll give you more tomorrow.\nOr you can buy more now.\nFive hund bits each?\n");
  setDialogOwner(Entity.Player);
  choice { "Buy" -> L11, "Don't buy" -> L12 }
  goto L12;

L11:
  if (money < 500) {
    speak(11, "You need more money.\n");
    return;
  }
  giveItem(Item.GiantMeat, 1);
  if (trigger(0)) {
    showTextbox("You've got too many Items.\n");
    return;
  }
  reduceMoney(500);
  sfx(0, 5, wait: 5);
  speak(11, "Do you want to buy more?\n");
  setDialogOwner(Entity.Player);
  choice { "Buy" -> L11, "Don't buy" -> L12 }
  goto L12;

L12:
  speak(11, "See you tomorrow.\n");
  return;

L13:
  if (!trigger(186)) {
    setTrigger(186);
    speak(11, "Heh, heh, heh!\n<LIGHTBLUE><PLAYER><WHITE>, look!\n");
    moveCamera(to: (-2243, 1914), slowdown: 30);
    waitForEntity(200);
    delay(20);
    moveCamera(to: Entity.Player, speed: 20);
    waitForEntity(200);
    speak(11, "We can grow lots of\nSirloin. I'll give you\nthree Sirloins a day.\n");
    showTextbox("I also started to\ngrow rare veggies!\nBuy as many as you want!\n");
  }
  roll(pstat: 110, max: 9);
  if (pstat[31] >= 1 && pstat[110] <= 0) {
    speak(11, "I feel good today,\nso I'll give you five pieces\nof Sirloin.\n");
    goto L14;
  }
  goto L15;

L14:
  if (item[Item.Sirloin] >= 99) {
    speak(11, "You got too much Sirloin.\nYou don't need any today\n");
    return;
  }
  if (item[Item.Sirloin] >= 95) {
    speak(11, "You got too much Sirloin.\n");
    giveItem(Item.Sirloin, 5);
    speak(Entity.System, "I got <LIGHTBLUE>Sirloin<WHITE>!\n");
    setTrigger(74);
    setPStat(31, 0);
    return;
  }
  giveItem(Item.Sirloin, 5);
  if (trigger(0)) {
    showTextbox("You got too many Items.\n");
    return;
  }
  speak(Entity.System, "I got five pieces of\n<LIGHTBLUE>Sirloin<WHITE>!\n");
  speak(11, "See you tomorrow!\n");
  setPStat(31, 0);
  return;

L15:
  if (pstat[31] >= 1) {
    speak(11, "Here's today's portion of\nSirloin times three!\n");
    goto L16;
  }
  goto L17;

L16:
  if (item[Item.Sirloin] >= 99) {
    speak(11, "You got too much Sirloin.\nYou don't need any today.\n");
    return;
  }
  if (item[Item.Sirloin] >= 97) {
    speak(11, "You got too much Sirloin.\n");
    giveItem(Item.Sirloin, 3);
    speak(Entity.System, "I got <LIGHTBLUE>Sirloin<WHITE>!\n");
    setTrigger(74);
    setPStat(31, 0);
    return;
  }
  giveItem(Item.Sirloin, 3);
  if (trigger(0)) {
    speak(11, "You got too many Items.\n");
    return;
  }
  speak(Entity.System, "I got three pieces of\n<LIGHTBLUE>Sirloin<WHITE>!\n");
  setPStat(31, 0);
  return;

L17:
  speak(11, "It's not tomorrow yet!\nDo you want to buy veggies?\n");
  setDialogOwner(Entity.Player);
  choice { "Buy" -> L18, "Don't buy" -> L22 }
  goto L22;

L18:
  setDialogOwner(Entity.Player);
  choice { "Super Carrot: five hund bits" -> L19, "Hawk Radish: five hund bits" -> L20, "Don't buy" -> L22 }
  goto L22;

L19:
  if (money < 500) {
    speak(11, "You don't got enough money.\n");
    return;
  }
  giveItem(Item.Supercarrot, 1);
  if (trigger(0)) {
    showTextbox("You got too many Items!\n");
    return;
  }
  goto L21;

L20:
  if (money < 500) {
    speak(11, "You don't got enough money.\n");
    return;
  }
  giveItem(Item.HawkRadish, 1);
  if (trigger(0)) {
    showTextbox("You got too many Items!\n");
    return;
  }
  goto L21;

L21:
  reduceMoney(500);
  sfx(0, 5, wait: 5);
  speak(11, "Do you want to buy more?\n");
  setDialogOwner(Entity.Player);
  choice { "Buy" -> L18, "Don't buy" -> L22 }
  goto L22;

L22:
  speak(11, "See ya!\n");
  return;
