// DG071.SCN
#include "functions.dgs"
#pragma script index=71 start=0x33000 end=0x33800 headerU16=0x28 sentinelOff=0x24
#include "entities.dgs"

section onEnter(254) {
  spawnItemChance(110, max: 99, chance: 11, item: Item.Digimushroom, x: 68, y: 50);
  spawnItemChance(110, max: 99, chance: 17, item: Item.Digimushroom, x: 46, y: 29);
  spawnItemChance(110, max: 99, chance: 3, item: Item.SweetNut, x: 46, y: 73);
  spawnItemChance(110, max: 99, chance: 0, item: Item.ChainMelon, x: 57, y: 83);
  return;
}

section(5) {
  speak(5, "Well, I see your point.\n");
  finishEncounter(282);
}

section(6) {
  speak(6, "Can you see its beauty?\n");
  finishEncounter(282);
}

section(7) {
  speak(7, "Uggghhhh!!\n");
  finishEncounter(295);
}

section(8) {
  speak(8, "I'm desperate now!\n");
  finishEncounter(296);
}

section(9) {
  speak(9, "Shoooot! Awh heck.\n");
  finishEncounter(296);
}

section(10) {
  speak(10, "I have a tummy ache.\n");
  finishEncounter(297);
}

section(81) {
  speak(Entity.System, "Vending Machine\n");
  rotate(entity: Entity.Player, to: 1536);
  speak(Entity.Player, "A vending machine with\nspecial prizes.\nShould I buy something?\n");
  choice { "Small Recovery:two hund bits" -> L1, "Portable potty:five hund bits" -> L2, "Don't buy" -> L3 }
  goto L3;
  return;

L1:
  if (money >= 200) {
    goto L4;
    goto L2;
  }
  speak(Entity.Player, "I don't got enough bits.\n");
  return;

L2:
  if (money >= 500) {
    goto L5;
    goto L3;
  }
  speak(Entity.Player, "I don't got enough bits.\n");
  return;

L3:
  return;

L4:
  giveItem(Item.SmallRecovery, 1);
  if (trigger(0)) {
    speak(Entity.Player, "I got too many Items.\n");
    return;
  }
  speak(Entity.System, "A <LIGHTBLUE>Small Recovery\nFloppy<WHITE>came out!\n");
  reduceMoney(200);
  roll(pstat: 102, max: 99);
  if (pstat[102] < 9) {
    goto L6;
  }
  return;

L5:
  giveItem(Item.PortaPotty, 1);
  if (trigger(0)) {
    speak(Entity.Player, "I got too many Items.\n");
    return;
  }
  speak(Entity.System, "A <LIGHTBLUE>Portable Potty <WHITE>\ncame out!\n");
  reduceMoney(500);
  roll(pstat: 102, max: 99);
  if (pstat[102] < 9) {
    goto L6;
  }
  return;

L6:
  speak(Entity.Player, "Alright, I won!\n");
  speak(Entity.System, "A <LIGHTBLUE>Double Floppy <WHITE>\ncame out!\n");
  giveItem(Item.DoubleFloppy, 1);
  if (trigger(0)) {
    setTrigger(3);
    speak(Entity.Player, "I got too many Items.\n");
    callSubroutine(0);
    callSubroutine(13);
    giveItem(Item.SuperSpeedDisk, 1);
  }
  return;
}

section(82) {
  speak(Entity.System, "MP Stand\n");
  rotate(entity: Entity.Player, to: 2048);
  speak(Entity.Player, "Can this machine recover MP?\n");
  choice { "Hund MP: two hund bits" -> L1, "Thous MP:eighteen hund bits" -> L2, "Don't use" -> L3 }
  goto L3;
  return;

L1:
  if (money >= 200) {
    addStats(currentMP: 100);
    reduceMoney(200);
    speak(Entity.System, "Our MP level has recovered!\n");
  } else {
    speak(Entity.Player, "I don't got enough bits.\n");
    return;
  }
  return;

L2:
  if (money >= 1800) {
    addStats(currentMP: 1000);
    reduceMoney(1800);
    speak(Entity.System, "Our MP level has recovered!\n");
  } else {
    speak(Entity.Player, "I don't got enough bits.\n");
    return;
  }
  return;

L3:
  return;
  garbage { 28 00 fe 00 28 00 }
}
