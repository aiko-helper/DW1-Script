// DG071.SCN
#pragma script index=71 start=0x33000 end=0x33800 headerU16=0x28 sentinelOff=0x24

section onEnter(254) {  // len=90
    roll(pstat: 110, max: 99);
    if (pstat[110] > 11) goto L_0016;
    spawnItem(Item.Digimushroom, 68, 50);
L_0016:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 17) goto L_002c;
    spawnItem(Item.Digimushroom, 46, 29);
L_002c:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 3) goto L_0042;
    spawnItem(Item.SweetNut, 46, 73);
L_0042:
    roll(pstat: 110, max: 99);
    if (pstat[110] > 0) goto L_0058;
    spawnItem(Item.ChainMelon, 57, 83);
L_0058:
    return;
}

