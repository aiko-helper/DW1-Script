section(81) {  // len=1014
    setDialogOwner(Entity.System);
    showTextbox("Vending Machine\n");
    rotate(entity: Entity.Player, to: 1536);
    setDialogOwner(Entity.Player);
    showTextbox("A vending machine with\nspecial prizes.\nShould I buy something?\n");
    setSelection(L1, L3, L5);
    showTextbox("Small Recovery:two hund bits\nPortable potty:five hund bits\nDon't buy\n");
    waitForSelectionChoice();
    goto L5;
    return;

L1:
    if (money < 200) goto L2;
    goto L6;
    goto L3;

L2:
    setDialogOwner(Entity.Player);
    showTextbox("I don't got enough bits.\n");
    return;

L3:
    if (money < 500) goto L4;
    goto L9;
    goto L5;

L4:
    setDialogOwner(Entity.Player);
    showTextbox("I don't got enough bits.\n");
    return;

L5:
    return;

L6:
    giveItem(Item.SmallRecovery, 1);
    if (!trigger(0)) goto L7;
    setDialogOwner(Entity.Player);
    showTextbox("I got too many Items.\n");
    return;

L7:
    setDialogOwner(Entity.System);
    showTextbox("A <LIGHTBLUE>Small Recovery\nFloppy<WHITE>came out!\n");
    reduceMoney(200);
    roll(pstat: 102, max: 99);
    if (pstat[102] >= 9) goto L8;
    goto L12;

L8:
    return;

L9:
    giveItem(Item.PortaPotty, 1);
    if (!trigger(0)) goto L10;
    setDialogOwner(Entity.Player);
    showTextbox("I got too many Items.\n");
    return;

L10:
    setDialogOwner(Entity.System);
    showTextbox("A <LIGHTBLUE>Portable Potty <WHITE>\ncame out!\n");
    reduceMoney(500);
    roll(pstat: 102, max: 99);
    if (pstat[102] >= 9) goto L11;
    goto L12;

L11:
    return;

L12:
    setDialogOwner(Entity.Player);
    showTextbox("Alright, I won!\n");
    setDialogOwner(Entity.System);
    showTextbox("A <LIGHTBLUE>Double Floppy <WHITE>\ncame out!\n");
    giveItem(Item.DoubleFloppy, 1);
    if (!trigger(0)) goto L13;
    setTrigger(3);
    setDialogOwner(Entity.Player);
    showTextbox("I got too many Items.\n");
    callSubroutine(0);
    callSubroutine(13);
    giveItem(Item.SuperSpeedDisk, 1);

L13:
    return;
}

section(82) {  // len=548
    setDialogOwner(Entity.System);
    showTextbox("MP Stand\n");
    rotate(entity: Entity.Player, to: 2048);
    setDialogOwner(Entity.Player);
    showTextbox("Can this machine recover MP?\n");
    setSelection(L1, L4, L7);
    showTextbox("Hund MP: two hund bits\nThous MP:eighteen hund bits\nDon't use\n");
    waitForSelectionChoice();
    goto L7;
    return;

L1:
    if (money < 200) goto L2;
    addStats(Stat.CurrentMP, 100);
    reduceMoney(200);
    setDialogOwner(Entity.System);
    showTextbox("Our MP level has recovered!\n");
    goto L3;

L2:
    setDialogOwner(Entity.Player);
    showTextbox("I don't got enough bits.\n");
    return;

L3:
    return;

L4:
    if (money < 1800) goto L5;
    addStats(Stat.CurrentMP, 1000);
    reduceMoney(1800);
    setDialogOwner(Entity.System);
    showTextbox("Our MP level has recovered!\n");
    goto L6;

L5:
    setDialogOwner(Entity.Player);
    showTextbox("I don't got enough bits.\n");
    return;

L6:
    return;

L7:
    return;
    garbage { 28 00 fe 00 28 00 }
}
