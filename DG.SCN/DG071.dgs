#include "functions.dgs"
#pragma script index=71 start=0x30800 end=0x31000 headerU16=0x20 sentinelOff=0x24
#include "entities.dgs"

section onEnter(254) {
  spawnItemChance(max: 99, chance: 14, item: Item.Digimushroom, x: 27, y: 77);
  spawnItemChance(max: 99, chance: 10, item: Item.Digimushroom, x: 62, y: 58);
  return;
}

section(5) {
  speak(Entity(5), "「ムダムダムダーーーッ!」<NEWLINE>");
  finishEncounter(Trigger(275));
}

section(6) {
  speak(Entity(6), "「くわせろ!」<NEWLINE>");
  finishEncounter(Trigger(297));
}

section(7) {
