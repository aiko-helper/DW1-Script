section(1246) {
  unsetTrigger(1);
  setTrigger(41);
  if (stat[Stat.Lives] == 0 && stat[Stat.CurrentHP] == 0) {
    runDigimonRoutine(73, 7);
    return;
  }
  if (stat[Stat.Lives] == 0 && stat[Stat.CurrentHP] != 0) {
    runDigimonRoutine(73, 7);
    return;
  }
  if (stat[Stat.Lifetime] <= 0) {
    runDigimonRoutine(71, 3);
    return;
  }
  runDigimonRoutine(72, 9);
  return;
}

