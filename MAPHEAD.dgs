section(1245) {
  playSound(0, 9);
  if (!trigger(203)) {
    warp(to: Map.TWNA01, spawn: 0, trigger: 255);
  }
  if (trigger(220) || trigger(214) || pstat[1] >= 50) goto L4; else goto L1;

L1:
  if (trigger(221)) goto L3; else goto L2;

L2:
  if (trigger(225)) {
    warp(to: Map.TWNA04, spawn: 0, trigger: 255);
  }
  if (trigger(246)) {
    warp(to: Map.TWNA03, spawn: 0, trigger: 255);
  }
  warp(to: Map.TWNA02, spawn: 0, trigger: 255);

L3:
  if (trigger(225)) {
    warp(to: Map.TWNA07, spawn: 0, trigger: 255);
  }
  if (trigger(246)) {
    warp(to: Map.TWNA06, spawn: 0, trigger: 255);
  }
  warp(to: Map.TWNA05, spawn: 0, trigger: 255);

L4:
  if (trigger(221)) goto L6; else goto L5;

L5:
  if (trigger(225)) {
    warp(to: Map.TWNA10, spawn: 0, trigger: 255);
  }
  if (trigger(246)) {
    warp(to: Map.TWNA09, spawn: 0, trigger: 255);
  }
  warp(to: Map.TWNA08, spawn: 0, trigger: 255);

L6:
  if (trigger(225)) {
    warp(to: Map.TWNA13, spawn: 0, trigger: 255);
  }
  if (trigger(246)) {
    warp(to: Map.TWNA12, spawn: 0, trigger: 255);
  }
  warp(to: Map.TWNA11, spawn: 0, trigger: 255);
  return;
}

section(1246) {
  unsetTrigger(Trigger(1));
  setTrigger(Trigger(41));
  if (stat[Stat.Lives] == 0 && stat[Stat.CurrentHP] == 0) {
    runDigimonRoutine(73, 7);
    return;
  }
  if (stat[Stat.Lives] == 0 && stat[Stat.CurrentHP] != 0) {
    runDigimonRoutine(73, 7);
    return;
  }
  if (stat[Stat.Lifetime] <= 0) {
    runDigimonRoutine(71, 3);
    return;
  }
  runDigimonRoutine(72, 9);
  return;
}

