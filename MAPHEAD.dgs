section(233) {
  switchToMap(189, Map.MIHA05, 0, 3);
  if (!trigger(233) && trigger(53)) {
    loadAndSetDigimon(Digimon.NPCUnimon, 0, 0);
  }
  return;
}

section(234) {
  switchToMap(190, Map.MIHA06, 0, 3);
  loadDigimon(Digimon.NPCVademon);
  return;
}

section(235) {
  switchToMap(191, Map.ROOM20, 0, 28);
  if (pstat[122] == 1) {
    loadAndSetDigimon(Digimon.NPCMetalMamemon, 1, 0);
    return;
  }
  if (pstat[122] == 0) {
    loadAndSetDigimon(Digimon.NPCPenguinmon, 0, 0);
    return;
  }
  roll(pstat: 110, max: 7);
  if (trigger(227) && pstat[110] <= 0) {
    setPStat(122, 1);
    loadAndSetDigimon(Digimon.NPCMetalMamemon, 1, 0);
    return;
  }
  if (trigger(257)) {
    setPStat(122, 0);
    loadAndSetDigimon(Digimon.NPCPenguinmon, 0, 0);
  }
  return;
  return;
}

section(236) {
  switchToMap(192, Map.TEND01, 0, 28);
  for x in [:Jijimon, :NPCGreymon, :NPCAirdramon] {
    loadDigimon(x);
  }
  setDigimon(Digimon.Jijimon, 0, 0);
  setDigimon(Digimon.NPCGreymon, 1, 0);
  setDigimon(Digimon.NPCAirdramon, 2, 0);
  return;
}

section(237) {
  switchToMap(192, Map.TEND02, 0, 28);
  for x in [:Jijimon, :NPCGreymon, :NPCAirdramon] {
    loadDigimon(x);
  }
  setDigimon(Digimon.Jijimon, 0, 0);
  setDigimon(Digimon.NPCGreymon, 1, 0);
  setDigimon(Digimon.NPCAirdramon, 2, 0);
  return;
}

section(238) {
  switchToMap(193, Map.TOPN01, 0, 28);
  if (trigger(55)) {
    for x in [:Jijimon, :Tokomon, :Poyomon] {
      loadDigimon(x);
    }
    setDigimon(Digimon.Tokomon, 5, 0);
    setDigimon(Digimon.Jijimon, 3, 0);
    setDigimon(Digimon.Poyomon, 7, 0);
    return;
  }
  return;
}

