section onEnter(254) {
  switchToMap(198, Map.MGEN10, 1, 27);
  if (!trigger(254)) {
    loadAndSetDigimon(Digimon.NPCMegadramon, 6, 1);
    return;
  }
  loadDigimon(Digimon.Gururumon);
  loadAndSetDigimon(Digimon.Piddomon, 0, 1);
  setDigimon(Digimon.Gururumon, 1, 1);
  setDigimon(Digimon.Piddomon, 2, 1);
  setDigimon(Digimon.Gururumon, 3, 1);
  setDigimon(Digimon.Piddomon, 4, 1);
  setDigimon(Digimon.Gururumon, 5, 1);
  return;
}

