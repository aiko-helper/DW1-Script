section(179) {
  switchToMap(162, Map.TWNA13, 0, 28);

L1:
  setPStat(42, 0);
  loadAndSetDigimon(Digimon.NPCVegimon, 6, 0);
  addPStat(42, 1);

L2:
  if (trigger(224)) {
    loadAndSetDigimon(Digimon.NPCWhamon, 7, 0);
    addPStat(42, 1);
  }
  if (trigger(87) && !trigger(205)) {
    return;
  }
  if (trigger(354) && !trigger(355)) {
    return;
  }
  if (!trigger(84) && trigger(250)) {
    loadAndSetDigimon(Digimon.NPCKokatorimon, 3, 0);
    addPStat(42, 1);
  }
  if (pstat[42] == 3) {
    return;
  }
  pstat[:SavedTime] = time();
  if (pstat[107] in 7..19) {
    goto L3;
    goto L3;
  }
  goto L4;

L3:
  roll(pstat: 110, max: 3);
  if (trigger(240) && pstat[110] <= 0 && pstat[42] <= 2) {
    loadAndSetDigimon(Digimon.NPCAndromon, 2, 0);
    addPStat(42, 1);
  }
  if (pstat[42] == 3) {
    return;
  }
  loadAndSetDigimon(Digimon.Yuramon, 0, 0);
  return;

L4:
  if (pstat[42] <= 2) {
    goto L5;
  }
  return;

L5:
  if (trigger(250) && trigger(84) && pstat[107] >= 4 && pstat[107] < 8) {
    loadAndSetDigimon(Digimon.NPCKokatorimon, 3, 0);
    addPStat(42, 1);
  }
  if (pstat[42] == 3) {
    return;
  }
  if (trigger(239)) {
    loadAndSetDigimon(Digimon.NPCSukamon, 1, 0);
  }
  return;
}

