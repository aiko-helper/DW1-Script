section(192) {
  switchToMap(163, Map.TWNB13, 0, 28);
  setPStat(43, 13);
  if (!trigger(328)) goto L1;
  setTrigger(329);

L1:
  setPStat(38, 0);
  setPStat(39, 0);
  if (!trigger(204)) goto L2;
  if (trigger(231) || trigger(245) || trigger(233) || trigger(247)) {
    goto L2;
  }
  addPStat(38, 1);
  loadAndSetDigimon(Digimon.NPCBetamon, 2, 0);

L2:
  if (!trigger(77) && trigger(237)) {
    addPStat(38, 1);
    loadAndSetDigimon(Digimon.NPCBakemon, 0, 0);
  }
  if (!trigger(78) && trigger(235)) {
    addPStat(38, 1);
    loadAndSetDigimon(Digimon.NPCShellmon, 1, 0);
  }
  if (pstat[38] == 3) {
    return;
  }
  if (!trigger(79) && trigger(232)) {
    addPStat(38, 1);
    loadAndSetDigimon(Digimon.NPCKunemon, 3, 0);
  }
  if (pstat[38] == 3) {
    return;
  }
  pstat[:SavedTime] = time();
  if (pstat[107] in 7..19) {
    goto L3;
  }
  if (!trigger(80) && trigger(218)) {
    addPStat(38, 1);
    loadAndSetDigimon(Digimon.NPCElecmon, 5, 0);
  }
  if (pstat[38] != 3) goto L3;
  return;

L3:
  pstat[:SavedTime] = time();
  if (pstat[107] in 7..19) {
    goto L4;
    goto L4;
  }
  goto L7;

L4:
  loop {
    addPStat(38, 1);
    loadAndSetDigimon(Digimon.Tsunomon, 4, 0);
    if (pstat[38] == 3) {
      return;
    }
    if (!trigger(204)) goto L5;
    if (!trigger(231) && !trigger(245) && !trigger(233) && !trigger(247)) goto L5;
    addPStat(38, 1);
    loadAndSetDigimon(Digimon.NPCBetamon, 2, 0);
    if (pstat[38] != 3) goto L5;
    return;

L5:
    roll(pstat: 110, max: 1);
    if (pstat[110] == 0 && trigger(235) && trigger(78)) {
      goto L6;
    }
    if (trigger(234)) {
      addPStat(38, 1);
      loadAndSetDigimon(Digimon.NPCOgremon, 7, 0);
    }
    if (pstat[38] != 3) goto L6;
    return;

L6:
    if (trigger(235) && trigger(78)) {
      addPStat(38, 1);
      loadAndSetDigimon(Digimon.NPCShellmon, 1, 0);
    }
    if (pstat[38] == 3) {
      return;
    }
    addPStat(39, 1);
    if (pstat[39] < 2) {
      goto L7;
    }
    return;

L7:
    pstat[:SavedTime] = time();
    if (pstat[107] in 7..19) {
      goto L8;
    }
    if (trigger(237) && trigger(77)) {
      addPStat(38, 1);
      loadAndSetDigimon(Digimon.NPCBakemon, 0, 0);
    }
    if (pstat[38] != 3) goto L8;
    return;

L8:
    if (trigger(218)) {
      addPStat(38, 1);
      loadAndSetDigimon(Digimon.NPCElecmon, 5, 0);
    }
    if (pstat[38] == 3) {
      return;
    }
    roll(pstat: 110, max: 1);
    if (pstat[110] == 0 && trigger(254)) {
      goto L9;
    }
    if (trigger(232) && trigger(79)) {
      addPStat(38, 1);
      loadAndSetDigimon(Digimon.NPCKunemon, 3, 0);
    }
    if (pstat[38] != 3) goto L9;
    return;

L9:
    if (trigger(254)) {
      addPStat(38, 1);
      loadAndSetDigimon(Digimon.NPCMegadramon, 6, 0);
    }
    if (pstat[38] == 3) {
      return;
    }
    addPStat(39, 1);
    if (pstat[39] >= 2) break;
  }
  return;
}

