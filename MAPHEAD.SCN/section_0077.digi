; source: extract/DIGIMON/SCN/MAPHEAD.SCN
; MAPHEAD.SCN, section 77

section_77(77):     ; len=68
  0000:  setScript GIAS05 GIAS08
  0006:  setPStat 245 0
  000a:  setBGM 11
  000c:  storeDate 105
  000e:  if pstat[107] < 7 OR pstat[107] >= 19 then section_77+0x32
  001e:  loadDigimon ShimaUnimon
  0020:  loadDigimon Sharmamon
  0022:  setDigimon ShimaUnimon 0 1
  0026:  setDigimon Sharmamon 1 1
  002a:  setDigimon Sharmamon 2 1
  002e:  jump section_77+0x42
  0032:  loadDigimon NiseDrimogemon
  0034:  loadDigimon Sharmamon
  0036:  setDigimon NiseDrimogemon 3 1
  003a:  setDigimon Sharmamon 4 1
  003e:  setDigimon Sharmamon 5 1
  0042:  endSection
