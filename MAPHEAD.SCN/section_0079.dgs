// source: extract/DIGIMON/SCN/MAPHEAD.SCN
// MAPHEAD.SCN, section 79

section section_79(79) {  // len=76
    setScript(76, Map.KODA00);
    setPStat(245, 0);
    setBGM(14);
    loadDigimon(Digimon.NPCTyrannomon);
    if (trigger(144)) goto L_0020;
    setDigimon(Digimon.NPCTyrannomon, 0, 1);
    return;
L_0020:
    storeDate(105);
    if (pstat[107] < 7 || pstat[107] >= 19) goto L_0040;
    loadDigimon(Digimon.Vermilimon);
    setDigimon(Digimon.Vermilimon, 1, 1);
    setDigimon(Digimon.Vermilimon, 2, 1);
    goto L_004a;
L_0040:
    loadDigimon(Digimon.Yanmamon);
    setDigimon(Digimon.Yanmamon, 3, 1);
    setDigimon(Digimon.Yanmamon, 4, 1);
L_004a:
    return;
}
