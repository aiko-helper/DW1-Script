// source: extract/DIGIMON/SCN/MAPHEAD.SCN
// MAPHEAD.SCN, section 247

section section_247(247) {  // len=58
    setScript(194, Map.MGEN06);
    setPStat(245, 1);
    setBGM(27);
    if (trigger(321)) goto L_0020;
    loadDigimon(Digimon.NPCDevimon);
    setDigimon(Digimon.NPCDevimon, 5, 1);
    return;
L_0020:
    loadDigimon(Digimon.Vermilimon);
    loadDigimon(Digimon.Piddomon);
    setDigimon(Digimon.Vermilimon, 0, 1);
    setDigimon(Digimon.Piddomon, 1, 1);
    setDigimon(Digimon.Piddomon, 2, 1);
    setDigimon(Digimon.Vermilimon, 3, 1);
    setDigimon(Digimon.Piddomon, 4, 1);
    return;
}
