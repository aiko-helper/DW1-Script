// source: extract/DIGIMON/SCN/MAPHEAD.SCN
// MAPHEAD.SCN, section 1246

section section_1246(1246) {  // len=94
    unsetTrigger(1);
    setTrigger(41);
    if (stat[Stat.Lives] != 0 || stat[Stat.CurrentHP] != 0) goto L_0024;
    sectionOnExit(73);
    callDigimonSubroutine(7);
    waitForEntity(Entity.System);
    return;
L_0024:
    if (stat[Stat.Lives] != 0 || stat[Stat.CurrentHP] == 0) goto L_0040;
    sectionOnExit(73);
    callDigimonSubroutine(7);
    waitForEntity(Entity.System);
    return;
L_0040:
    if (stat[Stat.Lifetime] > 0) goto L_0056;
    sectionOnExit(71);
    callDigimonSubroutine(3);
    waitForEntity(Entity.System);
    return;
L_0056:
    sectionOnExit(72);
    callDigimonSubroutine(9);
    waitForEntity(Entity.System);
    return;
}
