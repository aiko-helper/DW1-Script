section_12(12):     ; len=92
  0000:  setScript TROP02 TROP01
  0006:  setPStat 245 0
  000a:  setBGM 2
  000c:  storeDate 105
  000e:  if pstat[107] < 7 OR pstat[107] >= 19 then section_12+0x2c
  001e:  loadDigimon Muchomon
  0020:  setDigimon Muchomon 1 1
  0024:  setDigimon Muchomon 2 1
  0028:  jump section_12+0x36
  002c:  loadDigimon JMojyamon
  002e:  setDigimon JMojyamon 4 1
  0032:  setDigimon JMojyamon 3 1
