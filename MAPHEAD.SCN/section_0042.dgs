L_0032:
    loadDigimon(Digimon.Gotsumon);
    loadDigimon(Digimon.Gururumon);
    setDigimon(Digimon.Gotsumon, 3, 1);
    setDigimon(Digimon.Gotsumon, 4, 1);
    setDigimon(Digimon.Gururumon, 5, 1);
L_0042:
