; source: extract/DIGIMON/SCN/MAPHEAD.SCN
; MAPHEAD.SCN, section 36

section_36(36):     ; len=56
  0000:  setScript GCAN01 GCAN01
  0006:  setPStat 245 0
  000a:  setBGM 6
  000c:  storeDate 105
  000e:  if pstat[107] < 7 OR pstat[107] >= 19 then section_36+0x2c
  001e:  loadDigimon Goburimon
  0020:  setDigimon Goburimon 0 1
  0024:  setDigimon Goburimon 1 1
  0028:  jump section_36+0x36
  002c:  loadDigimon Gotsumon
  002e:  setDigimon Gotsumon 2 1
  0032:  setDigimon Gotsumon 3 1
  0036:  endSection
