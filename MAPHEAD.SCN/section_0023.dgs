section section_23(23) {  // len=76
    setScript(24, Map.MIHA04B);
    setPStat(245, 0);
    setBGM(3);
    storeDate(105);
    if (pstat[107] < 7 || pstat[107] >= 19) goto L_0036;
    loadDigimon(Digimon.Flareizamon);
    loadDigimon(Digimon.Aruraumon);
    setDigimon(Digimon.Flareizamon, 0, 1);
    setDigimon(Digimon.Flareizamon, 1, 1);
    setDigimon(Digimon.Aruraumon, 2, 1);
    setDigimon(Digimon.Aruraumon, 3, 1);
    goto L_004a;
L_0036:
    loadDigimon(Digimon.Tsukaimon);
    setDigimon(Digimon.Tsukaimon, 4, 1);
    setDigimon(Digimon.Tsukaimon, 5, 1);
    loadDigimon(Digimon.Goburimon);
    setDigimon(Digimon.Goburimon, 6, 1);
    setDigimon(Digimon.Goburimon, 7, 1);
L_004a:
    return;
}
