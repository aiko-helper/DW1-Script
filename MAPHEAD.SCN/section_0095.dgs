section section_95(95) {  // len=146
    setScript(91, Map.FRZL08);
    setPStat(245, 0);
    setBGM(15);
    if (trigger(195)) goto L_0020;
    loadDigimon(Digimon.NPCGarurumon);
    setDigimon(Digimon.NPCGarurumon, 0, 0);
    return;
L_0020:
    storeDate(105);
    if (!trigger(195) || pstat[107] < 15 || pstat[107] >= 17 || trigger(222) || pstat[29] < 1) goto L_0046;
    loadDigimon(Digimon.NPCGarurumon);
    setDigimon(Digimon.NPCGarurumon, 5, 0);
    return;
L_0046:
    if (!trigger(195) || pstat[107] < 17 || trigger(222) || pstat[29] < 1) goto L_0066;
    loadDigimon(Digimon.NPCGarurumon);
    setDigimon(Digimon.NPCGarurumon, 0, 0);
    return;
L_0066:
    storeDate(105);
    if (pstat[107] < 7 || pstat[107] >= 19) goto L_0086;
    loadDigimon(Digimon.SnowAgumon);
    setDigimon(Digimon.SnowAgumon, 1, 1);
    setDigimon(Digimon.SnowAgumon, 2, 1);
    goto L_0090;
L_0086:
    loadDigimon(Digimon.Hyogamon);
    setDigimon(Digimon.Hyogamon, 3, 1);
    setDigimon(Digimon.Hyogamon, 4, 1);
L_0090:
    return;
}
