section section_112(112) {  // len=56
    setScript(108, Map.TRAI00);
    setPStat(245, 0);
    setBGM(1);
    loadDigimon(Digimon.Koromon);
    setDigimon(Digimon.Koromon, 0, 0);
    if (!trigger(219)) goto L_0024;
    loadDigimon(Digimon.NPCKabuterimon);
    setDigimon(Digimon.NPCKabuterimon, 1, 0);
L_0024:
    if (!trigger(251)) goto L_0036;
    loadDigimon(Digimon.NPCKuwagamon);
    setDigimon(Digimon.NPCKuwagamon, 2, 0);
L_0036:
    return;
}
