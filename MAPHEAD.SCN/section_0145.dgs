section section_145(145) {  // len=62
    setScript(139, Map.OMOC02);
    if (!trigger(350)) goto L_001c;
    setPStat(245, 6);
    setBGM(21);
    goto L_0022;
L_001c:
    setPStat(245, 5);
    setBGM(21);
L_0022:
    storeDigimonType(103);
    if (!trigger(350) && pstat[103] != 14) goto L_0036;
    return;
L_0036:
    loadDigimon(Digimon.NPCMonzaemon);
    setDigimon(Digimon.NPCMonzaemon, 0, 0);
    return;
}
