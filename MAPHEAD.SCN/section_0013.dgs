section section_13(13) {  // len=66
    setScript(14, Map.TROP02);
    setPStat(245, 0);
    setBGM(2);
    storeDate(105);
    if (pstat[107] < 7 || pstat[107] >= 19) goto L_0030;
    loadDigimon(Digimon.Yanmamon);
    setDigimon(Digimon.Yanmamon, 0, 1);
    setDigimon(Digimon.Yanmamon, 1, 1);
    setDigimon(Digimon.Yanmamon, 2, 1);
    goto L_0040;
L_0030:
    loadDigimon(Digimon.Tsukaimon);
    loadDigimon(Digimon.JMojyamon);
    setDigimon(Digimon.Tsukaimon, 3, 1);
    setDigimon(Digimon.JMojyamon, 4, 1);
    setDigimon(Digimon.JMojyamon, 5, 1);
L_0040:
    return;
}
