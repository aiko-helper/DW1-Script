section section_91(91) {  // len=66
    setScript(87, Map.FRZL04);
    setPStat(245, 0);
    setBGM(15);
    storeDate(105);
    if (pstat[107] < 7 || pstat[107] >= 19) goto L_0032;
    loadDigimon(Digimon.Hyogamon);
    loadDigimon(Digimon.SnowGoburimon);
    setDigimon(Digimon.SnowGoburimon, 0, 1);
    setDigimon(Digimon.SnowGoburimon, 1, 1);
    setDigimon(Digimon.Hyogamon, 2, 1);
    goto L_0040;
L_0032:
    loadDigimon(Digimon.IceDevimon);
    setDigimon(Digimon.IceDevimon, 3, 1);
    setDigimon(Digimon.IceDevimon, 4, 1);
    setDigimon(Digimon.IceDevimon, 5, 1);
L_0040:
    return;
}
