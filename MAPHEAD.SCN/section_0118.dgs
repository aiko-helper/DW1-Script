// source: extract/DIGIMON/SCN/MAPHEAD.SCN
// MAPHEAD.SCN, section 118

section section_118(118) {  // len=82
    setScript(114, Map.MIST04);
    setPStat(245, 0);
    setBGM(20);
    if (trigger(114) || trigger(147)) goto L_0024;
    loadDigimon(Digimon.Goburimon);
    setDigimon(Digimon.Goburimon, 0, 1);
    return;
L_0024:
    storeDate(105);
    if (pstat[107] < 7 || pstat[107] >= 19) goto L_0046;
    loadDigimon(Digimon.Fugamon);
    loadDigimon(Digimon.MoriShellmon);
    setDigimon(Digimon.Fugamon, 1, 1);
    setDigimon(Digimon.MoriShellmon, 2, 1);
    goto L_0050;
L_0046:
    loadDigimon(Digimon.Saberdramon);
    setDigimon(Digimon.Saberdramon, 3, 1);
    setDigimon(Digimon.Saberdramon, 4, 1);
L_0050:
    return;
}
