// source: extract/DIGIMON/SCN/MAPHEAD.SCN
// MAPHEAD.SCN, section 82

section section_82(82) {  // len=70
    setScript(79, Map.KODA03);
    setPStat(245, 0);
    setBGM(14);
    loadDigimon(Digimon.NPCTyrannomon);
    loadDigimon(Digimon.MasterTyrannomon);
    if (trigger(187)) goto L_0020;
    setDigimon(Digimon.NPCTyrannomon, 0, 0);
L_0020:
    if (!trigger(187) || trigger(208)) goto L_0034;
    setDigimon(Digimon.NPCTyrannomon, 1, 0);
L_0034:
    if (!trigger(208)) goto L_0044;
    setDigimon(Digimon.MasterTyrannomon, 3, 0);
L_0044:
    return;
}
