// source: extract/DIGIMON/SCN/MAPHEAD.SCN
// MAPHEAD.SCN, section 9

section section_9(9) {  // len=88
    setScript(10, Map.MAYO08A);
    setPStat(245, 0);
    setBGM(1);
    if (!trigger(242) || !trigger(258)) goto L_0024;
    loadDigimon(Digimon.NPCEtemon);
    setDigimon(Digimon.NPCEtemon, 3, 0);
    return;
L_0024:
    if (trigger(258)) goto L_0034;
    loadDigimon(Digimon.NPCNinjamon);
    return;
L_0034:
    storeDate(105);
    if (pstat[107] < 7 || pstat[107] >= 19) goto L_0050;
    loadDigimon(Digimon.Aruraumon);
    setDigimon(Digimon.Aruraumon, 0, 1);
    goto L_0056;
L_0050:
    loadDigimon(Digimon.Tsukaimon);
    setDigimon(Digimon.Tsukaimon, 2, 1);
L_0056:
    return;
}
