// source: extract/DIGIMON/SCN/MAPHEAD.SCN
// MAPHEAD.SCN, section 19

section section_19(19) {  // len=58
    setScript(20, Map.MIHA01);
    setPStat(245, 0);
    setBGM(3);
    roll(pstat: 100, max: 99);
    if (pstat[100] > 2 || trigger(213)) goto L_002a;
    loadDigimon(Digimon.NPCMamemon);
    setDigimon(Digimon.NPCMamemon, 0, 1);
    goto L_0038;
L_002a:
    loadDigimon(Digimon.MudFrigimon);
    setDigimon(Digimon.MudFrigimon, 1, 1);
    setDigimon(Digimon.MudFrigimon, 2, 1);
    setDigimon(Digimon.MudFrigimon, 3, 1);
L_0038:
    return;
}
