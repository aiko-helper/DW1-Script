// source: extract/DIGIMON/SCN/MAPHEAD.SCN
// MAPHEAD.SCN, section 225

section section_225(225) {  // len=58
    setScript(184, Map.MGEN99);
    setPStat(245, 10);
    setBGM(27);
    if (trigger(50)) goto L_0022;
    loadDigimon(Digimon.Analogman);
    setDigimon(Digimon.Analogman, 1, 0);
    loadDigimon(Digimon.Machinedramon);
    return;
L_0022:
    if (trigger(256) || !trigger(50)) goto L_0038;
    loadDigimon(Digimon.NPCDigitamamon);
    setDigimon(Digimon.NPCDigitamamon, 3, 0);
L_0038:
    return;
}
