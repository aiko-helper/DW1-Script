section section_46(46) {  // len=42
    setScript(46, Map.OGRE01);
    setPStat(245, 1);
    setBGM(8);
    if (trigger(175)) goto L_0028;
    loadDigimon(Digimon.NPCGabumon);
    loadDigimon(Digimon.Agumon);
