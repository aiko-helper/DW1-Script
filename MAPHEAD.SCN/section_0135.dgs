// source: extract/DIGIMON/SCN/MAPHEAD.SCN
// MAPHEAD.SCN, section 135

section section_135(135) {  // len=70
    setScript(130, Map.FRZL16);
    setPStat(245, 0);
    setBGM(15);
    if (!trigger(175) || trigger(224)) goto L_0022;
    loadDigimon(Digimon.NPCWhamon);
    setDigimon(Digimon.NPCWhamon, 1, 0);
L_0022:
    storeDate(105);
    if (pstat[107] < 7 || pstat[107] >= 19) goto L_003e;
    loadDigimon(Digimon.SnowGoburimon);
    setDigimon(Digimon.SnowGoburimon, 0, 1);
    goto L_0044;
L_003e:
    loadDigimon(Digimon.IceDevimon);
    setDigimon(Digimon.IceDevimon, 2, 1);
L_0044:
    return;
}
