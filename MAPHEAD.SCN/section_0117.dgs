// source: extract/DIGIMON/SCN/MAPHEAD.SCN
// MAPHEAD.SCN, section 117

section section_117(117) {  // len=126
    setScript(113, Map.MIST03);
    setPStat(245, 0);
    setBGM(20);
    storeDate(105);
    unsetTrigger(174);
    if (pstat[107] < 4 || pstat[107] > 6 || trigger(250)) goto L_0032;
    loadDigimon(Digimon.NPCKokatorimon);
    setDigimon(Digimon.NPCKokatorimon, 0, 1);
    setTrigger(174);
    return;
L_0032:
    if (trigger(114) || trigger(147)) goto L_0052;
    loadDigimon(Digimon.Goburimon);
    setDigimon(Digimon.Goburimon, 1, 1);
    setDigimon(Digimon.Goburimon, 2, 1);
    setDigimon(Digimon.Goburimon, 3, 1);
    return;
L_0052:
    storeDate(105);
    if (pstat[107] < 7 || pstat[107] >= 19) goto L_0072;
    loadDigimon(Digimon.MoriShellmon);
    setDigimon(Digimon.MoriShellmon, 4, 1);
    setDigimon(Digimon.MoriShellmon, 5, 1);
    goto L_007c;
L_0072:
    loadDigimon(Digimon.Goburimon);
    setDigimon(Digimon.Goburimon, 6, 1);
    setDigimon(Digimon.Goburimon, 7, 1);
L_007c:
    return;
}
