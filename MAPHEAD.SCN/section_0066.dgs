// source: extract/DIGIMON/SCN/MAPHEAD.SCN
// MAPHEAD.SCN, section 66

section section_66(66) {  // len=58
    setScript(63, Map.CHKA01);
    setPStat(245, 1);
    setBGM(10);
    if (pstat[16] != 2) goto L_0026;
    loadDigimon(Digimon.Machinedramon);
    loadDigimon(Digimon.Analogman);
    setDigimon(Digimon.Machinedramon, 1, 0);
    setDigimon(Digimon.Analogman, 2, 0);
    return;
L_0026:
    if (trigger(128)) goto L_0038;
    loadDigimon(Digimon.NPCMyotismon);
    setDigimon(Digimon.NPCMyotismon, 0, 0);
L_0038:
    return;
}
