// source: extract/DIGIMON/SCN/MAPHEAD.SCN
// MAPHEAD.SCN, section 72

section section_72(72) {  // len=78
    setScript(69, Map.GIAS03);
    setPStat(245, 0);
    setBGM(11);
    if (trigger(231)) goto L_0020;
    loadDigimon(Digimon.NPCPatamon);
    setDigimon(Digimon.NPCPatamon, 0, 1);
    return;
L_0020:
    storeDate(105);
    if (pstat[107] < 7 || pstat[107] >= 19) goto L_0042;
    loadDigimon(Digimon.ShimaUnimon);
    loadDigimon(Digimon.Sharmamon);
    setDigimon(Digimon.ShimaUnimon, 1, 1);
    setDigimon(Digimon.Sharmamon, 2, 1);
    goto L_004c;
L_0042:
    loadDigimon(Digimon.Sharmamon);
    setDigimon(Digimon.Sharmamon, 3, 1);
    setDigimon(Digimon.Sharmamon, 4, 1);
L_004c:
    return;
}
