// source: extract/DIGIMON/SCN/MAPHEAD.SCN
// MAPHEAD.SCN, section 12

section section_12(12) {  // len=92
    setScript(13, Map.TROP01);
    setPStat(245, 0);
    setBGM(2);
    storeDate(105);
    if (pstat[107] < 7 || pstat[107] >= 19) goto L_002c;
    loadDigimon(Digimon.Muchomon);
    setDigimon(Digimon.Muchomon, 1, 1);
    setDigimon(Digimon.Muchomon, 2, 1);
    goto L_0036;
L_002c:
    loadDigimon(Digimon.JMojyamon);
    setDigimon(Digimon.JMojyamon, 4, 1);
    setDigimon(Digimon.JMojyamon, 3, 1);
L_0036:
    if (!trigger(255)) goto L_0044;
    return;
L_0044:
    roll(pstat: 100, max: 99);
    if (pstat[100] > 2) goto L_005a;
    loadDigimon(Digimon.NPCPiximon);
    setDigimon(Digimon.NPCPiximon, 0, 1);
L_005a:
    return;
}
