// source: extract/DIGIMON/SCN/MAPHEAD.SCN
// MAPHEAD.SCN, section 139

section section_139(139) {  // len=84
    setScript(134, Map.STIC02);
    setPStat(245, 0);
    setBGM(19);
    roll(pstat: 110, max: 2);
    if (pstat[110] > 0 || trigger(309)) goto L_0028;
    loadDigimon(Digimon.Otamamon);
    setDigimon(Digimon.Otamamon, 4, 0);
    return;
L_0028:
    storeDate(105);
    if (pstat[107] < 7 || pstat[107] >= 19) goto L_0048;
    loadDigimon(Digimon.Yanmamon);
    setDigimon(Digimon.Yanmamon, 0, 1);
    setDigimon(Digimon.Yanmamon, 1, 1);
    goto L_0052;
L_0048:
    loadDigimon(Digimon.Gekomon);
    setDigimon(Digimon.Gekomon, 2, 1);
    setDigimon(Digimon.Gekomon, 3, 1);
L_0052:
    return;
}
