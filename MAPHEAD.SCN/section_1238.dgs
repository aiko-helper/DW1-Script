L_0084:
    showTextbox("Which one do you want?\n");
L_00b6:
    showTextbox("Help me on my next request.\n");
L_00f2:
    showTextbox("<SELECTED TRACK>, right?\n");
L_010a:
    showTextbox("Why don't you request a\nnumber that will make me hot?\n");
L_017a:
    showTextbox("Where should I take you?\n");
L_01b0:
    showTextbox("I think that going yourself\nmay be the best way.\n");
L_0216:
    showTextbox("Are you sure? Once you go,\nI can't take you back.\n");
L_027e:
    showTextbox("I know\nCancel\n");
L_029e:
    showTextbox("I'm a collector. If you got\na thing I want, I'll trade.\n");
L_0312:
    showTextbox("What will you give me?\n");
L_0344:
    showTextbox("I'll trade all the time,\nso bring whatever you got.\n");
L_03b0:
    showTextbox("You'll really give me <SELECTED ITEM>?\n");
L_03e6:
    showTextbox("Yeah\nWell..., no\n");
L_040c:
    showTextbox("Thanks!\n");
L_0420:
    showTextbox("Too many Items.\n");
L_0444:
    showTextbox("I want You have\n");
L_0468:
    showTextbox("<YELLOW>Jijimon <WHITE>\nI'm Jijimon. Tell me\nabout yourself.\n");
L_04cc:
    showTextbox("<YELLOW>Jijimon <WHITE>\nDo you have a Digivice?\n");
L_0516:
    showTextbox("<LIGHTBLUE><PLAYER><WHITE>\nYes\nNo\n");
L_0530:
    showTextbox("<YELLOW>Jijimon <WHITE>\nI see.\n");
L_0558:
    showTextbox("<YELLOW>Jijimon <WHITE>\nNext question. Which do you\nlike better, day or night?\n");
L_05e0:
    showTextbox("<LIGHTBLUE><PLAYER><WHITE>\nDay\nNight\n");
L_0600:
    showTextbox("<YELLOW>Jijimon <WHITE>\nI see.\n");
L_0628:
    showTextbox("<YELLOW>Jijimon <WHITE>\nDo you have friends?\n");
L_066c:
    showTextbox("<LIGHTBLUE><PLAYER><WHITE>\nYes\nNo\n");
L_0686:
    showTextbox("<YELLOW>Jijimon <WHITE>\nAlright.\n");
L_06b2:
    showTextbox("<YELLOW>Jijimon <WHITE>\nWhat's your name?\n");
L_06f0:
    showTextbox("<YELLOW>Jijimon <WHITE>\n<LIGHTBLUE><PLAYER><WHITE>, right?\n");
L_0722:
    showTextbox("<LIGHTBLUE><PLAYER><WHITE>\nYes\nNo\n");
L_073c:
    showTextbox("<YELLOW>Jijimon <WHITE>\nWhat's your Digimon's name?\n");
L_078e:
    showTextbox("<YELLOW>Jijimon <WHITE>\n<ORANGE><DIGIMON><WHITE>, right?\n");
L_07c0:
    showTextbox("<YELLOW>Jijimon <WHITE>\nGood Name.\n");
L_07f0:
    showTextbox("<YELLOW>Jijimon <WHITE>\nThat's all the questions\nI have. See ya later!\n");
    return;
