// source: extract/DIGIMON/SCN/MAPHEAD.SCN
// MAPHEAD.SCN, section 71

section section_71(71) {  // len=88
    setScript(68, Map.GIAS02);
    setPStat(245, 0);
    setBGM(11);
    if (trigger(218)) goto L_0020;
    loadDigimon(Digimon.NPCElecmon);
    setDigimon(Digimon.NPCElecmon, 0, 0);
    return;
L_0020:
    storeDate(105);
    if (pstat[107] < 7 || pstat[107] >= 19) goto L_0046;
    loadDigimon(Digimon.Sharmamon);
    loadDigimon(Digimon.Akatorimon);
    setDigimon(Digimon.Akatorimon, 1, 1);
    setDigimon(Digimon.Akatorimon, 2, 1);
    setDigimon(Digimon.Sharmamon, 3, 1);
    goto L_0056;
L_0046:
    loadDigimon(Digimon.Psychemon);
    loadDigimon(Digimon.Sharmamon);
    setDigimon(Digimon.Psychemon, 4, 1);
    setDigimon(Digimon.Psychemon, 5, 1);
    setDigimon(Digimon.Sharmamon, 6, 1);
L_0056:
    return;
}
