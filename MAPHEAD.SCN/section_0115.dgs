// source: extract/DIGIMON/SCN/MAPHEAD.SCN
// MAPHEAD.SCN, section 115

section section_115(115) {  // len=68
    setScript(111, Map.MIST01);
    setPStat(245, 0);
    setBGM(20);
    storeDate(105);
    if (pstat[107] < 7 || pstat[107] >= 19) goto L_0032;
    loadDigimon(Digimon.Fugamon);
    loadDigimon(Digimon.MoriShellmon);
    setDigimon(Digimon.Fugamon, 0, 1);
    setDigimon(Digimon.Fugamon, 1, 1);
    setDigimon(Digimon.MoriShellmon, 2, 1);
    goto L_0042;
L_0032:
    loadDigimon(Digimon.Darkrizamon);
    loadDigimon(Digimon.Tsukaimon);
    setDigimon(Digimon.Darkrizamon, 3, 1);
    setDigimon(Digimon.Darkrizamon, 4, 1);
    setDigimon(Digimon.Tsukaimon, 5, 1);
L_0042:
    return;
}
