; MAPHEAD.SCN, section 74

section_74(74):     ; len=68
  0000:  setScript GIAS02 GIAS05
  0006:  setPStat 245 0
  000a:  setBGM 11
  000c:  storeDate 105
  000e:  if pstat[107] < 7 OR pstat[107] >= 19 then section_74+0x32
  001e:  loadDigimon Psychemon
  0020:  loadDigimon Akatorimon
  0022:  setDigimon Psychemon 0 1
  0026:  setDigimon Psychemon 1 1
  002a:  setDigimon Akatorimon 2 1
  002e:  jump section_74+0x42
  0032:  loadDigimon Tsukaimon
  0034:  loadDigimon Sharmamon
  0036:  setDigimon Tsukaimon 3 1
  003a:  setDigimon Tsukaimon 4 1
  003e:  setDigimon Sharmamon 5 1
  0042:  endSection
