// source: extract/DIGIMON/SCN/MAPHEAD.SCN
// MAPHEAD.SCN, section 10

section section_10(10) {  // len=66
    setScript(11, Map.MAYO08B);
    setPStat(245, 0);
    setBGM(1);
    storeDate(105);
    if (pstat[107] < 7 || pstat[107] >= 19) goto L_0032;
    loadDigimon(Digimon.ModokiBetamon);
    loadDigimon(Digimon.Aruraumon);
    setDigimon(Digimon.ModokiBetamon, 0, 1);
    setDigimon(Digimon.ModokiBetamon, 1, 1);
    setDigimon(Digimon.Aruraumon, 2, 1);
    goto L_0040;
L_0032:
    loadDigimon(Digimon.Tsukaimon);
    setDigimon(Digimon.Tsukaimon, 3, 1);
    setDigimon(Digimon.Tsukaimon, 4, 1);
    setDigimon(Digimon.Tsukaimon, 5, 1);
L_0040:
    return;
}
