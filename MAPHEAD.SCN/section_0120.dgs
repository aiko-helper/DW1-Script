// source: extract/DIGIMON/SCN/MAPHEAD.SCN
// MAPHEAD.SCN, section 120

section section_120(120) {  // len=78
    setScript(116, Map.MIST06);
    setPStat(245, 0);
    setBGM(20);
    if (trigger(217)) goto L_0020;
    loadDigimon(Digimon.NPCGabumon);
    setDigimon(Digimon.NPCGabumon, 0, 1);
    return;
L_0020:
    storeDate(105);
    if (pstat[107] < 7 || pstat[107] >= 19) goto L_0040;
    loadDigimon(Digimon.Goburimon);
    setDigimon(Digimon.Goburimon, 1, 1);
    setDigimon(Digimon.Goburimon, 2, 1);
    goto L_004c;
L_0040:
    loadDigimon(Digimon.Tsukaimon);
    loadDigimon(Digimon.Darkrizamon);
    setDigimon(Digimon.Tsukaimon, 3, 1);
    setDigimon(Digimon.Darkrizamon, 4, 1);
L_004c:
    return;
}
