; source: extract/DIGIMON/SCN/MAPHEAD.SCN
; MAPHEAD.SCN, section 41

section_41(41):     ; len=68
  0000:  setScript GCAN06 GCAN06
  0006:  setPStat 245 0
  000a:  setBGM 6
  000c:  storeDate 105
  000e:  if pstat[107] < 7 OR pstat[107] >= 19 then section_41+0x32
  001e:  loadDigimon Weedmon
  0020:  loadDigimon Muchomon
  0022:  setDigimon Muchomon 0 1
  0026:  setDigimon Muchomon 1 1
  002a:  setDigimon Weedmon 2 1
  002e:  jump section_41+0x42
  0032:  loadDigimon Weedmon
  0034:  loadDigimon Goburimon
  0036:  setDigimon Weedmon 3 1
  003a:  setDigimon Weedmon 4 1
  003e:  setDigimon Goburimon 5 1
  0042:  endSection
