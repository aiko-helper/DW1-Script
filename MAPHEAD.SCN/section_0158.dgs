section section_158(158) {  // len=66
    setScript(152, Map.FACT07);
    setPStat(245, 0);
    setBGM(22);
    storeDate(105);
    if (pstat[107] < 7 || pstat[107] >= 19) goto L_0032;
    loadDigimon(Digimon.Guardromon);
    loadDigimon(Digimon.Geremon);
    setDigimon(Digimon.Geremon, 0, 1);
    setDigimon(Digimon.Geremon, 1, 1);
    setDigimon(Digimon.Guardromon, 2, 1);
    goto L_0040;
L_0032:
    loadDigimon(Digimon.Guardromon);
    setDigimon(Digimon.Guardromon, 3, 1);
    setDigimon(Digimon.Guardromon, 4, 1);
    setDigimon(Digimon.Guardromon, 5, 1);
L_0040:
    return;
}
